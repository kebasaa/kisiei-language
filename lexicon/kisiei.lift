    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpéhìá</text></form></field>
    <sense id="kpéhènɔ̀ɔ́_1848_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant né juste après des jumeaux</text></gloss>
      <gloss lang="en"><text>child born right after twins</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 209: kpéhènɔ̀ɔ́ kpéhìá</text></form></note>
    <note><form lang="fr"><text>Emprunt au bandi.</text></form></note>
  </entry>
  <entry id="kpekaa_1849">
    <lexical-unit><form lang="kqs"><text>kpekaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
