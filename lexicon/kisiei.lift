    <note><form lang="fr"><text>Paulme : vɛnɛ bɔllɛi tyɛnɛ « combien de bananes ».</text></form></note>
  </entry>
  <entry id="vɛsio_5852">
    <lexical-unit><form lang="kqs"><text>vɛsio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vɛsi</text></form></variant>
    <sense id="vɛsio_5852_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire allaiter</text></gloss>
