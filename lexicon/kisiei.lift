  <entry id="sìɔ̀lɔ̀ɔ́_3023">
    <lexical-unit><form lang="kqs"><text>sìɔ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀lɔ̀ɔ́_3023_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>longue nasse en lianes</text></gloss>
      <gloss lang="en"><text>long fish trap made of vines</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 336: sìɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="siɔu_3024">
    <lexical-unit><form lang="kqs"><text>siɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛ</text></form></variant>
    <sense id="siɔu_3024_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>poindre (le jour), se lever (soleil)</text></gloss>
      <gloss lang="en"><text>dawn, break (of day), rise (sun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dawn; also (of the sun) come out, shine; (of rain) come down</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first JDG.19.26; Childs 2000, p. 336: sìɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>paalen siɔu « le jour parut » (Jg 21,4) ; paalen le sɛ « le jour se lève » (Gn 32,27). sɛ est un autre radical du même verbe : Childs donne sɛ̀l- comme bénéfactif de sìɔ̀ɔ́ « poindre » (p. 324).</text></form></note>
  </entry>
  <entry id="sìɔ̀ùléŋ_3025">
    <lexical-unit><form lang="kqs"><text>sìɔ̀ùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀ùléŋ_3025_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (commun autour des villages)</text></gloss>
      <gloss lang="en"><text>a tree species (common around towns)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìɔ̀ùléŋ</text></form></note>
  </entry>
  <entry id="sìɔ̀ùwé_3026">
    <lexical-unit><form lang="kqs"><text>sìɔ̀ùwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀ùwé_3026_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à fleurs parfumées</text></gloss>
      <gloss lang="en"><text>tree with fragrant flowers</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìɔ̀ùwé</text></form></note>
  </entry>
  <entry id="siɔw_3027">
    <lexical-unit><form lang="kqs"><text>siɔw</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɔw_3027_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pourrir</text></gloss>
      <gloss lang="en"><text>rot</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 116: Siöw</text></form></note>
    <note><form lang="fr"><text>La Bible a siɔu, siɔ « (le jour) se lever » (JDG 19,26), sens différent.</text></form></note>
  </entry>
  <entry id="siɔŋio_3028">
    <lexical-unit><form lang="kqs"><text>siɔŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɔŋ</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋi</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋnin</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋinin</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋnun</text></form></variant>
    <sense id="siɔŋio_3028_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'user, s'abîmer ; user, ronger</text></gloss>
      <gloss lang="en"><text>wear out, waste away; wear down, consume</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>age, get old</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.16.9; Childs 2000, p. 336: sìɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>volɔɔla niaa la siɔŋ te « vos vêtements ne se sont pas usés » (Dt 8,4) ; siɔŋi « user, ronger » (Ps 39,12).</text></form></note>
  </entry>
  <entry id="siɔ́ŋndo_3029">
    <lexical-unit><form lang="kqs"><text>siɔ́ŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛŋ</text></form></variant>
    <sense id="siɔ́ŋndo_3029_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépecer, découper (une bête abattue) ; écorcher</text></gloss>
      <gloss lang="en"><text>butcher, cut up (a slaughtered animal); flay</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>butcher, slaughter</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CH.35.11; Childs 2000, p. 336: sìɔ́ŋndó</text></form></note>
    <note><form lang="fr"><text>leviia nda va cɔlua sálàá siɔ́ŋndo « les lévites dépeçaient les bêtes » (2CH.35.11) ; a sɛŋ saa kóndó kon, a diw ndu kundalan « tu découperas le bélier en morceaux » (EXO.29.17) ; mà sɛŋ ndu (1KI.18.23).</text></form></note>
  </entry>
