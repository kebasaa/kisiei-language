      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.27.18; Childs 2000, p. 139: ísɛ̀</text></form></note>
