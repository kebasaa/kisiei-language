      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Baköllo; Childs 2000, p. 5: bàkɔ̀lló</text></form></note>
  </entry>
  <entry id="balaa_14">
    <lexical-unit><form lang="kqs"><text>balaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balaa_14_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pourtour ; (o balaa sɔ́) autour</text></gloss>
      <gloss lang="en"><text>surroundings; (o balaa sɔ́) round about</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOS.21.42</text></form></note>
  </entry>
  <entry id="balan_15">
    <lexical-unit><form lang="kqs"><text>balan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bala</text></form></variant>
    <sense id="balan_15_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main(s)</text></gloss>
      <gloss lang="en"><text>hand(s)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 220 occurrences, first GEN.17.9</text></form></note>
    <note><form lang="fr"><text>vana bala fondoo « pauvre » (litt. « main vide »).</text></form></note>
  </entry>
  <entry id="balika_16">
    <lexical-unit><form lang="kqs"><text>balika</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balika_16_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>merci</text></gloss>
      <gloss lang="en"><text>thank you</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 125 occurrences, first GEN.24.48</text></form></note>
  </entry>
  <entry id="balikaa_17">
    <lexical-unit><form lang="kqs"><text>balikaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balikaa_17_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remerciement, action de grâces</text></gloss>
      <gloss lang="en"><text>thanks, thanksgiving</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first LEV.7.12</text></form></note>
    <note><form lang="fr"><text>Voir l'interjection balika « merci ».</text></form></note>
  </entry>
  <entry id="bállo_18">
    <lexical-unit><form lang="kqs"><text>bállo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>báltan</text></form></field>
    <sense id="bállo_18_s1">
      <grammatical-info value="Noun"/>
