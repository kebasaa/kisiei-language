  <entry id="kólóŋ-_2204">
    <lexical-unit><form lang="kqs"><text>kólóŋ-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kólóŋ-_2204_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grave, chronique (plaie)</text></gloss>
      <gloss lang="en"><text>serious, chronic (of a sore)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kólóŋ-</text></form></note>
    <note><form lang="fr"><text>Emprunt (mandingue).</text></form></note>
  </entry>
  <entry id="kólóŋkólòŋndó_2205">
    <lexical-unit><form lang="kqs"><text>kólóŋkólòŋndó</text></form></lexical-unit>
