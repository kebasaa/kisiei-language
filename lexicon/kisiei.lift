    <trait name="status" value="check"/>
    <sense id="ii_1802_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>je (plus-que-parfait)</text></gloss>
      <gloss lang="en"><text>I (pluperfect)</text></gloss>
