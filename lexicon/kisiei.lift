    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 341: sɔ̀ɔ̀lǎŋndó</text></form></note>
  </entry>
  <entry id="sɔɔluuo_3177">
    <lexical-unit><form lang="kqs"><text>sɔɔluuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔɔluu</text></form></variant>
    <variant><form lang="kqs"><text>sɔɔlaa</text></form></variant>
    <variant><form lang="kqs"><text>sɔɔlaalan</text></form></variant>
    <sense id="sɔɔluuo_3177_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>broder</text></gloss>
      <gloss lang="en"><text>embroider</text></gloss>
