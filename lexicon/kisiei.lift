    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sofɛlɛa</text></form></field>
    <variant><form lang="kqs"><text>sufelɔ</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="sofɛlɔɔ_4674_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>âne</text></gloss>
      <gloss lang="en"><text>donkey</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.22.5; Keita 1979, p. 137: Sofèlöö; Paulme 1964, p. 94 (G/K): sɔfelɔ /G./, sufelɔ /K./, pl. sufemsa; Lexique kissi–français, p. 50: sofɛlɔɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : sɔfelɔ /G./, sufelɔ /K./, pl. sufemsa (p. 94).</text></form></note>
  </entry>
  <entry id="sòké_4675">
