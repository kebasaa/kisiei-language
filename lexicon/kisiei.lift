  </entry>
  <entry id="dolinnde_364">
    <lexical-unit><form lang="kqs"><text>dolinnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="dolinnde_364_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hameçon</text></gloss>
      <gloss lang="en"><text>fish hook</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.40.25; Keita 1979, p. 156: Dolinnde</text></form></note>
  </entry>
  <entry id="domaa_365">
    <lexical-unit><form lang="kqs"><text>domaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>domalan</text></form></field>
    <variant><form lang="kqs"><text>doma</text></form></variant>
    <variant><form lang="kqs"><text>domala</text></form></variant>
    <sense id="domaa_365_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chemise, vêtement ; vêtement, habit, manteau</text></gloss>
      <gloss lang="en"><text>shirt, garment ; garment, clothing, cloak</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shirt, gown, robe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.39.12; Keita 1979, p. 144: Domaa; Childs 2000, p. 86: dòmàá</text></form></note>
  </entry>
  <entry id="dombio_366">
    <lexical-unit><form lang="kqs"><text>dombio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dombi</text></form></variant>
    <variant><form lang="kqs"><text>dombinin</text></form></variant>
    <sense id="dombio_366_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>goûter</text></gloss>
      <gloss lang="en"><text>taste</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.10.10; Childs 2000, p. 71: dèmbìó</text></form></note>
    <note><form lang="fr"><text>Childs : dèmbìó, dont dèèmbùùwó (cf. deembuuo) est le pluriel. a dombinin mɛnndan a lediɛɛmu « ceux qui laperont l'eau avec la langue » (Jg 7,5).</text></form></note>
  </entry>
  <entry id="doolaa_367">
    <lexical-unit><form lang="kqs"><text>doolaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doola</text></form></variant>
    <variant><form lang="kqs"><text>doolala</text></form></variant>
    <sense id="doolaa_367_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pressoir (à vin)</text></gloss>
      <gloss lang="en"><text>winepress</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JDG.6.11</text></form></note>
  </entry>
  <entry id="doosulen_368">
    <lexical-unit><form lang="kqs"><text>doosulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doosule</text></form></variant>
    <sense id="doosulen_368_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse</text></gloss>
      <gloss lang="en"><text>hunting, the hunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.25.29; Childs 2000, p. 87: dòòsùléŋ</text></form></note>
    <note><form lang="fr"><text>kɔɛ doosulen « aller à la chasse ». Cf. doosunɔɔ « chasseur ».</text></form></note>
  </entry>
  <entry id="doosunɔɔ_369">
    <lexical-unit><form lang="kqs"><text>doosunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="doosunɔɔ_369_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur, oiseleur</text></gloss>
      <gloss lang="en"><text>hunter, fowler</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.1.17; Keita 1979, p. 145: Doosunöö; Childs 2000, p. 87: dòòsùnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="dovin_370">
    <lexical-unit><form lang="kqs"><text>dovin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dovin_370_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se parer, s'équiper</text></gloss>
      <gloss lang="en"><text>adorn oneself, equip oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.40.10</text></form></note>
    <note><form lang="fr"><text>Moyen de dovio. ɲɛm kɛndɛn n'dovin-ndon « tes belles parures » (Ez 16,39).</text></form></note>
  </entry>
  <entry id="dovio_371">
    <lexical-unit><form lang="kqs"><text>dovio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dovi</text></form></variant>
    <sense id="dovio_371_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>charger (une bête) ; atteler, équiper ; revêtir (d'une armure)</text></gloss>
      <gloss lang="en"><text>load (an animal); harness, equip; clothe (in armour)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2KI.9.21</text></form></note>
  </entry>
  <entry id="downun_372">
    <lexical-unit><form lang="kqs"><text>downun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>downunnin</text></form></variant>
    <variant><form lang="kqs"><text>downɔnndo</text></form></variant>
    <sense id="downun_372_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>informer, donner des nouvelles (downun X kona « raconter à X »)</text></gloss>
      <gloss lang="en"><text>inform, report (downun X kona 'tell X the news')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first GEN.24.66</text></form></note>
  </entry>
  <entry id="duaa_373">
    <lexical-unit><form lang="kqs"><text>duaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="duaa_373_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bénédiction ; bonheur</text></gloss>
      <gloss lang="en"><text>blessing; happiness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 384 occurrences, first GEN.1.22</text></form></note>
  </entry>
  <entry id="dulunndo_374">
    <lexical-unit><form lang="kqs"><text>dulunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dulunndo_374_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coude</text></gloss>
      <gloss lang="en"><text>elbow</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Dulunndo; Childs 2000, p. 91: dùŋndó</text></form></note>
  </entry>
  <entry id="dúmbú_375">
    <lexical-unit><form lang="kqs"><text>dúmbú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dúmbú_375_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trahison ; (yii … dúmbú) trahir, tromper</text></gloss>
      <gloss lang="en"><text>treachery; (yii … dúmbú) betray, deceive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.21.23</text></form></note>
  </entry>
  <entry id="dumbu kilitia_376">
    <lexical-unit><form lang="kqs"><text>dumbu kilitia</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dumbu kilitia_376_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>religion chrétienne (Keita)</text></gloss>
      <gloss lang="en"><text>Christian religion (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Dumbu kilitia</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, dúmbú signifie « tromperie, ruse » (Gn 27,36) ; forme et sens à confirmer.</text></form></note>
  </entry>
  <entry id="dundoo_377">
