  <entry id="fan_929">
    <lexical-unit><form lang="kqs"><text>fan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fan_929_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rapide, prompt</text></gloss>
      <gloss lang="en"><text>quick, prompt</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: fan</text></form></note>
  </entry>
  <entry id="fandaa_930">
    <lexical-unit><form lang="kqs"><text>fandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fanda</text></form></variant>
    <variant><form lang="kqs"><text>faandia</text></form></variant>
    <sense id="fandaa_930_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner en présent, offrir ; (nom) présent, cadeau ; (faandia) distribuer des présents ; cadeau de bienvenue (offert à un hôte)</text></gloss>
      <gloss lang="en"><text>give as a present, offer; (noun) gift, present; (faandia) hand out gifts; welcome gift (for a guest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>give as a gift; (noun) gift, present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2SA.11.8; Lexique kissi–français, p. 15: fandaa/ fanda; Childs 2000, p. 97: fàndàá</text></form></note>
    <note><form lang="fr"><text>Mó fanda Abimelɛk « il en fit présent à Abimélek » (GEN.21.27) ; masaa koma soli fandaa pum « un présent de la part du roi » (2SA.11.8) ; mó faandia vannda ɲɛm kɛndɛn « il distribua des présents » (EST.2.18 ; Childs p. 94 fààndìá). Lexique kissi–français, p. 14-15 : fandaa/fanda « donner un cadeau » ; fandaa « un don offert à un étranger, le cadeau donné à l'invité » ; fandalan « les cadeaux de bienvenue ».</text></form></note>
  </entry>
  <entry id="fando-fando_931">
    <lexical-unit><form lang="kqs"><text>fando-fando</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fando-fando_931_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sans force, défaillant</text></gloss>
      <gloss lang="en"><text>faint, without strength</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.29.8</text></form></note>
    <note><form lang="fr"><text>muungu fando-fando maa n'vanlaandu « devenir comme des femmes » (Jr 50,37).</text></form></note>
  </entry>
  <entry id="fàngà-kundaa_932">
    <lexical-unit><form lang="kqs"><text>fàngà-kundaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fàngà-kundaa_932_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foule, multitude</text></gloss>
      <gloss lang="en"><text>crowd, multitude</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crowd, assembly, group of people</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.17.5; Childs 2000, p. 98: fàŋgàá</text></form></note>
  </entry>
  <entry id="fangaa_933">
    <lexical-unit><form lang="kqs"><text>fangaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fangaa_933_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>force, puissance, autorité</text></gloss>
      <gloss lang="en"><text>strength, power, authority</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fangaa</text></form></note>
    <note><form lang="fr"><text>Emprunt probable (malinké fanga).</text></form></note>
  </entry>
  <entry id="fanndo_934">
    <lexical-unit><form lang="kqs"><text>fanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fanndo_934_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lance, épée</text></gloss>
      <gloss lang="en"><text>spear, sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fanndo</text></form></note>
    <note><form lang="fr"><text>Homographe de fanndo « quitter » noté à la même page (forme abrégée de faŋanndo).</text></form></note>
  </entry>
  <entry id="fasa fasan_935">
    <lexical-unit><form lang="kqs"><text>fasa fasan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fasa fasan_935_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bruine, nuage de gouttelettes</text></gloss>
      <gloss lang="en"><text>drizzle, spray of droplets</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fasa fasan</text></form></note>
    <note><form lang="fr"><text>Cf. le méridional fásáfásáléŋ « gouttes de pluie poussées par le vent » (Childs).</text></form></note>
  </entry>
  <entry id="fasaa_936">
    <lexical-unit><form lang="kqs"><text>fasaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fasaa_936_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>muscle</text></gloss>
      <gloss lang="en"><text>muscle</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fasaa</text></form></note>
  </entry>
  <entry id="fásáfásáléŋ_937">
    <lexical-unit><form lang="kqs"><text>fásáfásáléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fásáfásǎŋ</text></form></field>
    <sense id="fásáfásáléŋ_937_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouttes de pluie poussées par le vent sous un abri</text></gloss>
      <gloss lang="en"><text>raindrops blown in under a shelter</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 98: fásáfásáléŋ</text></form></note>
  </entry>
  <entry id="fasaka-fasaka_938">
    <lexical-unit><form lang="kqs"><text>fasaka-fasaka</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasaka-fasaka_938_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en bouillonnant, tumultueusement (eaux)</text></gloss>
      <gloss lang="en"><text>surging, turbulently (water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>quickly, roughly, in a tumbling manner</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first AMO.8.8; Childs 2000, p. 98: fásàkà-fásàkà</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : mɛnndan ma fula fasaka-fasaka « les eaux se soulèvent » (AMO.8.8).</text></form></note>
  </entry>
  <entry id="fásàn_939">
    <lexical-unit><form lang="kqs"><text>fásàn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fásàn_939_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>çà et là, de tous côtés (disperser)</text></gloss>
      <gloss lang="en"><text>abroad, in all directions (scatter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread about</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.49.7; Childs 2000, p. 99: fásáŋ-fásáŋ</text></form></note>
    <note><form lang="fr"><text>saŋ … fásàn « disperser ».</text></form></note>
  </entry>
  <entry id="fasaŋa_940">
    <lexical-unit><form lang="kqs"><text>fasaŋa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fasaŋanin</text></form></variant>
    <variant><form lang="kqs"><text>fasaŋan</text></form></variant>
    <variant><form lang="kqs"><text>fasaŋanndo</text></form></variant>
    <sense id="fasaŋa_940_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger ; secouer (pour faire tomber) ; (fasaŋanndo) se déployer</text></gloss>
      <gloss lang="en"><text>sprinkle; shake off; (fasaŋanndo) spread out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>splash, sprinkle; throw down, sow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ACT.28.5; Childs 2000, p. 98: fàsàŋàá</text></form></note>
    <note><form lang="fr"><text>Singulier de fasaŋiaa. Mí Pol fasaŋa kɛw kon o yin « Paul secoua la bête dans le feu » (ACT.28.5) ; kooma ndɔma fasaŋan-ndan « son sang répandu par aspersion » (HEB.12.24).</text></form></note>
  </entry>
  <entry id="fasaŋiaa_941">
    <lexical-unit><form lang="kqs"><text>fasaŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasaŋiaa_941_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger, répandre (en aspergeant)</text></gloss>
      <gloss lang="en"><text>sprinkle, splash</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.24.6; Childs 2000, p. 99: fàsàŋìá</text></form></note>
  </entry>
  <entry id="fasɛi_942">
    <lexical-unit><form lang="kqs"><text>fasɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasɛi_942_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, sans retour (voué, consacré)</text></gloss>
      <gloss lang="en"><text>wholly, irrevocably (devoted, given)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first LEV.27.28</text></form></note>
  </entry>
  <entry id="fáú-fáú_943">
    <lexical-unit><form lang="kqs"><text>fáú-fáú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fáú-fáú_943_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en désordre, éparpillé (cheveux défaits, gestes de colère)</text></gloss>
      <gloss lang="en"><text>spread about, loose (hair let down, angry waving)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 99: fáú-fáú</text></form></note>
  </entry>
  <entry id="faw_944">
    <lexical-unit><form lang="kqs"><text>faw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="faw_944_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tous, entièrement</text></gloss>
      <gloss lang="en"><text>all, completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'a lot, everywhere'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 192 occurrences, first GEN.8.17; Lexique kissi–français, p. 15: fau; Childs 2000, p. 99: fáù</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 15 : fau « tout ».</text></form></note>
  </entry>
  <entry id="fayaa_945">
    <lexical-unit><form lang="kqs"><text>fayaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="fayaa_945_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dynamite</text></gloss>
      <gloss lang="en"><text>dynamite, explosive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Fayaa; Lexique kissi–français, p. 15: fayaa</text></form></note>
