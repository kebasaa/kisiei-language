    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dòkìláŋ</text></form></field>
    <sense id="dòkìó_1129_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petits cailloux (punition des candidats à l'initiation)</text></gloss>
      <gloss lang="en"><text>small stones (used to punish initiation candidates)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 86: dòkìó</text></form></note>
  </entry>
  <entry id="dokpo_1130">
    <lexical-unit><form lang="kqs"><text>dokpo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>dukpo</text></form></variant>
    <variant><form lang="kqs"><text>dukpo</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="dokpo_1130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz paddy (?)</text></gloss>
      <gloss lang="en"><text>paddy rice (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 20 (K): dogbo /K./, dugbo /G./</text></form></note>
    <note><form lang="fr"><text>Paulme glose « poddy », sans doute « paddy » ; dugbo /G./. Sens à confirmer. Paulme : dogbo /K./, dugbo /G./ (p. 20).</text></form></note>
  </entry>
  <entry id="dòkpòó_1131">
    <lexical-unit><form lang="kqs"><text>dòkpòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dòkpòláŋ</text></form></field>
