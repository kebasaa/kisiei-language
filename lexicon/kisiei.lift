      <gloss lang="fr"><text>corbeille</text></gloss>
      <gloss lang="en"><text>basket</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpɛndo</text></form></note>
  </entry>
  <entry id="kpɛndon_2032">
    <lexical-unit><form lang="kqs"><text>kpɛndon</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kpɛndon_2032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peigne (d'homme)</text></gloss>
