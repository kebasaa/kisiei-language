    <trait name="status" value="attested"/>
    <sense id="vannun_3597_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être, rester, demeurer</text></gloss>
      <gloss lang="en"><text>be, remain, dwell</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 120 occurrences, first GEN.13.10</text></form></note>
    <note><form lang="fr"><text>Moyen de va « être ».</text></form></note>
