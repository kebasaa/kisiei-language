    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.33.15; Keita 1979, p. 152: Haw; Childs 2000, p. 118: háù</text></form></note>
  </entry>
  <entry id="hawnɔnndo_504">
    <lexical-unit><form lang="kqs"><text>hawnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hawnun</text></form></variant>
    <sense id="hawnɔnndo_504_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se bloquer ; se porter garant</text></gloss>
      <gloss lang="en"><text>get stuck; stand surety</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck</text></form></field>
