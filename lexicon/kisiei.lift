      <gloss lang="en"><text>straight, right (… sendu le 'unjust, crooked')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be straight; be honest; (of a lamp or fire) be bright</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 45 occurrences, first JOB.27.7; Childs 2000, p. 320: sàndɔ̀ɔ́</text></form></note>
