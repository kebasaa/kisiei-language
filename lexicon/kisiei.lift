  <entry id="landei_2348">
    <lexical-unit><form lang="kqs"><text>landei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>landii</text></form></variant>
    <sense id="landei_2348_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gage, nantissement</text></gloss>
      <gloss lang="en"><text>pledge, pawn, security</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pawn, guarantee; also a person indentured for a debt</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.38.17; Childs 2000, p. 223: làndéí</text></form></note>
    <note><form lang="fr"><text>o landei nin « en gage » (EXO.22.25) ; landii ndɔɛi « son gage » (DEU.24.12).</text></form></note>
  </entry>
  <entry id="làndìáŋ_2349">
    <lexical-unit><form lang="kqs"><text>làndìáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>làndìléŋ</text></form></field>
    <sense id="làndìáŋ_2349_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>suie</text></gloss>
      <gloss lang="en"><text>soot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 223: làndìáŋ</text></form></note>
  </entry>
  <entry id="landìlandìo_2350">
    <lexical-unit><form lang="kqs"><text>landìlandìo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="landìlandìo_2350_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écume, bave (à la bouche) ; (vanalanɔ landilandio) femme querelleuse</text></gloss>
      <gloss lang="en"><text>foam, froth (at the mouth); (vanalanɔ landilandio) quarrelsome woman</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PRO.21.19; Childs 2000, p. 223: làndìlàndìóó</text></form></note>
    <note><form lang="fr"><text>landìlandìo fula ndu o sondo « il écume » (MRK.9.20).</text></form></note>
  </entry>
  <entry id="landɔɔ_2351">
    <lexical-unit><form lang="kqs"><text>landɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>landu</text></form></variant>
    <variant><form lang="kqs"><text>landun</text></form></variant>
    <variant><form lang="kqs"><text>landunin</text></form></variant>
    <sense id="landɔɔ_2351_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>suspendre, pendre ; (hɔlla landɔɔ … coo) veiller sur, avoir la charge de</text></gloss>
      <gloss lang="en"><text>hang, suspend; (hɔlla landɔɔ … coo) watch over, be in charge of</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first GEN.30.31; Lexique kissi–français, p. 31: landɔɔ/ landu; Childs 2000, p. 223: làndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>o co nɔm landɔɔ o yɔm bɛndoo « il te pendra à un arbre » (GEN.40.19) ; hɔlla landɔɔ o Calta Mɛlɛka coo « avoir la charge du Tabernacle » (NUM.3.25). Lexique kissi–français, p. 31 : landɔnndo/ landun « s'accrocher, se suspendre ».</text></form></note>
  </entry>
  <entry id="langa_2352">
    <lexical-unit><form lang="kqs"><text>langa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="langa_2352_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout juste, déjà, il y a peu</text></gloss>
      <gloss lang="en"><text>just, already, a moment ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note><form lang="fr"><text>ndu bɛɛ langa tiiya ciee sunsun « il vient d'arriver en ville » (1 S 9,12).</text></form></note>
  </entry>
  <entry id="langbanɔɔ_2353">
    <lexical-unit><form lang="kqs"><text>langbanɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>langbaa</text></form></field>
    <variant><form lang="kqs"><text>langbanɔ</text></form></variant>
    <sense id="langbanɔɔ_2353_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>homme (adulte) ; (au pluriel) hommes, compagnons</text></gloss>
      <gloss lang="en"><text>man (adult male); (pl.) men, followers</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 177 occurrences, first GEN.24.30</text></form></note>
  </entry>
  <entry id="lánìbɔ̀kùèìyó_2354">
    <lexical-unit><form lang="kqs"><text>lánìbɔ̀kùèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lánìbɔ̀kùèìyó_2354_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand masque (« diable ») dansant sur échasses</text></gloss>
      <gloss lang="en"><text>tall dancing mask ('devil') on stilts</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 223: lánìbɔ̀kùèìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au bandi.</text></form></note>
  </entry>
  <entry id="lànìíyó_2355">
    <lexical-unit><form lang="kqs"><text>lànìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>lànèìyó</text></form></variant>
    <sense id="lànìíyó_2355_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>route</text></gloss>
      <gloss lang="en"><text>road</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 223: lànìíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt probable selon Childs.</text></form></note>
  </entry>
  <entry id="lanɔɔ_2356">
    <lexical-unit><form lang="kqs"><text>lanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>laandua</text></form></field>
    <sense id="lanɔɔ_2356_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épouse, femme</text></gloss>
      <gloss lang="en"><text>wife</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>woman, wife</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 193 occurrences, first GEN.11.29; Keita 1979, p. 134: Lanöö; Lexique kissi–français, p. 31: lanɔɔ; Childs 2000, p. 221: lààndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 31 : aussi laandɔ, laanuu « la femme ».</text></form></note>
  </entry>
  <entry id="lapi_2357">
    <lexical-unit><form lang="kqs"><text>lapi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lapi_2357_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bien, clairement, de près ; beaucoup ; mieux</text></gloss>
      <gloss lang="en"><text>well, clearly, closely; much; better</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first EXO.3.3; Lexique kissi–français, p. 45: rapi</text></form></note>
    <note><form lang="fr"><text>o ve lɛ cɔ lapi le « il ne voyait plus bien » (1 S 3,2) ; tofa … lapi « regarder de près » (Ex 3,3). Lexique kissi–français, p. 45 écrit rapi.</text></form></note>
  </entry>
  <entry id="lapitaa_2358">
    <lexical-unit><form lang="kqs"><text>lapitaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lapitaa_2358_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hôpital</text></gloss>
      <gloss lang="en"><text>hospital</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: lapitaa</text></form></note>
  </entry>
  <entry id="lapɔw_2359">
    <lexical-unit><form lang="kqs"><text>lapɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lapɔw_2359_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égarement, tromperie ; piège</text></gloss>
      <gloss lang="en"><text>error, deception; snare</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first MAT.11.6</text></form></note>
    <note><form lang="fr"><text>luɛi o lapɔw nin « se laisser tromper, tomber dans l'erreur » (Ga 6,7 ; He 3,13). Cf. pɔw « s'égarer, faillir ».</text></form></note>
  </entry>
  <entry id="lasa_2360">
    <lexical-unit><form lang="kqs"><text>lasa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lasa_2360_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faiblesse ; faible</text></gloss>
      <gloss lang="en"><text>weakness; weak</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: lasa</text></form></note>
  </entry>
  <entry id="lasalaa_2361">
    <lexical-unit><form lang="kqs"><text>lasalaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lasalaa_2361_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>faiblement</text></gloss>
      <gloss lang="en"><text>weakly</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: lasalaa</text></form></note>
    <note><form lang="fr"><text>Homographe de lasálàá (Bible), d'un autre sens.</text></form></note>
  </entry>
  <entry id="lasikɔlɔɔ_2362">
    <lexical-unit><form lang="kqs"><text>lasikɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="lasikɔlɔɔ_2362_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parfum, aromates</text></gloss>
