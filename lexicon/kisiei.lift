      <gloss lang="en"><text>jerky, bouncy motion (a dancer's buttocks, rice being fanned)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 100: féí-féí</text></form></note>
  </entry>
  <entry id="feke-feke_839">
