    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: karan te</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit karan te ; à confirmer.</text></form></note>
  </entry>
  <entry id="kàlándéfù_1427">
    <lexical-unit><form lang="kqs"><text>kàlándéfù</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kàlándéfùá</text></form></field>
    <sense id="kàlándéfù_1427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>belle-mère (mère de l'épouse)</text></gloss>
      <gloss lang="en"><text>mother-in-law (wife's mother)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 145: kàlándéfù kàlándéfùá</text></form></note>
  </entry>
  <entry id="kalangɛnɔɔ_1428">
    <lexical-unit><form lang="kqs"><text>kalangɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kalangɛnɔɔ_1428_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cordonnier</text></gloss>
      <gloss lang="en"><text>shoemaker</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Kalangènöö; Lexique kissi–français, p. 21: kalangɛnɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 22 : aussi karankɛnɔɔ « celui qui fait le cuir ou les chaussures ».</text></form></note>
  </entry>
  <entry id="kalankafoo_1429">
    <lexical-unit><form lang="kqs"><text>kalankafoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kalankafo</text></form></variant>
    <sense id="kalankafoo_1429_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>revenant, esprit d'un mort</text></gloss>
      <gloss lang="en"><text>ghost, spirit of the dead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ghost of a dead person not yet among the ancestors</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kalankafoo; Lexique kissi–français, p. 21: kalankafoo; Childs 2000, p. 269: ŋàlàŋàfɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale attestée : diom kalankafo « la voix d'un revenant » (Is 29,4).</text></form></note>
  </entry>
  <entry id="kalaŋaa_1430">
    <lexical-unit><form lang="kqs"><text>kalaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kalaŋan</text></form></variant>
    <variant><form lang="kqs"><text>kalaŋanin</text></form></variant>
    <variant><form lang="kqs"><text>kalaŋanndo</text></form></variant>
    <sense id="kalaŋaa_1430_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être déterré, mis à nu, retourné ; arracher, faire sortir</text></gloss>
      <gloss lang="en"><text>be dug up, laid bare, turned up; pull out, bring up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.6 Dig"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(middle of 'dig up') be dug up, uprooted</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.28.5; Childs 2000, p. 145: kàlàŋndó</text></form></note>
    <note><form lang="fr"><text>lɛŋnde tumnden le kalaŋan « les fondements du monde furent mis à nu » (2SA.22.16) ; Hala kalaŋanin mun ndu o dembe « Dieu les fera sortir de son ventre » (JOB.20.15). Cf. kalaa « déterrer ».</text></form></note>
  </entry>
  <entry id="kàláŋndó_1431">
    <lexical-unit><form lang="kqs"><text>kàláŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kàláŋndó_1431_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hotte en fibre de palmier (« kinja ») ; fétiche porté au cou ou à la taille ; remède contre le béribéri</text></gloss>
      <gloss lang="en"><text>palm-fibre hamper ('kinja'); fetish worn at the neck or waist; remedy for beriberi</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 145: kàláŋndó</text></form></note>
  </entry>
  <entry id="kalialahɔllo_1432">
    <lexical-unit><form lang="kqs"><text>kalialahɔllo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kalialahɔllo_1432_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte fouisseur (qui s'attaque aux yeux)</text></gloss>
      <gloss lang="en"><text>burrowing insect (said to attack the eyes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: karialahɔllo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit karialahɔllo « un insecte qui creuse, enlève les yeux ».</text></form></note>
  </entry>
  <entry id="kalio_1433">
    <lexical-unit><form lang="kqs"><text>kalio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kale</text></form></variant>
    <sense id="kalio_1433_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>caler (qqch pour qu'il ne bouge pas)</text></gloss>
      <gloss lang="en"><text>wedge, brace (so it does not move)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kalio/ kale</text></form></note>
  </entry>
  <entry id="kallante_1434">
    <lexical-unit><form lang="kqs"><text>kallante</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kallante_1434_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>particulièrement</text></gloss>
      <gloss lang="en"><text>particularly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kallante</text></form></note>
  </entry>
  <entry id="kallɛɔ_1435">
    <lexical-unit><form lang="kqs"><text>kallɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kallɛɔ_1435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>belle-mère</text></gloss>
      <gloss lang="en"><text>mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kallɛɔ</text></form></note>
  </entry>
  <entry id="kaloo_1436">
    <lexical-unit><form lang="kqs"><text>kaloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kalu</text></form></variant>
    <variant><form lang="kqs"><text>kalua</text></form></variant>
    <variant><form lang="kqs"><text>kalula</text></form></variant>
    <variant><form lang="kqs"><text>kalulan</text></form></variant>
    <sense id="kaloo_1436_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dur ; difficile ; (nila kalua) têtus</text></gloss>
      <gloss lang="en"><text>hard; difficult; (nila kalua) stubborn</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hard, difficult; also sharp, strong, effective; ripe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.21; Childs 2000, p. 144: kàlà-</text></form></note>
  </entry>
  <entry id="kaluo_1437">
    <lexical-unit><form lang="kqs"><text>kaluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kala</text></form></variant>
    <sense id="kaluo_1437_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dur, difficile</text></gloss>
      <gloss lang="en"><text>hard, difficult</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: karuo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit karuo « dur » et kara « difficile, dur ».</text></form></note>
  </entry>
  <entry id="kalɔɔ_1438">
    <lexical-unit><form lang="kqs"><text>kalɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kalɔɔ_1438_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vert, pas encore mûr</text></gloss>
      <gloss lang="en"><text>green, unripe</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kalɔɔ</text></form></note>
  </entry>
  <entry id="kamaa_1439">
    <lexical-unit><form lang="kqs"><text>kamaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kamaa_1439_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éléphant</text></gloss>
      <gloss lang="en"><text>elephant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first 1SA.14.45; Keita 1979, p. 136: Kamaa; Lexique kissi–français, p. 21: kamaa; Childs 2000, p. 145: kàmàá</text></form></note>
    <note><form lang="fr"><text>Ne pas confondre avec l'interrogatif kámáá. Lexique kissi–français, p. 21 : kamaa « l'éléphant, l'hippopotame ».</text></form></note>
  </entry>
  <entry id="kamaa_1440">
    <lexical-unit><form lang="kqs"><text>kamaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kamaa_1440_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cercle de gens assis (pour jouer ou raconter une histoire)</text></gloss>
      <gloss lang="en"><text>circle of people sitting (to play or tell a story)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kamaa</text></form></note>
    <note><form lang="fr"><text>Homographe de kamaa « éléphant » ; à confirmer.</text></form></note>
  </entry>
  <entry id="kàmàcíŋndó_1441">
    <lexical-unit><form lang="kqs"><text>kàmàcíŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kàmàcíŋndó_1441_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat à trompe (musaraigne-éléphant)</text></gloss>
      <gloss lang="en"><text>elephant rat (long-nosed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 146: kàmàcíŋndó</text></form></note>
  </entry>
  <entry id="kamadolaa_1442">
    <lexical-unit><form lang="kqs"><text>kamadolaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kamadolaa_1442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cire d'abeille</text></gloss>
      <gloss lang="en"><text>beeswax</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kamadolaa</text></form></note>
    <note><form lang="fr"><text>La Bible a kamadolaa une fois (REV.18.13), en tête d'une liste d'aromates (cannelle ?) ; le sens « cire d'abeille » du Lexique est à confirmer.</text></form></note>
  </entry>
  <entry id="kamafoeinɔɔ_1443">
    <lexical-unit><form lang="kqs"><text>kamafoeinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kamafoeinɔɔ_1443_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>photographe</text></gloss>
      <gloss lang="en"><text>photographer</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Kamafoeinöö; Lexique kissi–français, p. 21: kamafoeinɔɔ</text></form></note>
  </entry>
  <entry id="kamalindonden_1444">
    <lexical-unit><form lang="kqs"><text>kamalindonden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kamalindonden_1444_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balançoire</text></gloss>
      <gloss lang="en"><text>swing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kamalindonden</text></form></note>
  </entry>
  <entry id="kamalindoŋnden_1445">
    <lexical-unit><form lang="kqs"><text>kamalindoŋnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="kamalindoŋnden_1445_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balançoire</text></gloss>
      <gloss lang="en"><text>swing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swing, usually made of vines</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Kamalindonden; Childs 2000, p. 146: kàmálíndóŋndó</text></form></note>
    <note><form lang="fr"><text>ŋ d'après Childs.</text></form></note>
  </entry>
  <entry id="kàmásɔ̀lɔ́ŋndó_1446">
    <lexical-unit><form lang="kqs"><text>kàmásɔ̀lɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kàmásɔ̀lɔ́ŋndó_1446_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz (née, dit-on, d'une bouse d'éléphant)</text></gloss>
      <gloss lang="en"><text>variety of rice (said to have first grown from elephant dung)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 146: kàmásɔ̀lɔ́ŋndó</text></form></note>
  </entry>
  <entry id="kàmàtìkèíyó_1447">
    <lexical-unit><form lang="kqs"><text>kàmàtìkèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kàmàtìkèíyó_1447_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>légume-feuille (genre chou vert), graines pour la sauce</text></gloss>
      <gloss lang="en"><text>leafy vegetable like collard greens, seeds used for sauce</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 146: kàmàtìkèíyó</text></form></note>
  </entry>
  <entry id="kambalaa_1448">
    <lexical-unit><form lang="kqs"><text>kambalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kambalaa_1448_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte ; sauterelle</text></gloss>
      <gloss lang="en"><text>insect; grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large edible grasshopper</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first LEV.11.20; Keita 1979, p. 136: Kambalaa; Lexique kissi–français, p. 21: kanbalaa; Childs 2000, p. 146: kàmbàlàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 21 : kanbalaa « la sauterelle ».</text></form></note>
  </entry>
  <entry id="kambɛiyo_1449">
    <lexical-unit><form lang="kqs"><text>kambɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kambɛilan</text></form></field>
    <sense id="kambɛiyo_1449_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>panier</text></gloss>
      <gloss lang="en"><text>basket</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>large basket, hamper</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.2.3; Keita 1979, p. 159: Kambèiyo; Lexique kissi–français, p. 21: kanbɛiyo; Childs 2000, p. 146: kàmbɛ́íyó</text></form></note>
  </entry>
  <entry id="kamɔyɛi_1450">
    <lexical-unit><form lang="kqs"><text>kamɔyɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kamɔyɛi_1450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amitié, amour</text></gloss>
      <gloss lang="en"><text>friendship, love</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kamɔyɛi</text></form></note>
  </entry>
  <entry id="kan_1451">
    <lexical-unit><form lang="kqs"><text>kan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kan_1451_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces…-là (personnes)</text></gloss>
      <gloss lang="en"><text>those (persons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>these (a class), labelled proximal</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1321 occurrences, first GEN.6.4; Childs 2000, p. 148: kàŋ</text></form></note>
  </entry>
  <entry id="kanalanndo_1452">
    <lexical-unit><form lang="kqs"><text>kanalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kanalan</text></form></variant>
    <variant><form lang="kqs"><text>kanalannda</text></form></variant>
    <variant><form lang="kqs"><text>kanalanndan</text></form></variant>
    <sense id="kanalanndo_1452_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avertir, mettre en garde, réprimander ; (pl. kanalannda) avertissements</text></gloss>
      <gloss lang="en"><text>warn, admonish, rebuke; (pl. kanalannda) warnings</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first NUM.17.3</text></form></note>
  </entry>
  <entry id="kanapeo_1453">
    <lexical-unit><form lang="kqs"><text>kanapeo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kanapeo_1453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canapé, dais</text></gloss>
      <gloss lang="en"><text>sofa, canopy</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 21: kanapeo</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="kanda_1454">
    <lexical-unit><form lang="kqs"><text>kanda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kandanin</text></form></variant>
    <variant><form lang="kqs"><text>kandaa</text></form></variant>
    <sense id="kanda_1454_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, protéger</text></gloss>
      <gloss lang="en"><text>guard, protect</text></gloss>
