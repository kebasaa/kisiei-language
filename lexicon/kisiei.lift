    <trait name="status" value="southern"/>
    <sense id="sɔ̀ɔ́yúùwó_3800_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poule aux plumes ébouriffées</text></gloss>
      <gloss lang="en"><text>chicken with ruffled feathers</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.6 Poultry raising"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 341: sɔ̀ɔ́yúùwó</text></form></note>
