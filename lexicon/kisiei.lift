    <variant><form lang="kqs"><text>voliei</text></form></variant>
    <sense id="volion_3639_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argent (métal, monnaie)</text></gloss>
      <gloss lang="en"><text>silver, money</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 187 occurrences, first GEN.13.2; Keita 1979, p. 149: Volion</text></form></note>
  </entry>
  <entry id="vólotótoo_3640">
    <lexical-unit><form lang="kqs"><text>vólotótoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vólotótolan</text></form></field>
    <sense id="vólotótoo_3640_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>écarlate, rouge vif</text></gloss>
      <gloss lang="en"><text>scarlet</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.26.1</text></form></note>
    <note><form lang="fr"><text>Le pourpre est sɔɔtɔtɔɔ (Mc 15,17) ; vólotótoo est l'écarlate (Ap 17,4).</text></form></note>
  </entry>
  <entry id="volɔɔ_3641">
    <lexical-unit><form lang="kqs"><text>volɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>volɔɔlan</text></form></field>
    <variant><form lang="kqs"><text>volɔɔla</text></form></variant>
    <sense id="volɔɔ_3641_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charge, fardeau ; vêtement, habit (volɔɔ cuɛinan « vêtement »)</text></gloss>
      <gloss lang="en"><text>load, burden; garment, clothing (volɔɔ cuɛinan 'garment')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tool, implement; (pl.) loads</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first LEV.11.32; Childs 2000, p. 388: wòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>volɔɔla « charges » (GEN.24.32) et « vêtements » (LEV.19.19) ; volɔɔ lusulaa « joug pesant » (1KI.12.14).</text></form></note>
  </entry>
  <entry id="vomullo_3642">
    <lexical-unit><form lang="kqs"><text>vomullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vomul</text></form></variant>
    <variant><form lang="kqs"><text>vomulaa</text></form></variant>
    <sense id="vomullo_3642_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>filer (le coton, la laine) ; (vomulaa) fileuse, quenouille</text></gloss>
      <gloss lang="en"><text>spin (thread); (vomulaa) spinner, spindle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spin cotton, weave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.35.25; Childs 2000, p. 388: wòmùlló</text></form></note>
    <note><form lang="fr"><text>vanlaandua caa vomullo-a « les femmes habiles à filer » (EXO.35.25) ; bala ndɔlan la sanga a vomullo « ses mains tiennent la quenouille » (PRO.31.19) ; vanaa vomulaa (2SA.3.29).</text></form></note>
  </entry>
  <entry id="vomɔɔ_3643">
    <lexical-unit><form lang="kqs"><text>vomɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viomɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>viomnun</text></form></variant>
    <sense id="vomɔɔ_3643_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>envoyer (qqn), dépêcher ; charger, ordonner</text></gloss>
      <gloss lang="en"><text>send (someone), dispatch; charge, command</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.18.19; Childs 2000, p. 387: wìòmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>i co nɔm vomɔɔ « je vais t'envoyer » (GEN.37.13) ; Mɛlɛka co nɔm mɛlɛkanɔ ndɔɔ vomɔɔ laci « le Seigneur enverra son ange devant toi » (GEN.24.7). Variante viomɔɔ (EXO.4.13). Cf. viamaa « envoyer ».</text></form></note>
  </entry>
  <entry id="vóólun-vóólunndo_3644">
    <lexical-unit><form lang="kqs"><text>vóólun-vóólunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vóólun-vóólun</text></form></variant>
    <variant><form lang="kqs"><text>vóólun-vóólunn</text></form></variant>
    <sense id="vóólun-vóólunndo_3644_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, clameur</text></gloss>
      <gloss lang="en"><text>tumult, uproar, clamour</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(base verb) start from fright, tremble with fear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EZK.12.18; Childs 2000, p. 389: wòòlòó</text></form></note>
    <note><form lang="fr"><text>Cf. vooluo « tressaillir ».</text></form></note>
  </entry>
  <entry id="vooluo_3645">
    <lexical-unit><form lang="kqs"><text>vooluo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>voolu</text></form></variant>
    <variant><form lang="kqs"><text>voolunin</text></form></variant>
    <sense id="vooluo_3645_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tressaillir ; surprendre, fondre sur</text></gloss>
      <gloss lang="en"><text>startle; take by surprise, fall upon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Vooluo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, voolu signifie « fondre sur, attaquer par surprise » (JOS 10,9).</text></form></note>
  </entry>
  <entry id="voosanndo_3646">
    <lexical-unit><form lang="kqs"><text>voosanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="voosanndo_3646_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entorse</text></gloss>
      <gloss lang="en"><text>sprain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: Voosanndo</text></form></note>
  </entry>
  <entry id="voosu_3647">
    <lexical-unit><form lang="kqs"><text>voosu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>voosun</text></form></variant>
    <sense id="voosu_3647_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figue</text></gloss>
      <gloss lang="en"><text>fig</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fig tree; also a fern-like plant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first NUM.20.5; Childs 2000, p. 389: wòòsóó</text></form></note>
    <note><form lang="fr"><text>voosu tumndo « figuier ».</text></form></note>
  </entry>
  <entry id="vosɛ_3648">
    <lexical-unit><form lang="kqs"><text>vosɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vosɛ_3648_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>salut (adressé à plusieurs) : la vosɛ !</text></gloss>
      <gloss lang="en"><text>greetings (to several people): la vosɛ!</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 21: lavosè; Childs 2000, p. 389: wósè</text></form></note>
    <note><form lang="fr"><text>Keita : isɛ s'adresse à une seule personne, lavosè à deux ou plusieurs. Pluriel de isɛ.</text></form></note>
  </entry>
  <entry id="vowlul_3649">
    <lexical-unit><form lang="kqs"><text>vowlul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vowlulnin</text></form></variant>
    <variant><form lang="kqs"><text>vowlu</text></form></variant>
    <sense id="vowlul_3649_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre (dans), remplir pour (qqn) ; jeter à ; (vowlul X sondo) répondre à X</text></gloss>
      <gloss lang="en"><text>put (into), fill for (someone); throw to; (vowlul X sondo) answer X</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dress someone, put (clothes) on someone; put in for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.44.1; Childs 2000, p. 389: wòùlùlló</text></form></note>
    <note><form lang="fr"><text>Vowlul vannda ha ɲɛdiaa o bɔlɔla ndalan nin « remplis de vivres les sacs de ces hommes » (GEN.44.1) ; Mɛlɛka vowlulnin niaa sondo le « le Seigneur ne vous répondra pas » (1SA.8.18) ; vowlu tunaa cuawva « le jeter aux petits chiens » (MAT.15.26).</text></form></note>
  </entry>
  <entry id="vownun_3650">
    <lexical-unit><form lang="kqs"><text>vownun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vownun_3650_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, revêtir (vêtement, sandales)</text></gloss>
      <gloss lang="en"><text>put on (clothes, sandals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 93 occurrences, first EXO.12.11; Childs 2000, p. 390: wòùwó</text></form></note>
    <note><form lang="fr"><text>Moyen de vowvo.</text></form></note>
  </entry>
  <entry id="vowvo_3651">
    <lexical-unit><form lang="kqs"><text>vowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vow</text></form></variant>
    <variant><form lang="kqs"><text>vownin</text></form></variant>
    <sense id="vowvo_3651_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre dans, verser dans</text></gloss>
      <gloss lang="en"><text>put into, pour into</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put on, wear, fasten</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.42.25; Childs 2000, p. 390: wòùwó</text></form></note>
  </entry>
  <entry id="vueinɔnndo_3652">
    <lexical-unit><form lang="kqs"><text>vueinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vueinun</text></form></variant>
    <variant><form lang="kqs"><text>vueinunnin</text></form></variant>
    <variant><form lang="kqs"><text>vueinɔn</text></form></variant>
    <sense id="vueinɔnndo_3652_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>effrayer, inspirer la terreur ; être redoutable</text></gloss>
      <gloss lang="en"><text>frighten, terrify; be fearsome</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be afraid (middle of 'fear'); variant wèènɔ̌ŋndó, also 'frighten people'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1CH.12.9; Childs 2000, p. 389: wɔ̀ɔ́nɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Cf. vo « craindre ». mɛ̀ɛ́-mɛ̀ɛ́ ya vueinun « ne me crains pas » (JOB.33.7).</text></form></note>
  </entry>
  <entry id="vuilen_3653">
    <lexical-unit><form lang="kqs"><text>vuilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vuilen_3653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vol, larcin</text></gloss>
      <gloss lang="en"><text>theft, stealing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.30.33; Childs 2000, p. 385: wììléŋ</text></form></note>
    <note><form lang="fr"><text>De vuiyo « voleur ». bulio le luɛyɔɔ vuilen « en train d'entrer par effraction pour voler » (EXO.22.1) ; mɛɛ vuilen ya tosa ni « ce serait un vol de ma part » (GEN.30.33) ; o kɔɛ vuilen « il va voler » (JOB.24.14).</text></form></note>
  </entry>
  <entry id="vuiyo_3654">
    <lexical-unit><form lang="kqs"><text>vuiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vuiya</text></form></field>
    <sense id="vuiyo_3654_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voleur</text></gloss>
      <gloss lang="en"><text>thief</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.22.1; Keita 1979, p. 149: Vuiyo; Childs 2000, p. 385: wììnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vukɔɔ_3655">
    <lexical-unit><form lang="kqs"><text>vukɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vukɔɔ_3655_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu où se règlent les affaires du village</text></gloss>
      <gloss lang="en"><text>village meeting place for settling disputes</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Vuköö</text></form></note>
  </entry>
  <entry id="vulan_3656">
    <lexical-unit><form lang="kqs"><text>vulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vulan_3656_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genoux</text></gloss>
      <gloss lang="en"><text>knees</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>knee (singular, le class)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.17.3; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>baŋ vulan « s'agenouiller, se prosterner » (Gn 17,3).</text></form></note>
  </entry>
  <entry id="vulen_3657">
    <lexical-unit><form lang="kqs"><text>vulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>vulan</text></form></field>
    <sense id="vulen_3657_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genou</text></gloss>
      <gloss lang="en"><text>knee</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Vulen; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel vulan attesté : baŋ vulan « s'agenouiller » (Gn 17,3).</text></form></note>
  </entry>
  <entry id="vulɔɔ_3658">
    <lexical-unit><form lang="kqs"><text>vulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vul</text></form></variant>
    <variant><form lang="kqs"><text>vulnin</text></form></variant>
    <sense id="vulɔɔ_3658_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, germer</text></gloss>
      <gloss lang="en"><text>grow, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: thread a needle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.3.18; Childs 2000, p. 392: wùlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vum_3659">
    <lexical-unit><form lang="kqs"><text>vum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vum_3659_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) d'un coup, brusquement (cœur qui bat, feu qui jaillit)</text></gloss>
      <gloss lang="en"><text>(ideophone) suddenly, with a start (pounding heart, fire flaring up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sound of slow regular beating (heartbeat), of a fire being lit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.27.33; Childs 2000, p. 392: wúm</text></form></note>
  </entry>
  <entry id="vunduan_3660">
    <lexical-unit><form lang="kqs"><text>vunduan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vunduma</text></form></variant>
    <sense id="vunduan_3660_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre, ombrage (pluriel de vundulen)</text></gloss>
      <gloss lang="en"><text>shade, shadows (plural of vundulen)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural (ma) of 'shade, shadow'; also the soul, an umbrella, an illustration</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOB.7.2; Childs 2000, p. 393: wùndúléŋ</text></form></note>
  </entry>
  <entry id="vundulen_3661">
    <lexical-unit><form lang="kqs"><text>vundulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vundulen_3661_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre ; vision</text></gloss>
      <gloss lang="en"><text>shadow, shade; vision</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shade, shadow; the soul of a person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first GEN.15.1; Keita 1979, p. 155: Vundulen; Childs 2000, p. 393: wùndúléŋ</text></form></note>
  </entry>
  <entry id="vuo_3662">
    <lexical-unit><form lang="kqs"><text>vuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vu</text></form></variant>
    <variant><form lang="kqs"><text>vunin</text></form></variant>
    <variant><form lang="kqs"><text>vi</text></form></variant>
    <variant><form lang="kqs"><text>vinin</text></form></variant>
    <sense id="vuo_3662_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mourir</text></gloss>
      <gloss lang="en"><text>die</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.43.8; Keita 1979, p. 115: Vuo; Childs 2000, p. 393: wùó</text></form></note>
    <note><form lang="fr"><text>vi, vinin : radical négatif (EXO 9,4).</text></form></note>
  </entry>
  <entry id="vuulu_3663">
    <lexical-unit><form lang="kqs"><text>vuulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vuulu_3663_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter (qqch.) à (qqn)</text></gloss>
      <gloss lang="en"><text>throw (something) to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw to someone; shoot, thatch for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2SA.20.21; Childs 2000, p. 393: wùùlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de vuuo « jeter ». bolle ndɔlen vuulu o kpakio kɔɔli « on te jettera sa tête par-dessus la muraille » (2SA.20.21) ; la vuulu pewva « ne jetez pas (vos perles) aux porcs » (MAT.7.6).</text></form></note>
  </entry>
  <entry id="vuuo_3664">
    <lexical-unit><form lang="kqs"><text>vuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuu</text></form></variant>
    <sense id="vuuo_3664_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter, lancer</text></gloss>
      <gloss lang="en"><text>throw, cast</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw (e.g. with a sling); thatch a roof; shoot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.21.20; Childs 2000, p. 393: wùùwó</text></form></note>
    <note><form lang="fr"><text>vana caa kpaasiaa vuuo « archer » (Gn 21,20).</text></form></note>
  </entry>
  <entry id="vuɛɛndo_3665">
    <lexical-unit><form lang="kqs"><text>vuɛɛndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuɛɛn</text></form></variant>
    <sense id="vuɛɛndo_3665_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme (adulte) ; (vocatif) femme !</text></gloss>
      <gloss lang="en"><text>woman; (vocative) woman!</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first RUT.3.16</text></form></note>
    <note><form lang="fr"><text>vuɛɛn bala fondo pɔnɔɔ vi-o « une pauvre veuve » (MRK.12.42).</text></form></note>
  </entry>
  <entry id="vɔ_3666">
    <lexical-unit><form lang="kqs"><text>vɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ_3666_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>pas encore (vɔ … le)</text></gloss>
      <gloss lang="en"><text>not yet (vɔ … le)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'still, already'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 977 occurrences, first GEN.2.5; Childs 2000, p. 390: wɔ̀</text></form></note>
  </entry>
  <entry id="vɔkɔ-vɔkɔɔ_3667">
    <lexical-unit><form lang="kqs"><text>vɔkɔ-vɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔ</text></form></variant>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔlan</text></form></variant>
    <sense id="vɔkɔ-vɔkɔɔ_3667_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, agitation</text></gloss>
      <gloss lang="en"><text>uproar, commotion, din</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first PSA.2.1</text></form></note>
    <note><form lang="fr"><text>Ko vɔkɔ-vɔkɔ bɛndu yɛɛ nɛ co yɛ hoo ? « Pourquoi ce grand tumulte ? » (1KI.1.41).</text></form></note>
  </entry>
  <entry id="vɔlɔtɔɔ_3668">
    <lexical-unit><form lang="kqs"><text>vɔlɔtɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vɔlɔtɔlan</text></form></field>
    <variant><form lang="kqs"><text>vɔlɔtɔ</text></form></variant>
    <sense id="vɔlɔtɔɔ_3668_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faucille</text></gloss>
      <gloss lang="en"><text>sickle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.8 Agricultural tool"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.23.26</text></form></note>
  </entry>
  <entry id="vɔlɔɔ_3669">
    <lexical-unit><form lang="kqs"><text>vɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="vɔlɔɔ_3669_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perdrix</text></gloss>
      <gloss lang="en"><text>partridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bush chicken</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1SA.26.20; Keita 1979, p. 137: Völöö; Childs 2000, p. 390: wɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vɔ̀lɛ́lan_3670">
    <lexical-unit><form lang="kqs"><text>vɔ̀lɛ́lan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔ̀lɛ́la</text></form></variant>
    <sense id="vɔ̀lɛ́lan_3670_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, parcs (à bétail)</text></gloss>
      <gloss lang="en"><text>folds, pens (for livestock)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.32.16</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="vɔmndo_3671">
    <lexical-unit><form lang="kqs"><text>vɔmndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔm</text></form></variant>
    <sense id="vɔmndo_3671_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire la battue, traquer</text></gloss>
      <gloss lang="en"><text>beat (for game), hunt down</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HOS.5.8; Keita 1979, p. 114: Vömndo</text></form></note>
    <note><form lang="fr"><text>vɔm « chasser, traquer » (JER 16,16).</text></form></note>
  </entry>
  <entry id="vɔngoo_3672">
    <lexical-unit><form lang="kqs"><text>vɔngoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔngu</text></form></variant>
    <sense id="vɔngoo_3672_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix, paiement</text></gloss>
      <gloss lang="en"><text>price, payment</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.23.15; Childs 2000, p. 390: wɔ̀ŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vɔ̀ngɔ̀_3673">
    <lexical-unit><form lang="kqs"><text>vɔ̀ngɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ̀ngɔ̀_3673_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>récompense, salaire</text></gloss>
      <gloss lang="en"><text>reward, wages</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.15.1</text></form></note>
  </entry>
  <entry id="vɔsio_3674">
    <lexical-unit><form lang="kqs"><text>vɔsio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vɔsilan</text></form></field>
    <sense id="vɔsio_3674_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>année</text></gloss>
      <gloss lang="en"><text>year</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.1.14; Keita 1979, p. 152: Vösio; Childs 2000, p. 391: wɔ̀sìɛ́í</text></form></note>
  </entry>
  <entry id="vɔsɔkɔɔ_3675">
    <lexical-unit><form lang="kqs"><text>vɔsɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔsɔkɔɔ_3675_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sol pierreux, terrain rocailleux</text></gloss>
      <gloss lang="en"><text>stony ground, rocky soil</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gravel; gravelly upland soils</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MRK.4.5; Childs 2000, p. 391: wɔ̀sɔ̀kɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Mí n tiŋ deli o vɔsɔkɔɔ nin « d'autres tombèrent sur le sol pierreux » (MRK.4.5).</text></form></note>
  </entry>
  <entry id="vɔw_3676">
    <lexical-unit><form lang="kqs"><text>vɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔwnin</text></form></variant>
    <sense id="vɔw_3676_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être mauvais, être laid ; être terrible, grave</text></gloss>
      <gloss lang="en"><text>be bad, be ugly; be severe</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first EXO.9.24; Childs 2000, p. 391: wɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Cf. vɔɔndo « mauvais ».</text></form></note>
  </entry>
  <entry id="vɔwlen_3677">
    <lexical-unit><form lang="kqs"><text>vɔwlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔwle</text></form></variant>
    <sense id="vɔwlen_3677_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>laideur, mauvaise qualité ; pire</text></gloss>
      <gloss lang="en"><text>ugliness, badness; worse</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.41.19</text></form></note>
    <note><form lang="fr"><text>De vɔw.</text></form></note>
  </entry>
  <entry id="vɔyɔn_3678">
    <lexical-unit><form lang="kqs"><text>vɔyɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔyɔn_3678_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(s'asseoir par terre) tout abattu, prostré</text></gloss>
      <gloss lang="en"><text>(sit on the ground) dejectedly, slumped</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1.2 Sit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>describes relaxing or sitting</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.3.26; Childs 2000, p. 392: wɔ́yɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Toujours après cal lɛŋ « s'asseoir par terre » : La cal lɛŋ vɔyɔn « assieds-toi par terre » (ISA.47.1 ; aussi ISA.3.26, EZK.26.16).</text></form></note>
  </entry>
  <entry id="vɔ́yɔ́ɔ́_3679">
    <lexical-unit><form lang="kqs"><text>vɔ́yɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ́yɔ́ɔ́_3679_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>restes (de nourriture), reste</text></gloss>
      <gloss lang="en"><text>leftovers, remainder (of food)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.2.14; Childs 2000, p. 392: wɔ́yɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>mó dia, mó pum, mó mɛi vɔ́yɔ́ɔ́ « elle mangea, se rassasia et en garda un reste » (RUT.2.14).</text></form></note>
  </entry>
  <entry id="vɔɔca_3680">
    <lexical-unit><form lang="kqs"><text>vɔɔca</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔcan</text></form></variant>
    <sense id="vɔɔca_3680_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pétrir, mélanger (farine et huile) ; (vɔɔcan) pétri, mêlé</text></gloss>
      <gloss lang="en"><text>knead, mix (flour with oil); (vɔɔcan) mixed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.29.2</text></form></note>
    <note><form lang="fr"><text>kpeyan vɔɔcan a cuɛiyan « farine pétrie à l'huile » (LEV.9.4).</text></form></note>
  </entry>
  <entry id="vɔɔciaa_3681">
    <lexical-unit><form lang="kqs"><text>vɔɔciaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔciaanin</text></form></variant>
    <sense id="vɔɔciaa_3681_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écraser, broyer, mettre en pièces</text></gloss>
      <gloss lang="en"><text>crush, dash to pieces</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze; arrange</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first 2SA.22.39; Childs 2000, p. 391: wɔ̀ɔ̀cìá</text></form></note>
  </entry>
  <entry id="vɔɔlen_3682">
    <lexical-unit><form lang="kqs"><text>vɔɔlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vɔɔlen_3682_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>saison sèche</text></gloss>
      <gloss lang="en"><text>dry season</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.8.22; Keita 1979, p. 154: Vöölen; Childs 2000, p. 391: wɔ̀ɔ̀léŋ</text></form></note>
  </entry>
  <entry id="vɔɔndo_3683">
    <lexical-unit><form lang="kqs"><text>vɔɔndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔn</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnda</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnnda</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnndan</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnndon</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnde</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnnden</text></form></variant>
    <sense id="vɔɔndo_3683_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mauvais, méchant</text></gloss>
      <gloss lang="en"><text>bad, evil, wicked</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bad, evil; also ugly (wɔ̀ùwó 'be bad or ugly')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 547 occurrences, first GEN.2.9; Childs 2000, p. 391: wɔ̀ɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Homonyme de vɔɔndo « aisselle ». dɛnɛ vɔɔndo « le mal ».</text></form></note>
  </entry>
  <entry id="vɔɔndo_3684">
    <lexical-unit><form lang="kqs"><text>vɔɔndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="vɔɔndo_3684_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aisselle</text></gloss>
      <gloss lang="en"><text>armpit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>armpit; bosom</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 547 occurrences, first GEN.2.9; Keita 1979, p. 133: Vööndo; Childs 2000, p. 391: wɔ̀ɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs. Dans la Bible, vɔɔndo est surtout un homographe, « mauvais, mal » ; « sous les aisselles » s'y dit o lavɔɔn (Jr 38,12).</text></form></note>
  </entry>
  <entry id="vɔɔsuuo_3685">
    <lexical-unit><form lang="kqs"><text>vɔɔsuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔsuu</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsuunin</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsu</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsun</text></form></variant>
    <sense id="vɔɔsuuo_3685_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essuyer, effacer ; pardonner (les péchés) ; moucher (les lampes)</text></gloss>
      <gloss lang="en"><text>wipe, wipe away, blot out; forgive (sins); trim (lamps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wipe off, clean, erase; brush off, rub</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.30.7; Childs 2000, p. 391: wɔ̀ɔ̀sùùwó</text></form></note>
    <note><form lang="fr"><text>vɔɔsun (moyen) « être effacé, disparaître ; effleurer » (NUM.5.23, ISA.24.11, JOS.19.26) ; Hala vɔɔsuunin nda mɛmɛan kpow « Dieu essuiera toutes leurs larmes » (REV.7.17).</text></form></note>
  </entry>
  <entry id="vɔɛiyo_3686">
    <lexical-unit><form lang="kqs"><text>vɔɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɛi</text></form></variant>
    <variant><form lang="kqs"><text>vɔɛinin</text></form></variant>
    <sense id="vɔɛiyo_3686_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>téter, sucer ; baiser (les pieds) ; (nom) nourrisson</text></gloss>
      <gloss lang="en"><text>suck (at the breast); kiss; (noun) suckling</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nurse (a baby), suck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first DEU.32.25; Childs 2000, p. 384: wɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>mó va mun vɔɛiyo « elle les baisait » (LUK.7.38) ; vɔɛi « téter » (ISA.66.11).</text></form></note>
  </entry>
  <entry id="vɔɛsio_3687">
    <lexical-unit><form lang="kqs"><text>vɔɛsio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɛsi</text></form></variant>
    <variant><form lang="kqs"><text>vɔɛsil</text></form></variant>
    <sense id="vɔɛsio_3687_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allaiter, nourrir au sein</text></gloss>
      <gloss lang="en"><text>breastfeed, nurse</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.2.9; Childs 2000, p. 384: wɛ̀sìɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Causatif de vɔɛiyo. vɔɛsil (bénéfactif) « allaiter pour qqn » (EXO.2.7).</text></form></note>
  </entry>
  <entry id="vɛ_3688">
    <lexical-unit><form lang="kqs"><text>vɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɛ_3688_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>pourquoi ?</text></gloss>
      <gloss lang="en"><text>why?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 52 occurrences, first GEN.24.31</text></form></note>
  </entry>
  <entry id="vɛlɛ_3689">
    <lexical-unit><form lang="kqs"><text>vɛlɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɛlɛ_3689_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>encore, de nouveau, aussi</text></gloss>
      <gloss lang="en"><text>again, also</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'more, else, extra'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2741 occurrences, first GEN.1.6; Childs 2000, p. 384: wɛ̀lɛ̀</text></form></note>
  </entry>
  <entry id="vɛ̀ɛ̀_3690">
    <lexical-unit><form lang="kqs"><text>vɛ̀ɛ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɛ̀ɛ̀_3690_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>est-ce que ? comment ?</text></gloss>
      <gloss lang="en"><text>yes/no question marker; how?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>what? why? how? how much?</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 922 occurrences, first GEN.15.8; Childs 2000, p. 383: wɛ̀ɛ́</text></form></note>
  </entry>
  <entry id="vɛɛnnden_3691">
    <lexical-unit><form lang="kqs"><text>vɛɛnnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vɛɛnnden_3691_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nid</text></gloss>
      <gloss lang="en"><text>nest</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JOB.39.27; Keita 1979, p. 138: Vèènden; Childs 2000, p. 378: wàáŋndéŋ</text></form></note>
    <note><form lang="fr"><text>Keita écrit Vèènden ; la Bible vɛɛnnden.</text></form></note>
  </entry>
