    <sense id="héŋbéndéŋ_1031_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en tombant en morceaux, en se démantelant</text></gloss>
      <gloss lang="en"><text>falling apart, collapsing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: héŋbéndéŋ</text></form></note>
  </entry>
  <entry id="héŋgóó_1032">
