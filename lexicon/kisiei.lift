    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>korio</text></form></variant>
    <sense id="kolio_2190_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauterelle</text></gloss>
      <gloss lang="en"><text>grasshopper</text></gloss>
