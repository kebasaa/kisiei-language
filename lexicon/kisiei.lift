  <entry id="búéèŋndó_227">
    <lexical-unit><form lang="kqs"><text>búéèŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>búéèŋndá</text></form></field>
    <sense id="búéèŋndó_227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat rayé (de la forêt)</text></gloss>
      <gloss lang="en"><text>striped (forest) rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 31: búéèŋndó</text></form></note>
  </entry>
  <entry id="búí-_228">
    <lexical-unit><form lang="kqs"><text>búí-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="búí-_228_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>de femme (vêtement) ; (kólà-búíyó) pagne de dessous</text></gloss>
      <gloss lang="en"><text>of women's clothing; (kólà-búíyó) under-wrapper</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 20: búí-</text></form></note>
  </entry>
  <entry id="bùkàá_229">
    <lexical-unit><form lang="kqs"><text>bùkàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùkàláŋ</text></form></field>
    <sense id="bùkàá_229_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>courbe, coude, torsion</text></gloss>
      <gloss lang="en"><text>curve, bend, twist</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 31: bùkàá</text></form></note>
  </entry>
  <entry id="bukuloo_230">
    <lexical-unit><form lang="kqs"><text>bukuloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bukuloo_230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mai</text></gloss>
      <gloss lang="en"><text>May</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around May or June</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Bukuloo; Childs 2000, p. 31: búkúlɔ́ɔ</text></form></note>
  </entry>
  <entry id="bulio_231">
    <lexical-unit><form lang="kqs"><text>bulio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buli</text></form></variant>
    <variant><form lang="kqs"><text>bulinin</text></form></variant>
    <variant><form lang="kqs"><text>bulin</text></form></variant>
    <sense id="bulio_231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>percer, trouer ; faire une brèche, ouvrir (un passage)</text></gloss>
      <gloss lang="en"><text>pierce, bore through; break through, open (a way)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drill, bore; (of soil) be fertile, loose</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.22.1; Childs 2000, p. 31: bùlìó</text></form></note>
    <note><form lang="fr"><text>o buli ndu nilen a yɔɛi buliaa « il lui percera l'oreille avec un poinçon » (EXO.21.6) ; buli soondo « faire une brèche (dans le mur) » (2KI.14.13). Adj. buliɛiyo « troué » (HAG.1.6). Voir buuluuo.</text></form></note>
  </entry>
  <entry id="buloo_232">
    <lexical-unit><form lang="kqs"><text>buloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bululan</text></form></field>
    <variant><form lang="kqs"><text>bulu</text></form></variant>
    <variant><form lang="kqs"><text>bulula</text></form></variant>
    <sense id="buloo_232_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain</text></gloss>
      <gloss lang="en"><text>bread</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 111 occurrences, first GEN.14.18</text></form></note>
  </entry>
  <entry id="buloo_233">
    <lexical-unit><form lang="kqs"><text>buloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bululan</text></form></field>
    <variant><form lang="kqs"><text>bulu</text></form></variant>
    <sense id="buloo_233_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trompette, cor</text></gloss>
      <gloss lang="en"><text>trumpet, horn (wind instrument)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>horn, any wind instrument; bread</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 111 occurrences, first GEN.14.18; Childs 2000, p. 31: búlóó</text></form></note>
    <note><form lang="fr"><text>hɔŋ buloo « sonner de la trompette » (JDG.3.27, 2SA.2.28) ; bululan hɔŋndo (LEV.23.24). Même mot que buloo « pain ».</text></form></note>
  </entry>
  <entry id="bulu yekpandio_234">
    <lexical-unit><form lang="kqs"><text>bulu yekpandio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bulu yekpandio_234_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canon de fusil</text></gloss>
      <gloss lang="en"><text>gun barrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Bulu yekpandio</text></form></note>
  </entry>
  <entry id="búlúdíɔ́ɔ́_235">
    <lexical-unit><form lang="kqs"><text>búlúdíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="búlúdíɔ́ɔ́_235_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain en forme de corne (farine de riz)</text></gloss>
      <gloss lang="en"><text>horn-shaped rice-flour bread</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúdíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="búlúlákándáá_236">
    <lexical-unit><form lang="kqs"><text>búlúlákándáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="búlúlákándáá_236_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'insecte (ravageur du riz de bas-fond)</text></gloss>
      <gloss lang="en"><text>species of insect (pest of swamp rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúlákándáá</text></form></note>
  </entry>
  <entry id="búlúŋndó_237">
    <lexical-unit><form lang="kqs"><text>búlúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>búlúŋndáŋ</text></form></field>
    <sense id="búlúŋndó_237_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nœud</text></gloss>
      <gloss lang="en"><text>knot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúŋndó</text></form></note>
  </entry>
  <entry id="bumba_238">
    <lexical-unit><form lang="kqs"><text>bumba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bumbanin</text></form></variant>
    <sense id="bumba_238_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échouer, ne pas réussir à ; perdre (une bataille) ; manquer</text></gloss>
      <gloss lang="en"><text>fail, be unable to; lose (a battle); miss</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first DEU.2.36; Childs 2000, p. 32: bùmbàá</text></form></note>
  </entry>
  <entry id="bùmbàá_239">
    <lexical-unit><form lang="kqs"><text>bùmbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùmbàláŋ</text></form></field>
    <sense id="bùmbàá_239_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas du dos ; poitrail (d'un animal)</text></gloss>
      <gloss lang="en"><text>lower back; chest (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: bùmbàá</text></form></note>
  </entry>
  <entry id="bùmbòó_240">
    <lexical-unit><form lang="kqs"><text>bùmbòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùmbùá</text></form></field>
    <sense id="bùmbòó_240_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aulacode (« marmotte »), rongeur qui mange le riz</text></gloss>
      <gloss lang="en"><text>cane rat ("groundhog"), rodent eating rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: bùmbòó</text></form></note>
  </entry>
  <entry id="bumbula_241">
    <lexical-unit><form lang="kqs"><text>bumbula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bumbulan</text></form></variant>
    <sense id="bumbula_241_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'émousser, être émoussé ; (bumbulan) défaillir, s'affaiblir</text></gloss>
      <gloss lang="en"><text>become blunt, be dull; (bumbulan) grow faint, weaken</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.58.8; Childs 2000, p. 32: bùmbàlàá</text></form></note>
    <note><form lang="fr"><text>Te cuei bumbula pɛ « si le fer est émoussé » (ECC.10.10) ; o sanga le, o bumbulan te « il ne se fatigue ni ne se lasse » (ISA.40.28).</text></form></note>
  </entry>
  <entry id="bundɔɔ_242">
    <lexical-unit><form lang="kqs"><text>bundɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɛlan</text></form></field>
    <variant><form lang="kqs"><text>bundɛ</text></form></variant>
    <variant><form lang="kqs"><text>bundɛla</text></form></variant>
    <sense id="bundɔɔ_242_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forêt, bois</text></gloss>
      <gloss lang="en"><text>forest, wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moist semi-deciduous forest, gallery or riverside forest, jungle, woods</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first DEU.14.16; Childs 2000, p. 33: bùndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale bundɛ : o bundɛ kon nin « dans cette forêt » (1 S 14,26) ; yɔmii bundɛi « les arbres de la forêt » (Ez 15,6). Cf. bundɛcieo « clairière ».</text></form></note>
  </entry>
  <entry id="bundɛcieo_243">
    <lexical-unit><form lang="kqs"><text>bundɛcieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bundɛcieo_243_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clairière</text></gloss>
      <gloss lang="en"><text>clearing</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Bundètyieo</text></form></note>
  </entry>
  <entry id="bundɛi_244">
    <lexical-unit><form lang="kqs"><text>bundɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɔn</text></form></field>
    <sense id="bundɛi_244_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parabole, énigme ; (pl.) fables</text></gloss>
      <gloss lang="en"><text>parable, riddle; (pl.) fables, myths</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>story, tale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EZK.15.6; Childs 2000, p. 32: búndèí</text></form></note>
    <note><form lang="fr"><text>À distinguer de yɔmii bundɛi « les arbres de la forêt » (Ez 15,6), de bundɔɔ « forêt ».</text></form></note>
  </entry>
  <entry id="bungɛi_245">
    <lexical-unit><form lang="kqs"><text>bungɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bungan</text></form></field>
    <sense id="bungɛi_245_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>part, morceau, portion ; lobe (du foie)</text></gloss>
      <gloss lang="en"><text>part, piece, portion; lobe (of the liver)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>area, section, plot, portion; also promise, vow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 103 occurrences, first EXO.29.13; Childs 2000, p. 33: bùŋèí</text></form></note>
    <note><form lang="fr"><text>bungɛi hiow naŋɔɔ o yemnde « le lobe du foie » (Ex 29,13).</text></form></note>
  </entry>
  <entry id="buo_246">
    <lexical-unit><form lang="kqs"><text>buo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buo_246_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>largeur</text></gloss>
      <gloss lang="en"><text>width</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 96 occurrences, first GEN.6.15</text></form></note>
  </entry>
  <entry id="busa_247">
    <lexical-unit><form lang="kqs"><text>busa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>busanin</text></form></variant>
    <sense id="busa_247_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir, frayer (un chemin)</text></gloss>
      <gloss lang="en"><text>open up, make (a way)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.38.25</text></form></note>
  </entry>
  <entry id="busɔɔ_248">
    <lexical-unit><form lang="kqs"><text>busɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>busullo</text></form></variant>
    <sense id="busɔɔ_248_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aboyer, hurler (animal) ; (busullo) aboyer contre</text></gloss>
      <gloss lang="en"><text>bark, howl; (busullo) bark at</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bark; (of a young animal) open the eyes</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.13.22; Childs 2000, p. 33: bùsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>a nɔla busɔɔ le « ils ne peuvent aboyer » (ISA.56.10) ; tunndo ... vanacieo busullo « aucun chien n'aboiera contre personne » (EXO.11.7).</text></form></note>
  </entry>
  <entry id="bútè_249">
    <lexical-unit><form lang="kqs"><text>bútè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bútè_249_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup</text></gloss>
      <gloss lang="en"><text>much, a lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: bútè</text></form></note>
  </entry>
  <entry id="buubuuon_250">
    <lexical-unit><form lang="kqs"><text>buubuuon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buubuuon_250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collines</text></gloss>
      <gloss lang="en"><text>hills</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a mound</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first PSA.114.4; Childs 2000, p. 34: búúbúúwé</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="búúbúúwé_251">
    <lexical-unit><form lang="kqs"><text>búúbúúwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="búúbúúwé_251_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane rouge à l'intérieur (écorce battue pour faire des cordes)</text></gloss>
      <gloss lang="en"><text>vine red inside (peeled and beaten for rope)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: búúbúúwé</text></form></note>
  </entry>
  <entry id="buukuo_252">
    <lexical-unit><form lang="kqs"><text>buukuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>buukulan</text></form></field>
    <variant><form lang="kqs"><text>buuku</text></form></variant>
    <sense id="buukuo_252_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sabot</text></gloss>
      <gloss lang="en"><text>hoof</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Buukuo; Childs 2000, p. 34: bùùkɔ̀ɔ̀</text></form></note>
    <note><form lang="fr"><text>La Bible a la forme radicale buuku (LEV.11.3) et le pluriel buukulan (PSA.69.32).</text></form></note>
  </entry>
  <entry id="buulanndo_253">
    <lexical-unit><form lang="kqs"><text>buulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buulan</text></form></variant>
    <variant><form lang="kqs"><text>buulannda</text></form></variant>
    <sense id="buulanndo_253_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chercher, rechercher ; consulter ; s'inquiéter, se faire du souci ; (buulan te) n'aie pas peur</text></gloss>
      <gloss lang="en"><text>seek, look for; consult; worry, be anxious; (buulan te) do not be afraid</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.32.12; Childs 2000, p. 34: bùùlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Buulan te « ne crains pas » (GEN.21.17, GEN.26.24) ; kɔɔyɔlɔɔ a buulanndo « tristes et soucieux » (GEN.40.6) ; vana-vana buulan le ya « personne ne se soucie de moi » (1SA.22.8). Le sens « chercher, consulter » est déjà enregistré ailleurs ; c'est sans doute le même verbe (« se soucier de »).</text></form></note>
  </entry>
  <entry id="bùùlèbúúlíɔ́ɔ́_254">
    <lexical-unit><form lang="kqs"><text>bùùlèbúúlíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùùlèbúúlíá</text></form></field>
    <sense id="bùùlèbúúlíɔ́ɔ́_254_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de rat très prolifique (terrier à plusieurs issues) ; femme à nombreux enfants ; maladie cancéreuse</text></gloss>
      <gloss lang="en"><text>prolific rat species (burrow with many exits); woman with many children; cancerous disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: bùùlèbúúlíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="buululan_255">
    <lexical-unit><form lang="kqs"><text>buululan</text></form></lexical-unit>
