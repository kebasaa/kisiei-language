    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 91: dúúndúúwó</text></form></note>
  </entry>
  <entry id="duuva_851">
    <lexical-unit><form lang="kqs"><text>duuva</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="duuva_851_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rabrouer, faire honte à, écarter</text></gloss>
      <gloss lang="en"><text>rebuff, reproach, keep away</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>exclude, discriminate against, ostracize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first RUT.2.15; Childs 2000, p. 91: dùùwàá</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : vana-vana bɛnda mò duuva ndu le « que personne ne la rabroue » (RUT.2.15).</text></form></note>
  </entry>
  <entry id="duɛn_852">
    <lexical-unit><form lang="kqs"><text>duɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="duɛn_852_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lentement, doucement, sans bruit</text></gloss>
      <gloss lang="en"><text>slowly, quietly, softly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: duɛn; Childs 2000, p. 90: dúɛ́ŋ-dúɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 14 (duɛn « lentement ; doucement »).</text></form></note>
  </entry>
  <entry id="duɲɛi_853">
    <lexical-unit><form lang="kqs"><text>duɲɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>duɲan</text></form></field>
    <sense id="duɲɛi_853_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fête</text></gloss>
      <gloss lang="en"><text>feast, festival</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>feast, party, celebration, especially at someone's death</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.13.9; Childs 2000, p. 91: dúɲéí</text></form></note>
  </entry>
  <entry id="dɔ pala_854">
    <lexical-unit><form lang="kqs"><text>dɔ pala</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dɔ pala_854_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>après-midi</text></gloss>
      <gloss lang="en"><text>afternoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: dɔ pala</text></form></note>
    <note><form lang="fr"><text>Expression notée dɔ pala dans le Lexique ; composition et sens littéral à confirmer.</text></form></note>
  </entry>
  <entry id="dɔ́cù_855">
    <lexical-unit><form lang="kqs"><text>dɔ́cù</text></form></lexical-unit>
