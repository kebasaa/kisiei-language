  <entry id="kɔ̀mndéŋ_2207">
    <lexical-unit><form lang="kqs"><text>kɔ̀mndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
