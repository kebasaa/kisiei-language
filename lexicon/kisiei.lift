      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be enjoyable, tasty, sweet; (of talk) interesting</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.2.9; Childs 2000, p. 401: yèlàá</text></form></note>
  </entry>
  <entry id="yeelan_3838">
    <lexical-unit><form lang="kqs"><text>yeelan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="yeelan_3838_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cris, pleurs, lamentation</text></gloss>
      <gloss lang="en"><text>crying, weeping, wailing</text></gloss>
