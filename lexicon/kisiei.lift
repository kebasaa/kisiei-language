  <entry id="pɛŋnden_3309">
    <lexical-unit><form lang="kqs"><text>pɛŋnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛŋnde</text></form></variant>
    <sense id="pɛŋnden_3309_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manque, besoin, pauvreté</text></gloss>
      <gloss lang="en"><text>want, need, poverty</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lack, need, poverty; also state of being jammed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first LEV.25.35; Childs 2000, p. 297: pɛ̀ŋndéŋ</text></form></note>
    <note><form lang="fr"><text>pɛŋnde ɲɛdiaa « manque de pain, famine » (Am 8,11).</text></form></note>
  </entry>
  <entry id="pɛ̀ŋɔ́ɔ́_3310">
    <lexical-unit><form lang="kqs"><text>pɛ̀ŋɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀ŋíá</text></form></field>
    <sense id="pɛ̀ŋɔ́ɔ́_3310_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit poisson plat argenté (genre sardine)</text></gloss>
      <gloss lang="en"><text>small flat silvery fish (sardine-like)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ŋɔ́ɔ́</text></form></note>
  </entry>
  <entry id="pɛɛkoo_3311">
    <lexical-unit><form lang="kqs"><text>pɛɛkoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛku</text></form></variant>
    <variant><form lang="kqs"><text>pɛɛkaa</text></form></variant>
    <sense id="pɛɛkoo_3311_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enseigner</text></gloss>
      <gloss lang="en"><text>teach</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>teach; also study, learn</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 180 occurrences, first EXO.35.34; Lexique kissi–français, p. 42: pɛɛkuo/ pɛɛku; Childs 2000, p. 294: pèèkɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>vana pɛɛkaa « enseignant, maître » ; vanaa pɛɛkaa latɔŋnda « les maîtres de la loi ». Aussi Lexique kissi–français, p. 60 : « vana pɛɛkaa ». Lexique kissi–français, p. 60 : vana pɛɛkaa « enseignant ».</text></form></note>
  </entry>
  <entry id="pɛɛkula_3312">
    <lexical-unit><form lang="kqs"><text>pɛɛkula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛɛkula_3312_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enseignements, préceptes</text></gloss>
      <gloss lang="en"><text>teachings, precepts</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>teachings; ways of learning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first LEV.25.18; Childs 2000, p. 294: pèèkùláŋ</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀lǎŋ_3313">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀lǎŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɛ̀lǎŋ_3313_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vantard, crâneur</text></gloss>
      <gloss lang="en"><text>swanky, bluffing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 294: pɛ̀ɛ̀lǎŋ</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀lìá_3314">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀lìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɛ̀lìá_3314_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>roter, grogner, haleter, gronder</text></gloss>
      <gloss lang="en"><text>belch, grunt, pant, growl</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 294: pɛ̀ɛ̀lìá</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀lìá_3315">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀lìá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɛ̀lìá_3315_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cochon (litt. « le grogneur »)</text></gloss>
      <gloss lang="en"><text>pig (lit. 'the grunter')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀ɛ̀lìá</text></form></note>
  </entry>
  <entry id="pɛɛliaa_3316">
    <lexical-unit><form lang="kqs"><text>pɛɛliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛliaanin</text></form></variant>
    <sense id="pɛɛliaa_3316_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rugir, gronder (lion, tonnerre) ; hurler (chiens)</text></gloss>
      <gloss lang="en"><text>roar, rumble (lion, thunder); howl (dogs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first 2SA.22.16</text></form></note>
  </entry>
  <entry id="pɛɛlunɔɔ_3317">
    <lexical-unit><form lang="kqs"><text>pɛɛlunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɛɛlunɔɔ_3317_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prêtre</text></gloss>
      <gloss lang="en"><text>priest</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Pèèlunöö; Lexique kissi–français, p. 42: pɛɛlunɔɔ</text></form></note>
    <note><form lang="fr"><text>La Bible dit vana-solia-lasálàá « prêtre ».</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀lɔ̌ŋndó_3318">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀lɔ̌ŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɛ̀lɔ̌ŋndó_3318_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crâner, se pavaner, bluffer</text></gloss>
      <gloss lang="en"><text>swank, show off, strut, bluff</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀ɛ̀lɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="pɛɛlɛnnden_3319">
    <lexical-unit><form lang="kqs"><text>pɛɛlɛnnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="pɛɛlɛnnden_3319_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe</text></gloss>
      <gloss lang="en"><text>loincloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Pèèlènnden; Lexique kissi–français, p. 42: pɛɛlɛnnden</text></form></note>
  </entry>
  <entry id="pɛɛn_3320">
    <lexical-unit><form lang="kqs"><text>pɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛɛn_3320_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>c'est-à-dire, à savoir (particule d'apposition)</text></gloss>
      <gloss lang="en"><text>namely, that is (appositive particle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1262 occurrences, first GEN.4.2</text></form></note>
    <note><form lang="fr"><text>Suit un groupe qui précise le précédent : Abɛl, pɔmbɔɔ Kain pɛɛn « Abel, le cadet de Caïn » (Gn 4,2) ; koovan pɛɛn « c'est-à-dire son sang » (Gn 9,4).</text></form></note>
  </entry>
  <entry id="pɛɛnden_3321">
    <lexical-unit><form lang="kqs"><text>pɛɛnden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛɛnden_3321_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ceinture</text></gloss>
      <gloss lang="en"><text>belt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 42: pɛɛnden</text></form></note>
  </entry>
  <entry id="pɛɛngaa_3322">
    <lexical-unit><form lang="kqs"><text>pɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛnga</text></form></variant>
    <variant><form lang="kqs"><text>pɛɛngaalan</text></form></variant>
    <sense id="pɛɛngaa_3322_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déployer (les ailes), planer ; s'ouvrir (fleur)</text></gloss>
      <gloss lang="en"><text>spread (wings), hover; open (of flowers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.1.2</text></form></note>
    <note><form lang="fr"><text>Kɔl Hala-o va o pɛɛngaa o mɛmma man coo « l'Esprit de Dieu planait au-dessus des eaux » (Gn 1,2) ; peengela pɛɛngaalan « fleurs épanouies » (1 R 6,32).</text></form></note>
  </entry>
  <entry id="pɛɛngio_3323">
    <lexical-unit><form lang="kqs"><text>pɛɛngio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɛɛngi</text></form></variant>
    <sense id="pɛɛngio_3323_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cesser</text></gloss>
      <gloss lang="en"><text>cease, stop</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Pèèngio; Lexique kissi–français, p. 42: pɛɛngio/ pɛɛngi</text></form></note>
    <note><form lang="fr"><text>Non trouvé dans la Bible, qui emploie pɛngi pour « cesser » ; peut-être le même verbe que pɛngio. Confirmé au Nord par le Lexique kissi–français, p. 42, qui distingue pɛɛngio « cesser » de pɛngio « se reposer, arrêter ».</text></form></note>
  </entry>
  <entry id="pɛɛngu_3324">
    <lexical-unit><form lang="kqs"><text>pɛɛngu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛngu</text></form></variant>
    <sense id="pɛɛngu_3324_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, avec certitude (sina pɛɛngu « savoir avec certitude »)</text></gloss>
      <gloss lang="en"><text>clearly, for certain (sina pɛɛngu 'know for sure')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clearly, completely, very well</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first GEN.15.8; Childs 2000, p. 297: pɛ́ŋú</text></form></note>
    <note><form lang="fr"><text>vɛ̀ɛ̀ ya sina yɛnin pɛɛngu « comment saurai-je avec certitude » (GEN.15.8) ; la sina pɛngu maa … « sachez bien que … » (DEU.7.9).</text></form></note>
  </entry>
  <entry id="pɛɛngulan_3325">
    <lexical-unit><form lang="kqs"><text>pɛɛngulan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛngula</text></form></variant>
    <variant><form lang="kqs"><text>pɛngulan</text></form></variant>
    <sense id="pɛɛngulan_3325_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>différence, séparation ; limite, frontière</text></gloss>
      <gloss lang="en"><text>difference, distinction; boundary, border</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 98 occurrences, first GEN.1.7; Keita 1979, p. 148: Pèngulan; Lexique kissi–français, p. 42: pɛngulan</text></form></note>
    <note><form lang="fr"><text>Dans la Bible : sina pɛngulan « faire la différence » (Lv 20,25 ; Ez 22,26). Graphie principale pɛɛngulan (98 occurrences), rarement pɛngulan.</text></form></note>
  </entry>
  <entry id="pɛɛpɛi_3326">
    <lexical-unit><form lang="kqs"><text>pɛɛpɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>pɛɛpɛɛlan</text></form></field>
    <sense id="pɛɛpɛi_3326_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nageoire</text></gloss>
      <gloss lang="en"><text>fin</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Pèèpèi; Lexique kissi–français, p. 42: pɛɛpɛi</text></form></note>
    <note><form lang="fr"><text>La Bible a le pluriel pɛɛpɛɛlan (LEV.11.9, DEU.14.9) ; le singulier est réécrit d'après Keita.</text></form></note>
  </entry>
  <entry id="pɛɛsaa_3327">
    <lexical-unit><form lang="kqs"><text>pɛɛsaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛsa</text></form></variant>
    <sense id="pɛɛsaa_3327_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mépriser, dédaigner</text></gloss>
      <gloss lang="en"><text>despise, scorn</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>oversee; blame, criticize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first NUM.14.11; Childs 2000, p. 295: pèèsàá</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀ŋndéŋ_3328">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀ŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀ɛ̀ŋndé</text></form></field>
    <sense id="pɛ̀ɛ̀ŋndéŋ_3328_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ceinture de grimpeur (pour monter aux palmiers)</text></gloss>
      <gloss lang="en"><text>climbing belt (hoop of rope for climbing palm trees)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀ɛ̀ŋndéŋ</text></form></note>
  </entry>
  <entry id="pɛ̀ɲííyó_3329">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɲííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɲííyó_3329_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égratignure sur la main</text></gloss>
      <gloss lang="en"><text>scratch on the hand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ɲííyó</text></form></note>
  </entry>
  <entry id="robuo_3330">
    <lexical-unit><form lang="kqs"><text>robuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="robuo_3330_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jupe, robe</text></gloss>
      <gloss lang="en"><text>skirt, dress</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: robuo</text></form></note>
    <note><form lang="fr"><text>Emprunt (français robe) ; r gardé comme dans les emprunts.</text></form></note>
  </entry>
  <entry id="rɛsɛnndo_3331">
    <lexical-unit><form lang="kqs"><text>rɛsɛnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>rɛsɛn</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnndon</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛŋun</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnndan</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnnda</text></form></variant>
    <sense id="rɛsɛnndo_3331_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vigne, cep de vigne ; (rɛsɛnndon) raisins</text></gloss>
      <gloss lang="en"><text>vine, grapevine; (rɛsɛnndon) grapes</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.9.20</text></form></note>
    <note><form lang="fr"><text>rɛsɛŋun toaŋaa « raisins secs » (Ct 2,5) ; n'rɛsɛnndan « vignes, vignobles ».</text></form></note>
  </entry>
  <entry id="saa_3332">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="saa_3332_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouton</text></gloss>
      <gloss lang="en"><text>sheep</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 672 occurrences, first GEN.12.16; Keita 1979, p. 137: Saa; Lexique kissi–français, p. 45: saa; Childs 2000, p. 315: sàá</text></form></note>
    <note><form lang="fr"><text>Invariable : saa « mouton, moutons ».</text></form></note>
  </entry>
  <entry id="saa_3333">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saa_3333_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>octobre</text></gloss>
      <gloss lang="en"><text>October</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Saa; Lexique kissi–français, p. 45: Saa</text></form></note>
    <note><form lang="fr"><text>Même forme que saa « mouton » ; nom de mois absent de la Bible. Confirmé au Nord par le Lexique kissi–français, p. 45 (Saa « octobre »).</text></form></note>
  </entry>
  <entry id="saa_3334">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sa</text></form></variant>
    <sense id="saa_3334_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, attraper ; tenir ; prendre ; prendre feu</text></gloss>
      <gloss lang="en"><text>grab, seize, catch; hold; take; catch fire</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saa/ sa; Childs 2000, p. 315: sàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 45 (saa/ sa « prendre feu ; tenir, prendre »).</text></form></note>
  </entry>
  <entry id="saa cuao_3335">
    <lexical-unit><form lang="kqs"><text>saa cuao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saa cuao_3335_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agneau</text></gloss>
      <gloss lang="en"><text>lamb</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saa cuao</text></form></note>
    <note><form lang="fr"><text>saa « mouton » et cuao « petit (d'animal) » sont dans la Bible séparément.</text></form></note>
  </entry>
  <entry id="saa kóndóó_3336">
    <lexical-unit><form lang="kqs"><text>saa kóndóó</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saa kóndóó_3336_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bélier</text></gloss>
      <gloss lang="en"><text>ram</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Saa kondoo; Lexique kissi–français, p. 45: saa kondoo</text></form></note>
  </entry>
  <entry id="saa laandoo_3337">
    <lexical-unit><form lang="kqs"><text>saa laandoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saa laandoo_3337_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brebis</text></gloss>
      <gloss lang="en"><text>ewe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Saa laanduo; Lexique kissi–français, p. 45: saa laanduo</text></form></note>
    <note><form lang="fr"><text>Keita écrit laanduo ; la Bible écrit laandoo « femelle ».</text></form></note>
  </entry>
  <entry id="sààbándìínɔ̀ɔ́_3338">
    <lexical-unit><form lang="kqs"><text>sààbándìínɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sààbándìíyá</text></form></field>
    <sense id="sààbándìínɔ̀ɔ́_3338_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porteur du sac du chef</text></gloss>
      <gloss lang="en"><text>chief's bag-carrier</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààbándìínɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sààbèíyó_3339">
    <lexical-unit><form lang="kqs"><text>sààbèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààbèíyó_3339_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bandage ; mèche (de lampe)</text></gloss>
      <gloss lang="en"><text>bandage; lamp wick</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààbèíyó</text></form></note>
  </entry>
  <entry id="saabelanɔɔ_3340">
    <lexical-unit><form lang="kqs"><text>saabelanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="saabelanɔɔ_3340_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>architecte</text></gloss>
      <gloss lang="en"><text>architect</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Saabelanöö; Lexique kissi–français, p. 45: saabelanɔɔ</text></form></note>
  </entry>
  <entry id="saalaa_3341">
    <lexical-unit><form lang="kqs"><text>saalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>saala</text></form></variant>
    <variant><form lang="kqs"><text>sala</text></form></variant>
    <sense id="saalaa_3341_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attraper (un objet lancé), saisir ; se mêler (à une dispute)</text></gloss>
      <gloss lang="en"><text>catch (something thrown), grab; join in (an argument)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saalaa/ saala; Childs 2000, p. 315: sààlàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 45-46 (saalaa/ saala, sala « saisir un objet qui tombe »).</text></form></note>
  </entry>
  <entry id="saalan_3342">
    <lexical-unit><form lang="kqs"><text>saalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saalan_3342_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire attention à, se soucier de, tenir compte de ; (… le) négliger</text></gloss>
      <gloss lang="en"><text>pay attention to, heed, care about; (… le) neglect</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pay attention, do what someone says (middle of 'catch')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.21.29; Childs 2000, p. 316: sààlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Kɛ a saalan sɔɛi ken te « mais ils n'en tinrent pas compte » (MAT.22.5) ; o co saalan te? « cela ne te fait rien ? » (LUK.10.40) ; vanlaandua saalan haa isɔɔ le-a « femmes insouciantes » (ISA.32.11). À distinguer de saalanin, futur de « attraper » (LUK.4.11).</text></form></note>
  </entry>
  <entry id="saalɔnndo_3343">
    <lexical-unit><form lang="kqs"><text>saalɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saalun</text></form></variant>
    <variant><form lang="kqs"><text>saalunnin</text></form></variant>
    <sense id="saalɔnndo_3343_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trouver</text></gloss>
      <gloss lang="en"><text>find</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.2 Find"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.19.11</text></form></note>
  </entry>
  <entry id="sáálɛ́ŋ_3344">
    <lexical-unit><form lang="kqs"><text>sáálɛ́ŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sáálɛ́ŋ_3344_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeton (au jeu)</text></gloss>
      <gloss lang="en"><text>token (used in games)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sáálɛ́ŋ</text></form></note>
  </entry>
  <entry id="sáàmbáŋ_3345">
    <lexical-unit><form lang="kqs"><text>sáàmbáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="sáàmbáŋ_3345_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz blanc à grains longs</text></gloss>
      <gloss lang="en"><text>long-grained white rice variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sáàmbáŋ</text></form></note>
  </entry>
  <entry id="sààmɛ̀íyó_3346">
    <lexical-unit><form lang="kqs"><text>sààmɛ̀íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààmɛ̀íyó_3346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure (tasse) standard pour le riz</text></gloss>
      <gloss lang="en"><text>standard rice-measuring cup</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sààmɛ̀íyó</text></form></note>
  </entry>
  <entry id="saan_3347">
    <lexical-unit><form lang="kqs"><text>saan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saan_3347_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se mettre à, commencer à (faire)</text></gloss>
      <gloss lang="en"><text>begin, set about (doing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be held, hold oneself; start again (middle of 'hold')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.13.7; Childs 2000, p. 317: sàànɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Mí nda ŋiɔn kpow a saan caŋndo « et tous deux se mirent à pleurer » (GEN.33.4) ; a saan sɛɛngianndo « ils se mirent à se quereller » (GEN.13.7).</text></form></note>
  </entry>
  <entry id="saanaa_3348">
    <lexical-unit><form lang="kqs"><text>saanaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saana</text></form></variant>
    <sense id="saanaa_3348_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>nager</text></gloss>
      <gloss lang="en"><text>swim</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swim, float; overflow (river)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.25.11; Lexique kissi–français, p. 45: saanaa/ saana; Childs 2000, p. 316: sàànàá</text></form></note>
    <note><form lang="fr"><text>mɛnndan … vanáà del nin a saanaa « une eau où il fallait nager » (EZK.47.5) ; vana siɛndi balan le saanaa « le nageur étend les mains pour nager » (ISA.25.11) ; saana (ACT.27.42).</text></form></note>
  </entry>
  <entry id="sáándííyó_3349">
    <lexical-unit><form lang="kqs"><text>sáándííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sáándííyó_3349_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clôture de concession</text></gloss>
      <gloss lang="en"><text>compound fence</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 317: sáándííyó</text></form></note>
  </entry>
  <entry id="saangiaa_3350">
    <lexical-unit><form lang="kqs"><text>saangiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saangiaa_3350_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maltraiter, opprimer, faire souffrir</text></gloss>
      <gloss lang="en"><text>mistreat, oppress, afflict</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>labour, work hard all the time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.16.6; Childs 2000, p. 317: sààŋgìáá</text></form></note>
  </entry>
  <entry id="saangian_3351">
    <lexical-unit><form lang="kqs"><text>saangian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saangianndo</text></form></variant>
    <sense id="saangian_3351_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peiner, se donner du mal, se fatiguer (à)</text></gloss>
      <gloss lang="en"><text>toil, labour, weary oneself (at)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural middle of 'tire'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.9.29; Childs 2000, p. 317: sààŋìàŋndó</text></form></note>
    <note><form lang="fr"><text>Saangian kiltan bolofaa kɔɔli le « ne te fatigue pas pour t'enrichir » (PRO.23.4) ; le yɛɛ niko mì kɔɛ saangian fondoo? « pourquoi me donner de la peine en vain ? » (JOB.9.29). De sangaa « être fatigué, peiner ».</text></form></note>
  </entry>
  <entry id="saani_3352">
    <lexical-unit><form lang="kqs"><text>saani</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saani_3352_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>planter, repiquer (un plant)</text></gloss>
      <gloss lang="en"><text>plant, set out (a seedling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plant in a nursery; look beautiful; sign</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.17.5; Childs 2000, p. 317: sààn̂ìó</text></form></note>
    <note><form lang="fr"><text>Forme courte ; la forme longue n'est pas dans la Bible. mó cua tɛyii yɔmndo pum …, mó kɔ saani ndi « il prit un plant … et alla le planter » (EZK.17.5).</text></form></note>
  </entry>
  <entry id="saasa_3353">
    <lexical-unit><form lang="kqs"><text>saasa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saasa_3353_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cage</text></gloss>
      <gloss lang="en"><text>cage</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>basket for holding chickens, chicken coop</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.19.9; Childs 2000, p. 317: sáásáá</text></form></note>
    <note><form lang="fr"><text>má vow ndu o saasa n'cilinndo nin « ils le mirent dans une cage de fer » (EZK.19.9).</text></form></note>
  </entry>
  <entry id="saasalan_3354">
    <lexical-unit><form lang="kqs"><text>saasalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saasalan_3354_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>retranchements, ouvrages de siège (pl.)</text></gloss>
      <gloss lang="en"><text>siege works, ramparts (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>barricade, fortified fence; an early women's dance</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.29.3; Childs 2000, p. 317: sààsàá</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. i baŋnin kungala saasalan « je dresserai contre toi des retranchements » (ISA.29.3, EZK.21.27) ; saasaala (ISA.29.7).</text></form></note>
  </entry>
  <entry id="sáásàŋgbànɔ̀ɔ́_3355">
    <lexical-unit><form lang="kqs"><text>sáásàŋgbànɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sáásàŋgbànɔ̀ɔ́_3355_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon comestible</text></gloss>
      <gloss lang="en"><text>edible mushroom species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 317: sáásàŋgbànɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sáátátá_3356">
