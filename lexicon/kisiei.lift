    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛlia</text></form></variant>
    <sense id="siɛɛliaa_3046_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>glisser, chanceler, tituber ; (nɛi … siɛɛliaa) chemin glissant</text></gloss>
      <gloss lang="en"><text>slip, stagger, totter; (nɛi … siɛɛliaa) slippery path</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slip, slide (plural)</text></form></field>
