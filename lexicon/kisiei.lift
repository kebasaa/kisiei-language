    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.49.22; Keita 1979, p. 142: Kungaa; Childs 2000, p. 196: kùŋgàá</text></form></note>
  </entry>
  <entry id="kungaa_1797">
    <lexical-unit><form lang="kqs"><text>kungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kunga</text></form></variant>
    <variant><form lang="kqs"><text>kunganin</text></form></variant>
    <sense id="kungaa_1797_s1">
      <grammatical-info value="Verb"/>
