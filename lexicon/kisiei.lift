    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 405: yɛ̀sìléŋ</text></form></note>
  </entry>
  <entry id="yɛ́yíɔ́_4907">
    <lexical-unit><form lang="kqs"><text>yɛ́yíɔ́</text></form></lexical-unit>
