    <trait name="status" value="respelled"/>
    <sense id="kɛkɛ_1923_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>quelconque, n'importe quel ; (o kɛkɛ) n'importe quoi, tout ce que</text></gloss>
      <gloss lang="en"><text>any, whatever; (o kɛkɛ) anything, whatever</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>any (takes the noun-class prefix of its referent)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 71: Kèkè; Childs 2000, p. 158: kèékè</text></form></note>
    <note><form lang="fr"><text>Keita (p. 71, 74) : invariable, ex. peele kɛkɛ « n'importe quelle feuille », ma kɛkɛ « n'importe quel liquide ».</text></form></note>
  </entry>
