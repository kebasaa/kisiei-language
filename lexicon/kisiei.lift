    <sense id="pìɛ̀ndìóó_4054_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>exploser</text></gloss>
      <gloss lang="en"><text>explode</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pìɛ̀ndìóó</text></form></note>
  </entry>
  <entry id="po_4055">
    <lexical-unit><form lang="kqs"><text>po</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pove</text></form></variant>
    <sense id="po_4055_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: po, powé</text></form></note>
    <note><form lang="fr"><text>Mitragyna ciliata (Rubiacées). Homographe de po « fils ».</text></form></note>
  </entry>
  <entry id="pó_4056">
    <lexical-unit><form lang="kqs"><text>pó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pó_4056_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un choc, d'un objet qui frappe ; complètement, tout à fait</text></gloss>
      <gloss lang="en"><text>sound of an impact; completely, totally</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 305: pó</text></form></note>
  </entry>
  <entry id="pókópókóó_4057">
