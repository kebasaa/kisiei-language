  <entry id="mààla_2187">
    <lexical-unit><form lang="kqs"><text>mààla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mààlan</text></form></variant>
    <sense id="mààla_2187_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abomination, acte infâme, transgression d'un interdit (tosa mààla « commettre une infamie »)</text></gloss>
      <gloss lang="en"><text>abomination, disgraceful act, breach of a taboo (tosa mààla, commit an outrage)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>taboo, behavioural restriction (e.g. incest), whose breach brings illness; obligation, debt</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.19.7; Childs 2000, p. 238: mǎá</text></form></note>
    <note><form lang="fr"><text>la tosà mààla vaa lende le « ne commettez pas un tel crime » (GEN.19.7) ; mààla bɛndu-bɛndulan « une grave abomination » (LEV.20.13). Childs : pluriel mààláŋ.</text></form></note>
  </entry>
