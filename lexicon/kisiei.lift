    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛiyo</text></form></variant>
    <sense id="sɛi_4944_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>séparer ; diviser</text></gloss>
      <gloss lang="en"><text>separate; divide</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>separate, ostracize; branch off, turn off a path</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 68 occurrences, first GEN.1.4; Lexique kissi–français, p. 48: sɛiyo/ sɛi; Childs 2000, p. 324: sèìyɔ́</text></form></note>
  </entry>
  <entry id="sɛ̀ìléŋ_4945">
    <lexical-unit><form lang="kqs"><text>sɛ̀ìléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sɛ̀ìléŋ_4945_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piquant de porc-épic</text></gloss>
      <gloss lang="en"><text>porcupine quill</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ̀ìléŋ</text></form></note>
  </entry>
  <entry id="sɛiyo_4946">
    <lexical-unit><form lang="kqs"><text>sɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sɛilan</text></form></field>
    <variant><form lang="kqs"><text>sɛi</text></form></variant>
    <sense id="sɛiyo_4946_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tombe, tombeau ; sépulcre</text></gloss>
      <gloss lang="en"><text>grave, tomb; sepulchre</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.1.6; Keita 1979, p. 148: Sèiyo; Paulme 1964, p. 90: sayo, pl. saira; Lexique kissi–français, p. 46: saiyo; Terminologie (histoire), n° 570: Sèiyo (saiyo); Childs 2000, p. 327: sɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>Homographe : sɛiyo « entre, intervalle » (Gn 1,6). Lexique kissi–français, p. 46 écrit saiyo « la tombe ». Aussi Lexique kissi–français, p. 48 : « sɛiyo ».</text></form></note>
  </entry>
  <entry id="sɛiyo_4947">
    <lexical-unit><form lang="kqs"><text>sɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɛiyo_4947_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porc-épic</text></gloss>
      <gloss lang="en"><text>porcupine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛiyo; Childs 2000, p. 327: sɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 48. Homographe de sɛiyo « tombe » et de sɛiyo « séparer ».</text></form></note>
  </entry>
  <entry id="sɛ̀ìyó_4948">
    <lexical-unit><form lang="kqs"><text>sɛ̀ìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sɛ̀ìyó_4948_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>préparer un palmier pour en tirer le vin</text></gloss>
      <gloss lang="en"><text>tap, prepare a palm tree for palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ̀ìyó</text></form></note>
  </entry>
  <entry id="sɛ̀kìmɛ́íyó_4949">
    <lexical-unit><form lang="kqs"><text>sɛ̀kìmɛ́íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɛ̀kìmɛ́íyó_4949_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine (nom d'une coiffure)</text></gloss>
      <gloss lang="en"><text>a women's hair style</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ̀kìmɛ́íyó</text></form></note>
  </entry>
  <entry id="sɛ́kìóó_4950">
    <lexical-unit><form lang="kqs"><text>sɛ́kìóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɛ́kìóó_4950_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nasse en bambou</text></gloss>
      <gloss lang="en"><text>bamboo fish trap</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ́kìóó</text></form></note>
  </entry>
  <entry id="sɛ́kpúú_4951">
    <lexical-unit><form lang="kqs"><text>sɛ́kpúú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sɛ́kpúú_4951_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bombé en avant (ventre de femme enceinte)</text></gloss>
      <gloss lang="en"><text>bulging out in front (pregnant belly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ́kpúú</text></form></note>
  </entry>
  <entry id="sɛkpɛɛ_4952">
    <lexical-unit><form lang="kqs"><text>sɛkpɛɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛkpɛɛ_4952_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>impressionnant</text></gloss>
      <gloss lang="en"><text>impressive</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 157: Sèkpèè, nyè löèi vana o köllo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). L'original ajoute nyè löèi vana o köllo « chose qui entre dans le cœur ».</text></form></note>
  </entry>
  <entry id="sɛksiɔnndo_4953">
    <lexical-unit><form lang="kqs"><text>sɛksiɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛksiɔnndo_4953_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arrondissement ; section (du parti)</text></gloss>
      <gloss lang="en"><text>district, ward; (party) section</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 75: Sèksiönndo, bungèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Emprunt (français « section ») ; aussi bungɛi « part ». Académie des langues (terminologie, idéologie n° 577) : « section ».</text></form></note>
  </entry>
  <entry id="sɛlbɛtio_4954">
    <lexical-unit><form lang="kqs"><text>sɛlbɛtio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sɛrbɛtio</text></form></variant>
    <sense id="sɛlbɛtio_4954_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serviette</text></gloss>
      <gloss lang="en"><text>towel</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛrbɛtio</text></form></note>
    <note><form lang="fr"><text>Emprunt (français serviette). Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="sɛlela_4955">
    <lexical-unit><form lang="kqs"><text>sɛlela</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛlela_4955_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser de l'eau en prononçant une imprécation</text></gloss>
      <gloss lang="en"><text>pour water while uttering a curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 91: sɛrela</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 91 : ɔ sɛrelana mɛnda (ou ɔ sɔrulana mɛnde) ; sɛrelando, nom du rite sɛo dans le canton Yalamba ; sɔe sɛrelando « la parole du sɛrelando ».</text></form></note>
  </entry>
  <entry id="sɛlio_4956">
    <lexical-unit><form lang="kqs"><text>sɛlio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sɛrio</text></form></variant>
    <sense id="sɛlio_4956_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouillie (de céréale fine) ; eau de cuisson du riz</text></gloss>
      <gloss lang="en"><text>porridge (of fine cereal); water left from cooking rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: sɛryo, pl. sɛrila; Lexique kissi–français, p. 48: sɛrio</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Définition incertaine dans le Lexique (« une céréale fine et cuite ? »). Paulme 1964, p. 92 : sɛryo, pl. sɛrila « eau qui reste de la cuisson du riz ».</text></form></note>
  </entry>
  <entry id="sɛllo_4957">
    <lexical-unit><form lang="kqs"><text>sɛllo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɛllo_4957_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fête (musulmane) ; prière musulmane ; religion musulmane</text></gloss>
      <gloss lang="en"><text>(Muslim) feast; Muslim prayer; Islam</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛllo</text></form></note>
    <note><form lang="fr"><text>Homographe de sɛ̀llo (EXO.2.3), d'un autre sens.</text></form></note>
  </entry>
  <entry id="sɛ́lɔ́ɔ́_4958">
    <lexical-unit><form lang="kqs"><text>sɛ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛrɔɔ</text></form></variant>
    <sense id="sɛ́lɔ́ɔ́_4958_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foule</text></gloss>
      <gloss lang="en"><text>crowd, multitude</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 153 occurrences, first GEN.15.5; Lexique kissi–français, p. 48: sɛrɔɔ</text></form></note>
  </entry>
  <entry id="sɛ́lɛ́_4959">
    <lexical-unit><form lang="kqs"><text>sɛ́lɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛrɛ</text></form></variant>
    <sense id="sɛ́lɛ́_4959_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>nombreux, beaucoup</text></gloss>
      <gloss lang="en"><text>many, numerous</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 365 occurrences, first GEN.16.10; Paulme 1964, p. 91: sɛrea; Lexique kissi–français, p. 48: sɛrɛ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 91 : wanlandua sɛrea « plusieurs femmes ».</text></form></note>
  </entry>
  <entry id="sɛlɛ_4960">
    <lexical-unit><form lang="kqs"><text>sɛlɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sɛlɛla</text></form></field>
    <sense id="sɛlɛ_4960_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ménage, famille conjugale</text></gloss>
      <gloss lang="en"><text>household, married couple's family</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: sɛrɛ, pl. sɛrɛla</text></form></note>
    <note><form lang="fr"><text>Homographe de sɛ́lɛ́ « nombreux » dans la Bible.</text></form></note>
  </entry>
  <entry id="sɛ́lɛ̀lɛ́_4961">
    <lexical-unit><form lang="kqs"><text>sɛ́lɛ̀lɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sɛ́lɛ̀lɛ́_4961_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>vraiment, en vérité, bel et bien</text></gloss>
      <gloss lang="en"><text>indeed, verily, really</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ́lɛ̀lɛ́</text></form></note>
  </entry>
  <entry id="sɛmbaa_4962">
    <lexical-unit><form lang="kqs"><text>sɛmbaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛmba</text></form></variant>
    <sense id="sɛmbaa_4962_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se détacher (d'un bloc)</text></gloss>
      <gloss lang="en"><text>break off, be cut out (from a mass)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break off or take away a part; whittle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DAN.2.45; Childs 2000, p. 327: sɛ̀mbàá</text></form></note>
    <note><form lang="fr"><text>powvo sɛmba a ba ndɔ o pembei « une pierre se détacha de la montagne » (DAN.2.34, DAN.2.45).</text></form></note>
  </entry>
  <entry id="sɛmbesɛya_4963">
    <lexical-unit><form lang="kqs"><text>sɛmbesɛya</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛmbesɛya_4963_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (dont les feuilles donnent une infusion)</text></gloss>
      <gloss lang="en"><text>plant (leaves used for an infusion)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sɛmbesɛya</text></form></note>
    <note><form lang="fr"><text>Paulme : yallo, Kundiadu.</text></form></note>
  </entry>
  <entry id="sɛmbo_4964">
    <lexical-unit><form lang="kqs"><text>sɛmbo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sɛmbɛla</text></form></field>
    <sense id="sɛmbo_4964_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poitrine ; force ; morceau offert au chef dans les sacrifices</text></gloss>
      <gloss lang="en"><text>chest; strength; portion offered to the chief at sacrifices</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sɛmbo, pl. sɛmbɛra</text></form></note>
  </entry>
  <entry id="sɛmbo_4965">
    <lexical-unit><form lang="kqs"><text>sɛmbo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛmbo_4965_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>filet</text></gloss>
      <gloss lang="en"><text>net</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sɛmbo</text></form></note>
    <note><form lang="fr"><text>Homographe de sɛmbo « poitrine ».</text></form></note>
  </entry>
  <entry id="sɛmbu_4966">
    <lexical-unit><form lang="kqs"><text>sɛmbu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛmbu_4966_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 91: sɛmbu</text></form></note>
  </entry>
  <entry id="sɛmbullo_4967">
    <lexical-unit><form lang="kqs"><text>sɛmbullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛmbullo_4967_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante épineuse à fibres (liens, ficelles ; remède contre les serpents)</text></gloss>
      <gloss lang="en"><text>thorny fibre plant (ties, string; remedy against snakes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: sɛmbullo, pl. invariable</text></form></note>
    <note><form lang="fr"><text>Paulme : fibres à mauvaise odeur ; entrent dans le bɔrɔ, médicament contre les serpents.</text></form></note>
  </entry>
  <entry id="sɛmbɔɔ_4968">
    <lexical-unit><form lang="kqs"><text>sɛmbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɛmbɔɔ_4968_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>puissance</text></gloss>
      <gloss lang="en"><text>power</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛnbɔɔ</text></form></note>
  </entry>
  <entry id="sɛmtɔɔ_4969">
    <lexical-unit><form lang="kqs"><text>sɛmtɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sɛmtɔɔ_4969_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>véranda, perron, marches</text></gloss>
      <gloss lang="en"><text>veranda, porch, steps</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 1KI.7.19; Keita 1979, p. 142: Sèmtöö; Paulme 1964, p. 91: sɛmutɔ; Lexique kissi–français, p. 48: sɛmtɔɔ</text></form></note>
    <note><form lang="fr"><text>Ac 21,35 : les marches de la forteresse ; 1 R 7,19 : tongo-sɛmtɔɔ « vestibule ». Paulme 1964, p. 91 : sɛmutɔ, pl. sɛmutɔra « véranda » ; a kumbu ɔ sɛmute « il est enterré sous la véranda ».</text></form></note>
  </entry>
  <entry id="sɛndio_4970">
    <lexical-unit><form lang="kqs"><text>sɛndio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛndi</text></form></variant>
    <sense id="sɛndio_4970_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>redresser ; allumer, attiser (le feu)</text></gloss>
      <gloss lang="en"><text>straighten; kindle, fan (a fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.18.33; Lexique kissi–français, p. 48: sɛndio/ sɛndi</text></form></note>
    <note><form lang="fr"><text>Lexique : « redresser ; allumer (une allumette) ». Bible : nilan sɛndio « redresser les chemins » (PSA.18.33), sɛndi yinnden « attiser le feu » (EZK.22.20).</text></form></note>
  </entry>
  <entry id="sɛndullo_4971">
    <lexical-unit><form lang="kqs"><text>sɛndullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sɛndul</text></form></variant>
    <sense id="sɛndullo_4971_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'allonger pour qqn</text></gloss>
      <gloss lang="en"><text>stretch out for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛndullo/ sɛndul</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation au radical.</text></form></note>
  </entry>
  <entry id="sɛnduo_4972">
    <lexical-unit><form lang="kqs"><text>sɛnduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sɛndu</text></form></variant>
    <sense id="sɛnduo_4972_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allonger plusieurs fois</text></gloss>
      <gloss lang="en"><text>lengthen repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 48: sɛnduo/ sɛndu</text></form></note>
  </entry>
  <entry id="sɛnndan_4973">
    <lexical-unit><form lang="kqs"><text>sɛnndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɛnndan_4973_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>savon, potasse</text></gloss>
      <gloss lang="en"><text>soap, lye</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>soap</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.9.30; Lexique kissi–français, p. 48: sɛnndan; Childs 2000, p. 328: sɛ̌ŋndáŋ</text></form></note>
    <note><form lang="fr"><text>Hali pulun bɛɛ a sodaa mà vownun sɛnndan coo taw « même si tu te laves avec du nitre et beaucoup de savon » (JER.2.22) ; pulun … a sɛnndan (JOB.9.30). Lexique kissi–français, p. 48 : aussi sɛndan.</text></form></note>
  </entry>
  <entry id="sɛnɛiyo_4974">
    <lexical-unit><form lang="kqs"><text>sɛnɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛnɛi</text></form></variant>
    <variant><form lang="kqs"><text>sɛnɛiyan</text></form></variant>
    <variant><form lang="kqs"><text>sɛnɛilan</text></form></variant>
    <variant><form lang="kqs"><text>sɛnɛiye</text></form></variant>
    <variant><form lang="kqs"><text>sɛnɛiyon</text></form></variant>
    <sense id="sɛnɛiyo_4974_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>nouveau, neuf</text></gloss>
      <gloss lang="en"><text>new</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>new, fresh</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first EXO.6; Paulme 1964, p. 88: sanɛy; Lexique kissi–français, p. 46: sanɛiyo; Childs 2000, p. 328: sènèí-</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : sanɛiyo « les nouveaux ». Paulme 1964, p. 88 : kura sanɛy ɔ ni « ce pagne est neuf » ; malo sanɛyo « le riz qui commence à sortir de terre ».</text></form></note>
  </entry>
  <entry id="sɛnɛsinaa kɔlɔladiomndo_4975">
    <lexical-unit><form lang="kqs"><text>sɛnɛsinaa kɔlɔladiomndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛnɛsinaa kɔlɔladiomndo_4975_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lexicologie</text></gloss>
      <gloss lang="en"><text>lexicology</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 229: Sènèsinaa kölöladiomndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Lexical » : a kölöladiomndo o köö (langue n° 228). Sènèsinaa est peut-être une faute pour dènèsinaa « connaissance ».</text></form></note>
  </entry>
  <entry id="sɛo_4976">
    <lexical-unit><form lang="kqs"><text>sɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛo_4976_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rite d'exécration (en versant de l'eau)</text></gloss>
      <gloss lang="en"><text>cursing rite (by pouring water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 91: sɛo, pl. sɛrã</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 91 : ɔ sɛo dɔo « il a versé le sɛo », rite exécratoire. Cf. sɛlela.</text></form></note>
  </entry>
  <entry id="sɛo_4977">
    <lexical-unit><form lang="kqs"><text>sɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sɛkɛlan</text></form></field>
    <sense id="sɛo_4977_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hochet en calebasse (à percussion extérieure)</text></gloss>
      <gloss lang="en"><text>gourd rattle (with outer beads)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 91: sɛo, pl. sɛkɛrã</text></form></note>
    <note><form lang="fr"><text>Homographe de sɛo (rite).</text></form></note>
  </entry>
  <entry id="sɛsiei_4978">
    <lexical-unit><form lang="kqs"><text>sɛsiei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="sɛsiei_4978_s1">
