    <trait name="status" value="southern"/>
    <sense id="pɛ̀ɲííyó_4299_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égratignure sur la main</text></gloss>
      <gloss lang="en"><text>scratch on the hand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ɲííyó</text></form></note>
  </entry>
  <entry id="revolisiɔnndo_4300">
    <lexical-unit><form lang="kqs"><text>revolisiɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>revolisiɔnnɔɔ</text></form></variant>
    <sense id="revolisiɔnndo_4300_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>révolution ; (revolisiɔnnɔɔ) révolutionnaire</text></gloss>
      <gloss lang="en"><text>revolution; (revolisiɔnnɔɔ) revolutionary</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 554: Revolisiönndo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français, proposé par l'Académie des langues (années 1970) ; r conservé (emprunt). Aussi idéologie n° 567 ; revolisiɔnnɔɔ « révolutionnaire » (n° 568).</text></form></note>
  </entry>
  <entry id="robuo_4301">
    <lexical-unit><form lang="kqs"><text>robuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="robuo_4301_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jupe, robe</text></gloss>
      <gloss lang="en"><text>skirt, dress</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: robuo</text></form></note>
    <note><form lang="fr"><text>Emprunt (français robe) ; r gardé comme dans les emprunts.</text></form></note>
  </entry>
  <entry id="rɛsɛnndo_4302">
    <lexical-unit><form lang="kqs"><text>rɛsɛnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>rɛsɛn</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnndon</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛŋun</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnndan</text></form></variant>
    <variant><form lang="kqs"><text>rɛsɛnnda</text></form></variant>
    <sense id="rɛsɛnndo_4302_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vigne, cep de vigne ; (rɛsɛnndon) raisins</text></gloss>
      <gloss lang="en"><text>vine, grapevine; (rɛsɛnndon) grapes</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.9.20</text></form></note>
    <note><form lang="fr"><text>rɛsɛŋun toaŋaa « raisins secs » (Ct 2,5) ; n'rɛsɛnndan « vignes, vignobles ».</text></form></note>
  </entry>
  <entry id="saa_4303">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="saa_4303_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouton</text></gloss>
      <gloss lang="en"><text>sheep</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 672 occurrences, first GEN.12.16; Keita 1979, p. 137: Saa; Paulme 1964, p. 87: sa, pl. sā, saa; Lexique kissi–français, p. 45: saa; Childs 2000, p. 315: sàá</text></form></note>
    <note><form lang="fr"><text>Invariable : saa « mouton, moutons ». Paulme 1964, p. 87 : sa kundu « bélier » ; sa landu « brebis » ; sa tuao, sa pɔmbo « agneau ».</text></form></note>
  </entry>
  <entry id="saa_4304">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saa_4304_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>octobre</text></gloss>
      <gloss lang="en"><text>October</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Saa; Paulme 1964, p. 87: saā; Lexique kissi–français, p. 45: Saa; Terminologie (langue), n° 446: Saa ✎ 2</text></form></note>
    <note><form lang="fr"><text>Même forme que saa « mouton » ; nom de mois absent de la Bible. Confirmé au Nord par le Lexique kissi–français, p. 45 (Saa « octobre »). Paulme 1964, p. 87 : saā « troisième mois ». Académie des langues (terminologie, langue n° 446) : « octobre », numéroté à la main 2.</text></form></note>
  </entry>
  <entry id="saa_4305">
    <lexical-unit><form lang="kqs"><text>saa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sa</text></form></variant>
    <sense id="saa_4305_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, attraper ; tenir ; prendre ; prendre feu</text></gloss>
      <gloss lang="en"><text>grab, seize, catch; hold; take; catch fire</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saa/ sa; Childs 2000, p. 315: sàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 45 (saa/ sa « prendre feu ; tenir, prendre »).</text></form></note>
  </entry>
  <entry id="saa cuao_4306">
    <lexical-unit><form lang="kqs"><text>saa cuao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saa cuao_4306_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agneau</text></gloss>
      <gloss lang="en"><text>lamb</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saa cuao</text></form></note>
    <note><form lang="fr"><text>saa « mouton » et cuao « petit (d'animal) » sont dans la Bible séparément.</text></form></note>
  </entry>
  <entry id="saa kóndóó_4307">
    <lexical-unit><form lang="kqs"><text>saa kóndóó</text></form></lexical-unit>
