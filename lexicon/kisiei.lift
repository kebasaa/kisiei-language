      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sòké</text></form></note>
  </entry>
  <entry id="soko_4676">
    <lexical-unit><form lang="kqs"><text>soko</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sokoa</text></form></variant>
    <sense id="soko_4676_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forme d'initiation masculine</text></gloss>
      <gloss lang="en"><text>kind of male initiation</text></gloss>
