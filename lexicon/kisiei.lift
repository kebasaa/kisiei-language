    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: safuna</text></form></note>
    <note><form lang="fr"><text>La Bible dit sɛnndan.</text></form></note>
  </entry>
  <entry id="sáká_3363">
    <lexical-unit><form lang="kqs"><text>sáká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sáká_3363_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>exclamation d'étonnement ou d'admiration</text></gloss>
