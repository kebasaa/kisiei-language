    <trait name="status" value="respelled"/>
    <sense id="mɔsɔŋaa_821_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler</text></gloss>
      <gloss lang="en"><text>gather, put together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix or put together</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhaa; Childs 2000, p. 253: mɔ̀sɔ̀ŋàá</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : mɔsɔŋa (LEV 22,28), mɔsɔŋan « se rassembler » (GEN 34,30).</text></form></note>
  </entry>
