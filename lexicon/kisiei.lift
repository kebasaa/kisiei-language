      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau à longue queue qui paraît à la moisson</text></gloss>
      <gloss lang="en"><text>long-tailed bird that appears at harvest time</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 10: bémbékɔ́lɔ́ɔ́</text></form></note>
  </entry>
