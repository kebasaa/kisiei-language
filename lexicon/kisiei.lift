    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first DEU.23.3</text></form></note>
  </entry>
  <entry id="samkpaa_1403">
    <lexical-unit><form lang="kqs"><text>samkpaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="samkpaa_1403_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam crépitant</text></gloss>
      <gloss lang="en"><text>a kind of drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drum about three feet high, held between the legs and played with the hands</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Samkpaa; Childs 2000, p. 322: sáŋgbáá</text></form></note>
  </entry>
  <entry id="samtaa_1404">
