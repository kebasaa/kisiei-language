      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ROM.2.26; Keita 1979, p. 161: Köndenöö; Lexique kissi–français, p. 27: kɔndenɔɔ</text></form></note>
  </entry>
  <entry id="kɔ̀ndì-kòlàá_2210">
    <lexical-unit><form lang="kqs"><text>kɔ̀ndì-kòlàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kɔ̀ndì-kòlèíláŋ</text></form></field>
    <sense id="kɔ̀ndì-kòlàá_2210_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étoffe de coton grossière tissée au pays</text></gloss>
      <gloss lang="en"><text>coarse homespun cotton cloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 184: kɔ̀ndì-kòlàá kɔ̀ndì-kòlèíláŋ</text></form></note>
  </entry>
  <entry id="kɔndɔfillo_2211">
    <lexical-unit><form lang="kqs"><text>kɔndɔfillo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kɔndɔfiltan</text></form></field>
    <variant><form lang="kqs"><text>kɔndɔfili</text></form></variant>
    <variant><form lang="kqs"><text>kɔndɔfilta</text></form></variant>
    <sense id="kɔndɔfillo_2211_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>merveille, prodige ; étonnement</text></gloss>
      <gloss lang="en"><text>wonder, marvel; amazement</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>surprise, wonder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first GEN.43.33; Lexique kissi–français, p. 27: kɔndɔfillo; Childs 2000, p. 184: kɔ̀ndɔ̀fílló</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 27 : kɔndɔfillo dɔvɔɔ « étonnement, surprise ».</text></form></note>
  </entry>
  <entry id="kɔndɔɔ_2212">
    <lexical-unit><form lang="kqs"><text>kɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔndu</text></form></variant>
    <sense id="kɔndɔɔ_2212_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>puiser (de l'eau) ; ramasser, prendre (une poignée)</text></gloss>
      <gloss lang="en"><text>draw (water); gather, take (a handful)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scoop up, draw, collect; also hand out shares, clear a swamp for rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.24.11; Lexique kissi–français, p. 27: kɔndɔɔ/ kɔandu; Childs 2000, p. 175: kɔ̀ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 26-27 : aussi « prendre le repas ».</text></form></note>
  </entry>
  <entry id="kɔ̀ndɔ̀ɔ́_2213">
    <lexical-unit><form lang="kqs"><text>kɔ̀ndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kɔ̀ndɔ̀ɔ̀láŋ</text></form></field>
    <sense id="kɔ̀ndɔ̀ɔ́_2213_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand couteau rituel du devin-guérisseur</text></gloss>
      <gloss lang="en"><text>large ritual knife used by a shaman</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 184: kɔ̀ndɔ̀ɔ́ kɔ̀ndɔ̀ɔ̀láŋ</text></form></note>
  </entry>
  <entry id="kɔ̀ndɔ̀ɔ́_2214">
    <lexical-unit><form lang="kqs"><text>kɔ̀ndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ndɔ̀ɔ́_2214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jambes arquées</text></gloss>
      <gloss lang="en"><text>bow-leggedness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ̀ndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kɔ́ndɔ́ɔ́_2215">
    <lexical-unit><form lang="kqs"><text>kɔ́ndɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kɔ́ndɔ́láŋ</text></form></field>
    <sense id="kɔ́ndɔ́ɔ́_2215_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>repas préparé pour ceux qui travaillent pour soi</text></gloss>
      <gloss lang="en"><text>food prepared for people working for one</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ́ndɔ́ɔ́ kɔ́ndɔ́láŋ</text></form></note>
  </entry>
  <entry id="kɔngɔ_2216">
    <lexical-unit><form lang="kqs"><text>kɔngɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔngɔ_2216_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terre ferme ; rive, bord (de l'eau)</text></gloss>
      <gloss lang="en"><text>dry land; shore, bank</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bank, shore, dry land; higher ground around a swamp</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 181 occurrences, first GEN.1.9; Childs 2000, p. 185: kɔ̀ŋgɔ́ɔ</text></form></note>
  </entry>
  <entry id="kɔngɔlanndo_2217">
    <lexical-unit><form lang="kqs"><text>kɔngɔlanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔngɔlan</text></form></variant>
    <sense id="kɔngɔlanndo_2217_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>projeter, avoir l'intention de ; chercher à (nuire) ; penser à, espérer en</text></gloss>
      <gloss lang="en"><text>plan, intend; seek (to harm); think of, hope in</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.27.42; Lexique kissi–français, p. 27: kɔngɔlanndo/ kɔngɔlan</text></form></note>
    <note><form lang="fr"><text>Esau … co kɔngɔlanndo le pɔmbɔ ndɔ diyɔɔ « Ésaü projette de tuer son frère » (Gn 27,42) ; Mɛlɛka kɔngɔlan le kobio ho tɛɛmbuuo (Gn 19,14). Homographe : kɔngɔlan, pluriel de kɔngɔɔ « rive ». Lexique kissi–français, p. 27 : « penser de, espoir en, proposer de ».</text></form></note>
  </entry>
  <entry id="kɔngɔlɔɛi_2218">
    <lexical-unit><form lang="kqs"><text>kɔngɔlɔɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔngɔlɔɛi_2218_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tactique (Keita)</text></gloss>
      <gloss lang="en"><text>tactic (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>long war sword (about four feet)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Köngölöèi; Lexique kissi–français, p. 27: kɔngɔlɔɛi; Childs 2000, p. 253: mùɛ̀-kɔ́ŋgɔ̀lúɛ́í</text></form></note>
    <note><form lang="fr"><text>Sens à confirmer : chez Childs, kɔ́ŋgɔ̀lúɛ́í désigne une grande épée de guerre. Confirmé au Nord par le Lexique kissi–français, p. 27 (« la tactique »).</text></form></note>
  </entry>
  <entry id="kɔngɔsila_2219">
    <lexical-unit><form lang="kqs"><text>kɔngɔsila</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔngɔsila_2219_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tortue</text></gloss>
      <gloss lang="en"><text>tortoise</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 27: kɔngɔsira</text></form></note>
    <note><form lang="fr"><text>Écrit kɔngɔsira. La Bible et Keita ont sangɔɔ « tortue ».</text></form></note>
  </entry>
  <entry id="kɔngɔɔ_2220">
    <lexical-unit><form lang="kqs"><text>kɔngɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kɔngɔɔ_2220_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rivage, rive, bord</text></gloss>
      <gloss lang="en"><text>shore, bank, edge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bank, shore, dry land; the higher ground around a swamp</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.41.2; Keita 1979, p. 155: Köngöö; Lexique kissi–français, p. 27: kɔngɔɔ; Childs 2000, p. 185: kɔ̀ŋgɔ́ɔ́</text></form></note>
  </entry>
  <entry id="kɔnndan_2221">
    <lexical-unit><form lang="kqs"><text>kɔnndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔnndan_2221_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>départ, fuite</text></gloss>
      <gloss lang="en"><text>departure, flight</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.15.2</text></form></note>
    <note><form lang="fr"><text>can kɔnndan « s'enfuir, partir » (Gn 31,20) ; mal … kɔnndan « laisser partir » (Ex 14,5) ; a va kɔnndan-ndo « ils étaient en route » (Ex 12,38).</text></form></note>
  </entry>
  <entry id="kɔntanndo_2222">
    <lexical-unit><form lang="kqs"><text>kɔntanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kɔntan</text></form></variant>
    <sense id="kɔntanndo_2222_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'en aller, partir</text></gloss>
      <gloss lang="en"><text>go away, leave</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 27: kɔntan</text></form></note>
    <note><form lang="fr"><text>Lexique : kɔntan « s'en aller, partir », kɔntanndo (p. 27), kontan « est allé », kɔanun (rad.) « s'en aller, partir » (p. 26).</text></form></note>
  </entry>
  <entry id="kɔnyaa_2223">
    <lexical-unit><form lang="kqs"><text>kɔnyaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kɔnyaa_2223_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épidémie mortelle (nàà n'kɔnyaa « peste »)</text></gloss>
      <gloss lang="en"><text>deadly epidemic (nàà n'kɔnyaa 'pestilence')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note><form lang="fr"><text>Seulement dans nàà n'kɔnyaa « la peste » (Ex 5,3 ; Lv 26,25).</text></form></note>
  </entry>
  <entry id="kɔnɔ_2224">
    <lexical-unit><form lang="kqs"><text>kɔnɔ</text></form></lexical-unit>
