      <gloss lang="en"><text>fast, heavy stepping (of big animals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bíkà-bíkà</text></form></note>
  </entry>
  <entry id="bìl-kpèlòó_186">
