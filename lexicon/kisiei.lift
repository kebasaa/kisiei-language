      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 273: ŋgúèléŋ</text></form></note>
  </entry>
  <entry id="ŋgúɲàá_4935">
    <lexical-unit><form lang="kqs"><text>ŋgúɲàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ŋúɲàà</text></form></variant>
    <sense id="ŋgúɲàá_4935_s1">
      <grammatical-info value="Proper Noun"/>
      <gloss lang="fr"><text>masque (« diable ») au long bec, couvert de plumes, à jupe de raphia (Landai)</text></gloss>
      <gloss lang="en"><text>long-billed, feathered mask ('devil') with a raffia skirt (Landai)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 273: ŋgúɲàá</text></form></note>
    <note><form lang="fr"><text>Même masque que làndàá ; chez les Kissi, Bandi et Loma du Liberia.</text></form></note>
  </entry>
  <entry id="ŋgɔ̀ɔ́_4936">
