      <gloss lang="en"><text>waterfall</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bàlló</text></form></note>
