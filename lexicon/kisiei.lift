  <entry id="vanlaandoo_1800">
    <lexical-unit><form lang="kqs"><text>vanlaandoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vanlaandua</text></form></field>
    <variant><form lang="kqs"><text>vanlaandu</text></form></variant>
    <sense id="vanlaandoo_1800_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme (personne de sexe féminin) ; (pl.) les femmes</text></gloss>
      <gloss lang="en"><text>woman, female person; (pl.) women</text></gloss>
