      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(objet petit) flottant dans un trou trop grand</text></gloss>
      <gloss lang="en"><text>(of a small thing) loose in a hole too big</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yɔlɔ-yɔlɔ</text></form></note>
  </entry>
  <entry id="yɔlɔn_4851">
