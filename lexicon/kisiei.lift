  <entry id="banɛɔɔ_93">
    <lexical-unit><form lang="kqs"><text>banɛɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="banɛɔɔ_93_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clef</text></gloss>
      <gloss lang="en"><text>key</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Banèöö; Lexique kissi–français, p. 4: banɛɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 4 : « la clé, particulièrement pour une serrure en bois ».</text></form></note>
  </entry>
  <entry id="basabasakoendoo_94">
    <lexical-unit><form lang="kqs"><text>basabasakoendoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>basabasakoendea</text></form></field>
    <variant><form lang="kqs"><text>basabasakoende</text></form></variant>
    <sense id="basabasakoendoo_94_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corbeau</text></gloss>
      <gloss lang="en"><text>raven, crow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a crow-like bird, larger than the kùèndòò</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.8.7; Lexique kissi–français, p. 4: basabasakondoo; Childs 2000, p. 8: bàsàbàsà-kùèndóó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit basabasakondoo (p. 4) et balamasakondoo (p. 3) « oiseau noir et blanc (corbeau) ».</text></form></note>
  </entry>
  <entry id="básí_95">
    <lexical-unit><form lang="kqs"><text>básí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="básí_95_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>jaune</text></gloss>
      <gloss lang="en"><text>yellow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 9: básí</text></form></note>
  </entry>
  <entry id="basi taando_96">
    <lexical-unit><form lang="kqs"><text>basi taando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="basi taando_96_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabatière</text></gloss>
      <gloss lang="en"><text>snuffbox</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tobacco, snuff</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: basi taando; Lexique kissi–français, p. 4: basi taando; Childs 2000, p. 347: tàáŋndó</text></form></note>
    <note><form lang="fr"><text>Le second élément correspond à tàáŋndó « tabac » chez Childs.</text></form></note>
  </entry>
  <entry id="básíó_97">
    <lexical-unit><form lang="kqs"><text>básíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>básíéí</text></form></field>
    <sense id="básíó_97_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à teinture jaune (bois de cam ?) ; tissu teint avec</text></gloss>
      <gloss lang="en"><text>tree giving a yellow dye (camwood?); cloth dyed with it</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 9: básíó</text></form></note>
  </entry>
  <entry id="basɔɔ_98">
    <lexical-unit><form lang="kqs"><text>basɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>basu</text></form></variant>
    <variant><form lang="kqs"><text>basunin</text></form></variant>
    <sense id="basɔɔ_98_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>balayer</text></gloss>
      <gloss lang="en"><text>sweep</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.5 Sweep, rake"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sweep, clear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1KI.14.10; Keita 1979, p. 114: Basöö; Lexique kissi–français, p. 4: basɔɔ/ basu, besu; Childs 2000, p. 9: bàsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi : besu.</text></form></note>
  </entry>
  <entry id="bátákálàá_99">
    <lexical-unit><form lang="kqs"><text>bátákálàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bátákálàláŋ</text></form></field>
    <sense id="bátákálàá_99_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peau brunie par l'exposition répétée au feu</text></gloss>
      <gloss lang="en"><text>skin darkened by repeated exposure to fire</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 9: bátákálàá</text></form></note>
  </entry>
  <entry id="batisio_100">
    <lexical-unit><form lang="kqs"><text>batisio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>batisi</text></form></variant>
    <sense id="batisio_100_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>baptiser ; baptême</text></gloss>
      <gloss lang="en"><text>baptize; baptism</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: batisio/ batisi</text></form></note>
    <note><form lang="fr"><text>Emprunt au français. La Bible dit yinɔɔ « baptiser ».</text></form></note>
  </entry>
  <entry id="bau_101">
    <lexical-unit><form lang="kqs"><text>bau</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bau_101_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>car, puisque</text></gloss>
      <gloss lang="en"><text>for, because</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 83 occurrences, first GEN.9.6; Lexique kissi–français, p. 4: bau</text></form></note>
  </entry>
