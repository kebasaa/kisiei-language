      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀nɛ̀nɔ̀ɔ́</text></form></note>
