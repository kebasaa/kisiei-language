    <variant><form lang="kqs"><text>latɔ́ɔ́a</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́lan</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́-tɔ́ɔ́</text></form></variant>
    <sense id="latɔ́ɔ́_2007_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noble, grand, précieux</text></gloss>
      <gloss lang="en"><text>noble, great, precious</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
