  </entry>
  <entry id="idiiyo_1341">
    <lexical-unit><form lang="kqs"><text>idiiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>idii</text></form></variant>
    <sense id="idiiyo_1341_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le matin, tôt</text></gloss>
      <gloss lang="en"><text>in the morning, early</text></gloss>
