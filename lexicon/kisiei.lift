    <trait name="status" value="southern"/>
    <sense id="léùléù_2420_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>souple, flexible</text></gloss>
      <gloss lang="en"><text>flexible, pliant</text></gloss>
