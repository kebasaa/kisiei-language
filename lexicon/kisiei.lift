  <entry id="kɔ̀ndénɔɔ_2209">
    <lexical-unit><form lang="kqs"><text>kɔ̀ndénɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kɔ̀ndénɔɔ_2209_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>incirconcis, non-initié</text></gloss>
