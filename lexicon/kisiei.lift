    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleep (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 123 occurrences, first GEN.2.21; Childs 2000, p. 235: lùáŋ</text></form></note>
  </entry>
