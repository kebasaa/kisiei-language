      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écorcer, effeuiller, élaguer ; arracher (des fibres) ; battre (jusqu'aux pleurs)</text></gloss>
      <gloss lang="en"><text>strip, peel, trim; pull off (fibre); beat (until one cries)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 13: bèyó</text></form></note>
  </entry>
  <entry id="bèŋgéí_216">
    <lexical-unit><form lang="kqs"><text>bèŋgéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bèŋgóŋ</text></form></field>
    <sense id="bèŋgéí_216_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brisures de riz pilé ; particules dans la lie du vin de palme</text></gloss>
      <gloss lang="en"><text>broken kernels of pounded rice; particles in palm-wine dregs</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 10: bèŋgéí</text></form></note>
  </entry>
