      <gloss lang="fr"><text>bien caché, introuvable</text></gloss>
      <gloss lang="en"><text>well hidden, not to be found</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 341: sɔ́ɔ́ù</text></form></note>
  </entry>
  <entry id="sɔ̀ɔ̀yòó_3799">
    <lexical-unit><form lang="kqs"><text>sɔ̀ɔ̀yòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
