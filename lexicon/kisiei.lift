      <gloss lang="en"><text>robust, healthy (a small group of children, chicks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 378: wáá-wáá</text></form></note>
