      <gloss lang="fr"><text>guerrier vaillant, héros</text></gloss>
      <gloss lang="en"><text>mighty warrior, hero</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first EXO.15.3</text></form></note>
  </entry>
  <entry id="kuubanɔɔ_1807">
