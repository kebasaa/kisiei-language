      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de bambou</text></gloss>
      <gloss lang="en"><text>a species of bamboo</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 300: pìlàŋndéŋ</text></form></note>
  </entry>
  <entry id="pílí-pílí_2604">
    <lexical-unit><form lang="kqs"><text>pílí-pílí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pílí-pílí_2604_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>extrêmement (haut, loin, longtemps)</text></gloss>
      <gloss lang="en"><text>extremely (high, far, long)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pílí-pílí</text></form></note>
  </entry>
  <entry id="pílíkò-pílíkò_2605">
    <lexical-unit><form lang="kqs"><text>pílíkò-pílíkò</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pílíkò-pílíkò_2605_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>l'un après l'autre (choses qui passent en série)</text></gloss>
      <gloss lang="en"><text>one after another (things passing in a series)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pílíkò-pílíkò</text></form></note>
  </entry>
  <entry id="pìlìŋàá_2606">
    <lexical-unit><form lang="kqs"><text>pìlìŋàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìlìŋàá_2606_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gâter (un enfant)</text></gloss>
      <gloss lang="en"><text>spoil (a child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pìlìŋàá</text></form></note>
    <note><form lang="fr"><text>Variante pɔ̀lɔ̀ŋàá.</text></form></note>
  </entry>
  <entry id="pìllá_2607">
    <lexical-unit><form lang="kqs"><text>pìllá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìllá_2607_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, en grand nombre</text></gloss>
      <gloss lang="en"><text>very much, a lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pìllá</text></form></note>
  </entry>
  <entry id="pílò_2608">
    <lexical-unit><form lang="kqs"><text>pílò</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pílò_2608_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>de justesse, de très près</text></gloss>
      <gloss lang="en"><text>nearly, very closely (just missing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pílò</text></form></note>
  </entry>
  <entry id="pilɔɔ_2609">
    <lexical-unit><form lang="kqs"><text>pilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pilla</text></form></variant>
    <variant><form lang="kqs"><text>pilɔn</text></form></variant>
    <variant><form lang="kqs"><text>pilɛn</text></form></variant>
    <sense id="pilɔɔ_2609_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>un, un seul ; le même (accordé au nom)</text></gloss>
      <gloss lang="en"><text>one, a single; the same (agreeing with the noun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>one, a single, the same, alone; some</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 401 occurrences, first GEN.1.9; Childs 2000, p. 301: pìlé</text></form></note>
    <note><form lang="fr"><text>Formes d'accord de pilɛ « un ». o baa pilɔɔ « en un seul lieu » (GEN.1.9) ; o diom pilɔɔ nin « d'un commun accord » (GEN.5.22) ; vanaa pilla « un seul peuple » (GEN.34.16) ; sɔɔn pilɔn mun « les mêmes paroles » (JDG.16.16) ; sɔɔn pilɛn mun (MAT.26.44).</text></form></note>
  </entry>
  <entry id="pilɛ_2610">
    <lexical-unit><form lang="kqs"><text>pilɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pilɛ_2610_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>un</text></gloss>
      <gloss lang="en"><text>one</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1725 occurrences, first GEN.1.9; Childs 2000, p. 301: pìlɛ́ɛ́</text></form></note>
  </entry>
  <entry id="pilɛn-pilɛn_2611">
    <lexical-unit><form lang="kqs"><text>pilɛn-pilɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pilɛn-pilɛn_2611_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un à un, l'un après l'autre ; deux à deux</text></gloss>
      <gloss lang="en"><text>one by one, one after another; in pairs</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>one by one; a little, bit by bit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.15.4; Childs 2000, p. 301: pìléŋ-píléŋ</text></form></note>
    <note><form lang="fr"><text>dɛnndan ndan la pilɛn-pilɛn « (examinant) les choses une à une » (ECC.7.27) ; (attacher les queues) deux à deux (JDG.15.4).</text></form></note>
  </entry>
  <entry id="pim_2612">
    <lexical-unit><form lang="kqs"><text>pim</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pimi</text></form></variant>
    <sense id="pim_2612_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être rassasié, avoir assez (bu) ; (pimi) faire boire, rassasier</text></gloss>
      <gloss lang="en"><text>be satisfied, have enough (to drink); (pimi) give to drink, satisfy</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.24.19</text></form></note>
  </entry>
  <entry id="pîm_2613">
    <lexical-unit><form lang="kqs"><text>pîm</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pîm_2613_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit sourd (pilon, chute, coup)</text></gloss>
      <gloss lang="en"><text>thudding sound (pounding, falling, a blow)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 301: pîm</text></form></note>
  </entry>
  <entry id="pimbullo_2614">
    <lexical-unit><form lang="kqs"><text>pimbullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pimbul</text></form></variant>
    <variant><form lang="kqs"><text>pimbulu</text></form></variant>
    <variant><form lang="kqs"><text>pimbulaa</text></form></variant>
    <sense id="pimbullo_2614_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rouler (une pierre) ; se rouler, s'écrouler</text></gloss>
      <gloss lang="en"><text>roll (a stone); roll over, collapse</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.7.13; Childs 2000, p. 302: pìmbùlló</text></form></note>
    <note><form lang="fr"><text>La pimbul powta bɛndulan « roulez de grosses pierres » (Jos 10,18) ; mó va pimbullo « il se roulait (par terre) » (Mc 9,20).</text></form></note>
  </entry>
  <entry id="pîmpíbà_2615">
    <lexical-unit><form lang="kqs"><text>pîmpíbà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pîmpíbà_2615_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>planté ferme, immobile (comme une sentinelle)</text></gloss>
      <gloss lang="en"><text>standing firmly, staying put (like a sentry)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 302: pîmpíbà</text></form></note>
  </entry>
  <entry id="pìndàpìndàá_2616">
    <lexical-unit><form lang="kqs"><text>pìndàpìndàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìndàpìndàá_2616_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enrouler, entortiller (le fil autour du fuseau)</text></gloss>
      <gloss lang="en"><text>wrap around, twine (thread on a spindle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 302: pìndàpìndàá</text></form></note>
  </entry>
  <entry id="pìndìèí_2617">
    <lexical-unit><form lang="kqs"><text>pìndìèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pìndìóŋ</text></form></field>
    <sense id="pìndìèí_2617_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nonchalance, mollesse, paresse</text></gloss>
      <gloss lang="en"><text>sluggishness, listlessness, laziness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 302: pìndìèí</text></form></note>
  </entry>
  <entry id="pindipindio_2618">
    <lexical-unit><form lang="kqs"><text>pindipindio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pindipindio_2618_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charbon (pour tracer) ?</text></gloss>
      <gloss lang="en"><text>charcoal (for marking)?</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>coals, charcoal (variant pìndìpìndìó)</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 302: pìndìó</text></form></note>
    <note><form lang="fr"><text>Un seul emploi : o tɛnda tindilen a pindipindio « il trace (le bois) au … » (ISA.44.13), où l'hébreu a un outil à tracer (craie, stylet). Le sens « charbon » est déduit de Childs ; à confirmer.</text></form></note>
  </entry>
  <entry id="pindo_2619">
    <lexical-unit><form lang="kqs"><text>pindo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pindo_2619_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pourtour ; (… pindo) autour de</text></gloss>
      <gloss lang="en"><text>surroundings; (… pindo) around</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 97 occurrences, first GEN.19.4</text></form></note>
  </entry>
  <entry id="pìndùlló_2620">
    <lexical-unit><form lang="kqs"><text>pìndùlló</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìndùlló_2620_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enrouler le fil de coton sur un bâton (filage)</text></gloss>
      <gloss lang="en"><text>roll cotton thread on a stick (spinning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 303: pìndùlló</text></form></note>
  </entry>
  <entry id="piondɔɔ_2621">
    <lexical-unit><form lang="kqs"><text>piondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piondu</text></form></variant>
    <variant><form lang="kqs"><text>pendu</text></form></variant>
    <sense id="piondɔɔ_2621_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>acheter, acquérir</text></gloss>
      <gloss lang="en"><text>buy, acquire</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>buy, barter, exchange; pendu is one of its stems</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.17.12; Childs 2000, p. 303: pìòndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>pendu : autre radical, au même sens (vana pendu ndu-o « celui qui l'a acheté », Lv 25,30).</text></form></note>
  </entry>
  <entry id="píóó_2622">
    <lexical-unit><form lang="kqs"><text>píóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="píóó_2622_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre</text></gloss>
      <gloss lang="en"><text>a tree species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 303: píóó</text></form></note>
  </entry>
  <entry id="piow_2623">
    <lexical-unit><form lang="kqs"><text>piow</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piawnin</text></form></variant>
    <sense id="piow_2623_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abandonner, déserter, quitter (un lieu)</text></gloss>
      <gloss lang="en"><text>abandon, desert, leave (a place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make leave, drive away; also spend the evening</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first ISA.27.10; Childs 2000, p. 305: pìùwó</text></form></note>
    <note><form lang="fr"><text>Yowva coocoo a visia yondoa piow lon « oiseaux et bêtes ont fui » (Jr 9,9) ; mɛɛ yàlàá piaw bɔɔ ndɔɔ « comme un lion quitte son repaire » (Jr 25,38) ; vannda piawnin ndi « elle sera abandonnée » (Es 7,16). Forme longue non relevée.</text></form></note>
  </entry>
  <entry id="pìòŋɔ̀ɔ́_2624">
    <lexical-unit><form lang="kqs"><text>pìòŋɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìòŋɔ̀ɔ́_2624_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>survivre, guérir ; se repentir ; avoir des pellicules</text></gloss>
      <gloss lang="en"><text>survive, heal; repent; have dandruff</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 303: pìòŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pìòŋɔ̀ɔ́_2625">
    <lexical-unit><form lang="kqs"><text>pìòŋɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pìòŋɔ̀ɔ̀láŋ</text></form></field>
    <sense id="pìòŋɔ̀ɔ́_2625_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pellicules ; peau sèche ; mue (de serpent, d'araignée)</text></gloss>
      <gloss lang="en"><text>dandruff; dry flaky skin; shed skin (of snake, spider)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 303: pìòŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pisio_2626">
    <lexical-unit><form lang="kqs"><text>pisio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pisi</text></form></variant>
    <variant><form lang="kqs"><text>pisinin</text></form></variant>
    <sense id="pisio_2626_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vendre</text></gloss>
      <gloss lang="en"><text>sell</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sell; give away freely</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 38 occurrences, first GEN.31.15; Keita 1979, p. 113: Pisio; Childs 2000, p. 305: pìsìó</text></form></note>
  </entry>
  <entry id="pisultan_2627">
    <lexical-unit><form lang="kqs"><text>pisultan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="pisultan_2627_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeu, jeux</text></gloss>
      <gloss lang="en"><text>play, games</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>play, joke, tease (also a verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.21.9; Keita 1979, p. 163: Pisultan; Childs 2000, p. 305: pìsúltáŋ</text></form></note>
  </entry>
  <entry id="pisultan_2628">
    <lexical-unit><form lang="kqs"><text>pisultan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pisul</text></form></variant>
    <variant><form lang="kqs"><text>pisulnin</text></form></variant>
    <sense id="pisultan_2628_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jouer, s'amuser</text></gloss>
      <gloss lang="en"><text>play</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>play, joke</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.21.9; Keita 1979, p. 113: Pisultan; Childs 2000, p. 305: pìsúltáŋ</text></form></note>
  </entry>
  <entry id="pìùwó_2629">
    <lexical-unit><form lang="kqs"><text>pìùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pìùwó_2629_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soirée (vers 18-20 h)</text></gloss>
      <gloss lang="en"><text>evening (about 6 to 8 pm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 305: pìùwó</text></form></note>
  </entry>
  <entry id="pìyó_2630">
    <lexical-unit><form lang="kqs"><text>pìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìyó_2630_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever, emporter (ordures, tas de terre), déplacer</text></gloss>
      <gloss lang="en"><text>remove, take away (rubbish, dirt), move elsewhere</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 299: pìyó</text></form></note>
  </entry>
  <entry id="píŋndo_2631">
    <lexical-unit><form lang="kqs"><text>píŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>piŋndan</text></form></field>
    <sense id="píŋndo_2631_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, encerclement ; (luei … o píŋndo nin) assiéger, enfermer</text></gloss>
      <gloss lang="en"><text>enclosure, encirclement; (luei … o píŋndo nin) besiege, hem in</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fence of palm-branch thatch, used for storing palm nuts</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PSA.17.11; Childs 2000, p. 303: píŋndó</text></form></note>
    <note><form lang="fr"><text>I lueinin niaa o píŋndo nin « je t'assiégerai » (Es 29,3) ; toosiaa piŋndan « élever des ouvrages de siège » (Ez 4,2).</text></form></note>
  </entry>
  <entry id="piɔlnɔnndo_2632">
    <lexical-unit><form lang="kqs"><text>piɔlnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔlnɔnndo_2632_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être prononcé, être invoqué (nom)</text></gloss>
      <gloss lang="en"><text>be pronounced, be called upon (name)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break by itself (middle of 'break')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first 1KI.8.29; Childs 2000, p. 304: pìɔ̀lnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de piɔlɔɔ « briser ; prononcer (un nom) ». diola nɔmndan la vanin piɔlnɔnndo « ton nom y sera invoqué » (1KI.8.29, 2KI.21.7).</text></form></note>
  </entry>
  <entry id="piɔlɔɔ_2633">
    <lexical-unit><form lang="kqs"><text>piɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔl</text></form></variant>
    <variant><form lang="kqs"><text>pɛl</text></form></variant>
    <variant><form lang="kqs"><text>pial</text></form></variant>
    <variant><form lang="kqs"><text>pel</text></form></variant>
    <variant><form lang="kqs"><text>pialnin</text></form></variant>
    <variant><form lang="kqs"><text>piɔlnin</text></form></variant>
    <sense id="piɔlɔɔ_2633_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser, casser, écraser ; prononcer (un nom)</text></gloss>
      <gloss lang="en"><text>break, crush; pronounce (a name)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.48.20; Keita 1979, p. 116: Piölöö</text></form></note>
    <note><form lang="fr"><text>pel : radical négatif (EXO 12,46). diola pial « prononcer le nom » (EXO 20,7).</text></form></note>
  </entry>
  <entry id="pìɔ̀lɔ̀ɔ́_2634">
    <lexical-unit><form lang="kqs"><text>pìɔ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pìɔ̀lɔ̀láŋ</text></form></field>
    <sense id="pìɔ̀lɔ̀ɔ́_2634_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>devinette, énigme</text></gloss>
      <gloss lang="en"><text>puzzle, riddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 304: pìɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="piɔlɛiyo_2635">
    <lexical-unit><form lang="kqs"><text>piɔlɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔlɛi</text></form></variant>
    <variant><form lang="kqs"><text>piɔlɛilen</text></form></variant>
    <variant><form lang="kqs"><text>piɔlɛilan</text></form></variant>
    <variant><form lang="kqs"><text>piɔlɛila</text></form></variant>
    <variant><form lang="kqs"><text>piɔlɛiye</text></form></variant>
    <variant><form lang="kqs"><text>piɔlɛin</text></form></variant>
    <sense id="piɔlɛiyo_2635_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>brisé, détruit, en ruine</text></gloss>
      <gloss lang="en"><text>broken, destroyed, ruined</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>broken</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first JER.19.2; Childs 2000, p. 303: pìɔ̀lèí-</text></form></note>
    <note><form lang="fr"><text>De piɔlɔɔ « briser ». lɛŋnde piɔlɛilen « pays dévasté » (EZK.29.9) ; cɛila ndala piɔlɛilan « leurs maisons en ruine » (PSA.109.10) ; Kpɛɛnɛn Piɔlɛiyo « porte des Tessons » (JER.19.2).</text></form></note>
  </entry>
  <entry id="piɔmaa_2636">
    <lexical-unit><form lang="kqs"><text>piɔmaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔmaa_2636_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>idoles, statues de dieux</text></gloss>
      <gloss lang="en"><text>idols, images of gods</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 175 occurrences, first GEN.31.19</text></form></note>
  </entry>
  <entry id="piɔ́mndo_2637">
    <lexical-unit><form lang="kqs"><text>piɔ́mndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔ́m</text></form></variant>
    <sense id="piɔ́mndo_2637_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mourir ; la mort</text></gloss>
      <gloss lang="en"><text>die; death</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 492 occurrences, first GEN.2.17</text></form></note>
  </entry>
  <entry id="piɔmndo_2638">
    <lexical-unit><form lang="kqs"><text>piɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>piɔmnda</text></form></field>
    <sense id="piɔmndo_2638_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>idole, statue (d'un dieu)</text></gloss>
      <gloss lang="en"><text>idol, image (of a god)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>small carved stone figure (nomoli) kept for an ancestor spirit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 492 occurrences, first GEN.2.17; Childs 2000, p. 304: pìɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Sans tons, à distinguer de piɔ́mndo « mort ». cɔaw piɔmndo a mun maa naw téndé « il en fit une idole, un veau » (EXO.32.4) ; La selnun piɔmnda le « tu ne te feras pas d'idoles » (EXO.20.4) ; piɔmndo Molɛk (LEV.18.21).</text></form></note>
  </entry>
  <entry id="piɔndio_2639">
    <lexical-unit><form lang="kqs"><text>piɔndio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔndi</text></form></variant>
    <variant><form lang="kqs"><text>piɔndinin</text></form></variant>
    <sense id="piɔndio_2639_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tonner, gronder ; (piɔndi a caŋndo) éclater en sanglots</text></gloss>
      <gloss lang="en"><text>thunder, roar; (piɔndi a caŋndo) burst into tears</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>explode, pop (as corn)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.29.3; Childs 2000, p. 298: pìèndìóó</text></form></note>
    <note><form lang="fr"><text>Hala biilaa co piɔndio « le Dieu de gloire tonne » (Ps 29,3) ; mó piɔndi a caŋndo « il éclata en sanglots » (Gn 29,11).</text></form></note>
  </entry>
  <entry id="piɔsio_2640">
    <lexical-unit><form lang="kqs"><text>piɔsio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔsi</text></form></variant>
    <variant><form lang="kqs"><text>piɔsinin</text></form></variant>
    <sense id="piɔsio_2640_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se briser, voler en éclats, se fendre ; (bourgeon) éclater</text></gloss>
      <gloss lang="en"><text>break, shatter, split; (bud) burst open</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be broken, break by itself (esp. several things)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 1KI.1.40; Childs 2000, p. 304: pìɔ̀sìó</text></form></note>
    <note><form lang="fr"><text>bolle ndɔlen le piɔsi « sa tête se brisa » (1 S 5,4) ; mɛɛ kpɛɛnɛi … piɔsi « comme se brise un pot de potier » (Es 30,14) ; pei lendei ken piɔsi « le bâton avait bourgeonné » (Nb 17,23). Apparenté à piɔlɔɔ « briser ».</text></form></note>
  </entry>
  <entry id="piɔu_2641">
    <lexical-unit><form lang="kqs"><text>piɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔu_2641_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter, se remplir, déborder ; augmenter</text></gloss>
      <gloss lang="en"><text>rise, fill up, overflow; increase</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be full, lumpy or swollen</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.7.18; Childs 2000, p. 304: pìɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>taala kólaa nuu co piɔu « ma coupe déborde » (Ps 23,5) ; dɛ̀ndɔ̀ɔ́ va piɔu a mɛnndan « la barque se remplissait d'eau » (Mc 4,37) ; mɔnɛi kɔa a piɔu « le chagrin augmente » (Qo 1,18).</text></form></note>
  </entry>
  <entry id="piɔvan_2642">
    <lexical-unit><form lang="kqs"><text>piɔvan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔvan_2642_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se diviser, se séparer</text></gloss>
      <gloss lang="en"><text>be divided, divide (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>share oneself, contribute one's time and effort</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.2.10; Childs 2000, p. 304: pìɔ́ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de piɔwvo.</text></form></note>
  </entry>
  <entry id="piɔwvo_2643">
    <lexical-unit><form lang="kqs"><text>piɔwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɔw</text></form></variant>
    <sense id="piɔwvo_2643_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>partager, diviser</text></gloss>
      <gloss lang="en"><text>divide, share out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>distribute, share</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.10.25; Childs 2000, p. 304: pìɔ̀ùwɔ́</text></form></note>
  </entry>
  <entry id="piɔŋndo_2644">
    <lexical-unit><form lang="kqs"><text>piɔŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>piɔŋndan</text></form></field>
    <variant><form lang="kqs"><text>piɔŋnda</text></form></variant>
    <sense id="piɔŋndo_2644_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>furoncle, abcès</text></gloss>
      <gloss lang="en"><text>boil, abscess</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a skin rash forming large pustules</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first LEV.13.18; Childs 2000, p. 304: pìɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>piɔŋnda lan la siŋnun pavii vɔɔnde « ce seront des furoncles qui se changeront en plaies » (Ex 9,9).</text></form></note>
  </entry>
  <entry id="piɔɔ_2645">
    <lexical-unit><form lang="kqs"><text>piɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔɔ_2645_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pluie</text></gloss>
      <gloss lang="en"><text>rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 184 occurrences, first GEN.2.5</text></form></note>
  </entry>
  <entry id="piɔɔ bɛndoo_2646">
    <lexical-unit><form lang="kqs"><text>piɔɔ bɛndoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piɔɔ bɛndoo_2646_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tornade ; forte pluie</text></gloss>
      <gloss lang="en"><text>tornado, rainstorm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Piöö bènduo</text></form></note>
    <note><form lang="fr"><text>Litt. « grande pluie ». Keita écrit bènduo ; la Bible bɛndoo (piɔɔ bɛndu-bɛndoo, 1KI.18.45).</text></form></note>
  </entry>
  <entry id="piɛilen_2647">
    <lexical-unit><form lang="kqs"><text>piɛilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piɛile</text></form></variant>
    <sense id="piɛilen_2647_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prière, demande</text></gloss>
      <gloss lang="en"><text>prayer, request</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 97 occurrences, first GEN.4.26; Childs 2000, p. 298: pìèlɛ́ŋ</text></form></note>
  </entry>
