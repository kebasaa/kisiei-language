  <entry id="tɔɔ_1741">
    <lexical-unit><form lang="kqs"><text>tɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔɔ_1741_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver (objets, vêtements), rincer</text></gloss>
      <gloss lang="en"><text>wash (things, clothes), rinse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wash clothes, launder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 223 occurrences, first GEN.6.4; Keita 1979, p. 115: Töö; Childs 2000, p. 369: tɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tɔɔ ndi a mɛnndan « le rincer à l'eau » (LEV 6,21). Homonyme de tɔ́ɔ́ « très, nombreux ».</text></form></note>
  </entry>
  <entry id="tɔɔmaa_1742">
    <lexical-unit><form lang="kqs"><text>tɔɔmaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔma</text></form></variant>
    <sense id="tɔɔmaa_1742_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>monstre, bête prodigieuse (visi tɔɔmaa)</text></gloss>
      <gloss lang="en"><text>monster, monstrous beast (visi tɔɔmaa)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.1.21</text></form></note>
    <note><form lang="fr"><text>visia kɔndɔfilaa tɔɔmaa bɛndua « les grands monstres marins » (Gn 1,21).</text></form></note>
  </entry>
  <entry id="tɔɔmaseloo_1743">
