    <sense id="tum yekpandio_3464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crosse de fusil</text></gloss>
      <gloss lang="en"><text>rifle butt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Tum yekpandio</text></form></note>
  </entry>
  <entry id="tuma_3465">
    <lexical-unit><form lang="kqs"><text>tuma</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuma_3465_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>au moment où, quand</text></gloss>
      <gloss lang="en"><text>when, at the time when</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 394 occurrences, first GEN.2.4</text></form></note>
  </entry>
  <entry id="tùmbáfùíyó_3466">
    <lexical-unit><form lang="kqs"><text>tùmbáfùíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùmbáfùíyó_3466_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>baignoire, bassine de bain</text></gloss>
      <gloss lang="en"><text>bathtub</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 372: tùmbáfùíyó</text></form></note>
  </entry>
  <entry id="tumbé_3467">
    <lexical-unit><form lang="kqs"><text>tumbé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tumbé_3467_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colère, fureur</text></gloss>
      <gloss lang="en"><text>wrath, fury</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first DEU.29.27; Childs 2000, p. 372: túmbóó</text></form></note>
  </entry>
  <entry id="tumbu_3468">
    <lexical-unit><form lang="kqs"><text>tumbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tumbulan</text></form></field>
    <variant><form lang="kqs"><text>tumbula</text></form></variant>
    <sense id="tumbu_3468_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gerbe</text></gloss>
      <gloss lang="en"><text>sheaf</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large sheaf of rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.37.7; Childs 2000, p. 372: tùmbóó</text></form></note>
  </entry>
  <entry id="túmbúlnɔ̀ɔ́_3469">
    <lexical-unit><form lang="kqs"><text>túmbúlnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túmbúllá</text></form></field>
    <sense id="túmbúlnɔ̀ɔ́_3469_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purificateur, exorciste (après la violation d'un tabou)</text></gloss>
      <gloss lang="en"><text>exorcist, ritual cleanser (after a taboo is broken)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 373: túmbúlnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tumndo_3470">
    <lexical-unit><form lang="kqs"><text>tumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tumnda</text></form></field>
    <sense id="tumndo_3470_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>base, pied, socle ; cep, souche (de vigne) ; (pl.) vignes</text></gloss>
      <gloss lang="en"><text>base, foot, socket; stock (of a vine); (pl.) vineyards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bottom, base, background; buttocks, anus; palm nut head</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.32.33; Childs 2000, p. 373: tùmndó</text></form></note>
    <note><form lang="fr"><text>rɛsɛn tumndo « cep de vigne » (GEN.40.9) ; tumnda n'rɛsɛnndan « les vignes » (JDG.21.21) ; tumnda fondo « nu » (GEN.2.25).</text></form></note>
  </entry>
  <entry id="tumulu_3471">
    <lexical-unit><form lang="kqs"><text>tumulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tumulnin</text></form></variant>
    <sense id="tumulu_3471_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pourrir, se corrompre, puer</text></gloss>
      <gloss lang="en"><text>rot, putrefy, become foul</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.38.6; Childs 2000, p. 373: tùmùlló</text></form></note>
    <note><form lang="fr"><text>Pavii nii tumulu « mes plaies pourrissent » (PSA.38.6) ; peela pɔmbɔlan la tumulnin « les canaux deviendront infects » (ISA.19.6).</text></form></note>
  </entry>
  <entry id="tumulɛi_3472">
    <lexical-unit><form lang="kqs"><text>tumulɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tumulɛiyon</text></form></variant>
    <variant><form lang="kqs"><text>tumulɛin</text></form></variant>
    <sense id="tumulɛi_3472_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pourri, corrompu, impur</text></gloss>
      <gloss lang="en"><text>rotten, putrid, unclean</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.7.19; Childs 2000, p. 373: tùmúléí</text></form></note>
    <note><form lang="fr"><text>De tumulu. visin tumulɛiyon « viande avariée » (LEV.19.7) ; maa ɲɛ tumulɛi « comme une chose impure » (EZK.7.19).</text></form></note>
  </entry>
  <entry id="tuncua_3473">
    <lexical-unit><form lang="kqs"><text>tuncua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tuncua_3473_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chiot</text></gloss>
      <gloss lang="en"><text>puppy</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tuntyua</text></form></note>
  </entry>
  <entry id="tùndòó_3474">
    <lexical-unit><form lang="kqs"><text>tùndòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùndòó_3474_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâton recourbé (piège à animaux ; support des coupe-palmes)</text></gloss>
      <gloss lang="en"><text>bent stick (animal trap; holder for palm cutters)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 373: tùndòó</text></form></note>
  </entry>
  <entry id="tundu_3475">
    <lexical-unit><form lang="kqs"><text>tundu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tundu_3475_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>incliner, baisser (le visage vers le sol)</text></gloss>
      <gloss lang="en"><text>bow (the face to the ground)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.17.3</text></form></note>
  </entry>
  <entry id="tundun_3476">
    <lexical-unit><form lang="kqs"><text>tundun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tundun_3476_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se prosterner</text></gloss>
      <gloss lang="en"><text>bow down, prostrate oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.27.29</text></form></note>
  </entry>
  <entry id="tundɔɔ_3477">
    <lexical-unit><form lang="kqs"><text>tundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tundan</text></form></variant>
    <sense id="tundɔɔ_3477_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>courber, tordre ; pervertir (la justice, les paroles) ; accabler, opprimer</text></gloss>
      <gloss lang="en"><text>bend, twist; pervert (justice, words); oppress</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend or curve</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.1.11; Childs 2000, p. 373: tùndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>le nda tundɔɔ o baala « pour les accabler de travaux » (EXO.1.11) ; dɛnɛ sandaa tundɔɔ « pervertir la justice » (JOB.8.3) ; vanaa co a tundan-nda « ceux qui sont courbés » (PSA.145.14). Aussi « délibérer » (MAT.27.7, ACT.25.12). Cf. tundu « se prosterner ».</text></form></note>
  </entry>
  <entry id="tunndo_3478">
    <lexical-unit><form lang="kqs"><text>tunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tunnda</text></form></field>
    <sense id="tunndo_3478_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chien</text></gloss>
      <gloss lang="en"><text>dog</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.11.7; Keita 1979, p. 137: Tunndo; Childs 2000, p. 374: tùŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible a aussi le pluriel tunaa.</text></form></note>
  </entry>
  <entry id="tùsìó_3479">
    <lexical-unit><form lang="kqs"><text>tùsìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tùsìó_3479_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être sale</text></gloss>
      <gloss lang="en"><text>be dirty</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: tùsìó</text></form></note>
  </entry>
  <entry id="tùúlen_3480">
    <lexical-unit><form lang="kqs"><text>tùúlen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tùúlen_3480_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>un peu, petite quantité, juste ce qu'il faut</text></gloss>
      <gloss lang="en"><text>a little, a small amount, (just) enough</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being enough, sufficient</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.25.52; Childs 2000, p. 374: tùùléŋ</text></form></note>
    <note><form lang="fr"><text>O co fisa mì vana nɔ tùúlen « mieux vaut peu de bien » (PRO.15.16) ; a dio man tùúlen « manges-en avec mesure » (PRO.25.16).</text></form></note>
  </entry>
  <entry id="tuuliaa_3481">
    <lexical-unit><form lang="kqs"><text>tuuliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuliaa_3481_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sculpter, graver, broder (des figures)</text></gloss>
      <gloss lang="en"><text>carve, engrave, embroider (figures)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>imitate, gesticulate; make illustrations</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.26.1; Childs 2000, p. 375: tùùlìá</text></form></note>
  </entry>
  <entry id="tuuliaala_3482">
    <lexical-unit><form lang="kqs"><text>tuuliaala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuliaala_3482_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figures sculptées, images, idoles</text></gloss>
      <gloss lang="en"><text>carved figures, images, idols</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first DEU.4.23</text></form></note>
  </entry>
  <entry id="tuulianɔɔ_3483">
    <lexical-unit><form lang="kqs"><text>tuulianɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tuulianɔɔ_3483_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dessinateur</text></gloss>
      <gloss lang="en"><text>draughtsman</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Tuulianöö</text></form></note>
  </entry>
  <entry id="tuuloo_3484">
    <lexical-unit><form lang="kqs"><text>tuuloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuulu</text></form></variant>
    <variant><form lang="kqs"><text>tuulunin</text></form></variant>
    <sense id="tuuloo_3484_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'échauffer, s'enflammer ; (tuulu kɔl) se mettre en colère</text></gloss>
      <gloss lang="en"><text>heat up, flare up; (tuulu kɔl) become angry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be warm, become hot, heat; also beat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first 1SA.4.2; Childs 2000, p. 375: tùùlòó</text></form></note>
    <note><form lang="fr"><text>Cɔwvo tuuloo « le combat s'échauffa » (1 S 4,2) ; va kɔllo tuuloo « attiser la colère » (Ne 13,18).</text></form></note>
  </entry>
  <entry id="tuulul_3485">
    <lexical-unit><form lang="kqs"><text>tuulul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuululnin</text></form></variant>
    <sense id="tuulul_3485_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mesurer (pour qqn), mesurer à ; montrer (le modèle) à</text></gloss>
      <gloss lang="en"><text>measure out (to someone); show (a pattern) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>measure for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HEB.8.5; Childs 2000, p. 375: tùùlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tuuvo « mesurer ». A tuululnin niaa ɲɔɔn ɲɛkɛndɛi « on vous versera une bonne mesure » (LUK.6.38) ; mɛɛ ya tuulul nɔm ndu « selon le modèle que je t'ai montré » (HEB.8.5).</text></form></note>
  </entry>
  <entry id="tuunduanndo_3486">
    <lexical-unit><form lang="kqs"><text>tuunduanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuunduanndan</text></form></variant>
    <variant><form lang="kqs"><text>tuunduan</text></form></variant>
    <sense id="tuunduanndo_3486_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tortueux, courbe ; pervers (conduite)</text></gloss>
      <gloss lang="en"><text>crooked, winding; perverse (conduct)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend over, be bent (middle plural of 'bend')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.18.27; Childs 2000, p. 375: tùùndɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>nɛila tuunduan-ndan la sandunin « les chemins tortueux seront redressés » (LUK.3.5) ; kela tuunduanndo « conduite perverse » (PSA.18.27).</text></form></note>
  </entry>
  <entry id="tuunduuvo_3487">
    <lexical-unit><form lang="kqs"><text>tuunduuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuunduuvo_3487_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre tortueux, embrouiller (un chemin)</text></gloss>
      <gloss lang="en"><text>make crooked, confuse (a path)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend many things (plural of 'bend')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.3.12; Childs 2000, p. 375: tùùndùùwó</text></form></note>
    <note><form lang="fr"><text>nɛi niaa co kɔlan coo-o tuunduuvo « ils embrouillent le chemin que vous suivez » (ISA.3.12).</text></form></note>
  </entry>
  <entry id="tuunduɛiyo_3488">
    <lexical-unit><form lang="kqs"><text>tuunduɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuunduɛiyan</text></form></variant>
    <variant><form lang="kqs"><text>tuundɛilan</text></form></variant>
    <sense id="tuunduɛiyo_3488_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tortueux, détourné ; pervers, rusé</text></gloss>
      <gloss lang="en"><text>crooked, twisted; perverse, crafty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.10.9; Childs 2000, p. 375: túúndúéí-</text></form></note>
    <note><form lang="fr"><text>vana kela pɛ kela tuunduɛiyo « celui qui suit des voies tortueuses » (PRO.10.9) ; silala ndala tuundɛilan « les desseins des rusés » (JOB.5.13). De tundɔɔ « courber ».</text></form></note>
  </entry>
  <entry id="tùúpá_3489">
    <lexical-unit><form lang="kqs"><text>tùúpá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tùúpá_3489_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à ce que, avant que</text></gloss>
      <gloss lang="en"><text>until, before</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 375: tùúpá</text></form></note>
  </entry>
  <entry id="tuusu_3490">
    <lexical-unit><form lang="kqs"><text>tuusu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuusu_3490_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre ; s'étendre (frontière)</text></gloss>
      <gloss lang="en"><text>go down; extend (border)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first NUM.21.15</text></form></note>
  </entry>
  <entry id="tuuvo_3491">
    <lexical-unit><form lang="kqs"><text>tuuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuvo_3491_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mesurer ; projeter</text></gloss>
      <gloss lang="en"><text>measure; plan</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plan (middle of tùùwó 'measure')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.25; Childs 2000, p. 375: tùùnɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="tùùwó_3492">
    <lexical-unit><form lang="kqs"><text>tùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùùwó_3492_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parties génitales de l'homme</text></gloss>
      <gloss lang="en"><text>male genitals</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 376: tùùwó</text></form></note>
  </entry>
  <entry id="tuuŋanndan_3493">
    <lexical-unit><form lang="kqs"><text>tuuŋanndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuŋanndan_3493_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se comparer (les uns aux autres)</text></gloss>
      <gloss lang="en"><text>compare oneselves with one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>compare, make comparisons</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CO.10.12; Childs 2000, p. 375: tùùŋǎŋndó</text></form></note>
    <note><form lang="fr"><text>nda pilaa tɛɛn nda co tuuŋanndan ni « ils se comparent entre eux » (2CO.10.12). Moyen pluriel de tuuvo « mesurer ».</text></form></note>
  </entry>
  <entry id="tuvaa_3494">
    <lexical-unit><form lang="kqs"><text>tuvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tuvaala</text></form></field>
    <variant><form lang="kqs"><text>tuvaalen</text></form></variant>
    <sense id="tuvaa_3494_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure, unité de mesure ; (pl.) poids et mesures ; (yoole tuvaalen) cordeau</text></gloss>
      <gloss lang="en"><text>measure, measuring unit; (pl.) weights and measures; (yoole tuvaalen) measuring line</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) measure, take the size of; decide</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.16.36; Childs 2000, p. 376: tùùwó</text></form></note>
    <note><form lang="fr"><text>De tuuvo « mesurer ». ɲɛla tuvaala « poids, mesures » (LEV.19.36) ; yoole tuvaalen « cordeau à mesurer » (ZEC.2.5).</text></form></note>
  </entry>
  <entry id="tuvɔɔ_3495">
    <lexical-unit><form lang="kqs"><text>tuvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuvɔɔ_3495_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>replier, retirer (le bras)</text></gloss>
      <gloss lang="en"><text>draw back, fold back (the arm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold, fold around, wrap; bury; embrace; sprain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOS.8.26; Childs 2000, p. 376: tùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Toujours négatif : ba ndóò bii kon bállo-o tuvɔɔ le « il ne retira pas la main qui tenait le javelot » (JOS.8.26 ; aussi 1KI.13.4). Rapprochement avec Childs à confirmer.</text></form></note>
  </entry>
  <entry id="tuwvo_3496">
    <lexical-unit><form lang="kqs"><text>tuwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuwve</text></form></variant>
    <variant><form lang="kqs"><text>tuwvon</text></form></variant>
    <sense id="tuwvo_3496_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>chaud, brûlant ; (kɔl tuwvo) colère</text></gloss>
      <gloss lang="en"><text>hot, burning; (kɔl tuwvo) anger, wrath</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first GEN.49.6; Childs 2000, p. 374: tùù</text></form></note>
    <note><form lang="fr"><text>hoeyii tuwve « vent brûlant » (Jr 4,11) ; dialun tuwvon « fièvre » (Mt 8,14).</text></form></note>
  </entry>
  <entry id="tuŋ_3497">
    <lexical-unit><form lang="kqs"><text>tuŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuŋ-tuŋ</text></form></variant>
    <sense id="tuŋ_3497_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>toujours, continuellement</text></gloss>
      <gloss lang="en"><text>always, continually</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>only, just</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 228 occurrences, first GEN.6.5; Childs 2000, p. 373: túŋ</text></form></note>
    <note><form lang="fr"><text>tuŋ-tuŋ « de plus en plus, sans cesse » (Ex 19,19).</text></form></note>
  </entry>
  <entry id="tuŋndo_3498">
    <lexical-unit><form lang="kqs"><text>tuŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuŋndo_3498_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frire, cuire (des gâteaux) pour (qqn)</text></gloss>
      <gloss lang="en"><text>fry, bake (cakes) for (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry for someone (benefactive of tòŋɔ̀ɔ́ 'fry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.44.19; Childs 2000, p. 374: tùŋndó</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de toŋɔɔ « frire » (JER.7.18) : tuuliaala ndɔlan-ndo tuŋndo a ndu « lui cuire des gâteaux à son image » (JER.44.19).</text></form></note>
  </entry>
  <entry id="túŋòó_3499">
    <lexical-unit><form lang="kqs"><text>túŋòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túŋòá</text></form></field>
    <sense id="túŋòó_3499_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nain</text></gloss>
      <gloss lang="en"><text>midget, dwarf</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: túŋòó</text></form></note>
  </entry>
  <entry id="túŋótúŋóó_3500">
    <lexical-unit><form lang="kqs"><text>túŋótúŋóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túŋótúŋúá</text></form></field>
    <sense id="túŋótúŋóó_3500_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grosse sauterelle</text></gloss>
      <gloss lang="en"><text>large grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: túŋótúŋóó</text></form></note>
  </entry>
  <entry id="tuŋɔɔ_3501">
    <lexical-unit><form lang="kqs"><text>tuŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuŋɔɔ_3501_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>priver de, refuser (à qqn)</text></gloss>
      <gloss lang="en"><text>deprive of, withhold (from someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be greedy; deprive someone of something by keeping it for oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first NUM.11.11; Childs 2000, p. 374: tùŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>va vana yiaan ɲɛdiaa tuŋɔɔ « refuser du pain à l'affamé » (Jb 22,7).</text></form></note>
  </entry>
  <entry id="tuɛi_3502">
    <lexical-unit><form lang="kqs"><text>tuɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuɛi_3502_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rôtir, griller (la viande)</text></gloss>
      <gloss lang="en"><text>roast (meat)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 250 occurrences, first GEN.9.24; Childs 2000, p. 370: tùèìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Homographe de tuɛi « entendre » (tueyɔɔ). A bɛnda mà tuɛi visin mun « vous rôtirez la viande » (EXO.12.8) ; o tuɛi vision « il rôtit la viande » (ISA.44.16).</text></form></note>
  </entry>
  <entry id="tuɛndɔɔ_3503">
    <lexical-unit><form lang="kqs"><text>tuɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuɛndɔɔ_3503_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>burin, ciseau (à graver)</text></gloss>
      <gloss lang="en"><text>chisel, engraving tool</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a blacksmith's chisel for cutting iron</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.20.25; Childs 2000, p. 371: túéndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>tuɛndɔɔ a á ciliŋii « burin de fer » (JOB.19.24) ; aussi « outil » de taille (EXO.20.25).</text></form></note>
  </entry>
