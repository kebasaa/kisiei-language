      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 96: soko, sokoa</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, Soko est un nom de lieu.</text></form></note>
  </entry>
  <entry id="sókócáá_4677">
    <lexical-unit><form lang="kqs"><text>sókócáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sókócâláŋ</text></form></field>
