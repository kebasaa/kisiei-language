      <gloss lang="en"><text>shuffling, scuffing gait</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 187: kɔ́ɔ̀-kɔ̀ɔ̀</text></form></note>
  </entry>
  <entry id="kɔɔbanga dɛndɛlacoola cɔwlan_2899">
    <lexical-unit><form lang="kqs"><text>kɔɔbanga dɛndɛlacoola cɔwlan</text></form></lexical-unit>
