      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.29.26</text></form></note>
    <note><form lang="fr"><text>kɔŋɔ saa kóndó « la poitrine du bélier » (Ex 29,26).</text></form></note>
  </entry>
  <entry id="kɔɔ_917">
