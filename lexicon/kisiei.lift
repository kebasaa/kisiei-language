      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 405: yɛ́ndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yɛ̀ndɛ̀fúyɛ́í_6349">
