  <entry id="kɔndɔɔ_909">
    <lexical-unit><form lang="kqs"><text>kɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔndu</text></form></variant>
    <sense id="kɔndɔɔ_909_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>puiser (de l'eau) ; ramasser, prendre (une poignée)</text></gloss>
      <gloss lang="en"><text>draw (water); gather, take (a handful)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scoop up, draw, collect; also hand out shares, clear a swamp for rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.24.11; Childs 2000, p. 175: kɔ̀ndɔ̀ɔ́</text></form></note>
  </entry>
