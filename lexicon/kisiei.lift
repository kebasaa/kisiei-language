    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fɛ̀fɛ̀láŋ</text></form></field>
    <sense id="fɛ̀fɔ̀ɔ́_1512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avant-toit, bord du toit</text></gloss>
      <gloss lang="en"><text>eaves, roof overhang</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 103: fɛ̀fɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="fɛ̀fɛ̂íyó_1513">
    <lexical-unit><form lang="kqs"><text>fɛ̀fɛ̂íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fɛ̀fɛ̂íyó_1513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite lampe à pétrole</text></gloss>
      <gloss lang="en"><text>small kerosene lantern</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 103: fɛ̀fɛ̂íyó</text></form></note>
  </entry>
  <entry id="fɛfɛlaa_1514">
    <lexical-unit><form lang="kqs"><text>fɛfɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɛfɛla</text></form></variant>
    <sense id="fɛfɛlaa_1514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>explorer, espionner ; examiner, sonder</text></gloss>
      <gloss lang="en"><text>spy out, explore; examine, search</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first NUM.13.2</text></form></note>
  </entry>
  <entry id="fɛfɛyanndo_1515">
    <lexical-unit><form lang="kqs"><text>fɛfɛyanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛfɛyanndo_1515_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>spacieux</text></gloss>
      <gloss lang="en"><text>spacious</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fɛfɛyanndo</text></form></note>
  </entry>
  <entry id="fɛkɛiyo_1516">
    <lexical-unit><form lang="kqs"><text>fɛkɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɛkɛi</text></form></variant>
    <variant><form lang="kqs"><text>fɛkɛiya</text></form></variant>
    <variant><form lang="kqs"><text>fɛkɛila</text></form></variant>
    <variant><form lang="kqs"><text>fɛkɛilan</text></form></variant>
    <sense id="fɛkɛiyo_1516_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>large, spacieux ; aéré</text></gloss>
      <gloss lang="en"><text>wide, spacious; airy</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.26.22; Lexique kissi–français, p. 15: fɛkɛi</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 15 : fɛkɛi « aérer ».</text></form></note>
  </entry>
  <entry id="fɛ̂l_1517">
    <lexical-unit><form lang="kqs"><text>fɛ̂l</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fɛ̂l_1517_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(nettoyé) à fond, impeccablement</text></gloss>
      <gloss lang="en"><text>(cleaned) thoroughly, spotlessly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 103: fɛ̂l</text></form></note>
  </entry>
  <entry id="fɛ́lio_1518">
    <lexical-unit><form lang="kqs"><text>fɛ́lio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛ́lio_1518_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nudité, dénuement ; (a fɛ́lio) nu, sans vêtement ; (vana fɛ́lio) homme en haillons</text></gloss>
      <gloss lang="en"><text>nakedness, lack of clothing; (a fɛ́lio) naked; (vana fɛ́lio) man in rags</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lacking clothes, being destitute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.28.48; Paulme 1964, p. 26: fɛryo; Childs 2000, p. 104: fèlíó</text></form></note>
    <note><form lang="fr"><text>I va a fɛ́lio, mí la cuɛi ya « j'étais nu et vous m'avez vêtu » (MAT.25.36). Paulme 1964, p. 26 : wana fɛryo « homme déguenillé, aux vêtements en loques ».</text></form></note>
  </entry>
  <entry id="fɛlɔ_1519">
    <lexical-unit><form lang="kqs"><text>fɛlɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>fɛlɔla</text></form></field>
    <sense id="fɛlɔ_1519_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rhombe (lame de bambou, rites du kɔsɔa)</text></gloss>
      <gloss lang="en"><text>bullroarer (bamboo blade, kɔsɔa rites)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 26: fɛlɔ, pl. fɛlɔla</text></form></note>
  </entry>
  <entry id="fɛlɔɔ_1520">
    <lexical-unit><form lang="kqs"><text>fɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɛlɛ</text></form></variant>
    <sense id="fɛlɔɔ_1520_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>van</text></gloss>
      <gloss lang="en"><text>winnowing tray</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1CO.10.13; Keita 1979, p. 159: Fèlöö; Paulme 1964, p. 26: fɛrɔ, fɛrrɔ, pl. fɛrɛna; Lexique kissi–français, p. 15: fɛlɔɔ</text></form></note>
    <note><form lang="fr"><text>Mt 3,12 : fɛlɛ ndɔ hɛyaa « son van ». La forme pleine fɛlɔɔ n'apparaît qu'en 1 Co 10,13, au sens de « moyen d'en sortir ». Lexique kissi–français, p. 15 : aussi fɛrɔɔ « plateau de rameaux pour séparer le riz du fonio, le van ».</text></form></note>
  </entry>
  <entry id="fɛlɔɔ_1521">
    <lexical-unit><form lang="kqs"><text>fɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fɛlɔɔ_1521_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rougeole</text></gloss>
      <gloss lang="en"><text>measles</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1CO.10.13; Keita 1979, p. 161: Fèlöö; Lexique kissi–français, p. 15: felɔɔ; Childs 2000, p. 104: fɛ̀lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs. Le seul fɛlɔɔ de la Bible (1Co 10,13) est un homographe, « issue, moyen d'en sortir ». Lexique kissi–français, p. 15 : felɔɔ « rougeole ».</text></form></note>
  </entry>
  <entry id="fɛlɛku_1522">
    <lexical-unit><form lang="kqs"><text>fɛlɛku</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛlɛku_1522_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mou, faible</text></gloss>
      <gloss lang="en"><text>soft, weak</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fɛlɛku</text></form></note>
  </entry>
  <entry id="fɛlɛlen_1523">
    <lexical-unit><form lang="kqs"><text>fɛlɛlen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛlɛlen_1523_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lefa (éventail tressé)</text></gloss>
      <gloss lang="en"><text>lefa (woven fan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 223: Fèlèlen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="fɛlɛmɛndɛn_1524">
    <lexical-unit><form lang="kqs"><text>fɛlɛmɛndɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛlɛmɛndɛn_1524_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>soudain, à l'improviste (surgir contre qqn)</text></gloss>
      <gloss lang="en"><text>suddenly, unexpectedly (come out against)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>describes something coming out (of a socket, from inside) suddenly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first LEV.10.2; Childs 2000, p. 104: félèmèndèŋ</text></form></note>
  </entry>
  <entry id="fɛngɔɔ_1525">
    <lexical-unit><form lang="kqs"><text>fɛngɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛngɔɔ_1525_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pot d'argile (pour garder l'eau), récipient</text></gloss>
      <gloss lang="en"><text>clay pot (for water), vessel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1KI.7; Lexique kissi–français, p. 15: fɛngɔɔ</text></form></note>
  </entry>
  <entry id="fɛngɛ_1526">
    <lexical-unit><form lang="kqs"><text>fɛngɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛngɛ_1526_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bassin, auge</text></gloss>
