  <entry id="kèwèí_1561">
    <lexical-unit><form lang="kqs"><text>kèwèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kèwɔ̌ŋ</text></form></field>
    <sense id="kèwèí_1561_s1">
