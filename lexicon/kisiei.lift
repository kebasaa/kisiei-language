      <gloss lang="fr"><text>éclairer, faire briller</text></gloss>
      <gloss lang="en"><text>light up, make shine</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.1.16</text></form></note>
    <note><form lang="fr"><text>Causatif de tengaa.</text></form></note>
