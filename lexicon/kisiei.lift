  </entry>
  <entry id="seesiɛi_3465">
    <lexical-unit><form lang="kqs"><text>seesiɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="seesiɛi_3465_s1">
      <grammatical-info value="Noun"/>
