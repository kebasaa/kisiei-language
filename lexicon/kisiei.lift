  <entry id="cɛwvo_226">
    <lexical-unit><form lang="kqs"><text>cɛwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="cɛwvo_226_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arc (Keita)</text></gloss>
      <gloss lang="en"><text>bow (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bow (weapon); comb for carding cotton</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Tyèwvo; Childs 2000, p. 50: cìɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Childs confirme le sens « arc ». Mais la Bible dit kpaasiaa pour l'arc (Gn 27,3), et cɛwvo n'y apparaît qu'en 2 R 8,29 ; 9,15 ; 2 Ch 22,6, avec un autre sens.</text></form></note>
  </entry>
  <entry id="cɛŋio_227">
