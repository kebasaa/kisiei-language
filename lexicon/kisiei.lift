      <gloss lang="en"><text>help</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 255 occurrences, first GEN.2.18; Keita 1979, p. 110: Malaa; Childs 2000, p. 240: màlàá</text></form></note>
  </entry>
