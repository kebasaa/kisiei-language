      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer, faire la guerre à (… a cɔwvo)</text></gloss>
      <gloss lang="en"><text>attack, wage war on (… a cɔwvo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.31.52</text></form></note>
