    <sense id="vayia_1805_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fouler, presser (le raisin) ; tasser (la terre)</text></gloss>
      <gloss lang="en"><text>tread, press (grapes); tread down (soil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wring, squeeze (e.g. cloth)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.40.11; Childs 2000, p. 381: wàyìá</text></form></note>
    <note><form lang="fr"><text>vana vayia rɛsɛnndon o doola nin « celui qui foule le raisin dans la cuve » (LAM.1.15).</text></form></note>
  </entry>
  <entry id="vaŋ_1806">
