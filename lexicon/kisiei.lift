    <sense id="pɔndɔkɔlɔn_4198_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mauvais goût</text></gloss>
      <gloss lang="en"><text>bad taste</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔndɔkɔlɔn</text></form></note>
  </entry>
  <entry id="pɔ̀nèéŋ_4199">
    <lexical-unit><form lang="kqs"><text>pɔ̀nèéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀nèéŋ_4199_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz très huileux</text></gloss>
      <gloss lang="en"><text>rice with lots of oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 309: pɔ̀nèéŋ</text></form></note>
  </entry>
  <entry id="pɔnioo_4200">
    <lexical-unit><form lang="kqs"><text>pɔnioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔnioo_4200_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>amadouer</text></gloss>
      <gloss lang="en"><text>coax, cajole</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 43: Pönioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pɔntie_4201">
    <lexical-unit><form lang="kqs"><text>pɔntie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔntiye</text></form></variant>
    <sense id="pɔntie_4201_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point</text></gloss>
      <gloss lang="en"><text>point, dot</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔntie</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; le Lexique écrit aussi pɔntiye.</text></form></note>
  </entry>
  <entry id="pɔntɛo_4202">
    <lexical-unit><form lang="kqs"><text>pɔntɛo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɔntɛo_4202_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>premières pluies</text></gloss>
      <gloss lang="en"><text>first rains</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔntɛo</text></form></note>
  </entry>
  <entry id="pɔnɔɔ_4203">
    <lexical-unit><form lang="kqs"><text>pɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="pɔnɔɔ_4203_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>époux, mari</text></gloss>
      <gloss lang="en"><text>husband</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.21.22; Keita 1979, p. 134: Pönöö; Lexique kissi–français, p. 44: pɔnɔɔ; Childs 2000, p. 309: pɔ́nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɔpuo_4204">
    <lexical-unit><form lang="kqs"><text>pɔpuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>popuo</text></form></variant>
    <sense id="pɔpuo_4204_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe (espèce)</text></gloss>
      <gloss lang="en"><text>kind of grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔpuo, popuo</text></form></note>
    <note><form lang="fr"><text>Paulme : Tɛkulo, Dɛmbaduno.</text></form></note>
  </entry>
  <entry id="pɔpɔan_4205">
    <lexical-unit><form lang="kqs"><text>pɔpɔan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔpɔan_4205_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouttes de pluie qui tombent des arbres, du toit</text></gloss>
      <gloss lang="en"><text>raindrops falling from trees or the roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔpɔan</text></form></note>
  </entry>
  <entry id="pɔ̀pɔ́ɔ́_4206">
    <lexical-unit><form lang="kqs"><text>pɔ̀pɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀pɔ́ɔ́_4206_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>inciter, pousser (qqn à faire qqch)</text></gloss>
      <gloss lang="en"><text>inspire, prompt (someone to do something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀pɔ́ɔ́</text></form></note>
  </entry>
  <entry id="pɔsɔkɔɔ_4207">
    <lexical-unit><form lang="kqs"><text>pɔsɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔsɔkɔɔ_4207_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>talisman (qui soigne les malades du yallo)</text></gloss>
      <gloss lang="en"><text>charm (healing those sick from yallo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔsɔkɔ̄</text></form></note>
  </entry>
  <entry id="pɔsɔnio_4208">
    <lexical-unit><form lang="kqs"><text>pɔsɔnio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɔsɔnio_4208_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poison</text></gloss>
      <gloss lang="en"><text>poison</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔsɔnio</text></form></note>
    <note><form lang="fr"><text>Emprunt au français.</text></form></note>
  </entry>
  <entry id="pɔ́sɔ́ŋúɲáá_4209">
    <lexical-unit><form lang="kqs"><text>pɔ́sɔ́ŋúɲáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ́sɔ́ŋúɲáá_4209_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mille-pattes, scolopendre</text></gloss>
      <gloss lang="en"><text>centipede</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ́sɔ́ŋúɲáá</text></form></note>
  </entry>
  <entry id="pɔsɔɔ_4210">
    <lexical-unit><form lang="kqs"><text>pɔsɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɔsɔɔ_4210_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit escargot (espèce)</text></gloss>
      <gloss lang="en"><text>small snail (species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔsɔɔ</text></form></note>
  </entry>
  <entry id="pɔtmanio_4211">
    <lexical-unit><form lang="kqs"><text>pɔtmanio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔtɔmanilan</text></form></variant>
    <sense id="pɔtmanio_4211_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte-monnaie</text></gloss>
      <gloss lang="en"><text>purse</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔtmanio</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; le Lexique écrit aussi pɔtɔmanilan.</text></form></note>
  </entry>
  <entry id="pɔtɔlla_4212">
    <lexical-unit><form lang="kqs"><text>pɔtɔlla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔtɔlten</text></form></variant>
    <variant><form lang="kqs"><text>pɔtɔlaa</text></form></variant>
    <variant><form lang="kqs"><text>pɔtɔlte</text></form></variant>
    <sense id="pɔtɔlla_4212_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travailleurs forcés, corvéables ; (pɔtɔlten) corvée, servitude</text></gloss>
      <gloss lang="en"><text>forced labourers; (pɔtɔlten) forced labour, servitude</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.47.21</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé. siinguu … pɔtɔlla « réduire en servitude » (Gn 47,21) ; Hadoram va pɔtɔlla bollen « Adoram était chef des corvées » (2 S 20,24).</text></form></note>
  </entry>
  <entry id="pɔtɔtten_4213">
    <lexical-unit><form lang="kqs"><text>pɔtɔtten</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔtɔtten_4213_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corvée</text></gloss>
      <gloss lang="en"><text>forced labour, corvée</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 222: Pötötten</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pɔtɔtɔ_4214">
    <lexical-unit><form lang="kqs"><text>pɔtɔtɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔtɔtɔ_4214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (dont les feuilles servent aux ordalies)</text></gloss>
      <gloss lang="en"><text>plant (leaves used in ordeals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔtɔtɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : les feuilles sont un nyuruwa (remède, antidote) ; ordalies.</text></form></note>
  </entry>
  <entry id="pɔ̀úwó_4215">
    <lexical-unit><form lang="kqs"><text>pɔ̀úwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀úwó_4215_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argile blanche ou grise ; craie ; poudre ; poudre à fusil</text></gloss>
      <gloss lang="en"><text>white or grey clay; chalk; powder; gunpowder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀úwó</text></form></note>
  </entry>
  <entry id="pɔ́úwó_4216">
    <lexical-unit><form lang="kqs"><text>pɔ́úwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ́úwó_4216_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste des marais aux feuilles servant d'emballage (kola)</text></gloss>
      <gloss lang="en"><text>swamp shrub whose leaves are used to wrap parcels (kola)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ́úwó</text></form></note>
    <note><form lang="fr"><text>Piper umbellatum.</text></form></note>
  </entry>
  <entry id="pɔw_4217">
    <lexical-unit><form lang="kqs"><text>pɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔw_4217_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'égarer, se tromper ; être en faute ; faire tromper ; chuter</text></gloss>
      <gloss lang="en"><text>go astray, err; be at fault; lead astray; fall</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.14.3; Lexique kissi–français, p. 44: pɔwvo/ pɔw</text></form></note>
    <note><form lang="fr"><text>Israɛlla pɔw nɛiyo « les Israélites errent (ont perdu leur chemin) » (Ex 14,3) ; Ya pɔw ni « c'est moi la fautive » (1 S 25,24). Voir pɔwlan « faute ». Lexique kissi–français, p. 44 : pɔwvo/ pɔw « tromper, faire tromper, chuter ».</text></form></note>
  </entry>
  <entry id="pɔwlan_4218">
    <lexical-unit><form lang="kqs"><text>pɔwlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔwla</text></form></variant>
    <sense id="pɔwlan_4218_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égarement, faute, péché</text></gloss>
      <gloss lang="en"><text>error, wrongdoing, sin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first DEU.11.16</text></form></note>
    <note><form lang="fr"><text>luɛi o pɔwlan nin « s'égarer, tomber dans l'erreur » (Dt 11,16) ; pɔwla Yeroboam « les péchés de Jéroboam » (2 R 10,31). Voir pɔw « s'égarer ».</text></form></note>
  </entry>
  <entry id="pɔwvianndo_4219">
    <lexical-unit><form lang="kqs"><text>pɔwvianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔwvian</text></form></variant>
    <sense id="pɔwvianndo_4219_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se diviser, diviser entre plusieurs</text></gloss>
      <gloss lang="en"><text>split up, divide among several</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔwvianndo/ pɔwvian</text></form></note>
  </entry>
  <entry id="pɔwvo_4220">
    <lexical-unit><form lang="kqs"><text>pɔwvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔw</text></form></variant>
    <sense id="pɔwvo_4220_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>diviser, partager entre</text></gloss>
      <gloss lang="en"><text>divide, share out among</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔwvo/ pɔw</text></form></note>
    <note><form lang="fr"><text>Homographe de pɔw « s'égarer, se tromper » (Bible).</text></form></note>
  </entry>
  <entry id="pɔwvo_4221">
    <lexical-unit><form lang="kqs"><text>pɔwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɔwvo_4221_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce) des bas-fonds, le popo</text></gloss>
      <gloss lang="en"><text>tree (species) growing in lowlands</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: powa, pɔpou, pl. pove; Lexique kissi–français, p. 44: pɔwvo</text></form></note>
    <note><form lang="fr"><text>Le Lexique a barré « dont le bois est utilisé pour la charpente ». Paulme 1964, p. 82 : powa, pɔpou, pl. pove « variété d'arbre » ; pousse dans les rizières ; bois utilisé en menuiserie ; avec ses feuilles (pipɔve) on enveloppe les kolas.</text></form></note>
  </entry>
  <entry id="pɔwvo_4222">
    <lexical-unit><form lang="kqs"><text>pɔwvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>pɔwva</text></form></field>
    <variant><form lang="kqs"><text>puwvo</text></form></variant>
    <sense id="pɔwvo_4222_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>phacochère</text></gloss>
      <gloss lang="en"><text>warthog</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔwo, puwo, pl. pɔwa</text></form></note>
    <note><form lang="fr"><text>Paulme : cf. pevo « porc » (pewvo dans la Bible).</text></form></note>
  </entry>
  <entry id="pɔ̀yàŋndó_4223">
    <lexical-unit><form lang="kqs"><text>pɔ̀yàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀yàŋndó_4223_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre à racine amère (dont on tire le rotin)</text></gloss>
      <gloss lang="en"><text>large tree with a bitter root (source of rattan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀yàŋndó</text></form></note>
  </entry>
  <entry id="pɔ́ŋgɔ́sɔ̀ɔ́_4224">
    <lexical-unit><form lang="kqs"><text>pɔ́ŋgɔ́sɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ́ŋgɔ́sɔ̀ɔ́_4224_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tout petit</text></gloss>
      <gloss lang="en"><text>very small</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ́ŋgɔ́sɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɔɔ_4225">
    <lexical-unit><form lang="kqs"><text>pɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔɔ_4225_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>d'abord, un moment, en attendant</text></gloss>
      <gloss lang="en"><text>first, for a while, meanwhile</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.27.44; Paulme 1964, p. 80: pɔ; Lexique kissi–français, p. 44: pɔ</text></form></note>
    <note><form lang="fr"><text>Kɔ mà kɔ va pɔɔ lon « va et reste là-bas quelque temps » (Gn 27,44) ; hiow ya pɔɔ laci « passe devant moi » (Gn 33,14) ; yɔngu ya pɔɔ landei pum « donne-moi d'abord un gage » (Gn 38,17). Lexique kissi–français, p. 44 : pɔ « d'abord ». Paulme 1964, p. 80 : i tyɛ ndu pɔ « je l'ai vu d'abord » ; tɔsa pɔ « fais-le d'abord ».</text></form></note>
  </entry>
  <entry id="pɔɔ_4226">
    <lexical-unit><form lang="kqs"><text>pɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔɔ_4226_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont l'écorce sert aux inhalations)</text></gloss>
      <gloss lang="en"><text>kind of tree (bark used for inhalations)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 80: pɔɔ</text></form></note>
    <note><form lang="fr"><text>Homographe de pɔɔ « d'abord ».</text></form></note>
  </entry>
  <entry id="pɔ̀ɔ́_4227">
    <lexical-unit><form lang="kqs"><text>pɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɔ̀láŋ</text></form></field>
    <sense id="pɔ̀ɔ́_4227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chou palmiste (mangé en période de disette)</text></gloss>
      <gloss lang="en"><text>palm cabbage (eaten when rice is scarce)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɔɔli_4228">
    <lexical-unit><form lang="kqs"><text>pɔɔli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔɔli_4228_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de loin, à distance, là-bas</text></gloss>
      <gloss lang="en"><text>from afar, at a distance, over there</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JDG.4.11</text></form></note>
    <note><form lang="fr"><text>a lo levil pɔɔli « de loin tu perçois » (Ps 139,2) ; N lo coocoo pɔɔli « du haut du ciel » (Jg 5,20).</text></form></note>
  </entry>
  <entry id="pɔɔliaa_4229">
    <lexical-unit><form lang="kqs"><text>pɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔɔliaanin</text></form></variant>
    <variant><form lang="kqs"><text>pɔɔla</text></form></variant>
    <variant><form lang="kqs"><text>pɔɔlaa</text></form></variant>
    <sense id="pɔɔliaa_4229_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arroser, irriguer ; (pɔɔla) mouiller, tremper</text></gloss>
      <gloss lang="en"><text>water, irrigate; (pɔɔla) wet, soak</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>soak, immerse in water, drench, water a plant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.2.6; Childs 2000, p. 310: pɔ̀ɔ̀làá</text></form></note>
    <note><form lang="fr"><text>mɛmma va … lɛŋnden pɔɔliaa « l'eau arrosait toute la surface du sol » (Gn 2,6) ; o pɔɔla ɲɛm mun … o kooma « il les trempera dans le sang » (Lv 14,6).</text></form></note>
  </entry>
  <entry id="pɔɛnndan_4230">
    <lexical-unit><form lang="kqs"><text>pɔɛnndan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔɛnndan_4230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>omission</text></gloss>
      <gloss lang="en"><text>omission</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 289: Pöènndan</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pɔɛɛnndo_4231">
    <lexical-unit><form lang="kqs"><text>pɔɛɛnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔɛɛn</text></form></variant>
    <sense id="pɔɛɛnndo_4231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>oublier</text></gloss>
      <gloss lang="en"><text>forget</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.6 Remember"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forget</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Pöènndo; Lexique kissi–français, p. 44: pɔɛnndo/ pɔɛn; Childs 2000, p. 310: pùɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit pöènndo ; la Bible a le radical pɔɛɛn « oublier » (JER 30,14). La forme longue pɔɛɛnndo n'y est pas attestée. Confirmé au Nord par le Lexique kissi–français, p. 44 (pɔɛnndo/ pɔɛn « oublier »).</text></form></note>
  </entry>
  <entry id="pɔɛɛnɔnndo_4232">
    <lexical-unit><form lang="kqs"><text>pɔɛɛnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔɛɛnun</text></form></variant>
    <variant><form lang="kqs"><text>pɔɛɛnunnin</text></form></variant>
    <sense id="pɔɛɛnɔnndo_4232_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>oublier ; oubli ; s'oublier (Keita)</text></gloss>
      <gloss lang="en"><text>forget; oversight; forget oneself (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.6 Remember"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forget; ignore, have nothing to do with</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first GEN.43.12; Keita 1979, p. 113: Pöènnönndo; Lexique kissi–français, p. 44: pɔɛnnɔnndo/ pɔɛnnun; Childs 2000, p. 310: pùèèŋndɔ́</text></form></note>
    <note><form lang="fr"><text>Moyen de pɔɛɛnndo. Keita écrit pöènnönndo ; la Bible écrit pɔɛɛnɔnndo (GEN 43,12) et pɔɛɛnun « oublier » (très courant).</text></form></note>
  </entry>
  <entry id="pɛ́_4233">
    <lexical-unit><form lang="kqs"><text>pɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ́_4233_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement, tout à fait (disparaître, s'effondrer)</text></gloss>
      <gloss lang="en"><text>completely, entirely (vanish, collapse)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>all, completely, at all</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3807 occurrences, first GEN.1.22; Lexique kissi–français, p. 42: pɛ; Childs 2000, p. 294: pɛ́</text></form></note>
    <note><form lang="fr"><text>Accentué ; à distinguer de pɛ « si ». cɛila … vanaa vɔɔnda la lo pɛ́ « les tentes des méchants disparaîtront » (JOB.8.22) ; o lonnun pɛ́ « (la richesse) disparaît » (PRO.23.5) ; Ninivea vi n'diallon pɛ́ « Ninive s'effondre » (NAM.2.11). Lexique kissi–français, p. 42 : pɛ « être rempli ».</text></form></note>
  </entry>
  <entry id="pɛ_4234">
    <lexical-unit><form lang="kqs"><text>pɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ_4234_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule de condition (te … pɛ)</text></gloss>
      <gloss lang="en"><text>conditional particle (te … pɛ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3807 occurrences, first GEN.1.22; Paulme 1964, p. 78: pɛ; Lexique kissi–français, p. 42: pɛ; Childs 2000, p. 350: tè … pɛ́</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 78 : mala n tyu pɛ kowɔ « si on a fini de récolter le riz ».</text></form></note>
  </entry>
  <entry id="pɛ_4235">
    <lexical-unit><form lang="kqs"><text>pɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ_4235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être plein, remplir ; (pɛ cá) être rempli de</text></gloss>
      <gloss lang="en"><text>be full, fill; (pɛ cá) be filled with</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3807 occurrences, first GEN.1.22; Paulme 1964, p. 78: pɛ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 78 : tala pɛ « la calebasse est pleine » ; cf. pei « remplir ». Homographe de pɛ (particule de condition).</text></form></note>
  </entry>
  <entry id="pɛ́-pɛ́_4236">
    <lexical-unit><form lang="kqs"><text>pɛ́-pɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ́-pɛ́_4236_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout à fait, complètement</text></gloss>
      <gloss lang="en"><text>completely, entirely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.6.8; Lexique kissi–français, p. 42: pɛ-pɛ</text></form></note>
  </entry>
  <entry id="pɛ̀-pɛ̀_4237">
    <lexical-unit><form lang="kqs"><text>pɛ̀-pɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀-pɛ̀_4237_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du gombo qu'on écrase</text></gloss>
      <gloss lang="en"><text>sound of okra being mashed</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pɛ̀-pɛ̀</text></form></note>
  </entry>
  <entry id="pɛi_4238">
    <lexical-unit><form lang="kqs"><text>pɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛi_4238_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avant-hier ; auparavant</text></gloss>
      <gloss lang="en"><text>the day before yesterday; formerly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.42.35; Keita 1979, p. 152: Pèi; Paulme 1964, p. 79: pɛy; Lexique kissi–français, p. 42: pɛi</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, « auparavant, autrefois » (2TI.3.14, ACT.21.38). Paulme 1964, p. 79 : sɔe i yɔnnun pɛy « la parole s'est passée avant-hier ».</text></form></note>
  </entry>
  <entry id="pɛiyo_4239">
    <lexical-unit><form lang="kqs"><text>pɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛiyo_4239_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apprendre, étudier</text></gloss>
      <gloss lang="en"><text>learn, study</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.2 Learn"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>learn, study, remember, memorize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZR.7.10; Lexique kissi–français, p. 42: pɛiyo/ pɛi; Childs 2000, p. 295: pɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>tɔŋ Mɛlɛka-o pɛiyo « étudier la loi du Seigneur » (EZR.7.10) ; condii kalɛi pɛiyo « apprendre le cantique » (REV.14.3). Lexique kissi–français, p. 42 : pɛiyo/ pɛi « demander à, prier, apprendre, verser, enlever les vêtements » (plusieurs verbes homographes ?).</text></form></note>
  </entry>
  <entry id="pɛ̀ìyó_4240">
    <lexical-unit><form lang="kqs"><text>pɛ̀ìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ìyó_4240_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir (le riz), puiser ; vider ; tourner brusquement</text></gloss>
      <gloss lang="en"><text>dish out (rice), scoop; empty; turn sharply</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀ìyó</text></form></note>
  </entry>
  <entry id="pɛkpa_4241">
    <lexical-unit><form lang="kqs"><text>pɛkpa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛkpa_4241_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dixième mois</text></gloss>
      <gloss lang="en"><text>tenth month</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 78: pɛgba</text></form></note>
  </entry>
  <entry id="pɛl leyɔmbaa_4242">
    <lexical-unit><form lang="kqs"><text>pɛl leyɔmbaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛl leyɔmbaa_4242_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vers</text></gloss>
      <gloss lang="en"><text>line of verse</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 421: Pèl leyömbaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. pɛllo « phrase ».</text></form></note>
  </entry>
  <entry id="pɛ̀làá_4243">
    <lexical-unit><form lang="kqs"><text>pɛ̀làá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀làá_4243_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>roter, grogner, haleter, renâcler</text></gloss>
      <gloss lang="en"><text>belch, grunt, pant, snort</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀làá</text></form></note>
  </entry>
  <entry id="pɛllo_4244">
    <lexical-unit><form lang="kqs"><text>pɛllo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛllo_4244_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>phrase</text></gloss>
      <gloss lang="en"><text>sentence</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 311: Pèllo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. pɛltan « parts » (pɛltan bɛɛndiaa « construction de phrase »).</text></form></note>
  </entry>
  <entry id="pɛltan_4245">
    <lexical-unit><form lang="kqs"><text>pɛltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛltan_4245_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parts, portions (de terrain) (pl.)</text></gloss>
      <gloss lang="en"><text>portions, parts (of land) (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>division, part, portion (of a field to be worked)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.60.8; Childs 2000, p. 296: pɛ̌lló</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. mì tuu bóllo Sukɔt a pɛltan « je mesurerai (la vallée de) Soukkoth en parts » (PSA.60.8, PSA.108.8).</text></form></note>
  </entry>
  <entry id="pɛltan bɛɛndiaa_4246">
    <lexical-unit><form lang="kqs"><text>pɛltan bɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛltan bɛɛndiaa_4246_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>construction de phrase</text></gloss>
      <gloss lang="en"><text>sentence construction</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 88: Pèltan bèèndiaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « arranger les parts ».</text></form></note>
  </entry>
  <entry id="pɛltan tiimbuuo_4247">
    <lexical-unit><form lang="kqs"><text>pɛltan tiimbuuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛltan tiimbuuo_4247_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>analyse logique</text></gloss>
      <gloss lang="en"><text>logical analysis (of clauses)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 27: Pèltan tiimbuuo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « défaire les parts ».</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀í_4248">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lɔ̀ɔ́ŋ</text></form></field>
    <sense id="pɛ̀lɛ̀í_4248_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fond de la bouche, mâchoire inférieure</text></gloss>
      <gloss lang="en"><text>back of the mouth, lower jaw</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀lɛ̀í</text></form></note>
  </entry>
  <entry id="pɛlɛle delaa coolen_4249">
    <lexical-unit><form lang="kqs"><text>pɛlɛle delaa coolen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛlɛle delaa coolen_4249_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>conquête coloniale</text></gloss>
      <gloss lang="en"><text>colonial conquest</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 216: Pèlèle delaa tyoolen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. delɔɔcoo « violence, oppression ; colonialisme ».</text></form></note>
  </entry>
  <entry id="pɛlɛlen_4250">
    <lexical-unit><form lang="kqs"><text>pɛlɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="pɛlɛlen_4250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse, proie</text></gloss>
      <gloss lang="en"><text>hunt, prey</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hunting with dogs; chasing after something</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.49.9; Childs 2000, p. 296: pɛ̀lɛ̀lɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>a fula pɛlɛlen « tu es revenu de la chasse (de la proie) » (GEN.49.9), dit de Juda, jeune lion.</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀mbàá_4251">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀mbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lɛ̀mbàláŋ</text></form></field>
    <sense id="pɛ̀lɛ̀mbàá_4251_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe, slip (porté sous le pagne) ; pièce de tissu</text></gloss>
      <gloss lang="en"><text>loincloth, brief-like underclothing; cloth patch</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀mbàá</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀mbàá_4252">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀mbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀lɛ̀mbàá_4252_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ruisseau qui alimente ou draine un bas-fond (rizière)</text></gloss>
      <gloss lang="en"><text>stream that fills or drains a swamp (rice field)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀mbàá</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀nɔ̀ɔ́_4253">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lìá</text></form></field>
    <sense id="pɛ̀lɛ̀nɔ̀ɔ́_4253_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur (avec des chiens)</text></gloss>
      <gloss lang="en"><text>hunter (with dogs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɛlɛpɛlɔɔ_4254">
    <lexical-unit><form lang="kqs"><text>pɛlɛpɛlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛlɛpɛlɔɔ_4254_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étincelles</text></gloss>
      <gloss lang="en"><text>sparks</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 42: pɛlɛpɛlɔɔ</text></form></note>
    <note><form lang="fr"><text>Childs donne des homographes de sens différent (kissi du Sud).</text></form></note>
  </entry>
  <entry id="pɛ́lɛ́pɛ́lɔ̀ɔ́_4255">
    <lexical-unit><form lang="kqs"><text>pɛ́lɛ́pɛ́lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ́lɛ́pɛ́lɛ́láŋ</text></form></field>
    <sense id="pɛ́lɛ́pɛ́lɔ̀ɔ́_4255_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit bas-fond, ruisseau entre deux collines ; coin de marais</text></gloss>
      <gloss lang="en"><text>small swamp, stream between two hills; corner of a swamp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ́lɛ́pɛ́lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀pɛ̀lɔ̀ɔ́_4256">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀pɛ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lɛ̀pɛ̀lɛ̀láŋ</text></form></field>
    <sense id="pɛ̀lɛ̀pɛ̀lɔ̀ɔ́_4256_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz du matin (donné aux travailleurs des champs)</text></gloss>
      <gloss lang="en"><text>morning rice (given to farm workers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀pɛ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɛlɛpɛlɛlen_4257">
    <lexical-unit><form lang="kqs"><text>pɛlɛpɛlɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɛrɛpɛrɛlen</text></form></variant>
    <sense id="pɛlɛpɛlɛlen_4257_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit ruisseau, source</text></gloss>
      <gloss lang="en"><text>small stream, spring</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 42: pɛrɛpɛrɛlen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit pɛrɛpɛrɛlen.</text></form></note>
  </entry>
  <entry id="pɛ̀mbìó_4258">
    <lexical-unit><form lang="kqs"><text>pɛ̀mbìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀mbìó_4258_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lacer, ficeler (un panier) ; remplir ; s'habiller de plusieurs couches</text></gloss>
      <gloss lang="en"><text>lace or tie up (a hamper); fill; dress in layers</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀mbìó</text></form></note>
  </entry>
  <entry id="pɛndekɛɔn_4259">
    <lexical-unit><form lang="kqs"><text>pɛndekɛɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛndekɛɔn_4259_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz de montagne (variété)</text></gloss>
      <gloss lang="en"><text>upland rice (variety)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 78: pɛndekɛɔ̃</text></form></note>
    <note><form lang="fr"><text>Paulme : variété de malo pullo, semée en août, mûre en octobre.</text></form></note>
  </entry>
  <entry id="pɛ̀ndùléŋ_4260">
    <lexical-unit><form lang="kqs"><text>pɛ̀ndùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ndùléŋ_4260_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gémellité ; culte des jumeaux</text></gloss>
      <gloss lang="en"><text>being a twin; worship of twins</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀ndùléŋ</text></form></note>
  </entry>
  <entry id="pɛndunɔɔ_4261">
    <lexical-unit><form lang="kqs"><text>pɛndunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pɛndua</text></form></field>
    <sense id="pɛndunɔɔ_4261_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jumeau, jumelle</text></gloss>
      <gloss lang="en"><text>twin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.38.28; Keita 1979, p. 134: Pèndunöö; Paulme 1964, p. 78: pɛnduno, pl. pɛndua; Lexique kissi–français, p. 42: pɛndunɔɔ; Childs 2000, p. 296: pɛ̀ndùnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɛngi bɛndo_4262">
    <lexical-unit><form lang="kqs"><text>pɛngi bɛndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛngi bɛndo_4262_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grande mouche ; bousier</text></gloss>
      <gloss lang="en"><text>large fly; dung beetle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 78: peŋebɛ̃ndo, pl. piŋyabɛndua; Lexique kissi–français, p. 42: pɛngi bɛndo</text></form></note>
    <note><form lang="fr"><text>Comparer pengoo, pengio « mouche ». Paulme 1964, p. 78 : peŋebɛ̃ndo, pl. piŋyabɛndua « la grande mouche, bousier » ; peŋe (ou pɛŋebɛnduo) « bousier » ; devinette : peŋe dɛlu sunte « le bousier ne peut pas tomber ».</text></form></note>
  </entry>
  <entry id="pɛngi pɛo_4263">
    <lexical-unit><form lang="kqs"><text>pɛngi pɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛngi pɛo_4263_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouche tsé-tsé</text></gloss>
      <gloss lang="en"><text>tsetse fly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 42: pɛngi pɛo</text></form></note>
  </entry>
  <entry id="pɛngiaalen_4264">
    <lexical-unit><form lang="kqs"><text>pɛngiaalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="pɛngiaalen_4264_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>repos ; (paale pɛngiaalen) jour du sabbat</text></gloss>
      <gloss lang="en"><text>rest; (paale pɛngiaalen) sabbath day</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 109 occurrences, first GEN.2.3</text></form></note>
  </entry>
  <entry id="pɛngio_4265">
    <lexical-unit><form lang="kqs"><text>pɛngio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛngi</text></form></variant>
    <variant><form lang="kqs"><text>pɛnginin</text></form></variant>
    <sense id="pɛngio_4265_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se reposer ; cesser ; cesser, arrêter ; (nom) repos, congé</text></gloss>
      <gloss lang="en"><text>rest; cease ; rest; stop, cease; (noun) rest, leave</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stop an activity, rest</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 88 occurrences, first GEN.24.11; Keita 1979, p. 113: Pèngioo; Lexique kissi–français, p. 42: pɛngio/ pɛngi; Terminologie (langue), n° 317: Pèngioo; Childs 2000, p. 297: pɛ̀ŋgìó</text></form></note>
    <note><form lang="fr"><text>Keita écrit pèngioo ; la Bible écrit pɛngio (GEN 24,11). pɛngi signifie aussi « cesser » (EXO 9,29). Académie des langues (terminologie, langue n° 317) : pèngioo « pause ». Aussi Terminologie, p. 188 : « Landöö ; pèngioo ». Académie des langues (terminologie, histoire n° 188) : « cessation » (aussi landɔɔ). Académie des langues (terminologie, histoire n° 550) : « retraite » ; dɔngɔ pɛngiaa.</text></form></note>
  </entry>
  <entry id="pɛngivo_4266">
    <lexical-unit><form lang="kqs"><text>pɛngivo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛngivo_4266_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point-virgule</text></gloss>
      <gloss lang="en"><text>semicolon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 319: Pèngivo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. pɛngio « se reposer » (pɛngioo « pause »).</text></form></note>
  </entry>
  <entry id="pɛngɛi_4267">
    <lexical-unit><form lang="kqs"><text>pɛngɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pɛngɛn</text></form></field>
    <sense id="pɛngɛi_4267_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>planche ; bois (matériau)</text></gloss>
      <gloss lang="en"><text>board, plank; timber</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plank, board, lumber in general; also a strip of cloth, a wooden knife</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first EXO.26.16; Lexique kissi–français, p. 42: pengɛi; Childs 2000, p. 297: pèŋgéí</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 42 : pengɛi « la planche de bois » ; pɛngɛi y est glosé « blanche » (sans doute pour « planche »).</text></form></note>
  </entry>
  <entry id="pɛngɛi siɛɛliye_4268">
    <lexical-unit><form lang="kqs"><text>pɛngɛi siɛɛliye</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛngɛi siɛɛliye_4268_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palette</text></gloss>
      <gloss lang="en"><text>palette</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 191: Pèngèi sièèliye</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. pɛngɛi sɛvɛi « ardoise ».</text></form></note>
  </entry>
  <entry id="pɛngɛi sɛvɛi_4269">
    <lexical-unit><form lang="kqs"><text>pɛngɛi sɛvɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛngɛi sɛvɛi_4269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ardoise</text></gloss>
      <gloss lang="en"><text>slate (for writing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="3.6.2 School"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 12: Pèngèi sèvèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « planche à écrire ».</text></form></note>
  </entry>
  <entry id="pɛngɛlaa_4270">
    <lexical-unit><form lang="kqs"><text>pɛngɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛngɛla</text></form></variant>
    <variant><form lang="kqs"><text>pɛngɛliaa</text></form></variant>
    <sense id="pɛngɛlaa_4270_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étendre, étaler (un tissu sur qqch.) ; se disperser</text></gloss>
      <gloss lang="en"><text>spread out (a cloth over something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread out (e.g. cloth to dry); also make a matter big</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first DEU.22.17; Lexique kissi–français, p. 42: pɛngɛlaa/ pɛngɛla; Childs 2000, p. 297: pɛ̀ŋgɛ̀làá</text></form></note>
    <note><form lang="fr"><text>pɛngɛliaa (Pr 7,16 ; Mt 21,8 « étendre des vêtements sur le chemin ») semble en être la forme plurielle ou intensive.</text></form></note>
  </entry>
  <entry id="pɛngɛlanndo_4271">
    <lexical-unit><form lang="kqs"><text>pɛngɛlanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛngɛlan</text></form></variant>
    <variant><form lang="kqs"><text>pɛngɛlannin</text></form></variant>
    <sense id="pɛngɛlanndo_4271_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'étendre, se répandre</text></gloss>
      <gloss lang="en"><text>spread, extend (itself)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread oneself out</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.47.13; Childs 2000, p. 297: pɛ̀ŋgɛ̀lăŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de pɛngɛlaa : sɔŋndo … pɛngɛlan « la tache s'est étendue » (Lv 13,51).</text></form></note>
  </entry>
  <entry id="pɛo_4272">
    <lexical-unit><form lang="kqs"><text>pɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɛo_4272_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 78: pɛo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 79 donne aussi pɛwo « variété d'arbre », peut-être le même (homographe de pɛwvo « python »).</text></form></note>
  </entry>
  <entry id="pɛsɛle_4273">
    <lexical-unit><form lang="kqs"><text>pɛsɛle</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kpɛsian</text></form></field>
    <sense id="pɛsɛle_4273_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cure-dents</text></gloss>
      <gloss lang="en"><text>toothpick, chewing stick</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 79: pɛsɛle, pl. gbɛsyã</text></form></note>
  </entry>
  <entry id="pɛ̀ùwó_4274">
    <lexical-unit><form lang="kqs"><text>pɛ̀ùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ùwó_4274_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand serpent constricteur (python)</text></gloss>
      <gloss lang="en"><text>large constrictor snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pɛ̀ùwó</text></form></note>
  </entry>
  <entry id="pɛwvo_4275">
    <lexical-unit><form lang="kqs"><text>pɛwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɛwvo_4275_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boa, python</text></gloss>
      <gloss lang="en"><text>boa, python</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 79: pɛwo, pl. pɛwa; Lexique kissi–français, p. 42: pɛwvo; Sandara Kisia, proverbe 27: pɛwo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 79 : « serpent python, animal totémique ». Sandara Kissia, proverbe 27 : le serpent qui veut être aussi long que le python.</text></form></note>
  </entry>
  <entry id="pɛwvɛ_4276">
    <lexical-unit><form lang="kqs"><text>pɛwvɛ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>puɛi</text></form></variant>
    <variant><form lang="kqs"><text>pie</text></form></variant>
    <sense id="pɛwvɛ_4276_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>feuille</text></gloss>
      <gloss lang="en"><text>leaf</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 79: pɛwe, puɛy, pye; Sandara Kisia, fable 4: peye</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 79 : pɛwe, puɛy, pye « feuille » ; p. 80 : koma i piwã « Koma en feuilles » ; p. 85 : pye wana ũilɛyo « feuilles des cadavres » (suaire des premiers-nés). La Bible a peelen, pl. peela « feuille » ; forme à confirmer. Sandara Kissia, fable 4 : peye « les feuilles » (des arachides : Le yɛ n hin yɛ a peye o lɔɔ niŋ nɛ ? « qui apporte des feuilles au marché ? »).</text></form></note>
  </entry>
  <entry id="pɛ̀ŋgìó_4277">
    <lexical-unit><form lang="kqs"><text>pɛ̀ŋgìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀ŋgìláŋ</text></form></field>
    <sense id="pɛ̀ŋgìó_4277_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ligne de démarcation ; point (ponctuation)</text></gloss>
      <gloss lang="en"><text>boundary line; full stop (punctuation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ŋgìó</text></form></note>
  </entry>
  <entry id="pɛŋnden_4278">
    <lexical-unit><form lang="kqs"><text>pɛŋnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛŋnde</text></form></variant>
    <sense id="pɛŋnden_4278_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manque, besoin, pauvreté</text></gloss>
      <gloss lang="en"><text>want, need, poverty</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lack, need, poverty; also state of being jammed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first LEV.25.35; Childs 2000, p. 297: pɛ̀ŋndéŋ</text></form></note>
    <note><form lang="fr"><text>pɛŋnde ɲɛdiaa « manque de pain, famine » (Am 8,11).</text></form></note>
  </entry>
  <entry id="pɛ̀ŋɔ́ɔ́_4279">
    <lexical-unit><form lang="kqs"><text>pɛ̀ŋɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀ŋíá</text></form></field>
    <sense id="pɛ̀ŋɔ́ɔ́_4279_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit poisson plat argenté (genre sardine)</text></gloss>
      <gloss lang="en"><text>small flat silvery fish (sardine-like)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ŋɔ́ɔ́</text></form></note>
  </entry>
  <entry id="pɛɛkoo_4280">
    <lexical-unit><form lang="kqs"><text>pɛɛkoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɛɛku</text></form></variant>
    <variant><form lang="kqs"><text>pɛɛkaa</text></form></variant>
    <sense id="pɛɛkoo_4280_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enseigner</text></gloss>
      <gloss lang="en"><text>teach</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>teach; also study, learn</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 180 occurrences, first EXO.35.34; Lexique kissi–français, p. 42: pɛɛkuo/ pɛɛku; Terminologie (langue), n° 161: Pèèkuo; Childs 2000, p. 294: pèèkɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>vana pɛɛkaa « enseignant, maître » ; vanaa pɛɛkaa latɔŋnda « les maîtres de la loi ». Aussi Lexique kissi–français, p. 60 : « vana pɛɛkaa ». Lexique kissi–français, p. 60 : vana pɛɛkaa « enseignant ». Académie des langues (terminologie, langue n° 161) : pèèkuo « étude ».</text></form></note>
  </entry>
  <entry id="pɛɛkula_4281">
    <lexical-unit><form lang="kqs"><text>pɛɛkula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛɛkula_4281_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enseignements, préceptes</text></gloss>
      <gloss lang="en"><text>teachings, precepts</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>teachings; ways of learning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first LEV.25.18; Childs 2000, p. 294: pèèkùláŋ</text></form></note>
  </entry>
  <entry id="pɛɛkuoo_4282">
    <lexical-unit><form lang="kqs"><text>pɛɛkuoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɛɛkunɔɔ</text></form></variant>
    <sense id="pɛɛkuoo_4282_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enseigner ; (pɛɛkunɔɔ) instructeur</text></gloss>
      <gloss lang="en"><text>teach; (pɛɛkunɔɔ) instructor</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 268: Pèèkuoo, kaanden työmndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi kaanden cɔmndo ; pɛɛkuoo « enseignement » (idéologie n° 266) ; pɛɛkunɔɔ « instructeur » (n° 374).</text></form></note>
  </entry>
  <entry id="pɛ̀ɛ̀lǎŋ_4283">
    <lexical-unit><form lang="kqs"><text>pɛ̀ɛ̀lǎŋ</text></form></lexical-unit>
