  <entry id="baŋulɛiyo_167">
    <lexical-unit><form lang="kqs"><text>baŋulɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baŋulɛi</text></form></variant>
    <variant><form lang="kqs"><text>baŋulɛiya</text></form></variant>
    <sense id="baŋulɛiyo_167_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sourd ; (vana nila baŋulɛiyo) un sourd</text></gloss>
      <gloss lang="en"><text>deaf; (vana nila baŋulɛiyo) a deaf person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deaf; closed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.4.11; Childs 2000, p. 8: bàŋúléí</text></form></note>
    <note><form lang="fr"><text>Litt. « aux oreilles bouchées », de baŋullo « boucher ». Pluriel vanaa nila baŋulɛiya (MAT.11.5).</text></form></note>
  </entry>
  <entry id="baŋɔɔ_168">
    <lexical-unit><form lang="kqs"><text>baŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baŋ</text></form></variant>
    <variant><form lang="kqs"><text>baŋnin</text></form></variant>
    <sense id="baŋɔɔ_168_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser, bâtir, fixer ; (baŋ vulan) s'agenouiller, se prosterner ; frapper sur, heurter</text></gloss>
      <gloss lang="en"><text>set up, build, fix; (baŋ vulan) kneel, bow down; strike against, knock</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 69 occurrences, first GEN.37.10; Lexique kissi–français, p. 4: baŋɔɔ/ baŋ; Terminologie (langue), n° 213: Banhöö</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 4 : baŋɔɔ/ baŋ « frapper sur, heurter » ; baŋ « fixer » ; baŋ vulan (variante baŋ vuran) « s'agenouiller ». Académie des langues (terminologie, langue n° 213) : banhöö « injonction » ; a banhöö o köö « injonctif » (n° 212). Académie des langues (terminologie, langue n° 295 et 296) : banhöö (ou viomöö) « ordonner, ordre ». Aussi Terminologie, p. 211 : « Banhöö ». Académie des langues (terminologie, histoire n° 211) : « contrainte ». Académie des langues (terminologie, histoire n° 394, 395) : « implantation, imposition » (aussi bannɔnndo).</text></form></note>
  </entry>
