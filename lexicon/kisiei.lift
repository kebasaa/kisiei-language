      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 215: kpóŋgbóléŋ</text></form></note>
  </entry>
  <entry id="kpóŋndán_1955">
    <lexical-unit><form lang="kqs"><text>kpóŋndán</text></form></lexical-unit>
