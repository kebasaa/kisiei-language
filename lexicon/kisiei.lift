    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lale</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="lalle_3027_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sueur</text></gloss>
      <gloss lang="en"><text>sweat</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.6 Sweat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.3.19; Keita 1979, p. 132: Lalle; Paulme 1964, p. 55 (G/K): lale /G./, lalle /K./; Lexique kissi–français, p. 31: lalle; Childs 2000, p. 222: lǎllé</text></form></note>
    <note><form lang="fr"><text>Paulme : lale /G./, lalle /K./ (p. 55).</text></form></note>
  </entry>
  <entry id="lalu_3028">
    <lexical-unit><form lang="kqs"><text>lalu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>laru</text></form></variant>
    <sense id="lalu_3028_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accuser</text></gloss>
      <gloss lang="en"><text>accuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: laru</text></form></note>
    <note><form lang="fr"><text>Forme radicale seule. Cf. lɔlɔɔ « accuser ».</text></form></note>
  </entry>
  <entry id="lalumɛɔ_3029">
    <lexical-unit><form lang="kqs"><text>lalumɛɔ</text></form></lexical-unit>
