    <sense id="kpeku_1853_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>valeur, utilité, profit</text></gloss>
      <gloss lang="en"><text>value, use, profit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>work, job, purpose</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.23.15; Childs 2000, p. 209: kpékúláŋ</text></form></note>
