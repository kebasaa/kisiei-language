    <lexical-unit><form lang="kqs"><text>lemasaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lemasalan</text></form></field>
    <variant><form lang="kqs"><text>lemasa</text></form></variant>
    <variant><form lang="kqs"><text>lemasala</text></form></variant>
    <sense id="lemasaa_2039_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>royauté, majesté ; (après un nom) royal</text></gloss>
      <gloss lang="en"><text>kingship, majesty; (after a noun) royal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 294 occurrences, first GEN.14.17</text></form></note>
    <note><form lang="fr"><text>cɛi lemasaa « palais royal ».</text></form></note>
  </entry>
  <entry id="lemboo_2040">
    <lexical-unit><form lang="kqs"><text>lemboo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lemboa</text></form></field>
    <variant><form lang="kqs"><text>lembu</text></form></variant>
    <sense id="lemboo_2040_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vierge (jeune fille non mariée)</text></gloss>
      <gloss lang="en"><text>virgin (unmarried girl)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first NUM.30.4</text></form></note>
    <note><form lang="fr"><text>cuaambɔ lembu « jeune fille vierge » (Gn 24,16) ; cuaambɔa lemboa (Nb 31,35).</text></form></note>
  </entry>
  <entry id="lembulten_2041">
