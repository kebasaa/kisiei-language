    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>feke-fekela</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekelan</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekea</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekeo</text></form></variant>
    <sense id="feke-feke_839_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>escarpé, abrupt, rocheux</text></gloss>
      <gloss lang="en"><text>steep, rugged, rocky</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note><form lang="fr"><text>fondala feke-fekela co o pembon coo « les lieux escarpés des montagnes » (1 S 23,14).</text></form></note>
  </entry>
