      <trait name="semantic-domain-ddp4" value="6.6 Occupation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.35.17</text></form></note>
    <note><form lang="fr"><text>Composé de sokonɔɔ « guérisseur » et vialaa « mettre au monde ».</text></form></note>
  </entry>
  <entry id="sokonɔɔ_3059">
    <lexical-unit><form lang="kqs"><text>sokonɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sokonɔɔ_3059_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médecin, guérisseur</text></gloss>
      <gloss lang="en"><text>healer, doctor</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>herbalist, traditional healer, shaman</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Sokonöö; Childs 2000, p. 338: sókónɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La Bible a sokonɔ-vialaa « sage-femme » (Gn 38,28).</text></form></note>
  </entry>
  <entry id="sókónɔ̀ɔ́_3060">
