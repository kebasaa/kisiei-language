    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kafolan</text></form></field>
    <variant><form lang="kqs"><text>kafo</text></form></variant>
    <variant><form lang="kqs"><text>kafola</text></form></variant>
    <sense id="kafoo_443_s1">
