  <entry id="bɔ́ŋgèìyó_485">
    <lexical-unit><form lang="kqs"><text>bɔ́ŋgèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ́ŋgèìyá</text></form></field>
    <sense id="bɔ́ŋgèìyó_485_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit poisson plein d'arêtes (vendu séché et fumé)</text></gloss>
      <gloss lang="en"><text>small bony fish (sold dried and smoked)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ́ŋgèìyó</text></form></note>
  </entry>
  <entry id="bɔ̀ŋgìóó_486">
    <lexical-unit><form lang="kqs"><text>bɔ̀ŋgìóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ŋgìóó_486_s1">
      <grammatical-info value="Noun"/>
