    <sense id="ɲáŋòŋ-ɲàŋòŋ_4164_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(marcher) à grands pas puissants, comme un géant</text></gloss>
      <gloss lang="en"><text>(walk) powerfully, striding like a giant</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 275: ɲáŋòŋ-ɲàŋòŋ</text></form></note>
  </entry>
  <entry id="ɲáɲáá_4165">
    <lexical-unit><form lang="kqs"><text>ɲáɲáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
