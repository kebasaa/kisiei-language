      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane de forêt (sert de corde, pour les ponts)</text></gloss>
      <gloss lang="en"><text>forest creeper (used as rope, for bridges)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pàmbúléŋ</text></form></note>
  </entry>
  <entry id="pambɛi_3868">
    <lexical-unit><form lang="kqs"><text>pambɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pambae</text></form></variant>
    <variant><form lang="kqs"><text>pambale</text></form></variant>
    <sense id="pambɛi_3868_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste (espèce poussant sur les lieux de culte)</text></gloss>
      <gloss lang="en"><text>kind of shrub (growing at shrines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 77: pambae, pambale ou pambɛy</text></form></note>
    <note><form lang="fr"><text>Paulme : arbustes qui poussent sur le pambaeniŋ ; pambɛy ma, pambɛ y kɔsɔa « le pambae du kɔsɔa » (autel pour purifications).</text></form></note>
  </entry>
  <entry id="pampannden_3869">
    <lexical-unit><form lang="kqs"><text>pampannden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pampannden_3869_s1">
      <grammatical-info value="Noun"/>
