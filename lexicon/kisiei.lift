    <trait name="status" value="attested"/>
    <sense id="buun_259_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bosses (du chameau)</text></gloss>
      <gloss lang="en"><text>humps (of camels)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>unripe palm nut; hump</text></form></field>
