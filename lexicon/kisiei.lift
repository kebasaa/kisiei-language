    <variant><form lang="kqs"><text>telennda</text></form></variant>
    <sense id="telenndo_1642_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>temps, moment, époque</text></gloss>
      <gloss lang="en"><text>time, moment, period</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>time, period; also chance, opportunity</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 99 occurrences, first GEN.13.9; Childs 2000, p. 352: téléŋndó</text></form></note>
