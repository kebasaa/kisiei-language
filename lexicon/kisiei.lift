    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 413: yòù-yɔ̀ɔ̀yàá</text></form></note>
  </entry>
  <entry id="yòùwó_6217">
    <lexical-unit><form lang="kqs"><text>yòùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yòùwó_6217_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prêter, emprunter</text></gloss>
      <gloss lang="en"><text>lend, borrow</text></gloss>
