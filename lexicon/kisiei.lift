      <gloss lang="fr"><text>en ployant facilement</text></gloss>
      <gloss lang="en"><text>bending easily</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 228: lɛ́ɛ́ù-lɛ̀ɛ̀ù</text></form></note>
  </entry>
