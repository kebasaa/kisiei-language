      <gloss lang="fr"><text>grande ville</text></gloss>
      <gloss lang="en"><text>big town, city</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: kobida</text></form></note>
  </entry>
  <entry id="kobinte_1637">
    <lexical-unit><form lang="kqs"><text>kobinte</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kobinte_1637_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>à plus forte raison</text></gloss>
      <gloss lang="en"><text>all the more, let alone</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: kobinte</text></form></note>
  </entry>
  <entry id="kobio_1638">
    <lexical-unit><form lang="kqs"><text>kobio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kobilan</text></form></field>
    <variant><form lang="kqs"><text>kobi</text></form></variant>
    <variant><form lang="kqs"><text>kobila</text></form></variant>
    <sense id="kobio_1638_s1">
