      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also future auxiliary</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18903 occurrences, first GEN.1.7; Childs 2000, p. 50: cò</text></form></note>
  </entry>
  <entry id="cobe_460">
