  <entry id="vanacieeyɛi_4339">
    <lexical-unit><form lang="kqs"><text>vanacieeyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="check"/>
    <sense id="vanacieeyɛi_4339_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>humanité, humanisme (Keita)</text></gloss>
      <gloss lang="en"><text>humanity, humaneness (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Vanatyieoyèi; Lexique kissi–français, p. 60: vanacieeyɛi</text></form></note>
    <note><form lang="fr"><text>Keita écrit Vanatyieoyèi ; la Bible a vanacieeyɛi (Ps 11,3 ; Is 3,15), au sens à préciser. Le Lexique kissi–français (p. 60) traduit aussi « l'humanisme ».</text></form></note>
  </entry>
  <entry id="vanacieo_4340">
    <lexical-unit><form lang="kqs"><text>vanacieo</text></form></lexical-unit>
