      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouc</text></gloss>
      <gloss lang="en"><text>he-goat, billy goat</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.37.31; Keita 1979, p. 137: Toovio</text></form></note>
  </entry>
  <entry id="tosaa_1700">
    <lexical-unit><form lang="kqs"><text>tosaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosa</text></form></variant>
    <variant><form lang="kqs"><text>tosanin</text></form></variant>
    <variant><form lang="kqs"><text>tosan</text></form></variant>
    <variant><form lang="kqs"><text>tosal</text></form></variant>
    <sense id="tosaa_1700_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire</text></gloss>
      <gloss lang="en"><text>do, make</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1621 occurrences, first GEN.2.5; Keita 1979, p. 113: Tosaa; Childs 2000, p. 367: tòsàá</text></form></note>
    <note><form lang="fr"><text>tosan « se faire, arriver » (moyen) ; tosal « faire pour » (bénéfactif).</text></form></note>
  </entry>
  <entry id="tosalan_1701">
    <lexical-unit><form lang="kqs"><text>tosalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tosalan_1701_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arriver à (qqn)</text></gloss>
      <gloss lang="en"><text>happen to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.44.29</text></form></note>
    <note><form lang="fr"><text>Moyen de tosal, bénéfactif de tosaa.</text></form></note>
  </entry>
  <entry id="tosallo_1702">
    <lexical-unit><form lang="kqs"><text>tosallo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosal</text></form></variant>
    <variant><form lang="kqs"><text>tosalnin</text></form></variant>
    <sense id="tosallo_1702_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire pour, faire à (qqn)</text></gloss>
      <gloss lang="en"><text>do for, do to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 164 occurrences, first GEN.21.12; Childs 2000, p. 367: tòsàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tosaa « faire ».</text></form></note>
  </entry>
  <entry id="tosanndo_1703">
    <lexical-unit><form lang="kqs"><text>tosanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosan</text></form></variant>
    <variant><form lang="kqs"><text>tosannin</text></form></variant>
    <sense id="tosanndo_1703_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se faire, arriver ; être fait</text></gloss>
      <gloss lang="en"><text>happen, come about; be done</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be done, be made; succeed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 96 occurrences, first GEN.6.11; Childs 2000, p. 367: tòsǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de tosaa « faire ». Mí ɲɔɔ tosan lende « Et il en fut ainsi » (Gn 1,7).</text></form></note>
  </entry>
  <entry id="tova_1704">
    <lexical-unit><form lang="kqs"><text>tova</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tovaa</text></form></variant>
    <sense id="tova_1704_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mâle (bovin)</text></gloss>
      <gloss lang="en"><text>male (of cattle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>male (cow, sheep, etc.), bull</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first EXO.29.1; Childs 2000, p. 367: tòòyòó</text></form></note>
    <note><form lang="fr"><text>naw tova « taureau », pluriel navaa tovaa.</text></form></note>
  </entry>
  <entry id="tovɔɔ_1705">
    <lexical-unit><form lang="kqs"><text>tovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toaw</text></form></variant>
    <variant><form lang="kqs"><text>toawnin</text></form></variant>
    <variant><form lang="kqs"><text>townun</text></form></variant>
    <sense id="tovɔɔ_1705_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chasser, expulser ; poursuivre ; creuser (un puits)</text></gloss>
      <gloss lang="en"><text>drive out, expel; pursue; dig (a well)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 116 occurrences, first GEN.4.14</text></form></note>
  </entry>
  <entry id="toŋɔɔ_1706">
    <lexical-unit><form lang="kqs"><text>toŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toŋ</text></form></variant>
    <sense id="toŋɔɔ_1706_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>griller, cuire (galettes)</text></gloss>
      <gloss lang="en"><text>fry, bake (cakes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry, cook</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JER.7.18; Keita 1979, p. 115: Tonhöö; Childs 2000, p. 365: tòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>toŋ dɛɔ « faire des galettes » (GEN 18,6).</text></form></note>
  </entry>
  <entry id="toɲaa_1707">
    <lexical-unit><form lang="kqs"><text>toɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="toɲaa_1707_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vérité ; justice</text></gloss>
      <gloss lang="en"><text>truth; justice</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>truth; kindness, goodness, a favour</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 321 occurrences, first GEN.18.21; Keita 1979, p. 148: Tonyaa; Childs 2000, p. 366: tòɲáá</text></form></note>
  </entry>
  <entry id="tueyɔɔ_1708">
    <lexical-unit><form lang="kqs"><text>tueyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuei</text></form></variant>
    <variant><form lang="kqs"><text>tuɛi</text></form></variant>
    <variant><form lang="kqs"><text>tui</text></form></variant>
    <variant><form lang="kqs"><text>tuɛinin</text></form></variant>
    <sense id="tueyɔɔ_1708_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entendre, écouter ; apprendre (une nouvelle)</text></gloss>
      <gloss lang="en"><text>hear, listen; learn (news)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: understand; sense, perceive, smell</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 265 occurrences, first GEN.3.10; Childs 2000, p. 370: tùèìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tui au négatif : la tui ya diom te « vous ne m'avez pas écouté » (Gn 42,22).</text></form></note>
  </entry>
