  <entry id="kɔ̀sàá_1886">
    <lexical-unit><form lang="kqs"><text>kɔ̀sàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀sàá_1886_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être taché, rouillé, rester sale ; salir</text></gloss>
      <gloss lang="en"><text>be spotted, rusty, stay dirty; make dirty</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 189: kɔ̀sàá</text></form></note>
  </entry>
  <entry id="kɔsɔɔ_1887">
    <lexical-unit><form lang="kqs"><text>kɔsɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔsɔ</text></form></variant>
    <sense id="kɔsɔɔ_1887_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langueur, dépérissement ; (luɛi kɔsɔ) dépérir, se flétrir, être en deuil (terre)</text></gloss>
      <gloss lang="en"><text>languor, wasting; (luɛi kɔsɔ) languish, wither, mourn (of the land)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.1 Sick"/>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sick person; (pl.) sickness, illness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.64.6; Childs 2000, p. 189: kɔ́sɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lɛŋnden le luɛi kɔsɔ « la terre est en deuil » (JOL.1.10) ; tumnda n'rɛsɛnndan la luɛi kɔsɔ « la vigne languit » (ISA.24.7) ; mì mal naa kɔsɔɔ luɛyɔɔ « nous sommes tous flétris » (ISA.64.6) ; dii ndu kɔsɔ « l'anéantir » (JDG.4.24).</text></form></note>
  </entry>
  <entry id="kɔ̀tɔ́kpàá_1888">
