      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 217: Kpema lelènndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. kpemaa « pacte, alliance ».</text></form></note>
  </entry>
  <entry id="kpema salavusoo_2421">
    <lexical-unit><form lang="kqs"><text>kpema salavusoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cɔɔmuule salavusoo</text></form></variant>
