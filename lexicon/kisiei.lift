    <sense id="fíkì-fíkì_1372_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en se balançant, en secouant (branches, fronde)</text></gloss>
      <gloss lang="en"><text>swaying, shaking (branches, sling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 105: fíkì-fíkì</text></form></note>
  </entry>
  <entry id="fíkíkí_1373">
    <lexical-unit><form lang="kqs"><text>fíkíkí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fíkíkí_1373_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>plein à ras bord ; en balançant</text></gloss>
      <gloss lang="en"><text>full to the brim; swinging back and forth</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíkíkí</text></form></note>
  </entry>
  <entry id="fikpi_1374">
    <lexical-unit><form lang="kqs"><text>fikpi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fikpi_1374_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avec force, avec violence</text></gloss>
      <gloss lang="en"><text>forcefully, violently</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fikpi</text></form></note>
  </entry>
  <entry id="filaniiyo_1375">
    <lexical-unit><form lang="kqs"><text>filaniiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="filaniiyo_1375_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tricot</text></gloss>
      <gloss lang="en"><text>knitted garment, sweater</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Filaniiyo; Lexique kissi–français, p. 15: filaniiyo</text></form></note>
  </entry>
  <entry id="fili-fili_1376">
    <lexical-unit><form lang="kqs"><text>fili-fili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fili-fili_1376_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en foule, en masse (arriver)</text></gloss>
      <gloss lang="en"><text>in crowds, swarming (come)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.19.22</text></form></note>
  </entry>
  <entry id="filiyo_1377">
    <lexical-unit><form lang="kqs"><text>filiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>fliyo</text></form></variant>
    <sense id="filiyo_1377_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crépuscule du soir</text></gloss>
      <gloss lang="en"><text>evening twilight</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 26: firiyo, friyo</text></form></note>
    <note><form lang="fr"><text>Paulme : firiyo tul « le crépuscule est venu, la nuit tombe ». Cf. fitilio « crépuscule » (Bible), peut-être le même mot.</text></form></note>
  </entry>
  <entry id="filiɲa_1378">
    <lexical-unit><form lang="kqs"><text>filiɲa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="filiɲa_1378_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>deuil</text></gloss>
      <gloss lang="en"><text>mourning</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 26: firiña</text></form></note>
    <note><form lang="fr"><text>Cf. biisio « deuil » (Bible).</text></form></note>
  </entry>
  <entry id="fílò_1379">
    <lexical-unit><form lang="kqs"><text>fílò</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fílò_1379_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>un instant, vite, tout à coup</text></gloss>
      <gloss lang="en"><text>for a moment, quickly, all of a sudden</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fílò</text></form></note>
  </entry>
  <entry id="filofiloo_1380">
    <lexical-unit><form lang="kqs"><text>filofiloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="filofiloo_1380_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rapide</text></gloss>
      <gloss lang="en"><text>fast</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: filofiloo</text></form></note>
  </entry>
  <entry id="fíóú_1381">
    <lexical-unit><form lang="kqs"><text>fíóú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fíóú_1381_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout, complètement</text></gloss>
      <gloss lang="en"><text>all, completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíóú</text></form></note>
  </entry>
  <entry id="fisa_1382">
    <lexical-unit><form lang="kqs"><text>fisa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fisa_1382_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>meilleur, préférable (o co fisa « il vaut mieux »)</text></gloss>
      <gloss lang="en"><text>better, preferable (o co fisa 'it is better')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 146 occurrences, first GEN.29.19; Paulme 1964, p. 26: fisa; Lexique kissi–français, p. 15: fisa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 26 : a fisa « c'est mieux ».</text></form></note>
  </entry>
  <entry id="fisaa_1383">
    <lexical-unit><form lang="kqs"><text>fisaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fisaa_1383_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>valoir mieux (que), être préférable à</text></gloss>
      <gloss lang="en"><text>be better (than), be preferable to</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be better or equal</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.37.16; Childs 2000, p. 107: fìsàá</text></form></note>
    <note><form lang="fr"><text>Voir l'adjectif fisa. Mɛlɛka yɔngɔnndo co fisaa vanacieo tiindanndo « mieux vaut se réfugier auprès du Seigneur que se fier à l'homme » (PSA.118.8).</text></form></note>
  </entry>
  <entry id="fisan_1384">
    <lexical-unit><form lang="kqs"><text>fisan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fisan_1384_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (Phialodiscus plurijugatus)</text></gloss>
      <gloss lang="en"><text>tree (Phialodiscus plurijugatus)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 26: fisan</text></form></note>
  </entry>
  <entry id="fitilio_1385">
    <lexical-unit><form lang="kqs"><text>fitilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fitilio_1385_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crépuscule</text></gloss>
      <gloss lang="en"><text>dusk, twilight</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dusk, early evening</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.7.9; Keita 1979, p. 154: Fitilio; Lexique kissi–français, p. 15: fitilio; Childs 2000, p. 107: fìtílìó</text></form></note>
  </entry>
  <entry id="fitinaa_1386">
    <lexical-unit><form lang="kqs"><text>fitinaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>fitinalan</text></form></field>
    <variant><form lang="kqs"><text>fitina</text></form></variant>
    <variant><form lang="kqs"><text>fitinala</text></form></variant>
    <sense id="fitinaa_1386_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lampe</text></gloss>
      <gloss lang="en"><text>lamp</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first PRO.6.23</text></form></note>
    <note><form lang="fr"><text>ɲɛ kɛsiaa lafitinaa « chandelier » (Ex 25,31).</text></form></note>
  </entry>
  <entry id="fíɔ́ndɔ́ndɔ́ndɔ́_1387">
    <lexical-unit><form lang="kqs"><text>fíɔ́ndɔ́ndɔ́ndɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fíɔ́ndɔ́ndɔ́ndɔ́_1387_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout près</text></gloss>
      <gloss lang="en"><text>very close</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíɔ́ndɔ́ndɔ́ndɔ́</text></form></note>
  </entry>
  <entry id="fíɔ́ŋ_1388">
    <lexical-unit><form lang="kqs"><text>fíɔ́ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fíɔ́ŋ_1388_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>à toute vitesse (voiture, pierre de fronde, balle)</text></gloss>
      <gloss lang="en"><text>at great speed (car, slingstone, bullet)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíɔ́ŋ</text></form></note>
  </entry>
  <entry id="fiɔ́ɔ́-fiɔ́ɔ̀_1389">
    <lexical-unit><form lang="kqs"><text>fiɔ́ɔ́-fiɔ́ɔ̀</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fiɔ́ɔ́-fiɔ́ɔ̀_1389_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout près, de près ; juste après</text></gloss>
      <gloss lang="en"><text>close by, closely; right after</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
