      <gloss lang="fr"><text>souligne l'action de se moucher, de déféquer, de péter ; fort (souffler)</text></gloss>
      <gloss lang="en"><text>stresses blowing one's nose, defecating, breaking wind; hard (blowing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fáá</text></form></note>
  </entry>
  <entry id="fáá_790">
    <lexical-unit><form lang="kqs"><text>fáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fááláŋ</text></form></field>
    <sense id="fáá_790_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre sauvage à gousses (qui éclatent en saison sèche)</text></gloss>
      <gloss lang="en"><text>wild tree bearing bean pods (that burst in the dry season)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fáá</text></form></note>
  </entry>
  <entry id="faaboo_791">
    <lexical-unit><form lang="kqs"><text>faaboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="faaboo_791_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perroquet</text></gloss>
      <gloss lang="en"><text>parrot</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a bird, perhaps a small green parrot; also a figure of the initiation society</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Faaboo; Childs 2000, p. 93: fàábɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="fááfáá_792">
    <lexical-unit><form lang="kqs"><text>fááfáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fááfááláŋ</text></form></field>
    <sense id="fááfáá_792_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tuteurs pour les haricots grimpants</text></gloss>
      <gloss lang="en"><text>climbing sticks for bean vines</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fááfáá</text></form></note>
  </entry>
  <entry id="fáàndaa_793">
    <lexical-unit><form lang="kqs"><text>fáàndaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fáàndaa_793_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fronde</text></gloss>
      <gloss lang="en"><text>sling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sling, slingshot, also used to chase birds</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.20.16; Keita 1979, p. 156: Faandaa; Childs 2000, p. 93: fáàndáá</text></form></note>
  </entry>
  <entry id="fààndàá_794">
    <lexical-unit><form lang="kqs"><text>fààndàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fààndàá_794_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter loin ; errer sans but</text></gloss>
      <gloss lang="en"><text>throw far; wander aimlessly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fààndàá</text></form></note>
    <note><form lang="fr"><text>La Bible n'a que le nom fáàndaa « fronde ».</text></form></note>
  </entry>
  <entry id="fààndɛ̀í_795">
    <lexical-unit><form lang="kqs"><text>fààndɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fààndǎŋ</text></form></field>
    <sense id="fààndɛ̀í_795_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haricot sauvage brun foncé (teinture, potasse ; peut-être toxique)</text></gloss>
      <gloss lang="en"><text>dark brown wild bean (dye, soda; possibly poisonous)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fààndɛ̀í</text></form></note>
  </entry>
  <entry id="fààsàá_796">
    <lexical-unit><form lang="kqs"><text>fààsàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fààsàá_796_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter à terre et briser ; éclater ; éclore</text></gloss>
      <gloss lang="en"><text>smash down, shatter; split open; hatch</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 94: fààsàá</text></form></note>
  </entry>
  <entry id="faaŋiaa_797">
    <lexical-unit><form lang="kqs"><text>faaŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="faaŋiaa_797_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retirer, enlever (la graisse, les cendres)</text></gloss>
      <gloss lang="en"><text>take off, remove (fat, ashes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away or remove (things or people); plural of fàŋàá</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first LEV.4.19; Childs 2000, p. 94: fààŋìá</text></form></note>
  </entry>
  <entry id="fácííyó_798">
    <lexical-unit><form lang="kqs"><text>fácííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fácííláŋ</text></form></field>
    <sense id="fácííyó_798_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau</text></gloss>
      <gloss lang="en"><text>bucket, pail</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 95: fácííyó</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="fafaláà_799">
    <lexical-unit><form lang="kqs"><text>fafaláà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fafala</text></form></variant>
    <sense id="fafaláà_799_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peiner, se donner du mal ; se soucier de</text></gloss>
      <gloss lang="en"><text>toil, labour; worry about</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>struggle, suffer</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.8.10; Childs 2000, p. 95: fàfàlàá</text></form></note>
    <note><form lang="fr"><text>La fafala le ɲɛ niaa dianin-ndo « ne vous souciez pas de ce que vous mangerez » (Lc 12,29).</text></form></note>
  </entry>
  <entry id="fáká-fáká_800">
    <lexical-unit><form lang="kqs"><text>fáká-fáká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fáká-fáká_800_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très vite, soudainement</text></gloss>
      <gloss lang="en"><text>very fast, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fáká-fáká</text></form></note>
  </entry>
  <entry id="fálábóó_801">
    <lexical-unit><form lang="kqs"><text>fálábóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fálábúéí</text></form></field>
    <sense id="fálábóó_801_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre épineux à bois clair, facile à fendre</text></gloss>
      <gloss lang="en"><text>thorny tree with light, easily split wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fálábóó</text></form></note>
  </entry>
  <entry id="falei_802">
    <lexical-unit><form lang="kqs"><text>falei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>falon</text></form></field>
    <variant><form lang="kqs"><text>falun</text></form></variant>
    <variant><form lang="kqs"><text>falii</text></form></variant>
    <sense id="falei_802_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre, partie du corps ; chair ; (pl.) le corps</text></gloss>
      <gloss lang="en"><text>limb, part of the body; flesh; (pl.) the body</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first LEV.21.18</text></form></note>
    <note><form lang="fr"><text>Se fléchit comme dialii : Mí Sɔɛi siŋnun falon « le Verbe s'est fait chair » (Jn 1,14) ; falii kiyɛiye « chair vive » (Lv 13,10) ; ifalu oo ifalu « chaque membre » (Rm 12,4).</text></form></note>
  </entry>
  <entry id="faleŋii_803">
    <lexical-unit><form lang="kqs"><text>faleŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>faleŋun</text></form></field>
    <variant><form lang="kqs"><text>falennde</text></form></variant>
    <variant><form lang="kqs"><text>falenndon</text></form></variant>
    <sense id="faleŋii_803_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rite, cérémonie (religieuse)</text></gloss>
      <gloss lang="en"><text>rite, ceremony</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first EXO.29.24</text></form></note>
    <note><form lang="fr"><text>tosa faleŋii dindiannde « accomplir le rite de purification » (Lv 12,7). Variante falennde, pluriel falenndon (Lv 9,7 ; Lv 14,2).</text></form></note>
  </entry>
  <entry id="fàllé_804">
    <lexical-unit><form lang="kqs"><text>fàllé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="fàllé_804_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terrier, nid souterrain du rat</text></gloss>
      <gloss lang="en"><text>rat's burrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fàllé</text></form></note>
  </entry>
  <entry id="fàlléŋ_805">
    <lexical-unit><form lang="kqs"><text>fàlléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fàlláŋ</text></form></field>
    <sense id="fàlléŋ_805_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fil, fil de trame</text></gloss>
      <gloss lang="en"><text>thread, weft thread</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fàlléŋ</text></form></note>
  </entry>
  <entry id="fallo_806">
    <lexical-unit><form lang="kqs"><text>fallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fal</text></form></variant>
    <sense id="fallo_806_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vieil homme ; (en s'adressant à qqn) monseigneur, monsieur</text></gloss>
      <gloss lang="en"><text>old man; (in address) sir, my lord</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.16.2</text></form></note>
    <note><form lang="fr"><text>fal yuuvɛiyo « un vieillard » (Jg 19,16) ; Fallo ! en s'adressant à un mari ou à un roi (Gn 16,2 ; Jg 3,19).</text></form></note>
  </entry>
  <entry id="falnɔɔ_807">
    <lexical-unit><form lang="kqs"><text>falnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="falnɔɔ_807_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-père, beau-fils</text></gloss>
      <gloss lang="en"><text>father-in-law, son-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in-law</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Falnö; Childs 2000, p. 97: fálnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit Falnö ; voyelle longue d'après Childs (fálnɔ̀ɔ́).</text></form></note>
  </entry>
  <entry id="fálúlú_808">
    <lexical-unit><form lang="kqs"><text>fálúlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fálúlú_808_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(jeter) loin, violemment</text></gloss>
      <gloss lang="en"><text>(thrown) far, wildly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 97: fálúlú</text></form></note>
  </entry>
  <entry id="falɛiyo_809">
    <lexical-unit><form lang="kqs"><text>falɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="falɛiyo_809_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeudi</text></gloss>
      <gloss lang="en"><text>Thursday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Falèiyo</text></form></note>
  </entry>
  <entry id="fàmbúléŋ_810">
    <lexical-unit><form lang="kqs"><text>fàmbúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="fàmbúléŋ_810_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'arbre</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 97: fàmbúléŋ</text></form></note>
  </entry>
  <entry id="fandaa_811">
    <lexical-unit><form lang="kqs"><text>fandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fanda</text></form></variant>
    <variant><form lang="kqs"><text>faandia</text></form></variant>
    <sense id="fandaa_811_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner en présent, offrir ; (nom) présent, cadeau ; (faandia) distribuer des présents</text></gloss>
      <gloss lang="en"><text>give as a present, offer; (noun) gift, present; (faandia) hand out gifts</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>give as a gift; (noun) gift, present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2SA.11.8; Childs 2000, p. 97: fàndàá</text></form></note>
    <note><form lang="fr"><text>Mó fanda Abimelɛk « il en fit présent à Abimélek » (GEN.21.27) ; masaa koma soli fandaa pum « un présent de la part du roi » (2SA.11.8) ; mó faandia vannda ɲɛm kɛndɛn « il distribua des présents » (EST.2.18 ; Childs p. 94 fààndìá).</text></form></note>
  </entry>
  <entry id="fando-fando_812">
    <lexical-unit><form lang="kqs"><text>fando-fando</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fando-fando_812_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sans force, défaillant</text></gloss>
      <gloss lang="en"><text>faint, without strength</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.29.8</text></form></note>
    <note><form lang="fr"><text>muungu fando-fando maa n'vanlaandu « devenir comme des femmes » (Jr 50,37).</text></form></note>
  </entry>
  <entry id="fàngà-kundaa_813">
    <lexical-unit><form lang="kqs"><text>fàngà-kundaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fàngà-kundaa_813_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foule, multitude</text></gloss>
      <gloss lang="en"><text>crowd, multitude</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crowd, assembly, group of people</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.17.5; Childs 2000, p. 98: fàŋgàá</text></form></note>
  </entry>
  <entry id="fásáfásáléŋ_814">
    <lexical-unit><form lang="kqs"><text>fásáfásáléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fásáfásǎŋ</text></form></field>
    <sense id="fásáfásáléŋ_814_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouttes de pluie poussées par le vent sous un abri</text></gloss>
      <gloss lang="en"><text>raindrops blown in under a shelter</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 98: fásáfásáléŋ</text></form></note>
  </entry>
  <entry id="fasaka-fasaka_815">
    <lexical-unit><form lang="kqs"><text>fasaka-fasaka</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasaka-fasaka_815_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en bouillonnant, tumultueusement (eaux)</text></gloss>
      <gloss lang="en"><text>surging, turbulently (water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>quickly, roughly, in a tumbling manner</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first AMO.8.8; Childs 2000, p. 98: fásàkà-fásàkà</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : mɛnndan ma fula fasaka-fasaka « les eaux se soulèvent » (AMO.8.8).</text></form></note>
  </entry>
  <entry id="fásàn_816">
    <lexical-unit><form lang="kqs"><text>fásàn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fásàn_816_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>çà et là, de tous côtés (disperser)</text></gloss>
      <gloss lang="en"><text>abroad, in all directions (scatter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread about</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.49.7; Childs 2000, p. 99: fásáŋ-fásáŋ</text></form></note>
    <note><form lang="fr"><text>saŋ … fásàn « disperser ».</text></form></note>
  </entry>
  <entry id="fasaŋa_817">
    <lexical-unit><form lang="kqs"><text>fasaŋa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fasaŋanin</text></form></variant>
    <variant><form lang="kqs"><text>fasaŋan</text></form></variant>
    <variant><form lang="kqs"><text>fasaŋanndo</text></form></variant>
    <sense id="fasaŋa_817_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger ; secouer (pour faire tomber) ; (fasaŋanndo) se déployer</text></gloss>
      <gloss lang="en"><text>sprinkle; shake off; (fasaŋanndo) spread out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>splash, sprinkle; throw down, sow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ACT.28.5; Childs 2000, p. 98: fàsàŋàá</text></form></note>
    <note><form lang="fr"><text>Singulier de fasaŋiaa. Mí Pol fasaŋa kɛw kon o yin « Paul secoua la bête dans le feu » (ACT.28.5) ; kooma ndɔma fasaŋan-ndan « son sang répandu par aspersion » (HEB.12.24).</text></form></note>
  </entry>
  <entry id="fasaŋiaa_818">
    <lexical-unit><form lang="kqs"><text>fasaŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasaŋiaa_818_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger, répandre (en aspergeant)</text></gloss>
      <gloss lang="en"><text>sprinkle, splash</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.24.6; Childs 2000, p. 99: fàsàŋìá</text></form></note>
  </entry>
  <entry id="fasɛi_819">
    <lexical-unit><form lang="kqs"><text>fasɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fasɛi_819_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, sans retour (voué, consacré)</text></gloss>
      <gloss lang="en"><text>wholly, irrevocably (devoted, given)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
