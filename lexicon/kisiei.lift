  </entry>
  <entry id="sisɛlan_4616">
    <lexical-unit><form lang="kqs"><text>sisɛlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sisɛran</text></form></variant>
    <sense id="sisɛlan_4616_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>résidu des noix de palmiste broyées après extraction de l'huile</text></gloss>
      <gloss lang="en"><text>residue of crushed palm kernels after the oil is extracted</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: sisɛran</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
