    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 33: masini swandaa</text></form></note>
  </entry>
  <entry id="masɛi_2615">
    <lexical-unit><form lang="kqs"><text>masɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
