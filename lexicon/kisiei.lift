      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>uncooked, fresh</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.1.12; Lexique kissi–français, p. 25: kiyɛiyo; Childs 2000, p. 171: kìyɛ́í-</text></form></note>
  </entry>
  <entry id="kíŋ-kìŋ_1626">
