    <trait name="status" value="attested"/>
    <sense id="ndi_3684_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>le, la (classe i)</text></gloss>
      <gloss lang="en"><text>it (i class, object)</text></gloss>
