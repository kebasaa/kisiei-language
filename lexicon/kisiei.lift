    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOS.15.51; Lexique kissi–français, p. 24: kilo</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="kiloo_1600">
    <lexical-unit><form lang="kqs"><text>kiloo</text></form></lexical-unit>
