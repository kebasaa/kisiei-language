    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mbòòma</text></form></variant>
    <sense id="mboomaa_1101_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hamac ; litière, palanquin</text></gloss>
      <gloss lang="en"><text>hammock; litter, palanquin</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Nboomaa; Childs 2000, p. 256: mbòmàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Nboomaa. Forme radicale mbòòma « litière de Salomon » dans la Bible (Ct 3,7.9).</text></form></note>
  </entry>
  <entry id="mbɔ̀_1102">
    <lexical-unit><form lang="kqs"><text>mbɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mbɔ̀_1102_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ah ! hélas ! (exclamation)</text></gloss>
      <gloss lang="en"><text>ah! alas! (exclamation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first GEN.24.56</text></form></note>
  </entry>
  <entry id="meiyo_1103">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="meiyo_1103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>silence, calme (o meiyo nin)</text></gloss>
      <gloss lang="en"><text>silence, quiet (o meiyo nin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) keep quiet; set a time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Childs 2000, p. 243: mèìyɔ́</text></form></note>
  </entry>
  <entry id="meiyo_1104">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mei</text></form></variant>
    <variant><form lang="kqs"><text>meinin</text></form></variant>
    <sense id="meiyo_1104_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se taire</text></gloss>
      <gloss lang="en"><text>be silent</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>keep quiet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Keita 1979, p. 110: Maiyo; Childs 2000, p. 243: mèìyó</text></form></note>
    <note><form lang="fr"><text>Keita écrit maiyo ; la Bible écrit meiyo (ECC 3,7). Moyen meinun.</text></form></note>
  </entry>
  <entry id="mello_1105">
    <lexical-unit><form lang="kqs"><text>mello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mel</text></form></variant>
    <variant><form lang="kqs"><text>melnin</text></form></variant>
    <sense id="mello_1105_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser (partir), permettre ; garder pour (Keita)</text></gloss>
      <gloss lang="en"><text>let go, allow; keep for (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first EXO.4.23; Keita 1979, p. 110: Mello</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mello signifie « laisser partir » (EXO 4,23) ; mel et melnin sont les formes négatives de mal « laisser » (GEN 28,15).</text></form></note>
  </entry>
  <entry id="mi_1106">
    <lexical-unit><form lang="kqs"><text>mi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mí</text></form></variant>
    <variant><form lang="kqs"><text>mì</text></form></variant>
    <variant><form lang="kqs"><text>mó</text></form></variant>
    <variant><form lang="kqs"><text>mò</text></form></variant>
    <variant><form lang="kqs"><text>má</text></form></variant>
    <variant><form lang="kqs"><text>mà</text></form></variant>
    <sense id="mi_1106_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>et (alors) ; pour que</text></gloss>
      <gloss lang="en"><text>and (then); so that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'that' (subordinating)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20412 occurrences, first GEN.1.1; Childs 2000, p. 249: mì</text></form></note>
  </entry>
  <entry id="miallo_1107">
    <lexical-unit><form lang="kqs"><text>miallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mialla</text></form></field>
    <sense id="miallo_1107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étranger</text></gloss>
      <gloss lang="en"><text>stranger, foreigner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>guest, visitor, outsider</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.23.4; Keita 1979, p. 148: Miallo; Childs 2000, p. 249: mìàlló</text></form></note>
  </entry>
  <entry id="miinguuo_1108">
    <lexical-unit><form lang="kqs"><text>miinguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>miinguu</text></form></variant>
    <variant><form lang="kqs"><text>miinguo</text></form></variant>
    <variant><form lang="kqs"><text>miingul</text></form></variant>
    <variant><form lang="kqs"><text>miingun</text></form></variant>
    <variant><form lang="kqs"><text>miingulnin</text></form></variant>
    <sense id="miinguuo_1108_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répéter, refaire, redire ; (miinguu yaŋɔɔlen) tendre une embuscade</text></gloss>
      <gloss lang="en"><text>repeat, do again, say again; (miinguu yaŋɔɔlen) lay an ambush</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JDG.5.29</text></form></note>
    <note><form lang="fr"><text>o co lan miinguo lediin-diin, leyàá-yàá « il le fait deux fois, trois fois » (Jb 33,29) ; la miinguu sondo aa « qu'ils redisent » (Ps 118,2) ; miingul … yaŋɔɔlan « dresser une embuscade contre quelqu'un » (Dt 19,11).</text></form></note>
  </entry>
  <entry id="miisuu_1109">
    <lexical-unit><form lang="kqs"><text>miisuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>miisu</text></form></variant>
    <sense id="miisuu_1109_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>précipiter dans l'eau, engloutir, noyer ; se noyer</text></gloss>
      <gloss lang="en"><text>hurl into the water, engulf, drown; be drowned</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>immerse or dunk in water; also put someone into trouble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.14.27; Childs 2000, p. 250: mììsùùwó</text></form></note>
    <note><form lang="fr"><text>O miisuu soa a vanaa ɲaanun o soa coo-o mɛmma ihɛlma … nin « il a précipité dans la mer cheval et cavalier » (Ex 15,1) ; má miisuu o mɛnndan nin « ils furent noyés » (He 11,29).</text></form></note>
  </entry>
  <entry id="milinndo_1110">
    <lexical-unit><form lang="kqs"><text>milinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>milin</text></form></variant>
    <sense id="milinndo_1110_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nez</text></gloss>
      <gloss lang="en"><text>nose</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.13.45; Keita 1979, p. 132: Milinndo; Childs 2000, p. 250: mǐŋndó</text></form></note>
  </entry>
  <entry id="milionndo_1111">
    <lexical-unit><form lang="kqs"><text>milionndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>milionndan</text></form></field>
    <sense id="milionndo_1111_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>million</text></gloss>
      <gloss lang="en"><text>million</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.9.28</text></form></note>
    <note><form lang="fr"><text>Emprunt. milionndo o pilɛ « un million » (1 Ch 21,5).</text></form></note>
  </entry>
  <entry id="milɛɔ_1112">
    <lexical-unit><form lang="kqs"><text>milɛɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>milɛɛa</text></form></field>
    <variant><form lang="kqs"><text>milɛɛ</text></form></variant>
    <variant><form lang="kqs"><text>milɛaa</text></form></variant>
    <sense id="milɛɔ_1112_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mulet</text></gloss>
      <gloss lang="en"><text>mule</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2SA.18.9</text></form></note>
    <note><form lang="fr"><text>Emprunt (français mulet).</text></form></note>
  </entry>
  <entry id="mingio_1113">
    <lexical-unit><form lang="kqs"><text>mingio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mingi</text></form></variant>
    <variant><form lang="kqs"><text>minginin</text></form></variant>
    <variant><form lang="kqs"><text>mingin</text></form></variant>
    <sense id="mingio_1113_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>réparer, remettre en état, restaurer ; venger</text></gloss>
      <gloss lang="en"><text>repair, restore; avenge</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>return, go back; retaliate, replace</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 148 occurrences, first GEN.4.24; Childs 2000, p. 249: mìŋìó</text></form></note>
  </entry>
  <entry id="mingullo_1114">
    <lexical-unit><form lang="kqs"><text>mingullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mingul</text></form></variant>
    <variant><form lang="kqs"><text>mingulnin</text></form></variant>
    <sense id="mingullo_1114_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre, restituer (à quelqu'un) ; rendre la pareille</text></gloss>
      <gloss lang="en"><text>give back, restore (to someone); repay</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.50.20</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de mingio.</text></form></note>
  </entry>
  <entry id="miolɔɔ_1115">
    <lexical-unit><form lang="kqs"><text>miolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>miol</text></form></variant>
    <variant><form lang="kqs"><text>mial</text></form></variant>
    <variant><form lang="kqs"><text>mil</text></form></variant>
    <variant><form lang="kqs"><text>mialnin</text></form></variant>
    <sense id="miolɔɔ_1115_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avaler</text></gloss>
      <gloss lang="en"><text>swallow</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.88.18; Keita 1979, p. 116: Miolöö; Childs 2000, p. 250: mìòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>mil : radical négatif (GEN 41,21).</text></form></note>
  </entry>
  <entry id="mir_1116">
    <lexical-unit><form lang="kqs"><text>mir</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mir_1116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>myrrhe</text></gloss>
      <gloss lang="en"><text>myrrh</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.37.25</text></form></note>
    <note><form lang="fr"><text>Emprunt ; souvent avec cun kɛndɛ « parfum ».</text></form></note>
  </entry>
  <entry id="misiliminɔɔ_1117">
    <lexical-unit><form lang="kqs"><text>misiliminɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="misiliminɔɔ_1117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>musulman</text></gloss>
      <gloss lang="en"><text>Muslim</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Misiliminöö</text></form></note>
  </entry>
  <entry id="misilio_1118">
    <lexical-unit><form lang="kqs"><text>misilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="misilio_1118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mosquée</text></gloss>
      <gloss lang="en"><text>mosque</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Misilio; Childs 2000, p. 251: mísílíó</text></form></note>
  </entry>
  <entry id="misimisi_1119">
    <lexical-unit><form lang="kqs"><text>misimisi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="misimisi_1119_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>engloutir, dévorer</text></gloss>
      <gloss lang="en"><text>swallow up, devour</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural action of 'swallow'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.41.7; Childs 2000, p. 251: mìsìó</text></form></note>
    <note><form lang="fr"><text>Redoublement ; apparenté à miolɔɔ « avaler » (Childs : mìsìó, pluriel de mìòlɔ̀ɔ́). Voir aussi misimisio « angoisse ».</text></form></note>
  </entry>
  <entry id="misimisio_1120">
    <lexical-unit><form lang="kqs"><text>misimisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="misimisio_1120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>angoisse, effroi, désarroi</text></gloss>
      <gloss lang="en"><text>anguish, dismay, horror</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2SA.19.1</text></form></note>
    <note><form lang="fr"><text>Avec bii « saisir » : misimisio bii masaa David « le roi fut bouleversé » (2 S 19,1).</text></form></note>
  </entry>
  <entry id="miɔw_1121">
    <lexical-unit><form lang="kqs"><text>miɔw</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="miɔw_1121_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être à terme (grossesse)</text></gloss>
      <gloss lang="en"><text>be due (pregnancy)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Miöw</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : foli miaa « près d'accoucher » (1SA 4,19).</text></form></note>
  </entry>
  <entry id="muiyo_1122">
    <lexical-unit><form lang="kqs"><text>muiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>muiya</text></form></field>
    <sense id="muiyo_1122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustique ; moucheron</text></gloss>
      <gloss lang="en"><text>mosquito; gnat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Muiyo; Childs 2000, p. 254: mùìyó</text></form></note>
    <note><form lang="fr"><text>Le pluriel muiya traduit dans la Bible les moucherons de la troisième plaie d'Égypte (EXO.8.12-14).</text></form></note>
  </entry>
  <entry id="mulinndo_1123">
    <lexical-unit><form lang="kqs"><text>mulinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mulin</text></form></variant>
    <variant><form lang="kqs"><text>mulinin</text></form></variant>
    <sense id="mulinndo_1123_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tourner (vers), retourner ; recommencer, refaire</text></gloss>
      <gloss lang="en"><text>turn (to), go back; do again</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 1SA.8.8</text></form></note>
  </entry>
  <entry id="mulio_1124">
    <lexical-unit><form lang="kqs"><text>mulio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muli</text></form></variant>
    <variant><form lang="kqs"><text>mulinin</text></form></variant>
    <sense id="mulio_1124_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répondre ; tourner, se tourner</text></gloss>
      <gloss lang="en"><text>answer; turn</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>turn over; reply</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first 2SA.14.20; Keita 1979, p. 110: Mulio; Childs 2000, p. 254: mùlìó</text></form></note>
  </entry>
  <entry id="muloo_1125">
    <lexical-unit><form lang="kqs"><text>muloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="muloo_1125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>impôt, tribut ; rançon</text></gloss>
      <gloss lang="en"><text>tax, tribute; ransom</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first EXO.30; Keita 1979, p. 148: Muloo</text></form></note>
  </entry>
  <entry id="mulullo_1126">
    <lexical-unit><form lang="kqs"><text>mulullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mulul</text></form></variant>
    <variant><form lang="kqs"><text>mululnin</text></form></variant>
    <sense id="mulullo_1126_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répondre à ; se tourner vers</text></gloss>
      <gloss lang="en"><text>answer someone; turn to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.45.3; Keita 1979, p. 110: Mulullo</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de mulio.</text></form></note>
  </entry>
  <entry id="mun_1127">
    <lexical-unit><form lang="kqs"><text>mun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mun_1127_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces (pluriel en -on)</text></gloss>
      <gloss lang="en"><text>these, those (-on plural)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1752 occurrences, first GEN.1.14; Childs 2000, p. 255: mùŋ</text></form></note>
  </entry>
  <entry id="mundoo_1128">
    <lexical-unit><form lang="kqs"><text>mundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mundu</text></form></variant>
    <sense id="mundoo_1128_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nuque ; dos</text></gloss>
      <gloss lang="en"><text>nape of the neck; back</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nape of the neck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EXO.33.23; Keita 1979, p. 132: Munduo; Childs 2000, p. 255: mùndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mungén_1129">
    <lexical-unit><form lang="kqs"><text>mungén</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mungén_1129_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>complètement, entièrement (détruit, consumé)</text></gloss>
      <gloss lang="en"><text>completely, utterly (destroyed, burnt up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 2SA.14.7</text></form></note>
    <note><form lang="fr"><text>Après cuulu « brûler » ou cuu « périr » : má cuulu mungén « il les a entièrement consumés » (Jb 1,16).</text></form></note>
  </entry>
  <entry id="mutarde_1130">
    <lexical-unit><form lang="kqs"><text>mutarde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mutarde_1130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moutarde</text></gloss>
      <gloss lang="en"><text>mustard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first MAT.13</text></form></note>
    <note><form lang="fr"><text>Emprunt (français) ; kulii mutarde « graine de moutarde ».</text></form></note>
  </entry>
  <entry id="muulianndo_1131">
    <lexical-unit><form lang="kqs"><text>muulianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muulian</text></form></variant>
    <sense id="muulianndo_1131_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mélanger, mêler ; joindre, associer</text></gloss>
      <gloss lang="en"><text>mix, mingle; join together, combine</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) a mixture, derived from 'turn'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.2.2; Childs 2000, p. 254: mùlìàŋndó</text></form></note>
    <note><form lang="fr"><text>mɔima niaan ma muulian a mɛnndan « ton vin est coupé d'eau » (Es 1,22) ; La bɛnda mì la muulian cɔlua … le « n'accouple pas des bêtes d'espèces différentes » (Lv 19,19). Peut-être apparenté à mulio « tourner » (Childs).</text></form></note>
  </entry>
  <entry id="muuluanndo_1132">
    <lexical-unit><form lang="kqs"><text>muuluanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>muuluannda</text></form></field>
    <sense id="muuluanndo_1132_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hypocrite, homme fourbe</text></gloss>
      <gloss lang="en"><text>hypocrite, deceitful person</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.22.27</text></form></note>
    <note><form lang="fr"><text>Apparenté à muuluo « retourner ». muulɔnndo « hypocrisie, fausseté ; tortueux » (Rm 12,9 ; 2 S 22,27).</text></form></note>
  </entry>
  <entry id="muuluo_1133">
    <lexical-unit><form lang="kqs"><text>muuluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="muuluo_1133_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retourner, renverser</text></gloss>
      <gloss lang="en"><text>turn over, overturn</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Muuluo</text></form></note>
  </entry>
  <entry id="muungoo_1134">
    <lexical-unit><form lang="kqs"><text>muungoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muungu</text></form></variant>
    <variant><form lang="kqs"><text>muungun</text></form></variant>
    <variant><form lang="kqs"><text>muungunin</text></form></variant>
    <sense id="muungoo_1134_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retourner, revenir</text></gloss>
      <gloss lang="en"><text>return, go back</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>return, go back; also retaliate, replace (variant mùùŋgóó)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.12.9; Childs 2000, p. 249: mìŋìó</text></form></note>
  </entry>
  <entry id="mɔikpɛnɛnɔɔ_1135">
    <lexical-unit><form lang="kqs"><text>mɔikpɛnɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="mɔikpɛnɛnɔɔ_1135_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>albinos</text></gloss>
      <gloss lang="en"><text>albino</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Möikpènènöö; Childs 2000, p. 246: mɛ́kpɛ́nɔ́ɔ́</text></form></note>
  </entry>
  <entry id="mɔima vawvan_1136">
    <lexical-unit><form lang="kqs"><text>mɔima vawvan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔima vawvan_1136_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme</text></gloss>
      <gloss lang="en"><text>palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Möèma vawvan</text></form></note>
    <note><form lang="fr"><text>Keita écrit Möèma ; la Bible écrit mɔima, forme radicale de mɔiyan « vin » (DEU.28.39). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="mɔiyan_1137">
    <lexical-unit><form lang="kqs"><text>mɔiyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔima</text></form></variant>
    <sense id="mɔiyan_1137_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin</text></gloss>
      <gloss lang="en"><text>wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>liquor (generic), spirits</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 170 occurrences, first GEN.9.21; Childs 2000, p. 254: mùèìyáŋ</text></form></note>
  </entry>
  <entry id="mɔku-mɔku_1138">
    <lexical-unit><form lang="kqs"><text>mɔku-mɔku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔku-mɔku_1138_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entièrement (couvert)</text></gloss>
      <gloss lang="en"><text>entirely (covered)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.10.5</text></form></note>
    <note><form lang="fr"><text>Après kumbu « couvrir » : kumnde kumbu … mɔku-mɔku « la nuée couvrit entièrement … » (Ex 40,34).</text></form></note>
  </entry>
  <entry id="mɔ́mndo_1139">
    <lexical-unit><form lang="kqs"><text>mɔ́mndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="mɔ́mndo_1139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brouillard ; rosée</text></gloss>
      <gloss lang="en"><text>fog, mist; dew</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dew, morning mist</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first EXO.16.13; Keita 1979, p. 154: Mömndo; Childs 2000, p. 251: mɔ̌mndó</text></form></note>
  </entry>
  <entry id="mɔmtombolaa_1140">
    <lexical-unit><form lang="kqs"><text>mɔmtombolaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔmtombolaa_1140_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Pléiades (constellation)</text></gloss>
      <gloss lang="en"><text>Pleiades (constellation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.9.9</text></form></note>
    <note><form lang="fr"><text>Mɛlɛka cɔw mɔmtombolaa … a nanga-nsiiyo « celui qui a fait les Pléiades et Orion » (Am 5,8).</text></form></note>
  </entry>
  <entry id="mɔnɛi_1141">
    <lexical-unit><form lang="kqs"><text>mɔnɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔnɛ</text></form></variant>
    <sense id="mɔnɛi_1141_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chagrin, tristesse ; regret</text></gloss>
      <gloss lang="en"><text>grief, sorrow; regret</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sorrow, sadness; pity, remorse, regret</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 281 occurrences, first GEN.6.6; Childs 2000, p. 251: mɔ́nɛ́í</text></form></note>
  </entry>
  <entry id="mɔsillo_1142">
    <lexical-unit><form lang="kqs"><text>mɔsillo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="mɔsillo_1142_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure, turban, bonnet</text></gloss>
      <gloss lang="en"><text>headgear, turban, cap</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.28.4; Keita 1979, p. 144: Mösillo; Childs 2000, p. 253: mɔ́sílló</text></form></note>
  </entry>
  <entry id="mɔsɔŋaa_1143">
    <lexical-unit><form lang="kqs"><text>mɔsɔŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔsɔŋaa_1143_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler</text></gloss>
      <gloss lang="en"><text>gather, put together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix or put together</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhaa; Childs 2000, p. 253: mɔ̀sɔ̀ŋàá</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : mɔsɔŋa (LEV 22,28), mɔsɔŋan « se rassembler » (GEN 34,30).</text></form></note>
  </entry>
  <entry id="mɔsɔŋiaa_1144">
    <lexical-unit><form lang="kqs"><text>mɔsɔŋiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔsɔŋiaa_1144_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler (plusieurs)</text></gloss>
      <gloss lang="en"><text>gather (many)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de mɔsɔŋaa. Forme attestée dans la Bible : mɔsɔŋian « se coaliser » (JOS 10,6).</text></form></note>
  </entry>
  <entry id="mɔɔsa_1145">
    <lexical-unit><form lang="kqs"><text>mɔɔsa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔɔsu</text></form></variant>
    <sense id="mɔɔsa_1145_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'unir, se joindre ; (mɔɔsa kpeloo) avoir des rapports, coucher ensemble</text></gloss>
      <gloss lang="en"><text>come together, join; (mɔɔsa kpeloo) sleep together, have sexual relations</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold; embrace someone; put together, mix</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.21.5; Childs 2000, p. 252: mɔ̀ɔ̀sàá</text></form></note>
    <note><form lang="fr"><text>Verbe de base de mɔɔsiaa « rassembler ». mɔɔsu « serré, ajusté » (Ez 37,8) correspond à mɔ́ɔ́sú « tightly » chez Childs.</text></form></note>
  </entry>
  <entry id="mɔɔsiaa_1146">
    <lexical-unit><form lang="kqs"><text>mɔɔsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔɔsian</text></form></variant>
    <sense id="mɔɔsiaa_1146_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler ; (mɔɔsian) se rassembler</text></gloss>
      <gloss lang="en"><text>gather; (mɔɔsian) assemble, come together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 61 occurrences, first JOS.2.18</text></form></note>
  </entry>
  <entry id="mɔ́ɔ̀yɔ̀ɔ̀_1147">
    <lexical-unit><form lang="kqs"><text>mɔ́ɔ̀yɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔ́ɔ̀yɔ̀ɔ̀_1147_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(couvert de honte) totalement</text></gloss>
      <gloss lang="en"><text>utterly (put to shame)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first PSA.44.10</text></form></note>
    <note><form lang="fr"><text>Toujours avec siɛmbulan « honte » : siɛmbulan la tol naa mɔ́ɔ́yɔ̀ɔ̀ « tu nous couvres de honte » (Ps 44,10). Aussi écrit mɔ́ɔ́yɔ̀ɔ̀.</text></form></note>
  </entry>
  <entry id="mɔɛi_1148">
    <lexical-unit><form lang="kqs"><text>mɔɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɔɔn</text></form></field>
    <sense id="mɔɛi_1148_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couteau ; épée (mɔɛi cɔwve)</text></gloss>
      <gloss lang="en"><text>knife; sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 290 occurrences, first GEN.22.6; Keita 1979, p. 156: Möèi; Childs 2000, p. 253: mùɛ́í</text></form></note>
  </entry>
  <entry id="mɛiyo_1149">
    <lexical-unit><form lang="kqs"><text>mɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛi</text></form></variant>
    <variant><form lang="kqs"><text>mɛinin</text></form></variant>
    <sense id="mɛiyo_1149_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser, laisser de côté ; (mɛiyo yoomu) laisser en vie</text></gloss>
      <gloss lang="en"><text>leave, leave over; (mɛiyo yoomu) let live</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>leave; stop, cease (especially talking); arrange, agree</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.1.18; Childs 2000, p. 246: mèìyɔ́</text></form></note>
  </entry>
  <entry id="mɛlimɛlio_1150">
    <lexical-unit><form lang="kqs"><text>mɛlimɛlio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛlimɛlio_1150_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber çà et là</text></gloss>
      <gloss lang="en"><text>let fall here and there</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mèlimèlio</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : mɛlimɛli « laisser tomber (des épis) » (RUT 2,16).</text></form></note>
  </entry>
  <entry id="mɛlio_1151">
    <lexical-unit><form lang="kqs"><text>mɛlio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛli</text></form></variant>
    <variant><form lang="kqs"><text>mɛlinin</text></form></variant>
    <sense id="mɛlio_1151_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber ; pousser (un cri)</text></gloss>
      <gloss lang="en"><text>make fall; utter (a cry)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.22.24; Keita 1979, p. 110: Mèlio</text></form></note>
    <note><form lang="fr"><text>Causatif de delɔɔ ; yeelan mɛli « pousser des cris » (DEU 22,24).</text></form></note>
  </entry>
  <entry id="mɛlɛkanɔɔ_1152">
    <lexical-unit><form lang="kqs"><text>mɛlɛkanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɛlɛkaa</text></form></field>
    <variant><form lang="kqs"><text>mɛlɛkanɔ</text></form></variant>
    <sense id="mɛlɛkanɔɔ_1152_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ange</text></gloss>
      <gloss lang="en"><text>angel</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.19.17; Keita 1979, p. 150: Mèlèkanöö</text></form></note>
  </entry>
  <entry id="mɛlɛsoŋnɔ_1153">
    <lexical-unit><form lang="kqs"><text>mɛlɛsoŋnɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɛlɛsoŋnda</text></form></field>
    <variant><form lang="kqs"><text>mɛlɛsoŋaa</text></form></variant>
    <sense id="mɛlɛsoŋnɔ_1153_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chef de corvée, contremaître</text></gloss>
      <gloss lang="en"><text>taskmaster, overseer of forced labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.6.7</text></form></note>
  </entry>
  <entry id="mɛmɛan_1154">
    <lexical-unit><form lang="kqs"><text>mɛmɛan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="mɛmɛan_1154_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>larmes</text></gloss>
      <gloss lang="en"><text>tears</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first 2SA.13.36; Keita 1979, p. 132: Mèmèan; Childs 2000, p. 247: mɛ́míáŋ</text></form></note>
  </entry>
  <entry id="mɛnalanndo_1155">
    <lexical-unit><form lang="kqs"><text>mɛnalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛnalan</text></form></variant>
    <sense id="mɛnalanndo_1155_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire jurer ; promettre par serment (à quelqu'un)</text></gloss>
      <gloss lang="en"><text>make someone swear; swear (to someone), promise on oath</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.29.13; Childs 2000, p. 244: mènàlló</text></form></note>
    <note><form lang="fr"><text>Dérivé de mɛnanndo « jurer ». lɛŋnde ya mɛnalan Abraham « le pays que j'ai juré de donner à Abraham » (Ex 6,8).</text></form></note>
  </entry>
  <entry id="mɛnanndo_1156">
    <lexical-unit><form lang="kqs"><text>mɛnanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛnan</text></form></variant>
    <variant><form lang="kqs"><text>mɛnannin</text></form></variant>
    <sense id="mɛnanndo_1156_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jurer, prêter serment ; serment</text></gloss>
      <gloss lang="en"><text>swear, take an oath; oath</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 38 occurrences, first GEN.26.33; Childs 2000, p. 244: mènǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de mɛna « maudire ». Bɛɛr-Seba … « Soon kólaa mɛnanndo » « le puits du serment » (Gn 26,33) ; sendí n mɛnan-ndo « le serment que tu as juré » (Gn 24,8).</text></form></note>
  </entry>
  <entry id="mɛndul_1157">
    <lexical-unit><form lang="kqs"><text>mɛndul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛndul_1157_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allumer (le feu)</text></gloss>
      <gloss lang="en"><text>kindle (a fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>light, build a fire</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.35.3; Childs 2000, p. 247: mèndùlló</text></form></note>
  </entry>
  <entry id="mɛngɛlaa_1158">
    <lexical-unit><form lang="kqs"><text>mɛngɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛngɛlaa_1158_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guet, poste de guet</text></gloss>
      <gloss lang="en"><text>lookout, watch</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first NUM.23.14</text></form></note>
  </entry>
  <entry id="mɛnndan_1159">
    <lexical-unit><form lang="kqs"><text>mɛnndan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛmma</text></form></variant>
    <sense id="mɛnndan_1159_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>eau</text></gloss>
      <gloss lang="en"><text>water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 444 occurrences, first GEN.1.2; Keita 1979, p. 155: Mènndan; Childs 2000, p. 248: mɛ̀ŋndáŋ</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi mɛmma tuwvan « eau chaude » et mɛmma ɲuluan « eau fraîche ».</text></form></note>
  </entry>
  <entry id="mɛɛ_1160">
    <lexical-unit><form lang="kqs"><text>mɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛɛ_1160_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>quand ; comme</text></gloss>
      <gloss lang="en"><text>when; as, like</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'since, after, while; except, unless'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4301 occurrences, first GEN.1; Childs 2000, p. 244: mɛ̀ɛ́</text></form></note>
  </entry>
  <entry id="mɛɛlaa_1161">
    <lexical-unit><form lang="kqs"><text>mɛɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlaala</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlaalan</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlaalen</text></form></variant>
    <sense id="mɛɛlaa_1161_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dernier, final</text></gloss>
      <gloss lang="en"><text>last, final</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.18.32; Childs 2000, p. 245: mèèlà-</text></form></note>
    <note><form lang="fr"><text>paale mɛɛlaalen « le dernier jour » (Ne 8,18) ; kpundɛ mɛɛlaa « une dernière plaie » (Ex 11,1).</text></form></note>
  </entry>
  <entry id="mɛɛlen_1162">
    <lexical-unit><form lang="kqs"><text>mɛɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="mɛɛlen_1162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sein</text></gloss>
      <gloss lang="en"><text>breast</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>breast, breast milk; pus</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.21.8; Keita 1979, p. 132: Mèèlen; Childs 2000, p. 246: mɛ̀ɛ̀yáŋ</text></form></note>
  </entry>
  <entry id="mɛɛloo_1163">
    <lexical-unit><form lang="kqs"><text>mɛɛloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlu</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlunin</text></form></variant>
    <sense id="mɛɛloo_1163_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, s'achever, arriver au bout</text></gloss>
      <gloss lang="en"><text>end, finish, come to an end</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also stop, reach an end or boundary</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2CH.35.26; Childs 2000, p. 245: mèèlòó</text></form></note>
    <note><form lang="fr"><text>kandɔɔ a … kɔ mɛɛlu a … « en commençant par … et en finissant par … » (Gn 44,12) ; lɛŋnden le mɛɛlu-a « les extrémités de la terre » (Dt 28,49). Voir mɛɛlulan « fin ».</text></form></note>
  </entry>
  <entry id="mɛɛlulan_1164">
    <lexical-unit><form lang="kqs"><text>mɛɛlulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlula</text></form></variant>
    <sense id="mɛɛlulan_1164_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fin, dernier moment ; (o mɛɛlulan) à la fin, finalement</text></gloss>
      <gloss lang="en"><text>end, last part; (o mɛɛlulan) finally, afterwards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 166 occurrences, first GEN.30.21</text></form></note>
  </entry>
  <entry id="mɛɛnaa_1165">
    <lexical-unit><form lang="kqs"><text>mɛɛnaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛɛnaa_1165_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maudire</text></gloss>
      <gloss lang="en"><text>curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mèènaa</text></form></note>
    <note><form lang="fr"><text>La Bible emploie mɛɛniaa pour « maudire ».</text></form></note>
  </entry>
  <entry id="mɛɛndanndo_1166">
    <lexical-unit><form lang="kqs"><text>mɛɛndanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛndan</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛndannin</text></form></variant>
    <sense id="mɛɛndanndo_1166_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder, observer, examiner</text></gloss>
      <gloss lang="en"><text>look, watch, observe, inspect</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>look into deeply, ponder, scrutinize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.24.21; Childs 2000, p. 245: mèèndǎŋndó</text></form></note>
    <note><form lang="fr"><text>Verbe de base de mɛɛndianndo. Mɛɛndan-ndɔ « regarde ! » (Gn 15,5) ; o … mɛɛndanndo « pour espionner » (Gn 42,12).</text></form></note>
  </entry>
  <entry id="mɛɛndianndo_1167">
    <lexical-unit><form lang="kqs"><text>mɛɛndianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛndian</text></form></variant>
    <sense id="mɛɛndianndo_1167_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder (autour), examiner, observer</text></gloss>
      <gloss lang="en"><text>look around, examine, observe</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of mèèndăŋndɔ́ 'look into': look around, ponder, scrutinize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first LEV.13.11; Childs 2000, p. 245: mèèndìàŋndɔ́</text></form></note>
  </entry>
  <entry id="mɛɛniaa_1168">
    <lexical-unit><form lang="kqs"><text>mɛɛniaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛnian</text></form></variant>
    <sense id="mɛɛniaa_1168_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maudire ; maudire plusieurs fois (Keita)</text></gloss>
      <gloss lang="en"><text>curse; curse repeatedly (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.2.8; Keita 1979, p. 110: Mèèniaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de mɛɛnaa selon Keita ; dans la Bible, sens simple « maudire » (1KI 2,8 ; JAS 3,9).</text></form></note>
  </entry>
  <entry id="n_1169">
    <lexical-unit><form lang="kqs"><text>n</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="n_1169_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>nous (sujet) ; tu (relative, question)</text></gloss>
      <gloss lang="en"><text>we (subject); you (sg., in relatives and questions)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>we; also the ordinary 2sg subject 'you'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7904 occurrences, first GEN.1.26; Childs 2000, p. 269: ŋ̀</text></form></note>
  </entry>
  <entry id="naa_1170">
    <lexical-unit><form lang="kqs"><text>naa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="naa_1170_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>nous (indépendant) ; notre</text></gloss>
      <gloss lang="en"><text>us (independent); our</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4651 occurrences, first GEN.1.26; Childs 2000, p. 257: náá</text></form></note>
  </entry>
  <entry id="nàà_1171">
    <lexical-unit><form lang="kqs"><text>nàà</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>naalan</text></form></field>
    <sense id="nàà_1171_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie</text></gloss>
      <gloss lang="en"><text>illness, disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.1 Sick"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4651 occurrences, first GEN.1.26; Keita 1979, p. 161: Naa; Childs 2000, p. 257: nàá</text></form></note>
    <note><form lang="fr"><text>La Bible écrit en général nàà avec tons, ce qui le distingue de naa « nous ».</text></form></note>
  </entry>
  <entry id="nàà ciŋnde_1172">
    <lexical-unit><form lang="kqs"><text>nàà ciŋnde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà ciŋnde_1172_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mal de dents</text></gloss>
      <gloss lang="en"><text>toothache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa ntyinndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; Keita écrit Naa ntyinndo. Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="nàà dembe_1173">
    <lexical-unit><form lang="kqs"><text>nàà dembe</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nàà dembe_1173_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mal de ventre, maladie des entrailles</text></gloss>
      <gloss lang="en"><text>stomach ache, bowel disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa demboo</text></form></note>
  </entry>
  <entry id="nàà malɔɔ_1174">
    <lexical-unit><form lang="kqs"><text>nàà malɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="nàà malɔɔ_1174_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie du sommeil</text></gloss>
      <gloss lang="en"><text>sleeping sickness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa malöö</text></form></note>
    <note><form lang="fr"><text>Keita : « -"- de sommeil » ; malɔɔ est attesté dans la Bible, mais dans un autre sens.</text></form></note>
  </entry>
  <entry id="nàà siaŋaa_1175">
    <lexical-unit><form lang="kqs"><text>nàà siaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nàà siaŋaa_1175_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèpre</text></gloss>
      <gloss lang="en"><text>leprosy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: naa sianhaa</text></form></note>
  </entry>
  <entry id="naamu_1176">
    <lexical-unit><form lang="kqs"><text>naamu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>naamula</text></form></field>
    <sense id="naamu_1176_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coutume, tradition</text></gloss>
      <gloss lang="en"><text>custom, tradition</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first 1KI.18.28</text></form></note>
  </entry>
  <entry id="naanɔɔ_1177">
    <lexical-unit><form lang="kqs"><text>naanɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="naanɔɔ_1177_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>août</text></gloss>
      <gloss lang="en"><text>August</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around August (literally 'his sickness')</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Naanöö; Childs 2000, p. 257: nààndɔ́ɔ</text></form></note>
  </entry>
  <entry id="nákà-nàkà_1178">
    <lexical-unit><form lang="kqs"><text>nákà-nàkà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nákà-nàkà_1178_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(trembler) de tout son corps, violemment</text></gloss>
      <gloss lang="en"><text>(tremble) violently, all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first 1SA.31.3</text></form></note>
    <note><form lang="fr"><text>Avec ɲiiya « trembler » : diallon ɲiiya ya nákà-nàkà « tout mon corps tremble » (Jb 21,6).</text></form></note>
  </entry>
  <entry id="nakɔɔ_1179">
    <lexical-unit><form lang="kqs"><text>nakɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nakɔlan</text></form></field>
    <variant><form lang="kqs"><text>nakɔ</text></form></variant>
    <variant><form lang="kqs"><text>nakɔla</text></form></variant>
    <sense id="nakɔɔ_1179_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jardin, plantation ; jardin, champ cultivé, plantation</text></gloss>
      <gloss lang="en"><text>garden, plantation ; garden, cultivated field, plantation</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>garden (Guéckédou dialect, borrowed from Maninka)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.2; Keita 1979, p. 142: Naaköö; Childs 2000, p. 258: nákóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit une voyelle longue (Naaköö) ; la Bible écrit nakɔɔ (le jardin d'Éden).</text></form></note>
  </entry>
  <entry id="nambaa_1180">
    <lexical-unit><form lang="kqs"><text>nambaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="nambaa_1180_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>glisser</text></gloss>
      <gloss lang="en"><text>slip, slide</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Nambaa</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence dans la Bible (JER 32,24), au sens incertain (« escalader » ?).</text></form></note>
  </entry>
  <entry id="namtalen_1181">
    <lexical-unit><form lang="kqs"><text>namtalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="namtalen_1181_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut physique, infirmité ; paralysie</text></gloss>
      <gloss lang="en"><text>physical defect, infirmity; paralysis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.22.25; Keita 1979, p. 162: Namtalen; Childs 2000, p. 258: nâmtàá</text></form></note>
    <note><form lang="fr"><text>Keita : « paralysie » ; dans la Bible, « défaut » d'un animal (Dt 15,21).</text></form></note>
  </entry>
  <entry id="nanu_1182">
    <lexical-unit><form lang="kqs"><text>nanu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nanu_1182_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ici</text></gloss>
      <gloss lang="en"><text>here</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 506 occurrences, first GEN.15.16; Childs 2000, p. 258: nánùŋ</text></form></note>
  </entry>
  <entry id="nanɔɔ_1183">
    <lexical-unit><form lang="kqs"><text>nanɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nan</text></form></variant>
    <variant><form lang="kqs"><text>nannin</text></form></variant>
    <variant><form lang="kqs"><text>nennin</text></form></variant>
    <sense id="nanɔɔ_1183_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tirer</text></gloss>
      <gloss lang="en"><text>pull, draw</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pull, suck, drag</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.34.3; Keita 1979, p. 114: Nanöö; Childs 2000, p. 258: nànɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Radical en e de Keita : nen ; nennin (JDG 4,7).</text></form></note>
  </entry>
