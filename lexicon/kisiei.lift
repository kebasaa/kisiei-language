  </entry>
  <entry id="imamaa_1349">
    <lexical-unit><form lang="kqs"><text>imamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>imama</text></form></variant>
    <sense id="imamaa_1349_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>descendance, générations</text></gloss>
