    <note><form lang="fr"><text>Emprunt au mandé (bandi, mendé).</text></form></note>
  </entry>
  <entry id="kiilanɔ_1346">
    <lexical-unit><form lang="kqs"><text>kiilanɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kiilaa</text></form></field>
    <variant><form lang="kqs"><text>kiila</text></form></variant>
    <sense id="kiilanɔ_1346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>messager, envoyé ; apôtre</text></gloss>
