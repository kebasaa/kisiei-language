  <entry id="kengela_1329">
    <lexical-unit><form lang="kqs"><text>kengela</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kengelan</text></form></variant>
    <variant><form lang="kqs"><text>kengelɛi</text></form></variant>
    <variant><form lang="kqs"><text>kengelɛila</text></form></variant>
    <sense id="kengela_1329_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se dessécher, durcir ; se raidir (main) ; (kengelɛi) sec, desséché</text></gloss>
      <gloss lang="en"><text>dry up, harden; stiffen, wither (hand); (kengelɛi) dry, dried out</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be dry; cook until dry; be thin; be so cold as to shiver, have a fit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.28.23; Childs 2000, p. 156: kèŋgèlàá</text></form></note>
    <note><form lang="fr"><text>lɛŋnden … le kengela kekew maa icilin « la terre sera dure comme le fer » (DEU.28.23) ; mí ba … kengela « sa main se dessécha » (1KI.13.4) ; bulu … va o kengelɛi kekew « le pain était tout sec » (JOS.9.5).</text></form></note>
  </entry>
