      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>continuer, ne pas cesser (de)</text></gloss>
      <gloss lang="en"><text>continue, keep on</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first NUM.33.3</text></form></note>
  </entry>
  <entry id="nííyó_2439">
    <lexical-unit><form lang="kqs"><text>nííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>nííláŋ</text></form></field>
    <variant><form lang="kqs"><text>nìíyó</text></form></variant>
    <sense id="nííyó_2439_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lisses (fils du métier à tisser)</text></gloss>
      <gloss lang="en"><text>heddles (wires of a loom)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 263: nííyó</text></form></note>
    <note><form lang="fr"><text>Emprunt probable au mandé (vaï, mendé nini).</text></form></note>
  </entry>
  <entry id="níkènè_2440">
    <lexical-unit><form lang="kqs"><text>níkènè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="níkènè_2440_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>salutation du matin (surtout chez les anciens)</text></gloss>
      <gloss lang="en"><text>morning greeting (mostly used by old people)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 263: níkènè</text></form></note>
    <note><form lang="fr"><text>Emprunt au mandé.</text></form></note>
  </entry>
  <entry id="niko_2441">
    <lexical-unit><form lang="kqs"><text>niko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="niko_2441_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>alors, maintenant ; (après un impératif) donc, je te prie</text></gloss>
      <gloss lang="en"><text>then, now; (after an imperative) please, do</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>now, right away, right then</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 448 occurrences, first GEN.3.17; Childs 2000, p. 263: níkó</text></form></note>
    <note><form lang="fr"><text>Mí Mɛlɛka dimul niko vanapɔnɔɔ aa « puis le Seigneur dit à l'homme » (Gn 3,17) ; Yɔngu ya niko laa nuu « donne-moi donc ma femme » (Gn 29,21).</text></form></note>
  </entry>
  <entry id="nilen_2442">
    <lexical-unit><form lang="kqs"><text>nilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nilan</text></form></field>
    <variant><form lang="kqs"><text>nile</text></form></variant>
    <sense id="nilen_2442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oreille</text></gloss>
      <gloss lang="en"><text>ear</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 134 occurrences, first GEN.12.19; Keita 1979, p. 132: Nilen; Childs 2000, p. 263: nìléŋ</text></form></note>
  </entry>
  <entry id="nímí-nímí_2443">
    <lexical-unit><form lang="kqs"><text>nímí-nímí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="nímí-nímí_2443_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bon, sucré (souvent par plaisanterie)</text></gloss>
      <gloss lang="en"><text>tasty, sweet (often jokingly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 263: nímí-nímí</text></form></note>
  </entry>
  <entry id="nimɔɔ_2444">
    <lexical-unit><form lang="kqs"><text>nimɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="nimɔɔ_2444_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trompe d'éléphant</text></gloss>
      <gloss lang="en"><text>elephant's trunk</text></gloss>
