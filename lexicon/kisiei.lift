  <entry id="sanaa_4398">
    <lexical-unit><form lang="kqs"><text>sanaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sanaa_4398_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout droit, directement ; droit (adj.)</text></gloss>
      <gloss lang="en"><text>straight, straight ahead, directly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.30.11; Paulme 1964, p. 88: sana, sanda; Childs 2000, p. 320: sánáá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 88 : nɛ sandā « la route est droite » ; sunde sandala « bâton droit ».</text></form></note>
  </entry>
  <entry id="sandaa_4399">
    <lexical-unit><form lang="kqs"><text>sandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sandaala</text></form></variant>
    <variant><form lang="kqs"><text>sandaalan</text></form></variant>
    <sense id="sandaa_4399_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>juste, droit ; (dɛnɛ sandaa) la justice ; honnête, de bon caractère</text></gloss>
      <gloss lang="en"><text>righteous, just; (dɛnɛ sandaa) righteousness; honest, of good character</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 669 occurrences, first GEN.6.9; Lexique kissi–français, p. 46: sandaa</text></form></note>
  </entry>
  <entry id="sandaa_4400">
    <lexical-unit><form lang="kqs"><text>sandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sandaa_4400_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>histoire, parabole, proverbe</text></gloss>
      <gloss lang="en"><text>story, parable, proverb</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sandaa</text></form></note>
    <note><form lang="fr"><text>Homographe de sandaa « juste ».</text></form></note>
  </entry>
  <entry id="sandamɔlinɔɔ_4401">
    <lexical-unit><form lang="kqs"><text>sandamɔlinɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sandamɔlinɔɔ_4401_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gendarme</text></gloss>
      <gloss lang="en"><text>gendarme, policeman</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 360: Sandamölinöö</text></form></note>
    <note><form lang="fr"><text>Emprunt au français, proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sandanɔɔ_4402">
    <lexical-unit><form lang="kqs"><text>sandanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sandanɔɔ_4402_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit poisson rouge</text></gloss>
      <gloss lang="en"><text>small red fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sandanɔɔ</text></form></note>
  </entry>
  <entry id="sande yoovo_4403">
    <lexical-unit><form lang="kqs"><text>sande yoovo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sande yoovo_4403_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hibiscus (espèce)</text></gloss>
      <gloss lang="en"><text>kind of hibiscus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 88: sandé yooʊo</text></form></note>
    <note><form lang="fr"><text>Hibiscus asper (Malvacées). Lecture du dernier mot incertaine.</text></form></note>
  </entry>
  <entry id="sandei_4404">
    <lexical-unit><form lang="kqs"><text>sandei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="sandei_4404_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>justice, droiture, équité ; honnêteté, intégrité</text></gloss>
      <gloss lang="en"><text>justice, righteousness, equity; honesty, integrity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.18.19; Terminologie (idéologie), n° 337: Sandei</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, idéologie n° 337, 370) : « honnêteté, intégrité » (aussi kpafiiyo). Académie des langues (terminologie, idéologie n° 410) : « loyauté ».</text></form></note>
  </entry>
  <entry id="sandei_4405">
    <lexical-unit><form lang="kqs"><text>sandei</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sandei_4405_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>brûler, flamber, briller (feu, lampe)</text></gloss>
      <gloss lang="en"><text>burn, blaze, shine (fire, lamp)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>burn, blaze, burst into flame</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.18.19; Childs 2000, p. 320: sàndèí</text></form></note>
    <note><form lang="fr"><text>Homographe de sandei « justice ». yinnden cɔu sandei vulɛi-vulɛi o bɔɔ nin « le feu flambait dans le buisson » (EXO.3.2) ; mi fitinalan la va sandei idii a icɔl « que les lampes brûlent jour et nuit » (EXO.27.20).</text></form></note>
  </entry>
  <entry id="sandiaa_4406">
    <lexical-unit><form lang="kqs"><text>sandiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sandia</text></form></variant>
    <sense id="sandiaa_4406_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rejeter ; étirer, redresser ; peigner</text></gloss>
      <gloss lang="en"><text>throw out; stretch out straight; comb</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sandiaa/ sandia; Childs 2000, p. 316: sààndìá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 46 (« se peigner »).</text></form></note>
  </entry>
  <entry id="sandiasayo_4407">
    <lexical-unit><form lang="kqs"><text>sandiasayo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sandiasayo_4407_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mauvaise herbe (espèce), chiendent (?)</text></gloss>
      <gloss lang="en"><text>kind of weed, couch grass (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 88: sandyasayo</text></form></note>
    <note><form lang="fr"><text>Paulme : = sandiyo ?</text></form></note>
  </entry>
  <entry id="sàndíkìnɔ̀ɔ́_4408">
    <lexical-unit><form lang="kqs"><text>sàndíkìnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sàndíkìá</text></form></field>
    <sense id="sàndíkìnɔ̀ɔ́_4408_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>adjoint du chef ; assistante de la première épouse</text></gloss>
      <gloss lang="en"><text>vice-chief; assistant to the chief's head wife</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 320: sàndíkìnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sandiyo_4409">
    <lexical-unit><form lang="kqs"><text>sandiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sandiyo_4409_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe des rizières (espèce)</text></gloss>
      <gloss lang="en"><text>kind of grass of rice paddies</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 88: sandiyo</text></form></note>
    <note><form lang="fr"><text>Paulme : remède (nyuruwã) du yallo à Ouendé.</text></form></note>
  </entry>
  <entry id="sando_4410">
    <lexical-unit><form lang="kqs"><text>sando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>saanda</text></form></field>
    <sense id="sando_4410_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>magnan (fourmi)</text></gloss>
      <gloss lang="en"><text>driver ant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 88: sando, pl. sānda</text></form></note>
    <note><form lang="fr"><text>Paulme : sando kil nɔm « le magnan t'a mordu ». Ne pas confondre avec saŋndo « lièvre ».</text></form></note>
  </entry>
  <entry id="sandoo_4411">
    <lexical-unit><form lang="kqs"><text>sandoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sandoo_4411_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>légume-feuille acide (comme le chou de Bruxelles) ; plante dont on fait un jus aigre</text></gloss>
      <gloss lang="en"><text>sour leafy vegetable (like Brussels sprouts); plant used to make a sour juice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sandoo; Childs 2000, p. 320: sàndòó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 46. Pluriel en kissi du Sud (Childs 2000) : sàndùé.</text></form></note>
  </entry>
  <entry id="sandu_4412">
    <lexical-unit><form lang="kqs"><text>sandu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sandunin</text></form></variant>
    <sense id="sandu_4412_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être droit, être juste ; paraître bon (à qqn)</text></gloss>
      <gloss lang="en"><text>be upright, be right; seem right (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be straight, be honest; also be bright, blaze (lamp, fire)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first NUM.11.3; Lexique kissi–français, p. 46: sandu; Terminologie (idéologie), n° 389: Tonya, sandu; Childs 2000, p. 320: sàndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Verbe correspondant à l'adjectif sandaa ; vana sandu-o « l'homme juste » (Ez 18,5) ; mɛɛ o sandu nɔm o hɔl « comme il te semble bon » (Jos 9,25). En Nb 11,3, yinnde … le sandu vannda tɛɛn « le feu brûla parmi eux » : sens « flamber », comme en kissi du Sud. Lexique kissi–français, p. 46 : forme longue sandɔɔ « être droit ». Académie des langues (terminologie, idéologie n° 389, 408) : « juste » (aussi toɲa) ; o sandu « loyal ».</text></form></note>
  </entry>
  <entry id="sanga-sanga_4413">
    <lexical-unit><form lang="kqs"><text>sanga-sanga</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sanga-sanga_4413_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>échelle</text></gloss>
      <gloss lang="en"><text>ladder</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sanga-sanga</text></form></note>
    <note><form lang="fr"><text>Homographe : dans la Bible, sanga-sanga (LEV.20.19) a un autre sens (« subir, porter (sa faute) »).</text></form></note>
  </entry>
  <entry id="sangaa_4414">
    <lexical-unit><form lang="kqs"><text>sangaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sanga</text></form></variant>
    <variant><form lang="kqs"><text>sanganin</text></form></variant>
    <sense id="sangaa_4414_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fatigué, peiner ; (sanga) fatigue, lassitude, ennui ; fardeau, douleur</text></gloss>
      <gloss lang="en"><text>be tired, toil; (sanga) tiredness, weariness; burden, pain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 258 occurrences, first GEN.3.17; Keita 1979, p. 113: Sangaa; Paulme 1964, p. 88: saŋa; Lexique kissi–français, p. 46: sangaa</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : sanga « l'ennui, la lassitude, le fardeau, la douleur ». Paulme 1964, p. 88-89 : i saŋa « je suis fatigué » ; saŋa bi ya « la fatigue m'a attrapé » ; ɔ saŋi ya « il me fatigue ».</text></form></note>
  </entry>
  <entry id="sangala lekɛlɛmasaa_4415">
    <lexical-unit><form lang="kqs"><text>sangala lekɛlɛmasaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sangala lekɛlɛmasaa_4415_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épopée</text></gloss>
      <gloss lang="en"><text>epic</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 298: Sangala lekèlèmasaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. kɛlɛmasaa « chef de guerre ».</text></form></note>
  </entry>
  <entry id="sangalaa_4416">
    <lexical-unit><form lang="kqs"><text>sangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sangala</text></form></variant>
    <variant><form lang="kqs"><text>sangalanin</text></form></variant>
    <sense id="sangalaa_4416_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier, exalter</text></gloss>
      <gloss lang="en"><text>praise, glorify, exalt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>praise, esp. by singing; also tie logs together to make a ladder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first JDG.16.24; Childs 2000, p. 321: sàŋàlàá</text></form></note>
    <note><form lang="fr"><text>À distinguer de sangalan « peines, souffrances » (Gn 3,16), de la famille de sangaa « peiner ».</text></form></note>
  </entry>
  <entry id="sangalanndo_4417">
    <lexical-unit><form lang="kqs"><text>sangalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sangalanndo_4417_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vanter, se glorifier</text></gloss>
      <gloss lang="en"><text>boast, glorify oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.13.19; Childs 2000, p. 321: sàŋàlăŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de sangalaa « louer ».</text></form></note>
  </entry>
  <entry id="sanganndo_4418">
    <lexical-unit><form lang="kqs"><text>sanganndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sangan</text></form></variant>
    <sense id="sanganndo_4418_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se fatiguer, peiner</text></gloss>
      <gloss lang="en"><text>tire oneself, labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.127.1; Keita 1979, p. 113: Sanganndo; Lexique kissi–français, p. 46: sangannndo/ sangan</text></form></note>
    <note><form lang="fr"><text>Moyen de sangaa (PSA 127,1).</text></form></note>
  </entry>
  <entry id="sangboo_4419">
    <lexical-unit><form lang="kqs"><text>sangboo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sangboo_4419_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>razzia</text></gloss>
      <gloss lang="en"><text>raid</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 515: Sangboo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sangiaa_4420">
    <lexical-unit><form lang="kqs"><text>sangiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sangia</text></form></variant>
    <sense id="sangiaa_4420_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fatiguer, faire peiner ; ennuyer souvent, accabler</text></gloss>
      <gloss lang="en"><text>tire, make toil; pester, overwhelm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sangiaa; Lexique kissi–français, p. 46: sangiaa/ sangia; Sandara Kisia, fable 6: saŋgia</text></form></note>
    <note><form lang="fr"><text>Causatif de sangaa. Lexique kissi–français, p. 46 : « ennuyer souvent, accabler ». Sandara Kissia, fables 6, 7, 20 : « tourmenter, harceler » (Wanlana pum saŋgia pɔnɔ ndɔ « une femme tourmentait son mari »).</text></form></note>
  </entry>
  <entry id="sangio_4421">
    <lexical-unit><form lang="kqs"><text>sangio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sangio_4421_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peigne ; peigne en bois à trois dents (de femme)</text></gloss>
      <gloss lang="en"><text>comb; three-toothed wooden comb (women's)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Sangio; Paulme 1964, p. 89: saŋiyo, saŋira; Lexique kissi–français, p. 46: sangio; Childs 2000, p. 322: sáŋíó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 89 : saŋiyo, pl. saŋira « peigne en bois, à trois dents (usage féminin) ».</text></form></note>
  </entry>
  <entry id="sangio_4422">
    <lexical-unit><form lang="kqs"><text>sangio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sangio_4422_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson blanc (bon à manger)</text></gloss>
      <gloss lang="en"><text>kind of white fish (good to eat)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sangio</text></form></note>
    <note><form lang="fr"><text>Homographe de sangio « peigne ».</text></form></note>
  </entry>
  <entry id="sangɔɔ_4423">
    <lexical-unit><form lang="kqs"><text>sangɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sangɔɔ_4423_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tortue</text></gloss>
      <gloss lang="en"><text>tortoise</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.11.30; Keita 1979, p. 137: Sangöö; Lexique kissi–français, p. 46: sangɔɔ; Childs 2000, p. 322: sàŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sankpaa_4424">
    <lexical-unit><form lang="kqs"><text>sankpaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sankpaa_4424_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour (plus fin que le yinbɔ) ; tambour tripode</text></gloss>
      <gloss lang="en"><text>kind of drum (thinner than the yinbɔ); three-legged drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 87: sangba, sanyba, pl. sanybara; Lexique kissi–français, p. 46: sankpaa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 87 : « tambour tripode, à attache indirecte ».</text></form></note>
  </entry>
  <entry id="sannden_4425">
    <lexical-unit><form lang="kqs"><text>sannden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="sannden_4425_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante de forêt à feuilles lisses (remède contre la toux)</text></gloss>
      <gloss lang="en"><text>forest plant with smooth leaves (cough remedy)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sannden</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation à la définition.</text></form></note>
  </entry>
  <entry id="sànsìó_4426">
    <lexical-unit><form lang="kqs"><text>sànsìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sànsìó_4426_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer, échanger</text></gloss>
      <gloss lang="en"><text>change, exchange</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sànsìó</text></form></note>
  </entry>
  <entry id="sánsíó_4427">
    <lexical-unit><form lang="kqs"><text>sánsíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sánsíláŋ</text></form></field>
    <sense id="sánsíó_4427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remplacement, objet donné en échange</text></gloss>
      <gloss lang="en"><text>replacement, object given in exchange</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sánsíó</text></form></note>
  </entry>
  <entry id="santal_4428">
    <lexical-unit><form lang="kqs"><text>santal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="santal_4428_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>santal (bois précieux)</text></gloss>
      <gloss lang="en"><text>sandalwood, almug wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.10.11</text></form></note>
    <note><form lang="fr"><text>Emprunt ; pɛngɛn yɔm santal « bois de santal ».</text></form></note>
  </entry>
  <entry id="sao_4429">
    <lexical-unit><form lang="kqs"><text>sao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sao_4429_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>testament ; désir, volonté</text></gloss>
      <gloss lang="en"><text>will, testament; wish</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sao</text></form></note>
  </entry>
  <entry id="sapioo_4430">
    <lexical-unit><form lang="kqs"><text>sapioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sapioo_4430_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>décor</text></gloss>
      <gloss lang="en"><text>decor, scenery</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 82: Sapioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sapoo_4431">
    <lexical-unit><form lang="kqs"><text>sapoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sapoo_4431_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chapeau</text></gloss>
      <gloss lang="en"><text>hat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sapoo</text></form></note>
    <note><form lang="fr"><text>Emprunt (français chapeau).</text></form></note>
  </entry>
  <entry id="sarduan_4432">
    <lexical-unit><form lang="kqs"><text>sarduan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sarduan_4432_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sardoine (pierre précieuse)</text></gloss>
      <gloss lang="en"><text>sardius, carnelian (gem)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.28.17</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="sasaa_4433">
    <lexical-unit><form lang="kqs"><text>sasaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sasaa_4433_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>initiation des femmes (en forêt, trois à six mois : tatouage, danse, chant, secrets)</text></gloss>
      <gloss lang="en"><text>women's initiation (in the forest, three to six months: scarification, dance, song, secrets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sasaa</text></form></note>
  </entry>
  <entry id="sasaa_4434">
    <lexical-unit><form lang="kqs"><text>sasaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sasaa_4434_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corbeille pour transporter les poulets ; petit panier pour les sacrifices</text></gloss>
      <gloss lang="en"><text>basket for carrying chickens; small basket for sacrifices</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sasa; Lexique kissi–français, p. 47: sasaa</text></form></note>
    <note><form lang="fr"><text>Homographe de sasaa « initiation des femmes ». Paulme 1964, p. 90 : sasa « petit panier servant aux sacrifices, cage à poules ».</text></form></note>
  </entry>
  <entry id="sasan_4435">
    <lexical-unit><form lang="kqs"><text>sasan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sasan_4435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>salive qui coule pendant le sommeil</text></gloss>
      <gloss lang="en"><text>drool (saliva running during sleep)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sasan</text></form></note>
  </entry>
  <entry id="sasanndo_4436">
    <lexical-unit><form lang="kqs"><text>sasanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sasan</text></form></variant>
    <sense id="sasanndo_4436_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sécher en partie</text></gloss>
      <gloss lang="en"><text>dry partly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sasanndo/ sasan</text></form></note>
  </entry>
  <entry id="sàsàŋndó_4437">
    <lexical-unit><form lang="kqs"><text>sàsàŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sàsàŋndó_4437_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sécher (linge), durcir (ciment)</text></gloss>
      <gloss lang="en"><text>dry off (clothes), harden (cement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàsàŋndó</text></form></note>
  </entry>
  <entry id="sàsííyó_4438">
    <lexical-unit><form lang="kqs"><text>sàsííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàsííyó_4438_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marmite</text></gloss>
      <gloss lang="en"><text>cooking pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàsííyó</text></form></note>
  </entry>
  <entry id="sasun_4439">
    <lexical-unit><form lang="kqs"><text>sasun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sasɔnndo</text></form></variant>
    <sense id="sasun_4439_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramper ; se traîner péniblement, se tirer</text></gloss>
      <gloss lang="en"><text>creep, crawl; drag oneself along</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.7.8; Paulme 1964, p. 99: susyã, susyando; Lexique kissi–français, p. 47: sasɔnndo/ sasun</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 99 : a susyã lɛn « tu as rampé par terre » ; kɛwo susya lɛn « le serpent a rampé par terre ».</text></form></note>
  </entry>
  <entry id="sasuo_4440">
    <lexical-unit><form lang="kqs"><text>sasuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sasuo_4440_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peau de loutre renfermant le mɔsɔ</text></gloss>
      <gloss lang="en"><text>otter skin holding the mɔsɔ charm</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sasuo</text></form></note>
  </entry>
  <entry id="sasɔɔ_4441">
    <lexical-unit><form lang="kqs"><text>sasɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sasu</text></form></variant>
    <sense id="sasɔɔ_4441_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>traîner (par terre) ; tirer</text></gloss>
      <gloss lang="en"><text>drag (along the ground); pull</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slide, drag</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first NAM.3.6; Lexique kissi–français, p. 47: sasɔɔ/ sasu; Childs 2000, p. 322: sàsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>má sasu ndu o kobio kɔɔli « ils le traînèrent hors de la ville » (ACT.14.19) ; mì tunnda sasu nda « que les chiens les traînent » (JER.15.3) ; I co nɔm sasɔɔ o loolio nin (NAM.3.6). Voir sasun « ramper ».</text></form></note>
  </entry>
  <entry id="sàtòó_4442">
    <lexical-unit><form lang="kqs"><text>sàtòó</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sàtòó_4442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante comestible très acide (cuisine)</text></gloss>
      <gloss lang="en"><text>very sour edible plant (used in cooking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàtòó</text></form></note>
  </entry>
  <entry id="sauma pɔmbɔan_4443">
    <lexical-unit><form lang="kqs"><text>sauma pɔmbɔan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="sauma pɔmbɔan_4443_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>citron vert</text></gloss>
      <gloss lang="en"><text>lime</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sauma pɔnbɔan</text></form></note>
    <note><form lang="fr"><text>Lexique : sauma pɔnbɔan. Le Lexique écrit saulen pour siawlen « orange » : la graphie biblique serait peut-être siawma pɔmbɔan (« petites oranges »). À confirmer.</text></form></note>
  </entry>
  <entry id="sàùsàù_4444">
    <lexical-unit><form lang="kqs"><text>sàùsàù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sàùsàù_4444_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>piquant, épicé, poivré (qui brûle)</text></gloss>
      <gloss lang="en"><text>spicy, peppery, stinging</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàùsàù</text></form></note>
    <note><form lang="fr"><text>Aussi employé comme adjectif.</text></form></note>
  </entry>
  <entry id="sàùwó_4445">
    <lexical-unit><form lang="kqs"><text>sàùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàùwó_4445_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>raison, motif</text></gloss>
      <gloss lang="en"><text>reason</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàùwó</text></form></note>
  </entry>
  <entry id="sava lebollo_4446">
    <lexical-unit><form lang="kqs"><text>sava lebollo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sava lebollo_4446_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loi-cadre</text></gloss>
      <gloss lang="en"><text>framework law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
