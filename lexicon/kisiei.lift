<?xml version="1.0" encoding="UTF-8"?>
<lift version="0.13" producer="Kisie tools/build_lexicon.py">
  <entry id="a_1">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_1_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>tu ; ils, elles (sujet)</text></gloss>
      <gloss lang="en"><text>you (sg.); they (subject)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1</text></form></note>
  </entry>
  <entry id="a_2">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_2_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>avec ; et</text></gloss>
      <gloss lang="en"><text>with; and</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1</text></form></note>
  </entry>
  <entry id="a yandi_3">
    <lexical-unit><form lang="kqs"><text>a yandi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a yandi_3_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>s'il te plaît, je t'en prie</text></gloss>
      <gloss lang="en"><text>please</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yándíí</text></form></note>
  </entry>
  <entry id="aa_4">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="aa_4_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>introduit les paroles rapportées</text></gloss>
      <gloss lang="en"><text>quotative particle</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'like, as' (comparison)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8249 occurrences, first GEN.1.3; Childs 2000, p. 2: àà</text></form></note>
  </entry>
  <entry id="akasia_5">
    <lexical-unit><form lang="kqs"><text>akasia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="akasia_5_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acacia (pɛngɛn akasia « bois d'acacia »)</text></gloss>
      <gloss lang="en"><text>acacia (pɛngɛn akasia 'acacia wood')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.25.5</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="amanndiee_6">
    <lexical-unit><form lang="kqs"><text>amanndiee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="amanndiee_6_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amande, amandier (yɔm amanndiee)</text></gloss>
      <gloss lang="en"><text>almond, almond tree (yɔm amanndiee)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.30.37</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="ansan_7">
    <lexical-unit><form lang="kqs"><text>ansan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ansan_7_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>encens</text></gloss>
      <gloss lang="en"><text>incense</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 94 occurrences, first EXO.25.6</text></form></note>
  </entry>
  <entry id="ba_8">
    <lexical-unit><form lang="kqs"><text>ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba_8_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté ; (o … ba) chez, auprès de, aux mains de ; (a ba …) du côté de</text></gloss>
      <gloss lang="en"><text>side; (o … ba) with, at, in the hands of; (a ba …) towards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3579 occurrences, first GEN.2.8</text></form></note>
    <note><form lang="fr"><text>a ba paalen le can-ndo « à l'est » ; o ba bɛngu « sous l'autorité de ».</text></form></note>
  </entry>
  <entry id="baa_9">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>balan</text></form></field>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <sense id="baa_9_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main, bras</text></gloss>
      <gloss lang="en"><text>hand, arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hand, arm; also way, fork in a road</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 131: Baa; Childs 2000, p. 2: bàá</text></form></note>
  </entry>
  <entry id="baa_10">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baa_10_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, accrocher</text></gloss>
      <gloss lang="en"><text>tie, hang</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baa</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : ba, bee. baa est très courant dans la Bible mais avec d'autres sens ; le moyen baanun « attacher » y est attesté (EXO 28,28).</text></form></note>
  </entry>
  <entry id="baala folobaa_11">
    <lexical-unit><form lang="kqs"><text>baala folobaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baala folobaa_11_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>investissement humain (travail collectif)</text></gloss>
      <gloss lang="en"><text>communal labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Baala folobaa</text></form></note>
    <note><form lang="fr"><text>baala « travail » est attesté ; folobaa n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="baalaa_12">
    <lexical-unit><form lang="kqs"><text>baalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>baalalan</text></form></field>
    <variant><form lang="kqs"><text>baala</text></form></variant>
    <variant><form lang="kqs"><text>baalala</text></form></variant>
    <sense id="baalaa_12_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage ; service</text></gloss>
      <gloss lang="en"><text>work; service</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 809 occurrences, first GEN.2.5</text></form></note>
  </entry>
  <entry id="baanɔnndo_13">
    <lexical-unit><form lang="kqs"><text>baanɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baanɔnndo_13_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'accrocher, s'attacher</text></gloss>
      <gloss lang="en"><text>hang on, be attached</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hang, be suspended</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baanönndo; Childs 2000, p. 4: bàànɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de baa. Forme attestée dans la Bible : baanun « attacher » (EXO 28,28 ; JDG 3,16).</text></form></note>
  </entry>
  <entry id="bahavɛiyo_14">
    <lexical-unit><form lang="kqs"><text>bahavɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bahavɛi</text></form></variant>
    <sense id="bahavɛiyo_14_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaire, besoin, demande ; occupation</text></gloss>
      <gloss lang="en"><text>matter, need, request; business</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being busy or preoccupied; being in need or in trouble (lit. 'hand-stuck')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.47.12; Childs 2000, p. 5: bà-hàwɛ́íyó</text></form></note>
    <note><form lang="fr"><text>yungu bahavɛiyo « le clan le plus pauvre » (Jg 6,15) ; o bahavɛiyo pum nin « occupé à quelque affaire » (1 R 18,27).</text></form></note>
  </entry>
  <entry id="bako_15">
    <lexical-unit><form lang="kqs"><text>bako</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bako_15_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(bako bɛɛ + négation) pas un mot, pas du tout</text></gloss>
      <gloss lang="en"><text>(bako bɛɛ + negative) not a word, not at all</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note><form lang="fr"><text>Kɛ bako bɛɛ o suu le « il n'ouvrit pas la bouche » (Es 53,7).</text></form></note>
  </entry>
  <entry id="bakpeŋndo_16">
    <lexical-unit><form lang="kqs"><text>bakpeŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakpeŋndo_16_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignet</text></gloss>
      <gloss lang="en"><text>wrist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Bakpenndo; Childs 2000, p. 211: kpéŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Bakpenndo ; ŋ d'après Childs (kpéŋndó, var. bàlà kpéŋndáŋ).</text></form></note>
  </entry>
  <entry id="bakɔllo_17">
    <lexical-unit><form lang="kqs"><text>bakɔllo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakɔllo_17_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paume de la main</text></gloss>
      <gloss lang="en"><text>palm of the hand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Baköllo; Childs 2000, p. 5: bàkɔ̀lló</text></form></note>
  </entry>
  <entry id="balaa_18">
    <lexical-unit><form lang="kqs"><text>balaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balaa_18_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pourtour ; (o balaa sɔ́) autour</text></gloss>
      <gloss lang="en"><text>surroundings; (o balaa sɔ́) round about</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOS.21.42</text></form></note>
  </entry>
  <entry id="balahavɛilan_19">
    <lexical-unit><form lang="kqs"><text>balahavɛilan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>balahavɛila</text></form></variant>
    <variant><form lang="kqs"><text>balahavɛiya</text></form></variant>
    <sense id="balahavɛilan_19_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaires, besoins, demandes ; (balahavɛiya) les nécessiteux</text></gloss>
      <gloss lang="en"><text>affairs, needs, requests; (balahavɛiya) the needy</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note><form lang="fr"><text>Lié à bahavɛiyo. vanaa balahavɛiya « les pauvres » (Dt 15,11).</text></form></note>
  </entry>
  <entry id="balan_20">
    <lexical-unit><form lang="kqs"><text>balan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bala</text></form></variant>
    <sense id="balan_20_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main(s)</text></gloss>
      <gloss lang="en"><text>hand(s)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 220 occurrences, first GEN.17.9</text></form></note>
    <note><form lang="fr"><text>vana bala fondoo « pauvre » (litt. « main vide »).</text></form></note>
  </entry>
  <entry id="balika_21">
    <lexical-unit><form lang="kqs"><text>balika</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balika_21_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>merci</text></gloss>
      <gloss lang="en"><text>thank you</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 125 occurrences, first GEN.24.48; Childs 2000, p. 5: báléká</text></form></note>
  </entry>
  <entry id="balikaa_22">
    <lexical-unit><form lang="kqs"><text>balikaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balikaa_22_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remerciement, action de grâces</text></gloss>
      <gloss lang="en"><text>thanks, thanksgiving</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first LEV.7.12</text></form></note>
    <note><form lang="fr"><text>Voir l'interjection balika « merci ».</text></form></note>
  </entry>
  <entry id="bállo_23">
    <lexical-unit><form lang="kqs"><text>bállo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>báltan</text></form></field>
    <sense id="bállo_23_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lance</text></gloss>
      <gloss lang="en"><text>spear</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.25.7; Keita 1979, p. 156: Ballo; Childs 2000, p. 6: bàlló</text></form></note>
  </entry>
  <entry id="baloo_24">
    <lexical-unit><form lang="kqs"><text>baloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balo</text></form></variant>
    <sense id="baloo_24_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture ; (dɔwnun balo) se nourrir</text></gloss>
      <gloss lang="en"><text>food; (dɔwnun balo) feed on</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 102 occurrences, first GEN.1.29</text></form></note>
  </entry>
  <entry id="balu_25">
    <lexical-unit><form lang="kqs"><text>balu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balunin</text></form></variant>
    <sense id="balu_25_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire le tour, entourer ; parcourir</text></gloss>
      <gloss lang="en"><text>go around, surround; roam through</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 345 occurrences, first GEN.2.11; Childs 2000, p. 5: bàlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="balufaa_26">
    <lexical-unit><form lang="kqs"><text>balufaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="balufaa_26_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concubine ; fiancée</text></gloss>
      <gloss lang="en"><text>concubine; betrothed</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first JDG.19.1</text></form></note>
    <note><form lang="fr"><text>Distinct de sámáá. balufaa ndɔ « sa fiancée » (1 Co 7,36).</text></form></note>
  </entry>
  <entry id="balɔɔ_27">
    <lexical-unit><form lang="kqs"><text>balɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="balɔɔ_27_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avant-bras (Keita) ; autour, à travers (Bible)</text></gloss>
      <gloss lang="en"><text>forearm (Keita); around, throughout (Bible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wrist</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Balöö; Childs 2000, p. 6: bàlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, balɔɔ ne s'emploie que comme locatif « autour, partout dans » (Gn 41,46 ; Ex 19,12 ; Lv 13,13). Childs donne « poignet » ; la partie exacte du bras est à confirmer.</text></form></note>
  </entry>
  <entry id="bamban_28">
    <lexical-unit><form lang="kqs"><text>bamban</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bamban_28_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clochettes, grelots</text></gloss>
      <gloss lang="en"><text>small bells</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bell (singular bàmbèì, plural bàmbăŋ)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.28.33; Childs 2000, p. 6: bàmbèì</text></form></note>
    <note><form lang="fr"><text>Pluriel. bamban pɔmbɔn « clochettes » (Ex 28,33).</text></form></note>
  </entry>
  <entry id="bana-banaa_29">
    <lexical-unit><form lang="kqs"><text>bana-banaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bana-banaa_29_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gros, grands (bétail, animaux, navires)</text></gloss>
      <gloss lang="en"><text>big, large (livestock, animals, ships)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 2CH.31.6</text></form></note>
    <note><form lang="fr"><text>visia bana-banaa a á pɔmbɔa « animaux grands et petits » (Ps 104,25).</text></form></note>
  </entry>
