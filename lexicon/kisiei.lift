    <variant><form lang="kqs"><text>fɛkɛila</text></form></variant>
    <variant><form lang="kqs"><text>fɛkɛilan</text></form></variant>
    <sense id="fɛkɛiyo_471_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>large, spacieux</text></gloss>
      <gloss lang="en"><text>wide, spacious</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.26.22</text></form></note>
