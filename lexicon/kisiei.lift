  <entry id="tayɛnndo_5135">
    <lexical-unit><form lang="kqs"><text>tayɛnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tayɛn</text></form></variant>
    <sense id="tayɛnndo_5135_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>milieu, centre</text></gloss>
      <gloss lang="en"><text>middle, centre</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 54: tayɛnndo; Sandara Kisia, fable 17: tayɛŋ</text></form></note>
    <note><form lang="fr"><text>Sandara Kissia, fable 20 et proverbe 27 : tayɛŋ « au milieu » (i hini kɔli re, i hini wɛlɛ tatyi re, a fɔ tayɛŋ « je ne marche ni derrière ni devant, mais au milieu »).</text></form></note>
  </entry>
  <entry id="tàŋgbàŋ_5136">
    <lexical-unit><form lang="kqs"><text>tàŋgbàŋ</text></form></lexical-unit>
