  <entry id="kolaa_2182">
    <lexical-unit><form lang="kqs"><text>kolaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kolalan</text></form></field>
    <variant><form lang="kqs"><text>koraa</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>tafeo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="kolaa_2182_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagne, tissu</text></gloss>
      <gloss lang="en"><text>cloth, wrapper</text></gloss>
