    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yiduno</text></form></variant>
    <sense id="giduno_1554_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour d'eau</text></gloss>
      <gloss lang="en"><text>water drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 29: giduno, yiduno</text></form></note>
  </entry>
  <entry id="giɛmba_1555">
    <lexical-unit><form lang="kqs"><text>giɛmba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛmba</text></form></variant>
    <sense id="giɛmba_1555_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (tronc creusé pour le tambour funéraire)</text></gloss>
