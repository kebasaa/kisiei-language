    <variant><form lang="kqs"><text>siongu</text></form></variant>
    <variant><form lang="kqs"><text>sengu</text></form></variant>
    <variant><form lang="kqs"><text>siangu</text></form></variant>
    <variant><form lang="kqs"><text>singu</text></form></variant>
    <variant><form lang="kqs"><text>siangunin</text></form></variant>
    <variant><form lang="kqs"><text>singunin</text></form></variant>
    <sense id="siongɔɔ_1471_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir</text></gloss>
      <gloss lang="en"><text>heal</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
