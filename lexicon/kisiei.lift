      <gloss lang="en"><text>money</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 148: káníéí kánííŋ</text></form></note>
  </entry>
  <entry id="kanikokoe_1963">
    <lexical-unit><form lang="kqs"><text>kanikokoe</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kanikokoe_1963_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>cri de joie, félicitations</text></gloss>
      <gloss lang="en"><text>cry of joy, congratulations</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) congratulations</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 120: Kanikokoe !; Childs 2000, p. 148: kàníkòkùéíyó</text></form></note>
    <note><form lang="fr"><text>Keita (p. 60) : Kanikokoe ! ɲɛ ni kɔɛ pa !</text></form></note>
  </entry>
  <entry id="kanimasinndɔɔ_1964">
    <lexical-unit><form lang="kqs"><text>kanimasinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kanimasinndɔɔ_1964_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>classique</text></gloss>
      <gloss lang="en"><text>classical</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 62: Kanimasinndöö</text></form></note>
