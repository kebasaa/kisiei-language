  <entry id="ɲeenun_4167">
    <lexical-unit><form lang="kqs"><text>ɲeenun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲeenun_4167_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>reculer devant, fuir devant ; s'échapper</text></gloss>
      <gloss lang="en"><text>shrink back from, flee from; escape</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>run away from (benefactive of 'run')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1SA.19.11; Childs 2000, p. 275: ɲèènɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="ɲéŋíó_4168">
    <lexical-unit><form lang="kqs"><text>ɲéŋíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="ɲéŋíó_4168_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>engourdissement, somnolence ; maladie du sommeil, tétanos ; venin</text></gloss>
      <gloss lang="en"><text>numbness, sleepiness; sleeping sickness, tetanus; venom</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 278: ɲéŋíó</text></form></note>
