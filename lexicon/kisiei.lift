      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 479: Kpoola kökèndèlan, kula nyaaloo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi kula ɲaaloo (« cris de joie »).</text></form></note>
  </entry>
