    <note type="source"><form lang="en"><text>Terminologie (langue), n° 377: Soliooden</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="solisɛbɔɔ_4692">
    <lexical-unit><form lang="kqs"><text>solisɛbɔɔ</text></form></lexical-unit>
