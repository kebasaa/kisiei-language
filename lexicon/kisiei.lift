      <gloss lang="en"><text>harp, lyre; kora</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first 1SA.16.16; Keita 1979, p. 163: Bangaa; Lexique kissi–français, p. 4: bangaa</text></form></note>
