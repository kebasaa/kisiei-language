    <trait name="status" value="attested"/>
    <sense id="duuva_741_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rabrouer, faire honte à, écarter</text></gloss>
      <gloss lang="en"><text>rebuff, reproach, keep away</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>exclude, discriminate against, ostracize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first RUT.2.15; Childs 2000, p. 91: dùùwàá</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : vana-vana bɛnda mò duuva ndu le « que personne ne la rabroue » (RUT.2.15).</text></form></note>
  </entry>
