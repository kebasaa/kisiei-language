  <entry id="taasio_5053">
    <lexical-unit><form lang="kqs"><text>taasio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>taasi</text></form></variant>
    <sense id="taasio_5053_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sagesse, intelligence, stratégie ; tactique ; sagesse, discernement ; conseil ; compréhension, expérience ; remarque</text></gloss>
      <gloss lang="en"><text>wisdom, skill, strategy; tactic ; wisdom, discernment; advice; understanding, experience; remark</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being sensible or active</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 68 occurrences, first GEN.41.33; Keita 1979, p. 156: Taasioo; Lexique kissi–français, p. 53: taasio; Terminologie (idéologie), n° 570: Mönnyumalen, taasioo, vanakökaloo; Childs 2000, p. 347: tààsìóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Taasioo ; la Bible écrit taasio. Académie des langues (terminologie, idéologie n° 570) : « sagesse » (aussi mɔnɲumalen, vanakɔkaloo).</text></form></note>
  </entry>
