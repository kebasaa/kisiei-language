      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bunch, ear (of maize), stalk, clump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MRK.4.8; Keita 1979, p. 140: Yasaa; Childs 2000, p. 399: yàsàá</text></form></note>
  </entry>
  <entry id="yasabaa_1402">
    <lexical-unit><form lang="kqs"><text>yasabaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="yasabaa_1402_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri, campement ; atelier</text></gloss>
      <gloss lang="en"><text>shelter, camp; workshop</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>temporary cooking site on a farm, before the farm kitchen is built</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.28.15; Keita 1979, p. 142: Yasabaa; Childs 2000, p. 399: yàsàbáá</text></form></note>
    <note><form lang="fr"><text>Keita donne « atelier » (p. 142) et « le camp » (p. 156). Bible : refuge, abri (Is 28,15.17), pâturage (Ez 25,5).</text></form></note>
  </entry>
