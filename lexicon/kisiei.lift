    <sense id="kùùcùkúúcóó_1808_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termite (termite-lion)</text></gloss>
      <gloss lang="en"><text>termite (lion termite)</text></gloss>
