    <trait name="status" value="southern"/>
    <sense id="céŋndó_652_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marteau de forgeron (servant aussi pour les remèdes)</text></gloss>
      <gloss lang="en"><text>blacksmith's hammer (also used for preparing medicines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 42: céŋndó</text></form></note>
  </entry>
  <entry id="cèŋùlló_653">
