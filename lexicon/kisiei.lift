    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 24: kibaro</text></form></note>
    <note><form lang="fr"><text>Emprunt (malinké kibaro).</text></form></note>
  </entry>
  <entry id="kie pɔm_2087">
    <lexical-unit><form lang="kqs"><text>kie pɔm</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kie pɔm_2087_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pays des morts</text></gloss>
      <gloss lang="en"><text>land of the dead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.6 Heaven, hell"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 53: kye</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 53 : kye pɔm, tye pɔm « pays (maisons) des morts » ; kye/tye semble être la maison (Bible cɛiyo). Orthographe à vérifier.</text></form></note>
  </entry>
  <entry id="kííbɔ̀ŋíìyó_2088">
    <lexical-unit><form lang="kqs"><text>kííbɔ̀ŋíìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
