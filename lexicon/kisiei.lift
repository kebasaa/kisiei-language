    <sense id="fúùù_925_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une allumette qui s'enflamme, d'un souffle, d'une chute</text></gloss>
      <gloss lang="en"><text>sound of a match flaring, of blowing, of a fall</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fúùù</text></form></note>
  </entry>
  <entry id="fùùyìá_926">
