    <trait name="status" value="southern"/>
    <sense id="bìl-kpèlòó_186_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paille de literie</text></gloss>
      <gloss lang="en"><text>bedding straw</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bìl-kpèlòó</text></form></note>
  </entry>
  <entry id="bila_187">
    <lexical-unit><form lang="kqs"><text>bila</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bila_187_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sens ; (bii … bila) comprendre</text></gloss>
      <gloss lang="en"><text>meaning; (bii … bila) understand</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 216 occurrences, first GEN.19.9</text></form></note>
  </entry>
  <entry id="bilaa_188">
    <lexical-unit><form lang="kqs"><text>bilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bilaa_188_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>explication ; compréhension</text></gloss>
      <gloss lang="en"><text>explanation; understanding</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first 1KI.22.47; Lexique kissi–français, p. 6: bilaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi biraa (p. 7).</text></form></note>
  </entry>
  <entry id="bílílí_189">
    <lexical-unit><form lang="kqs"><text>bílílí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bílílí_189_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>écoulement fort et régulier (d'un liquide)</text></gloss>
      <gloss lang="en"><text>strong, steady flow (of a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bílílí</text></form></note>
  </entry>
  <entry id="bilio_190">
    <lexical-unit><form lang="kqs"><text>bilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bilio_190_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rue</text></gloss>
      <gloss lang="en"><text>street</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Bilio; Lexique kissi–français, p. 6: bilio; Childs 2000, p. 17: bílíó</text></form></note>
    <note><form lang="fr"><text>Keita glose « la rue (route) » ; la Bible dit nɛiyo pour « chemin, route ».</text></form></note>
  </entry>
  <entry id="bilkuamaa_191">
    <lexical-unit><form lang="kqs"><text>bilkuamaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bilkuamaa_191_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>graines d'herbes ; herbe à fleurs</text></gloss>
      <gloss lang="en"><text>grass seeds; flowering grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 6: bilkuamaa</text></form></note>
  </entry>
  <entry id="bìllèsókóó_192">
