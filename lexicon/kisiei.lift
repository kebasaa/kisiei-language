      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de pluie fine, de grains semés, de cailloux jetés (sur des feuilles)</text></gloss>
      <gloss lang="en"><text>sound of soft rain, of sown grain or pebbles falling (on leaves)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 16: bíàà</text></form></note>
  </entry>
  <entry id="bibuloo_168">
    <lexical-unit><form lang="kqs"><text>bibuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bibuloo_168_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Bible</text></gloss>
      <gloss lang="en"><text>Bible</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Bibuloo; Lexique kissi–français, p. 6: bibuloo</text></form></note>
  </entry>
  <entry id="bidiin_169">
    <lexical-unit><form lang="kqs"><text>bidiin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bidiin_169_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>vingt</text></gloss>
      <gloss lang="en"><text>twenty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 327 occurrences, first GEN.6.3; Lexique kissi–français, p. 6: bidin; Childs 2000, p. 16: bídìíŋ</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit bidin (p. 6).</text></form></note>
  </entry>
  <entry id="bidiinndɔɔ_170">
    <lexical-unit><form lang="kqs"><text>bidiinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bidiinndɔɔ_170_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>vingtième</text></gloss>
      <gloss lang="en"><text>twentieth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.15.9; Lexique kissi–français, p. 6: bidinndɔɔ</text></form></note>
    <note><form lang="fr"><text>Ordinal de bidiin « vingt ». Le Lexique kissi–français écrit bidinndɔɔ (p. 6).</text></form></note>
  </entry>
  <entry id="bidonndo_171">
    <lexical-unit><form lang="kqs"><text>bidonndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bidonndo_171_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bidon</text></gloss>
      <gloss lang="en"><text>jerrycan, can</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 6: bidonndo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français.</text></form></note>
  </entry>
  <entry id="bii_172">
    <lexical-unit><form lang="kqs"><text>bii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biinin</text></form></variant>
    <sense id="bii_172_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, attraper, tenir ; garder, observer (un commandement)</text></gloss>
      <gloss lang="en"><text>seize, catch, hold; keep (a commandment)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2065 occurrences, first GEN.3.6; Childs 2000, p. 20: bìyɔ̀ɔ́</text></form></note>
