      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Yallo; Lexique kissi–français, p. 63: yallo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 63 : « un épouvantail (qui garde les champs contre les voleurs), le fétiche ».</text></form></note>
  </entry>
  <entry id="yalɔɔ_4599">
    <lexical-unit><form lang="kqs"><text>yalɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yalu</text></form></variant>
    <sense id="yalɔɔ_4599_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier, s'exclamer</text></gloss>
      <gloss lang="en"><text>shout, exclaim</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yarɔɔ/ yaru</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yàmáfìkóó_4600">
    <lexical-unit><form lang="kqs"><text>yàmáfìkóó</text></form></lexical-unit>
