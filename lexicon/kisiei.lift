    <note><form lang="fr"><text>Forme et découpage à confirmer.</text></form></note>
  </entry>
  <entry id="nɛinun_1229">
    <lexical-unit><form lang="kqs"><text>nɛinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛinun_1229_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déplaire, être odieux (à quelqu'un)</text></gloss>
      <gloss lang="en"><text>displease, be hateful to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 75 occurrences, first GEN.37.5</text></form></note>
    <note><form lang="fr"><text>dɛnɛ ndɔ kon nɛinun Mɛlɛka « ce qu'il faisait déplut au Seigneur » (Gn 38,10) ; vanaa nɛinun Mɛlɛka-a « ceux que le Seigneur a en horreur » (Dt 22,5). Sans doute apparenté à nɛyɔnndo « haïr ».</text></form></note>
  </entry>
  <entry id="nɛiyo_1230">
    <lexical-unit><form lang="kqs"><text>nɛiyo</text></form></lexical-unit>
