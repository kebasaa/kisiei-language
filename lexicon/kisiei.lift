  <entry id="kookoo_1450">
    <lexical-unit><form lang="kqs"><text>kookoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kookoo_1450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foulard de tête</text></gloss>
      <gloss lang="en"><text>head scarf</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
