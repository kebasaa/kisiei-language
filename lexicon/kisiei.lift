    <sense id="fíɲɔ́ɔ́_870_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coussinet de portage (sur la tête)</text></gloss>
      <gloss lang="en"><text>head pad for carrying loads</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíɲɔ́ɔ́</text></form></note>
