      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hit, knock, bump into; also knock on a door</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.21.22; Childs 2000, p. 195: kùndɔ̀ɔ́</text></form></note>
