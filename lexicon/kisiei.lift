  <entry id="nɛwvo_1231">
    <lexical-unit><form lang="kqs"><text>nɛwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛw</text></form></variant>
    <variant><form lang="kqs"><text>nɛwnin</text></form></variant>
    <variant><form lang="kqs"><text>nɛwnun</text></form></variant>
    <sense id="nɛwvo_1231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fouler, piétiner, écraser</text></gloss>
      <gloss lang="en"><text>tread, trample, crush underfoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of nèìyó 'step on, kick, thresh'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 2SA.22.43; Childs 2000, p. 259: nèìùwó</text></form></note>
    <note><form lang="fr"><text>rɛsɛnndon nɛwvo o doolaa nin « fouler le raisin au pressoir » (Ne 13,15) ; nɛw … a labɛngu « fouler aux pieds » (Ps 44,6).</text></form></note>
  </entry>
  <entry id="nɛyaa_1232">
    <lexical-unit><form lang="kqs"><text>nɛyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛyan</text></form></variant>
    <variant><form lang="kqs"><text>nɛyaa-nɛyan</text></form></variant>
    <sense id="nɛyaa_1232_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>douloureux, brûlant ; fort (boisson) ; (ɲɛ nɛyaa) douleur</text></gloss>
      <gloss lang="en"><text>painful, burning; strong (drink); (ɲɛ nɛyaa) pain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.34.25; Childs 2000, p. 261: nèìyà-</text></form></note>
    <note><form lang="fr"><text>ɲɛ nɛyaa « la douleur » (Jb 30,17) ; mɔima nɛyaa « boisson forte » (Dt 29,5) ; kɛvaa lólòla nɛyaa « serpents brûlants » (Dt 8,15).</text></form></note>
  </entry>
