    <trait name="status" value="respelled"/>
    <sense id="fuo_459_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éponge</text></gloss>
      <gloss lang="en"><text>sponge</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Fuo</text></form></note>
  </entry>
  <entry id="fuo_460">
    <lexical-unit><form lang="kqs"><text>fuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuo_460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mars</text></gloss>
      <gloss lang="en"><text>March</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around February or March, end of the dry season</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Fuo; Childs 2000, p. 113: fúóò</text></form></note>
  </entry>
  <entry id="fúú_461">
    <lexical-unit><form lang="kqs"><text>fúú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fúú_461_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement (fondo fúú « tout nu, entièrement vide »)</text></gloss>
      <gloss lang="en"><text>completely (fondo fúú 'stark naked, utterly empty')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 183 occurrences, first GEN.9.22</text></form></note>
  </entry>
  <entry id="fuusaa_462">
    <lexical-unit><form lang="kqs"><text>fuusaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>fuusa</text></form></variant>
    <variant><form lang="kqs"><text>fuusɛi</text></form></variant>
    <variant><form lang="kqs"><text>fuusan</text></form></variant>
    <sense id="fuusaa_462_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire brûler (l'encens), encenser</text></gloss>
      <gloss lang="en"><text>burn (incense)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note><form lang="fr"><text>bonyii fuusɛi, pluriel bonyun fuusan « encensoir(s) » (Lv 10,1 ; Nb 16,17).</text></form></note>
  </entry>
  <entry id="fuɲaa_463">
    <lexical-unit><form lang="kqs"><text>fuɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fuɲa</text></form></variant>
    <sense id="fuɲaa_463_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>père ; (pl.) ancêtres</text></gloss>
      <gloss lang="en"><text>father ; father; (pl.) forefathers</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>father; term of respect for a man</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 606 occurrences, first GEN.4.18; Keita 1979, p. 134: Finyaa; Childs 2000, p. 106: fíɲàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Finyaa ; la Bible a toujours fuɲaa.</text></form></note>
  </entry>
  <entry id="fɔ_464">
    <lexical-unit><form lang="kqs"><text>fɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fɔ_464_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>il faut que, nécessairement ; (fɔ mì) jusqu'à ce que ; sauf</text></gloss>
      <gloss lang="en"><text>must, necessarily; (fɔ mì) until; except</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note><form lang="fr"><text>fɔ mì Po vanacieo sɔla heeloo « il faut que le Fils de l'homme soit élevé » (Jn 3,14) ; háá fɔ mì « jusqu'à ce que » (Ne 7,65).</text></form></note>
  </entry>
  <entry id="fɔ́_465">
    <lexical-unit><form lang="kqs"><text>fɔ́</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fɔ́_465_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule finale exclamative (souhaits, plaintes)</text></gloss>
      <gloss lang="en"><text>sentence-final exclamative particle (wishes, complaints)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note><form lang="fr"><text>Màá Mɛlɛka cɔɔlu ya hɔ́ɔ́ piaandu celen fɔ́ ! « Que le Seigneur m'ajoute un autre fils ! »</text></form></note>
  </entry>
  <entry id="fɔlɔn_466">
