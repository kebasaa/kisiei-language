    <lexical-unit><form lang="kqs"><text>kpulun</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kpulun_1972_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(tomber) mal ; manière de tomber</text></gloss>
      <gloss lang="en"><text>(fall) badly; manner of falling</text></gloss>
