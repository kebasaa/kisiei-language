    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diɔm</text></form></variant>
    <variant><form lang="kqs"><text>diɔmaa</text></form></variant>
    <sense id="diɔmndo_361_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise ; (pl.) les sots</text></gloss>
      <gloss lang="en"><text>folly; (pl.) fools</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fool, foolish person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first 1SA.21.14; Childs 2000, p. 83: ɗìɔ̀mndó</text></form></note>
  </entry>
  <entry id="diɛŋ_362">
    <lexical-unit><form lang="kqs"><text>diɛŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diɛŋ_362_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>après-demain</text></gloss>
      <gloss lang="en"><text>the day after tomorrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.19.11; Keita 1979, p. 152: Dièn; Childs 2000, p. 78: díɛ̀ŋ</text></form></note>
