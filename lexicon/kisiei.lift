    <note><form lang="fr"><text>Cf. luaŋ « haut, nord » (Bible). Confirmé au Nord par Paulme 1964, p. 59 : luande, pl. luando « montagne, colline ».</text></form></note>
  </entry>
  <entry id="luaŋ_3201">
    <lexical-unit><form lang="kqs"><text>luaŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luaŋ_3201_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haut, côté supérieur ; nord (a ba luaŋ-ndo « vers le nord »)</text></gloss>
      <gloss lang="en"><text>top, upper side; north (a ba luaŋ-ndo, northward)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>upper part, up(hill)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 127 occurrences, first GEN.13.14; Childs 2000, p. 236: lùàŋ</text></form></note>
    <note><form lang="fr"><text>a ba luaŋ-ndo « au nord » (GEN.13.14) ; kèédei coo a ba luaŋ-ndo « sur le linteau » (EXO.12.7). Cf. maluaŋ « nord ».</text></form></note>
  </entry>
  <entry id="lùáŋndé-sòòlùùwó_3202">
    <lexical-unit><form lang="kqs"><text>lùáŋndé-sòòlùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lùáŋndé-sòòlùùwó_3202_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cérémonie d'apaisement des ancêtres (repas préparé sur un rocher, part laissée aux ancêtres)</text></gloss>
      <gloss lang="en"><text>ceremony to appease the ancestors (meal cooked on a rocky hill, a share left for them)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùáŋndé-sòòlùùwó</text></form></note>
  </entry>
  <entry id="lue_3203">
    <lexical-unit><form lang="kqs"><text>lue</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lue_3203_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être tranchant, aiguisé</text></gloss>
      <gloss lang="en"><text>be sharp</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 59: lue; Childs 2000, p. 236: lùèíyó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par Paulme 1964, p. 59 : lue « être affilé » (muɔy i lue « le couteau est affilé », muɔy luɛay « couteau qui coupe »).</text></form></note>
  </entry>
  <entry id="lueinun_3204">
    <lexical-unit><form lang="kqs"><text>lueinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lueinun_3204_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller vers (une femme) ; (… yoomuan) prendre courage, se fortifier</text></gloss>
      <gloss lang="en"><text>go in to (a woman); (… yoomuan) take courage, be strong</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.6.19</text></form></note>
    <note><form lang="fr"><text>Moyen de lueiyo. lueinun … coo « aller vers (une femme) » (Gn 16,2) ; réciproque lueinan yoomuan « s'encourager mutuellement » (1 Th 5,11).</text></form></note>
  </entry>
  <entry id="lueisoo_3205">
    <lexical-unit><form lang="kqs"><text>lueisoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lueisoo_3205_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dé à coudre</text></gloss>
      <gloss lang="en"><text>thimble</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 81: Lueisoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lueiyo_3206">
    <lexical-unit><form lang="kqs"><text>lueiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>luei</text></form></variant>
    <variant><form lang="kqs"><text>lueinin</text></form></variant>
    <sense id="lueiyo_3206_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire entrer, introduire, mettre dans ; causer (un malheur)</text></gloss>
      <gloss lang="en"><text>bring in, put in; cause (grief)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put in; also carry back, put away, return</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 114 occurrences, first GEN.6.5; Childs 2000, p. 236: lùèìyó</text></form></note>
    <note><form lang="fr"><text>Causatif de luɛyɔɔ « entrer ». luei … mɔnɛi lueiyo « causer du chagrin » (Gn 26,35). Bénéfactif lueilul « rapporter (un profit) à » (Pr 3,14).</text></form></note>
  </entry>
  <entry id="lullo_3207">
    <lexical-unit><form lang="kqs"><text>lullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lul</text></form></variant>
    <sense id="lullo_3207_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fuir, laisser passer l'eau ; s'écouler</text></gloss>
      <gloss lang="en"><text>leak; drain away</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ECC.10.18; Childs 2000, p. 236: lùlló</text></form></note>
    <note><form lang="fr"><text>Lullo cɛiyo lul « le toit de la maison fuit » (ECC.10.18) ; mɛmma … co lullo « des eaux qui s'écoulent » (NAM.2.9).</text></form></note>
  </entry>
  <entry id="lulluo_3208">
    <lexical-unit><form lang="kqs"><text>lulluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lulluo_3208_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (écorce employée dans le médicament du kundo)</text></gloss>
      <gloss lang="en"><text>plant (bark used in the kundo medicine)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 59: lulluo</text></form></note>
    <note><form lang="fr"><text>Paulme : l'écorce entre dans la composition du nyuruwã kundo.</text></form></note>
  </entry>
  <entry id="lulundo_3209">
    <lexical-unit><form lang="kqs"><text>lulundo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="lulundo_3209_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste (rubiacée, pêcher africain)</text></gloss>
      <gloss lang="en"><text>shrub (African peach)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 60: lulundo, kulundo</text></form></note>
    <note><form lang="fr"><text>Sarcocephalus esculentus (Rubiaceae). Variante kulundo.</text></form></note>
  </entry>
  <entry id="lum_3210">
    <lexical-unit><form lang="kqs"><text>lum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lum_3210_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire (au four), préparer (un repas)</text></gloss>
      <gloss lang="en"><text>bake, prepare (a meal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.19.3</text></form></note>
  </entry>
  <entry id="lumbian_3211">
    <lexical-unit><form lang="kqs"><text>lumbian</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>dumbian</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="lumbian_3211_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de raphia (piassava)</text></gloss>
      <gloss lang="en"><text>(piassava) palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 22 (G/K): dumbiã /G./, lumbiã /K./; Childs 2000, p. 236: lùmbìáŋ</text></form></note>
    <note><form lang="fr"><text>Les notes manuscrites sur Keita portent « lumbian » à côté de Senhan « vin de raphia », avec un point d'interrogation. Confirmé au Nord par Paulme 1964, p. 22 (dumbiã /G./, lumbiã /K./ « vin de raphia »). Pluriel en kissi du Sud (Childs 2000) : lùmbèléŋ. Paulme : dumbiã /G./, lumbiã /K./ (p. 22).</text></form></note>
  </entry>
  <entry id="lùmbɔ́ɔ́_3212">
    <lexical-unit><form lang="kqs"><text>lùmbɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lùmbíáŋ</text></form></field>
    <sense id="lùmbɔ́ɔ́_3212_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier raphia (piassava), qui donne du vin</text></gloss>
      <gloss lang="en"><text>piassava (raffia) palm, tapped for wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùmbɔ́ɔ́</text></form></note>
  </entry>
  <entry id="lumlumndan_3213">
    <lexical-unit><form lang="kqs"><text>lumlumndan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lumlumndan_3213_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite fougère (diadèmes et colliers de fête)</text></gloss>
      <gloss lang="en"><text>small fern (made into festive headbands and necklaces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 59: lumlumdã</text></form></note>
    <note><form lang="fr"><text>Paulme : les wulla s'en font des diadèmes et des colliers pour les fêtes. md réécrit mnd comme dans la Bible (kumnde).</text></form></note>
  </entry>
  <entry id="lùmndé_3214">
    <lexical-unit><form lang="kqs"><text>lùmndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lùmndé_3214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>partie la plus profonde d'une rivière, tourbillon ; mort</text></gloss>
      <gloss lang="en"><text>deepest part of a river, whirlpool; death</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùmndé</text></form></note>
  </entry>
  <entry id="lumndo_3215">
    <lexical-unit><form lang="kqs"><text>lumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lumndo_3215_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadet, le plus jeune (des enfants)</text></gloss>
      <gloss lang="en"><text>youngest child, last-born</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>last child born to a woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.42.13; Childs 2000, p. 236: lùmndó</text></form></note>
    <note><form lang="fr"><text>pɔmbɔ naa lumndo « notre plus jeune frère » (GEN.42.13).</text></form></note>
  </entry>
  <entry id="lundupulo_3216">
    <lexical-unit><form lang="kqs"><text>lundupulo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lundupulo_3216_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (racines employées dans le karabala)</text></gloss>
      <gloss lang="en"><text>plant (roots used in the karabala)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 60: lundupuro</text></form></note>
  </entry>
  <entry id="lunndo_3217">
    <lexical-unit><form lang="kqs"><text>lunndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bɛu</text></form></variant>
    <sense id="lunndo_3217_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concession, cour</text></gloss>
      <gloss lang="en"><text>concession, compound, courtyard</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 196: Lunndo, bèu</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Variante bɛu. Aussi histoire n° 228 « cour ».</text></form></note>
  </entry>
  <entry id="lusullo_3218">
    <lexical-unit><form lang="kqs"><text>lusullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lusul</text></form></variant>
    <variant><form lang="kqs"><text>lusulaa</text></form></variant>
    <sense id="lusullo_3218_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être lourd ; poids</text></gloss>
      <gloss lang="en"><text>be heavy; weight</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.14.25; Paulme 1964, p. 60: lusullo</text></form></note>
    <note><form lang="fr"><text>Paulme : ɔ lusulte « il est léger ».</text></form></note>
  </entry>
  <entry id="lusuo_3219">
    <lexical-unit><form lang="kqs"><text>lusuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="lusuo_3219_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pression</text></gloss>
      <gloss lang="en"><text>pressure</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 33: lusuo</text></form></note>
  </entry>
  <entry id="luusian_3220">
    <lexical-unit><form lang="kqs"><text>luusian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luusian_3220_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>errer, s'égarer ; être perdu</text></gloss>
      <gloss lang="en"><text>wander, go astray; be lost</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>play tricks, act foolishly; get lost, go missing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.21.14; Childs 2000, p. 237: lùùsìá</text></form></note>
  </entry>
  <entry id="luŋ_3221">
    <lexical-unit><form lang="kqs"><text>luŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luŋ_3221_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>place publique ; (o luŋ) en public, dehors</text></gloss>
      <gloss lang="en"><text>public square; (o luŋ) in public, outside</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.4.10</text></form></note>
    <note><form lang="fr"><text>cal o luŋ « s'asseoir sur la place » (Jg 19,15) ; yonda … o luŋ kpendekele « proclamer en public » (Lc 12,3).</text></form></note>
  </entry>
  <entry id="lúŋndéŋ_3222">
    <lexical-unit><form lang="kqs"><text>lúŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="lúŋndéŋ_3222_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand palmier mort sans palmes (souvent frappé par la foudre)</text></gloss>
      <gloss lang="en"><text>tall dead palm tree without fronds (often struck by lightning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 237: lúŋndéŋ</text></form></note>
  </entry>
  <entry id="luɔlumpombo_3223">
    <lexical-unit><form lang="kqs"><text>luɔlumpombo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="luɔlumpombo_3223_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (sélaginelle)</text></gloss>
      <gloss lang="en"><text>spikemoss (Selaginella)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 60: luɔlumpombo</text></form></note>
    <note><form lang="fr"><text>Selaginella scandens (ptéridophyte).</text></form></note>
  </entry>
  <entry id="luɔɲo_3224">
    <lexical-unit><form lang="kqs"><text>luɔɲo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="luɔɲo_3224_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oryctérope</text></gloss>
      <gloss lang="en"><text>aardvark</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 60: luɔnyo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 60 : on fait un kɔwã avec sa patte gauche, censée arrêter la pluie quand il creuse le sol.</text></form></note>
  </entry>
  <entry id="luɛyaa_3225">
    <lexical-unit><form lang="kqs"><text>luɛyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>luɛyaalan</text></form></field>
    <variant><form lang="kqs"><text>luɛyaala</text></form></variant>
    <sense id="luɛyaa_3225_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entrée, porte (de ville)</text></gloss>
      <gloss lang="en"><text>entrance, gate</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first EXO.4.25</text></form></note>
    <note><form lang="fr"><text>Nom verbal de luɛyɔɔ « entrer ».</text></form></note>
  </entry>
  <entry id="luɛyɔɔ_3226">
    <lexical-unit><form lang="kqs"><text>luɛyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>luɛi</text></form></variant>
    <variant><form lang="kqs"><text>luɛinin</text></form></variant>
    <sense id="luɛyɔɔ_3226_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entrer ; arriver, survenir</text></gloss>
      <gloss lang="en"><text>enter, go in; come, arrive</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>enter, come in; put in; produce in quantity (crops)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 209 occurrences, first GEN.6.18; Paulme 1964, p. 59: luɛy; Terminologie (histoire), n° 464: Löèyöö; Childs 2000, p. 236: lùèyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 464) : lɔɛyɔɔ « pénétration ».</text></form></note>
  </entry>
  <entry id="luɛyɔɔninndo_3227">
    <lexical-unit><form lang="kqs"><text>luɛyɔɔninndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="luɛyɔɔninndo_3227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pot-de-vin</text></gloss>
      <gloss lang="en"><text>bribe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first DEU.27.25</text></form></note>
    <note><form lang="fr"><text>De luɛyɔɔ « entrer ». cɛl luɛyɔɔninndo « accepter un pot-de-vin » (Dt 27,25).</text></form></note>
  </entry>
  <entry id="lɔ ciɛiyo_3228">
    <lexical-unit><form lang="kqs"><text>lɔ ciɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lɔ ciɛiya</text></form></field>
    <sense id="lɔ ciɛiyo_3228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serpent-minute (vipère très venimeuse)</text></gloss>
      <gloss lang="en"><text>very venomous small viper ('one-day snake')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔ tyɛyo, pl. lɔ tyɛya</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 58 : « le jour d'hier », ainsi nommé car hier l'homme mordu était encore en vie (cf. ciɛi « hier »).</text></form></note>
  </entry>
  <entry id="lɔ kuɛ nɛ_3229">
    <lexical-unit><form lang="kqs"><text>lɔ kuɛ nɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔ kuɛ nɛ_3229_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>quand ?</text></gloss>
      <gloss lang="en"><text>when?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 32: lɔ kuɛ nɛ</text></form></note>
    <note><form lang="fr"><text>Cf. kuɛɛ « où ? quel ? ».</text></form></note>
  </entry>
  <entry id="lɔ o_3230">
    <lexical-unit><form lang="kqs"><text>lɔ o</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔ o_3230_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>pendant que</text></gloss>
      <gloss lang="en"><text>while</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 32: lɔ o</text></form></note>
  </entry>
  <entry id="lɔ pum_3231">
    <lexical-unit><form lang="kqs"><text>lɔ pum</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔ pum_3231_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>plus tard ; une autre fois</text></gloss>
      <gloss lang="en"><text>later; another time</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔpum</text></form></note>
    <note><form lang="fr"><text>Paulme : i hunni lɔpum « je viendrai plus tard » ; p. 57 : lɔ pum « une autre fois », le pilɛ « une seule fois », le din « une deuxième fois ».</text></form></note>
  </entry>
  <entry id="lɔ yomo_3232">
    <lexical-unit><form lang="kqs"><text>lɔ yomo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lɔ yomo_3232_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>annoncer le jour, fixer la date (d'une cérémonie)</text></gloss>
      <gloss lang="en"><text>announce the day, set the date (of a ceremony)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 58 : lɔ « jour » ; lɔ yomo « annoncer le jour, fixer la cérémonie (circoncision, deuil…) » ; a yɛm lɔ « on a fixé le jour ». Cf. lɔ́ɔ́ (Bible). Orthographe à vérifier.</text></form></note>
  </entry>
  <entry id="lɔ́-kùɛ̀ɛ́nɛ́_3233">
    <lexical-unit><form lang="kqs"><text>lɔ́-kùɛ̀ɛ́nɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lɔ́-kùɛ̀ɛ́nɛ́_3233_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>quand ? (litt. « quel (jour de) marché »)</text></gloss>
      <gloss lang="en"><text>when? (literally 'which market day')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 234: lɔ́-kùɛ̀ɛ́nɛ́</text></form></note>
  </entry>
  <entry id="lɔaa_3234">
    <lexical-unit><form lang="kqs"><text>lɔaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔanin</text></form></variant>
    <variant><form lang="kqs"><text>lɔa</text></form></variant>
    <sense id="lɔaa_3234_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper ; jouer (d'un instrument) ; frapper (à la porte)</text></gloss>
      <gloss lang="en"><text>strike, beat; play (an instrument) ; strike, beat; play (an instrument); knock</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hit, beat, strike</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.4.21; Keita 1979, p. 115: Löö; Paulme 1964, p. 57: lɔ, lɔɔ; Lexique kissi–français, p. 33: lɔɔ/ lɔ, loo, lɔa; Childs 2000, p. 235: lɔ̀wàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit löö (radicaux lö, loo, löa) ; la Bible a lɔaa (GEN 32,26 ; GEN 4,21) et lɔanin (ISA 11,4). Paulme 1964, p. 57 : lɔ, lɔɔ « coup, frapper » ; p. 59 : lua « frapper, coup » (ma lua tuilo « ils ont frappé le porc-épic »).</text></form></note>
  </entry>
  <entry id="lɔalaa_3235">
    <lexical-unit><form lang="kqs"><text>lɔalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔalu</text></form></variant>
    <variant><form lang="kqs"><text>lɔalunin</text></form></variant>
    <sense id="lɔalaa_3235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accuser, dénoncer, calomnier</text></gloss>
      <gloss lang="en"><text>accuse, denounce, slander</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ZEC.3.1</text></form></note>
    <note><form lang="fr"><text>vana lɔalaa n'vanndo « l'accusateur » (Za 3,1).</text></form></note>
  </entry>
  <entry id="lɔalianndo_3236">
    <lexical-unit><form lang="kqs"><text>lɔalianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>lɔalian</text></form></variant>
    <variant><form lang="kqs"><text>lɔarianndo</text></form></variant>
    <variant><form lang="kqs"><text>lɔarian</text></form></variant>
    <sense id="lɔalianndo_3236_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'accuser (l'un l'autre)</text></gloss>
      <gloss lang="en"><text>accuse one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 32: lɔarianndo/ lɔarian</text></form></note>
  </entry>
  <entry id="lɔan_3237">
    <lexical-unit><form lang="kqs"><text>lɔan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔma</text></form></variant>
    <sense id="lɔan_3237_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sommeil ; rêve</text></gloss>
      <gloss lang="en"><text>sleep; dream</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleep (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 123 occurrences, first GEN.2.21; Paulme 1964, p. 59: luã; Childs 2000, p. 235: lùáŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 59 : luã « sommeil, et aussi rêve » (i tyɛ luã « j'ai rêvé »).</text></form></note>
  </entry>
  <entry id="lɔco_3238">
    <lexical-unit><form lang="kqs"><text>lɔco</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔco_3238_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante des rizières (fibres pour faire des fouets)</text></gloss>
      <gloss lang="en"><text>rice-field plant (fibres used for whips)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔtyo</text></form></note>
    <note><form lang="fr"><text>Paulme : invariable ; fouets pour un jeu de garçons.</text></form></note>
  </entry>
  <entry id="lɔ̀cɔ̀ɔ́_3239">
    <lexical-unit><form lang="kqs"><text>lɔ̀cɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lɔ̀cɔ̀léŋ</text></form></field>
    <sense id="lɔ̀cɔ̀ɔ́_3239_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante comestible gluante (sert aussi à graisser les moules à briques)</text></gloss>
      <gloss lang="en"><text>slimy edible plant (also used to grease brick moulds)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 233: lɔ̀cɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="lɔl_3240">
    <lexical-unit><form lang="kqs"><text>lɔl</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔl_3240_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer la nuit, loger, séjourner ; dormir</text></gloss>
      <gloss lang="en"><text>spend the night, lodge, dwell; sleep</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.4.20; Paulme 1964, p. 58: lɔl</text></form></note>
    <note><form lang="fr"><text>Forme longue non attestée dans la Bible. Paulme 1964, p. 58 : i lɔl « j'ai dormi », a lɔl kɛnde « as-tu bien dormi ? ».</text></form></note>
  </entry>
  <entry id="lɔlnun_3241">
    <lexical-unit><form lang="kqs"><text>lɔlnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔlnin</text></form></variant>
    <sense id="lɔlnun_3241_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se coucher pour dormir, dormir ; passer la nuit</text></gloss>
      <gloss lang="en"><text>lie down to sleep, sleep; spend the night</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first JDG.19.6; Childs 2000, p. 234: lɔ̀lnɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>i lɔlnun a kɔlɲuloo « je me couche et je dors en paix » (PSA.4.9) ; Cɛl mì n lɔlnun vɛlɛ hau nanu « reste encore cette nuit ici » (JDG.19.6). Cf. lɔl « passer la nuit ».</text></form></note>
  </entry>
  <entry id="lɔloo_3242">
    <lexical-unit><form lang="kqs"><text>lɔloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lɔlulan</text></form></field>
    <variant><form lang="kqs"><text>lɔlu</text></form></variant>
    <variant><form lang="kqs"><text>lɔruo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="lɔloo_3242_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuisse</text></gloss>
      <gloss lang="en"><text>thigh</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.32.32; Keita 1979, p. 132: Löluoo; Paulme 1964, p. 58 (G/K): lɔlɔ /G./, lɔruo /K./; Lexique kissi–français, p. 33: lɔluo; Childs 2000, p. 234: lɔ̀lòó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 58 : lɔlɔ (G.), lɔruo (K.), pl. lɔrula « cuisse ». Paulme : lɔlɔ /G./, lɔruo /K./, pl. lɔrula (p. 58).</text></form></note>
  </entry>
  <entry id="lɔlu_3243">
    <lexical-unit><form lang="kqs"><text>lɔlu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔlu_3243_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuisse</text></gloss>
      <gloss lang="en"><text>thigh</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.24.2; Childs 2000, p. 234: lɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="lɔluan_3244">
    <lexical-unit><form lang="kqs"><text>lɔluan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="lɔluan_3244_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>salive, crachat</text></gloss>
      <gloss lang="en"><text>saliva, spittle</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.15.8; Keita 1979, p. 132: Löluan; Paulme 1964, p. 58: lɔrule, pl. lɔruã; Lexique kissi–français, p. 32: lɔluan; Childs 2000, p. 234: lɔ̀lùáŋ</text></form></note>
  </entry>
  <entry id="lɔ́lúí-cìɔ́ɔ́_3245">
    <lexical-unit><form lang="kqs"><text>lɔ́lúí-cìɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɔ́lúí-cìɔ́ɔ́_3245_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>part de viande (cuisse) offerte au propriétaire du champ après un travail collectif</text></gloss>
      <gloss lang="en"><text>share of meat (thigh) given to the farm owner after group hoeing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 234: lɔ́lúí-cìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="lɔ̀lùkómsáá_3246">
    <lexical-unit><form lang="kqs"><text>lɔ̀lùkómsáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɔ̀lùkómsáá_3246_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 234: lɔ̀lùkómsáá</text></form></note>
  </entry>
  <entry id="lɔlɔɔ_3247">
    <lexical-unit><form lang="kqs"><text>lɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔlɔɔ_3247_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dénoncer, accuser (auprès de qqn), parler contre ; se plaindre (de), réclamer</text></gloss>
      <gloss lang="en"><text>denounce, inform against, accuse; complain (about), claim</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>envy, resent; grumble against someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1SA.22.22; Paulme 1964, p. 58: lɔrɔ; Lexique kissi–français, p. 32: lɔlɔɔ/ lɔlu (g); Childs 2000, p. 234: lɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Doɛk … co lakɔ ya lɔlɔɔ o Saul-lo « Doëg irait me dénoncer à Saül » (1SA.22.22) ; sɛval … sɛbɔɔ le Yerusalɛmnda lɔlɔɔ « écrivirent une lettre contre Jérusalem » (EZR.4.8). Le rapprochement avec Childs (envier, récriminer) est probable mais pas certain. Lexique kissi–français, p. 32-33 : aussi lɔrɔɔ « accuser ». Paulme 1964, p. 58 : lɔrɔ « plainte, réclamer, se plaindre de » (i lɔru Fasa « je me plains de Fasa »).</text></form></note>
  </entry>
  <entry id="lɔ́mbíó_3248">
    <lexical-unit><form lang="kqs"><text>lɔ́mbíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lɔ́mbíléŋ</text></form></field>
    <variant><form lang="kqs"><text>lɔ́mbíóó</text></form></variant>
    <sense id="lɔ́mbíó_3248_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mousse verte (des lieux ombragés en saison des pluies)</text></gloss>
      <gloss lang="en"><text>green moss (of shady places in the rainy season)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 234: lɔ́mbíó</text></form></note>
  </entry>
  <entry id="lɔmbolen_3249">
    <lexical-unit><form lang="kqs"><text>lɔmbolen</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>lóómbòléŋ</text></form></variant>
    <sense id="lɔmbolen_3249_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pénis</text></gloss>
      <gloss lang="en"><text>penis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 59: lumbule, lɔmbole; Childs 2000, p. 232: lómbòléŋ</text></form></note>
    <note><form lang="fr"><text>Mot évité par les femmes. Confirmé au Nord par Paulme 1964, p. 59 : lumbule, lɔmbole « verge (organe sexuel) ». Pluriel en kissi du Sud (Childs 2000) : lómbùéí.</text></form></note>
  </entry>
  <entry id="lɔ̀ndìmèíyé_3250">
    <lexical-unit><form lang="kqs"><text>lɔ̀ndìmèíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lɔ̀ndìmèíyé_3250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clou</text></gloss>
      <gloss lang="en"><text>nail (metal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lɔ̀ndìmèíyé</text></form></note>
  </entry>
  <entry id="lɔ́ndɔ̀ŋndó_3251">
    <lexical-unit><form lang="kqs"><text>lɔ́ndɔ̀ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>lɔ̀mbɔ̀ɔ́</text></form></variant>
    <sense id="lɔ́ndɔ̀ŋndó_3251_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pantalon (long)</text></gloss>
      <gloss lang="en"><text>(long) trousers</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lɔ́ndɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="lɔ́ngùlɔn_3252">
    <lexical-unit><form lang="kqs"><text>lɔ́ngùlɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔ́ngùlɔn_3252_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sans force, inerte ; (sommeil) profond</text></gloss>
      <gloss lang="en"><text>limp, powerless; (sleep) deep</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.15.12</text></form></note>
    <note><form lang="fr"><text>diallon vu Abram lɔ́ngùlɔn « Abram fut saisi d'une torpeur » (Gn 15,12) ; bala … vi lɔ́ngùlɔn « les bras tomberont sans force » (Ez 30,25).</text></form></note>
  </entry>
  <entry id="lɔngɔlian_3253">
    <lexical-unit><form lang="kqs"><text>lɔngɔlian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔngɔlianndo</text></form></variant>
    <sense id="lɔngɔlian_3253_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rouler, se vautrer ; être souillé</text></gloss>
      <gloss lang="en"><text>roll, wallow; be defiled</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.32.5</text></form></note>
    <note><form lang="fr"><text>lɔngɔlianndo o kooma nɔmndan nin « te débattant dans ton sang » (Ez 16,6). Causatif lɔngɔliaa « fouler dans la boue » (Is 26,5).</text></form></note>
  </entry>
  <entry id="lɔu_3254">
    <lexical-unit><form lang="kqs"><text>lɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔa</text></form></variant>
    <sense id="lɔu_3254_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tresser, tisser, filer ; mouler (briques)</text></gloss>
      <gloss lang="en"><text>braid, weave, spin; mould (bricks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plait, braid (baskets, slings)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.1.14; Keita 1979, p. 110: Löw; Paulme 1964, p. 59: lua; Lexique kissi–français, p. 33: lɔu; Childs 2000, p. 235: lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit löw ; la Bible écrit lɔu : yiiŋii lɔu « filer le poil de chèvre » (EXO 35,26), lɔa kambɛiyo « tresser une corbeille » (EXO 2,3), kpilikion lɔu « faire des briques » (EXO 5,7). Paulme 1964, p. 59 : lua « tisser » (i lua kura « j'ai tissé le pagne »).</text></form></note>
  </entry>
  <entry id="lɔ̀ùwɔ̀ɔ́_3255">
    <lexical-unit><form lang="kqs"><text>lɔ̀ùwɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lɔ̀ùwɔ̀ɔ́_3255_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être cuit, prêt à manger</text></gloss>
      <gloss lang="en"><text>be cooked, be ready to eat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lɔ̀ùwɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="lɔw_3256">
    <lexical-unit><form lang="kqs"><text>lɔw</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lɔw_3256_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tisser</text></gloss>
      <gloss lang="en"><text>weave</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 283: Löw</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Numéro répété dans l'original (arts n° 283). La Bible a lɔw dans un autre sens (GEN.18.8) ; cf. luakolanɔɔ « tisserand ».</text></form></note>
  </entry>
  <entry id="lɔwviaa_3257">
    <lexical-unit><form lang="kqs"><text>lɔwviaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔwviaa_3257_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mordre</text></gloss>
      <gloss lang="en"><text>bite</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first NUM.21.6</text></form></note>
  </entry>
  <entry id="lɔŋɔɔ_3258">
    <lexical-unit><form lang="kqs"><text>lɔŋɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="lɔŋɔɔ_3258_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'animal (à la main fine) ; fourmilier</text></gloss>
      <gloss lang="en"><text>kind of animal (with fine hands); anteater</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.11.29; Lexique kissi–français, p. 33: lɔŋɔɔ; Childs 2000, p. 235: lɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 33 (« un animal qui mange les fourmis, fourmilier ») ; la Bible a lɔŋɔɔ (LEV.11.29).</text></form></note>
  </entry>
  <entry id="lɔ́ɔ́_3259">
    <lexical-unit><form lang="kqs"><text>lɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lɔ́ɔ́lan</text></form></field>
    <sense id="lɔ́ɔ́_3259_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>semaine ; marché</text></gloss>
      <gloss lang="en"><text>week ; market; week</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1717 occurrences, first GEN.3.19; Keita 1979, p. 152: Löö; Paulme 1964, p. 58: lɔɔ, pl. lɔrã; Lexique kissi–français, p. 33: lɔɔ; Terminologie (langue), n° 449: Löö; Childs 2000, p. 235: lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Homonyme de lɔ́ɔ́ « jusqu'à ». La Bible a le pluriel lɔ́ɔ́lan « semaines » (Lv 23,15) ; Childs donne « marché, semaine ». Pour la place du marché, la Bible dit luŋ (Mt 11,16). Ne pas confondre avec la conjonction lɔ́ɔ́. Paulme 1964, p. 58 : lɔɔ, pl. lɔrã « marché » ; lɔɔ bɛndu « grand marché ». Académie des langues (terminologie, langue n° 449) : « semaine ».</text></form></note>
  </entry>
  <entry id="lɔɔ_3260">
    <lexical-unit><form lang="kqs"><text>lɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔ_3260_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être cuit (riz)</text></gloss>
      <gloss lang="en"><text>be cooked (rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : mumu lɔɔ « le riz est cuit », mumu ɔ lua u ni « le riz sera cuit ».</text></form></note>
  </entry>
  <entry id="lɔɔ_3261">
    <lexical-unit><form lang="kqs"><text>lɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lɔlla</text></form></field>
    <sense id="lɔɔ_3261_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>baguette de tambour</text></gloss>
      <gloss lang="en"><text>drumstick</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 58: lɔɔ, pl. lɔrra; Terminologie (arts), n° 23: Löö</text></form></note>
    <note><form lang="fr"><text>Homographe de lɔ́ɔ́ « marché ». Académie des langues (terminologie, arts n° 23) : « baguette » ; löö nbalannöö « balafoniste » (n° 20).</text></form></note>
  </entry>
  <entry id="lɔ̀ɔ́_3262">
    <lexical-unit><form lang="kqs"><text>lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɔ̀ɔ́_3262_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manche, anse ; tige</text></gloss>
      <gloss lang="en"><text>handle; stem</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="lɔɔ hiavɛiyo_3263">
    <lexical-unit><form lang="kqs"><text>lɔɔ hiavɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔ hiavɛiyo_3263_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>imparfait</text></gloss>
      <gloss lang="en"><text>imperfect tense</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 398: Löö hiavèiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lɔɔ mbalannɔɔ_3264">
    <lexical-unit><form lang="kqs"><text>lɔɔ mbalannɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔ mbalannɔɔ_3264_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balafoniste</text></gloss>
      <gloss lang="en"><text>balafon player</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 20: Löö nbalannöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Imprimé nbalannöö (nb = mb) ; cf. baalanndo « balafon ».</text></form></note>
  </entry>
  <entry id="lɔ̀ɔ̀-cíéíyó_3265">
    <lexical-unit><form lang="kqs"><text>lɔ̀ɔ̀-cíéíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɔ̀ɔ̀-cíéíyó_3265_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de serpent (dangereux)</text></gloss>
      <gloss lang="en"><text>kind of snake (dangerous)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lɔ̀ɔ̀-cíéíyó</text></form></note>
  </entry>
  <entry id="lɔ́ɔ́-lɔ́ɔ̀_3266">
    <lexical-unit><form lang="kqs"><text>lɔ́ɔ́-lɔ́ɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔ́ɔ́-lɔ́ɔ̀_3266_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>toujours, souvent ; éternel</text></gloss>
      <gloss lang="en"><text>always, often; eternal</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 424 occurrences, first GEN.6.3; Paulme 1964, p. 58: lɔlo, lɔlɔre; Lexique kissi–français, p. 33: lɔɔ-lɔɔ</text></form></note>
    <note><form lang="fr"><text>le lɔ́ɔ́-lɔ́ɔ̀ « pour toujours » : … cuu le lɔ́ɔ́-lɔ́ɔ̀ (2CH.7.3). Paulme 1964, p. 58 : lɔlɔ « souvent, toujours », lɔlɔre « jamais » (i tiyɔ lɔlɔre « je n'ai jamais vu »).</text></form></note>
  </entry>
  <entry id="lɔɔbɛngoo_3267">
    <lexical-unit><form lang="kqs"><text>lɔɔbɛngoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔbɛngoo_3267_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>hebdomadaire</text></gloss>
      <gloss lang="en"><text>weekly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 326: Lööbèngoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lɔɔlɔɔloo_3268">
    <lexical-unit><form lang="kqs"><text>lɔɔlɔɔloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔlɔɔloo_3268_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rare</text></gloss>
      <gloss lang="en"><text>rare</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 33: lɔɔlɔɔloo</text></form></note>
  </entry>
  <entry id="lɔɔmei_3269">
    <lexical-unit><form lang="kqs"><text>lɔɔmei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="lɔɔmei_3269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>morve</text></gloss>
      <gloss lang="en"><text>nasal mucus</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.4 Mucus"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Löömei; Lexique kissi–français, p. 33: lɔɔmei; Childs 2000, p. 235: lɔ̀ɔ̀mèí</text></form></note>
  </entry>
  <entry id="lɔɔnɔnndo_3270">
    <lexical-unit><form lang="kqs"><text>lɔɔnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔɔnun</text></form></variant>
    <sense id="lɔɔnɔnndo_3270_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se frapper</text></gloss>
      <gloss lang="en"><text>beat oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first ISA.51.22; Keita 1979, p. 115: Löönönndo; Lexique kissi–français, p. 33: lɔɔnɔnndo/ lɔɔnun, loonun, lɔanun</text></form></note>
    <note><form lang="fr"><text>Moyen de lɔaa : buŋnde lɔɔnɔnndo « se frapper la poitrine » (LUK 18,13). Le Lexique kissi–français donne aussi : lɔanun.</text></form></note>
  </entry>
  <entry id="lɔɛyɔɔ nindo_3271">
    <lexical-unit><form lang="kqs"><text>lɔɛyɔɔ nindo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɔɛyɔɔ nindo_3271_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corruption</text></gloss>
      <gloss lang="en"><text>corruption</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 221: Löèyöö nindo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). lɔɛyɔɔ, cf. luɛyɔɔ « entrer » (la liste écrit Löèyöö « pénétration », n° 464).</text></form></note>
  </entry>
  <entry id="lɛ_3272">
    <lexical-unit><form lang="kqs"><text>lɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɛ_3272_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>encore ; (avec négation) ne … plus</text></gloss>
      <gloss lang="en"><text>still; (with negation) no longer, any more</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 775 occurrences, first GEN.4.14</text></form></note>
    <note><form lang="fr"><text>poonpoondo muungu lɛ ndu o ibuŋ te « la colombe ne revint plus vers lui » (Gn 8,12).</text></form></note>
  </entry>
  <entry id="lɛ ba_3273">
    <lexical-unit><form lang="kqs"><text>lɛ ba</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lɛ ba_3273_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ne… plus</text></gloss>
      <gloss lang="en"><text>no longer, not any more</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 32: lɛ ba</text></form></note>
    <note><form lang="fr"><text>Cf. … tiw lɛ ba « on ne peut plus » (2SA.14.14 ; JDG.21.18) ; analyse à confirmer.</text></form></note>
  </entry>
  <entry id="lɛan_3274">
    <lexical-unit><form lang="kqs"><text>lɛan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>luɛn</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>liɛn</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="lɛan_3274_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>miel</text></gloss>
      <gloss lang="en"><text>honey</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.43.11; Keita 1979, p. 136: Lian; Paulme 1964, p. 59 (G/K): luɛ̃; Lexique kissi–français, p. 32: lian; Childs 2000, p. 230: lìáŋ</text></form></note>
    <note><form lang="fr"><text>Keita écrit Lian ; la Bible écrit lɛan. Lexique kissi–français, p. 32 : écrit lian « le miel ». Paulme 1964, p. 59 : luɛ̃ (K.), lyɛ̃ (G.) « miel ». Paulme : luɛ̃ /K./, lyɛ̃ /G./ (p. 59).</text></form></note>
  </entry>
  <entry id="lɛfe_3275">
    <lexical-unit><form lang="kqs"><text>lɛfe</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛfe_3275_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>raphia</text></gloss>
      <gloss lang="en"><text>raffia palm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 56: lɛfe</text></form></note>
  </entry>
  <entry id="lɛfɔɔ_3276">
    <lexical-unit><form lang="kqs"><text>lɛfɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>lɛfɛ</text></form></variant>
    <sense id="lɛfɔɔ_3276_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>drapeau, étendard</text></gloss>
      <gloss lang="en"><text>flag, banner</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flag; also a wind-blown bamboo noisemaker that scares birds</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Lèföö; Lexique kissi–français, p. 32: lɛfɔɔ; Terminologie (histoire), n° 264: Lèfè kolaa; Childs 2000, p. 229: lɛ̀fɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale lɛfɛ « étendard » dans la Bible (Ex 17,15 ; Nb 2,2), comme dɛ̀ndɛ̀ pour dɛ̀ndɔ̀ɔ́. Académie des langues (terminologie, histoire n° 264) : lɛfɛ kolaa « drapeau ».</text></form></note>
  </entry>
  <entry id="lɛfɛla kolalan lɛɛnduuo_3277">
    <lexical-unit><form lang="kqs"><text>lɛfɛla kolalan lɛɛnduuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛfɛla kolalan lɛɛnduuo_3277_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pavoisement</text></gloss>
      <gloss lang="en"><text>decking with flags</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 197: Lèfèla kolalan lèènduuo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lɛ̀ìyó_3278">
    <lexical-unit><form lang="kqs"><text>lɛ̀ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɛ̀ìyó_3278_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de fourmi rouge (piqûre douloureuse)</text></gloss>
      <gloss lang="en"><text>kind of red ant (painful bite)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ̀ìyó</text></form></note>
  </entry>
  <entry id="lɛ́kpɛ́í_3279">
    <lexical-unit><form lang="kqs"><text>lɛ́kpɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lɛ́kpɛ́í_3279_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sanglots, fait de pleurer beaucoup</text></gloss>
      <gloss lang="en"><text>sobbing, crying a lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ́kpɛ́í</text></form></note>
  </entry>
  <entry id="lɛlɔn_3280">
    <lexical-unit><form lang="kqs"><text>lɛlɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛlɔn_3280_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèpre</text></gloss>
      <gloss lang="en"><text>leprosy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Lèlön; Lexique kissi–français, p. 32: lɛlɔn; Childs 2000, p. 229: lɛ̀lɔ̌ŋ</text></form></note>
  </entry>
  <entry id="lɛmbɔɔ_3281">
    <lexical-unit><form lang="kqs"><text>lɛmbɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛmbɔɔ_3281_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>caleçon ; cache-sexe (bila, porté avant la circoncision)</text></gloss>
      <gloss lang="en"><text>underpants; loincloth (worn before circumcision)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 56: lɛmbɔ; Lexique kissi–français, p. 32: lɛnbɔɔ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 56 : lɛmbɔ « le bila soudanais ; il se porte avant la circoncision, après le cache-sexe bafɔ ».</text></form></note>
  </entry>
  <entry id="lɛ̀mbɛ̀-làkpáùwó_3282">
    <lexical-unit><form lang="kqs"><text>lɛ̀mbɛ̀-làkpáùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɛ̀mbɛ̀-làkpáùwó_3282_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagne de ceinture des filles</text></gloss>
      <gloss lang="en"><text>girl's waist cloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ̀mbɛ̀-làkpáùwó</text></form></note>
  </entry>
  <entry id="lɛmbɛla_3283">
    <lexical-unit><form lang="kqs"><text>lɛmbɛla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɛmbɛla_3283_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>culottes, caleçons (lɛmbɛla lebɛngulan « caleçons »)</text></gloss>
      <gloss lang="en"><text>breeches, undergarments (lɛmbɛla lebɛngulan, undertrousers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>trousers, pants; lɛ̀mbɛ̀lɛ̀-bɛ̀ŋóó underwear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.28.42; Childs 2000, p. 229: lɛ̀mbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas attesté. À distinguer de lɛmbɛ-vílɛ́i (DEU.7.14).</text></form></note>
  </entry>
  <entry id="lɛmbɛvilɛiyo_3284">
    <lexical-unit><form lang="kqs"><text>lɛmbɛvilɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="lɛmbɛvilɛiyo_3284_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pantalon</text></gloss>
      <gloss lang="en"><text>trousers</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Lèmbèvilèiyo; Lexique kissi–français, p. 32: lɛnbɛvilɛiyo; Childs 2000, p. 229: lɛ̀mbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Childs : lɛ̀mbɔ̀ɔ́, pl. lɛ̀mbɛ̀láŋ « pantalon ». La Bible a lɛmbɛla lebɛngulan « caleçons » (Ex 28,42) ; lɛmbɛ-vílɛ́i (Dt 7,14) y signifie « stérile ».</text></form></note>
  </entry>
  <entry id="lɛnsosio_3285">
    <lexical-unit><form lang="kqs"><text>lɛnsosio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛnsosio_3285_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cimeterre (remis jadis par le chef à ses envoyés)</text></gloss>
      <gloss lang="en"><text>scimitar (formerly given by the chief to his envoys)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 56: lɛnsosyo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 56 : signe de leur mission (Fangamadou).</text></form></note>
  </entry>
  <entry id="lɛu_3286">
    <lexical-unit><form lang="kqs"><text>lɛu</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lɛa</text></form></field>
    <sense id="lɛu_3286_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abeille</text></gloss>
      <gloss lang="en"><text>bee</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Lèu; Lexique kissi–français, p. 32: lɛu</text></form></note>
    <note><form lang="fr"><text>Le singulier n'est pas dans la Bible ; le pluriel lɛa « abeilles » y est (DEU.1.44, JDG.14.8).</text></form></note>
  </entry>
  <entry id="lɛvve_3287">
    <lexical-unit><form lang="kqs"><text>lɛvve</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛvve_3287_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terme</text></gloss>
      <gloss lang="en"><text>term</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 399: Lèvve</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lɛvɔ_3288">
    <lexical-unit><form lang="kqs"><text>lɛvɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lɛvon</text></form></field>
    <sense id="lɛvɔ_3288_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>branche, support</text></gloss>
      <gloss lang="en"><text>branch, support</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 56: lɛwɔ, pl. lɛwã</text></form></note>
    <note><form lang="fr"><text>La Bible a le pluriel lɛvon « branches (de la vigne) » (JER.6.9). Paulme : hala nɔ lɛwole « le ciel se tient sans branche, ne possède pas de support ».</text></form></note>
  </entry>
  <entry id="lɛvɛnndo_3289">
    <lexical-unit><form lang="kqs"><text>lɛvɛnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɛvɛn</text></form></variant>
    <sense id="lɛvɛnndo_3289_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>levain</text></gloss>
      <gloss lang="en"><text>leaven, yeast</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.12.15</text></form></note>
    <note><form lang="fr"><text>bulu toosian a lɛvɛn too « pain sans levain ».</text></form></note>
  </entry>
  <entry id="lɛwve_3290">
    <lexical-unit><form lang="kqs"><text>lɛwve</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lɛwvon</text></form></field>
    <variant><form lang="kqs"><text>lɛvii</text></form></variant>
    <variant><form lang="kqs"><text>lɛvun</text></form></variant>
    <variant><form lang="kqs"><text>lɛvi</text></form></variant>
    <sense id="lɛwve_3290_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>branche d'arbre</text></gloss>
      <gloss lang="en"><text>branch</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.49.11; Keita 1979, p. 139: Lèwve; Lexique kissi–français, p. 32: lɛwve; Childs 2000, p. 230: lèùwé</text></form></note>
  </entry>
  <entry id="lɛŋ_3291">
    <lexical-unit><form lang="kqs"><text>lɛŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɛŋ_3291_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>à terre, par terre, en bas</text></gloss>
      <gloss lang="en"><text>on the ground, down</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 329 occurrences, first GEN.1.24; Childs 2000, p. 229: lɛ̀ŋ</text></form></note>
    <note><form lang="fr"><text>mó del lɛŋ « il tomba à terre » (MRK.9.20) ; cf. lɛŋnden « terre, pays ».</text></form></note>
  </entry>
  <entry id="lɛ́ŋgbùŋ-_3292">
    <lexical-unit><form lang="kqs"><text>lɛ́ŋgbùŋ-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lɛ́ŋgbùŋ-_3292_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>souple, flexible</text></gloss>
      <gloss lang="en"><text>soft, flexible, pliable</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ́ŋgbùŋ-</text></form></note>
  </entry>
  <entry id="lɛ́ŋgbɔ̀ŋ_3293">
    <lexical-unit><form lang="kqs"><text>lɛ́ŋgbɔ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lɛ́ŋgbɔ̀ŋ_3293_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souplement</text></gloss>
      <gloss lang="en"><text>flexibly, pliantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ́ŋgbɔ̀ŋ</text></form></note>
  </entry>
  <entry id="lɛ̀ŋgbɛ́sɔ́ɔ́_3294">
    <lexical-unit><form lang="kqs"><text>lɛ̀ŋgbɛ́sɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lɛ̀ŋgbɛ́súéí</text></form></field>
    <variant><form lang="kqs"><text>lɛ̀ŋgbɛ́síɔ́</text></form></variant>
    <sense id="lɛ̀ŋgbɛ́sɔ́ɔ́_3294_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à baies dont le jus soigne le mal de dents</text></gloss>
      <gloss lang="en"><text>tree whose berry juice treats toothache</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ̀ŋgbɛ́sɔ́ɔ́</text></form></note>
  </entry>
  <entry id="lɛŋii biyɛi_3295">
    <lexical-unit><form lang="kqs"><text>lɛŋii biyɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛŋii biyɛi_3295_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pays colonisés</text></gloss>
      <gloss lang="en"><text>colonized countries</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 485: Lènhii biyèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). lɛŋii, pluriel de lɛŋnden « pays ».</text></form></note>
  </entry>
  <entry id="lɛŋii delcooe_3296">
    <lexical-unit><form lang="kqs"><text>lɛŋii delcooe</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛŋii delcooe_3296_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pays colonisateur(s)</text></gloss>
      <gloss lang="en"><text>colonizing countries</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 486: Lènhii deltyooe</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. delcoonɔɔ « colonisateur ».</text></form></note>
  </entry>
  <entry id="lɛŋnde ba handaa coolen_3297">
    <lexical-unit><form lang="kqs"><text>lɛŋnde ba handaa coolen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛŋnde ba handaa coolen_3297_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pays sous tutelle</text></gloss>
      <gloss lang="en"><text>trust territory</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 462: Lènnde ba handaa tyoolen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="lɛŋnde biyaalen_3298">
    <lexical-unit><form lang="kqs"><text>lɛŋnde biyaalen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lɛŋnde biyaalen_3298_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colonie</text></gloss>
      <gloss lang="en"><text>colony</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 165: Lènnde biyaalen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « pays saisi » (lɛŋnden « pays », biyɔɔ « saisir »).</text></form></note>
  </entry>
  <entry id="lɛŋnde ibɛmɛi_3299">
