    <sense id="kílì-kílì_1361_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>petits pas rapides (de petits animaux la nuit)</text></gloss>
      <gloss lang="en"><text>pitter-patter of small animals' footsteps at night</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 165: kílì-kílì</text></form></note>
  </entry>
  <entry id="kiliiyɔmnɔɔ_1362">
    <lexical-unit><form lang="kqs"><text>kiliiyɔmnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kiliiyɔmnɔɔ_1362_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bûcheron</text></gloss>
      <gloss lang="en"><text>woodcutter</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
