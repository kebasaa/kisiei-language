  <entry id="yɛ́ndɛ́la_6350">
    <lexical-unit><form lang="kqs"><text>yɛ́ndɛ́la</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛ́ndɛ́la_6350_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>plat (pierre plate)</text></gloss>
      <gloss lang="en"><text>flat (of a stone slab)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.24.12</text></form></note>
    <note><form lang="fr"><text>powta yɛ́ndɛ́la « tables de pierre ».</text></form></note>
  </entry>
  <entry id="yɛngian_6351">
    <lexical-unit><form lang="kqs"><text>yɛngian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛngian_6351_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>nouveau, doux (vin) : mɔima yɛngian « vin nouveau, moût » ; premier vin de palme de la récolte</text></gloss>
      <gloss lang="en"><text>new, sweet (wine): mɔima yɛngian 'new wine, must'; first palm wine of the harvest</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.18.12; Paulme 1964, p. 127: yeŋya, yeŋiya, yeŋiya; Lexique kissi–français, p. 64: yengian</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 64 : yengian « la première goutte de la première récolte de vin de palmier ». Paulme 1964, p. 127 : vin de palme très sucré en hivernage, très fort, qui se boit aussitôt recueilli.</text></form></note>
  </entry>
  <entry id="yɛngiyo_6352">
    <lexical-unit><form lang="kqs"><text>yɛngiyo</text></form></lexical-unit>
