      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se raser, se coiffer</text></gloss>
      <gloss lang="en"><text>shave oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sendinndo</text></form></note>
    <note><form lang="fr"><text>Moyen de sendio. Formes attestées dans la Bible : sendin (LEV 13,33), sendinnin.</text></form></note>
  </entry>
  <entry id="sendinɔɔ_2934">
    <lexical-unit><form lang="kqs"><text>sendinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
