    <note type="source"><form lang="en"><text>BKG: 172 occurrences, first GEN.2.9; Childs 2000, p. 48: cìndàá</text></form></note>
  </entry>
  <entry id="ciŋ_216">
    <lexical-unit><form lang="kqs"><text>ciŋ</text></form></lexical-unit>
