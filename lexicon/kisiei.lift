  <entry id="latɔ́ɔ́_3068">
    <lexical-unit><form lang="kqs"><text>latɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>latɔ́ɔ́a</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́lan</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́-tɔ́ɔ́</text></form></variant>
    <sense id="latɔ́ɔ́_3068_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noble, grand, précieux</text></gloss>
      <gloss lang="en"><text>noble, great, precious</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.30.20</text></form></note>
    <note><form lang="fr"><text>vanaa latɔ́ɔ́a « les grands » (Jb 3,14). Redoublé latɔ́ɔ́-tɔ́ɔ́ : ɲɛ latɔ́ɔ́-tɔ́ɔ́ « un beau présent » (Gn 30,20) ; Hala latɔ́ɔ́-tɔ́ɔ́ « le Dieu puissant » (Is 10,21).</text></form></note>
  </entry>
  <entry id="làùwó_3069">
    <lexical-unit><form lang="kqs"><text>làùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="làùwó_3069_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tortiller (comme un serpent)</text></gloss>
      <gloss lang="en"><text>wriggle (like a snake), squirm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làùwó</text></form></note>
  </entry>
  <entry id="lavonse_3070">
    <lexical-unit><form lang="kqs"><text>lavonse</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lavonse_3070_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>bonjour (à plusieurs personnes)</text></gloss>
      <gloss lang="en"><text>hello (to several people)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 55: lavonse</text></form></note>
    <note><form lang="fr"><text>Paulme : « bonjour (collectif) ».</text></form></note>
  </entry>
  <entry id="lavɔɔ_3071">
    <lexical-unit><form lang="kqs"><text>lavɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>law</text></form></variant>
    <sense id="lavɔɔ_3071_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tresses, coiffure tressée ; (law) tresser</text></gloss>
      <gloss lang="en"><text>braids, braided hairstyle; (law) braid, plait</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) plait, braid, weave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.3.24; Paulme 1964, p. 56: lawo, lawɔ; Lexique kissi–français, p. 31: lavɔɔ; Childs 2000, p. 224: làùwɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>lavɔɔ kɛndɛ o lebol « une belle coiffure » (ISA.3.24) ; A law lavɔɔ báà kala le « qu'elles ne se fassent pas de tresses » (1TI.2.9). Correspondance w (Childs) ~ v (Bible). Cf. lɔu « tresser, tisser ». À distinguer de lavɔɔn « aisselles ; en secret ». Lexique kissi–français, p. 31 : law yinde « tresser (les cheveux) ». Paulme 1964, p. 56 : lawo « coiffure » ; lawo bundo « coiffure des filles du bundo ».</text></form></note>
  </entry>
  <entry id="làwáá_3072">
    <lexical-unit><form lang="kqs"><text>làwáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làwáá_3072_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mille-pattes</text></gloss>
      <gloss lang="en"><text>millipede</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 225: làwáá</text></form></note>
  </entry>
  <entry id="lawdɛndɛcoo_3073">
    <lexical-unit><form lang="kqs"><text>lawdɛndɛcoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lawdɛndɛcoo_3073_s1">
