    <sense id="fisa_862_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>meilleur, préférable (o co fisa « il vaut mieux »)</text></gloss>
      <gloss lang="en"><text>better, preferable (o co fisa 'it is better')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
