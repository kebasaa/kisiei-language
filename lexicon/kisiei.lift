<?xml version="1.0" encoding="UTF-8"?>
<lift version="0.13" producer="Kisie tools/build_lexicon.py">
  <entry id="-àlè_1">
    <lexical-unit><form lang="kqs"><text>-àlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-àlè_1_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule emphatique (après un ordre, une salutation)</text></gloss>
      <gloss lang="en"><text>emphatic tag (after commands, greetings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: -àlè</text></form></note>
  </entry>
  <entry id="-náá_2">
    <lexical-unit><form lang="kqs"><text>-náá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-náá_2_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>tout petit, très peu (suffixe, seulement pour des choses petites ou courtes)</text></gloss>
      <gloss lang="en"><text>very (small) (suffix, only with small or short things)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.9 Affixes"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 257: -náá</text></form></note>
  </entry>
  <entry id="a_3">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_3_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>tu ; ils, elles (sujet)</text></gloss>
      <gloss lang="en"><text>you (sg.); they (subject)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1; Paulme 1964, p. 1: a; Lexique kissi–français, p. 3: a</text></form></note>
  </entry>
  <entry id="a_4">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_4_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>avec ; et</text></gloss>
      <gloss lang="en"><text>with; and</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1; Lexique kissi–français, p. 3: a</text></form></note>
  </entry>
  <entry id="a yandi_5">
    <lexical-unit><form lang="kqs"><text>a yandi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a yandi_5_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>s'il te plaît, je t'en prie</text></gloss>
      <gloss lang="en"><text>please</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yándíí</text></form></note>
  </entry>
  <entry id="a … ni_6">
    <lexical-unit><form lang="kqs"><text>a … ni</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="a … ni_6_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>devant, avant (a … ni)</text></gloss>
      <gloss lang="en"><text>before, in front of (a … ni)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.1 Front"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 1: a… ni</text></form></note>
    <note><form lang="fr"><text>Paulme : a nɔm ni « devant toi », a ndu ni « avant lui ». Dans la Bible, a … ni suit surtout les verbes de comparaison ou de faute (« plus que lui », « envers toi » : DEU.34.10, JER.14.7) ; le sens « devant, avant » est à confirmer.</text></form></note>
  </entry>
  <entry id="aa_7">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="aa_7_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>introduit les paroles rapportées</text></gloss>
      <gloss lang="en"><text>quotative particle</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'like, as' (comparison)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8249 occurrences, first GEN.1.3; Paulme 1964, p. 1: a; Childs 2000, p. 2: àà</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 1 : a « que » (a dimu nyafindo a i yu wa « tu as dit à la panthère que j'étais vieux »).</text></form></note>
  </entry>
  <entry id="aa_8">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="aa_8_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>il, elle, ils, elles (avant le verbe, au plus-que-parfait)</text></gloss>
      <gloss lang="en"><text>he, she, they (before the verb, pluperfect)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: aa</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « il, elle, ils, elles avaient (avant les verbes dans le plus-que-parfait) ». Forme et tons à vérifier dans la Bible (cf. ndóò, ndáà « passé révolu ») ; homographe de aa (paroles rapportées).</text></form></note>
  </entry>
  <entry id="akasia_9">
    <lexical-unit><form lang="kqs"><text>akasia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="akasia_9_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acacia (pɛngɛn akasia « bois d'acacia »)</text></gloss>
      <gloss lang="en"><text>acacia (pɛngɛn akasia 'acacia wood')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.25.5</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="alaadio_10">
    <lexical-unit><form lang="kqs"><text>alaadio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="alaadio_10_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poste de radio</text></gloss>
      <gloss lang="en"><text>radio set</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 207: Alaadio</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Emprunt au français.</text></form></note>
  </entry>
  <entry id="aliene_11">
    <lexical-unit><form lang="kqs"><text>aliene</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="aliene_11_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel</text></gloss>
      <gloss lang="en"><text>sky</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 1: Aryene</text></form></note>
    <note><form lang="fr"><text>Paulme écrit le mot avec une majuscule (peut-être le ciel personnifié). Absent de la Bible, qui dit halataalaa ; forme et sens à confirmer.</text></form></note>
  </entry>
  <entry id="alumeco_12">
    <lexical-unit><form lang="kqs"><text>alumeco</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="alumeco_12_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>allumettes</text></gloss>
      <gloss lang="en"><text>matches</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 1: alumetyo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; selon Paulme, toujours au pluriel.</text></form></note>
  </entry>
  <entry id="amanndiee_13">
    <lexical-unit><form lang="kqs"><text>amanndiee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="amanndiee_13_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amande, amandier (yɔm amanndiee)</text></gloss>
      <gloss lang="en"><text>almond, almond tree (yɔm amanndiee)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.30.37</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="amoniɔmndo_14">
    <lexical-unit><form lang="kqs"><text>amoniɔmndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="amoniɔmndo_14_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>harmonium</text></gloss>
      <gloss lang="en"><text>harmonium</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 147: Amoniömndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Emprunt au français.</text></form></note>
  </entry>
  <entry id="ansan_15">
    <lexical-unit><form lang="kqs"><text>ansan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ansan_15_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>encens</text></gloss>
      <gloss lang="en"><text>incense</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 94 occurrences, first EXO.25.6</text></form></note>
  </entry>
  <entry id="antele_16">
    <lexical-unit><form lang="kqs"><text>antele</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="antele_16_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>formule de politesse (à midi)</text></gloss>
      <gloss lang="en"><text>polite greeting (at midday)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 104: tele, tɛle</text></form></note>
    <note><form lang="fr"><text>Paulme, s.v. tele, tɛle : antele. Voir aussi vuntele. Découpage à confirmer.</text></form></note>
  </entry>
  <entry id="ava_17">
    <lexical-unit><form lang="kqs"><text>ava</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ava_17_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>d'accord, eh bien</text></gloss>
      <gloss lang="en"><text>all right, well then</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.30.15; Lexique kissi–français, p. 3: ava</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, Ava ouvre une réplique (GEN.30.15, JDG.14.13 « Ava, dis ton énigme »).</text></form></note>
  </entry>
  <entry id="avokaanɔɔ_18">
    <lexical-unit><form lang="kqs"><text>avokaanɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="avokaanɔɔ_18_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avocat</text></gloss>
      <gloss lang="en"><text>lawyer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 100: Avokaanöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Emprunt au français.</text></form></note>
  </entry>
  <entry id="awa_19">
    <lexical-unit><form lang="kqs"><text>awa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="awa_19_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>eh bien, alors (en tête de phrase)</text></gloss>
      <gloss lang="en"><text>well, so (sentence-initial)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>Sandara Kisia, fable 4: Awa</text></form></note>
    <note><form lang="fr"><text>Sens d'après le contexte : ouvre une nouvelle étape du récit (fable 4, Awa, o laŋ nɔm nɔ ho lebɛŋgu ni « Eh bien, cette année c'est vous qui avez le bas » ; fable 17, Awa, mi tɔmndo dimul wɛindo…). Sans doute emprunt (malinké awa « bon, d'accord ») ; absent de la Bible.</text></form></note>
  </entry>
  <entry id="ba_20">
    <lexical-unit><form lang="kqs"><text>ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba_20_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté ; (o … ba) chez, auprès de, aux mains de ; (a ba …) du côté de</text></gloss>
      <gloss lang="en"><text>side; (o … ba) with, at, in the hands of; (a ba …) towards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3579 occurrences, first GEN.2.8; Paulme 1964, p. 3: ba; Lexique kissi–français, p. 3: ba</text></form></note>
    <note><form lang="fr"><text>a ba paalen le can-ndo « à l'est » ; o ba bɛngu « sous l'autorité de ». Lexique kissi–français, p. 3 : ba, a ba « vers, de ». Aussi Lexique kissi–français, p. 40 : « o ba ». Lexique kissi–français, p. 40 : o ba « en possession de ».</text></form></note>
  </entry>
  <entry id="bâ_21">
    <lexical-unit><form lang="kqs"><text>bâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bâ_21_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une goutte qui tombe sur une surface lisse</text></gloss>
      <gloss lang="en"><text>sound of a drop falling on a smooth surface</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: bâ</text></form></note>
  </entry>
  <entry id="ba hiwvaa_22">
    <lexical-unit><form lang="kqs"><text>ba hiwvaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ba hiwvaa_22_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abus</text></gloss>
      <gloss lang="en"><text>abuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 7: Ba hiwvaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="ba kɛndɔɔ_23">
    <lexical-unit><form lang="kqs"><text>ba kɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba kɛndɔɔ_23_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main droite, droite ; (o ba kɛndɔɔ coo) à droite</text></gloss>
      <gloss lang="en"><text>right hand, right side; (o ba kɛndɔɔ coo) on the right</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 43: kɛndo; Lexique kissi–français, p. 3: baa kɛndɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit baa kɛndɔɔ et baa kɛndɛ (p. 3) ; la Bible écrit ba kɛndɔɔ (o ba kɛndɔɔ coo « à droite », GEN.13.9). Paulme 1964, p. 43 : ba kɛndo « main droite », ba kɛɛndo « côté droit » ; kɛndo « juste » (masa kɛndo ni « le chef est juste »).</text></form></note>
  </entry>
  <entry id="ba loo_24">
    <lexical-unit><form lang="kqs"><text>ba loo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ba loo_24_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignet</text></gloss>
      <gloss lang="en"><text>wrist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: ba loo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, (o) ba loo signifie plutôt « dans la main » (2SA.23.6, MAT.13.12). Le sens « poignet » est à confirmer ; cf. bakpeŋndo « poignet ».</text></form></note>
  </entry>
  <entry id="ba mɛllo_25">
    <lexical-unit><form lang="kqs"><text>ba mɛllo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba mɛllo_25_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main gauche, gauche ; (o ba mɛllo coo) à gauche</text></gloss>
      <gloss lang="en"><text>left hand, left side; (o ba mɛllo coo) on the left</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: bamɛllo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit bamɛllo en un mot ; la Bible écrit ba mɛllo (GEN.13.9).</text></form></note>
  </entry>
  <entry id="ba pilɛ_26">
    <lexical-unit><form lang="kqs"><text>ba pilɛ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ba pilɛ_26_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>proche, à côté</text></gloss>
      <gloss lang="en"><text>near, beside</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: ba pilɛ</text></form></note>
    <note><form lang="fr"><text>La Bible a o ba pilɛ « d'une main, d'un côté » (JDG.5.26, JOB.42.15). Le sens « proche » du Lexique est à confirmer.</text></form></note>
  </entry>
  <entry id="bà-ó-bà_27">
    <lexical-unit><form lang="kqs"><text>bà-ó-bà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bà-ó-bà_27_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, où que ce soit</text></gloss>
      <gloss lang="en"><text>everywhere, wherever</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 8: bà-ó-bà</text></form></note>
  </entry>
  <entry id="bàà_28">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bàà_28_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>est-ce que (en tête de question) ; ou bien</text></gloss>
      <gloss lang="en"><text>question marker (sentence-initial); or</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>or, whether</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Childs 2000, p. 2: bàà</text></form></note>
    <note><form lang="fr"><text>Bàà nuaa Hala dimul niaa ni ... ? « Dieu a-t-il vraiment dit ... ? » (GEN.3.1) ; Bàà mì vin Abraham ... ? « Cacherai-je à Abraham ... ? » (GEN.18.17). Ne pas confondre avec baa « main ».</text></form></note>
  </entry>
  <entry id="báà_29">
    <lexical-unit><form lang="kqs"><text>báà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="báà_29_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix, valeur</text></gloss>
      <gloss lang="en"><text>price, value</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 17: Baa (T H D); Lexique kissi–français, p. 3: baa; Terminologie (idéologie), n° 643: Baa; Childs 2000, p. 3: báá</text></form></note>
    <note><form lang="fr"><text>Keita oppose Baa (ton haut) « le prix » à Baa (ton bas) « la main » ; Fallo vèè kolaa hoo nö yè baa « Monsieur, quel est le prix de ce pagne ? » (p. 59). La Bible écrit báà : mɛɛ cɔlu kon nɔ báà yɛ « selon le prix de l'animal » (Ex 21,34) ; powta báà kàlàla « pierres de grand prix, pierres précieuses » (Ex 25,7) ; ɲɛm báà kalan « objets de valeur » (2 R 20,13). Académie des langues (terminologie, idéologie n° 643, 644) : « valeur » ; baa yɔngoo « valorisation ».</text></form></note>
  </entry>
  <entry id="baa_30">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>balan</text></form></field>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <variant><form lang="kqs"><text>bao</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>baran</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="baa_30_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main, bras</text></gloss>
      <gloss lang="en"><text>hand, arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hand, arm; also way, fork in a road</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 131: Baa; Paulme 1964, p. 3 (G): baa, pl. balã; Lexique kissi–français, p. 3: baa; Childs 2000, p. 2: bàá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 3 : baa, pl. balã /G./, bao, pl. barã /K./ ; wana ba pilɔ « manchot ». Paulme : baa, pl. balã /G./ ; bao, pl. barã /K./ (p. 3).</text></form></note>
  </entry>
  <entry id="baa_31">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <variant><form lang="kqs"><text>bee</text></form></variant>
    <sense id="baa_31_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, accrocher</text></gloss>
      <gloss lang="en"><text>tie, hang</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baa; Lexique kissi–français, p. 3: baa/ ba, bee</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : ba, bee. baa est très courant dans la Bible mais avec d'autres sens ; le moyen baanun « attacher » y est attesté (EXO 28,28). Lexique kissi–français, p. 3-4 : baa/ ba, bee « attacher un animal » ; confirmé au Nord.</text></form></note>
  </entry>
  <entry id="baa_32">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baa_32_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>plus (comparatif, avec le)</text></gloss>
      <gloss lang="en"><text>more (comparative, with le)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « plus (accompagné par le mot le) ». Emploi non retrouvé dans la Bible (le bàà y introduit une question) ; à confirmer.</text></form></note>
  </entry>
  <entry id="bàà_33">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bàà_33_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi (jour de marché à Bàà)</text></gloss>
      <gloss lang="en"><text>Monday (market day at Bàà)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bàà</text></form></note>
  </entry>
  <entry id="baa lepilɛ_34">
    <lexical-unit><form lang="kqs"><text>baa lepilɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baa lepilɛ_34_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignée</text></gloss>
      <gloss lang="en"><text>handful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa lepilɛ</text></form></note>
    <note><form lang="fr"><text>Littéralement « une main ». Non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="báà piandaa_35">
    <lexical-unit><form lang="kqs"><text>báà piandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="báà piandaa_35_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix d'achat</text></gloss>
      <gloss lang="en"><text>purchase price</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa piandaa</text></form></note>
    <note><form lang="fr"><text>Composé de báà « prix » ; non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="baa pilɔɔ_36">
    <lexical-unit><form lang="kqs"><text>baa pilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="baa pilɔɔ_36_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>un côté, l'autre côté ; poignée</text></gloss>
      <gloss lang="en"><text>one side, the other side; handful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa pilɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « poignée ; la partie de ; l'autre côté ». La Bible a baa pilɔɔ « (d')un côté, en un même lieu » (GEN.1.9, EXO.26.35) ; le sens « poignée » n'y est pas vérifié.</text></form></note>
  </entry>
  <entry id="báà pisia_37">
    <lexical-unit><form lang="kqs"><text>báà pisia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="báà pisia_37_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix de vente</text></gloss>
      <gloss lang="en"><text>selling price</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa pisia</text></form></note>
    <note><form lang="fr"><text>Composé de báà « prix » ; non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="baa yulullo_38">
    <lexical-unit><form lang="kqs"><text>baa yulullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baa yulullo_38_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre le bras, montrer (du bras, du doigt), indiquer</text></gloss>
      <gloss lang="en"><text>stretch out the arm, point (with the arm or finger)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa yulullo</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi baa yurullo (p. 3). Cf. yulu « tendre (la main) » et yulul (PSA.7.13) dans la Bible.</text></form></note>
  </entry>
  <entry id="baabandinɔɔ_39">
    <lexical-unit><form lang="kqs"><text>baabandinɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baabandinɔɔ_39_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agent</text></gloss>
      <gloss lang="en"><text>agent, official</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 34: Baabandinöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="baakeo_40">
    <lexical-unit><form lang="kqs"><text>baakeo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bakɛian</text></form></field>
    <variant><form lang="kqs"><text>bakio</text></form></variant>
    <sense id="baakeo_40_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre épineux (écorce médicinale)</text></gloss>
      <gloss lang="en"><text>thorny tree (medicinal bark)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 3: bākeo, bakio, pl. bakɛyã</text></form></note>
    <note><form lang="fr"><text>Paulme : l'écorce entre dans de nombreux remèdes contre les maux de ventre ; ce remède est donné au nouvel initié du kundo.</text></form></note>
  </entry>
  <entry id="baala folobaa_41">
    <lexical-unit><form lang="kqs"><text>baala folobaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baala folobaa_41_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>investissement humain (travail collectif)</text></gloss>
      <gloss lang="en"><text>communal labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Baala folobaa; Lexique kissi–français, p. 3: baala folobaa; Terminologie (idéologie), n° 368: Baala folobaa</text></form></note>
    <note><form lang="fr"><text>baala « travail » est attesté ; folobaa n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="baalaa_42">
    <lexical-unit><form lang="kqs"><text>baalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>baalalan</text></form></field>
    <variant><form lang="kqs"><text>baala</text></form></variant>
    <variant><form lang="kqs"><text>baalala</text></form></variant>
    <sense id="baalaa_42_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage ; service ; fonction</text></gloss>
      <gloss lang="en"><text>work; service; function, office</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 809 occurrences, first GEN.2.5; Paulme 1964, p. 5: bara, pl. baralã; Lexique kissi–français, p. 3: baalaa; Terminologie (arts), n° 183: Baalaa, Balan</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, arts n° 183 et 184) : baalaa « œuvre » ; baalaa tosaa, balan malöö « œuvrer ». Aussi Terminologie, p. 299 : « Baalaa ».</text></form></note>
  </entry>
  <entry id="baalaa kɛu_43">
    <lexical-unit><form lang="kqs"><text>baalaa kɛu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>baalaa yɔmnɔnndo</text></form></variant>
    <sense id="baalaa kɛu_43_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grève</text></gloss>
      <gloss lang="en"><text>strike</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 370: Baalaa kèu, Baalaa yömnönndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « arrêt du travail ».</text></form></note>
  </entry>
  <entry id="baalalen_44">
    <lexical-unit><form lang="kqs"><text>baalalen</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baalalen_44_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>devoir</text></gloss>
      <gloss lang="en"><text>duty, homework</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 119: Baalalen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). La Bible a baalalen une seule fois (LEV.21.10), dans un contexte qui ne permet pas de confirmer ce sens.</text></form></note>
  </entry>
  <entry id="baalandoo_45">
    <lexical-unit><form lang="kqs"><text>baalandoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>baalan</text></form></variant>
    <variant><form lang="kqs"><text>baarandoo</text></form></variant>
    <variant><form lang="kqs"><text>baaran</text></form></variant>
    <sense id="baalandoo_45_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer</text></gloss>
      <gloss lang="en"><text>attack</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baarandoo/ baaran</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. baalan existe dans la Bible avec un autre sens (EXO.29.29).</text></form></note>
  </entry>
  <entry id="baalanndo_46">
    <lexical-unit><form lang="kqs"><text>baalanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="baalanndo_46_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balafon, xylophone (des Peuls et des Malinkés)</text></gloss>
      <gloss lang="en"><text>balafon, xylophone (of the Fula and Malinke)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 3: balando, balandu; Lexique kissi–français, p. 3: baalanndo; Terminologie (arts), n° 19: Kelenndon, Balanndon</text></form></note>
    <note><form lang="fr"><text>Homographe : la Bible a baalanndo dans un autre sens (EXO.25.31, travail du métal). Paulme 1964, p. 3 : balando, balandu « xylophone ». Académie des langues (terminologie, arts n° 19) : kelenndon, balanndon « balafon ».</text></form></note>
  </entry>
  <entry id="bààlòó_47">
    <lexical-unit><form lang="kqs"><text>bààlòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààlòlàŋ</text></form></field>
    <sense id="bààlòó_47_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabouret, siège à trois pieds</text></gloss>
      <gloss lang="en"><text>stool, three-legged seat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààlòó</text></form></note>
  </entry>
  <entry id="bààmbàá_48">
    <lexical-unit><form lang="kqs"><text>bààmbàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bààmbàá_48_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, envelopper ; accrocher ; démarrer (en courant)</text></gloss>
      <gloss lang="en"><text>tie up, wrap; hook up; start off (esp. running)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààmbàá</text></form></note>
  </entry>
  <entry id="bààníŋndó_49">
    <lexical-unit><form lang="kqs"><text>bààníŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bààníŋndó_49_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de culte des ancêtres (coin de la maison où l'on dépose offrandes et libations)</text></gloss>
      <gloss lang="en"><text>place of ancestor worship (corner where offerings are placed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààníŋndó</text></form></note>
  </entry>
  <entry id="baanɔnndo_50">
    <lexical-unit><form lang="kqs"><text>baanɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>baanun</text></form></variant>
    <variant><form lang="kqs"><text>beenun</text></form></variant>
    <sense id="baanɔnndo_50_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'accrocher, s'attacher</text></gloss>
      <gloss lang="en"><text>hang on, be attached</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hang, be suspended</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baanönndo; Lexique kissi–français, p. 3: baanɔnndo/ baanun, beenun; Childs 2000, p. 4: bàànɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de baa. Forme attestée dans la Bible : baanun « attacher » (EXO 28,28 ; JDG 3,16).</text></form></note>
  </entry>
  <entry id="báásìà_51">
    <lexical-unit><form lang="kqs"><text>báásìà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="báásìà_51_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essayer, faire effort</text></gloss>
      <gloss lang="en"><text>try, strive, make an effort</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásìà</text></form></note>
  </entry>
  <entry id="báásíó_52">
    <lexical-unit><form lang="kqs"><text>báásíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>báásíláŋ</text></form></field>
    <sense id="báásíó_52_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit flacon (tabac à priser, médicament)</text></gloss>
      <gloss lang="en"><text>small container (snuff, medicine)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásíó</text></form></note>
  </entry>
  <entry id="baavaa_53">
    <lexical-unit><form lang="kqs"><text>baavaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baava</text></form></variant>
    <sense id="baavaa_53_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau ; bath (mesure de liquides)</text></gloss>
      <gloss lang="en"><text>bucket, pail; bath (liquid measure)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EZK.45.11; Childs 2000, p. 4: báávàá</text></form></note>
    <note><form lang="fr"><text>mɛmma ... o baava « une goutte d'un seau » (ISA.40.15) ; mesure de liquides en EZK.45.11.</text></form></note>
  </entry>
  <entry id="bààyàléŋ_54">
    <lexical-unit><form lang="kqs"><text>bààyàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààyààŋ</text></form></field>
