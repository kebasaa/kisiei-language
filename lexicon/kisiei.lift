    <sense id="ndáà_2406_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>ils, elles (passé révolu)</text></gloss>
      <gloss lang="en"><text>they (remote past)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3298 occurrences, first GEN.6.3</text></form></note>
  </entry>
  <entry id="ndaa_2407">
    <lexical-unit><form lang="kqs"><text>ndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ndaa_2407_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>leur</text></gloss>
      <gloss lang="en"><text>their</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3298 occurrences, first GEN.6.3; Childs 2000, p. 266: ndà-</text></form></note>
