      <gloss lang="fr"><text>dégoûter, devenir odieux à ; avoir en horreur</text></gloss>
      <gloss lang="en"><text>disgust, become loathsome to; loathe</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>vomit on oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.37.8; Childs 2000, p. 192: kùìsíŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de kuisio « vomir » : X kuisin Y o kɔl « X devient odieux à Y » (2 S 13,15).</text></form></note>
  </entry>
  <entry id="kuisio_843">
    <lexical-unit><form lang="kqs"><text>kuisio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuisi</text></form></variant>
