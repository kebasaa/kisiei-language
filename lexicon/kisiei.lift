      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parenté</text></gloss>
      <gloss lang="en"><text>kinship, relatives</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>relative, member of the same family</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first GEN.13.8; Keita 1979, p. 149: Vanayèi; Lexique kissi–français, p. 60: vanayɛi; Childs 2000, p. 380: wànàyɛ́í</text></form></note>
  </entry>
