    <field type="southern-kissi-sense"><form lang="en"><text>just, only, alone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 489 occurrences, first GEN.7.2; Childs 2000, p. 176: kóní</text></form></note>
  </entry>
