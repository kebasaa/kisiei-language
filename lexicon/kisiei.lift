  <entry id="nɔw_2467">
    <lexical-unit><form lang="kqs"><text>nɔw</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>nɔ</text></form></variant>
    <sense id="nɔw_2467_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir</text></gloss>
      <gloss lang="en"><text>have</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4 Have, be with"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Nöw</text></form></note>
    <note><form lang="fr"><text>Keita : « Avoir, … » (glose tronquée). nɔ « avoir » est courant dans la Bible ; la forme longue nɔw n'y est pas (nɔ̀u = « épouse »).</text></form></note>
  </entry>
  <entry id="nɔɔla_2468">
    <lexical-unit><form lang="kqs"><text>nɔɔla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɔɔla_2468_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être impur, devenir souillé</text></gloss>
      <gloss lang="en"><text>be unclean, become defiled</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>soil, get dirty; make lazy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first LEV.11; Childs 2000, p. 264: nɔ̀ɔ̀làá</text></form></note>
    <note><form lang="fr"><text>vana pilan nda pɛ, vana kon nɔɔla « quiconque les touche sera impur » (LEV.11.24). Cf. nɔɔliaa « souiller » et nɔɔlɛiyo « impur ».</text></form></note>
  </entry>
  <entry id="nɔ́ɔ́lì-nɔ́ɔ́lì_2469">
    <lexical-unit><form lang="kqs"><text>nɔ́ɔ́lì-nɔ́ɔ́lì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="nɔ́ɔ́lì-nɔ́ɔ́lì_2469_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sale, crasseux</text></gloss>
      <gloss lang="en"><text>dirty, filthy</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 265: nɔ́ɔ́lì-nɔ́ɔ́lì</text></form></note>
    <note><form lang="fr"><text>Cf. nɔɔla, nɔɔliaa « être impur, souiller » (Bible).</text></form></note>
  </entry>
  <entry id="nɔɔliaa_2470">
    <lexical-unit><form lang="kqs"><text>nɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɔɔlian</text></form></variant>
    <sense id="nɔɔliaa_2470_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souiller, profaner ; (nɔɔlian) être souillé</text></gloss>
      <gloss lang="en"><text>defile, profane; (nɔɔlian) be defiled</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make dirty</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.49.4; Childs 2000, p. 265: nɔ̀ɔ̀lìá</text></form></note>
  </entry>
  <entry id="nɔɔlɛiyo_2471">
    <lexical-unit><form lang="kqs"><text>nɔɔlɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɔɔlɛi</text></form></variant>
    <variant><form lang="kqs"><text>nɔɔlɛila</text></form></variant>
    <variant><form lang="kqs"><text>nɔɔlɛilan</text></form></variant>
    <variant><form lang="kqs"><text>nɔɔlɛiya</text></form></variant>
    <variant><form lang="kqs"><text>nɔɔlɛiyon</text></form></variant>
    <sense id="nɔɔlɛiyo_2471_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>impur, abominable ; (dɛnɛ nɔɔlɛi) abomination</text></gloss>
      <gloss lang="en"><text>unclean, abominable; (dɛnɛ nɔɔlɛi) abomination</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dirty</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 150 occurrences, first EXO.23.24; Childs 2000, p. 264: nɔ̀ɔ̀lɛ́í-</text></form></note>
  </entry>
  <entry id="nɛ_2472">
    <lexical-unit><form lang="kqs"><text>nɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛ_2472_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule de mise en relief dans les questions (yɛɛ nɛ … yɛ ?)</text></gloss>
      <gloss lang="en"><text>focus particle in questions (yɛɛ nɛ … yɛ?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 643 occurrences, first GEN.3.9</text></form></note>
  </entry>
  <entry id="nɛa soalaa_2473">
    <lexical-unit><form lang="kqs"><text>nɛa soalaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="nɛa soalaa_2473_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieux d'aisance, latrines</text></gloss>
      <gloss lang="en"><text>latrine, toilet</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Nèa soalaa</text></form></note>
    <note><form lang="fr"><text>Forme et découpage à confirmer.</text></form></note>
  </entry>
  <entry id="nɛinun_2474">
    <lexical-unit><form lang="kqs"><text>nɛinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛinun_2474_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déplaire, être odieux (à quelqu'un)</text></gloss>
      <gloss lang="en"><text>displease, be hateful to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 75 occurrences, first GEN.37.5</text></form></note>
    <note><form lang="fr"><text>dɛnɛ ndɔ kon nɛinun Mɛlɛka « ce qu'il faisait déplut au Seigneur » (Gn 38,10) ; vanaa nɛinun Mɛlɛka-a « ceux que le Seigneur a en horreur » (Dt 22,5). Sans doute apparenté à nɛyɔnndo « haïr ».</text></form></note>
  </entry>
  <entry id="nɛ̀ìsóó_2475">
    <lexical-unit><form lang="kqs"><text>nɛ̀ìsóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nɛ̀ìsóó_2475_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bicyclette</text></gloss>
      <gloss lang="en"><text>bicycle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 261: nɛ̀ìsóó</text></form></note>
    <note><form lang="fr"><text>Emprunt au mendé nɛ̀ɛ̀só « cheval de fer ».</text></form></note>
  </entry>
  <entry id="nɛiyo_2476">
    <lexical-unit><form lang="kqs"><text>nɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛiyo_2476_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire mal, être douloureux ; fouler, battre (le grain)</text></gloss>
      <gloss lang="en"><text>hurt, be painful; tread, thresh (grain)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hurt, be in pain; step on, kick, thresh</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 231 occurrences, first GEN.22.3; Childs 2000, p. 261: nɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>Pua bollen le co ya nɛiyo ! « ma tête, ma tête ! (elle me fait mal) » (2KI.4.19) ; naw co maalon nɛiyo « le bœuf qui foule le grain » (DEU.25.4). À distinguer de nɛiyo « chemin ».</text></form></note>
  </entry>
  <entry id="nɛiyo_2477">
    <lexical-unit><form lang="kqs"><text>nɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nɛilan</text></form></field>
    <sense id="nɛiyo_2477_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chemin, route</text></gloss>
      <gloss lang="en"><text>path, road</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 231 occurrences, first GEN.22.3; Keita 1979, p. 142: Nèiyo; Childs 2000, p. 261: nɛ̀ìyó</text></form></note>
  </entry>
  <entry id="nɛwvo_2478">
    <lexical-unit><form lang="kqs"><text>nɛwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛw</text></form></variant>
    <variant><form lang="kqs"><text>nɛwnin</text></form></variant>
    <variant><form lang="kqs"><text>nɛwnun</text></form></variant>
    <sense id="nɛwvo_2478_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fouler, piétiner, écraser</text></gloss>
      <gloss lang="en"><text>tread, trample, crush underfoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of nèìyó 'step on, kick, thresh'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 2SA.22.43; Childs 2000, p. 259: nèìùwó</text></form></note>
    <note><form lang="fr"><text>rɛsɛnndon nɛwvo o doolaa nin « fouler le raisin au pressoir » (Ne 13,15) ; nɛw … a labɛngu « fouler aux pieds » (Ps 44,6).</text></form></note>
  </entry>
  <entry id="nɛyaa_2479">
    <lexical-unit><form lang="kqs"><text>nɛyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛyan</text></form></variant>
    <variant><form lang="kqs"><text>nɛyaa-nɛyan</text></form></variant>
    <sense id="nɛyaa_2479_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>douloureux, brûlant ; fort (boisson) ; (ɲɛ nɛyaa) douleur</text></gloss>
      <gloss lang="en"><text>painful, burning; strong (drink); (ɲɛ nɛyaa) pain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.34.25; Childs 2000, p. 261: nèìyà-</text></form></note>
    <note><form lang="fr"><text>ɲɛ nɛyaa « la douleur » (Jb 30,17) ; mɔima nɛyaa « boisson forte » (Dt 29,5) ; kɛvaa lólòla nɛyaa « serpents brûlants » (Dt 8,15).</text></form></note>
  </entry>
  <entry id="nɛyɔnndo_2480">
    <lexical-unit><form lang="kqs"><text>nɛyɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛyɔn</text></form></variant>
    <sense id="nɛyɔnndo_2480_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>haïr ; la haine</text></gloss>
      <gloss lang="en"><text>hate; hatred</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.37.4</text></form></note>
  </entry>
  <entry id="nɛŋio_2481">
    <lexical-unit><form lang="kqs"><text>nɛŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛŋi</text></form></variant>
    <variant><form lang="kqs"><text>nɛŋinin</text></form></variant>
    <variant><form lang="kqs"><text>nɛŋul</text></form></variant>
    <sense id="nɛŋio_2481_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire prospérer, rendre fécond ; réjouir (le cœur)</text></gloss>
      <gloss lang="en"><text>make prosper, make fruitful; gladden (the heart)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make something beautiful, make people happy (causative of 'be good')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.39.3; Childs 2000, p. 259: nèŋìó</text></form></note>
    <note><form lang="fr"><text>nɛŋi … ipulu « rendre fécond » (Gn 29,31) ; Mɛlɛka va ndu nɛŋio « le Seigneur le faisait réussir » (Gn 39,3) ; kɔllo nɛŋio « réjouir le cœur » (Ps 92,5).</text></form></note>
  </entry>
  <entry id="nɛ̀ɛ́_2482">
    <lexical-unit><form lang="kqs"><text>nɛ̀ɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛ̀ɛ́_2482_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>qui ?</text></gloss>
      <gloss lang="en"><text>who?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1602 occurrences, first GEN.1.9; Childs 2000, p. 260: nɛ̀ɛ́</text></form></note>
  </entry>
  <entry id="nɛ̀ɛ́_2483">
    <lexical-unit><form lang="kqs"><text>nɛ̀ɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>nɛ̌</text></form></variant>
    <variant><form lang="kqs"><text>nɛ́</text></form></variant>
    <variant><form lang="kqs"><text>nɛ̂</text></form></variant>
    <sense id="nɛ̀ɛ́_2483_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule interrogative de confirmation : n'est-ce pas ?</text></gloss>
      <gloss lang="en"><text>tag question particle: right?, isn't it?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 260: nɛ̀ɛ́</text></form></note>
  </entry>
  <entry id="nɛɛla_2484">
    <lexical-unit><form lang="kqs"><text>nɛɛla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nɛɛla_2484_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verrouiller, barrer (une porte)</text></gloss>
      <gloss lang="en"><text>bolt, bar (a door)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>secure, close or lock properly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.16.3; Childs 2000, p. 260: nɛ̀ɛ̀làá</text></form></note>
    <note><form lang="fr"><text>mà mingi dioo nɛɛla « et verrouille la porte » (2SA.13.17) ; a yɔm ndáà nɛɛla koŋndan-ndo « avec la barre dont on fermait les portes » (JDG.16.3).</text></form></note>
  </entry>
  <entry id="nɛ́ɛ̀nɛɔ_2485">
    <lexical-unit><form lang="kqs"><text>nɛ́ɛ̀nɛɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nɛ́ɛ̀nɛ́ɛ̀a</text></form></field>
    <sense id="nɛ́ɛ̀nɛɔ_2485_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moineau</text></gloss>
      <gloss lang="en"><text>sparrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a small red and gray gregarious bird</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.84.4; Childs 2000, p. 260: nèènéìyó</text></form></note>
  </entry>
  <entry id="nɛ̀ɛ́ŋndó_2486">
    <lexical-unit><form lang="kqs"><text>nɛ̀ɛ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nɛ̀ɛ́ŋndó_2486_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (bois de chauffe)</text></gloss>
      <gloss lang="en"><text>kind of tree (used as firewood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 260: nɛ̀ɛ́ŋndó</text></form></note>
  </entry>
  <entry id="o_2487">
    <lexical-unit><form lang="kqs"><text>o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o_2487_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>il, elle (sujet, classe o)</text></gloss>
      <gloss lang="en"><text>he, she, it (subject, o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 58042 occurrences, first GEN.1.1; Childs 2000, p. 284: ò</text></form></note>
  </entry>
  <entry id="o_2488">
    <lexical-unit><form lang="kqs"><text>o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o_2488_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>à, dans, sur (lieu, temps)</text></gloss>
      <gloss lang="en"><text>at, in, on (place, time)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'to, from, against, near'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58042 occurrences, first GEN.1.1; Childs 2000, p. 284: ó</text></form></note>
  </entry>
  <entry id="o kon kɔɔli_2489">
    <lexical-unit><form lang="kqs"><text>o kon kɔɔli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o kon kɔɔli_2489_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>après cela, ensuite, puis</text></gloss>
      <gloss lang="en"><text>after that, then, afterwards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in addition, moreover, besides</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 285: ó kɔ́ŋ kɔ́ɔ́lì</text></form></note>
    <note><form lang="fr"><text>Litt. « derrière cela » : o … kɔɔli « derrière, après » et kon « cela ». O kon kɔɔli, mí Mɛlɛka Hala soli nakɔɔ … « ensuite le Seigneur Dieu planta un jardin … » (GEN.2.8). Très fréquent en début de phrase.</text></form></note>
  </entry>
  <entry id="oi_2490">
    <lexical-unit><form lang="kqs"><text>oi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="oi_2490_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>oui</text></gloss>
      <gloss lang="en"><text>yes</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.24.58</text></form></note>
  </entry>
