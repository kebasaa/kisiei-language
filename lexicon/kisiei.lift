  <entry id="muulianndo_2295">
    <lexical-unit><form lang="kqs"><text>muulianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muulian</text></form></variant>
    <sense id="muulianndo_2295_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mélanger, mêler ; joindre, associer</text></gloss>
      <gloss lang="en"><text>mix, mingle; join together, combine</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) a mixture, derived from 'turn'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.2.2; Childs 2000, p. 254: mùlìàŋndó</text></form></note>
    <note><form lang="fr"><text>mɔima niaan ma muulian a mɛnndan « ton vin est coupé d'eau » (Es 1,22) ; La bɛnda mì la muulian cɔlua … le « n'accouple pas des bêtes d'espèces différentes » (Lv 19,19). Peut-être apparenté à mulio « tourner » (Childs).</text></form></note>
  </entry>
  <entry id="muuluanndo_2296">
    <lexical-unit><form lang="kqs"><text>muuluanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>muuluannda</text></form></field>
    <sense id="muuluanndo_2296_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hypocrite, homme fourbe</text></gloss>
      <gloss lang="en"><text>hypocrite, deceitful person</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.22.27</text></form></note>
    <note><form lang="fr"><text>Apparenté à muuluo « retourner ». muulɔnndo « hypocrisie, fausseté ; tortueux » (Rm 12,9 ; 2 S 22,27).</text></form></note>
  </entry>
  <entry id="muuluo_2297">
