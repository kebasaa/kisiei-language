  <entry id="fìɲàá_869">
    <lexical-unit><form lang="kqs"><text>fìɲàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fìɲàláŋ</text></form></field>
