  <entry id="kuubanɔɔ_869">
    <lexical-unit><form lang="kqs"><text>kuubanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kuubaa</text></form></field>
    <sense id="kuubanɔɔ_869_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>héros, guerrier vaillant</text></gloss>
      <gloss lang="en"><text>hero, valiant warrior</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>warrior with magical powers who could capture villages</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.6.12; Keita 1979, p. 156: Kuubanöö; Childs 2000, p. 197: kúúbánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kùùlen_870">
    <lexical-unit><form lang="kqs"><text>kùùlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="kùùlen_870_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri, hutte ; soufflet de forge</text></gloss>
      <gloss lang="en"><text>shelter, booth; bellows</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.4.6; Keita 1979, p. 159: Kuulen; Childs 2000, p. 198: kùúléŋ</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, kùùlen est un abri, une hutte (Is 4,6 ; Jon 4,5 ; pl. kùùlan, Gn 33,17). Keita et Childs donnent « soufflet » ; peut-être deux mots de tons différents.</text></form></note>
  </entry>
  <entry id="kuuliaa_871">
    <lexical-unit><form lang="kqs"><text>kuuliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuuliaa_871_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rugir ; gronder (tonnerre)</text></gloss>
      <gloss lang="en"><text>roar; thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shout (plural of kùlàá 'shout, cheer')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first DEU.32.10; Childs 2000, p. 198: kùùlìá</text></form></note>
  </entry>
  <entry id="kuumbuu_872">
    <lexical-unit><form lang="kqs"><text>kuumbuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuumbun</text></form></variant>
    <variant><form lang="kqs"><text>kuumbuan</text></form></variant>
    <sense id="kuumbuu_872_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recouvrir, étendre sur</text></gloss>
      <gloss lang="en"><text>cover over, spread over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.9.23; Childs 2000, p. 198: kùùmbùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel (intensif) de kumbɔɔ « couvrir ».</text></form></note>
  </entry>
  <entry id="kuumiaa_873">
    <lexical-unit><form lang="kqs"><text>kuumiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuumiaanin</text></form></variant>
    <sense id="kuumiaa_873_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bourgeonner, pousser des bourgeons</text></gloss>
      <gloss lang="en"><text>bud, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.40.10</text></form></note>
  </entry>
  <entry id="kuunaa_874">
    <lexical-unit><form lang="kqs"><text>kuunaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuuna</text></form></variant>
    <variant><form lang="kqs"><text>kuunan</text></form></variant>
    <sense id="kuunaa_874_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interdire, défendre</text></gloss>
      <gloss lang="en"><text>forbid</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stop, prevent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first NUM.22.22; Childs 2000, p. 198: kùùnàá</text></form></note>
  </entry>
  <entry id="kuundiaa_875">
    <lexical-unit><form lang="kqs"><text>kuundiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuundiaa_875_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agrandir ; élever, honorer</text></gloss>
      <gloss lang="en"><text>enlarge; exalt, honour</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make big, fatten (plural of kùndàá 'be plentiful')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.12.20; Childs 2000, p. 198: kùùndìá</text></form></note>
    <note><form lang="fr"><text>Base de kuundian « s'enorgueillir ». lɛŋnde niaalen kuundiaa « agrandir votre territoire » (Dt 12,20).</text></form></note>
  </entry>
  <entry id="kuundian_876">
    <lexical-unit><form lang="kqs"><text>kuundian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuundianndo</text></form></variant>
    <sense id="kuundian_876_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'enorgueillir, être arrogant ; orgueil</text></gloss>
      <gloss lang="en"><text>be proud, be arrogant; pride</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first DEU.29.18</text></form></note>
  </entry>
  <entry id="kuupepelan_877">
    <lexical-unit><form lang="kqs"><text>kuupepelan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="respelled"/>
    <sense id="kuupepelan_877_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oreillons</text></gloss>
      <gloss lang="en"><text>mumps</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Kuupepelan</text></form></note>
  </entry>
  <entry id="kuusuo_878">
    <lexical-unit><form lang="kqs"><text>kuusuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuusuo_878_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vomir</text></gloss>
      <gloss lang="en"><text>vomit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>vomit, retch</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kuusuo; Childs 2000, p. 192: kùìsìó</text></form></note>
    <note><form lang="fr"><text>La Bible a kuusuu « vomissure » (ISA 19,14 ; JER 48,26).</text></form></note>
  </entry>
  <entry id="kuusuu_879">
    <lexical-unit><form lang="kqs"><text>kuusuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuusuu_879_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vomissure</text></gloss>
      <gloss lang="en"><text>vomit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.19.14</text></form></note>
    <note><form lang="fr"><text>Cf. kuisio « vomir ».</text></form></note>
  </entry>
  <entry id="kuuvo_880">
    <lexical-unit><form lang="kqs"><text>kuuvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kuuvo_880_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joue</text></gloss>
      <gloss lang="en"><text>cheek</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cheek, jaw</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.24.20; Keita 1979, p. 131: Kuuvo; Childs 2000, p. 200: kùúwó</text></form></note>
    <note><form lang="fr"><text>Kuula nɔmndan « tes joues » (Ct 1,10). Homographe : kuuvo, kùùlan « hutte, cabane » (Is 24,20 ; Ne 8,16).</text></form></note>
  </entry>
  <entry id="kuŋndan_881">
    <lexical-unit><form lang="kqs"><text>kuŋndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuŋ</text></form></variant>
    <variant><form lang="kqs"><text>kuŋndo</text></form></variant>
    <sense id="kuŋndan_881_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gémir ; mugir, gronder (mer, pluie) ; (… te) ne pas dire mot</text></gloss>
      <gloss lang="en"><text>groan; roar (sea, rain); (… te) make no sound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grunt, groan; also a grunt of assent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.16.11; Childs 2000, p. 197: kùŋndó</text></form></note>
    <note><form lang="fr"><text>kuŋndan et kuŋndo servent de forme longue : a va kuŋndan « ils gémissaient » (Ex 2,23) ; mɛmma … và kuŋndo « les eaux qui grondent » (Ez 1,24) ; Yakɔb kuŋ te « Jacob se tut » (Gn 34,5).</text></form></note>
  </entry>
  <entry id="kúŋndo_882">
    <lexical-unit><form lang="kqs"><text>kúŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kúŋndo_882_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cruche, jarre (à huile)</text></gloss>
      <gloss lang="en"><text>jar, jug (for oil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1KI.17.12</text></form></note>
    <note><form lang="fr"><text>Écrit kúŋndo ; ne pas confondre avec kuŋndo « grondement » (voir kuŋndan).</text></form></note>
  </entry>
  <entry id="kuɛɛ_883">
    <lexical-unit><form lang="kqs"><text>kuɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuɛɛ_883_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>où ? quel ?</text></gloss>
      <gloss lang="en"><text>where? which?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 236 occurrences, first GEN.3.9; Childs 2000, p. 191: kùɛ́ɛ́</text></form></note>
  </entry>
  <entry id="kɔandaa_884">
    <lexical-unit><form lang="kqs"><text>kɔandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔandu</text></form></variant>
    <variant><form lang="kqs"><text>kɔandunin</text></form></variant>
    <sense id="kɔandaa_884_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>puiser (de l'eau) ; ramasser, emporter</text></gloss>
      <gloss lang="en"><text>draw (water); scoop up, carry off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.25.38</text></form></note>
    <note><form lang="fr"><text>bombola kɔandaa lapultan « pelles à cendres » (Ex 27,3). Proche de kɔndɔɔ.</text></form></note>
  </entry>
  <entry id="kɔannan_885">
    <lexical-unit><form lang="kqs"><text>kɔannan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔannan_885_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étendue, largeur ; (o kɔannan) étendu, vaste</text></gloss>
      <gloss lang="en"><text>breadth, extent; (o kɔannan) spread out, wide</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.34.21</text></form></note>
    <note><form lang="fr"><text>lɛŋnden le co le kɔannan kɛ́-kɛ̀ « le pays est assez vaste » (Gn 34,21).</text></form></note>
  </entry>
  <entry id="kɔannun_886">
    <lexical-unit><form lang="kqs"><text>kɔannun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔannun_886_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'en aller (avec), emmener ; poursuivre (… kɔɔli)</text></gloss>
      <gloss lang="en"><text>go off (with), take away; pursue (… kɔɔli)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 169 occurrences, first GEN.13.14</text></form></note>
    <note><form lang="fr"><text>Moyen de kɔlan « aller ».</text></form></note>
  </entry>
  <entry id="kɔduuvo_887">
    <lexical-unit><form lang="kqs"><text>kɔduuvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔduuvo_887_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coupe-coupe</text></gloss>
      <gloss lang="en"><text>machete</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Köduuvo</text></form></note>
  </entry>
  <entry id="kɔkumbɛiyo_888">
    <lexical-unit><form lang="kqs"><text>kɔkumbɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kɔkumbɛilan</text></form></field>
    <sense id="kɔkumbɛiyo_888_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concombre</text></gloss>
      <gloss lang="en"><text>cucumber</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Kökumbèiyo</text></form></note>
    <note><form lang="fr"><text>Le pluriel kɔkumbɛilan est dans la Bible (NUM.11.5).</text></form></note>
  </entry>
  <entry id="kɔlan_889">
    <lexical-unit><form lang="kqs"><text>kɔlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔ</text></form></variant>
    <variant><form lang="kqs"><text>kɔa</text></form></variant>
    <variant><form lang="kqs"><text>kɔɛ</text></form></variant>
    <variant><form lang="kqs"><text>kue</text></form></variant>
    <variant><form lang="kqs"><text>kɔanin</text></form></variant>
    <variant><form lang="kqs"><text>kuenin</text></form></variant>
    <sense id="kɔlan_889_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller, partir</text></gloss>
      <gloss lang="en"><text>go, leave</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go, walk; pass by</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1303 occurrences, first GEN.3.14; Keita 1979, p. 116: Kölan; Childs 2000, p. 182: kɔ̀láŋ</text></form></note>
    <note><form lang="fr"><text>kue, kuenin : radical négatif. kɔ s'emploie aussi en série : « aller (faire) ».</text></form></note>
  </entry>
  <entry id="kɔlfulaa_890">
    <lexical-unit><form lang="kqs"><text>kɔlfulaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kɔlfulaa_890_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colère, emportement ; palpitations</text></gloss>
      <gloss lang="en"><text>anger, rage; palpitations</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EST.1.12; Keita 1979, p. 161: Kölfulaa</text></form></note>
    <note><form lang="fr"><text>Keita : « palpitations de cœur » ; dans la Bible, « colère » (Est 1,12).</text></form></note>
  </entry>
  <entry id="kɔliiyo_891">
    <lexical-unit><form lang="kqs"><text>kɔliiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔliiyo_891_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciseaux</text></gloss>
      <gloss lang="en"><text>scissors</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Köliiyo; Childs 2000, p. 182: kɔ̀lìíyó</text></form></note>
  </entry>
  <entry id="kɔlkaloo_892">
    <lexical-unit><form lang="kqs"><text>kɔlkaloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔlkalu</text></form></variant>
    <variant><form lang="kqs"><text>kɔlkalua</text></form></variant>
    <sense id="kɔlkaloo_892_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sagesse, intelligence ; ruse</text></gloss>
      <gloss lang="en"><text>wisdom, intelligence; cunning</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wisdom, sense, insight (heart + hard)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 284 occurrences, first GEN.41.33; Childs 2000, p. 182: kɔ́l-kàlòó</text></form></note>
    <note><form lang="fr"><text>kɔlkalu vɔɔndo « rusé » (Gn 3,1) ; kɔlkalua « les sages ».</text></form></note>
  </entry>
  <entry id="kɔlkelle_893">
    <lexical-unit><form lang="kqs"><text>kɔlkelle</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kɔlkelon</text></form></field>
    <sense id="kɔlkelle_893_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rein</text></gloss>
      <gloss lang="en"><text>kidney</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Kölkelle</text></form></note>
    <note><form lang="fr"><text>Pluriel kɔlkelon attesté (Lv 3,4) ; la Bible a aussi kɔlkelen (Ex 29,13).</text></form></note>
  </entry>
  <entry id="kɔlkɛndɔɔ_894">
    <lexical-unit><form lang="kqs"><text>kɔlkɛndɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔlkɛndɛ</text></form></variant>
    <sense id="kɔlkɛndɔɔ_894_s1">
