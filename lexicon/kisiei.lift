      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>adult, middle-aged person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.48.14; Keita 1979, p. 134: Kaasonnöö; Childs 2000, p. 142: káásɔ́ŋnɔ́ɔ́</text></form></note>
