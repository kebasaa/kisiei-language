    <trait name="status" value="respelled"/>
    <sense id="suei mɛɛlɛi_4749_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>auriculaire</text></gloss>
      <gloss lang="en"><text>little finger</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Suei mèèlèi; Lexique kissi–français, p. 52: suei mɛɛlɛi</text></form></note>
  </entry>
  <entry id="suendi_4750">
    <lexical-unit><form lang="kqs"><text>suendi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suendì-suendiaalan</text></form></variant>
    <sense id="suendi_4750_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recoudre, rapiécer ; (suendì-suendiaalan) rapiécé de toutes parts</text></gloss>
      <gloss lang="en"><text>sew up, patch; (suendì-suendiaalan) patched all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sew (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOS.9.4; Childs 2000, p. 342: sùèndìó</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɔndɔɔ « coudre ». bɔlɔla yáwla … sɛɛsiɛila ndáà mingi suendi lan « des outres usées, déchirées et recousues » (JOS.9.4) ; samtala yuulula suendì-suendiaalan « des sandales usées et rapiécées » (JOS.9.5).</text></form></note>
  </entry>
  <entry id="suendo_4751">
    <lexical-unit><form lang="kqs"><text>suendo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="suendo_4751_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moucherons</text></gloss>
      <gloss lang="en"><text>gnats, midges</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: suendo</text></form></note>
  </entry>
  <entry id="sùéŋndó_4752">
    <lexical-unit><form lang="kqs"><text>sùéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sùéŋndó_4752_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite mouche qui bourdonne autour des oreilles</text></gloss>
      <gloss lang="en"><text>small fly buzzing around one's ears</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: sùéŋndó</text></form></note>
  </entry>
  <entry id="sueɲi_4753">
    <lexical-unit><form lang="kqs"><text>sueɲi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sueɲi_4753_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir peur</text></gloss>
      <gloss lang="en"><text>be afraid</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 97: suenyi</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 97 : le suenyi masa ɔ kwɛni « parce qu'il a eu peur du maître, il est parti ».</text></form></note>
  </entry>
  <entry id="suilio_4754">
    <lexical-unit><form lang="kqs"><text>suilio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suili</text></form></variant>
    <variant><form lang="kqs"><text>suilinin</text></form></variant>
    <sense id="suilio_4754_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir, atteindre (un âge) ; faire devenir, établir (roi) ; investir, introniser</text></gloss>
      <gloss lang="en"><text>become, reach (an age); make (someone) become, appoint (king); invest, enthrone</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first EXO.5.11; Terminologie (histoire), n° 390: Suilioo</text></form></note>
    <note><form lang="fr"><text>Vɔsi Abram suili vɔsilan … « lorsqu'Abram eut 99 ans » (Gn 17,1) ; David suilio masaa « faire David roi » (1 Ch 12,32). Académie des langues (terminologie, histoire n° 390, 413) : « investiture, intronisation ».</text></form></note>
  </entry>
  <entry id="suindin_4755">
    <lexical-unit><form lang="kqs"><text>suindin</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suindin_4755_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un petit peu</text></gloss>
      <gloss lang="en"><text>a little bit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: suindin</text></form></note>
  </entry>
  <entry id="suingi_4756">
    <lexical-unit><form lang="kqs"><text>suingi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suingin</text></form></variant>
    <sense id="suingi_4756_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arracher (cheveux), déraciner</text></gloss>
      <gloss lang="en"><text>pull out (hair), uproot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NEH.13.25</text></form></note>
    <note><form lang="fr"><text>Peut-être dérivé (causatif) de sungɔɔ « arracher ».</text></form></note>
  </entry>
  <entry id="suinun_4757">
    <lexical-unit><form lang="kqs"><text>suinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="suinun_4757_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'oindre, s'enduire</text></gloss>
      <gloss lang="en"><text>anoint oneself, smear oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.15.24; Childs 2000, p. 346: sùùnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de suiyo ; suinun cuɛiyan « s'oindre d'huile ».</text></form></note>
  </entry>
  <entry id="sùìsìó_4758">
    <lexical-unit><form lang="kqs"><text>sùìsìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sùìsìó_4758_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir la diarrhée</text></gloss>
      <gloss lang="en"><text>have diarrhoea</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: sùìsìó</text></form></note>
  </entry>
  <entry id="suiyo_4759">
    <lexical-unit><form lang="kqs"><text>suiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suu</text></form></variant>
    <variant><form lang="kqs"><text>suunin</text></form></variant>
    <sense id="suiyo_4759_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enduire, oindre ; asperger (de sang) ; masser</text></gloss>
      <gloss lang="en"><text>smear, anoint; sprinkle (blood); massage</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rub (in), apply</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.29.16; Lexique kissi–français, p. 53: suɔ/ su; Childs 2000, p. 346: sùùwó</text></form></note>
    <note><form lang="fr"><text>kɔlan Yeesu suiyo « aller oindre Jésus » (Mc 16,1) ; sɔɔlɛmaa suiyo « se moquer de » (Mt 27,31). Lexique kissi–français, p. 52-53 : suɔ/ su « oindre, masser ».</text></form></note>
  </entry>
  <entry id="suka_4760">
    <lexical-unit><form lang="kqs"><text>suka</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suka_4760_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>indigo</text></gloss>
      <gloss lang="en"><text>indigo</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 97: suka</text></form></note>
    <note><form lang="fr"><text>Cf. kaan « indigo » ; Childs (Sud) a súkàá, arbre servant de mordant en teinture.</text></form></note>
  </entry>
  <entry id="súkàá_4761">
    <lexical-unit><form lang="kqs"><text>súkàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="súkàá_4761_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à fruit non comestible servant de mordant (teinture)</text></gloss>
      <gloss lang="en"><text>tree with inedible fruit used as a dye fixative</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: súkàá</text></form></note>
  </entry>
  <entry id="sukalaa_4762">
    <lexical-unit><form lang="kqs"><text>sukalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sukaraa</text></form></variant>
    <sense id="sukalaa_4762_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sucre</text></gloss>
      <gloss lang="en"><text>sugar</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sukaraa</text></form></note>
    <note><form lang="fr"><text>Emprunt (français sucre). Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="sùkàsùkàá_4763">
    <lexical-unit><form lang="kqs"><text>sùkàsùkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sùkàsùkàá_4763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rincer (la bouche)</text></gloss>
      <gloss lang="en"><text>rinse out (the mouth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: sùkàsùkàá</text></form></note>
  </entry>
  <entry id="sukpɔloni_4764">
    <lexical-unit><form lang="kqs"><text>sukpɔloni</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>soukpɔloni</text></form></variant>
    <sense id="sukpɔloni_4764_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loup-garou</text></gloss>
      <gloss lang="en"><text>werewolf</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 97: sugbɔroni, sougbɔroni</text></form></note>
    <note><form lang="fr"><text>Paulme : litt. « mort recroquevillé ».</text></form></note>
  </entry>
  <entry id="sukuno_4765">
    <lexical-unit><form lang="kqs"><text>sukuno</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sulukuno</text></form></variant>
    <sense id="sukuno_4765_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>exciseuse ; doyenne du village, gardienne de la mare sacrée</text></gloss>
      <gloss lang="en"><text>woman who performs excision; village elder woman, keeper of the sacred pool</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 97: sukuno, sulukuno</text></form></note>
    <note><form lang="fr"><text>Paulme : elle enterre aussi les femmes mortes en couches.</text></form></note>
  </entry>
  <entry id="sulalle_4766">
    <lexical-unit><form lang="kqs"><text>sulalle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sulalii</text></form></variant>
    <sense id="sulalle_4766_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>accident, malheur (involontaire) ; incident</text></gloss>
      <gloss lang="en"><text>accident, mishap; incident</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first EXO.21.13; Terminologie (histoire), n° 401: Sulalle, sulèiye; Childs 2000, p. 344: sùléí</text></form></note>
    <note><form lang="fr"><text>vanaa sulalle fula o ba má dii vanacieo « ceux qui ont tué quelqu'un par accident » (Nb 35,6).</text></form></note>
  </entry>
  <entry id="sulan_4767">
    <lexical-unit><form lang="kqs"><text>sulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sulan_4767_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être égal à, être semblable à (… a)</text></gloss>
      <gloss lang="en"><text>be equal to, be like (… a)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) an equal, equivalent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.8.6; Childs 2000, p. 344: sùlâŋndó</text></form></note>
    <note><form lang="fr"><text>vana-vana sulan a Mɛlɛka le, Hala naa pɛɛn « nul n'est semblable au Seigneur notre Dieu » (EXO.8.6) ; i sulan bɛɛ a buɛyaa nɔmaa laandua ha o pilɛ le « je ne suis même pas l'égale d'une de tes servantes » (RUT.2.13).</text></form></note>
  </entry>
  <entry id="suleiyo_4768">
    <lexical-unit><form lang="kqs"><text>suleiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="suleiyo_4768_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>accident grave</text></gloss>
      <gloss lang="en"><text>serious accident</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: suleiyo</text></form></note>
  </entry>
  <entry id="sulio_4769">
    <lexical-unit><form lang="kqs"><text>sulio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>suli</text></form></variant>
    <sense id="sulio_4769_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>élever (un enfant)</text></gloss>
      <gloss lang="en"><text>raise, bring up (a child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sulio/ suli</text></form></note>
    <note><form lang="fr"><text>Causatif de sullo « grandir ».</text></form></note>
  </entry>
  <entry id="sullo_4770">
    <lexical-unit><form lang="kqs"><text>sullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sulɔɔ</text></form></variant>
    <sense id="sullo_4770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>grandir ; tenir, avoir de la place (dans un lieu) ; être élevé (enfant)</text></gloss>
      <gloss lang="en"><text>grow up; fit (in a place); be brought up (child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sullo; Paulme 1964, p. 97: sulɔ; Lexique kissi–français, p. 52: sullo/ sul</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : sul (GEN 21,8), sulnin. Lexique kissi–français, p. 52 : aussi sulɔɔ/ sul « être élevé comme un enfant, grandir ». Paulme 1964, p. 97 : sulɔ « croissance, grandir » ; i sul « j'ai grandi ».</text></form></note>
  </entry>
  <entry id="súlúkóó_4771">
    <lexical-unit><form lang="kqs"><text>súlúkóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="súlúkóó_4771_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loquet (de porte)</text></gloss>
      <gloss lang="en"><text>door latch</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 344: súlúkóó</text></form></note>
  </entry>
  <entry id="sulukuo_4772">
    <lexical-unit><form lang="kqs"><text>sulukuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sulukua</text></form></field>
    <sense id="sulukuo_4772_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hyène</text></gloss>
      <gloss lang="en"><text>hyena</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Sulukuo; Paulme 1964, p. 97: sulukuo, pl. sulukua; Lexique kissi–français, p. 52: sulukuo; Sandara Kisia, fable 2: sulukuo; Childs 2000, p. 344: súlúkóó</text></form></note>
    <note><form lang="fr"><text>Le pluriel sulukua est dans la Bible (ISA.13.22). Paulme 1964, p. 97 : sulukuo, pl. sulukua « hyène ». Pluriel sulukua dans la Bible (1SA.13.18).</text></form></note>
  </entry>
  <entry id="sumaa_4773">
    <lexical-unit><form lang="kqs"><text>sumaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suma</text></form></variant>
    <sense id="sumaa_4773_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être aveugle, devenir aveugle ; cécité</text></gloss>
      <gloss lang="en"><text>be blind, go blind; blindness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.28.28; Childs 2000, p. 344: sùmàá</text></form></note>
    <note><form lang="fr"><text>mí vana-vana suma « et chacun fut frappé de cécité » (GEN.19.11) ; seemɛilan, sumaa « la folie, la cécité » (DEU.28.28) ; o suma « il est né aveugle » (JHN.9.2). Voir sumɛiyo, suumiaa.</text></form></note>
  </entry>
  <entry id="sumialle_4774">
    <lexical-unit><form lang="kqs"><text>sumialle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sumialii</text></form></variant>
    <sense id="sumialle_4774_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>séjour comme étranger ; (o sumialle) en étranger</text></gloss>
      <gloss lang="en"><text>sojourning as a stranger; (o sumialle) as a stranger</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first GEN.15.13</text></form></note>
    <note><form lang="fr"><text>La forme sumialii désigne l'hôte (Gn 19,8).</text></form></note>
  </entry>
  <entry id="sùmndéŋ_4775">
    <lexical-unit><form lang="kqs"><text>sùmndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sùmndéŋ_4775_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>métier de forgeron, forge</text></gloss>
      <gloss lang="en"><text>blacksmithing</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 344: sùmndéŋ</text></form></note>
  </entry>
  <entry id="sumndo_4776">
    <lexical-unit><form lang="kqs"><text>sumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sumndo_4776_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeûne</text></gloss>
      <gloss lang="en"><text>fast, fasting</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 73 occurrences, first LEV.16.29; Childs 2000, p. 344: sûmndɔ́</text></form></note>
  </entry>
  <entry id="sumnɔɔ_4777">
    <lexical-unit><form lang="kqs"><text>sumnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sumnɔɔ_4777_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forgeron ; maréchal-ferrant</text></gloss>
      <gloss lang="en"><text>blacksmith; farrier</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2CH.26.15; Keita 1979, p. 145: Sumnöö; Paulme 1964, p. 97: sumuno, sumno, pl. sumude; Lexique kissi–français, p. 52: sumnɔɔ; Childs 2000, p. 344: sùmnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 97 : sumuno, sumno, pl. sumude « forgeron ».</text></form></note>
  </entry>
  <entry id="sumuŋɔɔ_4778">
    <lexical-unit><form lang="kqs"><text>sumuŋɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sumuŋɔɔ_4778_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>élève de la société d'initiation, pas encore pleinement initié ; excisée, circoncis (à la sortie et après) ; adepte</text></gloss>
      <gloss lang="en"><text>partly initiated student of the initiation society; initiated girl or boy (from the coming-out on); follower, adept</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98: sumuŋo, pl. sumua; Terminologie (histoire), n° 21: Sumunöö; Childs 2000, p. 344: súmúnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par Paulme 1964, p. 98 : sumuŋo, pl. sumua « excisé, circoncis, le jour de la sortie et après ». Pluriel en kissi du Sud (Childs 2000) : súmúá. Académie des langues (terminologie, histoire n° 21) : sumunöö « adepte ».</text></form></note>
  </entry>
  <entry id="sumɛiyo_4779">
    <lexical-unit><form lang="kqs"><text>sumɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sumɛiya</text></form></field>
    <sense id="sumɛiyo_4779_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aveugle</text></gloss>
      <gloss lang="en"><text>blind</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first LEV.19.14; Paulme 1964, p. 97: suma, sumyɛyo; Lexique kissi–français, p. 52: sumiɛiyo; Childs 2000, p. 344: sùmèíyé-</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 97 : vana sumyɛyo « aveugle » ; suma (cf. sumaa « être aveugle »).</text></form></note>
  </entry>
  <entry id="sun_4780">
    <lexical-unit><form lang="kqs"><text>sun</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="sun_4780_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bientôt</text></gloss>
      <gloss lang="en"><text>soon</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sun</text></form></note>
    <note><form lang="fr"><text>Homographe : sun dans la Bible (EXO.29.20) a un autre sens. À confirmer.</text></form></note>
  </entry>
  <entry id="sunbungaa_4781">
    <lexical-unit><form lang="kqs"><text>sunbungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sunbungaa_4781_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouches (essaim) ; grandes mouches noires</text></gloss>
      <gloss lang="en"><text>flies, swarm of flies; large black flies</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.8; Lexique kissi–français, p. 52: sunbungaa</text></form></note>
  </entry>
  <entry id="sungbule_4782">
    <lexical-unit><form lang="kqs"><text>sungbule</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sungbuan</text></form></field>
    <variant><form lang="kqs"><text>sungbuma</text></form></variant>
    <sense id="sungbule_4782_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colonne, pilier, poteau</text></gloss>
      <gloss lang="en"><text>pillar, column, post</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.37.20</text></form></note>
  </entry>
  <entry id="sungulnɔɔ_4783">
    <lexical-unit><form lang="kqs"><text>sungulnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sungulnɔɔ_4783_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>milicien</text></gloss>
      <gloss lang="en"><text>militiaman</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 424: Sungulnöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sungɔɔ_4784">
    <lexical-unit><form lang="kqs"><text>sungɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sungu</text></form></variant>
    <variant><form lang="kqs"><text>sungunin</text></form></variant>
    <variant><form lang="kqs"><text>sungun</text></form></variant>
    <sense id="sungɔɔ_4784_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arracher ; enlever (herbes, dents, chapeau) ; (sungun) s'enlever ; déterrer</text></gloss>
      <gloss lang="en"><text>pluck, tear away; remove (weeds, teeth, hat); (sungun) come off; dig up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>uproot, pull up, extract</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.24.9; Keita 1979, p. 113: Sungöö; Paulme 1964, p. 98: suŋu; Lexique kissi–français, p. 53: sungɔɔ/ sungu; Childs 2000, p. 345: sùŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 53 : sungɔnndo/ sungun « s'enlever » (cf. JOB.4.21). Paulme 1964, p. 98 : i suŋu yambe « je déterre du manioc » ; mi dusua a suŋu nira « les chasseurs ont arraché les oreilles ».</text></form></note>
  </entry>
  <entry id="sùnndo_4785">
    <lexical-unit><form lang="kqs"><text>sùnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sùnndo_4785_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pilon ; meule (supérieure) ; bâton</text></gloss>
      <gloss lang="en"><text>pestle; (upper) millstone; stick</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tree whose wood is used for pestles; pestle; its leaves</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.24.6; Paulme 1964, p. 98: sundo; Childs 2000, p. 345: sùŋndó</text></form></note>
    <note><form lang="fr"><text>bii sùnndo a ciei o landei nin « prendre en gage la meule ou le mortier » (DEU.24.6) ; mɛɛ vana cu kullon a sunndo « comme on pile le grain au pilon » (PRO.27.22) ; diom lasunndo « le bruit de la meule » (JER.25.10). Paulme 1964, p. 98 : sundo « pilon » ; sunde « bâton ».</text></form></note>
  </entry>
  <entry id="sunsun_4786">
    <lexical-unit><form lang="kqs"><text>sunsun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sunsun_4786_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>maintenant, tout de suite</text></gloss>
      <gloss lang="en"><text>now, right away</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 145 occurrences, first GEN.21.23; Childs 2000, p. 345: súŋsúŋ</text></form></note>
  </entry>
  <entry id="suntɛndo_4787">
    <lexical-unit><form lang="kqs"><text>suntɛndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>suntɛndia</text></form></field>
    <variant><form lang="kqs"><text>suuntɛndo</text></form></variant>
    <variant><form lang="kqs"><text>suuntɛndo</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="suntɛndo_4787_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>araignée</text></gloss>
      <gloss lang="en"><text>spider</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98 (G/K): suntɛndo, pl. suntɛndya /K./</text></form></note>
    <note><form lang="fr"><text>Paulme : suntɛndo, pl. suntɛndya /K./ ; suuntɛndo /G./. Paulme : suntɛndo /K./, suuntɛndo /G./ (p. 98).</text></form></note>
  </entry>
  <entry id="sunɔnndo_4788">
    <lexical-unit><form lang="kqs"><text>sunɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sunun</text></form></variant>
    <sense id="sunɔnndo_4788_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'oindre, se masser</text></gloss>
      <gloss lang="en"><text>anoint oneself, massage oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: sunɔnndo/ sunun</text></form></note>
    <note><form lang="fr"><text>Moyen de suiyo « oindre » (Lexique su « oindre, masser »).</text></form></note>
  </entry>
  <entry id="suo_4789">
    <lexical-unit><form lang="kqs"><text>suo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suo_4789_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>suie (remède contre le sambiyo)</text></gloss>
      <gloss lang="en"><text>soot (remedy against sambiyo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98: suo</text></form></note>
  </entry>
  <entry id="susaa_4790">
    <lexical-unit><form lang="kqs"><text>susaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>susa</text></form></variant>
    <sense id="susaa_4790_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frotter</text></gloss>
      <gloss lang="en"><text>rub</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scrape</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Susaa; Lexique kissi–français, p. 53: susaa/ susa; Childs 2000, p. 345: sùsàá</text></form></note>
  </entry>
  <entry id="susanndo_4791">
    <lexical-unit><form lang="kqs"><text>susanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>susan</text></form></variant>
    <sense id="susanndo_4791_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se frotter</text></gloss>
      <gloss lang="en"><text>rub oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Susanndo; Lexique kissi–français, p. 53: susanndo/ susan</text></form></note>
    <note><form lang="fr"><text>Moyen de susaa.</text></form></note>
  </entry>
  <entry id="suseco_4792">
    <lexical-unit><form lang="kqs"><text>suseco</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suseco_4792_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>société de prévoyance</text></gloss>
      <gloss lang="en"><text>mutual-aid society</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98: susetyo</text></form></note>
    <note><form lang="fr"><text>Paulme : malo n susɛtyo « le riz réclamé pour la société ».</text></form></note>
  </entry>
  <entry id="susiaa_4793">
    <lexical-unit><form lang="kqs"><text>susiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>susia</text></form></variant>
    <sense id="susiaa_4793_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frotter plusieurs fois</text></gloss>
      <gloss lang="en"><text>rub repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: susiaa/ susia</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi suusia (radical) « frotter plusieurs fois ».</text></form></note>
  </entry>
  <entry id="susio_4794">
    <lexical-unit><form lang="kqs"><text>susio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="susio_4794_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>diarrhée</text></gloss>
      <gloss lang="en"><text>diarrhoea</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: susio</text></form></note>
  </entry>
  <entry id="susokan_4795">
    <lexical-unit><form lang="kqs"><text>susokan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="susokan_4795_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz de rizière (variété à petit grain blanc)</text></gloss>
      <gloss lang="en"><text>paddy rice (variety with small white grain)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98: susokã</text></form></note>
    <note><form lang="fr"><text>Paulme : se sème en juin-juillet.</text></form></note>
  </entry>
  <entry id="susoo_4796">
    <lexical-unit><form lang="kqs"><text>susoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="susoo_4796_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse-mouches, balai rituel (de l'interprète du masque)</text></gloss>
      <gloss lang="en"><text>ritual whisk or broom (used by the masked spirit's interpreter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: susoo; Childs 2000, p. 345: sùsóó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 53 (« balai »).</text></form></note>
  </entry>
  <entry id="susu_4797">
    <lexical-unit><form lang="kqs"><text>susu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>suɔsɔi</text></form></field>
    <variant><form lang="kqs"><text>susuo</text></form></variant>
    <sense id="susu_4797_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont les feuilles donnent une infusion)</text></gloss>
      <gloss lang="en"><text>kind of tree (leaves used for an infusion)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 99: susuo, susu, pl. suɔsɔy</text></form></note>
    <note><form lang="fr"><text>Paulme : on en fait des « mouvettes » ; les feuilles donnent un nyuruwa. Homographe de susuo « loutre ».</text></form></note>
  </entry>
  <entry id="susu yinaa_4798">
    <lexical-unit><form lang="kqs"><text>susu yinaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="susu yinaa_4798_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pinceau</text></gloss>
      <gloss lang="en"><text>paintbrush</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 198: Susu yinaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. yinɔɔ « teindre ».</text></form></note>
  </entry>
  <entry id="susul_4799">
    <lexical-unit><form lang="kqs"><text>susul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="susul_4799_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vomir, cracher (un flot d'eau)</text></gloss>
      <gloss lang="en"><text>spew, spout (a stream of water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spit, spray a liquid from the mouth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first REV.12.15; Childs 2000, p. 345: sùsùlló</text></form></note>
    <note><form lang="fr"><text>mí tambálakáà susul mɛnndan vanalanɔɔ kɔɔli maa pee bɛndu « le dragon vomit de l'eau comme un fleuve derrière la femme » (REV.12.15, REV.12.16).</text></form></note>
  </entry>
  <entry id="susulɛn_4800">
    <lexical-unit><form lang="kqs"><text>susulɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="susulɛn_4800_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (feuilles du samsɔa, remède des jumeaux)</text></gloss>
      <gloss lang="en"><text>plant (leaves used in the samsɔa charm, remedy for twins)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 99: susulɛ̃</text></form></note>
    <note><form lang="fr"><text>Paulme : pye susulɛ̃ « feuilles du susu » ; talisman.</text></form></note>
  </entry>
  <entry id="susuo_4801">
    <lexical-unit><form lang="kqs"><text>susuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="susuo_4801_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loutre</text></gloss>
      <gloss lang="en"><text>otter</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 99: susuo, pl. susuwa; Lexique kissi–français, p. 53: susuo</text></form></note>
  </entry>
  <entry id="susɔɔ_4802">
    <lexical-unit><form lang="kqs"><text>susɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="susɔɔ_4802_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sucer plusieurs fois</text></gloss>
      <gloss lang="en"><text>suck repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Susöö</text></form></note>
  </entry>
  <entry id="susɔɔ_4803">
    <lexical-unit><form lang="kqs"><text>susɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>susu</text></form></variant>
    <sense id="susɔɔ_4803_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rôtir dans des feuilles ; cuire sous la cendre</text></gloss>
      <gloss lang="en"><text>roast in leaves; cook in the ashes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: susɔɔ/ susu; Childs 2000, p. 345: sùsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 53 : susɔɔ/ susu « cuire sous la cendre » (corrigé à la main ; d'abord « sucer plusieurs fois ? »).</text></form></note>
  </entry>
  <entry id="súú_4804">
    <lexical-unit><form lang="kqs"><text>súú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>súúlan</text></form></field>
    <variant><form lang="kqs"><text>súúla</text></form></variant>
    <sense id="súú_4804_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte, espèce ; peuple, nation</text></gloss>
      <gloss lang="en"><text>kind, species; people, nation</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 434 occurrences, first GEN.6.19; Terminologie (langue), n° 55: Suuo</text></form></note>
    <note><form lang="fr"><text>súú oo súú « de chaque espèce ». Académie des langues (terminologie, langue n° 55 et 61) : suuo « catégorie, classe ». Académie des langues (terminologie, langue n° 160 et 190) : suuo « espèce, genre ». Académie des langues (terminologie, langue n° 275) : suuo « nature ».</text></form></note>
  </entry>
  <entry id="súù_4805">
    <lexical-unit><form lang="kqs"><text>súù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="súù_4805_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>à toute vitesse (approche rapide)</text></gloss>
      <gloss lang="en"><text>speedily (rapid approach)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 345: súù</text></form></note>
  </entry>
  <entry id="sùùbɔ̀ɔ̀làá_4806">
    <lexical-unit><form lang="kqs"><text>sùùbɔ̀ɔ̀làá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sùùbɔ̀ɔ̀làá_4806_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>scarabée bruyant</text></gloss>
      <gloss lang="en"><text>noisy beetle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 345: sùùbɔ̀ɔ̀làá</text></form></note>
  </entry>
  <entry id="suukanndo_4807">
    <lexical-unit><form lang="kqs"><text>suukanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suukan</text></form></variant>
    <sense id="suukanndo_4807_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler, s'entretenir (avec) ; causer ; négocier ; négociation, pourparlers</text></gloss>
      <gloss lang="en"><text>speak, talk (with); chat; negotiate; negotiation, talks</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>talk back and forth (middle of 'talk')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.18.31; Lexique kissi–français, p. 53: suukanndo/ suukan; Terminologie (langue), n° 65: Suukanndo; Childs 2000, p. 345: sùùkăŋndɔ́</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 65 et 66) : « communication, communiquer ». Académie des langues (terminologie, langue n° 122) : « dialogue ». Académie des langues (terminologie, langue n° 225) : « langage ». Aussi Terminologie, p. 438 : « Suukanndo, yamèi ». Académie des langues (terminologie, histoire n° 438, 490) : « négociation, pourparlers » (aussi yamɛi).</text></form></note>
  </entry>
  <entry id="suuku_4808">
    <lexical-unit><form lang="kqs"><text>suuku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="suuku_4808_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>réclamer (une dette)</text></gloss>
      <gloss lang="en"><text>demand payment (of a debt)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.15.2; Lexique kissi–français, p. 53: suukuo/ suuku</text></form></note>
    <note><form lang="fr"><text>Forme longue suukuo (Lexique), non relevée dans la Bible.</text></form></note>
  </entry>
  <entry id="suulaa_4809">
    <lexical-unit><form lang="kqs"><text>suulaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suulaa_4809_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>photo</text></gloss>
      <gloss lang="en"><text>photo</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 202: Suulaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Photographie » : tyua suulaa (arts n° 204) ; cf. sɛbɛ cuungiaa lasuulaa « album ».</text></form></note>
  </entry>
  <entry id="suumaa_4810">
    <lexical-unit><form lang="kqs"><text>suumaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suuma</text></form></variant>
    <sense id="suumaa_4810_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bouder, avoir l'air abattu ; être triste ; être fâché (contre)</text></gloss>
      <gloss lang="en"><text>sulk, look downcast; be sad; be angry (with)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.4.5; Paulme 1964, p. 97: suma; Lexique kissi–français, p. 53: suuma; Childs 2000, p. 345: sùùmàá</text></form></note>
    <note><form lang="fr"><text>mó suuma suumaa « son visage fut abattu » (Gn 4,5) ; pɛngi suumaa « cesser d'être triste » (1 S 1,18). Paulme 1964, p. 97 : ɔ suma a ya « il est fâché contre moi ».</text></form></note>
  </entry>
  <entry id="suumiaa_4811">
    <lexical-unit><form lang="kqs"><text>suumiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="suumiaa_4811_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aveugler</text></gloss>
      <gloss lang="en"><text>strike blind</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.19.11; Childs 2000, p. 344: sùmìá</text></form></note>
  </entry>
  <entry id="suundaa_4812">
    <lexical-unit><form lang="kqs"><text>suundaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="suundaa_4812_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>adultère, prostitution, débauche</text></gloss>
      <gloss lang="en"><text>adultery, prostitution</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>to fornicate (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first LEV.21.9; Keita 1979, p. 148: Suundaa; Paulme 1964, p. 98: sunda; Lexique kissi–français, p. 53: suundaa; Childs 2000, p. 346: sùùndàá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 98 : sunda « courir après les femmes » ; vana sunda « débauché, coureur ».</text></form></note>
  </entry>
  <entry id="súúndùla_4813">
    <lexical-unit><form lang="kqs"><text>súúndùla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="súúndùla_4813_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prépuces (pl.)</text></gloss>
      <gloss lang="en"><text>foreskins (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>foreskin; also elephant shrew</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.18.25; Childs 2000, p. 346: súùndóó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. Ɲɛ o yeema daama-o co súúndùla Filistia kɛmɛ « il ne demande que cent prépuces de Philistins » (1SA.18.25, 1SA.18.27, 2SA.3.14).</text></form></note>
  </entry>
  <entry id="suundɛiyo_4814">
    <lexical-unit><form lang="kqs"><text>suundɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suundɛi</text></form></variant>
    <sense id="suundɛiyo_4814_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>débauché ; (vanalanɔ suundɛiyo) prostituée</text></gloss>
      <gloss lang="en"><text>immoral; (vanalanɔ suundɛiyo) prostitute</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.38.15; Childs 2000, p. 346: súndéí-</text></form></note>
  </entry>
  <entry id="suunvanndo_4815">
    <lexical-unit><form lang="kqs"><text>suunvanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suunvanndo_4815_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tribu</text></gloss>
      <gloss lang="en"><text>tribe</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 622: Suunvanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. suuvandacieeya « race ».</text></form></note>
  </entry>
  <entry id="suusiaa_4816">
    <lexical-unit><form lang="kqs"><text>suusiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="suusiaa_4816_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frotter, récurer (plusieurs fois)</text></gloss>
      <gloss lang="en"><text>scour, rub repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.6.21; Keita 1979, p. 113: Suusiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de susaa (LEV 6,21).</text></form></note>
  </entry>
  <entry id="sùùsúúwó_4817">
    <lexical-unit><form lang="kqs"><text>sùùsúúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sùùsúúwó_4817_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loutre (mange poissons et crabes)</text></gloss>
      <gloss lang="en"><text>otter (eats fish and crabs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 346: sùùsúúwó</text></form></note>
  </entry>
  <entry id="suuvandacieeya_4818">
    <lexical-unit><form lang="kqs"><text>suuvandacieeya</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>suuvandacieeya hɛlioo</text></form></variant>
    <variant><form lang="kqs"><text>hɛlilasuunɔɔ</text></form></variant>
    <sense id="suuvandacieeya_4818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>race ; (… hɛlioo) racisme ; (hɛlilasuunɔɔ) raciste</text></gloss>
      <gloss lang="en"><text>race; (… hɛlioo) racism; (hɛlilasuunɔɔ) racist</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 535: Suuvandatyieeya (Suuo…)</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. vanndacieea « peuples » ; suuvandacieeya hɛlioo « racisme » (n° 536), hɛlilasuunɔɔ « raciste » (n° 537).</text></form></note>
  </entry>
  <entry id="súúwó_4819">
    <lexical-unit><form lang="kqs"><text>súúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="súúwó_4819_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de termite (qui perce le bois)</text></gloss>
      <gloss lang="en"><text>a termite species (bores into wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 346: súúwó</text></form></note>
  </entry>
  <entry id="sùwásùwáá_4820">
    <lexical-unit><form lang="kqs"><text>sùwásùwáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sùwásùwáá_4820_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros rat des villages</text></gloss>
      <gloss lang="en"><text>large town rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 346: sùwásùwáá</text></form></note>
  </entry>
  <entry id="suwvo_4821">
    <lexical-unit><form lang="kqs"><text>suwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>suwva</text></form></field>
    <sense id="suwvo_4821_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson</text></gloss>
      <gloss lang="en"><text>fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first 2CH.33.14; Keita 1979, p. 137: Suwvo; Paulme 1964, p. 99: suwo, pl. suwa; Lexique kissi–français, p. 53: suwvo; Childs 2000, p. 346: sùùwó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 99 : aussi suvvo /G./.</text></form></note>
  </entry>
  <entry id="suwvo_4822">
    <lexical-unit><form lang="kqs"><text>suwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="suwvo_4822_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joug</text></gloss>
      <gloss lang="en"><text>yoke</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: suwvo</text></form></note>
    <note><form lang="fr"><text>Définition corrigée à la main dans le Lexique (d'abord « le bord de bois ») et marquée d'un point d'interrogation. Homographe de suwvo « poisson ».</text></form></note>
  </entry>
  <entry id="súŋ_4823">
    <lexical-unit><form lang="kqs"><text>súŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="súŋ_4823_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>plus tard</text></gloss>
      <gloss lang="en"><text>later</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 345: súŋ</text></form></note>
  </entry>
  <entry id="suŋo_4824">
    <lexical-unit><form lang="kqs"><text>suŋo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>suŋua</text></form></field>
    <sense id="suŋo_4824_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crapaud-buffle</text></gloss>
      <gloss lang="en"><text>bullfrog</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 98: suŋo, pl. suŋua</text></form></note>
  </entry>
  <entry id="suɛi_4825">
    <lexical-unit><form lang="kqs"><text>suɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="suɛi_4825_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maïs</text></gloss>
      <gloss lang="en"><text>maize</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Suèi; Paulme 1964, p. 96: suã, suay; Lexique kissi–français, p. 52: suɛi; Childs 2000, p. 343: sùɛ́í</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 96 : suã, suay « maïs ».</text></form></note>
  </entry>
  <entry id="suɛɛnde_4826">
    <lexical-unit><form lang="kqs"><text>suɛɛnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="suɛɛnde_4826_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charbon de bois</text></gloss>
      <gloss lang="en"><text>charcoal</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5.6 Fuel"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.41.13; Childs 2000, p. 343: sùɛ́ɛ́ŋndé</text></form></note>
    <note><form lang="fr"><text>Suɛɛnde yɔngu dɛngultan ni « le charbon donne la braise » (PRO.26.21) ; mì i mɛndul suɛɛnde « il allume les charbons » (JOB.41.13) ; yinnden fuulaa le suɛɛnde biyɔɔ (ISA.54.16).</text></form></note>
  </entry>
  <entry id="suɛɛsuɛɔ_4827">
    <lexical-unit><form lang="kqs"><text>suɛɛsuɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="suɛɛsuɛɔ_4827_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>juillet</text></gloss>
      <gloss lang="en"><text>July</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Suèèsuèö; Lexique kissi–français, p. 52: suɛɛsuɛɔ; Terminologie (langue), n° 443: Suèèsuèö ✎ 11</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 443) : « juillet », numéroté à la main 11.</text></form></note>
  </entry>
  <entry id="sɔ́_4828">
    <lexical-unit><form lang="kqs"><text>sɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔ́_4828_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>partout, tout autour ; entièrement (remplir) ; complètement, tout</text></gloss>
      <gloss lang="en"><text>all over, all around; completely (fill)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 106 occurrences, first GEN.9.7; Lexique kissi–français, p. 51: sɔ; Childs 2000, p. 339: sɔ́</text></form></note>
    <note><form lang="fr"><text>tiw … sɔ́ « remplir entièrement » (Gn 9,7) ; balu cieo sɔ́ « entourer la ville » (Ps 59,7) ; o tivaa sɔ́ « sur toute la surface » (Ex 4,6).</text></form></note>
  </entry>
  <entry id="sɔa_4829">
    <lexical-unit><form lang="kqs"><text>sɔa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="sɔa_4829_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rouiller</text></gloss>
      <gloss lang="en"><text>rust</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 51: sɔa</text></form></note>
    <note><form lang="fr"><text>Le Lexique précise « inf., passé ». Homographe : sɔ́a dans la Bible (PSA.22.17) a un autre sens.</text></form></note>
  </entry>
  <entry id="sɔaa_4830">
    <lexical-unit><form lang="kqs"><text>sɔaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔaanin</text></form></variant>
    <sense id="sɔaa_4830_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>confier, remettre (entre les mains de)</text></gloss>
      <gloss lang="en"><text>entrust, hand over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.32.17</text></form></note>
  </entry>
  <entry id="sɔamaa_4831">
    <lexical-unit><form lang="kqs"><text>sɔamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔam</text></form></variant>
    <variant><form lang="kqs"><text>sɔamnin</text></form></variant>
    <variant><form lang="kqs"><text>sɔaman</text></form></variant>
    <sense id="sɔamaa_4831_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dévorer</text></gloss>
      <gloss lang="en"><text>devour</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.57.5</text></form></note>
  </entry>
  <entry id="sɔ́kúmɛ́íyó_4832">
    <lexical-unit><form lang="kqs"><text>sɔ́kúmɛ́íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɔ́kúmɛ́íyó_4832_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine</text></gloss>
      <gloss lang="en"><text>a women's hair style</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 340: sɔ́kúmɛ́íyó</text></form></note>
  </entry>
  <entry id="sɔkɔa_4833">
    <lexical-unit><form lang="kqs"><text>sɔkɔa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔkɔa_4833_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dignitaires de la société des hommes</text></gloss>
      <gloss lang="en"><text>dignitaries of the men's society</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 94: sɔkɔa</text></form></note>
  </entry>
  <entry id="sɔkɔma_4834">
    <lexical-unit><form lang="kqs"><text>sɔkɔma</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔkɔma_4834_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>verrous, barres (de porte)</text></gloss>
      <gloss lang="en"><text>bolts, bars (of a gate)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first DEU.33.25</text></form></note>
  </entry>
  <entry id="sɔl_4835">
    <lexical-unit><form lang="kqs"><text>sɔl</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔl_4835_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rêver (sɔl lɔan « faire un rêve »)</text></gloss>
      <gloss lang="en"><text>dream (sɔl lɔan 'have a dream')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.2 Dream"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 66 occurrences, first GEN.28; Childs 2000, p. 340: sɔ̀llɔ́</text></form></note>
  </entry>
  <entry id="sɔla_4836">
    <lexical-unit><form lang="kqs"><text>sɔla</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sola</text></form></variant>
    <sense id="sɔla_4836_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sacré, interdit</text></gloss>
      <gloss lang="en"><text>sacred, forbidden</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 96: sola</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 96 : yɔm sɔla « bois sacré » ; dala sɔla « mare sacrée » ; vana sɔla « gardien d'un lieu de culte » ; même racine que sɔlulã. Homographe de sɔla « gagner » dans la Bible.</text></form></note>
  </entry>
  <entry id="sɔlaa_4837">
    <lexical-unit><form lang="kqs"><text>sɔlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔla</text></form></variant>
    <variant><form lang="kqs"><text>sɔlanin</text></form></variant>
    <sense id="sɔlaa_4837_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recevoir, obtenir ; gagner, acquérir, avoir</text></gloss>
      <gloss lang="en"><text>receive, get; earn, acquire, have</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.2 Receive"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 539 occurrences, first GEN.3.6; Keita 1979, p. 113: Sölaa; Paulme 1964, p. 95: sɔra; Lexique kissi–français, p. 51: [s]ɔlaa; Terminologie (langue), n° 8: Sölaa; Childs 2000, p. 340: sɔ̀làá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 50-51 : aussi écrit solaa/ sola, soraa/ sora « recevoir, acquérir, gagner, avoir » ; sɔlao « reçu ». Paulme 1964, p. 95 : tyɛy mi sɔra wurya « hier j'ai gagné de l'argent ». Académie des langues (terminologie, langue n° 8 et 9) : « acquérir, acquisition ».</text></form></note>
  </entry>
  <entry id="sɔlaama_4838">
    <lexical-unit><form lang="kqs"><text>sɔlaama</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔlaama_4838_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rêve (lɔma sɔlaama)</text></gloss>
      <gloss lang="en"><text>dream (lɔma sɔlaama)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.2 Dream"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.20.6</text></form></note>
    <note><form lang="fr"><text>Cf. sɔl lɔan « rêver ».</text></form></note>
  </entry>
  <entry id="sɔlulan_4839">
    <lexical-unit><form lang="kqs"><text>sɔlulan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔlulan_4839_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>objet de culte, autel</text></gloss>
      <gloss lang="en"><text>cult object, altar</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 95: sɔlulã</text></form></note>
    <note><form lang="fr"><text>Paulme : au pied d'un arbre, dans une case… ; sɔlulã pɛndua « autel des jumeaux » ; sɔlulã kɛwã « autel des serpents » (Dɛmbadouno).</text></form></note>
  </entry>
  <entry id="sɔluo_4840">
    <lexical-unit><form lang="kqs"><text>sɔluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sɔlu</text></form></variant>
    <sense id="sɔluo_4840_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler aux ancêtres, offrir un sacrifice (kola)</text></gloss>
      <gloss lang="en"><text>speak to the ancestors, offer a sacrifice (kola)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 95: sɔlu</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 95 : i sɔlu fɔya « j'ai parlé aux ancêtres » (l'expression couvre l'ensemble du rituel) ; fɔya sɔluo « offre d'un kola aux ancêtres ».</text></form></note>
  </entry>
  <entry id="sɔlɔlan_4841">
    <lexical-unit><form lang="kqs"><text>sɔlɔlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔlɔlanndo</text></form></variant>
    <sense id="sɔlɔlan_4841_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>confesser, avouer (ses fautes)</text></gloss>
      <gloss lang="en"><text>confess (one's sins)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.41.9; Lexique kissi–français, p. 51: sɔlɔlanndo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 52 : aussi sɔrɔlanndo/ sɔrɔlan.</text></form></note>
  </entry>
  <entry id="sɔlɔnndo_4842">
    <lexical-unit><form lang="kqs"><text>sɔlɔnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɔlɔnndo_4842_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hautes herbes</text></gloss>
      <gloss lang="en"><text>tall grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 51: sɔlɔnndo</text></form></note>
    <note><form lang="fr"><text>Homographe : sɔlɔnndo dans la Bible (EZR.10.1) signifie « confesser ».</text></form></note>
  </entry>
  <entry id="sɔ̀lɔ́ŋndó_4843">
    <lexical-unit><form lang="kqs"><text>sɔ̀lɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɔ̀lɔ́ŋndó_4843_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe à feuilles coupantes (pour couvrir les toits)</text></gloss>
      <gloss lang="en"><text>sharp-bladed grass used for thatching</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 340: sɔ̀lɔ́ŋndó</text></form></note>
  </entry>
  <entry id="sɔlɔɔ_4844">
    <lexical-unit><form lang="kqs"><text>sɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɔlɔɔ_4844_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grenouille</text></gloss>
      <gloss lang="en"><text>frog</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Sölöö; Lexique kissi–français, p. 51: sɔlɔɔ; Childs 2000, p. 340: sɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La Bible emploie ŋɔɔŋɔɔnda pour les grenouilles (EXO.8.2).</text></form></note>
  </entry>
  <entry id="sɔlɔɔ_4845">
    <lexical-unit><form lang="kqs"><text>sɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔlɔɔ_4845_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>scier ; raboter</text></gloss>
      <gloss lang="en"><text>saw; plane (wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 90: sɛlɔ; Lexique kissi–français, p. 51: sɔlɔɔ</text></form></note>
    <note><form lang="fr"><text>Homographe de sɔlɔɔ « grenouille ». Paulme 1964, p. 90 : ɔ sɛl yɔmdo « il rabote le bois » ; yɔmdo sɔlɔ « raboter (ou scier) » ; p. 93 : sio, pl. sirã « scie » (« pas de verbe sio, on dit yɔmdo sɔlo »).</text></form></note>
  </entry>
  <entry id="sɔlɛsiyo_4846">
    <lexical-unit><form lang="kqs"><text>sɔlɛsiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔlɛsiyo_4846_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse des excisées avant l'opération</text></gloss>
      <gloss lang="en"><text>dance of initiated girls before the operation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 94: sɔlɛsiyo</text></form></note>
  </entry>
  <entry id="sɔmamɛndo_4847">
    <lexical-unit><form lang="kqs"><text>sɔmamɛndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔmamɛndo_4847_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>puits</text></gloss>
      <gloss lang="en"><text>well</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 95 (G): sɔmamɛndo /G./</text></form></note>
  </entry>
  <entry id="sɔ́mìó_4848">
    <lexical-unit><form lang="kqs"><text>sɔ́mìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sɔ́mìó_4848_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>transgresser un interdit coutumier (épier un rite caché)</text></gloss>
      <gloss lang="en"><text>violate customs (e.g. spying on a forbidden rite)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 340: sɔ́mìó</text></form></note>
  </entry>
  <entry id="sɔmndo_4849">
    <lexical-unit><form lang="kqs"><text>sɔmndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔm</text></form></variant>
    <sense id="sɔmndo_4849_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mâcher, manger, dévorer ; (ciŋndon sɔmndo) grincer des dents ; croquer</text></gloss>
      <gloss lang="en"><text>chew, eat, devour; (ciŋndon sɔmndo) gnash one's teeth; crunch</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chew</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.12.4; Lexique kissi–français, p. 51: sɔmndo; Childs 2000, p. 338: sɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Childs le cite comme base des formes sòmìó, sòmìlló. nɛɛ caŋndan a ciŋndon sɔmndo vanin « là il y aura des pleurs et des grincements de dents » (MAT.13.42) ; mì la va saa kóndóa téndéa sɔmndo « vous mangez les agneaux » (AMO.6.4) ; le ya sɔmndo « pour me dévorer » (PSA.27.2).</text></form></note>
  </entry>
  <entry id="sɔmɔɔ_4850">
    <lexical-unit><form lang="kqs"><text>sɔmɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɔmɔɔ_4850_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acajou ; bois d'acajou utilisé pour les incisions des joues</text></gloss>
      <gloss lang="en"><text>acajou (mahogany or cashew); mahogany wood used for cheek scarification</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Sömöö; Lexique kissi–français, p. 51: sɔmɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 51 : sɔmɔɔ « le fruit ou le bois d'acajou utilisé par les femmes pour faire les incisions sur les joues » ; sɔmɔ « un bois utilisé pour tatouer ».</text></form></note>
  </entry>
  <entry id="sɔndamɔlen_4851">
    <lexical-unit><form lang="kqs"><text>sɔndamɔlen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔndamɔlen_4851_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>service civique</text></gloss>
      <gloss lang="en"><text>civic service</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 581: Söndamölen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sɔndan_4852">
    <lexical-unit><form lang="kqs"><text>sɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔndanndo</text></form></variant>
    <variant><form lang="kqs"><text>sɔndannin</text></form></variant>
    <sense id="sɔndan_4852_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'enfuir, se sauver, s'échapper ; (sɔndanndo) aller à l'écart (faire ses besoins)</text></gloss>
      <gloss lang="en"><text>flee, run away, escape; (sɔndanndo) go aside (to relieve oneself)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>enter the woods (also a euphemism for defecating)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.16.6; Lexique kissi–français, p. 51: sɔndanndo; Terminologie (histoire), n° 258: Söndanndo, fula lebènguoo; Childs 2000, p. 340: sɔ̀ndǎŋndó</text></form></note>
    <note><form lang="fr"><text>mí Moise sɔndan, mó kɔ viannun o lɛŋnde Madian-nden nin « Moïse s'enfuit et alla se cacher au pays de Madian » (EXO.2.15) ; fondokpaa … le vaa kɔlan sɔndanndo lon « un endroit où aller faire tes besoins » (DEU.23.13) ; Bɔɔle sɔndanndo o co ni « il doit se soulager » (JDG.3.24). Académie des langues (terminologie, histoire n° 258) : sɔndanndo « déroute » (aussi fula lebɛnguoo).</text></form></note>
  </entry>
  <entry id="sɔndasiiya cɔlaba lɛnnda_4853">
    <lexical-unit><form lang="kqs"><text>sɔndasiiya cɔlaba lɛnnda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔndasiiya cɔlaba lɛnnda_4853_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fantassins</text></gloss>
      <gloss lang="en"><text>infantry, foot soldiers</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 339: Söndasiiya työlaba lènnda</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). sɔndasiiya « soldats » (emprunt), cf. salasiiya. Aussi kunda sɔndasiyaa cɔlaba lɛnnda « infanterie » (histoire n° 406).</text></form></note>
  </entry>
  <entry id="sɔndianndo_4854">
    <lexical-unit><form lang="kqs"><text>sɔndianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔndianndo_4854_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir la diarrhée, aller à la selle plusieurs fois ; diarrhée</text></gloss>
      <gloss lang="en"><text>have diarrhoea, relieve oneself repeatedly; diarrhoea</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sɔndianndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « la diarrhée, faire la toilette plusieurs fois ». Comparer sɔndanndo.</text></form></note>
  </entry>
  <entry id="sɔndunɔɔ_4855">
    <lexical-unit><form lang="kqs"><text>sɔndunɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔndunɔɔ_4855_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tailleur</text></gloss>
      <gloss lang="en"><text>tailor</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 271: Söndunöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Formé sur sɔndɔɔ « coudre ».</text></form></note>
  </entry>
  <entry id="sɔndɔkɔlɔɔ_4856">
    <lexical-unit><form lang="kqs"><text>sɔndɔkɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sɔndɔkɔltan</text></form></field>
    <sense id="sɔndɔkɔlɔɔ_4856_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hameau</text></gloss>
      <gloss lang="en"><text>hamlet</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first RUT.1.2; Keita 1979, p. 142: Söndökölöö; Lexique kissi–français, p. 52: sɔndɔkɔlɔɔ</text></form></note>
  </entry>
  <entry id="sɔndɔɔ_4857">
    <lexical-unit><form lang="kqs"><text>sɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɔndu</text></form></variant>
    <variant><form lang="kqs"><text>sɔandu</text></form></variant>
    <sense id="sɔndɔɔ_4857_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>coudre</text></gloss>
      <gloss lang="en"><text>sew</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.28.3; Keita 1979, p. 115: Söndöö; Paulme 1964, p. 95: sɔndo; Lexique kissi–français, p. 52: sɔndɔɔ/ sɔndu, sondu, sɔandu; Terminologie (arts), n° 71: Söndöö; Childs 2000, p. 340: sɔ̀ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Bénéfactif sondul « coudre pour » (GEN 37,3). Paulme 1964, p. 95 : « coudre, couture, raccommodage » ; tala sɔnda « calebasse recousue » ; i sɔndu kura « j'ai cousu le pagne ». Académie des langues (terminologie, arts n° 71) : « coudre ».</text></form></note>
  </entry>
  <entry id="sɔngilen_4858">
    <lexical-unit><form lang="kqs"><text>sɔngilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sɔngilan</text></form></field>
    <variant><form lang="kqs"><text>sɔngila</text></form></variant>
    <sense id="sɔngilen_4858_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coin, angle</text></gloss>
      <gloss lang="en"><text>corner</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first 2KI.14.13; Childs 2000, p. 340: sɔ́ŋìléŋ</text></form></note>
    <note><form lang="fr"><text>sɔngila hiɔɔlulan « les quatre coins » (Ex 25,26).</text></form></note>
  </entry>
  <entry id="sɔnguo_4859">
    <lexical-unit><form lang="kqs"><text>sɔnguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔnguo_4859_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>approcher, aborder</text></gloss>
      <gloss lang="en"><text>approach</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 95: sɔŋu; Lexique kissi–français, p. 52: sɔnguo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 95 : yara dimi nyafindo sɔŋu « le lion a dit à la panthère de s'approcher » ; la sɔŋu « approchez ».</text></form></note>
  </entry>
  <entry id="sɔngɔ_4860">
    <lexical-unit><form lang="kqs"><text>sɔngɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sɔngɔlan</text></form></field>
    <sense id="sɔngɔ_4860_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>querelle, dispute ; se disputer ; discussion</text></gloss>
      <gloss lang="en"><text>quarrel, strife; quarrel; discussion</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) fight, argue</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.13.8; Lexique kissi–français, p. 52: sɔngɔɔ; Childs 2000, p. 340: sɔ́ŋgɔ̀ɔ̀</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 52 : sɔnga, sɔngɔɔ « se disputer, la discussion » (dans la Bible, sɔngɔɔ signifie « paix »).</text></form></note>
  </entry>
  <entry id="sɔngɔ_4861">
    <lexical-unit><form lang="kqs"><text>sɔngɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔngɔ_4861_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>à la place de, en échange de, pour (compensation)</text></gloss>
      <gloss lang="en"><text>in place of, in exchange for, for (compensation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) substitute, replacement</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.13.8; Childs 2000, p. 340: sɔ́ŋgɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Homographe de sɔngɔ « querelle ». o bɛnda mò ke ndu hɔ́ɔ́yɛi ndɔɛi sɔngɔ hɔlte « il lui rendra la liberté en compensation de l'œil » (EXO.21.26) ; o sala cɔlua nda ŋiɔn sɔngɔ cɔlu pilɛ « il rendra deux bêtes pour une » (EXO.22.3) ; nakɔ … celen sɔngɔ nakɔ nɔmndo ho « une autre vigne à la place de celle-ci » (1KI.21.2).</text></form></note>
  </entry>
  <entry id="sɔngɔvanaa_4862">
    <lexical-unit><form lang="kqs"><text>sɔngɔvanaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔngɔvanaa_4862_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pronom personnel</text></gloss>
      <gloss lang="en"><text>personal pronoun</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 307: Söngövanaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sɔngɔvanapilao_4863">
    <lexical-unit><form lang="kqs"><text>sɔngɔvanapilao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɔngɔvanapilao_4863_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pronom réfléchi</text></gloss>
      <gloss lang="en"><text>reflexive pronoun</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 337: Söngövanapilao</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. sɔngɔvanaa « pronom personnel ».</text></form></note>
  </entry>
  <entry id="sɔngɔɔ_4864">
    <lexical-unit><form lang="kqs"><text>sɔngɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sɔngɔɔ_4864_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paix</text></gloss>
      <gloss lang="en"><text>peace</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JDG.21.13; Keita 1979, p. 156: Söngöö</text></form></note>
    <note><form lang="fr"><text>Keita ne donne pas de glose ; le sens vient de la Bible (Jg 21,13 ; 2 S 10,19).</text></form></note>
  </entry>
  <entry id="sɔngɔɲɔn_4865">
    <lexical-unit><form lang="kqs"><text>sɔngɔɲɔn</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>sɔngɔɲɔnndan</text></form></variant>
    <sense id="sɔngɔɲɔn_4865_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>flamboyer, rougeoyer</text></gloss>
      <gloss lang="en"><text>blaze, glow</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note><form lang="fr"><text>dɛngulta sɔngɔɲɔnndan « charbons ardents » (2 S 22,9).</text></form></note>
  </entry>
  <entry id="sɔnnde_4866">
    <lexical-unit><form lang="kqs"><text>sɔnnde</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="sɔnnde_4866_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>usé ; battre qqn</text></gloss>
      <gloss lang="en"><text>worn out; beat someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sɔnnde</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi sɔn (radical) « user ». Deux sens réunis dans le Lexique ; à confirmer.</text></form></note>
  </entry>
  <entry id="sɔnndo_4867">
    <lexical-unit><form lang="kqs"><text>sɔnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sɔnndo_4867_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tache ; mauvais comportement</text></gloss>
      <gloss lang="en"><text>stain; bad behaviour</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 52: sɔnndo</text></form></note>
  </entry>
