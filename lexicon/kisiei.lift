      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perles rouges et noires portées par les femmes</text></gloss>
      <gloss lang="en"><text>red and black beads worn by women</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 378: wáátííyó</text></form></note>
  </entry>
  <entry id="wááyéléŋ_3697">
