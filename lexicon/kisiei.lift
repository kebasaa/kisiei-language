    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kondul</text></form></variant>
    <variant><form lang="kqs"><text>kondunin</text></form></variant>
    <variant><form lang="kqs"><text>kondullo</text></form></variant>
    <sense id="kondu_1688_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, procurer ; attirer (un malheur) sur</text></gloss>
