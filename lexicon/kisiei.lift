    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.14.5; Keita 1979, p. 137: Sengoo; Lexique kissi–français, p. 47: sengoo</text></form></note>
  </entry>
  <entry id="senguo_4496">
    <lexical-unit><form lang="kqs"><text>senguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="senguo_4496_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coquille vide d'escargot</text></gloss>
      <gloss lang="en"><text>empty snail shell</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 91: sɛŋuo, pl. sɛŋurã; Lexique kissi–français, p. 47: senguo</text></form></note>
    <note><form lang="fr"><text>Comparer seenguuvo « coquillage ». Paulme 1964, p. 91 : sɛŋuo, pl. sɛŋurã « coquille d'escargot » ; escargot : tyɔmdo.</text></form></note>
  </entry>
  <entry id="sengɔɔ_4497">
