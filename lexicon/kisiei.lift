    <sense id="dɛ́ɛ̀ɛ̀_783_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lentement</text></gloss>
      <gloss lang="en"><text>slowly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 74: dɛ́ɛ̀ɛ̀</text></form></note>
  </entry>
  <entry id="éé_784">
