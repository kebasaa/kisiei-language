    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 86: dòlàŋdòlǎŋndó</text></form></note>
  </entry>
  <entry id="dolinnde_1135">
    <lexical-unit><form lang="kqs"><text>dolinnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="dolinnde_1135_s1">
