    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ifalen</text></form></variant>
    <sense id="ifalenndo_1343_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éphod (doma ifalenndo, vêtement du prêtre)</text></gloss>
