      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustache</text></gloss>
      <gloss lang="en"><text>moustache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yiinhii lamilinde</text></form></note>
  </entry>
  <entry id="yikpa_1943">
