      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 87: sadɛndo</text></form></note>
    <note><form lang="fr"><text>Paulme : toma sadɛndo ; Moussama, Kossilan.</text></form></note>
  </entry>
  <entry id="safir_4338">
    <lexical-unit><form lang="kqs"><text>safir</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="safir_4338_s1">
