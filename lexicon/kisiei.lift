    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Konköö</text></form></note>
  </entry>
  <entry id="koo_1694">
    <lexical-unit><form lang="kqs"><text>koo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="koo_1694_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hernie testiculaire</text></gloss>
      <gloss lang="en"><text>scrotal hernia</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Koo; Lexique kissi–français, p. 26: koo</text></form></note>
    <note><form lang="fr"><text>Le seul kóò de la Bible (2S 19,1) est une particule sans rapport. Confirmé au Nord par le Lexique kissi–français, p. 26.</text></form></note>
  </entry>
  <entry id="kóó_1695">
