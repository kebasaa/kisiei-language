      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herboriste, guérisseur traditionnel, chaman</text></gloss>
      <gloss lang="en"><text>herbalist, shaman</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 338: sókónɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="solana_4683">
