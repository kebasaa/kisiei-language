    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kòndòbúéìyó_2226_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit arbre (bois de chauffe) qui irrite la peau</text></gloss>
      <gloss lang="en"><text>small tree used for firewood that makes the skin itch</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 175: kòndòbúéìyó</text></form></note>
  </entry>
  <entry id="kóndóó_2227">
    <lexical-unit><form lang="kqs"><text>kóndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kóndóa</text></form></field>
    <variant><form lang="kqs"><text>kóndó</text></form></variant>
    <sense id="kóndóó_2227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bélier (saa kóndó)</text></gloss>
      <gloss lang="en"><text>ram (saa kóndó)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.22.13</text></form></note>
  </entry>
  <entry id="kóndóó_2228">
    <lexical-unit><form lang="kqs"><text>kóndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kóndóó_2228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit tambour d'aisselle (à hauteur variable)</text></gloss>
      <gloss lang="en"><text>small talking drum, squeezed to vary the pitch</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 175: kóndóó</text></form></note>
  </entry>
  <entry id="kóndówálìó_2229">
    <lexical-unit><form lang="kqs"><text>kóndówálìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kóndówálìé</text></form></field>
    <sense id="kóndówálìó_2229_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite banane sucrée ; caféier à longues branches</text></gloss>
      <gloss lang="en"><text>small sweet banana; long-branched coffee tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 175: kóndówálìó kóndówálìé</text></form></note>
  </entry>
  <entry id="kondu_2230">
    <lexical-unit><form lang="kqs"><text>kondu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kondul</text></form></variant>
    <variant><form lang="kqs"><text>kondunin</text></form></variant>
    <variant><form lang="kqs"><text>kondullo</text></form></variant>
    <sense id="kondu_2230_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, procurer ; attirer (un malheur) sur</text></gloss>
      <gloss lang="en"><text>bring, fetch; bring (trouble) on</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scoop up, draw (water); collect, pile together</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.18.4; Childs 2000, p. 175: kòndòó</text></form></note>
    <note><form lang="fr"><text>kondul (bénéfactif) « apporter à » (Ex 5,10).</text></form></note>
  </entry>
  <entry id="kongillo_2231">
    <lexical-unit><form lang="kqs"><text>kongillo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kongilan</text></form></field>
    <variant><form lang="kqs"><text>kongil</text></form></variant>
    <variant><form lang="kqs"><text>kuŋilo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="kongillo_2231_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coq</text></gloss>
      <gloss lang="en"><text>rooster, cock</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.6 Poultry raising"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first JOB.38.36; Paulme 1964, p. 47 (G/K): koŋilo /G./, kuŋilo /K./; Lexique kissi–français, p. 25: kongillo; Childs 2000, p. 176: kòŋgìlló</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 47 : koŋilo (G.), kuŋilo (K.) « coq ». Aussi Paulme 1964, p. 52 : « kuŋilo /K./, koŋilo /G./, pl. kuŋila ». Paulme : koŋilo /G./, kuŋilo /K./ (p. 47, 52).</text></form></note>
  </entry>
  <entry id="kongio_2232">
    <lexical-unit><form lang="kqs"><text>kongio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kongio_2232_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>érosion</text></gloss>
      <gloss lang="en"><text>erosion</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: kongio</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence biblique (REV.14.20), où le sens « écoulement » paraît possible ; à confirmer.</text></form></note>
  </entry>
  <entry id="kongosalɛu_2233">
    <lexical-unit><form lang="kqs"><text>kongosalɛu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kongosalɛu_2233_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse de l'opérateur après les circoncisions</text></gloss>
      <gloss lang="en"><text>dance of the circumciser after the circumcisions</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Kongosalèu; Lexique kissi–français, p. 26: kongosalɛu</text></form></note>
  </entry>
  <entry id="koni_2234">
    <lexical-unit><form lang="kqs"><text>koni</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="koni_2234_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aussi, de même (lende koni « de même »)</text></gloss>
      <gloss lang="en"><text>also, likewise (lende koni 'likewise')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>just, only, alone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 489 occurrences, first GEN.7.2; Childs 2000, p. 176: kóní</text></form></note>
  </entry>
  <entry id="konkɔɔ_2235">
    <lexical-unit><form lang="kqs"><text>konkɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="konkɔɔ_2235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>herser, secouer</text></gloss>
      <gloss lang="en"><text>harrow, shake</text></gloss>
