  <entry id="selekpekpoo_3477">
    <lexical-unit><form lang="kqs"><text>selekpekpoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="selekpekpoo_3477_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pic</text></gloss>
      <gloss lang="en"><text>peak (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: selekpekpoo</text></form></note>
    <note><form lang="fr"><text>Le Lexique dit seulement « pic » : sommet escarpé (cf. selekpekpee « raide ») ou outil ou oiseau ? À confirmer.</text></form></note>
  </entry>
  <entry id="selemenden_3478">
