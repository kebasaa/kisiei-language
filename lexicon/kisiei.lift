      <gloss lang="en"><text>gum (of the teeth); gap left by a missing tooth; ring of reeds at the base of a hut roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
