    <trait name="status" value="southern"/>
    <sense id="mùùláŋndó_2294_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, poser</text></gloss>
      <gloss lang="en"><text>put</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: mùùláŋndó</text></form></note>
