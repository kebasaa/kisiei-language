    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 145: Solisèbènöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sòlíŋndé_4694">
    <lexical-unit><form lang="kqs"><text>sòlíŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
