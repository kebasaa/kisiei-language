      <gloss lang="fr"><text>manière astucieuse ou amusante de faire (tresser, danser)</text></gloss>
      <gloss lang="en"><text>clever or amusing way of doing something (weaving, dancing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 162: kèwɛ́lɔ̀ɔ́ kèwɛ́ltáŋ</text></form></note>
  </entry>
  <entry id="kéyěŋ_1336">
    <lexical-unit><form lang="kqs"><text>kéyěŋ</text></form></lexical-unit>
