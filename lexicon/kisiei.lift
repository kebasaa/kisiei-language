      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>across, on the other side; in Liberia also a name for Guinea</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 110 occurrences, first GEN.50.10; Childs 2000, p. 225: lèèlò</text></form></note>
