  <entry id="sààyìáŋndó_4333">
    <lexical-unit><form lang="kqs"><text>sààyìáŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sààyìáŋndó_4333_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'envelopper d'un pagne ; porter (un sac) à l'épaule</text></gloss>
      <gloss lang="en"><text>wrap oneself in a cloth; shoulder (a bag)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sààyìáŋndó</text></form></note>
  </entry>
  <entry id="sabu_4334">
    <lexical-unit><form lang="kqs"><text>sabu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sabu_4334_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cause, raison ; (le sabu yɛɛ) pourquoi ; (le sabu kon) c'est pourquoi</text></gloss>
      <gloss lang="en"><text>cause, reason; (le sabu yɛɛ) why; (le sabu kon) therefore</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>reason, cause, meaning; also an act of kindness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.20.17; Childs 2000, p. 318: sábòó</text></form></note>
  </entry>
  <entry id="sabuo_4335">
    <lexical-unit><form lang="kqs"><text>sabuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sabuo_4335_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agent (grammaire)</text></gloss>
      <gloss lang="en"><text>agent (grammar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 16: Sabuo, söboo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi sɔboo. La Bible a sabuo une seule fois, dans un autre contexte (HEB.13.20).</text></form></note>
  </entry>
  <entry id="sadasiyaa soa_4336">
    <lexical-unit><form lang="kqs"><text>sadasiyaa soa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sadasiyaa soa_4336_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cavalerie</text></gloss>
      <gloss lang="en"><text>cavalry</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 144: Soa . sadasiyaa soa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « chevaux des soldats » (soa, pluriel de sow « cheval ») ; la liste donne aussi soa seul.</text></form></note>
  </entry>
  <entry id="sadɛndo_4337">
    <lexical-unit><form lang="kqs"><text>sadɛndo</text></form></lexical-unit>
