  <entry id="kàmásɔ̀lɔ́ŋndó_1929">
    <lexical-unit><form lang="kqs"><text>kàmásɔ̀lɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
