    <trait name="status" value="southern"/>
    <sense id="sáátátá_4331_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>droit devant, en plein (dans)</text></gloss>
      <gloss lang="en"><text>straight on, right at</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 317: sáátátá</text></form></note>
  </entry>
  <entry id="sààtóndóó_4332">
