      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>homme (adulte) ; (au pluriel) hommes, compagnons</text></gloss>
      <gloss lang="en"><text>man (adult male); (pl.) men, followers</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
