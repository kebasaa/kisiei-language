    </sense>
    <note type="source"><form lang="en"><text>BKG: 134 occurrences, first GEN.18.2; Lexique kissi–français, p. 24: kiltan; Childs 2000, p. 166: kìltáŋ</text></form></note>
  </entry>
  <entry id="kinda_1602">
    <lexical-unit><form lang="kqs"><text>kinda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindaa</text></form></variant>
    <sense id="kinda_1602_s1">
