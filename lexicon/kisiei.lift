      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Kèmbèi kokoei; Lexique kissi–français, p. 23: kɛnbei kokoei</text></form></note>
  </entry>
  <entry id="kɛmbɛi kɔi_2276">
    <lexical-unit><form lang="kqs"><text>kɛmbɛi kɔi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɛmbɛi kɔi_2276_s1">
