    <sense id="cɛlɔɔ_222_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accepter ; accepter, consentir ; écouter, obéir à</text></gloss>
      <gloss lang="en"><text>accept ; accept, agree; listen to, obey</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.2 Receive"/>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>agree (to), concur</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.17.14; Keita 1979, p. 114: Tyèlöö; Childs 2000, p. 41: cɛ̀lɔ̀ɔ́</text></form></note>
  </entry>
