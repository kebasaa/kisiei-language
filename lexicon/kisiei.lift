  <entry id="tììfàá_4014">
    <lexical-unit><form lang="kqs"><text>tììfàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tììfàá_4014_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte d'entrée de l'école de brousse (initiation)</text></gloss>
      <gloss lang="en"><text>gate at the entrance of the bush school</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 358: tììfàá</text></form></note>
  </entry>
  <entry id="tiilaa_4015">
    <lexical-unit><form lang="kqs"><text>tiilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiila</text></form></variant>
    <sense id="tiilaa_4015_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>assiéger, cerner</text></gloss>
      <gloss lang="en"><text>besiege, surround</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first DEU.20.19; Keita 1979, p. 156: Tiilaa; Lexique kissi–français, p. 55: tiilaa/ tiila</text></form></note>
  </entry>
  <entry id="tiilanndo_4016">
    <lexical-unit><form lang="kqs"><text>tiilanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiilannde</text></form></variant>
    <variant><form lang="kqs"><text>tiilannda</text></form></variant>
    <variant><form lang="kqs"><text>tiilanndan</text></form></variant>
    <sense id="tiilanndo_4016_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rond, circulaire</text></gloss>
      <gloss lang="en"><text>round, circular</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) be round or full; curve, swirl</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first JDG.8.5; Lexique kissi–français, p. 55: tiilanndo; Childs 2000, p. 358: tììlăŋndó</text></form></note>
    <note><form lang="fr"><text>bulu tiilanndo « pain rond » (Jg 8,5) ; nile tiilannde « lobe de l'oreille » (Ex 29,20). Sans doute de la famille de tiilaa « encercler ».</text></form></note>
  </entry>
  <entry id="tíílíó_4017">
    <lexical-unit><form lang="kqs"><text>tíílíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tíílíó_4017_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouche piqueuse</text></gloss>
      <gloss lang="en"><text>biting fly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 358: tíílíó</text></form></note>
  </entry>
  <entry id="tiimbuuo_4018">
    <lexical-unit><form lang="kqs"><text>tiimbuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiimbuu</text></form></variant>
    <variant><form lang="kqs"><text>tiimbun</text></form></variant>
    <sense id="tiimbuuo_4018_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dénouer, défaire (les cheveux) ; ôter (des ornements)</text></gloss>
      <gloss lang="en"><text>loosen (hair); take off (ornaments)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.102.21; Childs 2000, p. 359: tììmbùùwó</text></form></note>
    <note><form lang="fr"><text>Forme plurielle (voyelle longue et -uu) de timbio « délier ».</text></form></note>
  </entry>
  <entry id="tiindaa_4019">
    <lexical-unit><form lang="kqs"><text>tiindaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiinda</text></form></variant>
    <sense id="tiindaa_4019_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>affermir, confirmer ; appuyer (la main sur) ; appuyer en frottant</text></gloss>
      <gloss lang="en"><text>make firm, confirm; lean (one's hand on); press while rubbing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>step on, press with the feet or hands, press against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EST.9.29; Lexique kissi–français, p. 55: tiindaa/ tiinda; Childs 2000, p. 359: tììndàá</text></form></note>
    <note><form lang="fr"><text>Verbe de base de tiindanndo « se fier à » ; vana tiinda baa o … coo « celui qui s'appuie sur … » (2 R 18,21).</text></form></note>
  </entry>
  <entry id="tiindanndo_4020">
    <lexical-unit><form lang="kqs"><text>tiindanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiindan</text></form></variant>
    <sense id="tiindanndo_4020_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se fier à, compter sur</text></gloss>
      <gloss lang="en"><text>trust in, rely on</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>depend on, trust (middle of 'step on, press')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first DEU.28.52; Childs 2000, p. 359: tììndǎŋndó</text></form></note>
  </entry>
  <entry id="tííndííyo_4021">
    <lexical-unit><form lang="kqs"><text>tííndííyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tííndíí</text></form></variant>
    <sense id="tííndííyo_4021_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>talon (bɛngu tííndííyo)</text></gloss>
      <gloss lang="en"><text>heel (bɛngu tííndííyo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heel, ankle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.3.15; Lexique kissi–français, p. 56: tindiio; Childs 2000, p. 360: tíndííyé</text></form></note>
    <note><form lang="fr"><text>Toujours avec bɛngu « pied » : bɛngu tííndííyo « talon » (GEN.3.15, GEN.25.26, JOB.18.9).</text></form></note>
  </entry>
  <entry id="tiiyaa_4022">
    <lexical-unit><form lang="kqs"><text>tiiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiiya</text></form></variant>
    <variant><form lang="kqs"><text>tiiyanin</text></form></variant>
    <sense id="tiiyaa_4022_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>atteindre, arriver à ; suffire</text></gloss>
      <gloss lang="en"><text>reach, arrive at; be enough</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 314 occurrences, first GEN.3.22; Lexique kissi–français, p. 55: tiiyaa/ tiiya; Childs 2000, p. 359: tììyàá</text></form></note>
  </entry>
  <entry id="tiiyallo_4023">
    <lexical-unit><form lang="kqs"><text>tiiyallo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiiyal</text></form></variant>
    <sense id="tiiyallo_4023_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter à, faire parvenir à ; annoncer (une nouvelle) à</text></gloss>
      <gloss lang="en"><text>bring to, deliver to; proclaim (news) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go somewhere for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first LEV.21.8; Childs 2000, p. 360: tììyàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tiiyaa.</text></form></note>
  </entry>
  <entry id="tika-tika_4024">
    <lexical-unit><form lang="kqs"><text>tika-tika</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tika-tika_4024_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>indécis</text></gloss>
      <gloss lang="en"><text>undecided</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tika-tika</text></form></note>
    <note><form lang="fr"><text>Voir aussi taka-taka.</text></form></note>
  </entry>
  <entry id="tíkítíkí_4025">
    <lexical-unit><form lang="kqs"><text>tíkítíkí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tíkítíkí_4025_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(bien coincé, bloqué)</text></gloss>
      <gloss lang="en"><text>(firmly stuck)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 360: tíkítíkí</text></form></note>
  </entry>
  <entry id="timbio_4026">
    <lexical-unit><form lang="kqs"><text>timbio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>timbi</text></form></variant>
    <sense id="timbio_4026_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>délier, détacher ; acquitter (un vœu)</text></gloss>
      <gloss lang="en"><text>untie, loosen; fulfil (a vow)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: explain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.25.21; Childs 2000, p. 360: tìmbìó</text></form></note>
  </entry>
  <entry id="timinikio_4027">
    <lexical-unit><form lang="kqs"><text>timinikio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="timinikio_4027_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soufre</text></gloss>
      <gloss lang="en"><text>sulphur</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: timinikio</text></form></note>
    <note><form lang="fr"><text>La Bible dit fungoo « soufre ».</text></form></note>
  </entry>
  <entry id="tindaa_4028">
    <lexical-unit><form lang="kqs"><text>tindaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tindalan</text></form></field>
    <variant><form lang="kqs"><text>tinda</text></form></variant>
    <variant><form lang="kqs"><text>tindala</text></form></variant>
    <sense id="tindaa_4028_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâton, canne ; bâton, verge</text></gloss>
      <gloss lang="en"><text>staff, walking stick ; staff, rod</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cane, walking stick</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.32.32; Keita 1979, p. 159: Tindan; Lexique kissi–français, p. 55: tinda; Childs 2000, p. 360: tìndàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tindan ; la Bible écrit tindaa, pl. tindalan. Lexique kissi–français, p. 55 : aussi tindan « la canne ».</text></form></note>
  </entry>
  <entry id="tindaa_4029">
    <lexical-unit><form lang="kqs"><text>tindaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tinda</text></form></variant>
    <sense id="tindaa_4029_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>boiter</text></gloss>
      <gloss lang="en"><text>limp</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.32.32; Lexique kissi–français, p. 55: tindaa/ tinda</text></form></note>
    <note><form lang="fr"><text>Homographe de tindaa « bâton, canne ».</text></form></note>
  </entry>
  <entry id="tindi_4030">
    <lexical-unit><form lang="kqs"><text>tindi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tindi_4030_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>réveiller ; ressusciter (qqn) ; se réveiller</text></gloss>
      <gloss lang="en"><text>wake (someone); raise (from the dead); wake up</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first LEV.13.23; Lexique kissi–français, p. 56: tindio/ tindi; Childs 2000, p. 360: tìndìó</text></form></note>
    <note><form lang="fr"><text>Causatif de tendu.</text></form></note>
  </entry>
  <entry id="tindi_4031">
    <lexical-unit><form lang="kqs"><text>tindi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tindila</text></form></field>
    <sense id="tindi_4031_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cicatrice (d'un ulcère, d'une brûlure) ; (pl.) marques</text></gloss>
      <gloss lang="en"><text>scar (of a boil, burn); (pl.) marks</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first LEV.13.23; Lexique kissi–français, p. 56: tindio; Childs 2000, p. 360: tìndìó</text></form></note>
    <note><form lang="fr"><text>tindi piɔŋndo « cicatrice de l'ulcère » (LEV.13.23) ; tindi paw « cicatrice de la brûlure » (LEV.13.28) ; tindila « les marques (de Jésus) » (GAL.6.17). Homographe de tindi « réveiller ». Lexique kissi–français, p. 56 : tindio « la cicatrice ».</text></form></note>
  </entry>
  <entry id="tindilen_4032">
    <lexical-unit><form lang="kqs"><text>tindilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tindile</text></form></variant>
    <sense id="tindilen_4032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colonne</text></gloss>
      <gloss lang="en"><text>pillar, column</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.44.13</text></form></note>
    <note><form lang="fr"><text>tindile ikumnden « la colonne de nuée ».</text></form></note>
  </entry>
  <entry id="tindima_4033">
    <lexical-unit><form lang="kqs"><text>tindima</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tindian</text></form></variant>
    <sense id="tindima_4033_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vagues, flots</text></gloss>
      <gloss lang="en"><text>waves, billows</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a place with a fast current, rapids in a river</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 2SA.22.5; Childs 2000, p. 360: tìndíléŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel (classe ma ; aussi tindian). Le singulier n'est pas attesté dans ce sens (tindilen « colonne » est un autre mot). tindian ma sim maa lakpaki « les flots se dressèrent comme un mur » (EXO.15.8).</text></form></note>
  </entry>
  <entry id="tingan-tingan_4034">
    <lexical-unit><form lang="kqs"><text>tingan-tingan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tingan-tingan_4034_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>indécis, instable, déséquilibré</text></gloss>
      <gloss lang="en"><text>undecided, unsteady, off balance</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tingan-tingan</text></form></note>
  </entry>
  <entry id="tingɔɔ_4035">
    <lexical-unit><form lang="kqs"><text>tingɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tingu</text></form></variant>
    <sense id="tingɔɔ_4035_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramasser (du bois) ; rassembler (du bois)</text></gloss>
      <gloss lang="en"><text>gather (firewood); gather (wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="5.5.6 Fuel"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, fetch; also cut, break (wood)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.15.32; Lexique kissi–français, p. 56: tingɔɔ/ tingu; Childs 2000, p. 361: tìŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>yɔmnde tingɔɔ « ramasser du bois ».</text></form></note>
  </entry>
  <entry id="tinndaa_4036">
    <lexical-unit><form lang="kqs"><text>tinndaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tinnda</text></form></field>
    <sense id="tinndaa_4036_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>verge (pénis)</text></gloss>
      <gloss lang="en"><text>penis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tinndaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi tinnda « verge (avec adj.) ». Sens « pénis » probable (à confirmer).</text></form></note>
  </entry>
  <entry id="tinnɔnndo_4037">
    <lexical-unit><form lang="kqs"><text>tinnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tinnɔn</text></form></variant>
    <sense id="tinnɔnndo_4037_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maudire, jurer</text></gloss>
      <gloss lang="en"><text>curse, swear</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tinnɔnndo/ tinnɔn</text></form></note>
  </entry>
  <entry id="tintin_4038">
    <lexical-unit><form lang="kqs"><text>tintin</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tintin_4038_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>lentement</text></gloss>
      <gloss lang="en"><text>slowly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tintin</text></form></note>
  </entry>
  <entry id="tíó_4039">
    <lexical-unit><form lang="kqs"><text>tíó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tíó_4039_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>désobéissance, indiscipline</text></gloss>
      <gloss lang="en"><text>disobedience, unruliness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 361: tíó</text></form></note>
  </entry>
  <entry id="tiondɔɔ_4040">
    <lexical-unit><form lang="kqs"><text>tiondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiondu</text></form></variant>
    <variant><form lang="kqs"><text>tiandu</text></form></variant>
    <variant><form lang="kqs"><text>tindu</text></form></variant>
    <variant><form lang="kqs"><text>tiandunin</text></form></variant>
    <sense id="tiondɔɔ_4040_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réveiller, s'éveiller</text></gloss>
      <gloss lang="en"><text>wake up, awake</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1KI.18.27; Childs 2000, p. 362: tìɔ̀ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tiondu (impératif, Jg 5,12), tiandu (accompli, Gn 41,7), tindu (négatif, 1 S 26,12). Cf. tindi « réveiller (qqn) ».</text></form></note>
  </entry>
  <entry id="tisaa_4041">
    <lexical-unit><form lang="kqs"><text>tisaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tisa</text></form></variant>
    <variant><form lang="kqs"><text>tisanin</text></form></variant>
    <sense id="tisaa_4041_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>poursuivre, attaquer ; presser (qqn)</text></gloss>
      <gloss lang="en"><text>pursue, attack; urge on, hurry (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stumble, fall down; also jump on, assault; follow; bear witness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.56.2; Childs 2000, p. 362: tìsàá</text></form></note>
    <note><form lang="fr"><text>mɛlɛkaa tisa Lɔt kɔɔli « les anges pressèrent Lot » (Gn 19,15).</text></form></note>
  </entry>
  <entry id="tìsàá_4042">
    <lexical-unit><form lang="kqs"><text>tìsàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tìsàá_4042_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étui pénien en fibres de bambou (après la circoncision)</text></gloss>
      <gloss lang="en"><text>penile sheath of bamboo fibre (after circumcision)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 359: tìsàá</text></form></note>
  </entry>
  <entry id="tìsáá_4043">
    <lexical-unit><form lang="kqs"><text>tìsáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tìsáá_4043_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passage étroit d'un sentier</text></gloss>
      <gloss lang="en"><text>narrow part of a trail</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 362: tìsáá</text></form></note>
  </entry>
  <entry id="tiu_4044">
    <lexical-unit><form lang="kqs"><text>tiu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tiu_4044_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souffrir</text></gloss>
      <gloss lang="en"><text>suffer</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tiu</text></form></note>
    <note><form lang="fr"><text>Le Lexique ne donne que le radical. Homographe de tiu « pouvoir » (voir tiwba).</text></form></note>
  </entry>
  <entry id="tíú_4045">
    <lexical-unit><form lang="kqs"><text>tíú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tíú_4045_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(rond, bien courbé)</text></gloss>
      <gloss lang="en"><text>(round, curvaceous)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 362: tíú</text></form></note>
  </entry>
  <entry id="tivaa_4046">
    <lexical-unit><form lang="kqs"><text>tivaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tivaa_4046_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>toute l'étendue, la surface entière ; (o tivaa sɔ́) partout</text></gloss>
      <gloss lang="en"><text>whole extent, entire surface; (o tivaa sɔ́) all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note><form lang="fr"><text>nàà siaŋaa va ndu o tivaa sɔ́ « (sa main) était couverte de lèpre » (Ex 4,6) ; naŋɔɔ ndɔɔ co o tivaa o lɛŋnden coo « sa gloire est sur toute la terre » (Ps 148,13).</text></form></note>
  </entry>
  <entry id="tivolla_4047">
    <lexical-unit><form lang="kqs"><text>tivolla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tivoli</text></form></variant>
    <variant><form lang="kqs"><text>tivolaa</text></form></variant>
    <sense id="tivolla_4047_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chacals</text></gloss>
      <gloss lang="en"><text>jackals</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a wild dog-like animal ('fox')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first JOB.30.29; Childs 2000, p. 363: tíwɔ̂lló</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé avec certitude (tivoli, Mi 1,8).</text></form></note>
  </entry>
  <entry id="tiw_4048">
    <lexical-unit><form lang="kqs"><text>tiw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiw_4048_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>suffire, être assez grand pour ; venir à bout de</text></gloss>
      <gloss lang="en"><text>be enough, have room for; master, overcome</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread throughout; be enough, suffice; fit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 206 occurrences, first GEN.4.7; Childs 2000, p. 363: tìùwó</text></form></note>
    <note><form lang="fr"><text>tàndá kon ndóò tiw nda le « le pays ne leur suffisait pas » (Gn 13,6).</text></form></note>
  </entry>
  <entry id="tiwba_4049">
    <lexical-unit><form lang="kqs"><text>tiwba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiwba_4049_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pouvoir, être capable de</text></gloss>
      <gloss lang="en"><text>be able to, can</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4 Semantic constituents related to verbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 256 occurrences, first GEN.34.14; Lexique kissi–français, p. 56: tiuba</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 56 : tiu, tiuba, tiulɛ « pouvoir, être capable ».</text></form></note>
  </entry>
  <entry id="tìwììyó_4050">
    <lexical-unit><form lang="kqs"><text>tìwììyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tìwììyó_4050_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>esprit de la brousse, diable de brousse</text></gloss>
      <gloss lang="en"><text>bush devil, bush spirit</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 363: tìwììyó</text></form></note>
  </entry>
  <entry id="tìwùèìyó_4051">
    <lexical-unit><form lang="kqs"><text>tìwùèìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tìwùèìyó_4051_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poudre noire pour les sourcils (khôl)</text></gloss>
      <gloss lang="en"><text>eyebrow liner (black powder)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 363: tìwùèìyó</text></form></note>
  </entry>
  <entry id="tiwvo_4052">
    <lexical-unit><form lang="kqs"><text>tiwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiwvo_4052_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>suffire ; être assez, complet</text></gloss>
      <gloss lang="en"><text>be enough; be complete</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first NUM.11.22; Lexique kissi–français, p. 56: tiuo</text></form></note>
    <note><form lang="fr"><text>Lexique : tiuo « assez, complet ».</text></form></note>
  </entry>
  <entry id="tiyilaa_4053">
    <lexical-unit><form lang="kqs"><text>tiyilaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tiyila</text></form></variant>
    <sense id="tiyilaa_4053_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire qqch à qqn</text></gloss>
      <gloss lang="en"><text>tell something to someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tiyilaa/ tiyila</text></form></note>
  </entry>
  <entry id="tiŋ_4054">
    <lexical-unit><form lang="kqs"><text>tiŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tíŋ</text></form></variant>
    <sense id="tiŋ_4054_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un peu, quelque peu ; une partie, quelques-uns</text></gloss>
      <gloss lang="en"><text>a little, slightly; some, a few</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adj.) some, a few; (adv.) a little, slightly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 76 occurrences, first GEN.18.2; Childs 2000, p. 360: tìŋ</text></form></note>
    <note><form lang="fr"><text>isisi tiŋ lándán « debout à quelque distance » (GEN.18.2) ; kpeyanndo o tiŋ « une partie du grain » (LEV.2.16) ; co tiŋ n'siaŋa « rougeâtre » (LEV.13.43) ; mel a tiŋ « laisser quelques-uns » (GEN.33.15).</text></form></note>
  </entry>
  <entry id="tiŋio_4055">
    <lexical-unit><form lang="kqs"><text>tiŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiŋi</text></form></variant>
    <variant><form lang="kqs"><text>tiŋia</text></form></variant>
    <variant><form lang="kqs"><text>tiŋii</text></form></variant>
    <sense id="tiŋio_4055_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noir, sombre</text></gloss>
      <gloss lang="en"><text>black, dark</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>black, dark; also dark blue</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first SNG.1.6; Childs 2000, p. 361: tìŋì-</text></form></note>
    <note><form lang="fr"><text>so tiŋio « cheval noir » (Ap 6,5) ; saa tiŋia « moutons noirs » (Gn 30,32) ; kumii tiŋii « nuages sombres » (Ex 19,16).</text></form></note>
  </entry>
  <entry id="tiŋndo_4056">
    <lexical-unit><form lang="kqs"><text>tiŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiŋndo_4056_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>île ; distance, intervalle, espace (entre deux lieux)</text></gloss>
      <gloss lang="en"><text>island; distance, space (between two places)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a measure of distance, roughly a mile; also a demijohn bottle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.30.36; Keita 1979, p. 155: Tinndo; Lexique kissi–français, p. 56: tinndo; Childs 2000, p. 361: tíŋndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tiŋndo signifie « trajet, distance » (1KI.19.7) ; le sens « île » est à confirmer. Mó bɛndi tiŋndo nda tɛɛn nda Yakɔb « il mit une distance (de trois jours) entre lui et Jacob » (GEN.30.36). Homographe de tiŋndo « île » (Keita).</text></form></note>
  </entry>
  <entry id="tìŋndó_4057">
    <lexical-unit><form lang="kqs"><text>tìŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tìŋndó_4057_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dispute, palabre déclenchée sans raison</text></gloss>
      <gloss lang="en"><text>argument or palaver started for no reason</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 361: tìŋndó</text></form></note>
  </entry>
  <entry id="tíŋtíŋ_4058">
    <lexical-unit><form lang="kqs"><text>tíŋtíŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tíŋtíŋ_4058_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(son d'une guitare, d'un instrument à cordes)</text></gloss>
      <gloss lang="en"><text>(sound of a guitar or string instrument)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 361: tíŋtíŋ</text></form></note>
  </entry>
  <entry id="tìŋɔ̀léŋ_4059">
    <lexical-unit><form lang="kqs"><text>tìŋɔ̀léŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tìŋɔ̀láŋ</text></form></field>
    <sense id="tìŋɔ̀léŋ_4059_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>alêne, poinçon</text></gloss>
      <gloss lang="en"><text>awl</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 361: tìŋɔ̀léŋ</text></form></note>
  </entry>
  <entry id="tíŋɔ́ŋ_4060">
    <lexical-unit><form lang="kqs"><text>tíŋɔ́ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tíŋɔ́ŋ_4060_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(muet, interdit, sans réponse)</text></gloss>
      <gloss lang="en"><text>(dumbstruck, unable to answer)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 361: tíŋɔ́ŋ</text></form></note>
  </entry>
  <entry id="tiŋɔɔ_4061">
    <lexical-unit><form lang="kqs"><text>tiŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiŋɔɔ_4061_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>provoquer, tenter, mettre à l'épreuve ; harceler</text></gloss>
      <gloss lang="en"><text>provoke, put to the test; harass</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pledge, vow; also start an argument without provocation</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.17.2; Lexique kissi–français, p. 56: tiŋɔɔ; Childs 2000, p. 361: tìŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tiɔmɔɔ_4062">
    <lexical-unit><form lang="kqs"><text>tiɔmɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiɔm</text></form></variant>
    <sense id="tiɔmɔɔ_4062_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>joindre, unir ; (tiɔm balan) battre des mains ; (tiɔmɔɔ a) avoir des relations avec</text></gloss>
      <gloss lang="en"><text>join, unite; (tiɔm balan) clap one's hands; (tiɔmɔɔ a) have sexual relations with</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>card or comb cotton; clap hands, snap fingers; flirt, make love (esp. adulterously)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.36.12; Childs 2000, p. 362: tìɔ̀mɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Elifas va tiɔmɔɔ nda cuaa pum « Éliphaz avait une concubine » (Gn 36,12) ; n kɔ lɔl tiɔmɔɔ « enivrons-nous d'amour » (Pr 7,18).</text></form></note>
  </entry>
  <entry id="tiɔn_4063">
    <lexical-unit><form lang="kqs"><text>tiɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ŋiɔn</text></form></variant>
    <variant><form lang="kqs"><text>ŋiin</text></form></variant>
    <variant><form lang="kqs"><text>miɔn</text></form></variant>
    <variant><form lang="kqs"><text>miun</text></form></variant>
    <variant><form lang="kqs"><text>miunndon</text></form></variant>
    <sense id="tiɔn_4063_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>deux</text></gloss>
      <gloss lang="en"><text>two</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 168 occurrences, first GEN.1.6; Lexique kissi–français, p. 35: miun; Childs 2000, p. 362: tìɔ́ɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>La forme varie selon la classe du nom compté. Lexique kissi–français, p. 35 : miun « deux » (cf. GEN.1.16). Aussi Lexique kissi–français, p. 36 : « muun ». Lexique kissi–français, p. 36 : muun « deux ».</text></form></note>
  </entry>
  <entry id="tìɔ̀ɔ́_4064">
    <lexical-unit><form lang="kqs"><text>tìɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tèèláŋ</text></form></field>
    <sense id="tìɔ̀ɔ́_4064_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>responsabilité, faute imputée</text></gloss>
      <gloss lang="en"><text>responsibility, blame</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 362: tìɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tìɲàá_4065">
    <lexical-unit><form lang="kqs"><text>tìɲàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tìɲàá_4065_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>presser pour extraire la dernière goutte</text></gloss>
      <gloss lang="en"><text>squeeze out the last drop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 360: tìɲàá</text></form></note>
  </entry>
  <entry id="tiɲio_4066">
    <lexical-unit><form lang="kqs"><text>tiɲio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tiɲie</text></form></variant>
    <sense id="tiɲio_4066_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noir</text></gloss>
      <gloss lang="en"><text>black</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tiɲio</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne tiɲie et tiɲio « noir » (formes d'accord).</text></form></note>
  </entry>
  <entry id="to_4067">
    <lexical-unit><form lang="kqs"><text>to</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="to_4067_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>contraction négative</text></gloss>
      <gloss lang="en"><text>negative contraction</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: to</text></form></note>
    <note><form lang="fr"><text>Le Lexique dit seulement « contraction négatif ». À confirmer.</text></form></note>
  </entry>
  <entry id="to_4068">
    <lexical-unit><form lang="kqs"><text>to</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="to_4068_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sud ; bas (de la page)</text></gloss>
      <gloss lang="en"><text>south; bottom (of the page)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: to</text></form></note>
  </entry>
  <entry id="toal_4069">
    <lexical-unit><form lang="kqs"><text>toal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toalnin</text></form></variant>
    <sense id="toal_4069_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre (sur)</text></gloss>
      <gloss lang="en"><text>come down (upon)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 178 occurrences, first GEN.11.5</text></form></note>
  </entry>
  <entry id="toandaa_4070">
    <lexical-unit><form lang="kqs"><text>toandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toandaa_4070_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, étendre (toile, filet)</text></gloss>
      <gloss lang="en"><text>stretch out, spread (cloth, net)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 354 occurrences, first GEN.9.21</text></form></note>
    <note><form lang="fr"><text>cɛi-kola-toandaa « tente » (maison de toile tendue).</text></form></note>
  </entry>
  <entry id="toaŋaa_4071">
    <lexical-unit><form lang="kqs"><text>toaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toaŋ</text></form></variant>
    <variant><form lang="kqs"><text>toaŋan</text></form></variant>
    <sense id="toaŋaa_4071_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire (galettes), griller (grains)</text></gloss>
      <gloss lang="en"><text>bake (flat bread), parch (grain)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry, cook</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.29.2; Childs 2000, p. 365: tɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>dɛɛ toaŋaa « galettes » (Ex 29,2) ; kulun toaŋan « grain grillé » (Jos 5,11).</text></form></note>
  </entry>
  <entry id="tódǎŋ_4072">
    <lexical-unit><form lang="kqs"><text>tódǎŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tódǎŋ_4072_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>pleinement, complètement</text></gloss>
      <gloss lang="en"><text>fully</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 363: tódǎŋ</text></form></note>
  </entry>
  <entry id="tofaa_4073">
    <lexical-unit><form lang="kqs"><text>tofaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tofa</text></form></variant>
    <variant><form lang="kqs"><text>tofanin</text></form></variant>
    <sense id="tofaa_4073_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder, voir</text></gloss>
      <gloss lang="en"><text>look at, see</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: inspect, taste, search, find out</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 158 occurrences, first GEN.2.9; Lexique kissi–français, p. 56: tofaa/ tofa; Childs 2000, p. 363: tòfàá</text></form></note>
  </entry>
  <entry id="tofan_4074">
    <lexical-unit><form lang="kqs"><text>tofan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tofan_4074_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se retourner pour regarder ; regarder vers</text></gloss>
      <gloss lang="en"><text>look back; look to</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>look at oneself (in a mirror)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.19.17; Childs 2000, p. 363: tòfǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de tofaa.</text></form></note>
  </entry>
  <entry id="tofanndo_4075">
    <lexical-unit><form lang="kqs"><text>tofanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tofanndan</text></form></field>
    <sense id="tofanndo_4075_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>miroir ; regard</text></gloss>
      <gloss lang="en"><text>mirror; looking</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOS.8.20; Keita 1979, p. 144: Tofanndo; Lexique kissi–français, p. 56: tofanndo; Childs 2000, p. 363: tɔ̀fáŋndó</text></form></note>
  </entry>
  <entry id="tofaɔ_4076">
    <lexical-unit><form lang="kqs"><text>tofaɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tofaɔ_4076_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>regard</text></gloss>
      <gloss lang="en"><text>look, gaze</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tofaɔ</text></form></note>
    <note><form lang="fr"><text>De tofaa « regarder ».</text></form></note>
  </entry>
  <entry id="tofiaa_4077">
    <lexical-unit><form lang="kqs"><text>tofiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tofia</text></form></variant>
    <sense id="tofiaa_4077_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chercher (du regard)</text></gloss>
      <gloss lang="en"><text>look for</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tofiaa/ tofia</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « chercher ». Itératif de tofaa « regarder ».</text></form></note>
  </entry>
  <entry id="tofianndo_4078">
    <lexical-unit><form lang="kqs"><text>tofianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tofian</text></form></variant>
    <sense id="tofianndo_4078_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se jeter un coup d'œil l'un à l'autre</text></gloss>
      <gloss lang="en"><text>glance at each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tofianndo/ tofian</text></form></note>
  </entry>
  <entry id="tòkpùéí_4079">
    <lexical-unit><form lang="kqs"><text>tòkpùéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tòkpòóŋ</text></form></field>
    <sense id="tòkpùéí_4079_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>noix de palme à peau épaisse</text></gloss>
      <gloss lang="en"><text>thick-skinned palm nut</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 363: tòkpùéí</text></form></note>
  </entry>
  <entry id="tolinndo_4080">
    <lexical-unit><form lang="kqs"><text>tolinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tolin</text></form></variant>
    <sense id="tolinndo_4080_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>persécuter, maltraiter</text></gloss>
      <gloss lang="en"><text>persecute, mistreat</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tolinndo/ tolin</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi tolinndu yɛlen (radical) « maltraiter, persécuter qqn ».</text></form></note>
  </entry>
  <entry id="tólítólí_4081">
    <lexical-unit><form lang="kqs"><text>tólítólí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tólítólí_4081_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(écoulement rapide, jaillissement)</text></gloss>
      <gloss lang="en"><text>(rapid flow, gushing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 363: tólítólí</text></form></note>
  </entry>
  <entry id="tòlòmàá_4082">
    <lexical-unit><form lang="kqs"><text>tòlòmàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tòlòmàá_4082_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit animal lent ressemblant au chat, frugivore (potto ?)</text></gloss>
      <gloss lang="en"><text>slow-moving cat-like fruit-eating animal (potto?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 364: tòlòmàá</text></form></note>
  </entry>
  <entry id="tolɔɔ_4083">
    <lexical-unit><form lang="kqs"><text>tolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tol</text></form></variant>
    <variant><form lang="kqs"><text>toal</text></form></variant>
    <variant><form lang="kqs"><text>tul</text></form></variant>
    <variant><form lang="kqs"><text>toalnin</text></form></variant>
    <variant><form lang="kqs"><text>tulnin</text></form></variant>
    <sense id="tolɔɔ_4083_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre</text></gloss>
      <gloss lang="en"><text>go down, descend</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>descend, climb or slide down</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 125 occurrences, first GEN.8.3; Keita 1979, p. 115: Tolöö; Lexique kissi–français, p. 56: tolɔɔ/ tol, tul, toal; Childs 2000, p. 364: tòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tul, tulnin : radical négatif (EXO 12,23). Aussi Lexique kissi–français, p. 58 : « tual ». Lexique kissi–français, p. 58 : radical tual.</text></form></note>
  </entry>
  <entry id="tomaa_4084">
    <lexical-unit><form lang="kqs"><text>tomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tomaa_4084_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vieillard (Keita)</text></gloss>
      <gloss lang="en"><text>old man (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Tomaa; Lexique kissi–français, p. 56: tomaa</text></form></note>
    <note><form lang="fr"><text>Le seul emploi biblique (Ac 11,2, tomaa-a) ne confirme pas le sens « vieillard ». Confirmé au Nord par le Lexique kissi–français, p. 56 (« un vieillard »).</text></form></note>
  </entry>
  <entry id="tomaa_4085">
    <lexical-unit><form lang="kqs"><text>tomaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toma</text></form></variant>
    <sense id="tomaa_4085_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>circoncision ; incision, scarification (garçons et filles)</text></gloss>
      <gloss lang="en"><text>circumcision; incision, scarification (boys and girls)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ACT.11.2; Lexique kissi–français, p. 56: tomaa</text></form></note>
    <note><form lang="fr"><text>Bible : dii haa toma « incirconcis » (JDG.15.18, ACT.7.51). Homographe de tomaa « vieillard ».</text></form></note>
  </entry>
  <entry id="tòmbàá_4086">
    <lexical-unit><form lang="kqs"><text>tòmbàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tòmbàá_4086_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manioc cuit avant d'être pilé</text></gloss>
      <gloss lang="en"><text>cassava cooked before pounding</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 364: tòmbàá</text></form></note>
  </entry>
  <entry id="tombolaa_4087">
    <lexical-unit><form lang="kqs"><text>tombolaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tombola</text></form></variant>
    <variant><form lang="kqs"><text>tombolal</text></form></variant>
    <sense id="tombolaa_4087_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>joindre, assembler ; raconter, exposer ; nouer, lacer, attacher deux bouts de corde</text></gloss>
      <gloss lang="en"><text>join, couple; tell, recount; knot, lace, tie two rope ends together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>talk, discuss, explain; join together, line up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.36.18; Lexique kissi–français, p. 56: tonbolaa/ tonbola; Childs 2000, p. 364: tɔ̀mbɔ̀làá</text></form></note>
    <note><form lang="fr"><text>tombola lɔma « raconter un rêve » (Gn 40,9) ; tombolal « raconter à » (Gn 41,8) ; tombolaa « assembler (la tente) » (Ex 36,18). Le kissi du Sud a les deux sens dans le même verbe (Childs).</text></form></note>
  </entry>
  <entry id="tómbólàá_4088">
    <lexical-unit><form lang="kqs"><text>tómbólàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tómbólàá_4088_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argent ou nourriture offerts aux morts</text></gloss>
      <gloss lang="en"><text>money or food offered to the dead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 364: tómbólàá</text></form></note>
  </entry>
  <entry id="tomboliaa_4089">
    <lexical-unit><form lang="kqs"><text>tomboliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tomboliaa_4089_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>assembler, coudre ensemble (plusieurs pièces)</text></gloss>
      <gloss lang="en"><text>join together, sew together (many pieces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>line up things or people; talk in sequence</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.26.14; Childs 2000, p. 364: tɔ̀mbɔ̀lìá</text></form></note>
    <note><form lang="fr"><text>Dérivé de tombolaa « joindre ».</text></form></note>
  </entry>
  <entry id="tombollo_4090">
    <lexical-unit><form lang="kqs"><text>tombollo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tombollo_4090_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pou de corps (qui vit dans les vêtements)</text></gloss>
      <gloss lang="en"><text>body louse (living in clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tonbollo</text></form></note>
  </entry>
  <entry id="tómbólóó_4091">
    <lexical-unit><form lang="kqs"><text>tómbólóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tómbólóó_4091_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>puces (surtout celles des vêtements)</text></gloss>
      <gloss lang="en"><text>fleas (esp. in clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 364: tómbólóó</text></form></note>
  </entry>
  <entry id="tòmbòmɛ́sɔ́ɔ́_4092">
    <lexical-unit><form lang="kqs"><text>tòmbòmɛ́sɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tòmbòmɛ́sɔ́ɔ́_4092_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (espèce) ressemblant à un arbre</text></gloss>
      <gloss lang="en"><text>tree-like plant species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 365: tòmbòmɛ́sɔ́ɔ́</text></form></note>
  </entry>
  <entry id="tombon_4093">
    <lexical-unit><form lang="kqs"><text>tombon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tombon_4093_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hauts lieux (lieux de culte)</text></gloss>
      <gloss lang="en"><text>high places (shrines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first 1KI.13.33</text></form></note>
    <note><form lang="fr"><text>Pluriel.</text></form></note>
  </entry>
  <entry id="tòmbòó_4094">
    <lexical-unit><form lang="kqs"><text>tòmbòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tòmbòó_4094_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taille, ventre (où les femmes gardent leur petite bourse)</text></gloss>
      <gloss lang="en"><text>waist area (where women keep a small purse)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 364: tòmbòó</text></form></note>
  </entry>
  <entry id="tómbòó_4095">
    <lexical-unit><form lang="kqs"><text>tómbòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tómbòláŋ</text></form></field>
    <sense id="tómbòó_4095_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>société secrète mixte (on s'y présente dévêtu)</text></gloss>
      <gloss lang="en"><text>secret society of men and women (members disrobe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 365: tómbòó</text></form></note>
  </entry>
  <entry id="tòmbòó_4096">
    <lexical-unit><form lang="kqs"><text>tòmbòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tòmbòó_4096_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>objet noué dans le pagne (par les femmes), tenu caché</text></gloss>
      <gloss lang="en"><text>object tied into a woman's wrapper, kept hidden</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 365: tòmbòó</text></form></note>
  </entry>
  <entry id="tómbòsìɔ́_4097">
    <lexical-unit><form lang="kqs"><text>tómbòsìɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tómbòsìá</text></form></field>
    <sense id="tómbòsìɔ́_4097_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tout petit rat, héros des contes (Tombose)</text></gloss>
      <gloss lang="en"><text>tiny rat, hero of folk tales (Tombose)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 365: tómbòsìɔ́</text></form></note>
  </entry>
  <entry id="tondanndo_4098">
    <lexical-unit><form lang="kqs"><text>tondanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tondanndo_4098_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>échasses</text></gloss>
      <gloss lang="en"><text>stilts</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tondanndo</text></form></note>
  </entry>
  <entry id="tóndóó_4099">
    <lexical-unit><form lang="kqs"><text>tóndóó</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tóndó</text></form></variant>
    <sense id="tóndóó_4099_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fournaise, four</text></gloss>
      <gloss lang="en"><text>furnace, kiln</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="5.5.7 Fireplace"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>blacksmith's furnace; also the base of elephant grass; a young cow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.21.10; Childs 2000, p. 365: tóndóó</text></form></note>
    <note><form lang="fr"><text>tóndó bɛndu « grande fournaise » (EXO.9.8) ; tóndó icilin tuwvo « fournaise à fondre le fer » (DEU.4.20).</text></form></note>
  </entry>
  <entry id="tondɔnndo_4100">
    <lexical-unit><form lang="kqs"><text>tondɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tondɔnndo_4100_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'étirer, se détendre</text></gloss>
      <gloss lang="en"><text>stretch oneself, relax</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tondɔnndo</text></form></note>
    <note><form lang="fr"><text>Moyen de tondɔɔ « étendre ».</text></form></note>
  </entry>
  <entry id="tondɔɔ_4101">
    <lexical-unit><form lang="kqs"><text>tondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tondu</text></form></variant>
    <variant><form lang="kqs"><text>tondunin</text></form></variant>
    <sense id="tondɔɔ_4101_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser (une tente), suspendre (un rideau) ; étendre</text></gloss>
      <gloss lang="en"><text>set up, pitch (a tent); hang (a curtain); stretch out, spread</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.35.18; Lexique kissi–français, p. 56: tondɔɔ/ tondu</text></form></note>
  </entry>
  <entry id="tongei_4102">
    <lexical-unit><form lang="kqs"><text>tongei</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tongii</text></form></variant>
    <sense id="tongei_4102_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>largeur ; largeur de main, palme</text></gloss>
      <gloss lang="en"><text>width, breadth; handbreadth, span</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) wide (from tɔ̀ŋɔ̀ɔ́ 'widen')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.25.25; Childs 2000, p. 365: tɔ̀ŋgéí</text></form></note>
    <note><form lang="fr"><text>tongei dunndo tɔ́ « large de dix coudées » (1KI.7.23) ; pɛngɔn tongei a ba kɔllo « une bordure large d'une main » (EXO.25.25) ; tongii « palme, empan » (PSA.39.6, ISA.40.12). Cf. tongu « être large ».</text></form></note>
  </entry>
  <entry id="tongitongio_4103">
    <lexical-unit><form lang="kqs"><text>tongitongio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tongitongio_4103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite guêpe noire</text></gloss>
      <gloss lang="en"><text>small black wasp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tongitongio</text></form></note>
  </entry>
  <entry id="tongo_4104">
    <lexical-unit><form lang="kqs"><text>tongo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tongo_4104_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>portique, vestibule, salle</text></gloss>
      <gloss lang="en"><text>porch, hall</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>village hall, open roofed meeting house</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first 1KI.6.3; Childs 2000, p. 365: tɔ̀ŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tongo cɔwvo_4105">
    <lexical-unit><form lang="kqs"><text>tongo cɔwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tongo cɔwvo_4105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forge</text></gloss>
      <gloss lang="en"><text>forge, smithy</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lit. 'war hut': the smithy, where the weapons were made</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Tongo työwvo; Lexique kissi–français, p. 56: tongo cɔwvo; Childs 2000, p. 365: tɔ̀ŋgɔ́-cɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; tongo « hangar, salle » (1 R 7,7) et cɔwvo sont dans la Bible. Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="tongoo_4106">
    <lexical-unit><form lang="kqs"><text>tongoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tongoo_4106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nièce, neveu</text></gloss>
      <gloss lang="en"><text>niece, nephew</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tongoo</text></form></note>
    <note><form lang="fr"><text>Homographe : tongoo dans la Bible (JDG.3.20) désigne une pièce (chambre haute).</text></form></note>
  </entry>
  <entry id="tongu_4107">
    <lexical-unit><form lang="kqs"><text>tongu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tongu_4107_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être large, vaste ; élargir</text></gloss>
      <gloss lang="en"><text>be wide, spacious; broaden</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NEH.3.8; Childs 2000, p. 365: tɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>dio tongu taw-vo « la porte large » (Mt 7,13) ; a tongu boofiaala ndalan « ils élargissent leurs phylactères » (Mt 23,5).</text></form></note>
  </entry>
  <entry id="tonguo_4108">
    <lexical-unit><form lang="kqs"><text>tonguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tonguo_4108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>largeur ; large</text></gloss>
      <gloss lang="en"><text>width; wide</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tonguo</text></form></note>
    <note><form lang="fr"><text>La Bible dit buo « largeur ».</text></form></note>
  </entry>
  <entry id="tongɔlɔɔ_4109">
    <lexical-unit><form lang="kqs"><text>tongɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tongɔlɔɔ_4109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tornade, vent violent</text></gloss>
      <gloss lang="en"><text>tornado, strong wind</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 56: tongɔlɔɔ</text></form></note>
  </entry>
  <entry id="tonndo_4110">
    <lexical-unit><form lang="kqs"><text>tonndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tonndo_4110_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>battu, usé, qui tombe en morceaux</text></gloss>
      <gloss lang="en"><text>beaten, worn out, falling to pieces</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tonndo</text></form></note>
    <note><form lang="fr"><text>Définition corrigée à la main dans le Lexique (d'abord « battre »).</text></form></note>
  </entry>
  <entry id="tontonnden_4111">
    <lexical-unit><form lang="kqs"><text>tontonnden</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="respelled"/>
    <sense id="tontonnden_4111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouttes d'eau (qui tombent) ; gouttes de pluie</text></gloss>
      <gloss lang="en"><text>water droplets; raindrops</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tontonnden; Childs 2000, p. 366: tóŋtóŋndéŋ</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 57 (« les gouttes de pluie »), écrit tontonnden.</text></form></note>
  </entry>
  <entry id="too_4112">
    <lexical-unit><form lang="kqs"><text>too</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="too_4112_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sud (a ba too « vers le sud »)</text></gloss>
      <gloss lang="en"><text>south (a ba too 'southward')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>low, lower part, below, down; also Monrovia (down-country)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.12.9; Childs 2000, p. 366: tòò</text></form></note>
  </entry>
  <entry id="too_4113">
    <lexical-unit><form lang="kqs"><text>too</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="too_4113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pâte collante de farine de manioc</text></gloss>
      <gloss lang="en"><text>sticky cassava-flour dough</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: too</text></form></note>
    <note><form lang="fr"><text>Homographe de too « sud » (Bible).</text></form></note>
  </entry>
  <entry id="tòòlóó_4114">
    <lexical-unit><form lang="kqs"><text>tòòlóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tòòlóláŋ</text></form></field>
    <sense id="tòòlóó_4114_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie (tétanos ?) contractée en marchant sur un objet</text></gloss>
      <gloss lang="en"><text>disease, possibly tetanus, from stepping on something</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 366: tòòlóó</text></form></note>
  </entry>
  <entry id="tooluo_4115">
    <lexical-unit><form lang="kqs"><text>tooluo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>toolu</text></form></variant>
    <variant><form lang="kqs"><text>toolunin</text></form></variant>
    <sense id="tooluo_4115_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arranger, réparer ; pourvoir ; secourir ; envoyer qqn</text></gloss>
      <gloss lang="en"><text>arrange, repair; provide for; help, rescue; send someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>assist, help</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Toolno; Lexique kissi–français, p. 57: tooluo/ toolu; Childs 2000, p. 366: tòòlòó</text></form></note>
    <note><form lang="fr"><text>Keita imprime toolno (pour tooluo ?). toolu dans la Bible : « pourvoir largement » (DEU 15,14), « vanner » (JER 51,2) ; sens à préciser. Lexique kissi–français, p. 57 : tooluo/ toolu « envoyer qqn » et « secourir ».</text></form></note>
  </entry>
  <entry id="tooma pɔɔndo_4116">
    <lexical-unit><form lang="kqs"><text>tooma pɔɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tooma pɔɔndo_4116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tatouages</text></gloss>
      <gloss lang="en"><text>tattoos</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boys' initiation society (Poro)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Tooma Pööndo; Lexique kissi–français, p. 57: tooma pɔɔndo; Childs 2000, p. 367: tóómá-pɔ̀ɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Sens à confirmer : Childs donne la société d'initiation des garçons ; dans la Bible, tooma est la circoncision. Confirmé au Nord par le Lexique kissi–français, p. 57 (« tatouage »).</text></form></note>
  </entry>
  <entry id="tóómá-bòndóó_4117">
    <lexical-unit><form lang="kqs"><text>tóómá-bòndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tóómá-bòndóó_4117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>société d'initiation des filles (Sande)</text></gloss>
      <gloss lang="en"><text>girls' initiation society (Sande)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 367: tóómá-bòndóó</text></form></note>
  </entry>
  <entry id="toomaa_4118">
    <lexical-unit><form lang="kqs"><text>toomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tooma</text></form></variant>
    <sense id="toomaa_4118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>circoncision</text></gloss>
      <gloss lang="en"><text>circumcision</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.17</text></form></note>
    <note><form lang="fr"><text>dii toomaa « circoncire ».</text></form></note>
  </entry>
  <entry id="toongoo_4119">
    <lexical-unit><form lang="kqs"><text>toongoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="toongoo_4119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>neveu, nièce (enfant de la sœur)</text></gloss>
      <gloss lang="en"><text>nephew, niece (sister's child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nephew, sister's son</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.29.12; Keita 1979, p. 134: Toongoo Piaanduo; Childs 2000, p. 365: tòŋóó</text></form></note>
    <note><form lang="fr"><text>En Gn 29,12, Jacob est le toongoo de Laban, frère de sa mère. Keita : Toongoo piaanduo « le neveu », Toongoo laanduo « la nièce ».</text></form></note>
  </entry>
  <entry id="toongoo lannduo_4120">
    <lexical-unit><form lang="kqs"><text>toongoo lannduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="toongoo lannduo_4120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nièce</text></gloss>
      <gloss lang="en"><text>niece</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: toongoo lannduo</text></form></note>
    <note><form lang="fr"><text>Voir tongoo « nièce, neveu ».</text></form></note>
  </entry>
  <entry id="toongoo piaanduo_4121">
    <lexical-unit><form lang="kqs"><text>toongoo piaanduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="toongoo piaanduo_4121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>neveu</text></gloss>
      <gloss lang="en"><text>nephew</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: toongoo piaanduo</text></form></note>
    <note><form lang="fr"><text>Voir tongoo « nièce, neveu ».</text></form></note>
  </entry>
  <entry id="toosiaa_4122">
    <lexical-unit><form lang="kqs"><text>toosiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toosian</text></form></variant>
    <variant><form lang="kqs"><text>toosial</text></form></variant>
    <sense id="toosiaa_4122_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, fabriquer, préparer ; arranger, réparer (Keita)</text></gloss>
      <gloss lang="en"><text>make, prepare; repair (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 543 occurrences, first GEN.1.16; Keita 1979, p. 113: Toosiaa; Lexique kissi–français, p. 57: toosiaa/ toosia</text></form></note>
    <note><form lang="fr"><text>Pluriel de tosaa ; dans la Bible « faire, créer » (GEN 1,16).</text></form></note>
  </entry>
  <entry id="toosial_4123">
    <lexical-unit><form lang="kqs"><text>toosial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toosial_4123_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, préparer pour (qqn)</text></gloss>
      <gloss lang="en"><text>make, prepare for (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fix, make, dress (someone) for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.2.18; Childs 2000, p. 367: tòòsìàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de toosiaa « faire, arranger ».</text></form></note>
  </entry>
  <entry id="toosian_4124">
    <lexical-unit><form lang="kqs"><text>toosian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toosian_4124_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fait, préparé (de)</text></gloss>
      <gloss lang="en"><text>be made, prepared (of)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>get prepared; get dressed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 151 occurrences, first GEN.19.3; Childs 2000, p. 367: tòòsìǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de toosiaa : bulu toosian a lɛvɛn too « pain fait sans levain ».</text></form></note>
  </entry>
  <entry id="tootoo_4125">
    <lexical-unit><form lang="kqs"><text>tootoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tootoo_4125_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bas ; humblement ; à voix basse</text></gloss>
      <gloss lang="en"><text>low; humbly; in a whisper</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>underscores how low (ideophone)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first 1SA.2.7; Childs 2000, p. 367: tóòtò</text></form></note>
  </entry>
  <entry id="toovaa_4126">
    <lexical-unit><form lang="kqs"><text>toovaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="toovaa_4126_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taureau</text></gloss>
      <gloss lang="en"><text>bull</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>male animal (cow, sheep, etc.), bull</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Toovaa; Lexique kissi–français, p. 57: toovaa; Childs 2000, p. 367: tòòyòó</text></form></note>
  </entry>
  <entry id="toovio_4127">
    <lexical-unit><form lang="kqs"><text>toovio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>toovia</text></form></field>
    <sense id="toovio_4127_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouc</text></gloss>
      <gloss lang="en"><text>he-goat, billy goat</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.37.31; Keita 1979, p. 137: Toovio; Lexique kissi–français, p. 57: [t]ovio</text></form></note>
  </entry>
  <entry id="tosaa_4128">
    <lexical-unit><form lang="kqs"><text>tosaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosa</text></form></variant>
    <variant><form lang="kqs"><text>tosanin</text></form></variant>
    <variant><form lang="kqs"><text>tosan</text></form></variant>
    <variant><form lang="kqs"><text>tosal</text></form></variant>
    <sense id="tosaa_4128_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire</text></gloss>
      <gloss lang="en"><text>do, make</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1621 occurrences, first GEN.2.5; Keita 1979, p. 113: Tosaa; Lexique kissi–français, p. 57: tosaa/ tosa; Childs 2000, p. 367: tòsàá</text></form></note>
    <note><form lang="fr"><text>tosan « se faire, arriver » (moyen) ; tosal « faire pour » (bénéfactif). Lexique kissi–français, p. 57 : tosolaa/ tosola « faire qqch pour ou à qqn » (bénéfactif ; la Bible écrit tosal).</text></form></note>
  </entry>
  <entry id="tosalan_4129">
    <lexical-unit><form lang="kqs"><text>tosalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tosalan_4129_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arriver à (qqn)</text></gloss>
      <gloss lang="en"><text>happen to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.44.29</text></form></note>
    <note><form lang="fr"><text>Moyen de tosal, bénéfactif de tosaa.</text></form></note>
  </entry>
  <entry id="tosallo_4130">
    <lexical-unit><form lang="kqs"><text>tosallo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosal</text></form></variant>
    <variant><form lang="kqs"><text>tosalnin</text></form></variant>
    <sense id="tosallo_4130_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire pour, faire à (qqn)</text></gloss>
      <gloss lang="en"><text>do for, do to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 164 occurrences, first GEN.21.12; Childs 2000, p. 367: tòsàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tosaa « faire ».</text></form></note>
  </entry>
  <entry id="tosanndo_4131">
    <lexical-unit><form lang="kqs"><text>tosanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tosan</text></form></variant>
    <variant><form lang="kqs"><text>tosannin</text></form></variant>
    <sense id="tosanndo_4131_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se faire, arriver ; être fait ; pratique</text></gloss>
      <gloss lang="en"><text>happen, come about; be done; practice</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be done, be made; succeed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 96 occurrences, first GEN.6.11; Lexique kissi–français, p. 57: tosanndo; Childs 2000, p. 367: tòsǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de tosaa « faire ». Mí ɲɔɔ tosan lende « Et il en fut ainsi » (Gn 1,7). Lexique kissi–français, p. 57 : tosanndo « la pratique ».</text></form></note>
  </entry>
  <entry id="toto_4132">
    <lexical-unit><form lang="kqs"><text>toto</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="toto_4132_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>bas</text></gloss>
      <gloss lang="en"><text>low</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: toto</text></form></note>
    <note><form lang="fr"><text>Cf. tuisinndo toto « l'humilité » (Lexique, p. 58).</text></form></note>
  </entry>
  <entry id="tova_4133">
    <lexical-unit><form lang="kqs"><text>tova</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tovaa</text></form></variant>
    <sense id="tova_4133_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mâle (bovin)</text></gloss>
      <gloss lang="en"><text>male (of cattle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>male (cow, sheep, etc.), bull</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first EXO.29.1; Childs 2000, p. 367: tòòyòó</text></form></note>
    <note><form lang="fr"><text>naw tova « taureau », pluriel navaa tovaa.</text></form></note>
  </entry>
  <entry id="tovɔɔ_4134">
    <lexical-unit><form lang="kqs"><text>tovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toaw</text></form></variant>
    <variant><form lang="kqs"><text>toawnin</text></form></variant>
    <variant><form lang="kqs"><text>townun</text></form></variant>
    <sense id="tovɔɔ_4134_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chasser, expulser ; poursuivre ; creuser (un puits) ; diriger, emmener ; bêcher</text></gloss>
      <gloss lang="en"><text>drive out, expel; pursue; dig (a well); drive, lead away; dig; lead, take away; dig (with a hoe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 116 occurrences, first GEN.4.14; Lexique kissi–français, p. 56: toaw</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 56 : toaw (radical) « chasser, diriger, emmener » et « creuser, bêcher ». Aussi Lexique kissi–français, p. 57 : « tovɔɔ/ toaw ». Lexique kissi–français, p. 57 : aussi « diriger, emmener » et « creuser, bêcher ».</text></form></note>
  </entry>
  <entry id="tòwàá_4135">
    <lexical-unit><form lang="kqs"><text>tòwàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tòwàá_4135_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>harpe (à ventre), guitare</text></gloss>
      <gloss lang="en"><text>belly harp, guitar</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tòwàá</text></form></note>
  </entry>
  <entry id="towlen_4136">
    <lexical-unit><form lang="kqs"><text>towlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>towle</text></form></variant>
    <sense id="towlen_4136_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poutre, bois de charpente</text></gloss>
      <gloss lang="en"><text>beam, timber (of a roof)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZR.6.11; Lexique kissi–français, p. 57: towve</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit towve « les bois des charpentes pour le toit, la maison » ; la Bible a towle, towlen « poutre » (EZR.6.11). Lecture de towve à vérifier.</text></form></note>
  </entry>
  <entry id="tòŋgó-máàŋndó_4137">
    <lexical-unit><form lang="kqs"><text>tòŋgó-máàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tòŋgó-máàŋndó_4137_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite case sans murs à l'entrée du village où les anciens parlent aux ancêtres</text></gloss>
      <gloss lang="en"><text>small wall-less hut at the village entrance where elders address the ancestors</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 365: tòŋgó-máàŋndó</text></form></note>
  </entry>
  <entry id="toŋɔɔ_4138">
    <lexical-unit><form lang="kqs"><text>toŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toŋ</text></form></variant>
    <sense id="toŋɔɔ_4138_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>griller, cuire (galettes) ; frire</text></gloss>
      <gloss lang="en"><text>fry, bake (cakes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry, cook</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JER.7.18; Keita 1979, p. 115: Tonhöö; Lexique kissi–français, p. 57: toŋɔɔ/ toŋ, tuŋ, toaŋ (tuaŋ); Childs 2000, p. 365: tòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>toŋ dɛɔ « faire des galettes » (GEN 18,6). Lexique kissi–français, p. 57 : radicaux toŋ, tuŋ, toaŋ (tuaŋ) ; voir aussi toaŋaa.</text></form></note>
  </entry>
  <entry id="toɲaa_4139">
    <lexical-unit><form lang="kqs"><text>toɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="toɲaa_4139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vérité ; justice</text></gloss>
      <gloss lang="en"><text>truth; justice</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>truth; kindness, goodness, a favour</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 321 occurrences, first GEN.18.21; Keita 1979, p. 148: Tonyaa; Lexique kissi–français, p. 57: toɲaa; Childs 2000, p. 366: tòɲáá</text></form></note>
  </entry>
  <entry id="tù_4140">
    <lexical-unit><form lang="kqs"><text>tù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tù_4140_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout, entièrement</text></gloss>
      <gloss lang="en"><text>all, entirely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 370: tù</text></form></note>
  </entry>
  <entry id="tu-tu_4141">
    <lexical-unit><form lang="kqs"><text>tu-tu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tu-tu_4141_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très chaud</text></gloss>
      <gloss lang="en"><text>very hot</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tu-tu</text></form></note>
  </entry>
  <entry id="tuaŋ_4142">
    <lexical-unit><form lang="kqs"><text>tuaŋ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tuaŋ_4142_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frire, faire frire</text></gloss>
      <gloss lang="en"><text>fry</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tuaŋ</text></form></note>
    <note><form lang="fr"><text>Le Lexique ne donne que le radical.</text></form></note>
  </entry>
  <entry id="tubabunɔɔ_4143">
    <lexical-unit><form lang="kqs"><text>tubabunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tubabunɔɔ_4143_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étranger, Blanc</text></gloss>
      <gloss lang="en"><text>foreigner, white person</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tubabunɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique traduit « un étranger » ; tubabu « Blanc, Européen » est un emprunt au mandingue.</text></form></note>
  </entry>
  <entry id="tubabuɛi_4144">
    <lexical-unit><form lang="kqs"><text>tubabuɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="tubabuɛi_4144_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue des Blancs (français, anglais)</text></gloss>
      <gloss lang="en"><text>language of white people (French, English)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tubabuɛi</text></form></note>
  </entry>
  <entry id="túdú_4145">
    <lexical-unit><form lang="kqs"><text>túdú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="túdú_4145_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(court, petit)</text></gloss>
      <gloss lang="en"><text>(short, small)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 370: túdú</text></form></note>
  </entry>
  <entry id="tue_4146">
    <lexical-unit><form lang="kqs"><text>tue</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tue_4146_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>goutte ; (tue-tue) goutte à goutte</text></gloss>
      <gloss lang="en"><text>drop; (tue-tue) drop by drop</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) sound of water falling a drop at a time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first SNG.5.5; Childs 2000, p. 370: túé-túé</text></form></note>
    <note><form lang="fr"><text>tue bɛɛ piɔɔ del a sialten te « pas une goutte de pluie n'est tombée » (JER.3.3) ; mó va delio tue-tue « (la myrrhe) coulait goutte à goutte » (SNG.5.5). Childs a aussi túé « une goutte » (idéophone).</text></form></note>
  </entry>
  <entry id="tueiyo_4147">
    <lexical-unit><form lang="kqs"><text>tueiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tueiyo_4147_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver, rincer (l'intérieur des récipients) ; laver la vaisselle</text></gloss>
      <gloss lang="en"><text>wash, rinse (the inside of vessels); wash the dishes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.23.25; Lexique kissi–français, p. 58: tueiyo/ tuei; Childs 2000, p. 370: tùèìyó</text></form></note>
    <note><form lang="fr"><text>la co taala kólaa a hɛngɛiyo tueiyo o kɔɔ « vous lavez l'extérieur de la coupe et du plat » (MAT.23.25 ; aussi MRK.7.4). Lexique kissi–français, p. 58 : « laver la vaisselle ».</text></form></note>
  </entry>
  <entry id="tùèndɔ̀ɔ́_4148">
    <lexical-unit><form lang="kqs"><text>tùèndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùèndɔ̀ɔ́_4148_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>instrument de musique (espèce)</text></gloss>
      <gloss lang="en"><text>a musical instrument</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 371: tùèndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tueyɔɔ_4149">
    <lexical-unit><form lang="kqs"><text>tueyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuei</text></form></variant>
    <variant><form lang="kqs"><text>tuɛi</text></form></variant>
    <variant><form lang="kqs"><text>tui</text></form></variant>
    <variant><form lang="kqs"><text>tuɛinin</text></form></variant>
    <sense id="tueyɔɔ_4149_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entendre, écouter ; apprendre (une nouvelle) ; comprendre</text></gloss>
      <gloss lang="en"><text>hear, listen; learn (news); understand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: understand; sense, perceive, smell</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 265 occurrences, first GEN.3.10; Lexique kissi–français, p. 58: tueiyɔɔ/ tuei; Childs 2000, p. 370: tùèìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tui au négatif : la tui ya diom te « vous ne m'avez pas écouté » (Gn 42,22). Lexique kissi–français, p. 58 : tueiyɔɔ « entendre, comprendre » ; tueinan dom, tueianndo dom « se comprendre (l'un l'autre) ».</text></form></note>
  </entry>
  <entry id="tufuo_4150">
    <lexical-unit><form lang="kqs"><text>tufuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tufuu</text></form></variant>
    <sense id="tufuo_4150_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cracher plusieurs fois</text></gloss>
      <gloss lang="en"><text>spit repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tufuo/ tufuu</text></form></note>
    <note><form lang="fr"><text>Itératif de tufɔɔ « cracher ».</text></form></note>
  </entry>
  <entry id="tufɔɔ_4151">
    <lexical-unit><form lang="kqs"><text>tufɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tufu</text></form></variant>
    <sense id="tufɔɔ_4151_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cracher</text></gloss>
      <gloss lang="en"><text>spit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.17.6; Lexique kissi–français, p. 58: tufɔɔ/ tufu; Childs 2000, p. 371: tùfɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tufu lɔluan « cracher (de la salive) ». Lexique kissi–français, p. 58 : tufɔɔ « cracher une fois », opposé à tufuo/ tufuu « cracher plusieurs fois ».</text></form></note>
  </entry>
  <entry id="túfɛ́-túfɛ́_4152">
    <lexical-unit><form lang="kqs"><text>túfɛ́-túfɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="túfɛ́-túfɛ́_4152_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(goût sucré)</text></gloss>
      <gloss lang="en"><text>(sweet-tasting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 371: túfɛ́-túfɛ́</text></form></note>
  </entry>
  <entry id="tuilian_4153">
    <lexical-unit><form lang="kqs"><text>tuilian</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tuilima</text></form></variant>
    <sense id="tuilian_4153_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>urine</text></gloss>
      <gloss lang="en"><text>urine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.7 Urinate, urine"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Tuilian; Lexique kissi–français, p. 58: tuilian; Childs 2000, p. 371: tùìlíáŋ</text></form></note>
    <note><form lang="fr"><text>Forme radicale tuilima attestée (2R 18,27 ; Is 36,12).</text></form></note>
  </entry>
  <entry id="tuinɔnndo_4154">
    <lexical-unit><form lang="kqs"><text>tuinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuinun</text></form></variant>
    <sense id="tuinɔnndo_4154_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire grâce, avoir pitié (tuinun … iɲíí)</text></gloss>
      <gloss lang="en"><text>show favour, have mercy (tuinun … iɲíí)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.33.19</text></form></note>
  </entry>
  <entry id="tuisinndo_4155">
    <lexical-unit><form lang="kqs"><text>tuisinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuisin</text></form></variant>
    <sense id="tuisinndo_4155_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'humilier, se soumettre ; descendre, être abaissé</text></gloss>
      <gloss lang="en"><text>humble oneself, submit; go down, be lowered</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.10.3; Lexique kissi–français, p. 58: tuisinndo/ tuisin</text></form></note>
    <note><form lang="fr"><text>Moyen de tuisio. Lexique kissi–français, p. 58 : « se descendre, être descendu, se soumettre » ; tuisinndo toto « l'humilité, s'humilier ».</text></form></note>
  </entry>
  <entry id="tuisio_4156">
    <lexical-unit><form lang="kqs"><text>tuisio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuisi</text></form></variant>
    <variant><form lang="kqs"><text>tuisinin</text></form></variant>
    <sense id="tuisio_4156_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire descendre, envoyer (pluie, malheur) sur ; abaisser</text></gloss>
      <gloss lang="en"><text>bring down, send (rain, calamity) upon; humble</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.17.13; Lexique kissi–français, p. 58: tuisio/ tuisi</text></form></note>
  </entry>
  <entry id="tuituiyaa_4157">
    <lexical-unit><form lang="kqs"><text>tuituiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuituiyaa_4157_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>plié, roulé (à plusieurs plis) ; plier plusieurs fois</text></gloss>
      <gloss lang="en"><text>folded, rolled up; fold several times</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold together, roll up (plural of tùwɔ̀ɔ́ 'fold')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JHN.20.7; Lexique kissi–français, p. 58: tuituiyo/ tuitui; Childs 2000, p. 372: tùìtùìyó</text></form></note>
    <note><form lang="fr"><text>o va o tuituiyaa « (le linge) était plié » (JHN.20.7). Lexique kissi–français, p. 58 : tuituiyo/ tuitui « plier plusieurs fois ».</text></form></note>
  </entry>
  <entry id="tuiŋio_4158">
    <lexical-unit><form lang="kqs"><text>tuiŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuiŋi</text></form></variant>
    <sense id="tuiŋio_4158_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retirer, arracher du feu</text></gloss>
      <gloss lang="en"><text>take out of the fire, snatch from the fire</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.47.14; Childs 2000, p. 371: tùìŋìó</text></form></note>
    <note><form lang="fr"><text>La tuiŋi nda o yin « arrachez-les du feu » (JUD.1.23) ; yoomu ndaa tuiŋio o yinnden nin « sauver leur vie des flammes » (ISA.47.14).</text></form></note>
  </entry>
  <entry id="tùkpàá_4159">
    <lexical-unit><form lang="kqs"><text>tùkpàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tùkpàláŋ</text></form></field>
    <sense id="tùkpàá_4159_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canon, mortier ; coup de fusil de fête (veillées)</text></gloss>
      <gloss lang="en"><text>cannon, mortar; celebratory gunshot (at wakes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 372: tùkpàá</text></form></note>
  </entry>
  <entry id="tullo_4160">
    <lexical-unit><form lang="kqs"><text>tullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tullo_4160_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sommet</text></gloss>
      <gloss lang="en"><text>top, summit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first EXO.24.17</text></form></note>
    <note><form lang="fr"><text>pembei tullo « le sommet de la montagne ».</text></form></note>
  </entry>
  <entry id="tuluo_4161">
    <lexical-unit><form lang="kqs"><text>tuluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tulu</text></form></variant>
    <sense id="tuluo_4161_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre la pareille, réciproquer</text></gloss>
      <gloss lang="en"><text>reciprocate, pay back in kind</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tuluo/ tulu</text></form></note>
  </entry>
  <entry id="tum yekpandio_4162">
    <lexical-unit><form lang="kqs"><text>tum yekpandio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tum yekpandio_4162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crosse de fusil</text></gloss>
      <gloss lang="en"><text>rifle butt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Tum yekpandio; Lexique kissi–français, p. 58: tum yekpandio</text></form></note>
  </entry>
  <entry id="tuma_4163">
    <lexical-unit><form lang="kqs"><text>tuma</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuma_4163_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>au moment où, quand</text></gloss>
      <gloss lang="en"><text>when, at the time when</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 394 occurrences, first GEN.2.4</text></form></note>
  </entry>
  <entry id="tuma-tuma_4164">
    <lexical-unit><form lang="kqs"><text>tuma-tuma</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuma-tuma_4164_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>toujours</text></gloss>
      <gloss lang="en"><text>always</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.25.32; Lexique kissi–français, p. 58: tuma-tuma</text></form></note>
  </entry>
  <entry id="tumaa_4165">
    <lexical-unit><form lang="kqs"><text>tumaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tumaa_4165_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moment, temps ; quand</text></gloss>
      <gloss lang="en"><text>time, moment; when</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.31.1; Lexique kissi–français, p. 58: tumaa</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, en tête de phrase : Tumaa pum « après cela, alors » (GEN.31.1).</text></form></note>
  </entry>
  <entry id="tumayongoyonguo_4166">
    <lexical-unit><form lang="kqs"><text>tumayongoyonguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tumayongoyonguo_4166_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau huppé</text></gloss>
      <gloss lang="en"><text>crested bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tumayongoyonguo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « un oiseau avec un kpue sur la tête ».</text></form></note>
  </entry>
  <entry id="tùmbáfùíyó_4167">
    <lexical-unit><form lang="kqs"><text>tùmbáfùíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùmbáfùíyó_4167_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>baignoire, bassine de bain</text></gloss>
      <gloss lang="en"><text>bathtub</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 372: tùmbáfùíyó</text></form></note>
  </entry>
  <entry id="tumbé_4168">
    <lexical-unit><form lang="kqs"><text>tumbé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tumbé_4168_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colère, fureur</text></gloss>
      <gloss lang="en"><text>wrath, fury</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first DEU.29.27; Lexique kissi–français, p. 58: tunbeo; Childs 2000, p. 372: túmbóó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 58) écrit tunbeo « la colère ».</text></form></note>
  </entry>
  <entry id="tumbu_4169">
    <lexical-unit><form lang="kqs"><text>tumbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tumbulan</text></form></field>
    <variant><form lang="kqs"><text>tumbula</text></form></variant>
    <variant><form lang="kqs"><text>tumboo</text></form></variant>
    <sense id="tumbu_4169_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gerbe</text></gloss>
      <gloss lang="en"><text>sheaf</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large sheaf of rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.37.7; Lexique kissi–français, p. 58: tunbuo; Childs 2000, p. 372: tùmbóó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 58) écrit tunbuo ; la Bible a le singulier tumboo (DEU.24.19).</text></form></note>
  </entry>
  <entry id="túmbúlnɔ̀ɔ́_4170">
    <lexical-unit><form lang="kqs"><text>túmbúlnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túmbúllá</text></form></field>
    <sense id="túmbúlnɔ̀ɔ́_4170_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purificateur, exorciste (après la violation d'un tabou)</text></gloss>
      <gloss lang="en"><text>exorcist, ritual cleanser (after a taboo is broken)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 373: túmbúlnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tumndo_4171">
    <lexical-unit><form lang="kqs"><text>tumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tumnda</text></form></field>
    <sense id="tumndo_4171_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>base, pied, socle ; cep, souche (de vigne) ; (pl.) vignes ; tronc (d'arbre) ; derrière, fesses</text></gloss>
      <gloss lang="en"><text>base, foot, socket; stock (of a vine); (pl.) vineyards; trunk (of a tree); buttocks</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bottom, base, background; buttocks, anus; palm nut head</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.32.33; Lexique kissi–français, p. 58: tumndo; Childs 2000, p. 373: tùmndó</text></form></note>
    <note><form lang="fr"><text>rɛsɛn tumndo « cep de vigne » (GEN.40.9) ; tumnda n'rɛsɛnndan « les vignes » (JDG.21.21) ; tumnda fondo « nu » (GEN.2.25). Lexique kissi–français, p. 58 : « le tronc d'un arbre, le derrière, les fesses ».</text></form></note>
  </entry>
  <entry id="tumulu_4172">
    <lexical-unit><form lang="kqs"><text>tumulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tumulnin</text></form></variant>
    <sense id="tumulu_4172_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pourrir, se corrompre, puer</text></gloss>
      <gloss lang="en"><text>rot, putrefy, become foul</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.38.6; Childs 2000, p. 373: tùmùlló</text></form></note>
    <note><form lang="fr"><text>Pavii nii tumulu « mes plaies pourrissent » (PSA.38.6) ; peela pɔmbɔlan la tumulnin « les canaux deviendront infects » (ISA.19.6).</text></form></note>
  </entry>
  <entry id="tumulɛi_4173">
    <lexical-unit><form lang="kqs"><text>tumulɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tumulɛiyon</text></form></variant>
    <variant><form lang="kqs"><text>tumulɛin</text></form></variant>
    <sense id="tumulɛi_4173_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pourri, corrompu, impur</text></gloss>
      <gloss lang="en"><text>rotten, putrid, unclean</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.7.19; Childs 2000, p. 373: tùmúléí</text></form></note>
    <note><form lang="fr"><text>De tumulu. visin tumulɛiyon « viande avariée » (LEV.19.7) ; maa ɲɛ tumulɛi « comme une chose impure » (EZK.7.19).</text></form></note>
  </entry>
  <entry id="tun_4174">
    <lexical-unit><form lang="kqs"><text>tun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tun_4174_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>seulement ; encore</text></gloss>
      <gloss lang="en"><text>only; still, again</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.49.27; Lexique kissi–français, p. 58: tun</text></form></note>
    <note><form lang="fr"><text>Yéè ya tun vílɛ́iyo ho « je ne suis qu'un chien mort » (2SA.9.8).</text></form></note>
  </entry>
  <entry id="tuncua_4175">
    <lexical-unit><form lang="kqs"><text>tuncua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tuncua_4175_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chiot</text></gloss>
      <gloss lang="en"><text>puppy</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tuntyua; Lexique kissi–français, p. 58: tuncua</text></form></note>
  </entry>
  <entry id="tùndòó_4176">
    <lexical-unit><form lang="kqs"><text>tùndòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùndòó_4176_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâton recourbé (piège à animaux ; support des coupe-palmes)</text></gloss>
      <gloss lang="en"><text>bent stick (animal trap; holder for palm cutters)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 373: tùndòó</text></form></note>
  </entry>
  <entry id="tundu_4177">
    <lexical-unit><form lang="kqs"><text>tundu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tundu_4177_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>incliner, baisser (le visage vers le sol)</text></gloss>
      <gloss lang="en"><text>bow (the face to the ground)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.17.3</text></form></note>
  </entry>
  <entry id="tundun_4178">
    <lexical-unit><form lang="kqs"><text>tundun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tundun_4178_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se prosterner</text></gloss>
      <gloss lang="en"><text>bow down, prostrate oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.27.29</text></form></note>
  </entry>
  <entry id="tunduo_4179">
    <lexical-unit><form lang="kqs"><text>tunduo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tunduo_4179_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bois du piège</text></gloss>
      <gloss lang="en"><text>trap stick</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tunduo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « le bois qui sert à faire le piège ».</text></form></note>
  </entry>
  <entry id="tundɔɔ_4180">
    <lexical-unit><form lang="kqs"><text>tundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tundan</text></form></variant>
    <sense id="tundɔɔ_4180_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>courber, tordre ; pervertir (la justice, les paroles) ; accabler, opprimer ; plier</text></gloss>
      <gloss lang="en"><text>bend, twist; pervert (justice, words); oppress; fold</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend or curve</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.1.11; Lexique kissi–français, p. 58: tundɔɔ/ tundu; Childs 2000, p. 373: tùndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>le nda tundɔɔ o baala « pour les accabler de travaux » (EXO.1.11) ; dɛnɛ sandaa tundɔɔ « pervertir la justice » (JOB.8.3) ; vanaa co a tundan-nda « ceux qui sont courbés » (PSA.145.14). Aussi « délibérer » (MAT.27.7, ACT.25.12). Cf. tundu « se prosterner ». Lexique kissi–français, p. 58 : « courber, plier ».</text></form></note>
  </entry>
  <entry id="tunguo_4181">
    <lexical-unit><form lang="kqs"><text>tunguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tunguo_4181_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nain</text></gloss>
      <gloss lang="en"><text>dwarf</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tunguo</text></form></note>
  </entry>
  <entry id="tunndo_4182">
    <lexical-unit><form lang="kqs"><text>tunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tunnda</text></form></field>
    <sense id="tunndo_4182_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chien</text></gloss>
      <gloss lang="en"><text>dog</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.11.7; Keita 1979, p. 137: Tunndo; Lexique kissi–français, p. 59: tunndo; Childs 2000, p. 374: tùŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible a aussi le pluriel tunaa.</text></form></note>
  </entry>
  <entry id="tunɔnndo_4183">
    <lexical-unit><form lang="kqs"><text>tunɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tunun</text></form></variant>
    <sense id="tunɔnndo_4183_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se plier</text></gloss>
      <gloss lang="en"><text>fold, be folded</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tunɔnndo/ tunun</text></form></note>
    <note><form lang="fr"><text>Moyen de tuɔ « plier ».</text></form></note>
  </entry>
  <entry id="tùsìó_4184">
    <lexical-unit><form lang="kqs"><text>tùsìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tùsìó_4184_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être sale</text></gloss>
      <gloss lang="en"><text>be dirty</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: tùsìó</text></form></note>
  </entry>
  <entry id="tuukuo_4185">
    <lexical-unit><form lang="kqs"><text>tuukuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tuuku</text></form></variant>
    <sense id="tuukuo_4185_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>voir, percevoir</text></gloss>
      <gloss lang="en"><text>see, perceive</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tuukuo/ tuuku</text></form></note>
  </entry>
  <entry id="tuulaa_4186">
    <lexical-unit><form lang="kqs"><text>tuulaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuula</text></form></variant>
    <sense id="tuulaa_4186_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dessiner ; représenter, sculpter (une image)</text></gloss>
      <gloss lang="en"><text>draw; make an image, carve</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JDG.17.4; Lexique kissi–français, p. 59: tuulaa</text></form></note>
    <note><form lang="fr"><text>La tuula ɲɛ-ɲɛ « ne fais aucune image » (EXO.20.4). Le Lexique donne aussi tula « les dessins, les photos ; imiter » (p. 58) et le radical itératif tuulia « dessiner plusieurs fois » (p. 59).</text></form></note>
  </entry>
  <entry id="tùúlen_4187">
    <lexical-unit><form lang="kqs"><text>tùúlen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tùúlen_4187_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>un peu, petite quantité, juste ce qu'il faut</text></gloss>
      <gloss lang="en"><text>a little, a small amount, (just) enough</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being enough, sufficient</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.25.52; Lexique kissi–français, p. 59: tuulen; Childs 2000, p. 374: tùùléŋ</text></form></note>
    <note><form lang="fr"><text>O co fisa mì vana nɔ tùúlen « mieux vaut peu de bien » (PRO.15.16) ; a dio man tùúlen « manges-en avec mesure » (PRO.25.16).</text></form></note>
  </entry>
  <entry id="tuuliaa_4188">
    <lexical-unit><form lang="kqs"><text>tuuliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuliaa_4188_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sculpter, graver, broder (des figures)</text></gloss>
      <gloss lang="en"><text>carve, engrave, embroider (figures)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>imitate, gesticulate; make illustrations</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.26.1; Childs 2000, p. 375: tùùlìá</text></form></note>
  </entry>
  <entry id="tuuliaala_4189">
    <lexical-unit><form lang="kqs"><text>tuuliaala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuliaala_4189_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figures sculptées, images, idoles</text></gloss>
      <gloss lang="en"><text>carved figures, images, idols</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first DEU.4.23</text></form></note>
  </entry>
  <entry id="tuulianɔɔ_4190">
    <lexical-unit><form lang="kqs"><text>tuulianɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tuulianɔɔ_4190_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dessinateur</text></gloss>
      <gloss lang="en"><text>draughtsman</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Tuulianöö; Lexique kissi–français, p. 59: tuulianɔɔ</text></form></note>
  </entry>
  <entry id="tuuloo_4191">
    <lexical-unit><form lang="kqs"><text>tuuloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuulu</text></form></variant>
    <variant><form lang="kqs"><text>tuulunin</text></form></variant>
    <sense id="tuuloo_4191_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'échauffer, s'enflammer ; (tuulu kɔl) se mettre en colère ; chauffer, faire chauffer</text></gloss>
      <gloss lang="en"><text>heat up, flare up; (tuulu kɔl) become angry; heat, warm up</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be warm, become hot, heat; also beat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first 1SA.4.2; Lexique kissi–français, p. 59: tuuluo/ tuulu; Childs 2000, p. 375: tùùlòó</text></form></note>
    <note><form lang="fr"><text>Cɔwvo tuuloo « le combat s'échauffa » (1 S 4,2) ; va kɔllo tuuloo « attiser la colère » (Ne 13,18). Lexique kissi–français, p. 59 : « (faire) chauffer ».</text></form></note>
  </entry>
  <entry id="tuulul_4192">
    <lexical-unit><form lang="kqs"><text>tuulul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuululnin</text></form></variant>
    <sense id="tuulul_4192_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mesurer (pour qqn), mesurer à ; montrer (le modèle) à</text></gloss>
      <gloss lang="en"><text>measure out (to someone); show (a pattern) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>measure for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HEB.8.5; Childs 2000, p. 375: tùùlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tuuvo « mesurer ». A tuululnin niaa ɲɔɔn ɲɛkɛndɛi « on vous versera une bonne mesure » (LUK.6.38) ; mɛɛ ya tuulul nɔm ndu « selon le modèle que je t'ai montré » (HEB.8.5).</text></form></note>
  </entry>
  <entry id="tuunduanndo_4193">
    <lexical-unit><form lang="kqs"><text>tuunduanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuunduanndan</text></form></variant>
    <variant><form lang="kqs"><text>tuunduan</text></form></variant>
    <sense id="tuunduanndo_4193_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tortueux, courbe ; pervers (conduite)</text></gloss>
      <gloss lang="en"><text>crooked, winding; perverse (conduct)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend over, be bent (middle plural of 'bend')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.18.27; Childs 2000, p. 375: tùùndɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>nɛila tuunduan-ndan la sandunin « les chemins tortueux seront redressés » (LUK.3.5) ; kela tuunduanndo « conduite perverse » (PSA.18.27).</text></form></note>
  </entry>
  <entry id="tuunduuvo_4194">
    <lexical-unit><form lang="kqs"><text>tuunduuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuunduuvo_4194_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre tortueux, embrouiller (un chemin)</text></gloss>
      <gloss lang="en"><text>make crooked, confuse (a path)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend many things (plural of 'bend')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.3.12; Childs 2000, p. 375: tùùndùùwó</text></form></note>
    <note><form lang="fr"><text>nɛi niaa co kɔlan coo-o tuunduuvo « ils embrouillent le chemin que vous suivez » (ISA.3.12).</text></form></note>
  </entry>
  <entry id="tuunduɛiyo_4195">
    <lexical-unit><form lang="kqs"><text>tuunduɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuunduɛiyan</text></form></variant>
    <variant><form lang="kqs"><text>tuundɛilan</text></form></variant>
    <sense id="tuunduɛiyo_4195_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tortueux, détourné ; pervers, rusé</text></gloss>
      <gloss lang="en"><text>crooked, twisted; perverse, crafty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.10.9; Childs 2000, p. 375: túúndúéí-</text></form></note>
    <note><form lang="fr"><text>vana kela pɛ kela tuunduɛiyo « celui qui suit des voies tortueuses » (PRO.10.9) ; silala ndala tuundɛilan « les desseins des rusés » (JOB.5.13). De tundɔɔ « courber ».</text></form></note>
  </entry>
  <entry id="tuunɔnndo_4196">
    <lexical-unit><form lang="kqs"><text>tuunɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuunun</text></form></variant>
    <sense id="tuunɔnndo_4196_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se mesurer ; calculer, projeter (dans son cœur)</text></gloss>
      <gloss lang="en"><text>measure oneself; calculate, devise (in one's heart)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.73.7; Lexique kissi–français, p. 59: tuunɔnndo/ tuunun</text></form></note>
    <note><form lang="fr"><text>o co dɛnɛ vɔɔndo tuunɔnndo o kɔl « il trame le mal dans son cœur » (PRO.6.14). Moyen de tuwvo « mesurer » ; le Lexique donne aussi [t]uuo « plan » (p. 59).</text></form></note>
  </entry>
  <entry id="tùúpá_4197">
    <lexical-unit><form lang="kqs"><text>tùúpá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tùúpá_4197_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à ce que, avant que</text></gloss>
      <gloss lang="en"><text>until, before</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 375: tùúpá</text></form></note>
  </entry>
  <entry id="tuusu_4198">
    <lexical-unit><form lang="kqs"><text>tuusu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuusu_4198_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre ; s'étendre (frontière) ; aller vers le sud, aller en bas</text></gloss>
      <gloss lang="en"><text>go down; extend (border); go south, go down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first NUM.21.15; Lexique kissi–français, p. 59: tuusuo/ tuusu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 59 : tuusuo/ tuusu « aller au sud, en bas ».</text></form></note>
  </entry>
  <entry id="tuuvo_4199">
    <lexical-unit><form lang="kqs"><text>tuuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuvo_4199_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mesurer ; projeter</text></gloss>
      <gloss lang="en"><text>measure; plan</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plan (middle of tùùwó 'measure')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.25; Childs 2000, p. 375: tùùnɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="tùùwó_4200">
    <lexical-unit><form lang="kqs"><text>tùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùùwó_4200_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parties génitales de l'homme</text></gloss>
      <gloss lang="en"><text>male genitals</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 376: tùùwó</text></form></note>
  </entry>
  <entry id="tuuŋanndan_4201">
    <lexical-unit><form lang="kqs"><text>tuuŋanndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuuŋanndan_4201_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se comparer (les uns aux autres)</text></gloss>
      <gloss lang="en"><text>compare oneselves with one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>compare, make comparisons</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CO.10.12; Childs 2000, p. 375: tùùŋǎŋndó</text></form></note>
    <note><form lang="fr"><text>nda pilaa tɛɛn nda co tuuŋanndan ni « ils se comparent entre eux » (2CO.10.12). Moyen pluriel de tuuvo « mesurer ».</text></form></note>
  </entry>
  <entry id="tuvaa_4202">
    <lexical-unit><form lang="kqs"><text>tuvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tuvaala</text></form></field>
    <variant><form lang="kqs"><text>tuvaalen</text></form></variant>
    <sense id="tuvaa_4202_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure, unité de mesure ; (pl.) poids et mesures ; (yoole tuvaalen) cordeau</text></gloss>
      <gloss lang="en"><text>measure, measuring unit; (pl.) weights and measures; (yoole tuvaalen) measuring line</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) measure, take the size of; decide</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.16.36; Childs 2000, p. 376: tùùwó</text></form></note>
    <note><form lang="fr"><text>De tuuvo « mesurer ». ɲɛla tuvaala « poids, mesures » (LEV.19.36) ; yoole tuvaalen « cordeau à mesurer » (ZEC.2.5).</text></form></note>
  </entry>
  <entry id="tuvɔɔ_4203">
    <lexical-unit><form lang="kqs"><text>tuvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuvɔɔ_4203_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>replier, retirer (le bras)</text></gloss>
      <gloss lang="en"><text>draw back, fold back (the arm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold, fold around, wrap; bury; embrace; sprain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOS.8.26; Childs 2000, p. 376: tùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Toujours négatif : ba ndóò bii kon bállo-o tuvɔɔ le « il ne retira pas la main qui tenait le javelot » (JOS.8.26 ; aussi 1KI.13.4). Rapprochement avec Childs à confirmer.</text></form></note>
  </entry>
  <entry id="tuwvo_4204">
    <lexical-unit><form lang="kqs"><text>tuwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuwve</text></form></variant>
    <variant><form lang="kqs"><text>tuwvon</text></form></variant>
    <sense id="tuwvo_4204_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>chaud, brûlant ; (kɔl tuwvo) colère</text></gloss>
      <gloss lang="en"><text>hot, burning; (kɔl tuwvo) anger, wrath</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first GEN.49.6; Lexique kissi–français, p. 59: tuuo; Childs 2000, p. 374: tùù</text></form></note>
    <note><form lang="fr"><text>hoeyii tuwve « vent brûlant » (Jr 4,11) ; dialun tuwvon « fièvre » (Mt 8,14). Le Lexique kissi–français (p. 59) écrit tuuo et tuuluo « chaud » ; il y donne tuwvo/ tuw au sens de « mesurer, proposer ».</text></form></note>
  </entry>
  <entry id="tuwvo_4205">
    <lexical-unit><form lang="kqs"><text>tuwvo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>tuw</text></form></variant>
    <sense id="tuwvo_4205_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mesurer ; proposer</text></gloss>
      <gloss lang="en"><text>measure; propose</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tuwvo</text></form></note>
    <note><form lang="fr"><text>Homographe de l'adjectif tuwvo « chaud ». Le sens « mesurer » n'est pas confirmé dans la Bible, qui a toutefois le moyen tuunun « calculer » (LEV.25.50).</text></form></note>
  </entry>
  <entry id="tuŋ_4206">
    <lexical-unit><form lang="kqs"><text>tuŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuŋ-tuŋ</text></form></variant>
    <sense id="tuŋ_4206_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>toujours, continuellement</text></gloss>
      <gloss lang="en"><text>always, continually</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>only, just</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 228 occurrences, first GEN.6.5; Childs 2000, p. 373: túŋ</text></form></note>
    <note><form lang="fr"><text>tuŋ-tuŋ « de plus en plus, sans cesse » (Ex 19,19).</text></form></note>
  </entry>
  <entry id="tuŋndo_4207">
    <lexical-unit><form lang="kqs"><text>tuŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuŋndo_4207_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frire, cuire (des gâteaux) pour (qqn)</text></gloss>
      <gloss lang="en"><text>fry, bake (cakes) for (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry for someone (benefactive of tòŋɔ̀ɔ́ 'fry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.44.19; Childs 2000, p. 374: tùŋndó</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de toŋɔɔ « frire » (JER.7.18) : tuuliaala ndɔlan-ndo tuŋndo a ndu « lui cuire des gâteaux à son image » (JER.44.19).</text></form></note>
  </entry>
  <entry id="túŋòó_4208">
    <lexical-unit><form lang="kqs"><text>túŋòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túŋòá</text></form></field>
    <sense id="túŋòó_4208_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nain</text></gloss>
      <gloss lang="en"><text>midget, dwarf</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: túŋòó</text></form></note>
  </entry>
  <entry id="túŋótúŋóó_4209">
    <lexical-unit><form lang="kqs"><text>túŋótúŋóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>túŋótúŋúá</text></form></field>
    <sense id="túŋótúŋóó_4209_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grosse sauterelle</text></gloss>
      <gloss lang="en"><text>large grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 374: túŋótúŋóó</text></form></note>
  </entry>
  <entry id="tuŋɔɔ_4210">
    <lexical-unit><form lang="kqs"><text>tuŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuŋɔɔ_4210_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>priver de, refuser (à qqn)</text></gloss>
      <gloss lang="en"><text>deprive of, withhold (from someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be greedy; deprive someone of something by keeping it for oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first NUM.11.11; Childs 2000, p. 374: tùŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>va vana yiaan ɲɛdiaa tuŋɔɔ « refuser du pain à l'affamé » (Jb 22,7).</text></form></note>
  </entry>
  <entry id="tuɔ_4211">
    <lexical-unit><form lang="kqs"><text>tuɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tu</text></form></variant>
    <sense id="tuɔ_4211_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>plier</text></gloss>
      <gloss lang="en"><text>fold</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: tuɔ/ tu</text></form></note>
    <note><form lang="fr"><text>Cf. tuituiyaa « plier plusieurs fois » (JHN.20.7) et tunɔnndo « se plier ».</text></form></note>
  </entry>
  <entry id="tuɛi_4212">
    <lexical-unit><form lang="kqs"><text>tuɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuɛi_4212_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rôtir, griller (la viande)</text></gloss>
      <gloss lang="en"><text>roast (meat)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 250 occurrences, first GEN.9.24; Lexique kissi–français, p. 58: tuɛiyɔɔ/ tuɛi; Childs 2000, p. 370: tùèìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Homographe de tuɛi « entendre » (tueyɔɔ). A bɛnda mà tuɛi visin mun « vous rôtirez la viande » (EXO.12.8) ; o tuɛi vision « il rôtit la viande » (ISA.44.16). Le Lexique kissi–français (p. 58) donne la forme longue tuɛiyɔɔ.</text></form></note>
  </entry>
  <entry id="tuɛi naa_4213">
    <lexical-unit><form lang="kqs"><text>tuɛi naa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tuɛi naa_4213_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fâché</text></gloss>
      <gloss lang="en"><text>be angry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tuei naa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit tuei naa (p. 58) et le radical tuɛi na. Dans la Bible, tuei naa signifie « entendre que » (ISA.39.1) ; tuɛi naa (DEU.29.6) n'y a pas ce sens. Forme et sens à vérifier.</text></form></note>
  </entry>
  <entry id="tuɛndɔɔ_4214">
    <lexical-unit><form lang="kqs"><text>tuɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuɛndɔɔ_4214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>burin, ciseau (à graver)</text></gloss>
      <gloss lang="en"><text>chisel, engraving tool</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a blacksmith's chisel for cutting iron</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.20.25; Lexique kissi–français, p. 55: tɛndɔɔ; Childs 2000, p. 371: túéndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>tuɛndɔɔ a á ciliŋii « burin de fer » (JOB.19.24) ; aussi « outil » de taille (EXO.20.25). Lexique kissi–français, p. 55 : tɛndɔɔ « le ciseau ». Aussi Lexique kissi–français, p. 58 : « tuɛndɔɔ ».</text></form></note>
  </entry>
  <entry id="tɔ́_4215">
    <lexical-unit><form lang="kqs"><text>tɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔ́_4215_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>dix</text></gloss>
      <gloss lang="en"><text>ten</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 694 occurrences, first GEN.5.8; Lexique kissi–français, p. 57: tɔ; Childs 2000, p. 368: tɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 57 : tɔ a hiɔɔlu « quatorze », tɔ a ŋuɛɛnu « quinze » (tɔ́ a ŋuɛɛnu, LEV.27.7).</text></form></note>
  </entry>
  <entry id="tɔ̀a_4216">
    <lexical-unit><form lang="kqs"><text>tɔ̀a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔ̀a_4216_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>les autres</text></gloss>
      <gloss lang="en"><text>the others</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 373 occurrences, first GEN.4.15; Lexique kissi–français, p. 57: tɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 57 : tɔ « le dernier, le reste » (rattachement à tɔ̀a à vérifier).</text></form></note>
  </entry>
  <entry id="tɔkpɔɔ_4217">
    <lexical-unit><form lang="kqs"><text>tɔkpɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔkpɔɔ_4217_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>babouin sans queue ; clan dont le tabou est le babouin ; chimpanzé</text></gloss>
      <gloss lang="en"><text>tailless baboon; clan whose taboo is the baboon; chimpanzee</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tɔkpɔɔ; Childs 2000, p. 368: tɔ́kpɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 57 (« le chimpanzé »). Pluriel en kissi du Sud (Childs 2000) : tɔ́kpùá.</text></form></note>
  </entry>
  <entry id="tɔ̀làá_4218">
    <lexical-unit><form lang="kqs"><text>tɔ̀làá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀làá_4218_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saigner un palmier, récolter le vin de palme</text></gloss>
      <gloss lang="en"><text>tap a palm tree for palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ̀làá</text></form></note>
  </entry>
  <entry id="tɔ̀lnɔ̀ɔ́_4219">
    <lexical-unit><form lang="kqs"><text>tɔ̀lnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tɔ̀llá</text></form></field>
    <sense id="tɔ̀lnɔ̀ɔ́_4219_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre d'un clan, d'un lignage</text></gloss>
      <gloss lang="en"><text>member of a clan or lineage</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ̀lnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɔ̀lóó_4220">
    <lexical-unit><form lang="kqs"><text>tɔ̀lóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀lóó_4220_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parties intimes, région génitale</text></gloss>
      <gloss lang="en"><text>private parts, genital area</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ̀lóó</text></form></note>
  </entry>
  <entry id="tɔ́lɔ́lɔ́_4221">
    <lexical-unit><form lang="kqs"><text>tɔ́lɔ́lɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ́lɔ́lɔ́_4221_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(bien lisse, comme un pelage)</text></gloss>
      <gloss lang="en"><text>(smooth, like an animal's hair)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ́lɔ́lɔ́</text></form></note>
  </entry>
  <entry id="tɔlɔɔ_4222">
    <lexical-unit><form lang="kqs"><text>tɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔlɔɔlan</text></form></field>
    <sense id="tɔlɔɔ_4222_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante</text></gloss>
      <gloss lang="en"><text>plant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first EXO.10.5; Keita 1979, p. 140: Tölöö; Lexique kissi–français, p. 57: tɔlɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 57 : pluriel tɔlɔlan « les plantes ».</text></form></note>
  </entry>
  <entry id="tɔlɔɔ_4223">
    <lexical-unit><form lang="kqs"><text>tɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔl</text></form></variant>
    <variant><form lang="kqs"><text>tɔal</text></form></variant>
    <variant><form lang="kqs"><text>tɔalnin</text></form></variant>
    <sense id="tɔlɔɔ_4223_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>planter ; plante, arbre</text></gloss>
      <gloss lang="en"><text>plant; plant, tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first EXO.10.5; Keita 1979, p. 115: Tölöö; Lexique kissi–français, p. 57: tɔlɔɔ/ tɔl, tol, tɔal</text></form></note>
    <note><form lang="fr"><text>tɔlɔɔ est aussi le nom « arbre, plante » (EXO 10,5). Lexique kissi–français, p. 57 : radicaux tɔl, tol, tɔal.</text></form></note>
  </entry>
  <entry id="tɔmenɔɔ_4224">
    <lexical-unit><form lang="kqs"><text>tɔmenɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔmenɔɔ_4224_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Toma (personne)</text></gloss>
      <gloss lang="en"><text>Toma (person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tɔmenɔɔ</text></form></note>
  </entry>
  <entry id="tɔmndo_4225">
    <lexical-unit><form lang="kqs"><text>tɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tɔmnda</text></form></field>
    <sense id="tɔmndo_4225_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>singe</text></gloss>
      <gloss lang="en"><text>monkey</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tömndo; Lexique kissi–français, p. 57: tɔmndo; Childs 2000, p. 369: tɔ̌mndó</text></form></note>
    <note><form lang="fr"><text>Le pluriel tɔmnda est dans la Bible (1KI.10.22).</text></form></note>
  </entry>
  <entry id="tɔmɔɔ_4226">
    <lexical-unit><form lang="kqs"><text>tɔmɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔmɔɔ_4226_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>filer (le coton) ; couper (le bois) ; mouler (les briques)</text></gloss>
      <gloss lang="en"><text>spin (cotton); cut (wood); mould (bricks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tɔmɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique ajoute « amuser un jeune garçon avec une jeune fille » ; sens à vérifier.</text></form></note>
  </entry>
  <entry id="tɔndaa_4227">
    <lexical-unit><form lang="kqs"><text>tɔndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔnda</text></form></variant>
    <sense id="tɔndaa_4227_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tisser, ourdir (le fil)</text></gloss>
      <gloss lang="en"><text>weave, warp (thread)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make the warp thread for weaving, wrap spools; also defame someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1CH.11.23; Childs 2000, p. 369: tɔ̀ndàá</text></form></note>
    <note><form lang="fr"><text>kola nda tɔnda « l'étoffe qu'ils tissèrent » (EXO.39.22) ; vanaa co funnden tɔndaa « ceux qui travaillent le lin » (ISA.19.9) ; kola-yɔɔsɔɔ o ndu tɔndaa « ensouple de tisserand » (1CH.11.23).</text></form></note>
  </entry>
  <entry id="tɔndikɔɔliei_4228">
    <lexical-unit><form lang="kqs"><text>tɔndikɔɔliei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tɔndikɔɔlion</text></form></field>
    <sense id="tɔndikɔɔliei_4228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tendon (du jarret)</text></gloss>
      <gloss lang="en"><text>tendon, hamstring</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Töndikööliei; Lexique kissi–français, p. 57: tɔndikɔɔliei</text></form></note>
    <note><form lang="fr"><text>Pluriel tɔndikɔɔlion attesté (Jos 11,6 : couper les jarrets des chevaux).</text></form></note>
  </entry>
  <entry id="tɔ́ndɔɔ_4229">
    <lexical-unit><form lang="kqs"><text>tɔ́ndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔ́ndɔɔ_4229_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>dixième ; dîme</text></gloss>
      <gloss lang="en"><text>tenth; tithe</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.28.22; Lexique kissi–français, p. 57: tɔndɔɔ</text></form></note>
  </entry>
  <entry id="tɔnganndo_4230">
    <lexical-unit><form lang="kqs"><text>tɔnganndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔngannda</text></form></field>
    <sense id="tɔnganndo_4230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chauve-souris</text></gloss>
      <gloss lang="en"><text>bat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.11.19; Lexique kissi–français, p. 57: tɔngando</text></form></note>
  </entry>
  <entry id="tɔngɔlɔɔ_4231">
    <lexical-unit><form lang="kqs"><text>tɔngɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔngɔlɔɔ_4231_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tornade</text></gloss>
      <gloss lang="en"><text>tornado, storm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 57: tɔngɔlɔɔ</text></form></note>
  </entry>
  <entry id="tɔnndunndo_4232">
    <lexical-unit><form lang="kqs"><text>tɔnndunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔnndunndo_4232_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour</text></gloss>
      <gloss lang="en"><text>drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tɔnndunndo</text></form></note>
  </entry>
  <entry id="tɔnɔɔ_4233">
    <lexical-unit><form lang="kqs"><text>tɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔnɔ</text></form></variant>
    <sense id="tɔnɔɔ_4233_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>profit, avantage ; intérêt (d'un prêt)</text></gloss>
      <gloss lang="en"><text>profit, benefit; interest (on a loan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gain, profit; good fortune</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first EXO.22.20; Lexique kissi–français, p. 58: tɔnɔɔ; Childs 2000, p. 369: tɔ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɔ̀ŋâŋndó_4234">
    <lexical-unit><form lang="kqs"><text>tɔ̀ŋâŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ŋâŋndó_4234_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau nocturne (espèce), au cri « tɔŋ … tɔŋ »</text></gloss>
      <gloss lang="en"><text>nocturnal bird species, calling 'tɔŋ … tɔŋ'</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ̀ŋâŋndó</text></form></note>
  </entry>
  <entry id="tɔ́ŋgɔ́tɔ́ŋgáá_4235">
    <lexical-unit><form lang="kqs"><text>tɔ́ŋgɔ́tɔ́ŋgáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ́ŋgɔ́tɔ́ŋgáá_4235_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remède traditionnel (espèce)</text></gloss>
      <gloss lang="en"><text>a traditional medicine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ́ŋgɔ́tɔ́ŋgáá</text></form></note>
  </entry>
  <entry id="tɔŋndo_4236">
    <lexical-unit><form lang="kqs"><text>tɔŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔŋndan</text></form></field>
    <variant><form lang="kqs"><text>tɔŋ</text></form></variant>
    <variant><form lang="kqs"><text>tɔŋnda</text></form></variant>
    <sense id="tɔŋndo_4236_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loi, commandement, ordre</text></gloss>
      <gloss lang="en"><text>law, commandment, order</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 298 occurrences, first GEN.2.16; Lexique kissi–français, p. 57: tɔnndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 57) écrit tɔnndo « la loi ».</text></form></note>
  </entry>
  <entry id="tɔ́ŋndó_4237">
    <lexical-unit><form lang="kqs"><text>tɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tɔ́ŋndó_4237_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amende infligée à qui arrive en retard au travail collectif</text></gloss>
      <gloss lang="en"><text>fine for being late to communal work</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ́ŋndó</text></form></note>
  </entry>
  <entry id="tɔ́ɔ́_4238">
    <lexical-unit><form lang="kqs"><text>tɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔ́ɔ́lan</text></form></field>
    <sense id="tɔ́ɔ́_4238_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>renommée, réputation ; nouvelle, bruit ; acclamation</text></gloss>
      <gloss lang="en"><text>fame, renown, reputation; news, report; acclaim</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 223 occurrences, first GEN.6.4; Lexique kissi–français, p. 58: tɔɔ; Childs 2000, p. 369: tɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>vana tɔ́ɔ́ « homme renommé » (GEN.34.19) ; mí tɔ́ɔ́ tiw o cɛi lemasa « la nouvelle parvint au palais » (GEN.45.16) ; tɔ́ɔ́lan « nouvelles » (JER.4.15). Lexique kissi–français, p. 58 : tɔɔ « acclamation ».</text></form></note>
  </entry>
  <entry id="tɔɔ_4239">
    <lexical-unit><form lang="kqs"><text>tɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔɔ_4239_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver (objets, vêtements), rincer</text></gloss>
      <gloss lang="en"><text>wash (things, clothes), rinse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wash clothes, launder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 223 occurrences, first GEN.6.4; Keita 1979, p. 115: Töö; Lexique kissi–français, p. 58: tɔɔ/ tɔa, too; Childs 2000, p. 369: tɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tɔɔ ndi a mɛnndan « le rincer à l'eau » (LEV 6,21). Homonyme de tɔ́ɔ́ « très, nombreux ». Lexique kissi–français, p. 57-58 : radicaux tɔa, too, tua.</text></form></note>
  </entry>
  <entry id="tɔɔliaa_4240">
    <lexical-unit><form lang="kqs"><text>tɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔɔliaa_4240_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accélérer, se dépêcher, faire vite ; faire souvent</text></gloss>
      <gloss lang="en"><text>hurry, go fast; do often</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HAB.1.8; Lexique kissi–français, p. 58: tɔɔriaa/ tɔɔria</text></form></note>
    <note><form lang="fr"><text>Radical tɔɔlia (Lexique : tɔɔria). Le Lexique donne aussi tɔɔliaa « accélérer » (p. 58) et tɔliaa/ tɔlia « se précipiter » (p. 57).</text></form></note>
  </entry>
  <entry id="tɔɔmaa_4241">
    <lexical-unit><form lang="kqs"><text>tɔɔmaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔma</text></form></variant>
    <sense id="tɔɔmaa_4241_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>monstre, bête prodigieuse (visi tɔɔmaa)</text></gloss>
      <gloss lang="en"><text>monster, monstrous beast (visi tɔɔmaa)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.1.21</text></form></note>
    <note><form lang="fr"><text>visia kɔndɔfilaa tɔɔmaa bɛndua « les grands monstres marins » (Gn 1,21).</text></form></note>
  </entry>
  <entry id="tɔɔmaseloo_4242">
    <lexical-unit><form lang="kqs"><text>tɔɔmaseloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔmasele</text></form></variant>
    <sense id="tɔɔmaseloo_4242_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>signe, marque ; symbole</text></gloss>
      <gloss lang="en"><text>sign, mark; symbol</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.9.13; Lexique kissi–français, p. 57: tɔmasereo; Childs 2000, p. 346: tààmàsììyó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 57 : tɔmasereo « le signe, le symbole ».</text></form></note>
  </entry>
  <entry id="tɔɔndaa_4243">
    <lexical-unit><form lang="kqs"><text>tɔɔndaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔɔndaa_4243_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pipe (à tabac)</text></gloss>
      <gloss lang="en"><text>(tobacco) pipe</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tɔɔndaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit aussi tɔndaa (p. 57), homographe du verbe tɔndaa « tisser ».</text></form></note>
  </entry>
  <entry id="tɔɔndan_4244">
    <lexical-unit><form lang="kqs"><text>tɔɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔndanndo</text></form></variant>
    <sense id="tɔɔndan_4244_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éprouver, mettre à l'épreuve ; tenter ; essayer</text></gloss>
      <gloss lang="en"><text>test, try; tempt; attempt</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.22.1</text></form></note>
  </entry>
  <entry id="tɔ́ɔ́yaa_4245">
    <lexical-unit><form lang="kqs"><text>tɔ́ɔ́yaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔ́ɔ́yaa_4245_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faute, blâme, responsabilité (bii X tɔ́ɔ́yaa « tenir X pour responsable, blâmer X »)</text></gloss>
      <gloss lang="en"><text>blame, fault, responsibility (bii X tɔ́ɔ́yaa 'hold X responsible, blame X')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.51.25; Childs 2000, p. 370: tɔ́ɔ́yáŋ</text></form></note>
    <note><form lang="fr"><text>le yɛɛ Hala kalaa co yɛ naa niko tɔ́ɔ́yaa biyɔɔ? « pourquoi Dieu blâme-t-il encore ? » (ROM.9.19 ; aussi ACT.19.40, JER.51.25).</text></form></note>
  </entry>
  <entry id="tɔ̀ɔ̀ɲá_4246">
    <lexical-unit><form lang="kqs"><text>tɔ̀ɔ̀ɲá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ɔ̀ɲá_4246_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire vite, parler très vite, manger ou piler rapidement</text></gloss>
      <gloss lang="en"><text>do quickly, speak very fast, eat or pound rapidly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ̀ɔ̀ɲá</text></form></note>
  </entry>
  <entry id="tɔ̀ɲàá_4247">
    <lexical-unit><form lang="kqs"><text>tɔ̀ɲàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ɲàá_4247_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler vite ; répéter ce qu'un autre a dit</text></gloss>
      <gloss lang="en"><text>speak quickly; repeat what someone said</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ̀ɲàá</text></form></note>
  </entry>
  <entry id="tɛ̀i_4248">
    <lexical-unit><form lang="kqs"><text>tɛ̀i</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛiyo</text></form></variant>
    <sense id="tɛ̀i_4248_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étendre, étaler (au soleil, pour sécher)</text></gloss>
      <gloss lang="en"><text>spread out (in the sun, to dry)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread, esp. in the sun to dry; spread one's hands or legs apart</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.13.10; Lexique kissi–français, p. 54: tɛiyo/ tɛi; Childs 2000, p. 356: tèìyó</text></form></note>
    <note><form lang="fr"><text>mó tɛ̀i malun kullon lecoo « elle étendit du grain dessus » (2SA.17.19) ; ma tɛ̀i nda o dɔ́ɔ́ngɔ́ɔ̀ balɔɔ « ils les étalèrent autour du camp » (NUM.11.32) ; fonda vana tɛ̀i yalalan « lieu où l'on étend les filets » (EZK.26.5). Dans siow X tɛ̀i « tuer X sur le coup » (2SA.1.10, JDG.9.54) le sens est peut-être autre. Cf. tɛilullo.</text></form></note>
  </entry>
  <entry id="tɛi_4249">
    <lexical-unit><form lang="kqs"><text>tɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛi_4249_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arachide ; cacahuète</text></gloss>
      <gloss lang="en"><text>groundnut, peanut</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tèi; Lexique kissi–français, p. 54: tɛi; Childs 2000, p. 362: tìɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tɛ̀i est un homonyme sans rapport (2SA.1.10). Lexique kissi–français, p. 55 : [ti]an « les arachides » (pluriel ?).</text></form></note>
  </entry>
  <entry id="tɛilullo_4250">
    <lexical-unit><form lang="kqs"><text>tɛilullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛilul</text></form></variant>
    <variant><form lang="kqs"><text>tɛilu</text></form></variant>
    <sense id="tɛilullo_4250_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, étendre (les mains) vers ; tendre (la joue) à</text></gloss>
      <gloss lang="en"><text>stretch out, spread (the hands) to; offer (the cheek) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread out (e.g. to dry) for someone; open one's hands to someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.65.2; Childs 2000, p. 355: tèìlúlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif d'un verbe « étendre » (Childs tèìyó). tɛilul ndu balan « tends les mains vers lui » (JOB.11.13) ; mò tɛilu vana co ndu lɔɔ-o kpannde « qu'il tende la joue à celui qui le frappe » (LAM.3.30).</text></form></note>
  </entry>
  <entry id="tɛiye_4251">
    <lexical-unit><form lang="kqs"><text>tɛiye</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛyii</text></form></variant>
    <variant><form lang="kqs"><text>tɛyun</text></form></variant>
    <variant><form lang="kqs"><text>tɛiyun</text></form></variant>
    <sense id="tɛiye_4251_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>confluent ; pousse, rejeton ; bras (d'un fleuve), cours d'eau</text></gloss>
      <gloss lang="en"><text>confluence; shoot, sprout; branch of a river, stream</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.11.1; Keita 1979, p. 155: Tèiye; Lexique kissi–français, p. 54: tɛiye</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tɛiye désigne un rejeton, une pousse (ISA.11.1) ; le sens « confluent » est à confirmer. Dans la Bible : tɛyii « bras de fleuve » (Gn 2,11), tɛiye « rejeton » (Is 11,1).</text></form></note>
  </entry>
  <entry id="tɛ́kpɛ́-tɛ́kpɛ́_4252">
    <lexical-unit><form lang="kqs"><text>tɛ́kpɛ́-tɛ́kpɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛ́kpɛ́-tɛ́kpɛ́_4252_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un par un, un à un (compter)</text></gloss>
      <gloss lang="en"><text>one by one, individually (counting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.2 Count"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first NUM.1.2</text></form></note>
    <note><form lang="fr"><text>La cɔm sɛ́lɛ́ Israɛlla tɛ́kpɛ́-tɛ́kpɛ́ « recensez toute l'assemblée d'Israël un par un » (NUM.1.2).</text></form></note>
  </entry>
  <entry id="tɛlɛfɛlɛ_4253">
    <lexical-unit><form lang="kqs"><text>tɛlɛfɛlɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛlɛfɛlɛ_4253_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tiède</text></gloss>
      <gloss lang="en"><text>lukewarm</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛlɛfɛlɛ</text></form></note>
  </entry>
  <entry id="tɛ̂lɛ́kɛ̀lɛ́_4254">
    <lexical-unit><form lang="kqs"><text>tɛ̂lɛ́kɛ̀lɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɛ̂lɛ́kɛ̀lɛ́_4254_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(bien lisse, comme le ciment)</text></gloss>
      <gloss lang="en"><text>(smooth, like cement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 356: tɛ̂lɛ́kɛ̀lɛ́</text></form></note>
  </entry>
  <entry id="tɛlɛlɔɔ_4255">
    <lexical-unit><form lang="kqs"><text>tɛlɛlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛlɛlɔɔ_4255_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>surface</text></gloss>
      <gloss lang="en"><text>surface</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tèlèlöö; Lexique kissi–français, p. 55: tɛlɛlɔɔ</text></form></note>
  </entry>
  <entry id="tɛmbuo_4256">
    <lexical-unit><form lang="kqs"><text>tɛmbuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛmbu</text></form></variant>
    <sense id="tɛmbuo_4256_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abîmer, ruiner, gâter</text></gloss>
      <gloss lang="en"><text>damage, ruin, spoil</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛnbuo/ tɛnbu</text></form></note>
    <note><form lang="fr"><text>Comparer tambu « être ruiné, s'abîmer » (Bible).</text></form></note>
  </entry>
  <entry id="tɛmbuo kpow_4257">
    <lexical-unit><form lang="kqs"><text>tɛmbuo kpow</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛmbuo kpow_4257_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ravager</text></gloss>
      <gloss lang="en"><text>ravage, lay waste</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛmbuo kpou</text></form></note>
    <note><form lang="fr"><text>Littéralement « tout abîmer » (kpow « tout »).</text></form></note>
  </entry>
  <entry id="tɛmbɔɔ_4258">
    <lexical-unit><form lang="kqs"><text>tɛmbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛmbɔɔ_4258_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>panier de pêche ; grand fétiche des femmes</text></gloss>
      <gloss lang="en"><text>fishing basket; great fetish of the women</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛnbɔɔ</text></form></note>
    <note><form lang="fr"><text>Deux sens réunis dans le Lexique (homographes ?).</text></form></note>
  </entry>
  <entry id="tɛndaa_4259">
    <lexical-unit><form lang="kqs"><text>tɛndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛnda</text></form></variant>
    <variant><form lang="kqs"><text>tɛndanin</text></form></variant>
    <sense id="tɛndaa_4259_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, diviser ; (seilen) témoigner ; couper dans le sens de la longueur (bois)</text></gloss>
      <gloss lang="en"><text>split, divide; (with seilen) testify; cut lengthwise (wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>split, cut open</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first LEV.5.1; Keita 1979, p. 113: Tèndaa; Lexique kissi–français, p. 55: tɛndaa/ tɛnda; Childs 2000, p. 357: tɛ̀ndàá</text></form></note>
    <note><form lang="fr"><text>seilen tɛndaa « porter témoignage » (LEV 5,1) ; bénéfactif tɛndal « témoigner contre ».</text></form></note>
  </entry>
  <entry id="tɛndanɔɔ_4260">
    <lexical-unit><form lang="kqs"><text>tɛndanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛndanɔɔ_4260_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chirurgien</text></gloss>
      <gloss lang="en"><text>surgeon</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Tèndanöö; Lexique kissi–français, p. 55: tɛndanɔɔ</text></form></note>
  </entry>
  <entry id="tɛndiaa_4261">
    <lexical-unit><form lang="kqs"><text>tɛndiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛndia</text></form></variant>
    <sense id="tɛndiaa_4261_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre plusieurs fois, couper dans la longueur à maintes reprises</text></gloss>
      <gloss lang="en"><text>split repeatedly, cut lengthwise again and again</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛndiaa/ tɛndia</text></form></note>
    <note><form lang="fr"><text>Itératif de tɛndaa « fendre ».</text></form></note>
  </entry>
  <entry id="tɛndoo_4262">
    <lexical-unit><form lang="kqs"><text>tɛndoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="tɛndoo_4262_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cotylédon (de la noix de cola)</text></gloss>
      <gloss lang="en"><text>cotyledon (of the kola nut)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛndoo</text></form></note>
    <note><form lang="fr"><text>La Bible a tɛndoo une fois (ISA.30.14) au sens de « morceau, tesson » ; rapport à vérifier.</text></form></note>
  </entry>
  <entry id="tɛnduo_4263">
    <lexical-unit><form lang="kqs"><text>tɛnduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛndu</text></form></variant>
    <sense id="tɛnduo_4263_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éclore</text></gloss>
      <gloss lang="en"><text>hatch</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: [t]ɛnduo/ tɛndu</text></form></note>
    <note><form lang="fr"><text>Homographe : tɛndu dans la Bible (ISA.30.14) signifie « morceau ».</text></form></note>
  </entry>
  <entry id="tɛngie_4264">
    <lexical-unit><form lang="kqs"><text>tɛngie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛngie_4264_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou</text></gloss>
      <gloss lang="en"><text>hole</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngie</text></form></note>
  </entry>
  <entry id="tɛngullo_4265">
    <lexical-unit><form lang="kqs"><text>tɛngullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛngul</text></form></variant>
    <sense id="tɛngullo_4265_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter qqn ou qqch pour lui faire traverser un ruisseau</text></gloss>
      <gloss lang="en"><text>carry someone or something across a stream for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngullo/ tɛngul</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation au radical.</text></form></note>
  </entry>
  <entry id="tɛnguo_4266">
    <lexical-unit><form lang="kqs"><text>tɛnguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛngu</text></form></variant>
    <sense id="tɛnguo_4266_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter une charge pour traverser (un cours d'eau)</text></gloss>
      <gloss lang="en"><text>carry a load across (a stream)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛnguo/ tɛngu</text></form></note>
  </entry>
  <entry id="tɛ́ngɛ̀_4267">
    <lexical-unit><form lang="kqs"><text>tɛ́ngɛ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛngɛla</text></form></variant>
    <sense id="tɛ́ngɛ̀_4267_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lampe, torche</text></gloss>
      <gloss lang="en"><text>lamp, torch</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.1.6</text></form></note>
    <note><form lang="fr"><text>tɛngɛla « torches » (Jg 7,16).</text></form></note>
  </entry>
  <entry id="tɛngɛboenndo_4268">
    <lexical-unit><form lang="kqs"><text>tɛngɛboenndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛngɛboenndo_4268_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>luciole</text></gloss>
      <gloss lang="en"><text>firefly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngɛboenndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « l'insecte qui fait sortir le feu en s'envolant la nuit ».</text></form></note>
  </entry>
  <entry id="tɛngɛi_4269">
    <lexical-unit><form lang="kqs"><text>tɛngɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛngɛi_4269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie des yeux (les yeux deviennent bleus)</text></gloss>
      <gloss lang="en"><text>eye disease (the eyes turn blue)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngɛi</text></form></note>
    <note><form lang="fr"><text>Le Lexique l'attribue à un manque de niacine.</text></form></note>
  </entry>
  <entry id="tɛngɛlen_4270">
    <lexical-unit><form lang="kqs"><text>tɛngɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="tɛngɛlen_4270_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roseau ; herbe de savane</text></gloss>
      <gloss lang="en"><text>reed; savanna grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.40.26; Keita 1979, p. 140: Tèngèlen; Lexique kissi–français, p. 55: tɛngɛlen</text></form></note>
  </entry>
  <entry id="tɛnɔɔ_4271">
    <lexical-unit><form lang="kqs"><text>tɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="tɛnɔɔ_4271_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi ; semaine</text></gloss>
      <gloss lang="en"><text>Monday; week</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛnɔɔ</text></form></note>
    <note><form lang="fr"><text>Homographe : tɛnɔ̀ɔ́ dans la Bible (LAM.3.16) signifie « gravier ». Lundi se dit aussi sayɛiyo. À confirmer.</text></form></note>
  </entry>
  <entry id="tɛtɛɔ_4272">
    <lexical-unit><form lang="kqs"><text>tɛtɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛtɛɔ_4272_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>araignée</text></gloss>
      <gloss lang="en"><text>spider</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛtɛɔ</text></form></note>
    <note><form lang="fr"><text>Voir aussi sontɛndɔɔ.</text></form></note>
  </entry>
  <entry id="tɛu_4273">
    <lexical-unit><form lang="kqs"><text>tɛu</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tɛu_4273_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière</text></gloss>
      <gloss lang="en"><text>termite mound</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chaff, rice straw left after threshing</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tèu; Childs 2000, p. 358: tèùwó</text></form></note>
    <note><form lang="fr"><text>Le sens « termitière » est douteux : la Bible a tɛwvo « paille, chaume » (1CO.3.12), comme le mot de Childs.</text></form></note>
  </entry>
  <entry id="tɛwvo_4274">
    <lexical-unit><form lang="kqs"><text>tɛwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛwvo_4274_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaume (qui reste debout dans les champs après la moisson)</text></gloss>
      <gloss lang="en"><text>stubble</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first RUT.2.7; Lexique kissi–français, p. 55: tɛwvo</text></form></note>
  </entry>
  <entry id="tɛɔndɔɔ_4275">
    <lexical-unit><form lang="kqs"><text>tɛɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɔndɔɔ_4275_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>second, deuxième</text></gloss>
      <gloss lang="en"><text>second</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛɔndɔɔ</text></form></note>
    <note><form lang="fr"><text>La Bible dit diinndɔɔ « deuxième ».</text></form></note>
  </entry>
  <entry id="tɛɛkpaa_4276">
    <lexical-unit><form lang="kqs"><text>tɛɛkpaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛkpaa_4276_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>février</text></gloss>
      <gloss lang="en"><text>February</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Tèèkpaa; Lexique kissi–français, p. 54: tɛɛkpaa</text></form></note>
  </entry>
  <entry id="tɛɛlɔnndo_4277">
    <lexical-unit><form lang="kqs"><text>tɛɛlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛlun</text></form></variant>
    <sense id="tɛɛlɔnndo_4277_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supplier, implorer, prier ; se plaindre à ; solliciter</text></gloss>
      <gloss lang="en"><text>plead, implore, pray; complain to; solicit</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first EXO.9.29; Lexique kissi–français, p. 55: tɛlɔnndo/ tɛlun</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 55 : écrit tɛlɔnndo/ tɛlun.</text></form></note>
  </entry>
  <entry id="tɛɛmbua_4278">
    <lexical-unit><form lang="kqs"><text>tɛɛmbua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛmbua_4278_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>destructeur</text></gloss>
      <gloss lang="en"><text>destroying, destroyer</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first EXO.12.13</text></form></note>
    <note><form lang="fr"><text>De tɛɛmbuuo. mɛlɛkanɔ tɛɛmbua « l'ange destructeur ».</text></form></note>
  </entry>
  <entry id="tɛɛmbuula_4279">
    <lexical-unit><form lang="kqs"><text>tɛɛmbuula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɛɛmbuulan</text></form></field>
    <sense id="tɛɛmbuula_4279_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>transgressions, fautes</text></gloss>
      <gloss lang="en"><text>transgressions, offences</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first LEV.16.21</text></form></note>
    <note><form lang="fr"><text>De tɛɛmbuuo « détruire ; transgresser ».</text></form></note>
  </entry>
  <entry id="tɛɛmbuuo_4280">
    <lexical-unit><form lang="kqs"><text>tɛɛmbuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛmbuu</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛmbuunin</text></form></variant>
    <sense id="tɛɛmbuuo_4280_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>détruire, anéantir ; transgresser (une loi)</text></gloss>
      <gloss lang="en"><text>destroy; break, transgress (a law)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of tàmbéí 'be ruined': spoil, break, misuse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 176 occurrences, first GEN.19.13; Childs 2000, p. 353: tèèmbùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tambu « être ruiné ».</text></form></note>
  </entry>
  <entry id="tɛɛn_4281">
    <lexical-unit><form lang="kqs"><text>tɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛn_4281_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>entre, parmi</text></gloss>
      <gloss lang="en"><text>between, among</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2313 occurrences, first GEN.1.6; Childs 2000, p. 354: tɛ́ɛ̀ŋ</text></form></note>
  </entry>
  <entry id="tɛɛndanndo_4282">
    <lexical-unit><form lang="kqs"><text>tɛɛndanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛndan</text></form></variant>
    <sense id="tɛɛndanndo_4282_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mépriser, regarder de haut, se moquer de</text></gloss>
      <gloss lang="en"><text>despise, look down on, scorn</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.16.4</text></form></note>
  </entry>
  <entry id="tɛɛndiaa_4283">
    <lexical-unit><form lang="kqs"><text>tɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛndiaanin</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛndian</text></form></variant>
    <sense id="tɛɛndiaa_4283_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, faire éclater ; se fendre, s'ouvrir (terre)</text></gloss>
      <gloss lang="en"><text>split, burst open; split apart (earth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>split; divide, distribute; show one by one</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.7.11; Childs 2000, p. 353: tɛ̀ɛ̀ndìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛndaa « fendre ».</text></form></note>
  </entry>
  <entry id="tɛ̀ɛ̀ndo_4284">
    <lexical-unit><form lang="kqs"><text>tɛ̀ɛ̀ndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛ̀ɛ̀ndo_4284_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>teigne ; gale</text></gloss>
      <gloss lang="en"><text>scalp ringworm, scall; scabies</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ringworm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.11.4; Keita 1979, p. 162: Tèèndo; Lexique kissi–français, p. 54: tɛɛndo; Childs 2000, p. 355: tɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit tɛ̀ɛ̀ndo dans ce sens ; tɛɛndo sans ton y signifie « du milieu » (Ex 26,28).</text></form></note>
  </entry>
  <entry id="tɛɛnduuo_4285">
    <lexical-unit><form lang="kqs"><text>tɛɛnduuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛnduuo_4285_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couver (des œufs)</text></gloss>
      <gloss lang="en"><text>hatch (eggs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hatch eggs</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.59.5; Childs 2000, p. 354: tèèndùùwó</text></form></note>
    <note><form lang="fr"><text>A co pelta hɔ̀ɔ̀lɔ́ɔ̀ tɛɛnduuo « ils couvent des œufs de vipère » (ISA.59.5). Une seule attestation.</text></form></note>
  </entry>
  <entry id="tɛɛngaa_4286">
    <lexical-unit><form lang="kqs"><text>tɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛngaa_4286_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, transporter ; transmettre (un message)</text></gloss>
      <gloss lang="en"><text>convey, carry across; deliver (a message)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 619 occurrences, first GEN.20.7</text></form></note>
    <note><form lang="fr"><text>vana-tɛɛngaa-diom-Hala « prophète » ; vanaa tɛɛngaa « les marins » (Jon 1,5).</text></form></note>
  </entry>
  <entry id="tɛɛngei_4287">
    <lexical-unit><form lang="kqs"><text>tɛɛngei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɛɛngon</text></form></field>
    <sense id="tɛɛngei_4287_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou, brèche, creux</text></gloss>
      <gloss lang="en"><text>hole, breach, hollow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hole; burrow (of a rat or squirrel)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first JDG.15.19; Childs 2000, p. 354: tèèŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɛɛngullo_4288">
    <lexical-unit><form lang="kqs"><text>tɛɛngullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛngul</text></form></variant>
    <sense id="tɛɛngullo_4288_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>annoncer, rapporter (à qqn), dire à</text></gloss>
      <gloss lang="en"><text>tell, report (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take (someone) across for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first EXO.4.16; Childs 2000, p. 355: tèèŋùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛngaa.</text></form></note>
  </entry>
  <entry id="tɛɛnguuo_4289">
    <lexical-unit><form lang="kqs"><text>tɛɛnguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛnguu</text></form></variant>
    <sense id="tɛɛnguuo_4289_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire traverser, faire passer (plusieurs)</text></gloss>
      <gloss lang="en"><text>take across, make (many) cross</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cross with or carry across (a river); plural of tàŋɔ̀ɔ́ 'cross'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first NUM.11.27; Childs 2000, p. 355: tèèŋùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛɛngaa.</text></form></note>
  </entry>
  <entry id="tɛɛnuu_4290">
    <lexical-unit><form lang="kqs"><text>tɛɛnuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛnuu_4290_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dégager, défricher (un chemin)</text></gloss>
      <gloss lang="en"><text>clear (a way), clear of vegetation</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear an area of large vegetation for cultivation</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.40.3; Childs 2000, p. 354: tèènùùwó</text></form></note>
    <note><form lang="fr"><text>La tɛɛnuu nɛi Mɛlɛka-oo « préparez le chemin du Seigneur » (ISA.40.3).</text></form></note>
  </entry>
  <entry id="tɛɛnɔn_4291">
    <lexical-unit><form lang="kqs"><text>tɛɛnɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛnɔn_4291_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gravier</text></gloss>
      <gloss lang="en"><text>gravel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tèènön; Lexique kissi–français, p. 54: tɛɛnɔn</text></form></note>
  </entry>
  <entry id="tɛ́ɛ́nɛí_4292">
    <lexical-unit><form lang="kqs"><text>tɛ́ɛ́nɛí</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛ́ɛ́nɛí_4292_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit caillou, grain (de poussière)</text></gloss>
      <gloss lang="en"><text>small stone, grain (of dust)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>small rock or stone; ten large sheaves of rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.8.26; Keita 1979, p. 155: Tèènön; Childs 2000, p. 357: ténéí</text></form></note>
    <note><form lang="fr"><text>hali tɛ́ɛ́nɛí tasei o cundoo nin lɛŋ « ni le premier grain de la poussière du monde » (PRO.8.26). Pluriel : Keita tɛɛnɔn « gravier » (Childs ténɔ́ŋ).</text></form></note>
  </entry>
  <entry id="tɛɛsiaa_4293">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsiaa_4293_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer</text></gloss>
      <gloss lang="en"><text>interpret, explain</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.40</text></form></note>
  </entry>
  <entry id="tɛɛsial_4294">
    <lexical-unit><form lang="kqs"><text>tɛɛsial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsial_4294_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer (à qqn)</text></gloss>
      <gloss lang="en"><text>interpret, explain (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.41.12</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛsiaa.</text></form></note>
  </entry>
  <entry id="va_4295">
    <lexical-unit><form lang="kqs"><text>va</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ve</text></form></variant>
    <variant><form lang="kqs"><text>vanin</text></form></variant>
    <sense id="va_4295_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être (passé) ; auxiliaire du progressif passé</text></gloss>
      <gloss lang="en"><text>be (past); past progressive auxiliary</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11781 occurrences, first GEN.1.2</text></form></note>
  </entry>
  <entry id="va_4296">
    <lexical-unit><form lang="kqs"><text>va</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="va_4296_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ou, donc ; particule interrogative ; exclamation d'émerveillement</text></gloss>
      <gloss lang="en"><text>or, so; question particle; exclamation of wonder</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne trois mots va (p. 59) : « ou, donc », « mot d'exclamation ou d'émerveillement », « une interrogation ». À distinguer du verbe va « être (passé) ».</text></form></note>
  </entry>
  <entry id="va a kɔl tam biɛyo_4297">
    <lexical-unit><form lang="kqs"><text>va a kɔl tam biɛyo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="va a kɔl tam biɛyo_4297_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fâché</text></gloss>
      <gloss lang="en"><text>be angry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va a kɔl tam biɛyo</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; tam est peut-être kɔl-tan « intérieur du cœur ». À vérifier.</text></form></note>
  </entry>
  <entry id="va a ɲaaloo_4298">
    <lexical-unit><form lang="kqs"><text>va a ɲaaloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="va a ɲaaloo_4298_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être content</text></gloss>
      <gloss lang="en"><text>be glad, be happy</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va a ɲalo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit ɲalo ; la Bible écrit ɲaaloo « joie ».</text></form></note>
  </entry>
  <entry id="vaa_4299">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaa_4299_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte, genre (vaa lende « de cette sorte, tel »)</text></gloss>
      <gloss lang="en"><text>kind, sort (vaa lende 'of that kind, such')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Childs 2000, p. 377: wàà</text></form></note>
    <note><form lang="fr"><text>dɛnɛ kɔlvesɛi bɛndu vaa lende « un si grand mal » (GEN.39.9) ; ɲɛla vaa lende « de telles choses » (1SA.17.39). Homographe de vaa « mille », vaa « cultiver », vaa « être ».</text></form></note>
  </entry>
  <entry id="vaa_4300">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vàálan</text></form></field>
    <sense id="vaa_4300_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>mille</text></gloss>
      <gloss lang="en"><text>thousand</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Lexique kissi–français, p. 59: vaa; Childs 2000, p. 377: wàá</text></form></note>
  </entry>
  <entry id="vàá_4301">
    <lexical-unit><form lang="kqs"><text>vàá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vee</text></form></variant>
    <variant><form lang="kqs"><text>veenin</text></form></variant>
    <sense id="vàá_4301_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cultiver, labourer</text></gloss>
      <gloss lang="en"><text>farm, plough</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Keita 1979, p. 115: Vaa; Lexique kissi–français, p. 59: vaa/ va, vee</text></form></note>
    <note><form lang="fr"><text>le vàá « labourer » (DEU 22,10) ; vee, veenin : radical négatif (PRO 20,4 ; GEN 45,6). Homonyme de vaa « être ». Confirmé au Nord par le Lexique kissi–français, p. 59 (vaa/ va, vee « labourer ») ; la Bible a le vàá « labourer » (DEU.22.10), ɲɛm niaa vàá « ce que vous cultivez » (DEU.14.22).</text></form></note>
  </entry>
  <entry id="vaa_4302">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>co</text></form></variant>
    <variant><form lang="kqs"><text>va</text></form></variant>
    <sense id="vaa_4302_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être</text></gloss>
      <gloss lang="en"><text>be</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Keita 1979, p. 115: Vaw; Lexique kissi–français, p. 60: vau/ co, ve, va</text></form></note>
    <note><form lang="fr"><text>Keita écrit vaw (radicaux tyo, vo, va) ; la Bible a le vaa « être » (GEN 3,12) ; vaw y désigne le palmier (JDG 4,5). Lexique kissi–français, p. 59-60 : vau/ co, ve, va « être » ; radical va « être, être sur ».</text></form></note>
  </entry>
  <entry id="vaaliaa_4303">
    <lexical-unit><form lang="kqs"><text>vaaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaaliaa_4303_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir aigre ; (dents) être agacées ; (âme) être amère</text></gloss>
      <gloss lang="en"><text>turn sour; (of teeth) be set on edge; be bitter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.7.11; Childs 2000, p. 377: wààlàá</text></form></note>
  </entry>
  <entry id="vaalio_4304">
    <lexical-unit><form lang="kqs"><text>vaalio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalio_4304_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>maintenant, de nos jours ; actuel (vanndacieea vaalio ho « cette génération »)</text></gloss>
      <gloss lang="en"><text>now, nowadays; present (vanndacieea vaalio ho 'this generation')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.5.14; Childs 2000, p. 377: wáálíò</text></form></note>
  </entry>
  <entry id="vaalɛiyan_4305">
    <lexical-unit><form lang="kqs"><text>vaalɛiyan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalɛiyan_4305_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aigre (mɔima vaalɛiyan « vinaigre »)</text></gloss>
      <gloss lang="en"><text>sour (mɔima vaalɛiyan 'vinegar')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.6.3; Childs 2000, p. 377: wààlɛ́í</text></form></note>
    <note><form lang="fr"><text>De vaaliaa.</text></form></note>
  </entry>
  <entry id="vaan-vaan_4306">
    <lexical-unit><form lang="kqs"><text>vaan-vaan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="vaan-vaan_4306_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fin, léger (tissu) : kola vaan-vaan « voile »</text></gloss>
      <gloss lang="en"><text>fine, thin (cloth): kola vaan-vaan 'veil'</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note><form lang="fr"><text>Toujours dans kola vaan-vaan « voile » (GEN.38.19, SNG.4.1, 2CO.3.14) ; le sens propre de vaan-vaan est à confirmer.</text></form></note>
  </entry>
  <entry id="vaasan_4307">
    <lexical-unit><form lang="kqs"><text>vaasan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaasan_4307_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>incisions, entailles (sur le corps, en signe de deuil)</text></gloss>
      <gloss lang="en"><text>cuts, gashes (on the body, in mourning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first LEV.19.28</text></form></note>
    <note><form lang="fr"><text>keŋnun / kiáŋnun vaasan lekɔɔ « se faire des incisions » (LEV.21.5, LEV.19.28).</text></form></note>
  </entry>
  <entry id="vaiye_4308">
    <lexical-unit><form lang="kqs"><text>vaiye</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vaiye_4308_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taro</text></gloss>
      <gloss lang="en"><text>taro</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: [va]iye</text></form></note>
    <note><form lang="fr"><text>Le Lexique met va- entre crochets : lecture incertaine.</text></form></note>
  </entry>
  <entry id="vakpa_4309">
    <lexical-unit><form lang="kqs"><text>vakpa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vakpa_4309_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, ouvertement, à découvert</text></gloss>
      <gloss lang="en"><text>clearly, openly, in plain view</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.30.37; Lexique kissi–français, p. 59: vakpa</text></form></note>
    <note><form lang="fr"><text>o fula vannda o hɔl vakpa le « il ne monta pas ouvertement » (JHN.7.10).</text></form></note>
  </entry>
  <entry id="valaa_4310">
    <lexical-unit><form lang="kqs"><text>valaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>valalan</text></form></field>
    <variant><form lang="kqs"><text>vala</text></form></variant>
    <sense id="valaa_4310_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>natte ; grabat, couche</text></gloss>
      <gloss lang="en"><text>mat; pallet, bed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(sleeping) mat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2SA.17.19; Lexique kissi–français, p. 60: varaa; Childs 2000, p. 379: wàlàá</text></form></note>
    <note><form lang="fr"><text>o ɲɛla hinialan coo a o valalan coo « sur des lits et des grabats » (ACT.5.15) ; cua vala nɔmndo « prends ton grabat » (ACT.9.34) ; maa vala « comme une natte (roulée) » (ISA.34.4). Le Lexique kissi–français (p. 60) écrit varaa « le petit tapis, la natte ».</text></form></note>
  </entry>
  <entry id="valaa_4311">
    <lexical-unit><form lang="kqs"><text>valaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="valaa_4311_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aigre</text></gloss>
      <gloss lang="en"><text>sour</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: valaa</text></form></note>
    <note><form lang="fr"><text>Homographe de valaa « natte ».</text></form></note>
  </entry>
  <entry id="valen_4312">
    <lexical-unit><form lang="kqs"><text>valen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
