  <entry id="yalalen_4592">
    <lexical-unit><form lang="kqs"><text>yalalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="yalalen_4592_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tromperie (en paroles), fourberie</text></gloss>
      <gloss lang="en"><text>deceit (in speech), treachery</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, slander</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first AMO.7; Childs 2000, p. 397: yàlàléŋ</text></form></note>
    <note><form lang="fr"><text>a co yalalen a diɛɛmui ndɛi « ils se servent de leur langue pour tromper » (ROM.3.13). Cf. Childs yàlàbàá « tromperie ».</text></form></note>
  </entry>
  <entry id="yalama_4593">
