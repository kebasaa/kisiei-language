      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pauvre, nécessiteux</text></gloss>
      <gloss lang="en"><text>poor, needy</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.22.24</text></form></note>
  </entry>
