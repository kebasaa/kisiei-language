    <trait name="status" value="attested"/>
    <sense id="sɛ́ɛ́n_1597_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(vesa sɛ́ɛ́n) complètement sec</text></gloss>
      <gloss lang="en"><text>(vesa sɛ́ɛ́n) completely dry</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) describes dryness, or the thinness of a person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.8.14; Childs 2000, p. 326: séɛ́ŋ</text></form></note>
  </entry>
  <entry id="sɛɛngianndo_1598">
    <lexical-unit><form lang="kqs"><text>sɛɛngianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛngian</text></form></variant>
    <variant><form lang="kqs"><text>sɛɛngiaa</text></form></variant>
    <variant><form lang="kqs"><text>sɛɛngianndan</text></form></variant>
    <sense id="sɛɛngianndo_1598_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se disputer, discuter ; dispute, querelle</text></gloss>
      <gloss lang="en"><text>quarrel, argue, debate; dispute, strife</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of sèŋìá 'argue': disagree repeatedly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.13.7; Childs 2000, p. 326: sèèŋìá</text></form></note>
  </entry>
  <entry id="sɛɛsaa_1599">
    <lexical-unit><form lang="kqs"><text>sɛɛsaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛsa</text></form></variant>
    <sense id="sɛɛsaa_1599_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déchirer</text></gloss>
      <gloss lang="en"><text>tear</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tear, rip apart; relate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ECC.3.7; Keita 1979, p. 113: Sèèsaa; Childs 2000, p. 326: sɛ̀ɛ̀sàá</text></form></note>
  </entry>
  <entry id="sɛɛsiaa_1600">
    <lexical-unit><form lang="kqs"><text>sɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛsian</text></form></variant>
    <sense id="sɛɛsiaa_1600_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déchirer (en morceaux, plusieurs fois)</text></gloss>
      <gloss lang="en"><text>tear (to pieces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.37.29; Keita 1979, p. 113: Sèèsiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɛɛsaa ; sɛɛsiaa volɔɔla « déchirer ses vêtements » (GEN 37,29).</text></form></note>
  </entry>
  <entry id="sɛɛviaa_1601">
    <lexical-unit><form lang="kqs"><text>sɛɛviaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛɛviaa_1601_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gribouiller</text></gloss>
      <gloss lang="en"><text>scribble</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sèèviaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɛvaa.</text></form></note>
  </entry>
  <entry id="taala itendoo_1602">
    <lexical-unit><form lang="kqs"><text>taala itendoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="taala itendoo_1602_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>calebasse</text></gloss>
      <gloss lang="en"><text>calabash</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Taala itendoo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, taala désigne une coupe (GEN.40.11).</text></form></note>
  </entry>
  <entry id="taala kolaa_1603">
    <lexical-unit><form lang="kqs"><text>taala kolaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="taala kolaa_1603_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gobelet</text></gloss>
      <gloss lang="en"><text>cup, goblet</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Taala kolaa</text></form></note>
    <note><form lang="fr"><text>Second élément incertain ; taalaa « calebasse, coupe » est attesté.</text></form></note>
  </entry>
  <entry id="taalaa_1604">
    <lexical-unit><form lang="kqs"><text>taalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="taalaa_1604_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>calebasse, coupe, bassin</text></gloss>
      <gloss lang="en"><text>calabash, cup, basin</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drinking cup, calabash; also a glass</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.12.22; Keita 1979, p. 159: Taalaa; Childs 2000, p. 346: tààlàá</text></form></note>
  </entry>
  <entry id="taaliaa_1605">
    <lexical-unit><form lang="kqs"><text>taaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>taaliaanin</text></form></variant>
    <sense id="taaliaa_1605_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (un liquide sur)</text></gloss>
      <gloss lang="en"><text>pour out, pour (a liquid on)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pour repeatedly (plural of 'pour')</text></form></field>
