    <sense id="kolokoloo_1418_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coin de rue, angle ; (pl.) carrefours, places</text></gloss>
      <gloss lang="en"><text>corner, street corner; (pl.) street corners, open places</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>corner, space between two houses</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first NEH.3.24; Childs 2000, p. 173: kòlòkòlóó</text></form></note>
    <note><form lang="fr"><text>mó kei o kolokoloo pum ikɛi « il passa près de l'angle (de sa rue) » (PRO.7.8) ; o kolokololan kpow ikɛi « à tous les coins de rue » (PRO.7.12).</text></form></note>
  </entry>
