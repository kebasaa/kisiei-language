    <trait name="status" value="check"/>
    <sense id="vanacieeyɛi_3583_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>humanité, humanisme (Keita)</text></gloss>
      <gloss lang="en"><text>humanity, humaneness (Keita)</text></gloss>
