      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpɛmɔɔ</text></form></note>
  </entry>
  <entry id="kpɛn_2029">
