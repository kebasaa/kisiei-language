      <gloss lang="fr"><text>sortir</text></gloss>
      <gloss lang="en"><text>go out, come out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go or come out, leave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 690 occurrences, first GEN.2.6; Keita 1979, p. 110: Fulaa; Childs 2000, p. 111: fùlàá</text></form></note>
    <note><form lang="fr"><text>Bénéfactif fulal « sortir vers, apparaître à ».</text></form></note>
  </entry>
  <entry id="fulakɔlio_902">
    <lexical-unit><form lang="kqs"><text>fulakɔlio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fulakɔlio_902_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trahison</text></gloss>
      <gloss lang="en"><text>betrayal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
