    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="sèléí_4483_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haricot ou baie sauvage non comestible (irritant)</text></gloss>
      <gloss lang="en"><text>inedible wild bean or berry (causes itching)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 324: sèléí</text></form></note>
  </entry>
  <entry id="selekpekpee_4484">
    <lexical-unit><form lang="kqs"><text>selekpekpee</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="selekpekpee_4484_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>raide, escarpé</text></gloss>
      <gloss lang="en"><text>steep</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: selekpekpee</text></form></note>
  </entry>
  <entry id="selekpekpoo_4485">
    <lexical-unit><form lang="kqs"><text>selekpekpoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="selekpekpoo_4485_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pic</text></gloss>
      <gloss lang="en"><text>peak (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: selekpekpoo</text></form></note>
    <note><form lang="fr"><text>Le Lexique dit seulement « pic » : sommet escarpé (cf. selekpekpee « raide ») ou outil ou oiseau ? À confirmer.</text></form></note>
  </entry>
  <entry id="selemenden_4486">
    <lexical-unit><form lang="kqs"><text>selemenden</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="selemenden_4486_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, complètement</text></gloss>
      <gloss lang="en"><text>completely, utterly, entirely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.7.23</text></form></note>
  </entry>
  <entry id="selennda_4487">
    <lexical-unit><form lang="kqs"><text>selennda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="selennda_4487_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de sauterelles (pl.)</text></gloss>
      <gloss lang="en"><text>a kind of locusts (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>edible tree-dwelling grasshoppers</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.11.22; Childs 2000, p. 324: séléŋndó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. Cité avec sóónɔa et paalenda (LEV.11.22, JOL.1.4, JOL.2.25).</text></form></note>
  </entry>
  <entry id="sèmɔ̀ɔ́_4488">
    <lexical-unit><form lang="kqs"><text>sèmɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sèmɔ̀ɔ́_4488_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (bois à planches)</text></gloss>
      <gloss lang="en"><text>a tree species (gives planks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 325: sèmɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="senaŋo_4489">
    <lexical-unit><form lang="kqs"><text>senaŋo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>semaa</text></form></variant>
    <sense id="senaŋo_4489_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soigneuse des excisées</text></gloss>
      <gloss lang="en"><text>woman who tends initiated girls</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 94: senaŋo, semaa</text></form></note>
    <note><form lang="fr"><text>Paulme : (N.) ; aussi pour les circoncis.</text></form></note>
  </entry>
  <entry id="sendi-sendi_4490">
    <lexical-unit><form lang="kqs"><text>sendi-sendi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sendi-sendi_4490_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pointu</text></gloss>
      <gloss lang="en"><text>pointed</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sendi-sendi</text></form></note>
  </entry>
  <entry id="sendinndo_4491">
    <lexical-unit><form lang="kqs"><text>sendinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sendin</text></form></variant>
    <sense id="sendinndo_4491_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se raser, se coiffer ; se couper les cheveux</text></gloss>
      <gloss lang="en"><text>shave oneself; cut one's hair</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sendinndo; Lexique kissi–français, p. 47: sendinndo/ sendin</text></form></note>
    <note><form lang="fr"><text>Moyen de sendio. Formes attestées dans la Bible : sendin (LEV 13,33), sendinnin.</text></form></note>
  </entry>
  <entry id="sendinɔɔ_4492">
    <lexical-unit><form lang="kqs"><text>sendinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sendinɔɔ_4492_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffeur, barbier</text></gloss>
      <gloss lang="en"><text>barber, hairdresser</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Sendinöö; Lexique kissi–français, p. 47: sendinɔɔ; Terminologie (arts), n° 60: Sendinöö, lawnöö</text></form></note>
    <note><form lang="fr"><text>Cf. sendi « raser » dans la Bible (Dt 21,12). Académie des langues (terminologie, arts n° 60) : sendinöö (aussi lawnöö) « coiffeur ».</text></form></note>
  </entry>
  <entry id="sendío_4493">
    <lexical-unit><form lang="kqs"><text>sendío</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sendi</text></form></variant>
    <variant><form lang="kqs"><text>sendinin</text></form></variant>
    <sense id="sendío_4493_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>raser, coiffer ; (sendi) coiffure</text></gloss>
      <gloss lang="en"><text>shave, cut (hair); (sendi) hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shave (someone), cut hair</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.22.10; Keita 1979, p. 113: Sendio; Paulme 1964, p. 91: sendyo; Lexique kissi–français, p. 47: sendio/ sendi; Terminologie (arts), n° 59: Sendioo, lavöö; Childs 2000, p. 325: sèndìó</text></form></note>
    <note><form lang="fr"><text>Homonyme : sendío « serment » (EXO 22,10). Paulme 1964, p. 91 : ɔ sendi « il se rase » ; p. 93 : tua ɔ sendyo « coiffure (coupe de cheveux) de l'enfant, à l'imposition du nom » ; pɛndua sendyo « coiffure des jumeaux ». Académie des langues (terminologie, arts n° 59) : sendioo (aussi lavöö) « coiffer ».</text></form></note>
  </entry>
  <entry id="sendu_4494">
    <lexical-unit><form lang="kqs"><text>sendu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sendu_4494_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>droit, juste (… sendu le « injuste, tortueux »)</text></gloss>
      <gloss lang="en"><text>straight, right (… sendu le 'unjust, crooked')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be straight; be honest; (of a lamp or fire) be bright</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 45 occurrences, first JOB.27.7; Paulme 1964, p. 91: sɛndu, sanda; Childs 2000, p. 320: sàndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 91 : sunde le sɛndura « ce bâton n'est pas droit ».</text></form></note>
  </entry>
  <entry id="sengoo_4495">
    <lexical-unit><form lang="kqs"><text>sengoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sengoo_4495_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>antilope</text></gloss>
      <gloss lang="en"><text>antelope</text></gloss>
