  <entry id="ndáà_2408">
    <lexical-unit><form lang="kqs"><text>ndáà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="ndáà_2408_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ensemble (avec eux)</text></gloss>
      <gloss lang="en"><text>together (with them)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
