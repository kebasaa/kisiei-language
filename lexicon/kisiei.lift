  <entry id="fìɲàá_1390">
    <lexical-unit><form lang="kqs"><text>fìɲàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fìɲàláŋ</text></form></field>
    <sense id="fìɲàá_1390_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>scarifications, marques de beauté, tatouages</text></gloss>
      <gloss lang="en"><text>scarification, beauty marks, tattoos</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fìɲàá</text></form></note>
  </entry>
  <entry id="fíɲɔ́ɔ́_1391">
    <lexical-unit><form lang="kqs"><text>fíɲɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fíɲéláŋ</text></form></field>
    <sense id="fíɲɔ́ɔ́_1391_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coussinet de portage (sur la tête)</text></gloss>
      <gloss lang="en"><text>head pad for carrying loads</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 106: fíɲɔ́ɔ́</text></form></note>
