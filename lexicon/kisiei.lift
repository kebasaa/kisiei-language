      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>intervene, interfere (to stop someone)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LUK.9.55; Childs 2000, p. 202: kpààndìáŋndó</text></form></note>
    <note><form lang="fr"><text>a kpaandian ndu « reprends-le » (LUK.17.3) ; mó kpaandian nda « il les réprimanda » (LUK.9.55). Cf. kpaa « arrêter, retenir ».</text></form></note>
  </entry>
