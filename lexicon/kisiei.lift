    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sùsóó_3124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse-mouches, balai rituel (de l'interprète du masque)</text></gloss>
      <gloss lang="en"><text>ritual whisk or broom (used by the masked spirit's interpreter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 345: sùsóó</text></form></note>
  </entry>
  <entry id="susul_3125">
    <lexical-unit><form lang="kqs"><text>susul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="susul_3125_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vomir, cracher (un flot d'eau)</text></gloss>
      <gloss lang="en"><text>spew, spout (a stream of water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spit, spray a liquid from the mouth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first REV.12.15; Childs 2000, p. 345: sùsùlló</text></form></note>
    <note><form lang="fr"><text>mí tambálakáà susul mɛnndan vanalanɔɔ kɔɔli maa pee bɛndu « le dragon vomit de l'eau comme un fleuve derrière la femme » (REV.12.15, REV.12.16).</text></form></note>
  </entry>
