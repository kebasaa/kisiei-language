    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pelon</text></form></field>
    <variant><form lang="kqs"><text>pelii</text></form></variant>
    <variant><form lang="kqs"><text>pɛrie</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>peruo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="pelei_3916_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pied, jambe</text></gloss>
      <gloss lang="en"><text>foot, leg</text></gloss>
