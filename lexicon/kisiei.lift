  <entry id="nɛŋio_1234">
    <lexical-unit><form lang="kqs"><text>nɛŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nɛŋi</text></form></variant>
    <variant><form lang="kqs"><text>nɛŋinin</text></form></variant>
    <variant><form lang="kqs"><text>nɛŋul</text></form></variant>
    <sense id="nɛŋio_1234_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire prospérer, rendre fécond ; réjouir (le cœur)</text></gloss>
      <gloss lang="en"><text>make prosper, make fruitful; gladden (the heart)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make something beautiful, make people happy (causative of 'be good')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.39.3; Childs 2000, p. 259: nèŋìó</text></form></note>
    <note><form lang="fr"><text>nɛŋi … ipulu « rendre fécond » (Gn 29,31) ; Mɛlɛka va ndu nɛŋio « le Seigneur le faisait réussir » (Gn 39,3) ; kɔllo nɛŋio « réjouir le cœur » (Ps 92,5).</text></form></note>
  </entry>
