  <entry id="kéléŋ_1532">
    <lexical-unit><form lang="kqs"><text>kéléŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kéléŋ_1532_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout droit ; (Liberia) injure</text></gloss>
      <gloss lang="en"><text>straight ahead; (Liberia) a term of abuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
