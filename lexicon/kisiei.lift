    <sense id="bello_199_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouvernement</text></gloss>
      <gloss lang="en"><text>government</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
