    <sense id="kpóŋó-kpóŋó_1956_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(travailler) à faire un champ, une caféière</text></gloss>
      <gloss lang="en"><text>(working) at making a farm or coffee plot</text></gloss>
