    <sense id="beleŋuɛɛnu_59_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>cinquante</text></gloss>
      <gloss lang="en"><text>fifty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
