      <gloss lang="fr"><text>si (te … pɛ)</text></gloss>
      <gloss lang="en"><text>if (te … pɛ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>if, when</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7156 occurrences, first GEN.3.3; Childs 2000, p. 350: tè … pɛ́</text></form></note>
  </entry>
  <entry id="teengen_1639">
    <lexical-unit><form lang="kqs"><text>teengen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tengen</text></form></variant>
    <sense id="teengen_1639_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>à part, séparément ; mis à part ; différent</text></gloss>
      <gloss lang="en"><text>apart, separately; set apart; different</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>different, distinct; also erect (as a rising snake)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 94 occurrences, first GEN.4.15; Childs 2000, p. 352: téŋéŋ-téŋéŋ</text></form></note>
    <note><form lang="fr"><text>kɛsin teengen le Mɛlɛka « mis à part pour le Seigneur » (Ex 16,23) ; le co tengen « est différent » (1 Co 15,39).</text></form></note>
  </entry>
  <entry id="teengiaa_1640">
