    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="sondo yiyo_4704">
    <lexical-unit><form lang="kqs"><text>sondo yiyo</text></form></lexical-unit>
