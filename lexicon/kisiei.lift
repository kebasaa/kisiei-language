      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chuchoter</text></gloss>
      <gloss lang="en"><text>whisper</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Siööndaa; Lexique kissi–français, p. 50: siɔɔndaa/ siɔɔnda</text></form></note>
