      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>cette année</text></gloss>
      <gloss lang="en"><text>this year</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nánde</text></form></note>
  </entry>
  <entry id="nanu_2395">
    <lexical-unit><form lang="kqs"><text>nanu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nanu_2395_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ici</text></gloss>
      <gloss lang="en"><text>here</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 506 occurrences, first GEN.15.16; Childs 2000, p. 258: nánùŋ</text></form></note>
  </entry>
  <entry id="nanɔɔ_2396">
    <lexical-unit><form lang="kqs"><text>nanɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nan</text></form></variant>
    <variant><form lang="kqs"><text>nannin</text></form></variant>
    <variant><form lang="kqs"><text>nennin</text></form></variant>
    <sense id="nanɔɔ_2396_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tirer</text></gloss>
      <gloss lang="en"><text>pull, draw</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pull, suck, drag</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.34.3; Keita 1979, p. 114: Nanöö; Childs 2000, p. 258: nànɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Radical en e de Keita : nen ; nennin (JDG 4,7).</text></form></note>
  </entry>
  <entry id="nawvo_2397">
    <lexical-unit><form lang="kqs"><text>nawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nawva</text></form></field>
    <variant><form lang="kqs"><text>naw</text></form></variant>
    <variant><form lang="kqs"><text>navaa</text></form></variant>
    <sense id="nawvo_2397_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vache, bœuf ; bovin</text></gloss>
      <gloss lang="en"><text>cow, ox; cattle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.21.28; Childs 2000, p. 259: nàùwɔ́</text></form></note>
    <note><form lang="fr"><text>navaa tovaa « jeunes taureaux ».</text></form></note>
  </entry>
  <entry id="náŋ_2398">
    <lexical-unit><form lang="kqs"><text>náŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="náŋ_2398_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>déjà, autrefois, auparavant ; ici</text></gloss>
      <gloss lang="en"><text>already, once, before; here</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: náŋ</text></form></note>
  </entry>
  <entry id="nàŋǎŋndó_2399">
    <lexical-unit><form lang="kqs"><text>nàŋǎŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>nàŋáŋndó</text></form></variant>
    <variant><form lang="kqs"><text>nààŋáŋndó</text></form></variant>
    <sense id="nàŋǎŋndó_2399_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amitié ; meilleur ami</text></gloss>
      <gloss lang="en"><text>friendship; best friend</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 259: nàŋǎŋndó</text></form></note>
    <note><form lang="fr"><text>Dérivé de nàŋɔ̀ɔ́ « être bon » (cf. naŋɔɔ, Bible).</text></form></note>
  </entry>
  <entry id="nàŋgàá_2400">
    <lexical-unit><form lang="kqs"><text>nàŋgàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nàŋgàá_2400_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>natte souple (pour jouer à la toupie) ; maladie par manque de sang ; coiffure de femme</text></gloss>
      <gloss lang="en"><text>soft mat (used for playing tops); sickness from lack of blood; a woman's hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 259: nàŋgàá</text></form></note>
  </entry>
  <entry id="naŋu_2401">
    <lexical-unit><form lang="kqs"><text>naŋu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>naŋun</text></form></variant>
    <sense id="naŋu_2401_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>incliner, abaisser ; (naŋun) se pencher</text></gloss>
      <gloss lang="en"><text>bend down, bow (something); (naŋun) lean down, stoop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend, be bent; tip; settle a matter secretly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.18.10; Childs 2000, p. 259: nàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Mó naŋu halataalaa « il abaissa les cieux » (PSA.18.10) ; mó naŋun le tofaa « il s'est penché pour regarder » (PSA.102.20). À distinguer de naŋɔɔ « être bon ».</text></form></note>
  </entry>
  <entry id="naŋɔɔ_2402">
    <lexical-unit><form lang="kqs"><text>naŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>naŋ</text></form></variant>
    <variant><form lang="kqs"><text>naŋnin</text></form></variant>
    <sense id="naŋɔɔ_2402_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être bon, beau, agréable ; plaire ; bonté, beauté</text></gloss>
      <gloss lang="en"><text>be good, beautiful, pleasing; goodness, beauty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be good, fine, beautiful; be generous, morally good</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 170 occurrences, first GEN.2.12; Childs 2000, p. 259: nàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>naŋ kɔl a … « aimer, apprécier » (1 S 18,5).</text></form></note>
  </entry>
  <entry id="nda_2403">
    <lexical-unit><form lang="kqs"><text>nda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nda_2403_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>eux, elles, les</text></gloss>
      <gloss lang="en"><text>them (independent)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15820 occurrences, first GEN.1.21; Childs 2000, p. 266: ndá</text></form></note>
  </entry>
  <entry id="nda_2404">
