    <note type="source"><form lang="en"><text>BKG: 134 occurrences, first GEN.39; Keita 1979, p. 142: Kaasoo; Lexique kissi–français, p. 20: kaasoo</text></form></note>
  </entry>
  <entry id="kààŋgòó_1389">
    <lexical-unit><form lang="kqs"><text>kààŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
