    <sense id="viɔw_3636_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cogner, heurter ; tirer (flèche)</text></gloss>
      <gloss lang="en"><text>knock, strike; shoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.35.22; Keita 1979, p. 116: Viöw</text></form></note>
    <note><form lang="fr"><text>via « atteindre (d'une flèche) » (2CH 35,23).</text></form></note>
  </entry>
  <entry id="vo_3637">
    <lexical-unit><form lang="kqs"><text>vo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vo_3637_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>craindre, respecter</text></gloss>
      <gloss lang="en"><text>fear, revere</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 754 occurrences, first GEN.9.15; Childs 2000, p. 389: wɔ̀ɔ́</text></form></note>
