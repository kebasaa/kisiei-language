  <entry id="ciɛilabaa_726">
    <lexical-unit><form lang="kqs"><text>ciɛilabaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ciɛilabaa_726_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bataille</text></gloss>
      <gloss lang="en"><text>battle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 108: Tyieilabaa (työlabaa)</text></form></note>
