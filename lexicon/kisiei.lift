    <sense id="fúwáléŋ_928_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>savane arbustive, forêt claire</text></gloss>
      <gloss lang="en"><text>bushy savanna, open forest</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fúwáléŋ</text></form></note>
  </entry>
  <entry id="fûŋ_929">
