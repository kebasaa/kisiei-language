    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲavɛi</text></form></variant>
    <variant><form lang="kqs"><text>ɲavɛiya</text></form></variant>
    <variant><form lang="kqs"><text>ɲavɛyaa</text></form></variant>
    <sense id="ɲavɛiyo_4158_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>maigre, chétif</text></gloss>
      <gloss lang="en"><text>thin, lean, gaunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thin, dry</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZK.34.20; Childs 2000, p. 275: ɲàwéí-</text></form></note>
    <note><form lang="fr"><text>navaa … ɲavɛyaa « les vaches maigres » (GEN.41.4). Cf. ɲawvo « maigrir ». Correspondance w ~ v.</text></form></note>
  </entry>
  <entry id="ɲawvo_4159">
    <lexical-unit><form lang="kqs"><text>ɲawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲaw</text></form></variant>
    <variant><form lang="kqs"><text>ɲawnin</text></form></variant>
    <sense id="ɲawvo_4159_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maigrir, dépérir, s'épuiser ; (nom) dépérissement, consomption</text></gloss>
      <gloss lang="en"><text>waste away, grow thin; (noun) wasting, emaciation</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.47.13; Childs 2000, p. 275: ɲàùwó</text></form></note>
    <note><form lang="fr"><text>vanndacieea kandu ɲawvo a yiaan « les gens dépérissaient de faim » (GEN.47.13).</text></form></note>
  </entry>
