      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 29: kpɔɔ; Childs 2000, p. 218: kpɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Ricinodendron africanum. Confirmé au Nord par le Lexique kissi–français, p. 29 (« une sorte d'arbre »). Pluriel en kissi du Sud (Childs 2000) : kpɔ́ɔ́wé.</text></form></note>
  </entry>
