    <trait name="status" value="attested"/>
    <sense id="man_2597_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce, ces (classe an)</text></gloss>
      <gloss lang="en"><text>this, that (an class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 475 occurrences, first GEN.1.2; Childs 2000, p. 241: mâŋ</text></form></note>
  </entry>
  <entry id="mànàwɛ́íyó_2598">
    <lexical-unit><form lang="kqs"><text>mànàwɛ́íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mànàwɛ́íyó_2598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de banane (savoureuse)</text></gloss>
      <gloss lang="en"><text>variety of banana (tasty)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 241: mànàwɛ́íyó</text></form></note>
  </entry>
  <entry id="mandaa_2599">
    <lexical-unit><form lang="kqs"><text>mandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>manda</text></form></variant>
    <variant><form lang="kqs"><text>mandanin</text></form></variant>
    <sense id="mandaa_2599_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller, prendre soin de</text></gloss>
      <gloss lang="en"><text>keep, guard, look after</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take care of, raise (animals); mind</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 368 occurrences, first GEN.2.15; Childs 2000, p. 241: màndàá</text></form></note>
    <note><form lang="fr"><text>vana mandaa n'cɔloo « gardien de moutons, berger » (Gn 4,2).</text></form></note>
  </entry>
  <entry id="mandanndo_2600">
    <lexical-unit><form lang="kqs"><text>mandanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mandan</text></form></variant>
    <sense id="mandanndo_2600_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se garder (de), prendre garde ; mettre de côté</text></gloss>
      <gloss lang="en"><text>keep oneself (from), beware; store up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take care of oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first DEU.11; Childs 2000, p. 241: màndăŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de mandaa.</text></form></note>
  </entry>
  <entry id="mandenɔɔ_2601">
    <lexical-unit><form lang="kqs"><text>mandenɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mandea</text></form></field>
    <sense id="mandenɔɔ_2601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marabout, devin</text></gloss>
      <gloss lang="en"><text>diviner, charmer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>diviner, fortune teller, medicine man; also a Muslim</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.18.11; Keita 1979, p. 150: Mandenöö; Lexique kissi–français, p. 33: mandenɔɔ; Childs 2000, p. 241: màndénɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mandrakɔr_2602">
    <lexical-unit><form lang="kqs"><text>mandrakɔr</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mandrakɔr_2602_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mandragore</text></gloss>
      <gloss lang="en"><text>mandrake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.30.14</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="mangalaa_2603">
    <lexical-unit><form lang="kqs"><text>mangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mangala</text></form></variant>
    <variant><form lang="kqs"><text>mangalan</text></form></variant>
    <variant><form lang="kqs"><text>mangalanin</text></form></variant>
    <variant><form lang="kqs"><text>mangalɛi</text></form></variant>
    <sense id="mangalaa_2603_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer ; (mangalan) être changé, être différent</text></gloss>
      <gloss lang="en"><text>change; (mangalan) be changed, be different</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>change (clothes, behaviour); play magic, transform by magic</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 660 occurrences, first GEN.12.2; Childs 2000, p. 242: màŋàlàá</text></form></note>
    <note><form lang="fr"><text>mangala kelala « changer de conduite » ; sɔɛi mangalɛi « une langue différente » (Gn 11,9).</text></form></note>
  </entry>
  <entry id="mangaliaa_2604">
    <lexical-unit><form lang="kqs"><text>mangaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mangaliala</text></form></variant>
    <sense id="mangaliaa_2604_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>falsifier, truquer ; (mangaliala) sortilèges, tours de magie</text></gloss>
      <gloss lang="en"><text>falsify, rig; (mangaliala) sorceries, magic tricks</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>change many things; play magic</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first AMO.8.5; Childs 2000, p. 242: màŋàlìá</text></form></note>
    <note><form lang="fr"><text>Pluriel verbal de mangalaa « changer ». ɲɛla tuvaala n'ɲɛlan mangaliaa « fausser les balances » (AMO.8.5) ; mangaliala ndɔla « ses sortilèges » (ACT.8.11).</text></form></note>
  </entry>
  <entry id="mangalian_2605">
    <lexical-unit><form lang="kqs"><text>mangalian</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mangalian_2605_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>primitif</text></gloss>
      <gloss lang="en"><text>primitive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 33: mangalian</text></form></note>
  </entry>
  <entry id="manne_2606">
    <lexical-unit><form lang="kqs"><text>manne</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="manne_2606_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manne</text></gloss>
      <gloss lang="en"><text>manna</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.16</text></form></note>
    <note><form lang="fr"><text>Nom donné par les Israélites à la nourriture du désert (Ex 16,31).</text></form></note>
  </entry>
  <entry id="masa-ibungaa_2607">
    <lexical-unit><form lang="kqs"><text>masa-ibungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masa-ibunga</text></form></variant>
    <sense id="masa-ibungaa_2607_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouverneur, proconsul</text></gloss>
      <gloss lang="en"><text>governor, proconsul</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first LUK.2.2</text></form></note>
  </entry>
  <entry id="masaa_2608">
    <lexical-unit><form lang="kqs"><text>masaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="masaa_2608_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roi, chef</text></gloss>
      <gloss lang="en"><text>king, chief</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chief</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2748 occurrences, first GEN.12.15; Keita 1979, p. 148: Masaa; Lexique kissi–français, p. 33: masaa; Childs 2000, p. 242: màsàá</text></form></note>
  </entry>
  <entry id="másáá_2609">
    <lexical-unit><form lang="kqs"><text>másáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>másáléŋ</text></form></field>
    <sense id="másáá_2609_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pian (infection de la peau, surtout aux pieds)</text></gloss>
      <gloss lang="en"><text>yaws (skin infection, especially of the feet)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: másáá</text></form></note>
  </entry>
  <entry id="masalen_2610">
    <lexical-unit><form lang="kqs"><text>masalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masale</text></form></variant>
    <sense id="masalen_2610_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>royaume, règne, royauté</text></gloss>
      <gloss lang="en"><text>kingdom, reign, kingship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chieftaincy, rule</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 482 occurrences, first GEN.1.28; Childs 2000, p. 243: màsàlɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>De masaa « roi ».</text></form></note>
  </entry>
  <entry id="másáŋ-kàŋgóó_2611">
    <lexical-unit><form lang="kqs"><text>másáŋ-kàŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="másáŋ-kàŋgóó_2611_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie qui creuse la plante des pieds</text></gloss>
      <gloss lang="en"><text>disease that pits the soles of the feet</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: másáŋ-kàŋgóó</text></form></note>
  </entry>
  <entry id="masindɛ_2612">
    <lexical-unit><form lang="kqs"><text>masindɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masindɛa</text></form></variant>
    <variant><form lang="kqs"><text>masindɛlan</text></form></variant>
    <variant><form lang="kqs"><text>masindɛla</text></form></variant>
    <variant><form lang="kqs"><text>masindɛi</text></form></variant>
    <variant><form lang="kqs"><text>masindɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>masindɔn</text></form></variant>
    <variant><form lang="kqs"><text>masindɛ-sindɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>masindɛ-sindɔn</text></form></variant>
    <sense id="masindɛ_2612_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>ancien, d'autrefois ; (kabi masindɛ) depuis toujours ; (Bɛndu Yuu Masindɛ-Sindɔɔ) l'Ancien des jours</text></gloss>
      <gloss lang="en"><text>ancient, of old; (kabi masindɛ) from of old; (Bɛndu Yuu Masindɛ-Sindɔɔ) the Ancient of Days</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adj.) of an earlier time; sìndɔ̀ɔ́ 'old days'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first 1KI.14.30; Childs 2000, p. 335: sìndè</text></form></note>
    <note><form lang="fr"><text>De sindɛ « autrefois ». Kabi masindɛ (1KI.14.30, PSA.74.12) ; dɛnnda viannannda masindɛlan « les mystères des temps anciens » (PSA.78.2) ; pembun masindɔn « les collines antiques » (GEN.49.26) ; tale masindɔɔ « un proverbe ancien » (1SA.24.14) ; Masindɛ-Sindɔɔ (DAN.7.9).</text></form></note>
  </entry>
  <entry id="masini_2613">
    <lexical-unit><form lang="kqs"><text>masini</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="masini_2613_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>machine</text></gloss>
      <gloss lang="en"><text>machine</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 33: masini</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="masini suandaa_2614">
    <lexical-unit><form lang="kqs"><text>masini suandaa</text></form></lexical-unit>
