  <entry id="leemu-leemu_2026">
    <lexical-unit><form lang="kqs"><text>leemu-leemu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>leemu-leemoo</text></form></variant>
    <sense id="leemu-leemu_2026_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souple, flexible, qui plie</text></gloss>
      <gloss lang="en"><text>supple, pliant, bending</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flexibly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.49.24; Childs 2000, p. 228: lɛ́ɛ̀mù</text></form></note>
    <note><form lang="fr"><text>congúla ndɔlan … la co vɔ leemu-leemu « ses bras restent souples » (GEN.49.24) ; tiindan leemu-leemoo « un appui qui plie » (EZK.29.6).</text></form></note>
  </entry>
  <entry id="leendo_2027">
    <lexical-unit><form lang="kqs"><text>leendo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>leenda</text></form></field>
    <sense id="leendo_2027_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>margouillat</text></gloss>
      <gloss lang="en"><text>agama lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gecko, a black lizard</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Leendo; Childs 2000, p. 226: lééŋndó</text></form></note>
    <note><form lang="fr"><text>Le pluriel leenda « lézards » est dans la Bible (LEV.11.29, PRO.30.28).</text></form></note>
  </entry>
  <entry id="lèéŋndé_2028">
    <lexical-unit><form lang="kqs"><text>lèéŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lèéŋndé_2028_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>déchets, gaspillage</text></gloss>
      <gloss lang="en"><text>waste</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 226: lèéŋndé</text></form></note>
  </entry>
  <entry id="lefoo_2029">
    <lexical-unit><form lang="kqs"><text>lefoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefoo_2029_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-père ; (lefu … laandoo) belle-mère</text></gloss>
      <gloss lang="en"><text>father-in-law; (lefu … laandoo) mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.18.1</text></form></note>
  </entry>
  <entry id="lefuo_2030">
    <lexical-unit><form lang="kqs"><text>lefuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lefua</text></form></field>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefuo_2030_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent par alliance : gendre, bru, beau-père, belle-mère</text></gloss>
      <gloss lang="en"><text>in-law: son-in-law, daughter-in-law, father-in-law, mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in-law</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Lefuo; Childs 2000, p. 226: lèfòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale lefu attestée (Jéthro, beau-père de Moïse, Ex 3,1) ; pluriel lefua « gendres » (Gn 19,14). Keita donne aussi Nde lefu « la belle-mère ».</text></form></note>
  </entry>
  <entry id="lèíyó_2031">
    <lexical-unit><form lang="kqs"><text>lèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lèíyó_2031_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'insecte volant (qui pique)</text></gloss>
      <gloss lang="en"><text>kind of flying insect (stings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lèíyó</text></form></note>
  </entry>
  <entry id="lekáá_2032">
    <lexical-unit><form lang="kqs"><text>lekáá</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lekáá_2032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éloignement, exil (o lekáá « au loin, banni, perdu »)</text></gloss>
      <gloss lang="en"><text>absence, exile (o lekáá 'away, banished, lost')</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note><form lang="fr"><text>Simeɔn bɛɛ lo o lekáá « Siméon aussi n'est plus » (Gn 42,36) ; po nɔm co o lekáá-o « ton fils banni » (2 S 14,13).</text></form></note>
  </entry>
  <entry id="lekaando_2033">
    <lexical-unit><form lang="kqs"><text>lekaando</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lekaan</text></form></variant>
    <variant><form lang="kqs"><text>lekaannda</text></form></variant>
    <variant><form lang="kqs"><text>lekaandan</text></form></variant>
    <variant><form lang="kqs"><text>lekaandon</text></form></variant>
    <sense id="lekaando_2033_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>du culte, cultuel</text></gloss>
      <gloss lang="en"><text>of worship, cultic</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first DEU.16.8</text></form></note>
    <note><form lang="fr"><text>baala lekaando « service du culte » (2 R 25,14) ; cuungian lekaando « assemblée solennelle » (Dt 16,8) ; cɛi lekaan « synagogue » (Mt 12,9).</text></form></note>
  </entry>
