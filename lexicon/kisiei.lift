    <sense id="kèlèŋgàà_1535_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>peut-être, probablement</text></gloss>
      <gloss lang="en"><text>perhaps, maybe, probably</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 160: kèlèŋgàà</text></form></note>
  </entry>
  <entry id="keleŋnde_1536">
    <lexical-unit><form lang="kqs"><text>keleŋnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="keleŋnde_1536_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour à fente, tambour-xylophone</text></gloss>
      <gloss lang="en"><text>slit drum, wooden xylophone drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wooden drum: a hollow log with holes, beaten with sticks</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Kelennde; Lexique kissi–français, p. 22: kelennde; Childs 2000, p. 154: kèlèŋndé</text></form></note>
    <note><form lang="fr"><text>ŋ d'après Childs. Lexique kissi–français, p. 22 : kelennde « tambour xylophone ».</text></form></note>
  </entry>
