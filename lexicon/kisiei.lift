    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EXO.39.30; Keita 1979, p. 132: Tendei; Lexique kissi–français, p. 54: tendie; Childs 2000, p. 352: tèndèí</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 54 : tendie « le front » ; tendei « … le front ? ».</text></form></note>
  </entry>
  <entry id="tendei_3985">
    <lexical-unit><form lang="kqs"><text>tendei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="tendei_3985_s1">
