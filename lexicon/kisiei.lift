  <entry id="dunndo_843">
    <lexical-unit><form lang="kqs"><text>dunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dunndo_843_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure (de longueur) ; coude ; coudée (pour mesurer le tissu)</text></gloss>
      <gloss lang="en"><text>measure (of length); elbow; cubit (to measure cloth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 292 occurrences, first GEN.6.15; Lexique kissi–français, p. 14: dunndo</text></form></note>
    <note><form lang="fr"><text>bandei dunndo « coudée » ; buo dunndo « (mesure de) largeur ». Lexique kissi–français, p. 14 : dunndo « le coude ; employé pour mesurer du tissu ».</text></form></note>
  </entry>
  <entry id="duo_844">
