      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>matériau (déchet de fibres) pour faire des sacs ; remède traditionnel</text></gloss>
      <gloss lang="en"><text>material (fibre waste) used for making bags; traditional medicine</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 230: lìlìléŋ</text></form></note>
  </entry>
  <entry id="lilindo_3143">
    <lexical-unit><form lang="kqs"><text>lilindo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lilinda</text></form></field>
    <sense id="lilindo_3143_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau mange-mil</text></gloss>
      <gloss lang="en"><text>seed-eating bird (quelea)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 57: lilindo, pl. lilinda; Sandara Kisia, proverbe 83: lilinda</text></form></note>
    <note><form lang="fr"><text>Paulme : lilindo de pendue « le mange-mil mange du fonio ».</text></form></note>
  </entry>
  <entry id="limba_3144">
    <lexical-unit><form lang="kqs"><text>limba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="limba_3144_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson qui pique (ressemble au bube, en plus petit)</text></gloss>
      <gloss lang="en"><text>stinging fish (like the bube, but smaller)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 57: limba, pl. limba</text></form></note>
    <note><form lang="fr"><text>Paulme : vit dans les fleuves et les marigots.</text></form></note>
  </entry>
  <entry id="lìmbàá_3145">
    <lexical-unit><form lang="kqs"><text>lìmbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lìmbàá_3145_s1">
