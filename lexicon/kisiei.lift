  <entry id="fɛɔ_1113">
    <lexical-unit><form lang="kqs"><text>fɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɔ_1113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut, tache</text></gloss>
      <gloss lang="en"><text>flaw, stain</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 15: fɛɔ</text></form></note>
  </entry>
  <entry id="fɛɛ_1114">
    <lexical-unit><form lang="kqs"><text>fɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛɛ_1114_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en paix, tranquillement ; à l'écart</text></gloss>
      <gloss lang="en"><text>in peace, quietly; aside</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first JOS.6.23; Lexique kissi–français, p. 15: fɛɛ</text></form></note>
    <note><form lang="fr"><text>Kɔnnun a kɔlɲulu fɛɛ « va en paix ».</text></form></note>
  </entry>
  <entry id="fɛ́ɛ́_1115">
    <lexical-unit><form lang="kqs"><text>fɛ́ɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fɛ́ɛ́_1115_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(se reposer) bien, à fond</text></gloss>
      <gloss lang="en"><text>(rest) well, thoroughly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ́ɛ́</text></form></note>
  </entry>
  <entry id="fɛ́ɛ́-fɛ́ɛ́o_1116">
    <lexical-unit><form lang="kqs"><text>fɛ́ɛ́-fɛ́ɛ́o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛ́ɛ́-fɛ́ɛ́o_1116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>douceur ; (diom fɛ́ɛ́-fɛ́ɛ́o) murmure doux</text></gloss>
      <gloss lang="en"><text>gentleness; (diom fɛ́ɛ́-fɛ́ɛ́o) gentle whisper</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.19.12</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀lìá_1117">
    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀lìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fɛ̀ɛ̀lìá_1117_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>utiliser avec soin, peu à peu ; ménager</text></gloss>
      <gloss lang="en"><text>use carefully, bit by bit; husband</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀lìá</text></form></note>
    <note><form lang="fr"><text>Peut-être fɛɛliaa « grappiller » (ISA.24.13, une seule occurrence).</text></form></note>
  </entry>
  <entry id="fɛɛlɔɔ_1118">
    <lexical-unit><form lang="kqs"><text>fɛɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fɛɛlɔɔ_1118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>occasion, prétexte</text></gloss>
      <gloss lang="en"><text>occasion, pretext</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.14.4</text></form></note>
  </entry>
  <entry id="fɛ́ɛ́mbɛ́_1119">
    <lexical-unit><form lang="kqs"><text>fɛ́ɛ́mbɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fɛ́ɛ́mbɛ́_1119_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>jamais</text></gloss>
      <gloss lang="en"><text>never</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ́ɛ́mbɛ́</text></form></note>
    <note><form lang="fr"><text>Composé de fɛ́ɛ́ŋ « toujours » et bɛ́ « pas » ; cf. few … le dans la Bible.</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀mbɛ̂ìyó_1120">
    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀mbɛ̂ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fɛ̀ɛ̀mbɛ̂ìyó_1120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boubou, grande robe traditionnelle (des chefs)</text></gloss>
      <gloss lang="en"><text>traditional gown, robe (worn by chiefs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀mbɛ̂ìyó</text></form></note>
  </entry>
  <entry id="fɛɛn_1121">
    <lexical-unit><form lang="kqs"><text>fɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛɛn_1121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éternité ; (le fɛɛn a fɛɛn) pour toujours</text></gloss>
      <gloss lang="en"><text>eternity; (le fɛɛn a fɛɛn) for ever</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 851 occurrences, first GEN.3.14; Childs 2000, p. 101: fééŋ</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀nɛ̀í_1122">
    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀nɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="fɛ̀ɛ̀nɛ̀í_1122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue malinké, maninka</text></gloss>
      <gloss lang="en"><text>Maninka (Malinke) language</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀nɛ̀í</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀nɛ̀lɛ́ŋ_1123">
    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀nɛ̀lɛ́ŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="fɛ̀ɛ̀nɛ̀lɛ́ŋ_1123_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manières des Mandingues</text></gloss>
      <gloss lang="en"><text>Mandingo ways, manner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀nɛ̀lɛ́ŋ</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀nɛ̀nɔ̀ɔ́_1124">
    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀nɛ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fɛ̀ɛ̀nìá</text></form></field>
    <sense id="fɛ̀ɛ̀nɛ̀nɔ̀ɔ́_1124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Mandingue ; musulman</text></gloss>
      <gloss lang="en"><text>Mandingo person; Muslim</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ̀ɛ̀nɛ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="fɛɛyaa_1125">
    <lexical-unit><form lang="kqs"><text>fɛɛyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>fɛɛya</text></form></variant>
    <sense id="fɛɛyaa_1125_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher</text></gloss>
      <gloss lang="en"><text>clear (land)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear away low bushes</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyaa; Lexique kissi–français, p. 15: fɛɛyaa/ fɛɛya; Childs 2000, p. 102: fèèyàá</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : fɛɛya (JOS 17,15). La Bible a la forme fɛɛya « défricher » (JOS.17.15).</text></form></note>
  </entry>
  <entry id="fɛɛyallo_1126">
    <lexical-unit><form lang="kqs"><text>fɛɛyallo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyallo_1126_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher pour quelqu'un</text></gloss>
      <gloss lang="en"><text>clear land for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyallo; Lexique kissi–français, p. 15: fɛɛyallo/ fɛɛyal</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de fɛɛyaa.</text></form></note>
  </entry>
  <entry id="fɛɛyiaa_1127">
    <lexical-unit><form lang="kqs"><text>fɛɛyiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyiaa_1127_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher en plusieurs endroits</text></gloss>
      <gloss lang="en"><text>clear land in several places</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyiaa; Lexique kissi–français, p. 15: fɛɛyiaa/ fɛɛyia</text></form></note>
    <note><form lang="fr"><text>Pluriel de fɛɛyaa.</text></form></note>
  </entry>
  <entry id="gbó-gbó_1128">
    <lexical-unit><form lang="kqs"><text>gbó-gbó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbó-gbó_1128_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit des pas de quelqu'un qui marche</text></gloss>
      <gloss lang="en"><text>sound of footsteps</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbó-gbó ...</text></form></note>
  </entry>
  <entry id="gbólúŋ-gbólúŋ_1129">
    <lexical-unit><form lang="kqs"><text>gbólúŋ-gbólúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbólúŋ-gbólúŋ_1129_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de va-et-vient (navette du tisserand, clochettes)</text></gloss>
      <gloss lang="en"><text>rattling back and forth (weaver's shuttle, bells)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbólúŋ-gbólúŋ</text></form></note>
  </entry>
  <entry id="gbú-û-ù_1130">
    <lexical-unit><form lang="kqs"><text>gbú-û-ù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbú-û-ù_1130_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de fibre arrachée ; tonnerre lointain</text></gloss>
      <gloss lang="en"><text>sound of fibre being stripped; distant thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbú-û-ù</text></form></note>
  </entry>
  <entry id="gbúŋ-gbúŋ_1131">
    <lexical-unit><form lang="kqs"><text>gbúŋ-gbúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbúŋ-gbúŋ_1131_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit sourd et régulier (pilon, hache, coup sur la tête)</text></gloss>
      <gloss lang="en"><text>steady thumping (pestle, axe, blow on the head)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbúŋ-gbúŋ</text></form></note>
  </entry>
  <entry id="gbɛɛnɛi_1132">
    <lexical-unit><form lang="kqs"><text>gbɛɛnɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="gbɛɛnɛi_1132_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marmite</text></gloss>
      <gloss lang="en"><text>cooking pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Gbèènèi</text></form></note>
  </entry>
  <entry id="ha_1133">
    <lexical-unit><form lang="kqs"><text>ha</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ha_1133_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces…-ci (personnes)</text></gloss>
      <gloss lang="en"><text>these (persons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 358 occurrences, first GEN.7.1; Lexique kissi–français, p. 16: ha; Childs 2000, p. 116: háà</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 16 : ha « ces (pour les choses inanimées) ».</text></form></note>
  </entry>
  <entry id="háá_1134">
    <lexical-unit><form lang="kqs"><text>háá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="háá_1134_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à (ce que)</text></gloss>
      <gloss lang="en"><text>until</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>going on for a long time; until</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1778 occurrences, first GEN.3.17; Lexique kissi–français, p. 16: haa; Childs 2000, p. 116: háá</text></form></note>
  </entry>
  <entry id="haa_1135">
    <lexical-unit><form lang="kqs"><text>haa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>ha</text></form></variant>
    <sense id="haa_1135_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler ses forces ; barrer</text></gloss>
      <gloss lang="en"><text>gather one's strength; bar, block</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: haa/ ha</text></form></note>
    <note><form lang="fr"><text>Lexique : haa/ha. Homographe de háá « jusqu'à » ; à confirmer.</text></form></note>
  </entry>
  <entry id="hààlàá_1136">
    <lexical-unit><form lang="kqs"><text>hààlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hààlàá_1136_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser des tuteurs (pour les plantes grimpantes) ; élever une barricade</text></gloss>
      <gloss lang="en"><text>set up stick frames (for climbing plants); put up a barricade</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: hààlàá</text></form></note>
  </entry>
  <entry id="haalan_1137">
    <lexical-unit><form lang="kqs"><text>haalan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haalan_1137_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pluie</text></gloss>
      <gloss lang="en"><text>rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: haalan; Lexique kissi–français, p. 17: haalan</text></form></note>
    <note><form lang="fr"><text>La Bible emploie piɔɔ pour « pluie » (GEN.7.12). Lexique kissi–français, p. 16-17 : aussi haalaa, halaa « la pluie ».</text></form></note>
  </entry>
  <entry id="háámì_1138">
    <lexical-unit><form lang="kqs"><text>háámì</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="háámì_1138_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à ce que</text></gloss>
      <gloss lang="en"><text>until</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.7.15; Lexique kissi–français, p. 17: haami</text></form></note>
  </entry>
  <entry id="hààŋndó_1139">
    <lexical-unit><form lang="kqs"><text>hààŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hààŋndó_1139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourmi noire à piqûre douloureuse (sur les agrumes)</text></gloss>
      <gloss lang="en"><text>black ant with a painful bite (on citrus trees)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hààŋndó</text></form></note>
  </entry>
  <entry id="haiyɛɔ_1140">
    <lexical-unit><form lang="kqs"><text>haiyɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haiyɛɔ_1140_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bonne chance</text></gloss>
      <gloss lang="en"><text>good luck</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: haiyɛɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi hariyɔɔ « bonne chance » (p. 17).</text></form></note>
  </entry>
  <entry id="hàkátó_1141">
    <lexical-unit><form lang="kqs"><text>hàkátó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàkátó_1141_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>pardon, excusez-moi</text></gloss>
      <gloss lang="en"><text>excuse me</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàkátó</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="hakio_1142">
    <lexical-unit><form lang="kqs"><text>hakio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hakilan</text></form></field>
    <variant><form lang="kqs"><text>haki</text></form></variant>
    <variant><form lang="kqs"><text>hakila</text></form></variant>
    <sense id="hakio_1142_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>péché, faute</text></gloss>
      <gloss lang="en"><text>sin, wrongdoing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pardon, forgiveness; sin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 365 occurrences, first GEN.4.7; Lexique kissi–français, p. 17: hakio; Childs 2000, p. 117: hákìó</text></form></note>
  </entry>
  <entry id="hàkɛ́ìyó_1143">
    <lexical-unit><form lang="kqs"><text>hàkɛ́ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hàkɛ́ìyó_1143_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chance, sort ; malchance</text></gloss>
      <gloss lang="en"><text>luck, fortune; misfortune</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàkɛ́ìyó</text></form></note>
  </entry>
  <entry id="hala_1144">
    <lexical-unit><form lang="kqs"><text>hala</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>halaa</text></form></field>
    <sense id="hala_1144_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dieu, divinité</text></gloss>
      <gloss lang="en"><text>god, deity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6548 occurrences, first GEN.1; Childs 2000, p. 117: hálà</text></form></note>
    <note><form lang="fr"><text>Nom commun : halaa celen « d'autres dieux » (Ex 20,3), hala naa « notre dieu ». Avec une majuscule, Hala est le nom de Dieu. Childs : emprunt à l'arabe (Allah), surtout en kissi de Guinée.</text></form></note>
  </entry>
  <entry id="Hala_1145">
    <lexical-unit><form lang="kqs"><text>Hala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="Hala_1145_s1">
      <grammatical-info value="Proper Noun"/>
      <gloss lang="fr"><text>Dieu</text></gloss>
      <gloss lang="en"><text>God</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6548 occurrences, first GEN.1; Keita 1979, p. 150: Hala; Lexique kissi–français, p. 17: Hala; Childs 2000, p. 117: hálà</text></form></note>
  </entry>
  <entry id="halaa_1146">
    <lexical-unit><form lang="kqs"><text>halaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halaa_1146_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel</text></gloss>
      <gloss lang="en"><text>sky</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cloud, sky, heavens; also the name of a spirit</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 154: Halaa; Lexique kissi–français, p. 17: halaa; Childs 2000, p. 117: hálàá</text></form></note>
    <note><form lang="fr"><text>La Bible emploie halataala pour « ciel » (GEN.1.8) ; halaa y est le pluriel homonyme de hala « dieu » (1CH.16.26).</text></form></note>
  </entry>
  <entry id="halacucaa_1147">
    <lexical-unit><form lang="kqs"><text>halacucaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halacucaa_1147_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bruine, pluie fine</text></gloss>
      <gloss lang="en"><text>drizzle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halacucaa</text></form></note>
  </entry>
  <entry id="hàlàkàá_1148">
    <lexical-unit><form lang="kqs"><text>hàlàkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàlàkàá_1148_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>construire, réparer grossièrement, à la va-vite</text></gloss>
      <gloss lang="en"><text>build or fix roughly, carelessly</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàlàkàá</text></form></note>
  </entry>
  <entry id="halakio_1149">
    <lexical-unit><form lang="kqs"><text>halakio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>halaki</text></form></variant>
    <sense id="halakio_1149_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>périr ; (nom) destruction</text></gloss>
      <gloss lang="en"><text>perish; (noun) destruction</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halakio/ halaki</text></form></note>
  </entry>
  <entry id="halataalaa_1150">
    <lexical-unit><form lang="kqs"><text>halataalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>halataala</text></form></variant>
    <sense id="halataalaa_1150_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel ; les cieux ; paradis</text></gloss>
      <gloss lang="en"><text>sky; heaven; paradise</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
      <trait name="semantic-domain-ddp4" value="4.9.6 Heaven, hell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 176 occurrences, first GEN.1; Lexique kissi–français, p. 17: halatala</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : halatala « le paradis ».</text></form></note>
  </entry>
  <entry id="háléé_1151">
    <lexical-unit><form lang="kqs"><text>háléé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háléé_1151_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(fouetter) à fond</text></gloss>
      <gloss lang="en"><text>(whip) thoroughly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: háléé</text></form></note>
  </entry>
  <entry id="hali_1152">
    <lexical-unit><form lang="kqs"><text>hali</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hali_1152_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>même ; même si</text></gloss>
      <gloss lang="en"><text>even; even if</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'only, just'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 484 occurrences, first GEN.2.5; Lexique kissi–français, p. 17: hali; Childs 2000, p. 118: hálì</text></form></note>
  </entry>
  <entry id="haliko_1153">
    <lexical-unit><form lang="kqs"><text>haliko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haliko_1153_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>afin que</text></gloss>
      <gloss lang="en"><text>so that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 956 occurrences, first GEN.1.29; Lexique kissi–français, p. 17: halako</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : halako « pour que, afin que ».</text></form></note>
  </entry>
  <entry id="halimaa_1154">
    <lexical-unit><form lang="kqs"><text>halimaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="halimaa_1154_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épidémie, peste (nàà halimaa)</text></gloss>
      <gloss lang="en"><text>epidemic, pestilence (nàà halimaa)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first EXO.9</text></form></note>
  </entry>
  <entry id="haliyɛnɛ_1155">
    <lexical-unit><form lang="kqs"><text>haliyɛnɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haliyɛnɛ_1155_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paradis</text></gloss>
      <gloss lang="en"><text>paradise</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.6 Heaven, hell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heaven</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LUK.23.43; Keita 1979, p. 150: Haliyènè; Lexique kissi–français, p. 17: haliyɛnɛ; Childs 2000, p. 121: hècɛ́nɛ̀</text></form></note>
  </entry>
  <entry id="halumɛtio_1156">
    <lexical-unit><form lang="kqs"><text>halumɛtio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halumɛtio_1156_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>allumette</text></gloss>
      <gloss lang="en"><text>match (for fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halumɛtio</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="halɛiyo_1157">
    <lexical-unit><form lang="kqs"><text>halɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halɛiyo_1157_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>samedi</text></gloss>
      <gloss lang="en"><text>Saturday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Halèiyo; Lexique kissi–français, p. 17: halɛiyo</text></form></note>
  </entry>
  <entry id="hande_1158">
    <lexical-unit><form lang="kqs"><text>hande</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hande_1158_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>pour que, afin que</text></gloss>
      <gloss lang="en"><text>so that, in order that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hande</text></form></note>
  </entry>
  <entry id="handullo_1159">
    <lexical-unit><form lang="kqs"><text>handullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="handullo_1159_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouclier</text></gloss>
      <gloss lang="en"><text>shield</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Handullo; Lexique kissi–français, p. 17: handullo</text></form></note>
    <note><form lang="fr"><text>La Bible dit kɔ̀ɔ̀ cɔwvo pour « bouclier » (1 S 17,7 ; Ep 6,16).</text></form></note>
  </entry>
  <entry id="handun_1160">
    <lexical-unit><form lang="kqs"><text>handun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>handɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>handɔn</text></form></variant>
    <sense id="handun_1160_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre sur soi ; (se) poser</text></gloss>
      <gloss lang="en"><text>put on oneself; set oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.9.23</text></form></note>
    <note><form lang="fr"><text>Moyen de handɔɔ « mettre ».</text></form></note>
  </entry>
  <entry id="handɔɔ_1161">
    <lexical-unit><form lang="kqs"><text>handɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>handu</text></form></variant>
    <variant><form lang="kqs"><text>handunin</text></form></variant>
    <sense id="handɔɔ_1161_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, poser ; établir (sur) ; (handu … lecoo) mettre sur, ajouter, accumuler</text></gloss>
      <gloss lang="en"><text>put, lay; set (over); (handu … lecoo) put on top, add, pile up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 185 occurrences, first GEN.11.4; Lexique kissi–français, p. 17: handɔɔ/ handu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : handɔɔ lecoo « mettre sur, placer sur, ajouter, accumuler » (cf. handu lecoo, 2KI.5.23) ; handun leco, handɔnndo leco « s'accumuler » ; handɔɔ aussi « plus ».</text></form></note>
  </entry>
  <entry id="hangullo_1162">
    <lexical-unit><form lang="kqs"><text>hangullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hangul</text></form></variant>
    <variant><form lang="kqs"><text>hangulu</text></form></variant>
    <sense id="hangullo_1162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaleur</text></gloss>
      <gloss lang="en"><text>heat</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heat, steam</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.8.22; Lexique kissi–français, p. 17: hangullo; Childs 2000, p. 118: hàŋgúlló</text></form></note>
  </entry>
  <entry id="hangɔɔ_1163">
    <lexical-unit><form lang="kqs"><text>hangɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hangu</text></form></variant>
    <sense id="hangɔɔ_1163_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se chauffer</text></gloss>
      <gloss lang="en"><text>warm oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be or become warm; warm oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first ISA.44.15; Lexique kissi–français, p. 17: hangɔɔ; Childs 2000, p. 118: hàŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="hantenge_1164">
    <lexical-unit><form lang="kqs"><text>hantenge</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hantenge_1164_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>pardon, excusez-moi</text></gloss>
      <gloss lang="en"><text>sorry, excuse me</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hantenge</text></form></note>
  </entry>
  <entry id="hau_1165">
    <lexical-unit><form lang="kqs"><text>hau</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hau_1165_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aujourd'hui, maintenant</text></gloss>
      <gloss lang="en"><text>today, now</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 436 occurrences, first GEN.4.11; Lexique kissi–français, p. 17: hau; Childs 2000, p. 118: háù</text></form></note>
  </entry>
  <entry id="háú-hàù_1166">
    <lexical-unit><form lang="kqs"><text>háú-hàù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háú-hàù_1166_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sensation de brûlure, de picotement (plaie, alcool sur une coupure)</text></gloss>
      <gloss lang="en"><text>stinging, burning sensation (sore, alcohol on a cut)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: háú-hàù</text></form></note>
    <note><form lang="fr"><text>Distinct de hau-hau « aujourd'hui même » de la Bible.</text></form></note>
  </entry>
  <entry id="hàùdíí_1167">
    <lexical-unit><form lang="kqs"><text>hàùdíí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàùdíí_1167_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ce matin</text></gloss>
      <gloss lang="en"><text>this morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: hàùdíí</text></form></note>
    <note><form lang="fr"><text>Composé de háù « aujourd'hui » et ɗílɛ́ŋ « matin ».</text></form></note>
  </entry>
  <entry id="haw_1168">
    <lexical-unit><form lang="kqs"><text>haw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haw_1168_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aujourd'hui</text></gloss>
      <gloss lang="en"><text>today</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>today; now, right away; again</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.33.15; Keita 1979, p. 152: Haw; Childs 2000, p. 118: háù</text></form></note>
  </entry>
  <entry id="haw ba_1169">
    <lexical-unit><form lang="kqs"><text>haw ba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haw ba_1169_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accabler ; être incapable (à cause des circonstances)</text></gloss>
      <gloss lang="en"><text>overwhelm; be unable (because of circumstances)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: haw ba</text></form></note>
    <note><form lang="fr"><text>De hawvo « bloquer ».</text></form></note>
  </entry>
  <entry id="háwèìyó_1170">
    <lexical-unit><form lang="kqs"><text>háwèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="háwèìyó_1170_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>heure</text></gloss>
      <gloss lang="en"><text>hour</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háwèìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="háwèlè-hàwèlè_1171">
    <lexical-unit><form lang="kqs"><text>háwèlè-hàwèlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háwèlè-hàwèlè_1171_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>rugueux, bosselé ; brûlant</text></gloss>
      <gloss lang="en"><text>rough, bumpy; burning hot</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háwèlè-hàwèlè</text></form></note>
  </entry>
  <entry id="hawnɔnndo_1172">
    <lexical-unit><form lang="kqs"><text>hawnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hawnun</text></form></variant>
    <sense id="hawnɔnndo_1172_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se bloquer ; se porter garant</text></gloss>
      <gloss lang="en"><text>get stuck; stand surety</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.6; Keita 1979, p. 114: Hawnönndo; Lexique kissi–français, p. 17: hawnɔnndo/ hawnun, hewnun; Childs 2000, p. 119: hàùnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hawvo ; hawnun « se porter caution » (PRO 6,1).</text></form></note>
  </entry>
  <entry id="hawvo_1173">
    <lexical-unit><form lang="kqs"><text>hawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>haw</text></form></variant>
    <variant><form lang="kqs"><text>hawnin</text></form></variant>
    <sense id="hawvo_1173_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bloquer, coincer, presser</text></gloss>
      <gloss lang="en"><text>block, trap, press</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck or trapped</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.27.3; Keita 1979, p. 114: Hawvo; Lexique kissi–français, p. 17: hawvo/ haw, hew; Childs 2000, p. 119: hàùwó</text></form></note>
    <note><form lang="fr"><text>haw : presser (les raisins, GEN 40,11) ; hawnin : être pris (au piège, ISA 24,18). Lexique kissi–français, p. 17 : hawvo/haw, hew « bloquer » (hew au négatif).</text></form></note>
  </entry>
  <entry id="hàyàá_1174">
    <lexical-unit><form lang="kqs"><text>hàyàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàyàá_1174_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>repasser (le linge)</text></gloss>
      <gloss lang="en"><text>iron (clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: hàyàá</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="háyèìyé_1175">
    <lexical-unit><form lang="kqs"><text>háyèìyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="háyèìyé_1175_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer à repasser</text></gloss>
      <gloss lang="en"><text>(clothes) iron</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háyèìyé</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="hâŋndí_1176">
    <lexical-unit><form lang="kqs"><text>hâŋndí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hâŋndí_1176_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en arrachant, d'un geste vif (saisir)</text></gloss>
      <gloss lang="en"><text>snatching (take quickly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: hâŋndí</text></form></note>
  </entry>
  <entry id="he_1177">
    <lexical-unit><form lang="kqs"><text>he</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="he_1177_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe i)</text></gloss>
      <gloss lang="en"><text>this (i class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 213 occurrences, first GEN.9.17; Lexique kissi–français, p. 17: he; Childs 2000, p. 120: héì</text></form></note>
  </entry>
  <entry id="hébè_1178">
    <lexical-unit><form lang="kqs"><text>hébè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hébè_1178_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en filant à toute allure (passer)</text></gloss>
      <gloss lang="en"><text>zooming by (pass)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: hébè</text></form></note>
  </entry>
  <entry id="heelanndo_1179">
    <lexical-unit><form lang="kqs"><text>heelanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelanndo_1179_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orgueil, fierté ; ce dont on se glorifie</text></gloss>
      <gloss lang="en"><text>pride, haughtiness; one's glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.17.6</text></form></note>
    <note><form lang="fr"><text>Dérivé de heeloo « lever ». tofa heelanndo « regard hautain » (Pr 21,4).</text></form></note>
  </entry>
  <entry id="heeloo_1180">
    <lexical-unit><form lang="kqs"><text>heeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <variant><form lang="kqs"><text>heelunin</text></form></variant>
    <variant><form lang="kqs"><text>heelaa</text></form></variant>
    <sense id="heeloo_1180_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever</text></gloss>
      <gloss lang="en"><text>lift up, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>raise; praise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first 2SA.22.42; Childs 2000, p. 120: hèèlòó</text></form></note>
  </entry>
  <entry id="heeluo_1181">
    <lexical-unit><form lang="kqs"><text>heeluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <sense id="heeluo_1181_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever, faire monter</text></gloss>
      <gloss lang="en"><text>lift, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put up, raise, lift, erect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Heeluo; Lexique kissi–français, p. 17: heeluo/ heelu; Childs 2000, p. 119: hèèlòó</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : heelu (lever les yeux, la main), heelunin, heelun (GEN 5,24). Lexique kissi–français, p. 17 : aussi heluo/helu « soulever, faire monter, se lever ».</text></form></note>
  </entry>
  <entry id="heelɔnndo_1182">
    <lexical-unit><form lang="kqs"><text>heelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelɔnndo_1182_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'élever, s'enorgueillir ; (sondoo heelɔnndo) parler avec arrogance</text></gloss>
      <gloss lang="en"><text>exalt oneself, be proud; (sondoo heelɔnndo) speak arrogantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.73.9; Lexique kissi–français, p. 17: helɔnndɔ/ helun</text></form></note>
    <note><form lang="fr"><text>Moyen de heeloo « lever ». Lexique kissi–français, p. 17 : helɔnndɔ/helun « fier ».</text></form></note>
  </entry>
  <entry id="héèyó_1183">
    <lexical-unit><form lang="kqs"><text>héèyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="héèyó_1183_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, parc à bêtes</text></gloss>
      <gloss lang="en"><text>animal pen, enclosure</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: héèyó</text></form></note>
  </entry>
  <entry id="hèèŋúúwó_1184">
    <lexical-unit><form lang="kqs"><text>hèèŋúúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hèèŋúúwó_1184_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>carapace, coquille (d'escargot)</text></gloss>
      <gloss lang="en"><text>carapace, shell (e.g. of a snail)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: hèèŋúúwó</text></form></note>
  </entry>
  <entry id="helnɔnndo_1185">
    <lexical-unit><form lang="kqs"><text>helnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>helnɔn</text></form></variant>
    <sense id="helnɔnndo_1185_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter, s'élever (au ciel)</text></gloss>
      <gloss lang="en"><text>go up, ascend, rise (into the sky)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>climb, ascend</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.13.20; Childs 2000, p. 120: hèlnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de helɔɔ « monter ». mɛlɛkanɔ Hala-o helnɔnndo coocoo o yelenyelen kon nin « l'ange de Dieu montait dans la flamme » (JDG.13.20) ; sunsun i co helnɔn « maintenant je m'élève » (ISA.33.10).</text></form></note>
  </entry>
  <entry id="hèlùlló_1186">
    <lexical-unit><form lang="kqs"><text>hèlùlló</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hèlùlló_1186_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gagner, prendre (qqch) à qqn (dans une dispute)</text></gloss>
      <gloss lang="en"><text>win (something) from someone (in a contest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: hèlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hìɔ̀lɔ̀ɔ́ (hiɔlɔɔ dans le lexique).</text></form></note>
  </entry>
  <entry id="helɔɔ_1187">
    <lexical-unit><form lang="kqs"><text>helɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hel</text></form></variant>
    <variant><form lang="kqs"><text>helnin</text></form></variant>
    <sense id="helɔɔ_1187_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter ; hauteur</text></gloss>
      <gloss lang="en"><text>go up, climb; height</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>climb, go up, rise; also mount, breed (animals)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.6.16; Lexique kissi–français, p. 17: helɔɔ/ hel; Childs 2000, p. 120: hèlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="hemndo_1188">
    <lexical-unit><form lang="kqs"><text>hemndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hemndan</text></form></field>
    <sense id="hemndo_1188_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gourde, outre</text></gloss>
      <gloss lang="en"><text>gourd, skin bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gourd for keeping oil or wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.6.19; Keita 1979, p. 139: Hemndo; Lexique kissi–français, p. 17: hemndo; Childs 2000, p. 120: hěmndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mɔiyan hemndo « une outre de vin ».</text></form></note>
  </entry>
  <entry id="hendullo_1189">
    <lexical-unit><form lang="kqs"><text>hendullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hendul</text></form></variant>
    <variant><form lang="kqs"><text>hendulun</text></form></variant>
    <sense id="hendullo_1189_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner (un ordre) à ; tendre (un piège) à</text></gloss>
      <gloss lang="en"><text>give (an order) to; set (a snare) for</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put or place something for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.28.9; Childs 2000, p. 120: hèndùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de handɔɔ « mettre ». hendul … tɔŋndo « ordonner » ; yaŋɔɔlen hendullo « tendre un piège ».</text></form></note>
  </entry>
  <entry id="hengen_1190">
    <lexical-unit><form lang="kqs"><text>hengen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hengen_1190_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup</text></gloss>
      <gloss lang="en"><text>a lot, much</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hengen</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi hem « beaucoup » (p. 17), homographe d'un mot de la Bible de sens différent.</text></form></note>
  </entry>
  <entry id="héú_1191">
    <lexical-unit><form lang="kqs"><text>héú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="héú_1191_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très gros, énorme</text></gloss>
      <gloss lang="en"><text>very big, enormous</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: héú</text></form></note>
  </entry>
  <entry id="héŋbéndéŋ_1192">
    <lexical-unit><form lang="kqs"><text>héŋbéndéŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="héŋbéndéŋ_1192_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en tombant en morceaux, en se démantelant</text></gloss>
      <gloss lang="en"><text>falling apart, collapsing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: héŋbéndéŋ</text></form></note>
  </entry>
  <entry id="héŋgóó_1193">
    <lexical-unit><form lang="kqs"><text>héŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="héŋgóó_1193_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine haute (ancienne)</text></gloss>
      <gloss lang="en"><text>(old-time) high-piled female hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: héŋgóó</text></form></note>
  </entry>
  <entry id="hèŋgúúwé_1194">
    <lexical-unit><form lang="kqs"><text>hèŋgúúwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="hèŋgúúwé_1194_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à graines blanches ou jaunes comestibles (cuisine)</text></gloss>
      <gloss lang="en"><text>plant with edible white or yellow seeds (used in cooking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: hèŋgúúwé</text></form></note>
  </entry>
  <entry id="hìà-hìà_1195">
    <lexical-unit><form lang="kqs"><text>hìà-hìà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìà-hìà_1195_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>rire (ha ha)</text></gloss>
      <gloss lang="en"><text>laughing (ha-ha)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 123: hìà-hìà</text></form></note>
  </entry>
  <entry id="hìàánànàá_1196">
    <lexical-unit><form lang="kqs"><text>hìàánànàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hìàánànàá_1196_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>démarche chancelante, titubement</text></gloss>
      <gloss lang="en"><text>unsteadiness, reeling</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 123: hìàánànàá</text></form></note>
  </entry>
  <entry id="hialu_1197">
    <lexical-unit><form lang="kqs"><text>hialu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hialun</text></form></variant>
    <variant><form lang="kqs"><text>hialunin</text></form></variant>
    <sense id="hialu_1197_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dérober, enlever par ruse ; s'échapper, disparaître</text></gloss>
      <gloss lang="en"><text>take by stealth; slip away, disappear</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.27.35</text></form></note>
  </entry>
  <entry id="hianndo_1198">
    <lexical-unit><form lang="kqs"><text>hianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hian</text></form></variant>
    <sense id="hianndo_1198_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>montrer sa préférence</text></gloss>
      <gloss lang="en"><text>show preference</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hianndo/ hian</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi le redoublé hiahianndo/hiahian, même sens.</text></form></note>
  </entry>
  <entry id="hiawnanndo_1199">
    <lexical-unit><form lang="kqs"><text>hiawnanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hiawnannda</text></form></field>
    <variant><form lang="kqs"><text>hiavannda</text></form></variant>
    <sense id="hiawnanndo_1199_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passant, voyageur ; étranger de passage</text></gloss>
      <gloss lang="en"><text>passer-by, traveller; sojourner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.39.13; Lexique kissi–français, p. 60: vana havanndo</text></form></note>
    <note><form lang="fr"><text>Dérivé de hiovɔɔ « passer » : vanaa hiawnannda « les passants, les étrangers ». Lexique kissi–français, p. 60 : vana havanndo « un passant ».</text></form></note>
  </entry>
  <entry id="híàŋ-híàŋ_1200">
    <lexical-unit><form lang="kqs"><text>híàŋ-híàŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="híàŋ-híàŋ_1200_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mouvement mou et désarticulé (ivrogne qui titube)</text></gloss>
      <gloss lang="en"><text>floppy, loose-jointed movement (a reeling drunk)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 124: híàŋ-híàŋ</text></form></note>
  </entry>
  <entry id="hiilaa_1201">
    <lexical-unit><form lang="kqs"><text>hiilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiila</text></form></variant>
    <variant><form lang="kqs"><text>hiiliaa</text></form></variant>
    <sense id="hiilaa_1201_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lamenter, pousser des cris ; rugir</text></gloss>
      <gloss lang="en"><text>wail, lament; roar</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hiccup; (plural hììlíá) sob or weep quietly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.21.16; Childs 2000, p. 124: hììlàá</text></form></note>
    <note><form lang="fr"><text>hiiliaa hiko-hiko a caŋndo « sangloter en pleurant » (Rt 1,9).</text></form></note>
  </entry>
  <entry id="hiiloo_1202">
    <lexical-unit><form lang="kqs"><text>hiiloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluunin</text></form></variant>
    <sense id="hiiloo_1202_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>secouer, agiter, ébranler</text></gloss>
      <gloss lang="en"><text>shake, toss, move</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake (transitive)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 2KI.19.21; Childs 2000, p. 124: hììlùùwó</text></form></note>
    <note><form lang="fr"><text>bolle hiiloo « hocher la tête » ; hiiluu (pluriel) « remuer, ébranler » : vana-vana hiiluu suei le (Gn 41,44).</text></form></note>
  </entry>
  <entry id="hiilɔnndo_1203">
    <lexical-unit><form lang="kqs"><text>hiilɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilun</text></form></variant>
    <variant><form lang="kqs"><text>hiilunnin</text></form></variant>
    <sense id="hiilɔnndo_1203_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trembler, être ébranlé ; être troublé</text></gloss>
      <gloss lang="en"><text>tremble, be shaken; be troubled</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first PSA.46.7; Childs 2000, p. 124: hììlɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiiloo. kɔlta hiilun niaa nin le « ne soyez pas troublés » (Gn 45,5).</text></form></note>
  </entry>
  <entry id="hiilɛi_1204">
    <lexical-unit><form lang="kqs"><text>hiilɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hiilɛi_1204_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fureur, colère violente</text></gloss>
      <gloss lang="en"><text>fury, rage</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 1SA.2.10</text></form></note>
  </entry>
  <entry id="hììndìndòó_1205">
    <lexical-unit><form lang="kqs"><text>hììndìndòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hììndìndòó_1205_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enfler, gonfler</text></gloss>
      <gloss lang="en"><text>swell up</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 124: hììndìndòó</text></form></note>
  </entry>
  <entry id="hiiyo_1206">
    <lexical-unit><form lang="kqs"><text>hiiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hiiyo_1206_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écume</text></gloss>
      <gloss lang="en"><text>foam</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.49.4; Childs 2000, p. 125: hìíyó</text></form></note>
  </entry>
  <entry id="hììyó_1207">
    <lexical-unit><form lang="kqs"><text>hììyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hììyó_1207_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire place à qqn, laisser passer</text></gloss>
      <gloss lang="en"><text>make room for someone, let pass</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hììyó</text></form></note>
  </entry>
  <entry id="hìíyó_1208">
    <lexical-unit><form lang="kqs"><text>hìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hìíyó_1208_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>buffle</text></gloss>
      <gloss lang="en"><text>buffalo, bush cow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hìíyó</text></form></note>
  </entry>
  <entry id="hiko-hiko_1209">
    <lexical-unit><form lang="kqs"><text>hiko-hiko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiko-hiko_1209_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(pleurer) en sanglotant</text></gloss>
      <gloss lang="en"><text>(weep) sobbing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.42.24</text></form></note>
  </entry>
  <entry id="hílì-hìlì_1210">
    <lexical-unit><form lang="kqs"><text>hílì-hìlì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hílì-hìlì_1210_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>grumeleux, épais</text></gloss>
      <gloss lang="en"><text>lumpy, thick</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hílì-hìlì</text></form></note>
    <note><form lang="fr"><text>La Bible a hili-hili (PSA.55.22) dans un sens apparemment différent (« doux, onctueux »).</text></form></note>
  </entry>
  <entry id="hilihiliei_1211">
    <lexical-unit><form lang="kqs"><text>hilihiliei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="hilihiliei_1211_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hoquet</text></gloss>
      <gloss lang="en"><text>hiccup</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>to hiccup; to sob</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Hilihiliei; Lexique kissi–français, p. 18: hilihiliei; Childs 2000, p. 124: hììlàá</text></form></note>
  </entry>
  <entry id="hìlló_1212">
    <lexical-unit><form lang="kqs"><text>hìlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hìlló_1212_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière (en champignon)</text></gloss>
      <gloss lang="en"><text>(mushroom-shaped) termite mound</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hìlló</text></form></note>
  </entry>
  <entry id="hiluan_1213">
    <lexical-unit><form lang="kqs"><text>hiluan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiluan_1213_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>envie, convoitise (de nourriture, de viande), appétit</text></gloss>
      <gloss lang="en"><text>craving (for food, meat), appetite</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greed, excessive appetite (esp. for meat and fish)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.12.20; Lexique kissi–français, p. 18: hiruan; Childs 2000, p. 125: hìlùáŋ</text></form></note>
    <note><form lang="fr"><text>te hiluan ma bii pɛ niaa le vision dioo « si tu as envie de manger de la viande » (DEU.12.20) ; ma soli nda hiluan « assouvir l'appétit (des lionceaux) » (JOB.38.39). Lexique kissi–français, p. 18 : hiruan « le désir de la viande ».</text></form></note>
  </entry>
  <entry id="hilul_1214">
    <lexical-unit><form lang="kqs"><text>hilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hilul_1214_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>haleter, être hors d'haleine ; être bouleversé, trembler</text></gloss>
      <gloss lang="en"><text>pant, be out of breath; be troubled, tremble</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.10.5; Lexique kissi–français, p. 18: hirullo/ hirul</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hirullo/hirul « trembler avec les armes ; haleter, essoufflé ». La forme longue hilullo n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="hiluo_1215">
    <lexical-unit><form lang="kqs"><text>hiluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hilu</text></form></variant>
    <sense id="hiluo_1215_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>secouer, agiter</text></gloss>
      <gloss lang="en"><text>shake, wave</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hiruo/ hiru</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hiruo/hiru.</text></form></note>
  </entry>
  <entry id="hindɔɔ_1216">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hindu</text></form></variant>
    <variant><form lang="kqs"><text>hindunin</text></form></variant>
    <sense id="hindɔɔ_1216_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, grandir ; enfler, grossir</text></gloss>
      <gloss lang="en"><text>grow, grow up; swell, grow fat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grow, mature; also swell, bloat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Lexique kissi–français, p. 18: hindɔɔ/ hindu; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le nom verbal hindɔɔ « croissance » a sa propre entrée.</text></form></note>
  </entry>
  <entry id="hindɔɔ_1217">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hindɔɔ_1217_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>furoncle ; croissance, fait de pousser</text></gloss>
      <gloss lang="en"><text>boil; growth, growing</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boil, swelling, lump, sore; growing up, coming to maturity</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Keita 1979, p. 161: Hindöö; Lexique kissi–français, p. 18: hinndɔɔ; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « le furoncle », confirmé par Childs ; dans la Bible, hindɔɔ « pousser, croissance » (Nb 6,5 ; Ex 10,5). Lexique kissi–français, p. 18 : hinndɔɔ « le furoncle, l'éruption, l'enflure ».</text></form></note>
  </entry>
  <entry id="hini_1218">
    <lexical-unit><form lang="kqs"><text>hini</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hini_1218_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être couché, se coucher</text></gloss>
      <gloss lang="en"><text>lie, lie down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lie down, rest, sleep</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 124 occurrences, first GEN.9.16; Lexique kissi–français, p. 18: hinie/ hini; Childs 2000, p. 126: hìníláŋ</text></form></note>
  </entry>
  <entry id="hinia_1219">
    <lexical-unit><form lang="kqs"><text>hinia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hinilan</text></form></field>
    <sense id="hinia_1219_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lit, couche</text></gloss>
      <gloss lang="en"><text>bed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.24.31</text></form></note>
    <note><form lang="fr"><text>Lié à hini « être couché ».</text></form></note>
  </entry>
  <entry id="hinul_1220">
    <lexical-unit><form lang="kqs"><text>hinul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hinul_1220_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer, faire la guerre à (… a cɔwvo)</text></gloss>
      <gloss lang="en"><text>attack, wage war on (… a cɔwvo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.31.52</text></form></note>
  </entry>
  <entry id="hinullo_1221">
    <lexical-unit><form lang="kqs"><text>hinullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hinul</text></form></variant>
    <variant><form lang="kqs"><text>hinulnin</text></form></variant>
    <sense id="hinullo_1221_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir contre, s'avancer vers ; menacer</text></gloss>
      <gloss lang="en"><text>come against, advance on; threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.14.10; Keita 1979, p. 110: Hinullo; Lexique kissi–français, p. 18: hinullo/ hinul</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hunɔɔ (radical négatif hin). Dans la Bible : « marcher contre » (EXO 14,10), « tourner sa face contre » (LEV 20,6).</text></form></note>
  </entry>
  <entry id="hiovɔɔ_1222">
    <lexical-unit><form lang="kqs"><text>hiovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiow</text></form></variant>
    <variant><form lang="kqs"><text>hiaw</text></form></variant>
    <variant><form lang="kqs"><text>hiw</text></form></variant>
    <variant><form lang="kqs"><text>hiawnin</text></form></variant>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <variant><form lang="kqs"><text>hiownun</text></form></variant>
    <sense id="hiovɔɔ_1222_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, dépasser ; dépasser, surpasser</text></gloss>
      <gloss lang="en"><text>pass, surpass ; pass; exceed, surpass</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go by, pass</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.4.3; Keita 1979, p. 115: Hiowvöö; Lexique kissi–français, p. 18: hiovɔɔ/ hiow, hiw, hiaw; Childs 2000, p. 127: hìòùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit hiowvöö ; la Bible écrit hiovɔɔ. hiw, hiwnin : radical négatif (GEN 6,3 ; MAT 24,34). hiow … vaa « plus que » (comparatif). Lexique kissi–français, p. 18-19 : aussi hiɔw « plus » ; hovɔɔ « passer, dépasser ».</text></form></note>
  </entry>
  <entry id="hiownɔnndo_1223">
    <lexical-unit><form lang="kqs"><text>hiownɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiownɔn</text></form></variant>
    <sense id="hiownɔnndo_1223_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, s'écouler (temps) ; passer (en chemin)</text></gloss>
      <gloss lang="en"><text>pass, go by (time); pass by</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pass (middle)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JOB.11.10; Childs 2000, p. 127: hìòùnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiovɔɔ « passer ». Palɛi nii co hiownɔnndo maa vundule icɔl « mes jours passent comme l'ombre du soir » (PSA.102.12) ; o hiownɔn nin « en passant » (1CO.16.7).</text></form></note>
  </entry>
  <entry id="hisɔp_1224">
    <lexical-unit><form lang="kqs"><text>hisɔp</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hisɔp_1224_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hysope</text></gloss>
      <gloss lang="en"><text>hyssop</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.12.22</text></form></note>
  </entry>
  <entry id="hiuo_1225">
    <lexical-unit><form lang="kqs"><text>hiuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hiu</text></form></variant>
    <sense id="hiuo_1225_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer ; interpréter</text></gloss>
      <gloss lang="en"><text>pass; interpret</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hiuo/ hiu</text></form></note>
    <note><form lang="fr"><text>Sans doute apparenté à hiovɔɔ « passer, dépasser ».</text></form></note>
  </entry>
  <entry id="hivi_1226">
    <lexical-unit><form lang="kqs"><text>hivi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <sense id="hivi_1226_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, livrer, remettre</text></gloss>
      <gloss lang="en"><text>hand over, deliver to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lift over; circumcise; translate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.16.3; Childs 2000, p. 125: hììwìó</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ « passer ».</text></form></note>
  </entry>
  <entry id="hivihivio_1227">
    <lexical-unit><form lang="kqs"><text>hivihivio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hivihivio_1227_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer plusieurs fois</text></gloss>
      <gloss lang="en"><text>make pass repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Hivihivio; Lexique kissi–français, p. 18: hivihivio/ hivihivi</text></form></note>
    <note><form lang="fr"><text>Redoublement de hivio.</text></form></note>
  </entry>
  <entry id="hivio_1228">
    <lexical-unit><form lang="kqs"><text>hivio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivi</text></form></variant>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <variant><form lang="kqs"><text>hivin</text></form></variant>
    <sense id="hivio_1228_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer</text></gloss>
      <gloss lang="en"><text>make pass, send ahead</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first JOB.18.19; Keita 1979, p. 110: Hivio; Lexique kissi–français, p. 18: hivio/ hivi</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ ; vana hivia isɔɔ « interprète » (GEN 42,23).</text></form></note>
  </entry>
  <entry id="hiw_1229">
    <lexical-unit><form lang="kqs"><text>hiw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <sense id="hiw_1229_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépasser (une limite)</text></gloss>
      <gloss lang="en"><text>exceed, go beyond</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.6.3</text></form></note>
  </entry>
  <entry id="hiw ba_1230">
    <lexical-unit><form lang="kqs"><text>hiw ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiwba</text></form></variant>
    <sense id="hiw ba_1230_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépasser la mesure, abuser ; accabler ; être pressé</text></gloss>
      <gloss lang="en"><text>go too far, overdo, abuse; overwhelm; be in a hurry</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hiw ba</text></form></note>
    <note><form lang="fr"><text>De hiovɔɔ « dépasser ». Lexique p. 17-19 : hiw ba, hiwvo ba « abuser » ; hew ba, heaw ba « préférer, faire plus que ; être pressé, se dépêcher, dépasser » ; hiu ba « être pressé, dépasser une limite ».</text></form></note>
  </entry>
  <entry id="hiyanndo_1231">
    <lexical-unit><form lang="kqs"><text>hiyanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiyan</text></form></variant>
    <sense id="hiyanndo_1231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire une différence, distinguer ; faire acception de personnes</text></gloss>
      <gloss lang="en"><text>make a distinction; show partiality</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.11.47</text></form></note>
    <note><form lang="fr"><text>hiyan kɛ́-kɛ̀ co … tɛɛn te « il n'y a aucune différence entre … » (Jos 22,28).</text></form></note>
  </entry>
  <entry id="hiyinɔɔ_1232">
    <lexical-unit><form lang="kqs"><text>hiyinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyinɔɔ_1232_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerin</text></gloss>
      <gloss lang="en"><text>pilgrim</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyinöö; Lexique kissi–français, p. 19: hiyinɔɔ</text></form></note>
  </entry>
  <entry id="hiyioo_1233">
    <lexical-unit><form lang="kqs"><text>hiyioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyioo_1233_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerinage</text></gloss>
      <gloss lang="en"><text>pilgrimage</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyioo; Lexique kissi–français, p. 19: hiyioo</text></form></note>
  </entry>
  <entry id="hiŋndo_1234">
    <lexical-unit><form lang="kqs"><text>hiŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋ</text></form></variant>
    <variant><form lang="kqs"><text>hiŋaa</text></form></variant>
    <sense id="hiŋndo_1234_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agiter, brandir, remuer ; (hiŋ … hɔlla) tromper, léser ; tourner (qqch)</text></gloss>
      <gloss lang="en"><text>shake, brandish, wield; (hiŋ … hɔlla) deceive, wrong; turn (something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first GEN.3.24; Lexique kissi–français, p. 18: hiŋɔɔ/ hiŋ</text></form></note>
    <note><form lang="fr"><text>hiŋ bollen « hocher la tête » (Jr 18,16). Lexique kissi–français, p. 18 : hiŋɔɔ/hiŋ « tourner qqch ».</text></form></note>
  </entry>
  <entry id="hiŋnɔnndo_1235">
    <lexical-unit><form lang="kqs"><text>hiŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋnun</text></form></variant>
    <variant><form lang="kqs"><text>hiŋnɔn</text></form></variant>
    <sense id="hiŋnɔnndo_1235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>errer, aller çà et là ; s'agiter ; être tourné</text></gloss>
      <gloss lang="en"><text>wander about; be agitated; be turned</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be turned or stirred; turn around; become confused, go crazy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.37.15; Lexique kissi–français, p. 18: hinnɔnndo/ hinnun; Childs 2000, p. 127: hìŋnɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiŋndo. Lexique kissi–français, p. 18 : hinnɔnndo/hinnun « être tourné ; aller » (nn pour ŋn).</text></form></note>
  </entry>
  <entry id="hiɔlundɔɔ_1236">
    <lexical-unit><form lang="kqs"><text>hiɔlundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiɔlundɔɔ_1236_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatrième</text></gloss>
      <gloss lang="en"><text>fourth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.42.16; Lexique kissi–français, p. 18: hiɔlundɔɔ</text></form></note>
  </entry>
  <entry id="hiɔlɔnndo_1237">
    <lexical-unit><form lang="kqs"><text>hiɔlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlɔn</text></form></variant>
    <variant><form lang="kqs"><text>hiɔlun</text></form></variant>
    <sense id="hiɔlɔnndo_1237_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échapper, se sauver</text></gloss>
      <gloss lang="en"><text>escape, get away</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drop by accident, slip and fall; escape, slip away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.43.14; Childs 2000, p. 127: hìɔ̀lɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiɔlɔɔ.</text></form></note>
  </entry>
  <entry id="hiɔlɔɔ_1238">
    <lexical-unit><form lang="kqs"><text>hiɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlu</text></form></variant>
    <sense id="hiɔlɔɔ_1238_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre possession de, s'emparer de</text></gloss>
      <gloss lang="en"><text>take possession of, seize</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>win from somebody, take away by persuasion, money or force</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.20.18; Childs 2000, p. 128: hìɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lɛŋnden hiɔlɔɔ « prendre possession du pays ».</text></form></note>
  </entry>
  <entry id="hìɔ́ɔ́_1239">
    <lexical-unit><form lang="kqs"><text>hìɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɔ́ɔ́_1239_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>flamber (poils, plumes) ; tromper</text></gloss>
      <gloss lang="en"><text>singe (hair, feathers); cheat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="híɔ́ɔ́dɔ́lɔ́ɔ́_1240">
    <lexical-unit><form lang="kqs"><text>híɔ́ɔ́dɔ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="híɔ́ɔ́dɔ́lɔ́ɔ́_1240_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>ventre creusé (par la faim, rentré)</text></gloss>
      <gloss lang="en"><text>stomach drawn in (from hunger, sucked in)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: híɔ́ɔ́dɔ́lɔ́ɔ́</text></form></note>
  </entry>
  <entry id="hiɔɔlu_1241">
    <lexical-unit><form lang="kqs"><text>hiɔɔlu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiɔɔlu_1241_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatre</text></gloss>
      <gloss lang="en"><text>four</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.10; Lexique kissi–français, p. 18: hiɔɔlu; Childs 2000, p. 128: hìɔ́ɔ́lú</text></form></note>
    <note><form lang="fr"><text>Aussi Lexique kissi–français, p. 36 : « n hɔɔlu ». Lexique kissi–français, p. 36 écrit n hɔɔlu « quatre ».</text></form></note>
  </entry>
  <entry id="hiɔɔlundɔɔ_1242">
    <lexical-unit><form lang="kqs"><text>hiɔɔlundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔɔlundɔ</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔlen</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔɛi</text></form></variant>
    <sense id="hiɔɔlundɔɔ_1242_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatrième</text></gloss>
      <gloss lang="en"><text>fourth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.14.5; Childs 2000, p. 128: hìɔ́ɔ́lùndɔ́ɔ́-</text></form></note>
    <note><form lang="fr"><text>De hiɔɔlu « quatre ». paale hiɔɔlundɔlen « le quatrième jour » (Gn 1,19).</text></form></note>
  </entry>
  <entry id="hìɔ̀ɔ̀lɔ́léŋ_1243">
    <lexical-unit><form lang="kqs"><text>hìɔ̀ɔ̀lɔ́léŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="hìɔ̀ɔ̀lɔ́léŋ_1243_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de champignon (mis dans les sauces)</text></gloss>
      <gloss lang="en"><text>kind of mushroom (used in sauces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ̀ɔ̀lɔ́léŋ</text></form></note>
  </entry>
  <entry id="hìɔ̀ɔ̀nɔ̌ŋndó_1244">
    <lexical-unit><form lang="kqs"><text>hìɔ̀ɔ̀nɔ̌ŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɔ̀ɔ̀nɔ̌ŋndó_1244_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rentrer le ventre ; crâner, bluffer</text></gloss>
      <gloss lang="en"><text>draw in one's stomach; swagger, bluff</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ̀ɔ̀nɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="hìɲáhíɲâŋndó_1245">
    <lexical-unit><form lang="kqs"><text>hìɲáhíɲâŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɲáhíɲâŋndó_1245_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller et venir, mouvement de va-et-vient ; se démener</text></gloss>
      <gloss lang="en"><text>move back and forth, to and fro</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 127: hìɲáhíɲâŋndó</text></form></note>
  </entry>
  <entry id="ho_1246">
    <lexical-unit><form lang="kqs"><text>ho</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ho_1246_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe o)</text></gloss>
      <gloss lang="en"><text>this (o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1059 occurrences, first GEN.2.16; Lexique kissi–français, p. 19: ho; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
  <entry id="hoeiye_1247">
    <lexical-unit><form lang="kqs"><text>hoeiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hoeyii</text></form></variant>
    <variant><form lang="kqs"><text>hoiye</text></form></variant>
    <sense id="hoeiye_1247_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>froid ; souffle, vent ; paludisme, grippe ; air, vent</text></gloss>
      <gloss lang="en"><text>cold; breath, wind; malaria, flu ; air, wind; cold; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold, cold wind; cold dry season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 107 occurrences, first GEN.7.22; Keita 1979, p. 161: Hoeiye; Lexique kissi–français, p. 19: hoeiye; Childs 2000, p. 134: hùɛ̀ìyé</text></form></note>
    <note><form lang="fr"><text>Keita : « le palu, la grippe ». Dans la Bible : « froid » (Gn 8,22) et « souffle » (Gn 7,22). Lexique kissi–français, p. 19 : aussi hoiye « le vent ; le froid ; l'air » (la Bible a hoiye en PRO.20.4).</text></form></note>
  </entry>
  <entry id="hoeyii_1248">
    <lexical-unit><form lang="kqs"><text>hoeyii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hoeyii_1248_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vent ; souffle</text></gloss>
      <gloss lang="en"><text>wind; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold wind, cold season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.7; Childs 2000, p. 134: hùèìyé</text></form></note>
  </entry>
  <entry id="hókìíyó_1249">
    <lexical-unit><form lang="kqs"><text>hókìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hókìíyó_1249_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>semaine</text></gloss>
      <gloss lang="en"><text>week</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 129: hókìíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt (mendé, de l'anglais week) selon Childs.</text></form></note>
  </entry>
  <entry id="hòl-tìɔ́ɔ́_1250">
    <lexical-unit><form lang="kqs"><text>hòl-tìɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòl-tìɔ́ɔ́_1250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon de termitière</text></gloss>
      <gloss lang="en"><text>termite mushroom (grows on termite hills)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 130: hòl-tìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="hòl-ŋ̀pèŋgòó_1251">
    <lexical-unit><form lang="kqs"><text>hòl-ŋ̀pèŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòl-ŋ̀pèŋgòó_1251_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon comestible (des termitières de type pùùsɔ́ɔ́)</text></gloss>
      <gloss lang="en"><text>edible mushroom (growing on a type of termite hill)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 130: hòl-ŋ̀pèŋgòó</text></form></note>
  </entry>
  <entry id="hollo_1252">
    <lexical-unit><form lang="kqs"><text>hollo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hollo_1252_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon</text></gloss>
      <gloss lang="en"><text>mushroom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mushroom; helmet</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Hollo; Lexique kissi–français, p. 19: hollo; Childs 2000, p. 130: hòlló</text></form></note>
    <note><form lang="fr"><text>Pluriel holle selon Keita (p. 27). Lexique kissi–français, p. 19 : aussi hollen « champignon ».</text></form></note>
  </entry>
  <entry id="holnun_1253">
    <lexical-unit><form lang="kqs"><text>holnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>holnɔnndo</text></form></variant>
    <sense id="holnun_1253_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>cling to, be joined to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first GEN.2.24; Lexique kissi–français, p. 19: holnɔnndo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : holnɔnndo « se cramponner à ; se coller à » ; holnanndo « s'attacher ».</text></form></note>
  </entry>
  <entry id="holɔɔ_1254">
    <lexical-unit><form lang="kqs"><text>holɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hol</text></form></variant>
    <variant><form lang="kqs"><text>holnun</text></form></variant>
    <sense id="holɔɔ_1254_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, fixer, coller ; monter (Keita) ; joindre ; renverser, faire tomber</text></gloss>
      <gloss lang="en"><text>fix, attach, stick; climb (Keita); join; knock over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stick on, lean against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.25.7; Keita 1979, p. 110: Holöö; Lexique kissi–français, p. 19: holɔɔ; Childs 2000, p. 130: hòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, hol signifie « fixer, sertir, porter la main sur » (EXO 28,11 ; GEN 22,12) et holnun « s'attacher à » (GEN 2,24). Le sens « monter » de Keita correspond plutôt à hel (Bible) et hèlɔ̀ɔ́ (Childs p. 120).</text></form></note>
  </entry>
  <entry id="hoo_1255">
    <lexical-unit><form lang="kqs"><text>hoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hoo_1255_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui-ci, ceci</text></gloss>
      <gloss lang="en"><text>this one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 849 occurrences, first GEN.3.3; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
  <entry id="hòólan_1256">
    <lexical-unit><form lang="kqs"><text>hòólan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hòóla</text></form></variant>
    <sense id="hòólan_1256_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champs, pâturages, terres (de culture)</text></gloss>
      <gloss lang="en"><text>fields, pastures, (farm) lands</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>old or abandoned farm, recently cultivated land</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.24.6; Childs 2000, p. 131: hòó</text></form></note>
    <note><form lang="fr"><text>Pluriel. cɔlua niaa vanin kɔlan diólano hòóla bɛndu-bɛndulan nin « tes troupeaux paîtront dans de vastes pâturages » (ISA.30.23) ; niaa saa co o hòóla nilan nin-nda « vous, brebis de mon pâturage » (EZK.34.31).</text></form></note>
  </entry>
  <entry id="hóòlí_1257">
    <lexical-unit><form lang="kqs"><text>hóòlí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hóòlí_1257_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(déraciné) complètement</text></gloss>
      <gloss lang="en"><text>(uprooted) completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hóòlí</text></form></note>
  </entry>
  <entry id="hoondo_1258">
    <lexical-unit><form lang="kqs"><text>hoondo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hoondo_1258_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sangsue</text></gloss>
      <gloss lang="en"><text>leech</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.30.15; Lexique kissi–français, p. 19: hoondo</text></form></note>
  </entry>
  <entry id="hòòŋndó_1259">
    <lexical-unit><form lang="kqs"><text>hòòŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòòŋndó_1259_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sangsue</text></gloss>
      <gloss lang="en"><text>leech</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hòòŋndó</text></form></note>
  </entry>
  <entry id="houvianndo_1260">
    <lexical-unit><form lang="kqs"><text>houvianndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="houvianndo_1260_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être pressés l'un contre l'autre</text></gloss>
      <gloss lang="en"><text>be pressed against one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: houvianndo</text></form></note>
    <note><form lang="fr"><text>Lexique : « être pressés l'un contre l'autre ; se percer » (« percé » corrigé en « pressés » dans la source).</text></form></note>
  </entry>
  <entry id="hòùwáŋ_1261">
    <lexical-unit><form lang="kqs"><text>hòùwáŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hòùwáŋ_1261_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potion de feuilles de hòùwó (contre la constipation)</text></gloss>
      <gloss lang="en"><text>potion made from hòùwó leaves (for constipation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hòùwáŋ</text></form></note>
  </entry>
  <entry id="hòùwó_1262">
    <lexical-unit><form lang="kqs"><text>hòùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòùwó_1262_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à bois dur et blanc (construction)</text></gloss>
      <gloss lang="en"><text>tree with hard white wood (for building)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hòùwó</text></form></note>
  </entry>
  <entry id="hovihovio_1263">
    <lexical-unit><form lang="kqs"><text>hovihovio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hovihovio_1263_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer (à plusieurs reprises)</text></gloss>
      <gloss lang="en"><text>prick, pierce (repeatedly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>prick many times</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOS.23.13; Childs 2000, p. 131: hòwìhòwìó</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : maa n'yɔɔ le niaa hɔltan hovihovio « comme des épines qui piquent vos yeux » (JOS.23.13). Cf. hɔwvɔɔ « enfoncer ».</text></form></note>
  </entry>
  <entry id="huinden_1264">
    <lexical-unit><form lang="kqs"><text>huinden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="huinden_1264_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gale</text></gloss>
      <gloss lang="en"><text>scabies</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Huinden; Lexique kissi–français, p. 19: huinden</text></form></note>
    <note><form lang="fr"><text>Cf. vana ihuindo « galeux » (Lv 21,20). Lexique kissi–français, p. 16 et 19 : fuinde, huinde « la démangeaison ; les (petits) boutons sur la peau » (la Bible a huinde en LEV.13.10).</text></form></note>
  </entry>
  <entry id="huinndon_1265">
    <lexical-unit><form lang="kqs"><text>huinndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="huinndon_1265_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gale, maladie de peau (qui démange)</text></gloss>
      <gloss lang="en"><text>scab, itching skin disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>craw-craw, a skin disease with mottled skin; smallpox</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.28.27; Childs 2000, p. 134: hùíŋndé</text></form></note>
    <note><form lang="fr"><text>Pluriel. Une seule occurrence : nààla bondokpalan, huinndon a tɛɛnndan « ulcères, gale et démangeaisons » (DEU.28.27).</text></form></note>
  </entry>
  <entry id="huinɔnndo_1266">
    <lexical-unit><form lang="kqs"><text>huinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>huinan</text></form></variant>
    <sense id="huinɔnndo_1266_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tromper soi-même ; (huinan) se trahir les uns les autres</text></gloss>
      <gloss lang="en"><text>deceive oneself; (huinan) betray one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fool or trick oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JAS.1.22; Childs 2000, p. 134: hùìnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de huiyo « tromper ». mɛɛ niaa pila co huinɔnndo ni « vous vous trompez vous-mêmes » (JAS.1.22) ; mà huinan « ils se trahiront » (MAT.24.10).</text></form></note>
  </entry>
  <entry id="hùíyé_1267">
    <lexical-unit><form lang="kqs"><text>hùíyé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hùíyé_1267_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sifflement ; (hɔŋ hùíyé) siffler</text></gloss>
      <gloss lang="en"><text>whistle, hiss; (hɔŋ hùíyé) whistle, hiss</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a whistle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first ISA.5.26; Childs 2000, p. 134: hùíyé</text></form></note>
    <note><form lang="fr"><text>o hɔŋ hùíyé le nda veeloo « il siffle pour les appeler » (ISA.5.26) ; mà hɔŋ hùíyé a mɔnɛi « ils siffleront de stupeur » (JER.25.9).</text></form></note>
  </entry>
  <entry id="huiyo_1268">
    <lexical-unit><form lang="kqs"><text>huiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hui</text></form></variant>
    <sense id="huiyo_1268_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tromper, trahir</text></gloss>
      <gloss lang="en"><text>deceive, betray</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cheat, deceive; also break a promise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first JDG.16.10; Lexique kissi–français, p. 19: huiyo/ hui; Childs 2000, p. 134: hùìyó</text></form></note>
  </entry>
  <entry id="hulio_1269">
    <lexical-unit><form lang="kqs"><text>hulio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>huli</text></form></variant>
    <sense id="hulio_1269_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler finement, réduire en purée</text></gloss>
      <gloss lang="en"><text>pound fine, mash</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 20: hurio/ huri</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hurio/huri. Homographe de hulio « salir avec la poussière ».</text></form></note>
  </entry>
  <entry id="hulio_1270">
    <lexical-unit><form lang="kqs"><text>hulio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>huli</text></form></variant>
    <sense id="hulio_1270_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se salir, se couvrir de poussière ; (peau) desquamer</text></gloss>
      <gloss lang="en"><text>get dirty or dusty; (skin) flake</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hulio/ huli; Childs 2000, p. 135: hùlìó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 19 (hulio/huli « salir avec la poussière »).</text></form></note>
  </entry>
  <entry id="hullan_1271">
    <lexical-unit><form lang="kqs"><text>hullan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="respelled"/>
    <sense id="hullan_1271_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cerveau</text></gloss>
      <gloss lang="en"><text>brain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Hullan; Lexique kissi–français, p. 19: hullan; Childs 2000, p. 135: hùlláŋ</text></form></note>
  </entry>
  <entry id="hullo_1272">
    <lexical-unit><form lang="kqs"><text>hullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hul</text></form></variant>
    <sense id="hullo_1272_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souffler (sur) ; insuffler</text></gloss>
      <gloss lang="en"><text>blow (on); breathe into</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>blow on something; also lie to someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.4.15; Lexique kissi–français, p. 19: hul; Childs 2000, p. 135: hùllò</text></form></note>
    <note><form lang="fr"><text>Mó hul ndu hoeyii yoomuɛi o tɛɛngun lamilinndon nin « il souffla dans ses narines un souffle de vie » (GEN.2.7) ; mó hul nda « il souffla sur eux » (JHN.20.22) ; hoeiye pum va ya hɔlla hullo « un souffle passa sur mon visage » (JOB.4.15). Lexique kissi–français, p. 19-20 : hul (rad.), hulɔɔ « souffler ».</text></form></note>
  </entry>
  <entry id="hulma pɔmbɔan_1273">
    <lexical-unit><form lang="kqs"><text>hulma pɔmbɔan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hulma pɔmbɔan_1273_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cervelle</text></gloss>
      <gloss lang="en"><text>brains (soft matter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Hulma pömböan; Lexique kissi–français, p. 20: hulma pɔmɔan</text></form></note>
  </entry>
  <entry id="hulɔnndo_1274">
    <lexical-unit><form lang="kqs"><text>hulɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hulun</text></form></variant>
    <sense id="hulɔnndo_1274_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vider, se répandre</text></gloss>
      <gloss lang="en"><text>empty out, spill out</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.24.6; Lexique kissi–français, p. 20: hulɔnndo/ hulun</text></form></note>
  </entry>
  <entry id="hulɔɔ_1275">
    <lexical-unit><form lang="kqs"><text>hulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hulu</text></form></variant>
    <sense id="hulɔɔ_1275_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vider, verser</text></gloss>
      <gloss lang="en"><text>empty, pour out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw away, spill, dump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.8.7; Keita 1979, p. 110: Hulöö; Lexique kissi–français, p. 20: hulɔɔ/ hulu; Childs 2000, p. 135: hùlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Moyen hulun « se répandre » (2SA 20,10). Lexique kissi–français, p. 20 : hulɔɔ/hulu « éventer, vider » ; hurɔɔ « vider ».</text></form></note>
  </entry>
  <entry id="humboo_1276">
    <lexical-unit><form lang="kqs"><text>humboo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>humbu</text></form></variant>
    <variant><form lang="kqs"><text>humbon</text></form></variant>
    <sense id="humboo_1276_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>blanc ; (volin humbon) argent (métal)</text></gloss>
      <gloss lang="en"><text>white; (volin humbon) silver</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first LEV.13.24; Lexique kissi–français, p. 20: hunbuo; Childs 2000, p. 135: húmbù-</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 20 : hunbuo, hunbue « blanc, blanche » (nb pour mb).</text></form></note>
  </entry>
  <entry id="hunan_1277">
    <lexical-unit><form lang="kqs"><text>hunan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hunan_1277_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>en crue, qui monte (eau) ; (mɛmma hunan) eaux en crue, flot</text></gloss>
      <gloss lang="en"><text>rising, in flood (water); (mɛmma hunan) flood waters</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flooded (mɛŋmà hùùnâŋ 'the flooding water')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.22.16; Childs 2000, p. 137: hùùnâŋ</text></form></note>
    <note><form lang="fr"><text>maa mɛmma hunan o peo Nil « comme les eaux du Nil en crue » (JER.46.7). On trouve aussi mɛmma hunaa « le flot, l'inondation » (JOB.27.20, DAN.11.40). Le rattachement à hunɔɔ « venir » ou à hulɔɔ « verser » (Childs) reste à préciser.</text></form></note>
  </entry>
  <entry id="hunnun_1278">
    <lexical-unit><form lang="kqs"><text>hunnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hunnun_1278_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>(hunnun a) emmener, ramener avec soi</text></gloss>
      <gloss lang="en"><text>(hunnun a) bring along, bring back</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>arrive, come by one's own power</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.31.26; Childs 2000, p. 137: hùŋnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hunɔɔ « venir ». mì n kɔ hunnun a kesu kpema Hala naa « allons ramener l'arche de notre Dieu » (1CH.13.3) ; ma hunnun a nda « tu les as emmenées » (GEN.31.26).</text></form></note>
  </entry>
  <entry id="hunɔɔ_1279">
    <lexical-unit><form lang="kqs"><text>hunɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hun</text></form></variant>
    <variant><form lang="kqs"><text>hunnin</text></form></variant>
    <variant><form lang="kqs"><text>hin</text></form></variant>
    <variant><form lang="kqs"><text>hinnin</text></form></variant>
    <sense id="hunɔɔ_1279_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir ; (hun a) apporter, amener</text></gloss>
      <gloss lang="en"><text>come ; come; (hun a) bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>come, arrive</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 768 occurrences, first GEN.6.17; Keita 1979, p. 114: Hunöö; Lexique kissi–français, p. 20: hunɔɔ/ hun, hin; Childs 2000, p. 136: hùnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>hin, hinnin : radical négatif. co hunɔɔ + verbe : « être sur le point de ». Lexique kissi–français, p. 20 : hunɔɔ a, hun a « venir avec ; apporter » ; hin (forme négative).</text></form></note>
  </entry>
  <entry id="húó_1280">
    <lexical-unit><form lang="kqs"><text>húó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>húá</text></form></field>
    <sense id="húó_1280_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hibou, chouette</text></gloss>
      <gloss lang="en"><text>owl</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 137: húó</text></form></note>
  </entry>
  <entry id="huuluo_1281">
    <lexical-unit><form lang="kqs"><text>huuluo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>huulu</text></form></variant>
    <variant><form lang="kqs"><text>huulunin</text></form></variant>
    <variant><form lang="kqs"><text>huuloo</text></form></variant>
    <variant><form lang="kqs"><text>huuluu</text></form></variant>
    <sense id="huuluo_1281_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sauter, bondir</text></gloss>
      <gloss lang="en"><text>jump, leap</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>jump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.68.4; Keita 1979, p. 110: Huuluö; Lexique kissi–français, p. 20: huuluo/ huulu; Childs 2000, p. 137: hùùlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit huuluö ; la Bible écrit huuluo. Pluriel huuluu « sauter, franchir, transgresser » (PSA 114,4 ; NUM 22,18).</text></form></note>
  </entry>
  <entry id="hùŋgòó_1282">
    <lexical-unit><form lang="kqs"><text>hùŋgòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hùŋgòó_1282_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler (le grain), premier pilage</text></gloss>
      <gloss lang="en"><text>pound grain (first of three poundings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 136: hùŋgòó</text></form></note>
  </entry>
  <entry id="hùŋgùlàá_1283">
    <lexical-unit><form lang="kqs"><text>hùŋgùlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hùŋgùlàá_1283_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agrandir, élargir ; exagérer, grossir (une affaire)</text></gloss>
      <gloss lang="en"><text>enlarge, widen; exaggerate, blow up (a matter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 136: hùŋgùlàá</text></form></note>
  </entry>
  <entry id="huŋndo_1284">
    <lexical-unit><form lang="kqs"><text>huŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>huŋndan</text></form></field>
    <sense id="huŋndo_1284_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-fond, marécage</text></gloss>
      <gloss lang="en"><text>lowland, swamp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swamp where swamp rice is grown</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Hunndo; Lexique kissi–français, p. 20: hunndo; Childs 2000, p. 137: hùŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Hunndo ; le pluriel huŋndan (Jb 40,21) et Childs ont ŋ. Lexique kissi–français, p. 20 : hunndo « le bas-fond ».</text></form></note>
  </entry>
  <entry id="hɔ̂_1285">
    <lexical-unit><form lang="kqs"><text>hɔ̂</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɔ̂_1285_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souligne le fait de renverser (un liquide)</text></gloss>
      <gloss lang="en"><text>stresses spilling (a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hɔ̂</text></form></note>
  </entry>
  <entry id="hɔ́bɔ̀_1286">
    <lexical-unit><form lang="kqs"><text>hɔ́bɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɔ́bɔ̀_1286_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, en abondance</text></gloss>
      <gloss lang="en"><text>a lot, plentifully</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 132: hɔ́bɔ̀</text></form></note>
  </entry>
  <entry id="hɔ́dèíyó_1287">
    <lexical-unit><form lang="kqs"><text>hɔ́dèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hɔ́dèíyó_1287_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ordre (commandement)</text></gloss>
      <gloss lang="en"><text>order (command)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 132: hɔ́dèíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="hɔlaa_1288">
    <lexical-unit><form lang="kqs"><text>hɔlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɔl</text></form></variant>
    <sense id="hɔlaa_1288_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>visage, face ; (o … hɔl) devant, en présence de</text></gloss>
      <gloss lang="en"><text>face; (o … hɔl) before, in the presence of</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="8.6.1 Front"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>face; also sky</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 130 occurrences, first GEN.32.31; Childs 2000, p. 132: hɔ̀llá</text></form></note>
  </entry>
  <entry id="hɔlaa piɔ́mndo_1289">
    <lexical-unit><form lang="kqs"><text>hɔlaa piɔ́mndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlaa piɔ́mndo_1289_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque</text></gloss>
      <gloss lang="en"><text>mask</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Hölaa Piömndo; Lexique kissi–français, p. 19: hɔlaa piɔmndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel : hɔlaa « visage », piɔ́mndo « image, idole ». Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="hɔlahiŋaa_1290">
    <lexical-unit><form lang="kqs"><text>hɔlahiŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlahiŋaa_1290_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vertige</text></gloss>
      <gloss lang="en"><text>dizziness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔlahiŋaa</text></form></note>
  </entry>
  <entry id="hɔlla_1291">
    <lexical-unit><form lang="kqs"><text>hɔlla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɔl</text></form></variant>
    <sense id="hɔlla_1291_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>face, visage ; côté</text></gloss>
      <gloss lang="en"><text>face; side</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>face; sky</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 443 occurrences, first GEN.12.11; Keita 1979, p. 131: Hölla; Lexique kissi–français, p. 19: hɔlla; Childs 2000, p. 132: hɔ̀llá</text></form></note>
  </entry>
  <entry id="hɔlle kongelen_1292">
    <lexical-unit><form lang="kqs"><text>hɔlle kongelen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlle kongelen_1292_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sourcil</text></gloss>
      <gloss lang="en"><text>eyebrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔlle kongelen</text></form></note>
  </entry>
  <entry id="hɔllo_1293">
    <lexical-unit><form lang="kqs"><text>hɔllo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɔllo_1293_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bout, extrémité (d'un bâton, d'un sceptre) ; (o … hɔllo) devant, contre</text></gloss>
      <gloss lang="en"><text>tip, end (of a stick, sceptre); (o … hɔllo) before, against</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.7 End, point"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>point, tip, top, end</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1SA.14.43; Lexique kissi–français, p. 19: hɔllo; Childs 2000, p. 132: hɔ̀lló</text></form></note>
    <note><form lang="fr"><text>mó pilan tindaa hɔllo « elle toucha le bout du sceptre » (EST.5.2) ; ya vow hɔllo o lɛan nin « j'ai trempé le bout (du bâton) dans le miel » (1SA.14.43) ; o sim Mɛlɛka o hɔllo « (rien ne) tient devant le Seigneur » (PRO.21.30).</text></form></note>
  </entry>
  <entry id="hɔlmaa_1294">
    <lexical-unit><form lang="kqs"><text>hɔlmaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="hɔlmaa_1294_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>(o … hɔlmaa) aux yeux de, au regard de</text></gloss>
      <gloss lang="en"><text>(o … hɔlmaa) in the eyes of, in the sight of</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
  </entry>
  <entry id="hɔ̀lndɔ̀_1295">
    <lexical-unit><form lang="kqs"><text>hɔ̀lndɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɔ̀lndɔ̀_1295_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>près de, entre</text></gloss>
      <gloss lang="en"><text>close to, near, between</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 132: hɔ̀lndɔ̀</text></form></note>
  </entry>
  <entry id="hɔlta kalalan_1296">
    <lexical-unit><form lang="kqs"><text>hɔlta kalalan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlta kalalan_1296_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dureté, cruauté ; avarice</text></gloss>
      <gloss lang="en"><text>hardness, ruthlessness; stinginess</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔlta karalan</text></form></note>
    <note><form lang="fr"><text>Lexique : hɔlta karalan « impitoyable ; avare ; dureté de vie ».</text></form></note>
  </entry>
  <entry id="hɔlta vesɛlɛlan_1297">
    <lexical-unit><form lang="kqs"><text>hɔlta vesɛlɛlan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlta vesɛlɛlan_1297_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hardiesse, courage ; dureté</text></gloss>
      <gloss lang="en"><text>boldness, courage; ruthlessness</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔlta vesɛlɛran</text></form></note>
    <note><form lang="fr"><text>Lexique : hɔlta vesɛlɛran « la hardiesse ; le courage ; l'impitoyable ».</text></form></note>
  </entry>
  <entry id="hɔlten_1298">
    <lexical-unit><form lang="kqs"><text>hɔlten</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hɔltan</text></form></field>
    <variant><form lang="kqs"><text>hɔlte</text></form></variant>
    <variant><form lang="kqs"><text>hɔlta</text></form></variant>
    <sense id="hɔlten_1298_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>œil ; (nɔ hɔlten … coo) veiller sur</text></gloss>
      <gloss lang="en"><text>eye ; eye; (nɔ hɔlten … coo) watch over</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 139 occurrences, first GEN.17.18; Keita 1979, p. 131: Hölten; Lexique kissi–français, p. 19: hɔlten; Childs 2000, p. 132: hɔ̀ltéŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : aussi hɔllen « l'œil ».</text></form></note>
  </entry>
  <entry id="hɔ́lɔ̀bí_1299">
    <lexical-unit><form lang="kqs"><text>hɔ́lɔ̀bí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɔ́lɔ̀bí_1299_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, énormément</text></gloss>
      <gloss lang="en"><text>a lot, a great deal</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 132: hɔ́lɔ̀bí</text></form></note>
  </entry>
  <entry id="hɔlɔɔ_1300">
    <lexical-unit><form lang="kqs"><text>hɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlɔɔ_1300_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, retirer qqch des mains de qqn</text></gloss>
      <gloss lang="en"><text>seize, snatch from someone's hands</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔrɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hɔrɔɔ ; aussi haru (rad.) « saisir, retenir qqch dans les mains » (p. 17).</text></form></note>
  </entry>
  <entry id="hɔnlesɛnnɔɔ_1301">
    <lexical-unit><form lang="kqs"><text>hɔnlesɛnnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hɔnlesɛnnɔɔ_1301_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flûtiste</text></gloss>
      <gloss lang="en"><text>flute player</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Hönlesènnöö; Lexique kissi–français, p. 19: hɔnlesɛnnɔɔ</text></form></note>
  </entry>
  <entry id="hɔvio_1302">
    <lexical-unit><form lang="kqs"><text>hɔvio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hɔvi</text></form></variant>
    <sense id="hɔvio_1302_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer (plusieurs fois)</text></gloss>
      <gloss lang="en"><text>prick, sting (repeatedly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔvio/ hɔvi</text></form></note>
    <note><form lang="fr"><text>Lexique p. 19 : aussi hovio « percer plusieurs fois, piquer ». Cf. hovihovio.</text></form></note>
  </entry>
  <entry id="hɔvɔɔ_1303">
    <lexical-unit><form lang="kqs"><text>hɔvɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hɔw</text></form></variant>
    <sense id="hɔvɔɔ_1303_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer, percer, enfoncer ; injecter</text></gloss>
      <gloss lang="en"><text>prick, pierce, thrust; inject</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔvɔɔ/ hɔw, how, hɔaw</text></form></note>
    <note><form lang="fr"><text>Lexique p. 19 : hɔvɔɔ/hɔw, how, hɔaw « injecter » ; hɔɔ/hɔa « percer ; piquer ». La Bible a hɔw « enfoncer (la fourchette) » (1SA.2.14).</text></form></note>
  </entry>
  <entry id="hɔwvɔɔ_1304">
    <lexical-unit><form lang="kqs"><text>hɔwvɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔwvɔɔ_1304_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>injecter, enfoncer</text></gloss>
      <gloss lang="en"><text>inject, thrust in</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Höwvöö</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : hɔw (1SA 2,14, la fourchette enfoncée).</text></form></note>
  </entry>
  <entry id="hɔŋndo_1305">
    <lexical-unit><form lang="kqs"><text>hɔŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɔŋ</text></form></variant>
    <sense id="hɔŋndo_1305_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souffler ; sonner (de la trompette) ; siffler</text></gloss>
      <gloss lang="en"><text>blow; sound (a trumpet); whistle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first EXO.10.13; Lexique kissi–français, p. 19: hɔŋɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : hɔŋɔɔ, hɔaŋ (rad.) « siffler ».</text></form></note>
  </entry>
  <entry id="hɔ̌ŋndó_1306">
    <lexical-unit><form lang="kqs"><text>hɔ̌ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hɔ̌ŋndó_1306_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'oiseau forestier (faisan ?)</text></gloss>
      <gloss lang="en"><text>kind of forest bird (pheasant?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 132: hɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="hɔŋnɔnndo_1307">
    <lexical-unit><form lang="kqs"><text>hɔŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɔŋnɔnndo_1307_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sonner, retentir (trompette)</text></gloss>
      <gloss lang="en"><text>sound, be blown (trumpet)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be blown</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOS.6.13; Childs 2000, p. 132: hɔ̀ŋnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hɔŋndo « souffler, sonner ». bululan la va hɔŋnɔnndo « les trompettes sonnaient » (JOS.6.13).</text></form></note>
  </entry>
  <entry id="hɔ́ɔ́_1308">
    <lexical-unit><form lang="kqs"><text>hɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hɔ́aa</text></form></field>
    <sense id="hɔ́ɔ́_1308_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant (descendant), fils ou fille</text></gloss>
      <gloss lang="en"><text>child, offspring</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 196 occurrences, first GEN.4.1</text></form></note>
  </entry>
  <entry id="hɔ̀ɔ̀lɔ́ɔ̀_1309">
    <lexical-unit><form lang="kqs"><text>hɔ̀ɔ̀lɔ́ɔ̀</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hɔ̀ɔ̀lɔ́a</text></form></field>
    <variant><form lang="kqs"><text>hɔ̀ɔ̀lɔ́</text></form></variant>
    <sense id="hɔ̀ɔ̀lɔ́ɔ̀_1309_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vipère ; serpent</text></gloss>
      <gloss lang="en"><text>viper, adder; snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a poisonous water snake, a kind of adder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.49.17; Lexique kissi–français, p. 19: hɔɔlɔɔ; Childs 2000, p. 133: hɔ̀ɔ̀lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : hɔɔlɔɔ « le serpent », hɔɔrɔɔ « la vipère ».</text></form></note>
  </entry>
  <entry id="hɔ̀ɔ̀néí_1310">
    <lexical-unit><form lang="kqs"><text>hɔ̀ɔ̀néí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>hɔ̀ɔ̀nóŋ</text></form></field>
    <sense id="hɔ̀ɔ̀néí_1310_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gratin de riz (au fond de la marmite)</text></gloss>
      <gloss lang="en"><text>rice crust (at the bottom of the pot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 133: hɔ̀ɔ̀néí</text></form></note>
  </entry>
  <entry id="hɔɔnie_1311">
    <lexical-unit><form lang="kqs"><text>hɔɔnie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔɔnie_1311_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>croûte de riz au fond de la marmite, gratin</text></gloss>
      <gloss lang="en"><text>rice crust at the bottom of the pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hɔɔnie</text></form></note>
  </entry>
  <entry id="hɔɔnuo_1312">
    <lexical-unit><form lang="kqs"><text>hɔɔnuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔɔnuo_1312_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>désherber, arracher les mauvaises herbes</text></gloss>
      <gloss lang="en"><text>weed</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>weed</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Höönuo; Lexique kissi–français, p. 19: hɔɔnuo/ hɔɔnu; Childs 2000, p. 133: hɔ̀ɔ̀nòó</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : hɔɔnuu « arracher (l'ivraie) » (MAT 13,28). Lexique kissi–français, p. 19 : aussi hɔnɔɔ/hɔnu « désherber ».</text></form></note>
  </entry>
  <entry id="hɔ́ɔ́pìó_1313">
    <lexical-unit><form lang="kqs"><text>hɔ́ɔ́pìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hɔ́ɔ́pìó_1313_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de serpent (non venimeux)</text></gloss>
      <gloss lang="en"><text>kind of snake (non-venomous)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 133: hɔ́ɔ́pìó</text></form></note>
  </entry>
  <entry id="hɔ́ɔ́yɛi_1314">
    <lexical-unit><form lang="kqs"><text>hɔ́ɔ́yɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hɔ́ɔ́yɛi_1314_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liberté</text></gloss>
      <gloss lang="en"><text>freedom</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first EXO.21.2; Keita 1979, p. 148: Hööyèi; Lexique kissi–français, p. 19: hɔɔyɛi</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : hɔɔ « une personne libérée ».</text></form></note>
  </entry>
  <entry id="hɛiyo_1315">
    <lexical-unit><form lang="kqs"><text>hɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛi</text></form></variant>
    <variant><form lang="kqs"><text>hɛinin</text></form></variant>
    <variant><form lang="kqs"><text>hɛyaa</text></form></variant>
    <sense id="hɛiyo_1315_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vanner ; cribler ; (fɛlɛ hɛyaa) van</text></gloss>
      <gloss lang="en"><text>winnow; sift; (fɛlɛ hɛyaa) winnowing fork</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>winnow, fan; also flutter; trick, fool</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first RUT.3.2; Lexique kissi–français, p. 18: hɛiyo/ hɛi; Childs 2000, p. 122: hɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>o co lakɔ ɔrse ndɔɔ lɔɔ a hɛiyo « il va vanner son orge » (RUT.3.2) ; Setana hɛi niaa maa mɛɛ vana hɛi maalon nuaa yɛ « (que) Satan vous passe au crible comme on vanne le blé » (LUK.22.31) ; Fɛlɛ ndɔ hɛyaa « son van » (MAT.3.12).</text></form></note>
  </entry>
  <entry id="hɛli_1316">
    <lexical-unit><form lang="kqs"><text>hɛli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛlinin</text></form></variant>
    <variant><form lang="kqs"><text>hɛlin</text></form></variant>
    <sense id="hɛli_1316_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>choisir</text></gloss>
      <gloss lang="en"><text>choose</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 358 occurrences, first GEN.6.2; Childs 2000, p. 122: hɛ̀líó</text></form></note>
  </entry>
  <entry id="hɛlihɛlio_1317">
    <lexical-unit><form lang="kqs"><text>hɛlihɛlio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɛlihɛlio_1317_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trier plusieurs fois</text></gloss>
      <gloss lang="en"><text>sort repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Hèlihèlio; Lexique kissi–français, p. 18: hɛlihɛlio/ hɛlihɛli</text></form></note>
    <note><form lang="fr"><text>Redoublement de hɛlio.</text></form></note>
  </entry>
  <entry id="hɛlio_1318">
    <lexical-unit><form lang="kqs"><text>hɛlio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛli</text></form></variant>
    <variant><form lang="kqs"><text>hɛlinin</text></form></variant>
    <variant><form lang="kqs"><text>hɛlin</text></form></variant>
    <sense id="hɛlio_1318_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>choisir, trier</text></gloss>
      <gloss lang="en"><text>choose, select, sort</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>choose</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.18; Keita 1979, p. 110: Hèlio; Lexique kissi–français, p. 18: hɛlio/ hɛli; Childs 2000, p. 122: hɛ̀lìó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 18 : aussi hɛrio/hɛri « choisir » ; hɛrinndo/hɛrin « être choisi, être élu » (Bible hɛlin).</text></form></note>
  </entry>
  <entry id="hɛlle_1319">
    <lexical-unit><form lang="kqs"><text>hɛlle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɛlle_1319_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sel</text></gloss>
      <gloss lang="en"><text>salt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.30.35; Lexique kissi–français, p. 18: hɛlle; Childs 2000, p. 122: hɛ̀llé</text></form></note>
    <note><form lang="fr"><text>A bɛnda ma vow hɛlle « vous y mettrez du sel » (LEV.2.13) ; mó saŋ hɛlle o fonda kobio va-o « il sema du sel sur l'emplacement de la ville » (JDG.9.45).</text></form></note>
  </entry>
  <entry id="hɛlu_1320">
    <lexical-unit><form lang="kqs"><text>hɛlu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>helu</text></form></variant>
    <variant><form lang="kqs"><text>hélú</text></form></variant>
    <sense id="hɛlu_1320_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre, enlever, s'emparer de</text></gloss>
      <gloss lang="en"><text>take (away), seize</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 63 occurrences, first GEN.20.18</text></form></note>
    <note><form lang="fr"><text>Vana-vana hélú ndu ya o ba le « personne ne me l'ôte » (Jn 10,18).</text></form></note>
  </entry>
  <entry id="hɛlul_1321">
    <lexical-unit><form lang="kqs"><text>hɛlul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛlulun</text></form></variant>
    <sense id="hɛlul_1321_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>choisir pour (qqn) ; (hɛlulun) se choisir</text></gloss>
      <gloss lang="en"><text>choose for (someone); (hɛlulun) choose for oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>select for someone (variant hɛlul)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.17.9; Childs 2000, p. 122: hɛ̀lìlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hɛlio « choisir ». Hɛlul naa kuubaa « choisis-nous des hommes » (EXO.17.9) ; nda pila hɛlulun masaa « ils se donnèrent un roi » (2KI.8.20).</text></form></note>
  </entry>
  <entry id="hɛlun_1322">
    <lexical-unit><form lang="kqs"><text>hɛlun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>helun</text></form></variant>
    <variant><form lang="kqs"><text>helunnin</text></form></variant>
    <sense id="hɛlun_1322_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échapper, survivre</text></gloss>
      <gloss lang="en"><text>escape, survive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.14.10; Lexique kissi–français, p. 19: hɔrɔnndo/ hɛrun</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 et 19 : harun (rad.) « s'échapper » ; hɔrɔnndo/hɛrun « échapper ».</text></form></note>
  </entry>
  <entry id="hɛ̀lùŋndó_1323">
    <lexical-unit><form lang="kqs"><text>hɛ̀lùŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>hɛ̀lùŋndá</text></form></field>
    <sense id="hɛ̀lùŋndó_1323_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chevrotain aquatique</text></gloss>
      <gloss lang="en"><text>water chevrotain (water deer)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: hɛ̀lùŋndó</text></form></note>
    <note><form lang="fr"><text>Dorcatherium aquaticum (Hyemoschus aquaticus).</text></form></note>
  </entry>
  <entry id="hɛ́lɛ́ŋ_1324">
    <lexical-unit><form lang="kqs"><text>hɛ́lɛ́ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɛ́lɛ́ŋ_1324_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en se détachant, en sortant de son logement</text></gloss>
      <gloss lang="en"><text>coming loose, popping out of its socket</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: hɛ́lɛ́ŋ</text></form></note>
  </entry>
  <entry id="hɛnan_1325">
    <lexical-unit><form lang="kqs"><text>hɛnan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛnanndo</text></form></variant>
    <variant><form lang="kqs"><text>hɛnannin</text></form></variant>
    <sense id="hɛnan_1325_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>plaire à</text></gloss>
      <gloss lang="en"><text>please, be pleasing to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 451 occurrences, first GEN.17.1; Lexique kissi–français, p. 18: hɛnanndo/ hɛnan</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 18 : hɛnanndo/hɛnan « plaire, faire plaire, admirer ».</text></form></note>
  </entry>
  <entry id="hɛngɔɔ_1326">
    <lexical-unit><form lang="kqs"><text>hɛngɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="hɛngɔɔ_1326_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour du chef (pour appeler les gens)</text></gloss>
      <gloss lang="en"><text>chief's drum (to summon people)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hɛngɔɔ</text></form></note>
    <note><form lang="fr"><text>Homographe de hɛngɔɔ « bol (de bois) » ; à confirmer.</text></form></note>
  </entry>
  <entry id="hɛngɔɔ_1327">
    <lexical-unit><form lang="kqs"><text>hɛngɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɛngɔɔ_1327_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bol de bois, récipient</text></gloss>
      <gloss lang="en"><text>wooden bowl, vessel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZK.4.9; Lexique kissi–français, p. 18: hɛngɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique : « un bois taillé sous forme de bol pour extraire l'huile rouge ; un bol ». Dans la Bible, aussi le boisseau sous lequel on met la lampe (LUK.11.33).</text></form></note>
  </entry>
  <entry id="hɛngɛiyo_1328">
    <lexical-unit><form lang="kqs"><text>hɛngɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hɛngɛilan</text></form></field>
    <variant><form lang="kqs"><text>hɛngɛi</text></form></variant>
    <variant><form lang="kqs"><text>hɛngɛila</text></form></variant>
    <sense id="hɛngɛiyo_1328_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bol, bassin, plat</text></gloss>
      <gloss lang="en"><text>bowl, basin, dish</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.7.85; Lexique kissi–français, p. 18: hɛngɛiyo; Childs 2000, p. 122: hèŋgéíyó</text></form></note>
  </entry>
  <entry id="hɛ̀ù-hɛ̀ù_1329">
    <lexical-unit><form lang="kqs"><text>hɛ̀ù-hɛ̀ù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hɛ̀ù-hɛ̀ù_1329_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>halètement (léopard, sanglier, personne en colère)</text></gloss>
      <gloss lang="en"><text>panting (leopard, boar, angry person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 123: hɛ̀ù-hɛ̀ù</text></form></note>
  </entry>
  <entry id="hɛŋgɛi-tòŋndó_1330">
    <lexical-unit><form lang="kqs"><text>hɛŋgɛi-tòŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hɛŋgɛi-tòŋndó_1330_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vieille marmite servant à faire le savon</text></gloss>
      <gloss lang="en"><text>old pot used for making soap</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: hɛŋgɛi-tòŋndó</text></form></note>
  </entry>
  <entry id="hɛ́ɛ̀_1331">
    <lexical-unit><form lang="kqs"><text>hɛ́ɛ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɛ́ɛ̀_1331_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ah ! (ɛ̀ɛ̀ hɛ́ɛ̀, cri de joie ou de triomphe)</text></gloss>
      <gloss lang="en"><text>aha! (ɛ̀ɛ̀ hɛ́ɛ̀, cry of joy or gloating)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.2.23</text></form></note>
  </entry>
  <entry id="hɛɛnduuo_1332">
    <lexical-unit><form lang="kqs"><text>hɛɛnduuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɛɛnduu</text></form></variant>
    <variant><form lang="kqs"><text>hɛ́ɛ́ndùù</text></form></variant>
    <variant><form lang="kqs"><text>hɛɛndu</text></form></variant>
    <sense id="hɛɛnduuo_1332_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>disposer, placer (plusieurs choses) ; (sɔɔn hɛɛnduuo … coo) accuser</text></gloss>
      <gloss lang="en"><text>set up, place (several things); (sɔɔn hɛɛnduuo … coo) accuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stack, place a succession of objects</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first JOB.33.10; Childs 2000, p. 121: hèènduùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de handɔɔ « mettre ». hɛɛnduu fitinalan « disposer les lampes » (Nb 8,3).</text></form></note>
  </entry>
  <entry id="hɛɛnndon_1333">
    <lexical-unit><form lang="kqs"><text>hɛɛnndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hɛɛnndon_1333_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chardons, ronces</text></gloss>
      <gloss lang="en"><text>thistles, briers</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.3.18</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="i_1334">
    <lexical-unit><form lang="kqs"><text>i</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="i_1334_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>je (sujet)</text></gloss>
      <gloss lang="en"><text>I (subject)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5732 occurrences, first GEN.1.29; Lexique kissi–français, p. 20: i; Childs 2000, p. 138: í</text></form></note>
  </entry>
