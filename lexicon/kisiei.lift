    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pick up one by one; steal</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2KI.3.23; Childs 2000, p. 59: cɔ̀ɔ̀wìáŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen pluriel de cɔwviaa « ramasser ». n kɔ cɔwvian ɲɛm ndan « allons piller leurs biens » (2KI.3.23) ; N'tiŋ cɔwvian « l'argent est pillé » (NAM.2.11) ; JER.6.9.</text></form></note>
  </entry>
  <entry id="cɔwvo_577">
    <lexical-unit><form lang="kqs"><text>cɔwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɔwlan</text></form></field>
    <variant><form lang="kqs"><text>cɔwva</text></form></variant>
    <variant><form lang="kqs"><text>cɔwve</text></form></variant>
    <variant><form lang="kqs"><text>cɔwvon</text></form></variant>
    <variant><form lang="kqs"><text>cɔwla</text></form></variant>
    <variant><form lang="kqs"><text>cɔwlan</text></form></variant>
    <variant><form lang="kqs"><text>cɔvii</text></form></variant>
    <variant><form lang="kqs"><text>cɔvun</text></form></variant>
    <sense id="cɔwvo_577_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guerre ; guerre, combat ; (pl. cɔwva) armées, guerriers</text></gloss>
      <gloss lang="en"><text>war ; war, battle; (pl. cɔwva) armies, warriors</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>war; also the making of weapons, blacksmithing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 769 occurrences, first GEN.14.2; Keita 1979, p. 156: Työwvo; Childs 2000, p. 59: cɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Après un nom, s'accorde avec lui : mɔɛi cɔwve « épée », mɔɔn cɔwvon « épées », ɲɛm cɔvun « armes », kɔ̀ɔ̀la cɔwla « boucliers ».</text></form></note>
  </entry>
  <entry id="cɔ̀wɔ̀ɔ́_578">
    <lexical-unit><form lang="kqs"><text>cɔ̀wɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀wɔ̀ɔ́_578_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aplatir, marteler (le métal, travail du forgeron)</text></gloss>
      <gloss lang="en"><text>flatten, hammer (metal, as a blacksmith)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cɔ̀wɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔ̀ŋgáŋcɔ̀_579">
    <lexical-unit><form lang="kqs"><text>cɔ̀ŋgáŋcɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ŋgáŋcɔ̀_579_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>à cloche-pied, en sautillant</text></gloss>
      <gloss lang="en"><text>hopping, with a hopping motion</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 56: cɔ̀ŋgáŋcɔ̀</text></form></note>
  </entry>
  <entry id="cɔ̀ŋgùɛ́í_580">
    <lexical-unit><form lang="kqs"><text>cɔ̀ŋgùɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ŋgùɛ́í_580_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros poisson au dos bossu</text></gloss>
      <gloss lang="en"><text>large hump-backed fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ŋgùɛ́í</text></form></note>
  </entry>
  <entry id="cɔ̀ŋgùɛ́í_581">
    <lexical-unit><form lang="kqs"><text>cɔ̀ŋgùɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cɔ̀ŋgɔ̌ŋ</text></form></field>
    <sense id="cɔ̀ŋgùɛ́í_581_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>culotte traditionnelle ouverte sur les côtés</text></gloss>
      <gloss lang="en"><text>traditional leggings open at the sides</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ŋgùɛ́í</text></form></note>
  </entry>
  <entry id="cɔ̀ŋndéŋ_582">
    <lexical-unit><form lang="kqs"><text>cɔ̀ŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ŋndéŋ_582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couronne d'un jeune palmier</text></gloss>
      <gloss lang="en"><text>crown of a young palm tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ŋndéŋ</text></form></note>
  </entry>
  <entry id="cɔ̀ŋɔ̀ɔ́_583">
    <lexical-unit><form lang="kqs"><text>cɔ̀ŋɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ŋɔ̀ɔ́_583_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pêcher au filet (pêche collective des femmes)</text></gloss>
      <gloss lang="en"><text>fish with a net (women's drive fishing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔ̀ɔ́_584">
    <lexical-unit><form lang="kqs"><text>cɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ɔ́_584_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enterrer</text></gloss>
      <gloss lang="en"><text>bury</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔ̀ɔ́_585">
    <lexical-unit><form lang="kqs"><text>cɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀ɔ́_585_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être gros, épais, corpulent</text></gloss>
      <gloss lang="en"><text>be fat, thick, stout</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 58: cɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔ́ɔ́cɔ́ɔ̀an_586">
    <lexical-unit><form lang="kqs"><text>cɔ́ɔ́cɔ́ɔ̀an</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="cɔ́ɔ́cɔ́ɔ̀an_586_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roseaux, joncs, papyrus</text></gloss>
      <gloss lang="en"><text>reeds, rushes, papyrus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.2.3</text></form></note>
  </entry>
  <entry id="cɔɔlu_587">
    <lexical-unit><form lang="kqs"><text>cɔɔlu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔɔlunin</text></form></variant>
    <sense id="cɔɔlu_587_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ajouter, augmenter ; continuer, faire de nouveau</text></gloss>
      <gloss lang="en"><text>add, increase; continue, do again</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 143 occurrences, first GEN.9.12</text></form></note>
  </entry>
  <entry id="cɔɔlɔnndo_588">
    <lexical-unit><form lang="kqs"><text>cɔɔlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔɔlɔnndo_588_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>augmenter, s'accroître ; empirer</text></gloss>
      <gloss lang="en"><text>increase, grow (in number); get worse</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.39.3; Childs 2000, p. 58: cɔ̀ɔ̀lɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de cɔɔlu « ajouter ». kunda vanaa laalannda va cɔɔlɔnndo « le nombre des croyants augmentait » (ACT.5.14) ; sanga nuu ... cɔɔlɔnndo « ma douleur s'aggravait » (PSA.39.3).</text></form></note>
  </entry>
  <entry id="cɔɔmullo_589">
    <lexical-unit><form lang="kqs"><text>cɔɔmullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔɔmul</text></form></variant>
    <sense id="cɔɔmullo_589_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>révéler, dévoiler, mettre au jour (à qqn)</text></gloss>
      <gloss lang="en"><text>reveal, disclose, expose (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>show something hidden</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1KI.17.18; Childs 2000, p. 58: cɔ̀ɔ̀mùlló</text></form></note>
    <note><form lang="fr"><text>le Israɛlla haki ndaa cɔɔmullo « pour révéler à Israël ses péchés » (MIC.3.8) ; Yoongu Hala cɔɔmul Habakuk « la parole que Dieu révéla à Habacuc » (HAB.1.1). Voir cɔɔmuuo.</text></form></note>
  </entry>
  <entry id="cɔɔmun_590">
    <lexical-unit><form lang="kqs"><text>cɔɔmun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔɔmun_590_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se faire connaître, se révéler ; apparaître</text></gloss>
      <gloss lang="en"><text>make oneself known, reveal oneself; appear</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first LUK.24</text></form></note>
    <note><form lang="fr"><text>Moyen de cɔɔmuuo.</text></form></note>
  </entry>
  <entry id="cɔɔmuuo_591">
    <lexical-unit><form lang="kqs"><text>cɔɔmuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔɔmuu</text></form></variant>
    <variant><form lang="kqs"><text>cɔɔmuunin</text></form></variant>
    <sense id="cɔɔmuuo_591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>révéler, rapporter, dénoncer ; faire connaître</text></gloss>
      <gloss lang="en"><text>reveal, report, tell on; make known</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.5.13</text></form></note>
    <note><form lang="fr"><text>Dérivé de cɔmndo « indiquer, montrer ». Bénéfactif cɔɔmul(lo) « révéler à » (Mi 3,8 ; Ha 1,1).</text></form></note>
  </entry>
  <entry id="cɔɛllɛn_592">
    <lexical-unit><form lang="kqs"><text>cɔɛllɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔɛllɛn_592_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>cette nuit, ce soir</text></gloss>
      <gloss lang="en"><text>tonight, this night</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.19.5; Childs 2000, p. 62: cùèllèŋ</text></form></note>
  </entry>
  <entry id="cɔ̀ɲɔ̀ɔ́_593">
    <lexical-unit><form lang="kqs"><text>cɔ̀ɲɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cɔ̀ɲɔ̀láŋ</text></form></field>
    <sense id="cɔ̀ɲɔ̀ɔ́_593_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>régime de noix de palme (surtout égrené)</text></gloss>
      <gloss lang="en"><text>palm nut cluster (esp. with the nuts removed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 57: cɔ̀ɲɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɛi panio_594">
    <lexical-unit><form lang="kqs"><text>cɛi panio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɛi panio_594_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maison en tôle</text></gloss>
      <gloss lang="en"><text>house with a sheet-metal roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: tyièi panio; Childs 2000, p. 44: cìɛ̀ì-pánìɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; dans la Bible, panio désigne une mesure de capacité (1 S 25,18). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="cɛi puiyo_595">
    <lexical-unit><form lang="kqs"><text>cɛi puiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɛi puiyo_595_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>case en paille</text></gloss>
      <gloss lang="en"><text>thatched house</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Tyiei puiyo; Childs 2000, p. 44: cìɛ̀ì-pùíyó</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; puiyo « paille, herbe » (Jg 19,19). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="cɛi tollo_596">
    <lexical-unit><form lang="kqs"><text>cɛi tollo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="cɛi tollo_596_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maison en tôle</text></gloss>
      <gloss lang="en"><text>house with a sheet-metal roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Tyièi tollo</text></form></note>
    <note><form lang="fr"><text>tollo vient sans doute du français « tôle » ; dans la Bible, tollo a un autre sens (yɛlen tollo « souffrir », Mt 5,10).</text></form></note>
  </entry>
  <entry id="Cɛi-Hala_597">
    <lexical-unit><form lang="kqs"><text>Cɛi-Hala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="Cɛi-Hala_597_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>temple, église (maison de Dieu)</text></gloss>
      <gloss lang="en"><text>temple, church (house of God)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first JOS.9.23; Keita 1979, p. 150: Tyièi hala</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tyièi hala ; la Bible écrit Cɛi-Hala.</text></form></note>
  </entry>
  <entry id="cɛiyo_598">
    <lexical-unit><form lang="kqs"><text>cɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɛilan</text></form></field>
    <variant><form lang="kqs"><text>cɛi</text></form></variant>
    <variant><form lang="kqs"><text>cɛila</text></form></variant>
    <variant><form lang="kqs"><text>cɛinin</text></form></variant>
    <sense id="cɛiyo_598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maison ; famille</text></gloss>
      <gloss lang="en"><text>house ; house; household</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 167 occurrences, first GEN.19.11; Keita 1979, p. 142: Tyièiyo; Childs 2000, p. 44: cìɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>La forme ciɛiyo proposée par la respelling n'apparaît qu'une fois (Lc 16,20) ; la Bible écrit cɛiyo. cɛinin (cɛi + nin) « dans la maison, chez soi » : o ndu lo cɛinin « chez lui ».</text></form></note>
  </entry>
  <entry id="cɛkɔɔ_599">
    <lexical-unit><form lang="kqs"><text>cɛkɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cɛkɔɔ_599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>castagnette masculine</text></gloss>
      <gloss lang="en"><text>men's rattle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Tyèköö; Childs 2000, p. 41: cèkɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɛ́kɛ́lɛ́_600">
    <lexical-unit><form lang="kqs"><text>cɛ́kɛ́lɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɛ́kɛ́lɛ́_600_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, à fond (laver, se laver)</text></gloss>
      <gloss lang="en"><text>thoroughly, all over (wash, bathe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first LEV.6.21</text></form></note>
  </entry>
  <entry id="cɛlan_601">
    <lexical-unit><form lang="kqs"><text>cɛlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɛlan_601_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entendre, s'allier</text></gloss>
      <gloss lang="en"><text>agree together, ally</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first GEN.14.5</text></form></note>
    <note><form lang="fr"><text>Réciproque de cɛlɔɔ « accepter ».</text></form></note>
  </entry>
  <entry id="cɛlnun_602">
    <lexical-unit><form lang="kqs"><text>cɛlnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɛlnun_602_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être agréé, être accepté ; accepter, consentir à</text></gloss>
      <gloss lang="en"><text>be accepted, be approved; agree to, accept</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="7.4.2 Receive"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.34.23; Childs 2000, p. 41: cèlnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de cɛlɔɔ « accepter ». haliko mo cɛlnun « afin qu'il soit agréé » (LEV.1.4) ; n cɛlnun sɔɛi nda dimi-e « consentons à ce qu'ils disent » (GEN.34.23).</text></form></note>
  </entry>
  <entry id="cɛlɔɔ_603">
    <lexical-unit><form lang="kqs"><text>cɛlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛl</text></form></variant>
    <variant><form lang="kqs"><text>cɛlnin</text></form></variant>
    <sense id="cɛlɔɔ_603_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accepter ; accepter, consentir ; écouter, obéir à</text></gloss>
      <gloss lang="en"><text>accept ; accept, agree; listen to, obey</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.2 Receive"/>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>agree (to), concur</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.17.14; Keita 1979, p. 114: Tyèlöö; Childs 2000, p. 41: cɛ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɛlɛkpɔɔ_604">
    <lexical-unit><form lang="kqs"><text>cɛlɛkpɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="cɛlɛkpɔɔ_604_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bébé, petit enfant ; jeune garçon</text></gloss>
      <gloss lang="en"><text>baby, small child; young boy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.4.23; Keita 1979, p. 148: Tyèlèkpöö</text></form></note>
  </entry>
  <entry id="cɛlɛkpɛ_605">
    <lexical-unit><form lang="kqs"><text>cɛlɛkpɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɛlɛkpɛa</text></form></field>
    <sense id="cɛlɛkpɛ_605_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nouveau-né, bébé</text></gloss>
      <gloss lang="en"><text>newborn, baby</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>newborn boy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first EXO.1.16; Childs 2000, p. 41: cèlèkpíá</text></form></note>
  </entry>
  <entry id="cɛngilen_606">
    <lexical-unit><form lang="kqs"><text>cɛngilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="cɛngilen_606_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canne à sucre</text></gloss>
      <gloss lang="en"><text>sugar cane</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tyèngilen; Childs 2000, p. 41: cɛ̀ŋgìléŋ</text></form></note>
  </entry>
  <entry id="cɛ̀wnun_607">
    <lexical-unit><form lang="kqs"><text>cɛ̀wnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛwnɔnndo</text></form></variant>
    <sense id="cɛ̀wnun_607_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir, être guéri</text></gloss>
      <gloss lang="en"><text>be healed, recover</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.28.35</text></form></note>
    <note><form lang="fr"><text>Moyen de cɛwvo. piɔŋnda cɛ̀wnun te lan « des ulcères incurables » (Dt 28,35).</text></form></note>
  </entry>
  <entry id="cɛwvo_608">
    <lexical-unit><form lang="kqs"><text>cɛwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛw</text></form></variant>
    <variant><form lang="kqs"><text>cɛwnin</text></form></variant>
    <sense id="cɛwvo_608_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir, soigner</text></gloss>
      <gloss lang="en"><text>heal, cure</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>treat, cure; save (make survive after being near death)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first 2KI.8.29; Childs 2000, p. 50: cìɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Homonyme de cɛwvo « arc » (Keita). Le rapprochement de forme avec Childs est probable mais non certain.</text></form></note>
  </entry>
  <entry id="cɛwvo_609">
    <lexical-unit><form lang="kqs"><text>cɛwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="cɛwvo_609_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arc (Keita)</text></gloss>
      <gloss lang="en"><text>bow (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bow (weapon); comb for carding cotton</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Tyèwvo; Childs 2000, p. 50: cìɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Childs confirme le sens « arc ». Mais la Bible dit kpaasiaa pour l'arc (Gn 27,3), et cɛwvo n'y apparaît qu'en 2 R 8,29 ; 9,15 ; 2 Ch 22,6, avec un autre sens.</text></form></note>
  </entry>
  <entry id="cɛŋio_610">
    <lexical-unit><form lang="kqs"><text>cɛŋio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɛŋio_610_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire pleurer</text></gloss>
      <gloss lang="en"><text>make cry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cause to cry</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Tyènhio; Childs 2000, p. 42: cɛ̀ŋìóó</text></form></note>
    <note><form lang="fr"><text>Causatif de caŋndo. Forme attestée dans la Bible : cɛŋi (JOB 34,28).</text></form></note>
  </entry>
  <entry id="cɛɔ_611">
    <lexical-unit><form lang="kqs"><text>cɛɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɛa</text></form></field>
    <variant><form lang="kqs"><text>cɛ</text></form></variant>
    <sense id="cɛɔ_611_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>esclave, serviteur</text></gloss>
      <gloss lang="en"><text>slave, servant</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.21.10; Keita 1979, p. 148: Tyèw; Childs 2000, p. 50: cìɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tyèw ; la Bible a cɛɔ (pluriel cɛa). Dans la Bible, cɛw est un verbe, « soigner » (Ex 21,19).</text></form></note>
  </entry>
  <entry id="cɛɛlian_612">
    <lexical-unit><form lang="kqs"><text>cɛɛlian</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cɛɛlan</text></form></variant>
    <sense id="cɛɛlian_612_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être voisin, être à côté (de) ; (vanaa … cɛɛlan-nda) les voisins</text></gloss>
      <gloss lang="en"><text>be next to, be neighbours; (vanaa … cɛɛlan-nda) neighbours</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.4 Neighbor"/>
    </sense>
  </entry>
  <entry id="cɛɛlun_613">
    <lexical-unit><form lang="kqs"><text>cɛɛlun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛɛlɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>cɛɛlunnin</text></form></variant>
    <sense id="cɛɛlun_613_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber, s'abattre ; tomber (au combat)</text></gloss>
      <gloss lang="en"><text>fall, drop; fall (in battle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first DEU.28.40</text></form></note>
    <note><form lang="fr"><text>Moyen de cɛɛluu.</text></form></note>
  </entry>
  <entry id="cɛɛluu_614">
    <lexical-unit><form lang="kqs"><text>cɛɛluu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛɛluuo</text></form></variant>
    <variant><form lang="kqs"><text>cɛɛluunin</text></form></variant>
    <sense id="cɛɛluu_614_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber, abattre ; tomber goutte à goutte (rosée)</text></gloss>
      <gloss lang="en"><text>bring down, fell; drip, fall (dew)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first NUM.21.30</text></form></note>
  </entry>
  <entry id="cɛɛŋaa_615">
    <lexical-unit><form lang="kqs"><text>cɛɛŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛɛŋa</text></form></variant>
    <sense id="cɛɛŋaa_615_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aiguiser, affûter</text></gloss>
      <gloss lang="en"><text>sharpen</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
