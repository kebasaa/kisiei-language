  <entry id="sɛ̀ɛ̀lììyó_3227">
    <lexical-unit><form lang="kqs"><text>sɛ̀ɛ̀lììyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɛ̀ɛ̀lììyó_3227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz mou, en bouillie</text></gloss>
      <gloss lang="en"><text>soft, mushy rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 325: sɛ̀ɛ̀lììyó</text></form></note>
  </entry>
  <entry id="sɛɛluu_3228">
    <lexical-unit><form lang="kqs"><text>sɛɛluu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɛɛluu_3228_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>racler, gratter (les murs)</text></gloss>
      <gloss lang="en"><text>scrape (walls)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scrape, sharpen, plane (plural of 'scrape')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.14.41; Childs 2000, p. 325: sɛ̀ɛ̀lùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de salɔɔ « peler ». sɛɛluu cìì cɛiyo lenin kpow « il fera racler tout l'intérieur de la maison » (LEV.14.41).</text></form></note>
  </entry>
  <entry id="sɛ́ɛ́n_3229">
    <lexical-unit><form lang="kqs"><text>sɛ́ɛ́n</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɛ́ɛ́n_3229_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(vesa sɛ́ɛ́n) complètement sec</text></gloss>
      <gloss lang="en"><text>(vesa sɛ́ɛ́n) completely dry</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) describes dryness, or the thinness of a person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.8.14; Childs 2000, p. 326: séɛ́ŋ</text></form></note>
  </entry>
  <entry id="sɛ̀ɛ̀ndíɔ́ɔ́_3230">
    <lexical-unit><form lang="kqs"><text>sɛ̀ɛ̀ndíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sɛ̀ɛ̀ndɛ́ɛ́láŋ</text></form></field>
    <sense id="sɛ̀ɛ̀ndíɔ́ɔ́_3230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palourde, coquillage d'eau douce</text></gloss>
      <gloss lang="en"><text>clam</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 326: sɛ̀ɛ̀ndíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="sɛɛngianndo_3231">
    <lexical-unit><form lang="kqs"><text>sɛɛngianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛngian</text></form></variant>
    <variant><form lang="kqs"><text>sɛɛngiaa</text></form></variant>
    <variant><form lang="kqs"><text>sɛɛngianndan</text></form></variant>
    <sense id="sɛɛngianndo_3231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se disputer, discuter ; dispute, querelle</text></gloss>
      <gloss lang="en"><text>quarrel, argue, debate; dispute, strife</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of sèŋìá 'argue': disagree repeatedly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.13.7; Childs 2000, p. 326: sèèŋìá</text></form></note>
  </entry>
  <entry id="sɛɛsaa_3232">
    <lexical-unit><form lang="kqs"><text>sɛɛsaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛsa</text></form></variant>
    <sense id="sɛɛsaa_3232_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déchirer</text></gloss>
      <gloss lang="en"><text>tear</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tear, rip apart; relate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ECC.3.7; Keita 1979, p. 113: Sèèsaa; Childs 2000, p. 326: sɛ̀ɛ̀sàá</text></form></note>
  </entry>
  <entry id="sɛɛsiaa_3233">
    <lexical-unit><form lang="kqs"><text>sɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛsian</text></form></variant>
    <sense id="sɛɛsiaa_3233_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déchirer (en morceaux, plusieurs fois)</text></gloss>
      <gloss lang="en"><text>tear (to pieces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.37.29; Keita 1979, p. 113: Sèèsiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɛɛsaa ; sɛɛsiaa volɔɔla « déchirer ses vêtements » (GEN 37,29).</text></form></note>
  </entry>
  <entry id="sɛɛsuu_3234">
    <lexical-unit><form lang="kqs"><text>sɛɛsuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛɛsuunin</text></form></variant>
    <variant><form lang="kqs"><text>sɛɛsun</text></form></variant>
    <sense id="sɛɛsuu_3234_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>traîner, entraîner (de force) ; (sɛɛsun) se retirer à l'écart</text></gloss>
      <gloss lang="en"><text>drag, drag away; (sɛɛsun) withdraw, go off apart</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drag, haul (plural of 'drag')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZK.32.20; Childs 2000, p. 327: sɛ̀ɛ̀sùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de sasɔɔ « traîner ». mì sɛɛsuu nɔm « je t'entraînerai » (EZK.38.4) ; a sɛɛsuunin niaa a bawla n'cilinndan « on vous traînera avec des crochets » (AMO.4.2) ; Mó sɛɛsun a nda lándán « il se retira avec eux à l'écart » (LUK.9.10).</text></form></note>
  </entry>
  <entry id="sɛɛviaa_3235">
    <lexical-unit><form lang="kqs"><text>sɛɛviaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sɛɛviaa_3235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gribouiller</text></gloss>
      <gloss lang="en"><text>scribble</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sèèviaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɛvaa.</text></form></note>
