      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bear (a child)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 62 occurrences, first GEN.6.1; Keita 1979, p. 115: Violöö; Childs 2000, p. 386: wìòlɔ̀ɔ́</text></form></note>
