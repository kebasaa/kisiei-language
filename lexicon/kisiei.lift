  <entry id="ŋɔvɔɔ_4965">
    <lexical-unit><form lang="kqs"><text>ŋɔvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ŋɔw</text></form></variant>
    <variant><form lang="kqs"><text>ŋɔaw</text></form></variant>
    <variant><form lang="kqs"><text>ŋɔawnin</text></form></variant>
    <sense id="ŋɔvɔɔ_4965_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>serrer, presser ; se serrer, se frayer un chemin (dans la foule)</text></gloss>
      <gloss lang="en"><text>squeeze, press; squeeze through, push one's way (through a crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze, press</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PRO.16.26; Keita 1979, p. 115: Nhövöö; Lexique kissi–français, p. 40: ŋɔvɔɔ/ ŋɔw, ŋow, ŋɔaw; Childs 2000, p. 271: ŋɔ̀ùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi : ŋow.</text></form></note>
  </entry>
