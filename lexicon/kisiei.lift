  <entry id="delian_324">
    <lexical-unit><form lang="kqs"><text>delian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="delian_324_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber (grêle)</text></gloss>
      <gloss lang="en"><text>make fall, rain down (hail)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.9</text></form></note>
    <note><form lang="fr"><text>Dérivé de delaa « tomber ».</text></form></note>
  </entry>
  <entry id="delio_325">
    <lexical-unit><form lang="kqs"><text>delio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deli</text></form></variant>
    <variant><form lang="kqs"><text>delinin</text></form></variant>
    <sense id="delio_325_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber çà et là, tomber en nombre</text></gloss>
      <gloss lang="en"><text>fall here and there, fall in numbers</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.9.18; Keita 1979, p. 110: Delio</text></form></note>
    <note><form lang="fr"><text>Pluriel de delɔɔ (grêle qui tombe, EXO 9,18).</text></form></note>
  </entry>
  <entry id="delɔɔ_326">
    <lexical-unit><form lang="kqs"><text>delɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>del</text></form></variant>
    <variant><form lang="kqs"><text>delnin</text></form></variant>
    <sense id="delɔɔ_326_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber</text></gloss>
      <gloss lang="en"><text>fall</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fall, drop</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 206 occurrences, first GEN.15.12; Keita 1979, p. 110: Delöö; Childs 2000, p. 72: dèlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="delɔɔcoo_327">
    <lexical-unit><form lang="kqs"><text>delɔɔcoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="delɔɔcoo_327_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>violence, oppression, agression</text></gloss>
      <gloss lang="en"><text>violence, oppression, aggression</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first DEU.25.16; Keita 1979, p. 148: Delöötyoo</text></form></note>
  </entry>
  <entry id="demboo_328">
    <lexical-unit><form lang="kqs"><text>demboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dembe</text></form></variant>
    <sense id="demboo_328_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ventre, estomac ; sein (maternel)</text></gloss>
      <gloss lang="en"><text>belly, stomach ; belly; womb</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first LEV.11.42; Keita 1979, p. 131: Demboo; Childs 2000, p. 73: dèmbòó</text></form></note>
  </entry>
  <entry id="demullo_329">
    <lexical-unit><form lang="kqs"><text>demullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>demul</text></form></variant>
    <sense id="demullo_329_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller à la rencontre de ; en face de</text></gloss>
      <gloss lang="en"><text>go to meet; facing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>embrace</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.18.2; Childs 2000, p. 73: dèmùlló</text></form></note>
  </entry>
  <entry id="dendu_330">
    <lexical-unit><form lang="kqs"><text>dendu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dendu_330_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pur, net ; éclatant</text></gloss>
      <gloss lang="en"><text>pure, clean; bright</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first GEN.7.8</text></form></note>
    <note><form lang="fr"><text>Lv 11,47 oppose ɲɛ dendu et ɲɛ dindu ; la répartition des sens « pur / impur » reste à vérifier.</text></form></note>
  </entry>
  <entry id="dengadengiaa_331">
    <lexical-unit><form lang="kqs"><text>dengadengiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dengadengiaa_331_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>superposer</text></gloss>
      <gloss lang="en"><text>stack, pile up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Denga dengiaa</text></form></note>
    <note><form lang="fr"><text>Keita écrit en deux mots.</text></form></note>
  </entry>
  <entry id="déŋ_332">
    <lexical-unit><form lang="kqs"><text>déŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="déŋ_332_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>au beau milieu, en plein (tɛɛn déŋ ; pala déŋ « en plein midi »)</text></gloss>
      <gloss lang="en"><text>right (in the middle), exactly (tɛɛn déŋ 'in the very middle'; pala déŋ 'at noon')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.2.9</text></form></note>
  </entry>
  <entry id="deŋio_333">
    <lexical-unit><form lang="kqs"><text>deŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deŋi</text></form></variant>
    <variant><form lang="kqs"><text>deŋinin</text></form></variant>
    <sense id="deŋio_333_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier, s'écrier ; gronder (tonnerre)</text></gloss>
      <gloss lang="en"><text>cry out, shout; thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>yell, shout, scream</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first EXO.9.29; Keita 1979, p. 110: Denhio; Childs 2000, p. 74: dèŋìó</text></form></note>
  </entry>
  <entry id="dialii_334">
    <lexical-unit><form lang="kqs"><text>dialii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>diallon</text></form></field>
    <variant><form lang="kqs"><text>dialun</text></form></variant>
    <sense id="dialii_334_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre, partie du corps ; chair ; (pl.) le corps</text></gloss>
      <gloss lang="en"><text>limb, part of the body; flesh; (pl.) the body</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>body; also health, condition, skin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.2.23; Childs 2000, p. 76: ɗìàllé</text></form></note>
  </entry>
  <entry id="diam_335">
    <lexical-unit><form lang="kqs"><text>diam</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dem</text></form></variant>
    <sense id="diam_335_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rejoindre ; suivre, poursuivre ; (diam fuɲaa … ciee-piɔ́m) rejoindre ses pères (mourir)</text></gloss>
      <gloss lang="en"><text>join; follow, pursue; (diam fuɲaa … ciee-piɔ́m) be gathered to one's fathers (die)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.5 Accompany"/>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.14.14</text></form></note>
    <note><form lang="fr"><text>dem : te i dem pɛ fuɲaa niaa « quand je reposerai avec mes pères » (Gn 47,30).</text></form></note>
  </entry>
  <entry id="diandaa_336">
    <lexical-unit><form lang="kqs"><text>diandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandan</text></form></variant>
    <variant><form lang="kqs"><text>diandɛi</text></form></variant>
    <variant><form lang="kqs"><text>diandaalan</text></form></variant>
    <sense id="diandaa_336_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>saint, consacré ; pur</text></gloss>
      <gloss lang="en"><text>holy, consecrated; pure</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 972 occurrences, first GEN.6.9; Childs 2000, p. 77: ɗìàndà-</text></form></note>
  </entry>
  <entry id="dii_337">
    <lexical-unit><form lang="kqs"><text>dii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diinin</text></form></variant>
    <sense id="dii_337_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 567 occurrences, first GEN.4.8; Childs 2000, p. 78: ɗìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diimandɔɔ_338">
    <lexical-unit><form lang="kqs"><text>diimandɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diimandɔ</text></form></variant>
    <sense id="diimandɔɔ_338_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le lendemain</text></gloss>
      <gloss lang="en"><text>the next day</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the coming day, tomorrow morning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 119 occurrences, first GEN.19.34; Childs 2000, p. 78: dìímàndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diinndɔɔ_339">
    <lexical-unit><form lang="kqs"><text>diinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinndɔɔ_339_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>deuxième</text></gloss>
      <gloss lang="en"><text>second</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>two; second</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.4.19; Childs 2000, p. 79: dìíŋ</text></form></note>
  </entry>
  <entry id="diinɔnndo_340">
    <lexical-unit><form lang="kqs"><text>diinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinɔnndo_340_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tuer</text></gloss>
      <gloss lang="en"><text>kill oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ZEC.11.4; Keita 1979, p. 110: Diinönndo; Childs 2000, p. 78: dììnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de diyɔɔ (ACT 16,27). Ne pas confondre avec diinun « se rassembler » (GEN 1,9).</text></form></note>
  </entry>
  <entry id="dillo_341">
    <lexical-unit><form lang="kqs"><text>dillo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dillo_341_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger pour quelqu'un</text></gloss>
      <gloss lang="en"><text>eat for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Dillo</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de dioo.</text></form></note>
  </entry>
  <entry id="dimi_342">
    <lexical-unit><form lang="kqs"><text>dimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimin</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimi_342_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire</text></gloss>
      <gloss lang="en"><text>say</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2652 occurrences, first GEN.1.3; Childs 2000, p. 80: ɗìmìó</text></form></note>
    <note><form lang="fr"><text>Forme longue dimio (« kon co dimio ni aa » « ce qui veut dire »).</text></form></note>
  </entry>
  <entry id="dimio_343">
    <lexical-unit><form lang="kqs"><text>dimio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimi</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimio_343_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire</text></gloss>
      <gloss lang="en"><text>say</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>say, tell, speak</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 890 occurrences, first GEN.3.20; Keita 1979, p. 110: Dimio; Childs 2000, p. 80: dìmìó</text></form></note>
    <note><form lang="fr"><text>Bénéfactif dimul « dire à ».</text></form></note>
  </entry>
  <entry id="dimulan_344">
    <lexical-unit><form lang="kqs"><text>dimulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dimulan_344_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se dire, se parler (l'un à l'autre)</text></gloss>
      <gloss lang="en"><text>say to one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.11.3</text></form></note>
    <note><form lang="fr"><text>Réciproque de dimullo « dire à ».</text></form></note>
  </entry>
  <entry id="dimullo_345">
    <lexical-unit><form lang="kqs"><text>dimullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimul</text></form></variant>
    <variant><form lang="kqs"><text>dimulnin</text></form></variant>
    <sense id="dimullo_345_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire à, parler à</text></gloss>
      <gloss lang="en"><text>say to, tell</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 338 occurrences, first GEN.17.3; Childs 2000, p. 81: ɗìmùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de dimi « dire ».</text></form></note>
  </entry>
  <entry id="dinaa_346">
    <lexical-unit><form lang="kqs"><text>dinaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="dinaa_346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>religion</text></gloss>
      <gloss lang="en"><text>religion</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ACT.17.22; Keita 1979, p. 150: Dinaa</text></form></note>
    <note><form lang="fr"><text>Keita : « la religion musulmane ».</text></form></note>
  </entry>
  <entry id="dindiannde_347">
    <lexical-unit><form lang="kqs"><text>dindiannde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindianndan</text></form></variant>
    <sense id="dindiannde_347_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>de purification (faleŋii dindiannde « sacrifice pour le péché »)</text></gloss>
      <gloss lang="en"><text>of purification (faleŋii dindiannde 'sin offering')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be cleaned (causative middle of dìòndɔ̀ɔ́ 'be clean')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.29.27; Childs 2000, p. 81: dìndíŋndó</text></form></note>
    <note><form lang="fr"><text>Forme d'accord de classe i ; classe an : mɛmma dindianndan « eau de purification » (Nb 8,7). Dérivé causatif de diondɔɔ.</text></form></note>
  </entry>
  <entry id="dindin_348">
    <lexical-unit><form lang="kqs"><text>dindin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindinndo</text></form></variant>
    <variant><form lang="kqs"><text>dindinin</text></form></variant>
    <sense id="dindin_348_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se purifier, se sanctifier</text></gloss>
      <gloss lang="en"><text>purify oneself, consecrate oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.35.2</text></form></note>
    <note><form lang="fr"><text>Moyen de dindio « purifier ».</text></form></note>
  </entry>
  <entry id="dindio_349">
    <lexical-unit><form lang="kqs"><text>dindio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindi</text></form></variant>
    <variant><form lang="kqs"><text>dindinin</text></form></variant>
    <sense id="dindio_349_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre propre, purifier ; purifier, sanctifier</text></gloss>
      <gloss lang="en"><text>make clean, purify ; purify, sanctify</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make clean (causative of 'be clean')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.29.36; Keita 1979, p. 110: Dindindio; Childs 2000, p. 81: dìndìó</text></form></note>
    <note><form lang="fr"><text>Keita écrit dindindio (radical dindin) ; la Bible a dindio, dindi « purifier », et le moyen dindin, dindinndo « se purifier, se laver ».</text></form></note>
  </entry>
  <entry id="dindu_350">
    <lexical-unit><form lang="kqs"><text>dindu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dindu_350_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pur (rituellement) ; clair</text></gloss>
      <gloss lang="en"><text>clean (ritually); clear</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.7.2; Childs 2000, p. 81: ɗìòndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diolan_351">
    <lexical-unit><form lang="kqs"><text>diolan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diola</text></form></variant>
    <sense id="diolan_351_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nom ; renom</text></gloss>
      <gloss lang="en"><text>name; renown</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 601 occurrences, first GEN.1.5; Childs 2000, p. 82: ɗìòláŋ</text></form></note>
  </entry>
  <entry id="diomndo_352">
    <lexical-unit><form lang="kqs"><text>diomndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>diomndan</text></form></field>
    <variant><form lang="kqs"><text>diom</text></form></variant>
    <variant><form lang="kqs"><text>diomnda</text></form></variant>
    <sense id="diomndo_352_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voix, son ; parole ; langue</text></gloss>
      <gloss lang="en"><text>voice, sound; word; language</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>voice, word; also advice, answer, promise; abuse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 121 occurrences, first GEN.27.22; Childs 2000, p. 82: ɗìòmndó</text></form></note>
  </entry>
  <entry id="diondɔɔ_353">
    <lexical-unit><form lang="kqs"><text>diondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandu</text></form></variant>
    <variant><form lang="kqs"><text>diandunin</text></form></variant>
    <variant><form lang="kqs"><text>diondu</text></form></variant>
    <sense id="diondɔɔ_353_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être pur, devenir propre ; briller, être blanc ; (nom) éclat, blancheur, gloire</text></gloss>
      <gloss lang="en"><text>be clean, become pure; shine, be white; (noun) brightness, whiteness, glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be clean, shine, be white; fade (Childs lists dendu, diandu, dindu as forms)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.1.16; Childs 2000, p. 83: dìòndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Nom verbal : sina diondɔɔ ndɔɔ « connaître sa gloire » (Lv 10,3) ; hiow diondɔɔ « plus blanc » (Gn 49,12). diandu « se purifier » (Esd 6,20). Cf. diandaa « saint, pur ».</text></form></note>
  </entry>
  <entry id="dioo_354">
    <lexical-unit><form lang="kqs"><text>dioo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dio</text></form></variant>
    <variant><form lang="kqs"><text>de</text></form></variant>
    <variant><form lang="kqs"><text>dia</text></form></variant>
    <variant><form lang="kqs"><text>di</text></form></variant>
    <variant><form lang="kqs"><text>dianin</text></form></variant>
    <variant><form lang="kqs"><text>dinin</text></form></variant>
    <sense id="dioo_354_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger</text></gloss>
      <gloss lang="en"><text>eat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>eat, consume, use up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 452 occurrences, first GEN.2.9; Keita 1979, p. 116: Dioo; Childs 2000, p. 82: dìó</text></form></note>
    <note><form lang="fr"><text>di, dinin : radical négatif.</text></form></note>
  </entry>
  <entry id="diuvaa_355">
    <lexical-unit><form lang="kqs"><text>diuvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diuvaa_355_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer, massacrer (vanaa diuvaa n'vannda « les meurtriers »)</text></gloss>
      <gloss lang="en"><text>kill, slaughter (vanaa diuvaa n'vannda 'murderers')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first PSA.5.7</text></form></note>
    <note><form lang="fr"><text>Sans doute dérivé (pluriel) de dii « tuer ».</text></form></note>
  </entry>
  <entry id="diuvan_356">
    <lexical-unit><form lang="kqs"><text>diuvan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diuvanndo</text></form></variant>
    <sense id="diuvan_356_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entretuer</text></gloss>
      <gloss lang="en"><text>kill one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JDG.7.22</text></form></note>
    <note><form lang="fr"><text>Réciproque de diuvaa.</text></form></note>
  </entry>
  <entry id="diwvo_357">
    <lexical-unit><form lang="kqs"><text>diwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diw</text></form></variant>
    <variant><form lang="kqs"><text>diwnin</text></form></variant>
    <sense id="diwvo_357_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer (en nombre), massacrer</text></gloss>
      <gloss lang="en"><text>kill (many), slaughter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first EXO.5.21</text></form></note>
    <note><form lang="fr"><text>diw s'emploie surtout pour plusieurs victimes ; voir dii « tuer ».</text></form></note>
  </entry>
  <entry id="diyɔɔ_358">
    <lexical-unit><form lang="kqs"><text>diyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dii</text></form></variant>
    <sense id="diyɔɔ_358_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.25.32; Keita 1979, p. 110: Diyöö; Childs 2000, p. 85: dìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diyɔɔ koya_359">
    <lexical-unit><form lang="kqs"><text>diyɔɔ koya</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="diyɔɔ koya_359_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Diyöö koya</text></form></note>
    <note><form lang="fr"><text>diyɔɔ « fait de tuer » est attesté ; koya n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="diyɔɔkoyaa_360">
    <lexical-unit><form lang="kqs"><text>diyɔɔkoyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diyɔɔkoyaa_360_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Diyöökoyaa</text></form></note>
    <note><form lang="fr"><text>Contient diyɔɔ « tuer », attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="diɔmndo_361">
    <lexical-unit><form lang="kqs"><text>diɔmndo</text></form></lexical-unit>
