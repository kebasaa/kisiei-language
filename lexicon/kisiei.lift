  <entry id="fó-fó_871">
    <lexical-unit><form lang="kqs"><text>fó-fó</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fo-fo</text></form></variant>
    <sense id="fó-fó_871_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout à fait, entièrement ; (blanc) éclatant ; complètement, tout à fait ; (humbu fo-fo) tout blanc</text></gloss>
      <gloss lang="en"><text>completely, thoroughly; (white) as snow; completely, thoroughly; (humbu fo-fo) pure white</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>all, completely, thoroughly, very</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first EXO.4.6; Childs 2000, p. 107: fó</text></form></note>
    <note><form lang="fr"><text>humbu fo-fo « tout blanc » (Ex 4,6) ; diandaa fó-fó « parfaitement saint ». o diandaa fó-fó « (je suis) saint » (LEV.19.2) ; humbu fo-fo maa fengbɔ « blanc comme la neige » (EXO.4.6) ; la dindin fó-fó « purifiez-vous » (ISA.52.11).</text></form></note>
  </entry>
  <entry id="foeende_872">
