      <gloss lang="en"><text>woman separated from her husband</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sengɔɔ</text></form></note>
  </entry>
  <entry id="seo_4498">
