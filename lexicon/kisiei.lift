  <entry id="pó_2651">
    <lexical-unit><form lang="kqs"><text>pó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pó_2651_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un choc, d'un objet qui frappe ; complètement, tout à fait</text></gloss>
      <gloss lang="en"><text>sound of an impact; completely, totally</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 305: pó</text></form></note>
