    <sense id="cokaacoo_462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crapaud</text></gloss>
      <gloss lang="en"><text>toad</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>toad, frog</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyokaatyoo; Childs 2000, p. 51: còkáácòó</text></form></note>
  </entry>
  <entry id="cólló_463">
    <lexical-unit><form lang="kqs"><text>cólló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cóltáŋ</text></form></field>
    <sense id="cólló_463_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-ventre ; (pl.) estomacs</text></gloss>
      <gloss lang="en"><text>lower stomach; (pl.) stomachs</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: cólló</text></form></note>
  </entry>
  <entry id="còmbèí_464">
    <lexical-unit><form lang="kqs"><text>còmbèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còmbǎŋ</text></form></field>
    <sense id="còmbèí_464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>organes génitaux féminins (mot évité en présence d'hommes)</text></gloss>
      <gloss lang="en"><text>female genitals (word avoided in mixed company)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: còmbèí</text></form></note>
  </entry>
  <entry id="condei_465">
    <lexical-unit><form lang="kqs"><text>condei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>condon</text></form></field>
    <variant><form lang="kqs"><text>condii</text></form></variant>
    <variant><form lang="kqs"><text>condun</text></form></variant>
    <sense id="condei_465_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chant, cantique</text></gloss>
      <gloss lang="en"><text>song</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first EXO.15; Childs 2000, p. 51: còndúŋ</text></form></note>
  </entry>
  <entry id="condu_466">
    <lexical-unit><form lang="kqs"><text>condu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="condu_466_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chanter</text></gloss>
      <gloss lang="en"><text>sing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first DEU.31; Childs 2000, p. 51: còndèí</text></form></note>
    <note><form lang="fr"><text>La solul Hala condon, la condu ! « chantez à Dieu, chantez ! » (PSA.47.7) ; voir condei « chant ».</text></form></note>
  </entry>
  <entry id="congòó_467">
    <lexical-unit><form lang="kqs"><text>congòó</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>congu</text></form></variant>
    <variant><form lang="kqs"><text>cóngù</text></form></variant>
    <sense id="congòó_467_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>médire de, calomnier, dénigrer</text></gloss>
      <gloss lang="en"><text>slander, speak ill of, backbite</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, backbite; send a message; bid farewell; bet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.49.15; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>la cal puapilɛa niaa congòó « tu dénigres tes frères » (PSA.50.20) ; La cóngù vanaa niaa ... le « ne calomnie pas » (LEV.19.16) ; la congan vellaa-velle le « ne médisez pas les uns des autres » (JAS.4.11). Voir congɔnndo « prendre congé ».</text></form></note>
  </entry>
  <entry id="congoo_468">
    <lexical-unit><form lang="kqs"><text>congoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>congulan</text></form></field>
    <variant><form lang="kqs"><text>congú</text></form></variant>
    <sense id="congoo_468_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épaule</text></gloss>
      <gloss lang="en"><text>shoulder</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shoulder, upper arm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.49.15; Keita 1979, p. 132: Tyonguo; Childs 2000, p. 52: còŋgóó</text></form></note>
    <note><form lang="fr"><text>o congú « sur l'épaule » (Gn 21,14).</text></form></note>
  </entry>
  <entry id="congulan_469">
    <lexical-unit><form lang="kqs"><text>congulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congulan_469_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médisances, calomnies</text></gloss>
      <gloss lang="en"><text>slander, malicious gossip</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.28.7; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>Pluriel de congòó. À distinguer de congúlan « épaules ».</text></form></note>
  </entry>
  <entry id="congɔnndo_470">
    <lexical-unit><form lang="kqs"><text>congɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congɔnndo_470_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre congé (de), dire adieu ; envoyer un message</text></gloss>
      <gloss lang="en"><text>take leave (of), bid farewell; send a message</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, backbite; send a message; bid farewell, wave goodbye; bet, gamble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.28.6; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>le X congɔnndo « pour prendre congé de X » ; David yɔngu congɔnndo « David envoya un message » (2 S 11,6). Réciproque congan « se dire adieu » (Ac 21,6), « médire les uns des autres » (Jc 4,11).</text></form></note>
  </entry>
  <entry id="congɔɔ_471">
    <lexical-unit><form lang="kqs"><text>congɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congɔɔ_471_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder (un animal confié)</text></gloss>
      <gloss lang="en"><text>keep (livestock entrusted to one), look after</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>keep or raise livestock for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EXO.22.9; Childs 2000, p. 52: còŋgɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cɔlu súú-súù congɔɔ « tout animal confié à garder » (EXO.22.9). Seule occurrence.</text></form></note>
  </entry>
  <entry id="connun_472">
    <lexical-unit><form lang="kqs"><text>connun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="connun_472_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se porter bien ; être en repos</text></gloss>
      <gloss lang="en"><text>be well; be at rest</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.43.28</text></form></note>
  </entry>
  <entry id="coo_473">
    <lexical-unit><form lang="kqs"><text>coo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coo_473_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sur (o … coo)</text></gloss>
      <gloss lang="en"><text>on (o … coo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7185 occurrences, first GEN.1.2; Childs 2000, p. 53: còó</text></form></note>
  </entry>
  <entry id="còó_474">
    <lexical-unit><form lang="kqs"><text>còó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còó_474_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel, temps (météo) ; art de grimper aux palmiers</text></gloss>
      <gloss lang="en"><text>sky, weather; the art of climbing palm trees</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còó</text></form></note>
  </entry>
  <entry id="coocoo_475">
    <lexical-unit><form lang="kqs"><text>coocoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coocoo_475_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en haut, au-dessus, dans les airs</text></gloss>
      <gloss lang="en"><text>up, above, in the air</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>far up; also loudly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 313 occurrences, first GEN.1.20; Childs 2000, p. 53: cóó-cóó</text></form></note>
  </entry>
  <entry id="còòlan_476">
    <lexical-unit><form lang="kqs"><text>còòlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="còòlan_476_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mensonge(s)</text></gloss>
      <gloss lang="en"><text>lies, falsehood</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 108 occurrences, first GEN.42.12; Childs 2000, p. 53: còòláŋ</text></form></note>
  </entry>
  <entry id="còòlúŋndó_477">
    <lexical-unit><form lang="kqs"><text>còòlúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còòlúŋndó_477_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre très inflammable (écorce contre la toux et pour des remèdes)</text></gloss>
      <gloss lang="en"><text>highly flammable tree (bark used against cough and in potions)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còòlúŋndó</text></form></note>
  </entry>
  <entry id="còòmáánɔ̀ɔ́_478">
    <lexical-unit><form lang="kqs"><text>còòmáánɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còòmáánɔ̀ɔ́_478_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur de sorciers</text></gloss>
      <gloss lang="en"><text>witch hunter, one who kills witches</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còòmáánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="còòwàá_479">
    <lexical-unit><form lang="kqs"><text>còòwàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="còòwàá_479_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vanter, fanfaronner</text></gloss>
      <gloss lang="en"><text>boast, brag, show off</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còòwàá</text></form></note>
  </entry>
  <entry id="còòwó_480">
    <lexical-unit><form lang="kqs"><text>còòwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còòwáŋ</text></form></field>
    <sense id="còòwó_480_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à baies rouges comestibles (tiges pour filets de pêche)</text></gloss>
      <gloss lang="en"><text>plant with edible red berries (stems used for fishing nets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còòwó</text></form></note>
  </entry>
  <entry id="còpìó_481">
    <lexical-unit><form lang="kqs"><text>còpìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còpìá</text></form></field>
    <sense id="còpìó_481_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil (arboricole)</text></gloss>
      <gloss lang="en"><text>tree squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còpìó</text></form></note>
  </entry>
  <entry id="còúléŋ_482">
    <lexical-unit><form lang="kqs"><text>còúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còúwé</text></form></field>
    <sense id="còúléŋ_482_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre-liane à baies non comestibles (fibres pour filets)</text></gloss>
      <gloss lang="en"><text>vine-like tree with inedible berries (fibre used for nets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còúléŋ</text></form></note>
  </entry>
  <entry id="còúwó_483">
    <lexical-unit><form lang="kqs"><text>còúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còúwá</text></form></field>
    <sense id="còúwó_483_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tique</text></gloss>
      <gloss lang="en"><text>tick</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còúwó</text></form></note>
  </entry>
  <entry id="cowvo_484">
    <lexical-unit><form lang="kqs"><text>cowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cow</text></form></variant>
    <sense id="cowvo_484_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>construire, bâtir (un autel) ; fabriquer (une idole, des armes) ; créer</text></gloss>
      <gloss lang="en"><text>build (an altar); make (an idol, weapons); create</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.20.25</text></form></note>
    <note><form lang="fr"><text>Cow ya fondala-loamaa-lasálàlan tan ŋɔmmɛw « bâtis-moi sept autels » (Nb 23,1) ; ɲɛm cɔwvon cowvo « fabriquer des armes » (1 S 8,12) ; halaa cow halataala a lɛŋnden te « les dieux qui n'ont pas fait le ciel et la terre » (Jr 10,11). Homonyme de cowvo « rat palmiste » (Keita).</text></form></note>
  </entry>
  <entry id="cowvo_485">
    <lexical-unit><form lang="kqs"><text>cowvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cowvo_485_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat palmiste</text></gloss>
      <gloss lang="en"><text>ground squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large rat; opossum (Liberian English)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyowvo; Childs 2000, p. 54: còúwó</text></form></note>
    <note><form lang="fr"><text>Homonyme du verbe cowvo « construire, fabriquer » de la Bible (Ex 20,25 ; 1 S 8,12).</text></form></note>
  </entry>
  <entry id="coŋ_486">
    <lexical-unit><form lang="kqs"><text>coŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>coŋnin</text></form></variant>
    <sense id="coŋ_486_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se répandre, envahir, couvrir ; déborder</text></gloss>
      <gloss lang="en"><text>spread over, swarm, cover; overflow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, overflow; throw away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.8.2; Childs 2000, p. 52: còŋndó</text></form></note>
  </entry>
  <entry id="cóŋ-cóŋ_487">
    <lexical-unit><form lang="kqs"><text>cóŋ-cóŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cóŋ-cóŋ_487_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, en hâte</text></gloss>
      <gloss lang="en"><text>quickly, hurriedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: cóŋ-cóŋ</text></form></note>
  </entry>
  <entry id="còŋgáŋcòó_488">
    <lexical-unit><form lang="kqs"><text>còŋgáŋcòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còŋgáŋcòláŋ</text></form></field>
    <sense id="còŋgáŋcòó_488_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeu ou acrobatie à cloche-pied</text></gloss>
      <gloss lang="en"><text>game or stunt of hopping on one leg</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: còŋgáŋcòó</text></form></note>
  </entry>
  <entry id="cóŋgúéíyó_489">
    <lexical-unit><form lang="kqs"><text>cóŋgúéíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cóŋgúéíyó_489_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau émaillé (pour l'eau, le latex)</text></gloss>
      <gloss lang="en"><text>enamel bucket (for water, latex)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 52: cóŋgúéíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au mende sonɡoi (?).</text></form></note>
  </entry>
  <entry id="cóŋŋáŋ-_490">
    <lexical-unit><form lang="kqs"><text>cóŋŋáŋ-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cóŋŋáŋ-_490_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grand, haut, énorme (d'un animal)</text></gloss>
      <gloss lang="en"><text>tall, big, huge (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: cóŋŋáŋ-</text></form></note>
  </entry>
  <entry id="cû_491">
    <lexical-unit><form lang="kqs"><text>cû</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cû_491_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lourdement, durement (en tombant)</text></gloss>
      <gloss lang="en"><text>hard, heavily (of falling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cû</text></form></note>
  </entry>
  <entry id="cua_492">
    <lexical-unit><form lang="kqs"><text>cua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuaa</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <sense id="cua_492_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre ; (cua haki) commettre (un péché)</text></gloss>
      <gloss lang="en"><text>take; (cua haki) commit (a sin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take; also carry, lift; take in marriage</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1496 occurrences, first GEN.2.15; Childs 2000, p. 60: cùàá</text></form></note>
  </entry>
  <entry id="cua mamaa_493">
    <lexical-unit><form lang="kqs"><text>cua mamaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cua mamaa_493_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit-fils, petite-fille</text></gloss>
      <gloss lang="en"><text>grandchild</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Tyua mamaa; Childs 2000, p. 60: cùàà-màmàá</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs (cùàà-màmàá). Dans la Bible, mamaa désigne l'aïeul (Gn 28,13) et cuavaa-imamaa « les descendants ». Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="cúà-cúà_494">
    <lexical-unit><form lang="kqs"><text>cúà-cúà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúà-cúà_494_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du débroussaillage à la machette ; de pierres lancées une à une</text></gloss>
      <gloss lang="en"><text>sound of clearing brush with machetes; of stones thrown one by one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cúà-cúà</text></form></note>
  </entry>
  <entry id="cuaa_495">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuavaa</text></form></field>
    <variant><form lang="kqs"><text>cuawva</text></form></variant>
    <sense id="cuaa_495_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant ; la femme (dont on parle) ; (pl.) enfants, descendants</text></gloss>
      <gloss lang="en"><text>child; the woman (in question); (pl.) children, descendants</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl, daughter, young woman, woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 270 occurrences, first GEN.3.13; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>Au singulier, la Bible emploie cuaa surtout pour « la femme » dont il est question (Gn 3,13 ; 1 S 1,26 ; 2 R 8,6) ; le pluriel cuavaa / cuawva signifie « enfants, descendants ». À vérifier auprès de locuteurs.</text></form></note>
  </entry>
  <entry id="cuaa_496">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cua</text></form></variant>
    <variant><form lang="kqs"><text>cue</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <variant><form lang="kqs"><text>cuenin</text></form></variant>
    <sense id="cuaa_496_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre</text></gloss>
      <gloss lang="en"><text>take</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take, carry or lift</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Tyuaa; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>cua est très courant (GEN 2,15) ; cue, cuenin : radical négatif. La forme longue cuaa de la Bible a surtout d'autres sens (« femme », GEN 3,13).</text></form></note>
  </entry>
  <entry id="cùààmàwùèìyó_497">
    <lexical-unit><form lang="kqs"><text>cùààmàwùèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùààmàwùèìyó_497_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à bois dur (bois de chauffe, construction)</text></gloss>
      <gloss lang="en"><text>hardwood tree (firewood, building)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmàwùèìyó</text></form></note>
  </entry>
  <entry id="cùààmbɔ́-féléŋɔ́ɔ́_498">
    <lexical-unit><form lang="kqs"><text>cùààmbɔ́-féléŋɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùààmbɔ́-féléŋɔ́ɔ́_498_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme jeune ou d'âge mûr</text></gloss>
      <gloss lang="en"><text>young to middle-aged woman</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmbɔ́-féléŋɔ́ɔ́</text></form></note>
  </entry>
  <entry id="cuaambɔyɛi_499">
    <lexical-unit><form lang="kqs"><text>cuaambɔyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="cuaambɔyɛi_499_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunesse</text></gloss>
      <gloss lang="en"><text>youth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.46.34</text></form></note>
  </entry>
  <entry id="cùààmbɔ̀yɛ́í-_500">
    <lexical-unit><form lang="kqs"><text>cùààmbɔ̀yɛ́í-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùààmbɔ̀yɛ́í-_500_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>puéril, enfantin (d'un adulte)</text></gloss>
      <gloss lang="en"><text>childish (of an adult)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmbɔ̀yɛ́í-</text></form></note>
  </entry>
  <entry id="cuaambɔɔ_501">
    <lexical-unit><form lang="kqs"><text>cuaambɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuaambɔa</text></form></field>
    <variant><form lang="kqs"><text>cuaambɔ</text></form></variant>
    <sense id="cuaambɔɔ_501_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune fille, fille ; jeune (personne) ; jeune (garçon ou fille), jeune fille</text></gloss>
      <gloss lang="en"><text>girl, young woman; young person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.16.5; Keita 1979, p. 148: Tyuaamböö; Childs 2000, p. 61: cùààmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « l'enfant » ; dans la Bible, surtout « jeune fille » (Rébecca, Gn 24,18), opposé à kaasonɔɔ « adulte ».</text></form></note>
  </entry>
  <entry id="cualen_502">
    <lexical-unit><form lang="kqs"><text>cualen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="cualen_502_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit (d'un animal), nouveau-né ; fillette</text></gloss>
      <gloss lang="en"><text>young (of an animal), newborn; little girl</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fetus; small (female) child</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.22.27; Keita 1979, p. 35: Tyualen; Childs 2000, p. 61: cùàléŋ</text></form></note>
    <note><form lang="fr"><text>cualen le bɛnda mì le lo kala ndɔ ikɛi « le petit restera avec sa mère » (LEV.22.27) ; un lionceau (EZK.19.5). Keita : Tyualen = Tyuaa + len « fillette ».</text></form></note>
  </entry>
  <entry id="cuanndo_503">
    <lexical-unit><form lang="kqs"><text>cuanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuanndo_503_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ma fille (en s'adressant à une jeune femme)</text></gloss>
      <gloss lang="en"><text>daughter, my daughter (in address)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl, daughter</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JDG.11.35; Childs 2000, p. 61: cùàŋndó</text></form></note>
    <note><form lang="fr"><text>Toujours en apostrophe : Noémi et Boaz à Ruth (RUT.2.2, RUT.3.10), Jephté à sa fille (JDG.11.35).</text></form></note>
  </entry>
  <entry id="cùcúŋkàá_504">
    <lexical-unit><form lang="kqs"><text>cùcúŋkàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùcúŋkèí</text></form></field>
    <sense id="cùcúŋkàá_504_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de petit arbre</text></gloss>
      <gloss lang="en"><text>species of small tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 61: cùcúŋkàá</text></form></note>
  </entry>
  <entry id="cucɔɔ_505">
    <lexical-unit><form lang="kqs"><text>cucɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cucu</text></form></variant>
    <variant><form lang="kqs"><text>cucunin</text></form></variant>
    <sense id="cucɔɔ_505_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répandre, faire tomber (en pluie, en rosée) ; saupoudrer (l'encens)</text></gloss>
      <gloss lang="en"><text>pour down, drop (like rain, dew); sprinkle (incense)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.7.27</text></form></note>
  </entry>
  <entry id="cùè-mà-kìálláŋ_506">
    <lexical-unit><form lang="kqs"><text>cùè-mà-kìálláŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-mà-kìálláŋ_506_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« herbe du cerf », herbe des marécages</text></gloss>
      <gloss lang="en"><text>"deer grass", a swamp grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-mà-kìálláŋ</text></form></note>
  </entry>
  <entry id="cùè-mà-pèúwáŋ_507">
    <lexical-unit><form lang="kqs"><text>cùè-mà-pèúwáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-mà-pèúwáŋ_507_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'herbe des marécages</text></gloss>
      <gloss lang="en"><text>species of swamp grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-mà-pèúwáŋ</text></form></note>
  </entry>
  <entry id="cùè-pèèyé_508">
    <lexical-unit><form lang="kqs"><text>cùè-pèèyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-pèèyé_508_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante médicinale des bords de ruisseau (feuilles pour envelopper un nouveau-né mort) ; cet enfant mort</text></gloss>
      <gloss lang="en"><text>medicinal streamside plant (leaves wrap a dead newborn); such a dead baby</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-pèèyé</text></form></note>
  </entry>
  <entry id="cuei_509">
    <lexical-unit><form lang="kqs"><text>cuei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cueon</text></form></field>
    <sense id="cuei_509_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hache</text></gloss>
      <gloss lang="en"><text>axe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first DEU.19.5; Keita 1979, p. 160: Tyuei; Childs 2000, p. 61: cùèí</text></form></note>
  </entry>
  <entry id="cuello_510">
    <lexical-unit><form lang="kqs"><text>cuello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuel</text></form></variant>
    <sense id="cuello_510_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre pour quelqu'un</text></gloss>
      <gloss lang="en"><text>take for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1SA.14.6; Keita 1979, p. 114: Tyuello</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de cuaa (radical cue) : cuel lanɔɔ « prendre une femme pour » (GEN 24,4).</text></form></note>
  </entry>
  <entry id="cùìlló_511">
    <lexical-unit><form lang="kqs"><text>cùìlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùìlló_511_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porc-épic (espèce à queue touffue)</text></gloss>
      <gloss lang="en"><text>brush-tailed porcupine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 63: cùìlló</text></form></note>
  </entry>
  <entry id="cuinndo_512">
    <lexical-unit><form lang="kqs"><text>cuinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuinnda</text></form></field>
    <variant><form lang="kqs"><text>cuin</text></form></variant>
    <variant><form lang="kqs"><text>cuinaa</text></form></variant>
    <sense id="cuinndo_512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chèvre</text></gloss>
      <gloss lang="en"><text>goat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.21.14; Keita 1979, p. 137: Tyuinndo; Childs 2000, p. 63: cùìŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible a aussi le pluriel cuinaa.</text></form></note>
  </entry>
  <entry id="cuinun_513">
    <lexical-unit><form lang="kqs"><text>cuinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuinun_513_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se briser, voler en éclats</text></gloss>
      <gloss lang="en"><text>break, shatter (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.32.19</text></form></note>
  </entry>
  <entry id="cuiyo_514">
    <lexical-unit><form lang="kqs"><text>cuiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuiyo_514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>broyer, écraser, réduire en poussière</text></gloss>
      <gloss lang="en"><text>crush, grind to powder</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2SA.22.43; Childs 2000, p. 63: cùìyó</text></form></note>
    <note><form lang="fr"><text>O va dioo a cuiyo « elle dévorait et broyait » (DAN.7.7, DAN.7.19) ; I co nda cuiyo ... maa cundu « je les broie comme la poussière » (2SA.22.43). Moyen : cuinun « se briser ».</text></form></note>
  </entry>
  <entry id="cuiŋi_515">
    <lexical-unit><form lang="kqs"><text>cuiŋi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuiŋi_515_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (un liquide)</text></gloss>
      <gloss lang="en"><text>pour out (a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, pour away; waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.35.14; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cukanioo_516">
    <lexical-unit><form lang="kqs"><text>cukanioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cukani</text></form></variant>
    <sense id="cukanioo_516_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuillère</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Tyukanioo</text></form></note>
    <note><form lang="fr"><text>La Bible a cukanila n'ciŋndan « fourchettes » (Ex 27,3), avec la forme radicale du pluriel.</text></form></note>
  </entry>
  <entry id="cúkè_517">
    <lexical-unit><form lang="kqs"><text>cúkè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúkè_517_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un petit moment, brièvement</text></gloss>
      <gloss lang="en"><text>for a short while, briefly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúkè</text></form></note>
  </entry>
  <entry id="cúkù-cùkù_518">
    <lexical-unit><form lang="kqs"><text>cúkù-cùkù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúkù-cùkù_518_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un petit poisson qui saute dans l'eau, d'une chose plongée dans l'eau ; de petits trous percés à l'alêne</text></gloss>
      <gloss lang="en"><text>sound of a small fish jumping in water, of something dipped in water; of an awl making small holes</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúkù-cùkù</text></form></note>
  </entry>
  <entry id="cùkúlló_519">
    <lexical-unit><form lang="kqs"><text>cùkúlló</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùkúlló_519_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chatouiller ; taquiner, faire rire</text></gloss>
      <gloss lang="en"><text>tickle; tease, make laugh</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.5 Sense of touch"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cùkúlló</text></form></note>
  </entry>
  <entry id="cukɔnndo_520">
    <lexical-unit><form lang="kqs"><text>cukɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cukɔnndo_520_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se piquer</text></gloss>
      <gloss lang="en"><text>prick oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Tyukönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de cukɔɔ.</text></form></note>
  </entry>
  <entry id="cukɔɔ_521">
    <lexical-unit><form lang="kqs"><text>cukɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuku</text></form></variant>
    <sense id="cukɔɔ_521_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer, transpercer</text></gloss>
      <gloss lang="en"><text>prick, pierce</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>prick (as a thorn)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.19.10; Keita 1979, p. 114: Tyuköö; Childs 2000, p. 63: cùkàá</text></form></note>
  </entry>
  <entry id="cúlú_522">
    <lexical-unit><form lang="kqs"><text>cúlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúlú_522_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en glissant facilement (entrer, sortir, plonger)</text></gloss>
      <gloss lang="en"><text>slipping in or out easily, smoothly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúlú</text></form></note>
  </entry>
  <entry id="cùlùkàá_523">
    <lexical-unit><form lang="kqs"><text>cùlùkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùlùkàá_523_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être glissant, gluant ; rendre glissant</text></gloss>
      <gloss lang="en"><text>be slippery, slimy; make slippery</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 65: cùlùkàá</text></form></note>
  </entry>
  <entry id="cumndo_524">
    <lexical-unit><form lang="kqs"><text>cumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cum</text></form></variant>
    <sense id="cumndo_524_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attendre ; laisser (faire)</text></gloss>
      <gloss lang="en"><text>wait; let, allow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 91 occurrences, first EXO.5.20; Childs 2000, p. 65: cùmndó</text></form></note>
  </entry>
  <entry id="cumullo_525">
    <lexical-unit><form lang="kqs"><text>cumullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cumul</text></form></variant>
    <sense id="cumullo_525_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller</text></gloss>
      <gloss lang="en"><text>guard, watch over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>watch something secretly, peep, spy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.3.24; Childs 2000, p. 66: cùmùlló</text></form></note>
  </entry>
  <entry id="cun_526">
    <lexical-unit><form lang="kqs"><text>cun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cun_526_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>odeur ; (cun kɛndɛ) parfum</text></gloss>
      <gloss lang="en"><text>smell; (cun kɛndɛ) fragrance</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smelly; smell of, stink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 189 occurrences, first GEN.8.21; Childs 2000, p. 66: cùnéí-</text></form></note>
  </entry>
  <entry id="cundoo_527">
    <lexical-unit><form lang="kqs"><text>cundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cundu</text></form></variant>
    <sense id="cundoo_527_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poussière</text></gloss>
      <gloss lang="en"><text>dust</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first GEN.3.14; Keita 1979, p. 155: Tyunduo; Childs 2000, p. 66: cúndóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tyunduo ; la Bible cundoo.</text></form></note>
  </entry>
  <entry id="cùndòó_528">
    <lexical-unit><form lang="kqs"><text>cùndòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùndùá</text></form></field>
    <sense id="cùndòó_528_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand oiseau noir, roux et blanc qui mange les serpents et chante à l'aube</text></gloss>
      <gloss lang="en"><text>large black, russet and white bird that eats snakes and calls at dawn</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 66: cùndòó</text></form></note>
    <note><form lang="fr"><text>Appelé « time bird » en anglais du Libéria.</text></form></note>
  </entry>
  <entry id="cunndo_529">
    <lexical-unit><form lang="kqs"><text>cunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cunndo_529_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sentir, dégager une odeur ; puer</text></gloss>
      <gloss lang="en"><text>smell, give off a smell; stink</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.27.27; Childs 2000, p. 66: cùŋndo</text></form></note>
    <note><form lang="fr"><text>O co nin cunndo fulaa « il sent déjà » (JHN.11.39) ; i co cunndo kuí-kuí « je pue » (PSA.38.6) ; aussi en bonne part : Po nuu co cunndo ... « l'odeur de mon fils » (GEN.27.27). Voir cun « odeur ».</text></form></note>
  </entry>
  <entry id="cúo_530">
    <lexical-unit><form lang="kqs"><text>cúo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cu</text></form></variant>
    <sense id="cúo_530_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler, moudre (au mortier)</text></gloss>
      <gloss lang="en"><text>pound, grind (in a mortar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.24.41</text></form></note>
  </entry>
  <entry id="cùó_531">
    <lexical-unit><form lang="kqs"><text>cùó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùléŋ</text></form></field>
    <sense id="cùó_531_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuillère, louche</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùó</text></form></note>
  </entry>
  <entry id="cùùlán_532">
    <lexical-unit><form lang="kqs"><text>cùùlán</text></form></lexical-unit>
    <trait name="noun-class" value="la"/>
    <trait name="status" value="southern"/>
    <sense id="cùùlán_532_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadeaux</text></gloss>
      <gloss lang="en"><text>presents, gifts</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùùlán</text></form></note>
  </entry>
  <entry id="cuuloo_533">
    <lexical-unit><form lang="kqs"><text>cuuloo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cuulu</text></form></variant>
    <variant><form lang="kqs"><text>cuulunin</text></form></variant>
    <sense id="cuuloo_533_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter en épi, pousser ; être consumé, dépérir</text></gloss>
      <gloss lang="en"><text>come into ear, sprout; be consumed, waste away</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tiller, produce grain (rice); also be slimy, slippery</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùùlòó</text></form></note>
    <note><form lang="fr"><text>Deux emplois : épis (Gn 41,5-6 ; Ex 9,31) et « consumer » (yinnden … cuulu mungén, Ps 106,18 ; paalan la cuulu ya « mes os se consument », Ps 31,11).</text></form></note>
  </entry>
  <entry id="cùùmɔ̀ɔ́_534">
    <lexical-unit><form lang="kqs"><text>cùùmɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùmɔ̀ɔ́_534_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sonner, tinter (clochette)</text></gloss>
      <gloss lang="en"><text>ring (of a bell)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 68: cùùmɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cuungiaa_535">
    <lexical-unit><form lang="kqs"><text>cuungiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuungiaanin</text></form></variant>
    <sense id="cuungiaa_535_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, réunir</text></gloss>
      <gloss lang="en"><text>gather, assemble</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, collect; also contribute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 175 occurrences, first GEN.9.14; Childs 2000, p. 68: cùùŋgìá</text></form></note>
  </entry>
  <entry id="cuungian_536">
    <lexical-unit><form lang="kqs"><text>cuungian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuungian_536_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rassembler, se réunir</text></gloss>
      <gloss lang="en"><text>gather, come together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 147 occurrences, first GEN.14.8</text></form></note>
    <note><form lang="fr"><text>Moyen de cuungiaa « rassembler ».</text></form></note>
  </entry>
  <entry id="cuunɔnndo_537">
    <lexical-unit><form lang="kqs"><text>cuunɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuunun</text></form></variant>
    <sense id="cuunɔnndo_537_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'écouler, passer, prendre fin (des jours, de la vie)</text></gloss>
      <gloss lang="en"><text>pass away, run out, come to an end (of days, life)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be used up, be finishing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.7.16; Childs 2000, p. 68: cùùnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de cuu « finir ». Palɛi nii ... keleŋaa cuunɔnndo « mes jours passent vite » (JOB.9.25) ; Palɛi nii cuunun « mes jours sont finis » (JOB.17.11).</text></form></note>
  </entry>
  <entry id="cuuo_538">
    <lexical-unit><form lang="kqs"><text>cuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuu</text></form></variant>
    <variant><form lang="kqs"><text>cuunin</text></form></variant>
    <sense id="cuuo_538_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, amener</text></gloss>
      <gloss lang="en"><text>bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring; give someone a present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.27.5; Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cùùwó_539">
    <lexical-unit><form lang="kqs"><text>cùùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùwó_539_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>offrir, apporter un cadeau à qqn</text></gloss>
      <gloss lang="en"><text>give a present, bring as a gift</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cùùwó_540">
    <lexical-unit><form lang="kqs"><text>cùùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùwó_540_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>émousser</text></gloss>
      <gloss lang="en"><text>make dull, blunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cuuŋuuo_541">
    <lexical-unit><form lang="kqs"><text>cuuŋuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuuŋuu</text></form></variant>
    <variant><form lang="kqs"><text>cuuŋuunin</text></form></variant>
    <sense id="cuuŋuuo_541_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (sang, eau)</text></gloss>
      <gloss lang="en"><text>pour out (blood, water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, throw (a liquid) away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2KI.3.11; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cuvɔɔ_542">
    <lexical-unit><form lang="kqs"><text>cuvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuvɔɔ_542_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, s'achever ; fin ; (X cuvɔɔ) après X</text></gloss>
      <gloss lang="en"><text>finish, come to an end; end; (X cuvɔɔ) after X</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.6.7 End, point"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be finished, used up; auxiliary of completion</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.22.19; Childs 2000, p. 69: cùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Biisi Yosue-o cuvɔɔ « après la mort de Josué » (Jg 1,1) ; niaa co cuvɔɔ vu « vous finirez par mourir » (Nb 14,32).</text></form></note>
  </entry>
  <entry id="cùwɔ̀ɔ́_543">
    <lexical-unit><form lang="kqs"><text>cùwɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùwɔ̀ɔ́_543_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter à terre, renverser</text></gloss>
      <gloss lang="en"><text>throw down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùwɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cuɛi-cuɛi_544">
    <lexical-unit><form lang="kqs"><text>cuɛi-cuɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuɛi-cuɛi_544_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>souvent, régulièrement</text></gloss>
      <gloss lang="en"><text>often, regularly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.3.1</text></form></note>
  </entry>
  <entry id="cuɛinanndo_545">
    <lexical-unit><form lang="kqs"><text>cuɛinanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuɛinanndan</text></form></field>
    <variant><form lang="kqs"><text>cuɛinan</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinannda</text></form></variant>
    <sense id="cuɛinanndo_545_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vêtement (ɲɛ cuɛinanndo) ; (volɔɔla cuɛinanndan) habits</text></gloss>
      <gloss lang="en"><text>clothing, garment (ɲɛ cuɛinanndo); (volɔɔla cuɛinanndan) clothes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.28.20</text></form></note>
    <note><form lang="fr"><text>De cuɛinun « se vêtir » ; souvent en apposition : volɔɔ cuɛinanndo « vêtement », ɲɛ cuɛinan « vêtement ».</text></form></note>
  </entry>
  <entry id="cuɛinɔnndo_546">
    <lexical-unit><form lang="kqs"><text>cuɛinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛinun</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinɔn</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinunnin</text></form></variant>
    <sense id="cuɛinɔnndo_546_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'habiller, se vêtir, mettre (un vêtement)</text></gloss>
      <gloss lang="en"><text>dress, put on (clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.8.4; Childs 2000, p. 62: cùènɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="cuɛiyan_547">
    <lexical-unit><form lang="kqs"><text>cuɛiyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛima</text></form></variant>
    <sense id="cuɛiyan_547_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>graisse ; huile ; pommade ; graisse, beurre</text></gloss>
      <gloss lang="en"><text>fat; oil ; oil; ointment ; oil; fat, butter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>oil, palm oil, ointment</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 132 occurrences, first GEN.28.18; Keita 1979, p. 133: Tyuèyan; Childs 2000, p. 62: cùɛ̀ìyáŋ</text></form></note>
  </entry>
  <entry id="cɔ̂_548">
    <lexical-unit><form lang="kqs"><text>cɔ̂</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̂_548_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un coup de coupe-coupe ou d'une morsure</text></gloss>
      <gloss lang="en"><text>sound of chopping or biting</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: cɔ̂</text></form></note>
  </entry>
  <entry id="cɔ́-cɔ́_549">
    <lexical-unit><form lang="kqs"><text>cɔ́-cɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔ́-cɔ́_549_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, rapidement, sans tarder</text></gloss>
      <gloss lang="en"><text>quickly, at once, hurriedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 93 occurrences, first GEN.18.6; Childs 2000, p. 55: cɔ́(-cɔ́)</text></form></note>
    <note><form lang="fr"><text>Abraham luɛi cɔ́-cɔ́ o cɛi-kola-toandaa ndɔɔ nin « Abraham se hâta d'entrer dans sa tente » (GEN.18.6).</text></form></note>
  </entry>
  <entry id="cɔ́cɔ̀l_550">
