    <note><form lang="fr"><text>hoeyii felenfelennde « vent de tourbillon » (2 R 2,11).</text></form></note>
  </entry>
  <entry id="felengiyɛi_843">
    <lexical-unit><form lang="kqs"><text>felengiyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="felengiyɛi_843_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunesse</text></gloss>
      <gloss lang="en"><text>youth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.8.21; Keita 1979, p. 148: Felengöyèi</text></form></note>
    <note><form lang="fr"><text>Keita écrit Felengöyèi ; la Bible a felengiyɛi.</text></form></note>
  </entry>
  <entry id="felengoo_844">
