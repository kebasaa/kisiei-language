  <entry id="bu_360">
    <lexical-unit><form lang="kqs"><text>bu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bu_360_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gratter ; dessoucher</text></gloss>
      <gloss lang="en"><text>scrape; clear stumps</text></gloss>
