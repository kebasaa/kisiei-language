    <sense id="fùùyìá_926_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher grossièrement, incomplètement</text></gloss>
      <gloss lang="en"><text>clear a field roughly, incompletely</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùyìá</text></form></note>
  </entry>
  <entry id="fùùyɔ́ɔ́_927">
