    <sense id="pìɛ̀ndìóó_3138_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>exploser</text></gloss>
      <gloss lang="en"><text>explode</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pìɛ̀ndìóó</text></form></note>
