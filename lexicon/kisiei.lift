      <gloss lang="en"><text>(laugh) softly; (press) firmly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: múɛ̀ɛ̀ŋ</text></form></note>
  </entry>
