  <entry id="masalen_2229">
    <lexical-unit><form lang="kqs"><text>masalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masale</text></form></variant>
    <sense id="masalen_2229_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>royaume, règne, royauté</text></gloss>
      <gloss lang="en"><text>kingdom, reign, kingship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chieftaincy, rule</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 482 occurrences, first GEN.1.28; Childs 2000, p. 243: màsàlɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>De masaa « roi ».</text></form></note>
  </entry>
  <entry id="másáŋ-kàŋgóó_2230">
    <lexical-unit><form lang="kqs"><text>másáŋ-kàŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="másáŋ-kàŋgóó_2230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie qui creuse la plante des pieds</text></gloss>
      <gloss lang="en"><text>disease that pits the soles of the feet</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: másáŋ-kàŋgóó</text></form></note>
