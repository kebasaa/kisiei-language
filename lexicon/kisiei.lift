  <entry id="yeowlan_1930">
    <lexical-unit><form lang="kqs"><text>yeowlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeow</text></form></variant>
    <variant><form lang="kqs"><text>yeowla</text></form></variant>
    <sense id="yeowlan_1930_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se moquer de, insulter ; maudire</text></gloss>
      <gloss lang="en"><text>mock, insult; curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>abuse repeatedly (plural of yèìyó 'insult, curse')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first JDG.8.15; Childs 2000, p. 409: yìòùwó</text></form></note>
  </entry>
  <entry id="yeŋ_1931">
    <lexical-unit><form lang="kqs"><text>yeŋ</text></form></lexical-unit>
