    <trait name="status" value="southern"/>
    <sense id="fɛ̂l_1099_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(nettoyé) à fond, impeccablement</text></gloss>
      <gloss lang="en"><text>(cleaned) thoroughly, spotlessly</text></gloss>
