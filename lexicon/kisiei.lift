    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 95: Töntibiiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɔnɔ cɔwvo_5488">
    <lexical-unit><form lang="kqs"><text>tɔnɔ cɔwvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔnɔ cɔwvo_5488_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>butin</text></gloss>
      <gloss lang="en"><text>booty, spoils of war</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 124: Tönö työwvo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɔnɔɔ_5489">
    <lexical-unit><form lang="kqs"><text>tɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔnɔ</text></form></variant>
    <sense id="tɔnɔɔ_5489_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>profit, avantage ; intérêt (d'un prêt)</text></gloss>
      <gloss lang="en"><text>profit, benefit; interest (on a loan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gain, profit; good fortune</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first EXO.22.20; Lexique kissi–français, p. 58: tɔnɔɔ; Childs 2000, p. 369: tɔ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɔnɔɔ dioo_5490">
    <lexical-unit><form lang="kqs"><text>tɔnɔɔ dioo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔnɔɔ dioo_5490_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tirer profit (de), exploiter ; jouir ; (tɔnɔdiaa) jouissance</text></gloss>
      <gloss lang="en"><text>profit (from), exploit; enjoy; (tɔnɔdiaa) enjoyment</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 383: Tönöö dioo, vau o lekètyè tyoo</text></form></note>
    <note><form lang="fr"><text>Litt. « manger le profit ». Académie des langues (terminologie, idéologie n° 383, 384) : « jouir » ; tɔnɔdiaa, kɛcɛlen « jouissance ».</text></form></note>
  </entry>
  <entry id="tɔŋando_5491">
    <lexical-unit><form lang="kqs"><text>tɔŋando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔŋando_5491_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chauve-souris (grande espèce)</text></gloss>
      <gloss lang="en"><text>bat (large species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 106: tɔŋando, pl. tɔŋaɛda</text></form></note>
  </entry>
  <entry id="tɔ̀ŋâŋndó_5492">
    <lexical-unit><form lang="kqs"><text>tɔ̀ŋâŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ŋâŋndó_5492_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau nocturne (espèce), au cri « tɔŋ … tɔŋ »</text></gloss>
      <gloss lang="en"><text>nocturnal bird species, calling 'tɔŋ … tɔŋ'</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ̀ŋâŋndó</text></form></note>
  </entry>
  <entry id="tɔ́ŋgɔ́tɔ́ŋgáá_5493">
    <lexical-unit><form lang="kqs"><text>tɔ́ŋgɔ́tɔ́ŋgáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ́ŋgɔ́tɔ́ŋgáá_5493_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remède traditionnel (espèce)</text></gloss>
      <gloss lang="en"><text>a traditional medicine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ́ŋgɔ́tɔ́ŋgáá</text></form></note>
  </entry>
  <entry id="tɔŋndan kɛsioo_5494">
    <lexical-unit><form lang="kqs"><text>tɔŋndan kɛsioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔŋndan kɛsioo_5494_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>législation</text></gloss>
      <gloss lang="en"><text>legislation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 403: Tönndan kèsioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « établir les lois » (tɔŋndan, pluriel de tɔŋndo « loi »).</text></form></note>
  </entry>
  <entry id="tɔŋndo_5495">
    <lexical-unit><form lang="kqs"><text>tɔŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔŋndan</text></form></field>
    <variant><form lang="kqs"><text>tɔŋ</text></form></variant>
    <variant><form lang="kqs"><text>tɔŋnda</text></form></variant>
    <sense id="tɔŋndo_5495_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loi, commandement, ordre ; interdiction, défense</text></gloss>
      <gloss lang="en"><text>law, commandment, order; prohibition</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 298 occurrences, first GEN.2.16; Paulme 1964, p. 106: tɔndo; Lexique kissi–français, p. 57: tɔnndo; Terminologie (idéologie), n° 407: Tönndo, kpemaa, siavaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 57) écrit tɔnndo « la loi ». Paulme 1964, p. 106 : tɔndo « interdiction (laïque) » ; tɔndo yio « c'est interdit » ; pua yi tɔndo « le père l'a défendu ». Académie des langues (terminologie, idéologie n° 407) : « loi » (aussi kpemaa, siavaa). Académie des langues (terminologie, idéologie n° 559) : « règlement ».</text></form></note>
  </entry>
  <entry id="tɔ́ŋndó_5496">
    <lexical-unit><form lang="kqs"><text>tɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tɔ́ŋndó_5496_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amende infligée à qui arrive en retard au travail collectif</text></gloss>
      <gloss lang="en"><text>fine for being late to communal work</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ́ŋndó</text></form></note>
  </entry>
  <entry id="tɔŋolo_5497">
    <lexical-unit><form lang="kqs"><text>tɔŋolo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔŋolo_5497_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tourbillon, vent des ninya</text></gloss>
      <gloss lang="en"><text>whirlwind, wind of the ninya spirits</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 106: tɔŋolo</text></form></note>
  </entry>
  <entry id="tɔ́ɔ́_5498">
    <lexical-unit><form lang="kqs"><text>tɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɔ́ɔ́lan</text></form></field>
    <sense id="tɔ́ɔ́_5498_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>renommée, réputation ; nouvelle, bruit ; acclamation</text></gloss>
      <gloss lang="en"><text>fame, renown, reputation; news, report; acclaim</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 223 occurrences, first GEN.6.4; Lexique kissi–français, p. 58: tɔɔ; Terminologie (histoire), n° 146: (vana nyè) töö; Childs 2000, p. 369: tɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>vana tɔ́ɔ́ « homme renommé » (GEN.34.19) ; mí tɔ́ɔ́ tiw o cɛi lemasa « la nouvelle parvint au palais » (GEN.45.16) ; tɔ́ɔ́lan « nouvelles » (JER.4.15). Lexique kissi–français, p. 58 : tɔɔ « acclamation ». Académie des langues (terminologie, histoire n° 146) : (vana ɲɛ) tɔ́ɔ́ « célèbre ». Académie des langues (terminologie, histoire n° 402) : vana tɔ́ɔ́ « illustre ». Académie des langues (terminologie, idéologie n° 504) : « popularité » (aussi diolakɛndɛlan, tɔɔkɛndɔɔ).</text></form></note>
  </entry>
  <entry id="tɔɔ_5499">
    <lexical-unit><form lang="kqs"><text>tɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔɔ_5499_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver (objets, vêtements), rincer</text></gloss>
      <gloss lang="en"><text>wash (things, clothes), rinse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wash clothes, launder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 223 occurrences, first GEN.6.4; Keita 1979, p. 115: Töö; Paulme 1964, p. 106: tɔɔ; Lexique kissi–français, p. 58: tɔɔ/ tɔa, too; Childs 2000, p. 369: tɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tɔɔ ndi a mɛnndan « le rincer à l'eau » (LEV 6,21). Homonyme de tɔ́ɔ́ « très, nombreux ». Lexique kissi–français, p. 57-58 : radicaux tɔa, too, tua.</text></form></note>
  </entry>
  <entry id="tɔ́ɔ́ vɔɔndo_5500">
    <lexical-unit><form lang="kqs"><text>tɔ́ɔ́ vɔɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔ́ɔ́ vɔɔndo_5500_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>impopularité, mauvaise réputation</text></gloss>
      <gloss lang="en"><text>unpopularity, bad reputation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 400: Töö vööndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « mauvaise renommée » (tɔ́ɔ́ « renommée », vɔɔndo « mauvais »).</text></form></note>
  </entry>
  <entry id="tɔɔkɛndɔɔ_5501">
    <lexical-unit><form lang="kqs"><text>tɔɔkɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɔɔkɛndɔɔ_5501_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gloire</text></gloss>
      <gloss lang="en"><text>glory, fame</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 366: Töökèndöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. tɔ́ɔ́ « renommée ».</text></form></note>
  </entry>
  <entry id="tɔɔliaa_5502">
    <lexical-unit><form lang="kqs"><text>tɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔriaa</text></form></variant>
    <sense id="tɔɔliaa_5502_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accélérer, se dépêcher, faire vite ; faire souvent</text></gloss>
      <gloss lang="en"><text>hurry, go fast; do often</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HAB.1.8; Lexique kissi–français, p. 58: tɔɔriaa/ tɔɔria</text></form></note>
    <note><form lang="fr"><text>Radical tɔɔlia (Lexique : tɔɔria). Le Lexique donne aussi tɔɔliaa « accélérer » (p. 58) et tɔliaa/ tɔlia « se précipiter » (p. 57).</text></form></note>
  </entry>
  <entry id="tɔɔmaa_5503">
    <lexical-unit><form lang="kqs"><text>tɔɔmaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔma</text></form></variant>
    <sense id="tɔɔmaa_5503_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>monstre, bête prodigieuse (visi tɔɔmaa)</text></gloss>
      <gloss lang="en"><text>monster, monstrous beast (visi tɔɔmaa)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.1.21</text></form></note>
    <note><form lang="fr"><text>visia kɔndɔfilaa tɔɔmaa bɛndua « les grands monstres marins » (Gn 1,21).</text></form></note>
  </entry>
  <entry id="tɔɔmaseloo_5504">
    <lexical-unit><form lang="kqs"><text>tɔɔmaseloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔmasele</text></form></variant>
    <variant><form lang="kqs"><text>tɔmaseloo</text></form></variant>
    <sense id="tɔɔmaseloo_5504_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>signe, marque ; symbole</text></gloss>
      <gloss lang="en"><text>sign, mark; symbol</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.9.13; Lexique kissi–français, p. 57: tɔmasereo; Terminologie (histoire), n° 589: Tömaseloo; Childs 2000, p. 346: tààmàsììyó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 57 : tɔmasereo « le signe, le symbole ».</text></form></note>
  </entry>
  <entry id="tɔɔndaa_5505">
    <lexical-unit><form lang="kqs"><text>tɔɔndaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɔɔndaa_5505_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pipe (à tabac)</text></gloss>
      <gloss lang="en"><text>(tobacco) pipe</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 58: tɔɔndaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit aussi tɔndaa (p. 57), homographe du verbe tɔndaa « tisser ».</text></form></note>
  </entry>
  <entry id="tɔɔndan_5506">
    <lexical-unit><form lang="kqs"><text>tɔɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔndanndo</text></form></variant>
    <sense id="tɔɔndan_5506_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éprouver, mettre à l'épreuve ; tenter ; essayer</text></gloss>
      <gloss lang="en"><text>test, try; tempt; attempt</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.22.1; Terminologie (histoire), n° 600: Töndanndo</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 600) : tɔndanndo « tentative ».</text></form></note>
  </entry>
  <entry id="tɔ́ɔ́yaa_5507">
    <lexical-unit><form lang="kqs"><text>tɔ́ɔ́yaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɔ́ɔ́yaa_5507_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faute, blâme, responsabilité (bii X tɔ́ɔ́yaa « tenir X pour responsable, blâmer X »)</text></gloss>
      <gloss lang="en"><text>blame, fault, responsibility (bii X tɔ́ɔ́yaa 'hold X responsible, blame X')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.51.25; Childs 2000, p. 370: tɔ́ɔ́yáŋ</text></form></note>
    <note><form lang="fr"><text>le yɛɛ Hala kalaa co yɛ naa niko tɔ́ɔ́yaa biyɔɔ? « pourquoi Dieu blâme-t-il encore ? » (ROM.9.19 ; aussi ACT.19.40, JER.51.25).</text></form></note>
  </entry>
  <entry id="tɔ̀ɔ̀ɲá_5508">
    <lexical-unit><form lang="kqs"><text>tɔ̀ɔ̀ɲá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ɔ̀ɲá_5508_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire vite, parler très vite, manger ou piler rapidement</text></gloss>
      <gloss lang="en"><text>do quickly, speak very fast, eat or pound rapidly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 369: tɔ̀ɔ̀ɲá</text></form></note>
  </entry>
  <entry id="tɔ̀ɲàá_5509">
    <lexical-unit><form lang="kqs"><text>tɔ̀ɲàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɔ̀ɲàá_5509_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler vite ; répéter ce qu'un autre a dit</text></gloss>
      <gloss lang="en"><text>speak quickly; repeat what someone said</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 368: tɔ̀ɲàá</text></form></note>
  </entry>
  <entry id="tɛfɛ vesɛiyo_5510">
    <lexical-unit><form lang="kqs"><text>tɛfɛ vesɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛfɛ vesɛiyo_5510_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>participe passé</text></gloss>
      <gloss lang="en"><text>past participle</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 306: Tèfè vesèiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɛfɛ yɔnnonndo_5511">
    <lexical-unit><form lang="kqs"><text>tɛfɛ yɔnnonndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛfɛ yɔnnonndo_5511_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>participe présent</text></gloss>
      <gloss lang="en"><text>present participle</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 305: Tèfè yönnonndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. tɛfɛ vesɛiyo « participe passé » (langue n° 306).</text></form></note>
  </entry>
  <entry id="tɛ̀i_5512">
    <lexical-unit><form lang="kqs"><text>tɛ̀i</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛiyo</text></form></variant>
    <sense id="tɛ̀i_5512_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étendre, étaler (au soleil, pour sécher)</text></gloss>
      <gloss lang="en"><text>spread out (in the sun, to dry)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread, esp. in the sun to dry; spread one's hands or legs apart</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.13.10; Paulme 1964, p. 104: tɛyo; Lexique kissi–français, p. 54: tɛiyo/ tɛi; Childs 2000, p. 356: tèìyó</text></form></note>
    <note><form lang="fr"><text>mó tɛ̀i malun kullon lecoo « elle étendit du grain dessus » (2SA.17.19) ; ma tɛ̀i nda o dɔ́ɔ́ngɔ́ɔ̀ balɔɔ « ils les étalèrent autour du camp » (NUM.11.32) ; fonda vana tɛ̀i yalalan « lieu où l'on étend les filets » (EZK.26.5). Dans siow X tɛ̀i « tuer X sur le coup » (2SA.1.10, JDG.9.54) le sens est peut-être autre. Cf. tɛilullo.</text></form></note>
  </entry>
  <entry id="tɛi_5513">
    <lexical-unit><form lang="kqs"><text>tɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tiyan</text></form></variant>
    <variant><form lang="kqs"><text>tiɛi</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>tiyan</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="tɛi_5513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arachide ; cacahuète</text></gloss>
      <gloss lang="en"><text>groundnut, peanut</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tèi; Paulme 1964, p. 104 (G/K): tɛy, pl. tɛɔ̃ /G./, tiɛy, tiyã /K./; Lexique kissi–français, p. 54: tɛi; Sandara Kisia, fable 4: tiyaŋ; Childs 2000, p. 362: tìɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tɛ̀i est un homonyme sans rapport (2SA.1.10). Lexique kissi–français, p. 55 : [ti]an « les arachides » (pluriel ?). Paulme 1964, p. 104 : tɛy, pl. tɛɔ̃ /G./ ; tiɛy, pl. tiyã /K./. Sandara Kissia, fables 4 et 17 : tiyaŋ « les arachides » (pluriel, comme Paulme tiyã /K./). Paulme : tɛy, pl. tɛɔ̃ /G./ ; tiɛy, pl. tiyã /K./ (p. 104, 111).</text></form></note>
  </entry>
  <entry id="tɛilullo_5514">
    <lexical-unit><form lang="kqs"><text>tɛilullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛilul</text></form></variant>
    <variant><form lang="kqs"><text>tɛilu</text></form></variant>
    <sense id="tɛilullo_5514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, étendre (les mains) vers ; tendre (la joue) à</text></gloss>
      <gloss lang="en"><text>stretch out, spread (the hands) to; offer (the cheek) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread out (e.g. to dry) for someone; open one's hands to someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.65.2; Childs 2000, p. 355: tèìlúlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif d'un verbe « étendre » (Childs tèìyó). tɛilul ndu balan « tends les mains vers lui » (JOB.11.13) ; mò tɛilu vana co ndu lɔɔ-o kpannde « qu'il tende la joue à celui qui le frappe » (LAM.3.30).</text></form></note>
  </entry>
  <entry id="tɛiye_5515">
    <lexical-unit><form lang="kqs"><text>tɛiye</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛyii</text></form></variant>
    <variant><form lang="kqs"><text>tɛyun</text></form></variant>
    <variant><form lang="kqs"><text>tɛiyun</text></form></variant>
    <sense id="tɛiye_5515_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>confluent ; pousse, rejeton ; bras (d'un fleuve), cours d'eau</text></gloss>
      <gloss lang="en"><text>confluence; shoot, sprout; branch of a river, stream</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.11.1; Keita 1979, p. 155: Tèiye; Lexique kissi–français, p. 54: tɛiye</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tɛiye désigne un rejeton, une pousse (ISA.11.1) ; le sens « confluent » est à confirmer. Dans la Bible : tɛyii « bras de fleuve » (Gn 2,11), tɛiye « rejeton » (Is 11,1).</text></form></note>
  </entry>
  <entry id="tɛiyon_5516">
    <lexical-unit><form lang="kqs"><text>tɛiyon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛiyon_5516_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bras (d'un fleuve), branches ; ramification</text></gloss>
      <gloss lang="en"><text>branches (of a river); ramification</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.2.10; Terminologie (histoire), n° 551: Tèiyon</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 551) : « ramification ».</text></form></note>
  </entry>
  <entry id="tɛ́kpɛ́-tɛ́kpɛ́_5517">
    <lexical-unit><form lang="kqs"><text>tɛ́kpɛ́-tɛ́kpɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛ́kpɛ́-tɛ́kpɛ́_5517_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un par un, un à un (compter)</text></gloss>
      <gloss lang="en"><text>one by one, individually (counting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.2 Count"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first NUM.1.2</text></form></note>
    <note><form lang="fr"><text>La cɔm sɛ́lɛ́ Israɛlla tɛ́kpɛ́-tɛ́kpɛ́ « recensez toute l'assemblée d'Israël un par un » (NUM.1.2).</text></form></note>
  </entry>
  <entry id="tɛlɛfɛlɛ_5518">
    <lexical-unit><form lang="kqs"><text>tɛlɛfɛlɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛlɛfɛlɛ_5518_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tiède</text></gloss>
      <gloss lang="en"><text>lukewarm</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛlɛfɛlɛ</text></form></note>
  </entry>
  <entry id="tɛ̂lɛ́kɛ̀lɛ́_5519">
    <lexical-unit><form lang="kqs"><text>tɛ̂lɛ́kɛ̀lɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="tɛ̂lɛ́kɛ̀lɛ́_5519_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(bien lisse, comme le ciment)</text></gloss>
      <gloss lang="en"><text>(smooth, like cement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 356: tɛ̂lɛ́kɛ̀lɛ́</text></form></note>
  </entry>
  <entry id="tɛlɛlɔɔ_5520">
    <lexical-unit><form lang="kqs"><text>tɛlɛlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛlɛlɔɔ_5520_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>surface</text></gloss>
      <gloss lang="en"><text>surface</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tèlèlöö; Lexique kissi–français, p. 55: tɛlɛlɔɔ</text></form></note>
  </entry>
  <entry id="tɛmbuo_5521">
    <lexical-unit><form lang="kqs"><text>tɛmbuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛmbu</text></form></variant>
    <sense id="tɛmbuo_5521_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abîmer, ruiner, gâter</text></gloss>
      <gloss lang="en"><text>damage, ruin, spoil</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛmbuo; Lexique kissi–français, p. 55: tɛnbuo/ tɛnbu</text></form></note>
    <note><form lang="fr"><text>Comparer tambu « être ruiné, s'abîmer » (Bible).</text></form></note>
  </entry>
  <entry id="tɛmbuo kpow_5522">
    <lexical-unit><form lang="kqs"><text>tɛmbuo kpow</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛmbuo kpow_5522_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ravager</text></gloss>
      <gloss lang="en"><text>ravage, lay waste</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛmbuo kpou</text></form></note>
    <note><form lang="fr"><text>Littéralement « tout abîmer » (kpow « tout »).</text></form></note>
  </entry>
  <entry id="tɛmbɔɔ_5523">
    <lexical-unit><form lang="kqs"><text>tɛmbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛmbɔɔ_5523_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>panier de pêche ; grand fétiche des femmes</text></gloss>
      <gloss lang="en"><text>fishing basket; great fetish of the women</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛmbo, tɛmbɔ, pl. tɛmbɛra; Lexique kissi–français, p. 55: tɛnbɔɔ</text></form></note>
    <note><form lang="fr"><text>Deux sens réunis dans le Lexique (homographes ?).</text></form></note>
  </entry>
  <entry id="tɛnda mɔsɔŋiaa_5524">
    <lexical-unit><form lang="kqs"><text>tɛnda mɔsɔŋiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛnda mɔsɔŋiaa_5524_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trait d'union</text></gloss>
      <gloss lang="en"><text>hyphen</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 412: Tènda mösönhiaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. tɛndaa « trait ».</text></form></note>
  </entry>
  <entry id="tɛndaa_5525">
    <lexical-unit><form lang="kqs"><text>tɛndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛnda</text></form></variant>
    <variant><form lang="kqs"><text>tɛndanin</text></form></variant>
    <sense id="tɛndaa_5525_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, diviser ; (seilen) témoigner ; couper dans le sens de la longueur (bois)</text></gloss>
      <gloss lang="en"><text>split, divide; (with seilen) testify; cut lengthwise (wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>split, cut open</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first LEV.5.1; Keita 1979, p. 113: Tèndaa; Lexique kissi–français, p. 55: tɛndaa/ tɛnda; Terminologie (langue), n° 411: Tèndaa; Childs 2000, p. 357: tɛ̀ndàá</text></form></note>
    <note><form lang="fr"><text>seilen tɛndaa « porter témoignage » (LEV 5,1) ; bénéfactif tɛndal « témoigner contre ». Académie des langues (terminologie, langue n° 411) : « trait » ; tènda mösönhiaa « trait d'union » (n° 412). Académie des langues (terminologie, arts n° 215) : tèndaa « raie ».</text></form></note>
  </entry>
  <entry id="tɛndanɔɔ_5526">
    <lexical-unit><form lang="kqs"><text>tɛndanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛndanɔɔ_5526_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chirurgien</text></gloss>
      <gloss lang="en"><text>surgeon</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Tèndanöö; Lexique kissi–français, p. 55: tɛndanɔɔ</text></form></note>
  </entry>
  <entry id="tɛndiaa_5527">
    <lexical-unit><form lang="kqs"><text>tɛndiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛndia</text></form></variant>
    <sense id="tɛndiaa_5527_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre plusieurs fois, couper dans la longueur à maintes reprises</text></gloss>
      <gloss lang="en"><text>split repeatedly, cut lengthwise again and again</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛndiaa/ tɛndia</text></form></note>
    <note><form lang="fr"><text>Itératif de tɛndaa « fendre ».</text></form></note>
  </entry>
  <entry id="tɛndoo_5528">
    <lexical-unit><form lang="kqs"><text>tɛndoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="tɛndoo_5528_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cotylédon (de la noix de cola)</text></gloss>
      <gloss lang="en"><text>cotyledon (of the kola nut)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛndoo</text></form></note>
    <note><form lang="fr"><text>La Bible a tɛndoo une fois (ISA.30.14) au sens de « morceau, tesson » ; rapport à vérifier.</text></form></note>
  </entry>
  <entry id="tɛndudiomndo_5529">
    <lexical-unit><form lang="kqs"><text>tɛndudiomndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛndudiomndo_5529_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>syllabe</text></gloss>
      <gloss lang="en"><text>syllable</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 390: Tèndudiomndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. tɛndupilɔɔ « monosyllabe ».</text></form></note>
  </entry>
  <entry id="tɛnduo_5530">
    <lexical-unit><form lang="kqs"><text>tɛnduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛndu</text></form></variant>
    <sense id="tɛnduo_5530_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éclore</text></gloss>
      <gloss lang="en"><text>hatch</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: [t]ɛnduo/ tɛndu</text></form></note>
    <note><form lang="fr"><text>Homographe : tɛndu dans la Bible (ISA.30.14) signifie « morceau ».</text></form></note>
  </entry>
  <entry id="tɛnduo_5531">
    <lexical-unit><form lang="kqs"><text>tɛnduo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>tɛndu</text></form></variant>
    <sense id="tɛnduo_5531_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déterrer (le riz semé)</text></gloss>
      <gloss lang="en"><text>dig up (sown rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
      <trait name="semantic-domain-ddp4" value="7.8.6 Dig"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛndu</text></form></note>
    <note><form lang="fr"><text>Paulme : suŋua a tɛndu malo « les crapauds-buffles déterrent le riz ». Peut-être le même mot que tɛnduo « éclore » ; à vérifier.</text></form></note>
  </entry>
  <entry id="tɛndupilɔɔ_5532">
    <lexical-unit><form lang="kqs"><text>tɛndupilɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛndupilɔɔ_5532_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>monosyllabe</text></gloss>
      <gloss lang="en"><text>monosyllable</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 268: Tèndupilöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. pilɛ « un » ; diom tɛndulatiɔɔndo « dissyllabe ».</text></form></note>
  </entry>
  <entry id="tɛngie_5533">
    <lexical-unit><form lang="kqs"><text>tɛngie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛngi</text></form></variant>
    <sense id="tɛngie_5533_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou</text></gloss>
      <gloss lang="en"><text>hole</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngie; Sandara Kisia, fable 5: tɛŋgie, tɛŋgi</text></form></note>
  </entry>
  <entry id="tɛngullo_5534">
    <lexical-unit><form lang="kqs"><text>tɛngullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛngul</text></form></variant>
    <sense id="tɛngullo_5534_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter qqn ou qqch pour lui faire traverser un ruisseau</text></gloss>
      <gloss lang="en"><text>carry someone or something across a stream for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngullo/ tɛngul</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation au radical.</text></form></note>
  </entry>
  <entry id="tɛnguo_5535">
    <lexical-unit><form lang="kqs"><text>tɛnguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tɛngu</text></form></variant>
    <sense id="tɛnguo_5535_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter une charge pour traverser (un cours d'eau)</text></gloss>
      <gloss lang="en"><text>carry a load across (a stream)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛnguo/ tɛngu</text></form></note>
  </entry>
  <entry id="tɛ́ngɛ̀_5536">
    <lexical-unit><form lang="kqs"><text>tɛ́ngɛ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛngɛla</text></form></variant>
    <sense id="tɛ́ngɛ̀_5536_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lampe, torche</text></gloss>
      <gloss lang="en"><text>lamp, torch</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.1.6</text></form></note>
    <note><form lang="fr"><text>tɛngɛla « torches » (Jg 7,16).</text></form></note>
  </entry>
  <entry id="tɛngɛboenndo_5537">
    <lexical-unit><form lang="kqs"><text>tɛngɛboenndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛngɛboenndo_5537_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>luciole</text></gloss>
      <gloss lang="en"><text>firefly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngɛboenndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « l'insecte qui fait sortir le feu en s'envolant la nuit ».</text></form></note>
  </entry>
  <entry id="tɛngɛi_5538">
    <lexical-unit><form lang="kqs"><text>tɛngɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛngɛi_5538_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie des yeux (les yeux deviennent bleus)</text></gloss>
      <gloss lang="en"><text>eye disease (the eyes turn blue)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛngɛi</text></form></note>
    <note><form lang="fr"><text>Le Lexique l'attribue à un manque de niacine.</text></form></note>
  </entry>
  <entry id="tɛngɛlen_5539">
    <lexical-unit><form lang="kqs"><text>tɛngɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="tɛngɛlen_5539_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roseau ; herbe de savane</text></gloss>
      <gloss lang="en"><text>reed; savanna grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.40.26; Keita 1979, p. 140: Tèngèlen; Paulme 1964, p. 103: tɛŋɛle, pl. tɛŋyã; Lexique kissi–français, p. 55: tɛngɛlen</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 104 : aussi « bâtonnet des excisées ».</text></form></note>
  </entry>
  <entry id="tɛnɔɔ_5540">
    <lexical-unit><form lang="kqs"><text>tɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tɛnɔɔ_5540_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi ; semaine</text></gloss>
      <gloss lang="en"><text>Monday; week</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛno; Lexique kissi–français, p. 55: tɛnɔɔ</text></form></note>
    <note><form lang="fr"><text>Homographe : tɛnɔ̀ɔ́ dans la Bible (LAM.3.16) signifie « gravier ». Lundi se dit aussi sayɛiyo. À confirmer. Confirmé au Nord par Paulme 1964, p. 103 (tɛno « lundi », jour où l'on ne cultive pas).</text></form></note>
  </entry>
  <entry id="tɛnɔɔcɔnɔndo_5541">
    <lexical-unit><form lang="kqs"><text>tɛnɔɔcɔnɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛnɔɔcɔnɔndo_5541_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mardi</text></gloss>
      <gloss lang="en"><text>Tuesday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛnɔɔtyɔnɔndo</text></form></note>
    <note><form lang="fr"><text>Litt. « qui suit le lundi » (Paulme). Mardi se dit aussi tambɛiyo.</text></form></note>
  </entry>
  <entry id="tɛtɛɔ_5542">
    <lexical-unit><form lang="kqs"><text>tɛtɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛtɛɔ_5542_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>araignée ; cocon d'araignée</text></gloss>
      <gloss lang="en"><text>spider; spider's cocoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 104: tɛtɛo, pl. tɛtɛa; Lexique kissi–français, p. 55: tɛtɛɔ; Sandara Kisia, proverbe 22: Tɛtɛɔ</text></form></note>
    <note><form lang="fr"><text>Voir aussi sontɛndɔɔ. Paulme 1964, p. 104 : aussi « cocon d'araignée ». Sandara Kissia, devinette 22 : réponse « l'araignée ».</text></form></note>
  </entry>
  <entry id="tɛu_5543">
    <lexical-unit><form lang="kqs"><text>tɛu</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tɛu_5543_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière</text></gloss>
      <gloss lang="en"><text>termite mound</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chaff, rice straw left after threshing</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tèu; Childs 2000, p. 358: tèùwó</text></form></note>
    <note><form lang="fr"><text>Le sens « termitière » est douteux : la Bible a tɛwvo « paille, chaume » (1CO.3.12), comme le mot de Childs.</text></form></note>
  </entry>
  <entry id="tɛwvo_5544">
    <lexical-unit><form lang="kqs"><text>tɛwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛwvo_5544_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaume (qui reste debout dans les champs après la moisson)</text></gloss>
      <gloss lang="en"><text>stubble</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first RUT.2.7; Lexique kissi–français, p. 55: tɛwvo</text></form></note>
  </entry>
  <entry id="tɛwvo_5545">
    <lexical-unit><form lang="kqs"><text>tɛwvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛwvo_5545_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce) dont on frotte les calebasses</text></gloss>
      <gloss lang="en"><text>tree (species) used to scour calabashes</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 104: tɛwo, pl. tɛorã /peu usité/</text></form></note>
    <note><form lang="fr"><text>Moracée, Ficus asperifolia (feuilles rugueuses). Pluriel peu usité. Homographe de tɛwvo « chaume » ; Paulme écrit w intervocalique là où la Bible a wv (suwo, Bible suwvo).</text></form></note>
  </entry>
  <entry id="tɛŋundu_5546">
    <lexical-unit><form lang="kqs"><text>tɛŋundu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛŋundu_5546_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (espèce) médicinale</text></gloss>
      <gloss lang="en"><text>medicinal plant (species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 104: tɛŋundu</text></form></note>
    <note><form lang="fr"><text>Ses feuilles entrent dans la préparation de la médecine nyuruwa doma (Paulme).</text></form></note>
  </entry>
  <entry id="tɛŋɔvo_5547">
    <lexical-unit><form lang="kqs"><text>tɛŋɔvo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tɛŋɔvo_5547_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>loucher</text></gloss>
      <gloss lang="en"><text>squint</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 104: tɛŋɔwo</text></form></note>
    <note><form lang="fr"><text>Paulme : wana i tɛnɔwɔ « homme qui louche » (ŋ ou n). Forme à confirmer.</text></form></note>
  </entry>
  <entry id="tɛɔ_5548">
    <lexical-unit><form lang="kqs"><text>tɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tɛa</text></form></field>
    <sense id="tɛɔ_5548_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termite ailé</text></gloss>
      <gloss lang="en"><text>winged termite</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: tɛɔ, pl. tɛa</text></form></note>
    <note><form lang="fr"><text>Homographe de tɛɔ (NUM.13.30), qui a un autre sens.</text></form></note>
  </entry>
  <entry id="tɛɔndɔɔ_5549">
    <lexical-unit><form lang="kqs"><text>tɛɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɔndɔɔ_5549_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>second, deuxième</text></gloss>
      <gloss lang="en"><text>second</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 55: tɛɔndɔɔ; Sandara Kisia, fable 14: tɛɔndɔ</text></form></note>
    <note><form lang="fr"><text>La Bible dit diinndɔɔ « deuxième ».</text></form></note>
  </entry>
  <entry id="tɛɛkpaa_5550">
    <lexical-unit><form lang="kqs"><text>tɛɛkpaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛkpaa_5550_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>février</text></gloss>
      <gloss lang="en"><text>February</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Tèèkpaa; Lexique kissi–français, p. 54: tɛɛkpaa; Terminologie (langue), n° 438: Tèèkpaa ✎ 6</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 438) : « février », numéroté à la main 6.</text></form></note>
  </entry>
  <entry id="tɛɛlɔnndo_5551">
    <lexical-unit><form lang="kqs"><text>tɛɛlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛlun</text></form></variant>
    <sense id="tɛɛlɔnndo_5551_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supplier, implorer, prier ; se plaindre à ; solliciter ; demander pardon (aux aînés)</text></gloss>
      <gloss lang="en"><text>plead, implore, pray; complain to; solicit; ask forgiveness (of elders)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first EXO.9.29; Paulme 1964, p. 104: telɔndo; Lexique kissi–français, p. 55: tɛlɔnndo/ tɛlun</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 55 : écrit tɛlɔnndo/ tɛlun. Paulme 1964, p. 104 : telɔndo « demander pardon, amende honorable due aux vieux » ; mɔ telun fiŋa ndo « il a demandé pardon à son père ».</text></form></note>
  </entry>
  <entry id="tɛɛmbua_5552">
    <lexical-unit><form lang="kqs"><text>tɛɛmbua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛmbua_5552_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>destructeur</text></gloss>
      <gloss lang="en"><text>destroying, destroyer</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first EXO.12.13</text></form></note>
    <note><form lang="fr"><text>De tɛɛmbuuo. mɛlɛkanɔ tɛɛmbua « l'ange destructeur ».</text></form></note>
  </entry>
  <entry id="tɛɛmbuula_5553">
    <lexical-unit><form lang="kqs"><text>tɛɛmbuula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɛɛmbuulan</text></form></field>
    <sense id="tɛɛmbuula_5553_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>transgressions, fautes</text></gloss>
      <gloss lang="en"><text>transgressions, offences</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first LEV.16.21</text></form></note>
    <note><form lang="fr"><text>De tɛɛmbuuo « détruire ; transgresser ».</text></form></note>
  </entry>
  <entry id="tɛɛmbuuo_5554">
    <lexical-unit><form lang="kqs"><text>tɛɛmbuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛmbuu</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛmbuunin</text></form></variant>
    <sense id="tɛɛmbuuo_5554_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>détruire, anéantir ; transgresser (une loi)</text></gloss>
      <gloss lang="en"><text>destroy; break, transgress (a law)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of tàmbéí 'be ruined': spoil, break, misuse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 176 occurrences, first GEN.19.13; Terminologie (histoire), n° 6: Tèèmbuuo, puusiaa; Childs 2000, p. 353: tèèmbùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tambu « être ruiné ». Académie des langues (terminologie, histoire n° 6) : « abroger » (aussi puusiaa). Aussi Terminologie, p. 584 : « Tèèmbuuo, fanhaa ». Académie des langues (terminologie, histoire n° 584) : « suppression » (aussi faŋaa).</text></form></note>
  </entry>
  <entry id="tɛɛn_5555">
    <lexical-unit><form lang="kqs"><text>tɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛn_5555_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>entre, parmi</text></gloss>
      <gloss lang="en"><text>between, among</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2313 occurrences, first GEN.1.6; Terminologie (arts), n° 243: Tèèn; Childs 2000, p. 354: tɛ́ɛ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, arts n° 243) : « milieu ».</text></form></note>
  </entry>
  <entry id="tɛɛndanndo_5556">
    <lexical-unit><form lang="kqs"><text>tɛɛndanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛndan</text></form></variant>
    <sense id="tɛɛndanndo_5556_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mépriser, regarder de haut, se moquer de</text></gloss>
      <gloss lang="en"><text>despise, look down on, scorn</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.16.4</text></form></note>
  </entry>
  <entry id="tɛɛndiaa_5557">
    <lexical-unit><form lang="kqs"><text>tɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛndiaanin</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛndian</text></form></variant>
    <sense id="tɛɛndiaa_5557_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, faire éclater ; se fendre, s'ouvrir (terre)</text></gloss>
      <gloss lang="en"><text>split, burst open; split apart (earth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>split; divide, distribute; show one by one</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.7.11; Paulme 1964, p. 103: tɛndya; Childs 2000, p. 353: tɛ̀ɛ̀ndìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛndaa « fendre ». Paulme 1964, p. 103 : tɛndya « ouvrir » (les singes ont ouvert le riz).</text></form></note>
  </entry>
  <entry id="tɛ̀ɛ̀ndo_5558">
    <lexical-unit><form lang="kqs"><text>tɛ̀ɛ̀ndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛ̀ɛ̀ndo_5558_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>teigne ; gale</text></gloss>
      <gloss lang="en"><text>scalp ringworm, scall; scabies</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ringworm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.11.4; Keita 1979, p. 162: Tèèndo; Lexique kissi–français, p. 54: tɛɛndo; Childs 2000, p. 355: tɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit tɛ̀ɛ̀ndo dans ce sens ; tɛɛndo sans ton y signifie « du milieu » (Ex 26,28).</text></form></note>
  </entry>
  <entry id="tɛɛnduuo_5559">
    <lexical-unit><form lang="kqs"><text>tɛɛnduuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛnduuo_5559_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couver (des œufs)</text></gloss>
      <gloss lang="en"><text>hatch (eggs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hatch eggs</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.59.5; Paulme 1964, p. 103: tɛndu; Childs 2000, p. 354: tèèndùùwó</text></form></note>
    <note><form lang="fr"><text>A co pelta hɔ̀ɔ̀lɔ́ɔ̀ tɛɛnduuo « ils couvent des œufs de vipère » (ISA.59.5). Une seule attestation. Paulme 1964, p. 103 : sɔɔ tɛndu « la poule a couvé ».</text></form></note>
  </entry>
  <entry id="tɛɛngaa_5560">
    <lexical-unit><form lang="kqs"><text>tɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛngaa_5560_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, transporter ; transmettre (un message)</text></gloss>
      <gloss lang="en"><text>convey, carry across; deliver (a message)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 619 occurrences, first GEN.20.7</text></form></note>
    <note><form lang="fr"><text>vana-tɛɛngaa-diom-Hala « prophète » ; vanaa tɛɛngaa « les marins » (Jon 1,5).</text></form></note>
  </entry>
  <entry id="tɛɛngei_5561">
    <lexical-unit><form lang="kqs"><text>tɛɛngei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɛɛngon</text></form></field>
    <sense id="tɛɛngei_5561_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou, brèche, creux</text></gloss>
      <gloss lang="en"><text>hole, breach, hollow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hole; burrow (of a rat or squirrel)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first JDG.15.19; Childs 2000, p. 354: tèèŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɛɛngullo_5562">
    <lexical-unit><form lang="kqs"><text>tɛɛngullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛngul</text></form></variant>
    <sense id="tɛɛngullo_5562_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>annoncer, rapporter (à qqn), dire à</text></gloss>
      <gloss lang="en"><text>tell, report (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take (someone) across for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first EXO.4.16; Childs 2000, p. 355: tèèŋùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛngaa.</text></form></note>
  </entry>
  <entry id="tɛɛnguuo_5563">
    <lexical-unit><form lang="kqs"><text>tɛɛnguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛnguu</text></form></variant>
    <sense id="tɛɛnguuo_5563_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire traverser, faire passer (plusieurs)</text></gloss>
      <gloss lang="en"><text>take across, make (many) cross</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cross with or carry across (a river); plural of tàŋɔ̀ɔ́ 'cross'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first NUM.11.27; Terminologie (histoire), n° 436: Tèènguuo; Childs 2000, p. 355: tèèŋùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛɛngaa. Académie des langues (terminologie, histoire n° 436) : « navigation ».</text></form></note>
  </entry>
  <entry id="tɛɛngɛi_5564">
    <lexical-unit><form lang="kqs"><text>tɛɛngɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛngɛi_5564_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brèche</text></gloss>
      <gloss lang="en"><text>breach, gap</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 121: Tèèngèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɛɛnkpɛn_5565">
    <lexical-unit><form lang="kqs"><text>tɛɛnkpɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛnkpɛn_5565_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>médiocre</text></gloss>
      <gloss lang="en"><text>mediocre</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 249: Tèènkpèn</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɛɛnuu_5566">
    <lexical-unit><form lang="kqs"><text>tɛɛnuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛnuu_5566_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dégager, défricher (un chemin)</text></gloss>
      <gloss lang="en"><text>clear (a way), clear of vegetation</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear an area of large vegetation for cultivation</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.40.3; Childs 2000, p. 354: tèènùùwó</text></form></note>
    <note><form lang="fr"><text>La tɛɛnuu nɛi Mɛlɛka-oo « préparez le chemin du Seigneur » (ISA.40.3).</text></form></note>
  </entry>
  <entry id="tɛɛnɔn_5567">
    <lexical-unit><form lang="kqs"><text>tɛɛnɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛnɔn_5567_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gravier</text></gloss>
      <gloss lang="en"><text>gravel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tèènön; Lexique kissi–français, p. 54: tɛɛnɔn</text></form></note>
  </entry>
  <entry id="tɛ́ɛ́nɛí_5568">
    <lexical-unit><form lang="kqs"><text>tɛ́ɛ́nɛí</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛ́ɛ́nɛí_5568_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit caillou, grain (de poussière)</text></gloss>
      <gloss lang="en"><text>small stone, grain (of dust)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>small rock or stone; ten large sheaves of rice</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.8.26; Keita 1979, p. 155: Tèènön; Childs 2000, p. 357: ténéí</text></form></note>
    <note><form lang="fr"><text>hali tɛ́ɛ́nɛí tasei o cundoo nin lɛŋ « ni le premier grain de la poussière du monde » (PRO.8.26). Pluriel : Keita tɛɛnɔn « gravier » (Childs ténɔ́ŋ).</text></form></note>
  </entry>
  <entry id="tɛɛsiaa_5569">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsiaa_5569_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer</text></gloss>
      <gloss lang="en"><text>interpret, explain</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.40; Terminologie (langue), n° 108: Tèèsiaa</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 108 et 115) : « décrire, description ».</text></form></note>
  </entry>
  <entry id="tɛɛsiaakaao_5570">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaakaao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛsiaakaao_5570_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>adjectif qualificatif ; qualifier</text></gloss>
      <gloss lang="en"><text>qualifying adjective; qualify</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.1 Adjectives"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 340: Tèèsiaakaao</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Qualifier » : kaa tèèsiaa (langue n° 341).</text></form></note>
  </entry>
  <entry id="tɛɛsiaanɔɔvo_5571">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaanɔɔvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛsiaanɔɔvo_5571_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>possessif (adjectif)</text></gloss>
      <gloss lang="en"><text>possessive (adjective)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.1 Adjectives"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 325: Tèèsiaanöövo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Formé sur tɛɛsiaao « adjectif » et nɔ « avoir ».</text></form></note>
  </entry>
  <entry id="tɛɛsiaao_5572">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛsiaao_5572_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>adjectif, déterminatif</text></gloss>
      <gloss lang="en"><text>adjective, determiner</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.1 Adjectives"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 12: Tèèsiaao</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Il rend aussi « déterminatif » (langue n° 116). Formé sur tɛɛsiaa « expliquer ».</text></form></note>
  </entry>
  <entry id="tɛɛsiaayɔnnɔn diomladiomndo_5573">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaayɔnnɔn diomladiomndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛsiaayɔnnɔn diomladiomndo_5573_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>locution adverbiale</text></gloss>
      <gloss lang="en"><text>adverbial phrase</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 240: Tèèsiaayönnön diomladiomndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɛɛsiaayɔnnɔnndo_5574">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaayɔnnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛsiaayɔnnɔnndo_5574_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>adverbe</text></gloss>
      <gloss lang="en"><text>adverb</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 14: Tèèsiaayönnönndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Formé sur tɛɛsiaa « expliquer » ; la graphie de la seconde partie (n ou ŋ, cf. yɔŋndo « action ») est à vérifier.</text></form></note>
  </entry>
  <entry id="tɛɛsial_5575">
    <lexical-unit><form lang="kqs"><text>tɛɛsial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsial_5575_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer (à qqn)</text></gloss>
      <gloss lang="en"><text>interpret, explain (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.41.12</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛsiaa.</text></form></note>
  </entry>
  <entry id="va_5576">
    <lexical-unit><form lang="kqs"><text>va</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ve</text></form></variant>
    <variant><form lang="kqs"><text>vanin</text></form></variant>
    <sense id="va_5576_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être (passé) ; auxiliaire du progressif passé</text></gloss>
      <gloss lang="en"><text>be (past); past progressive auxiliary</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11781 occurrences, first GEN.1.2; Paulme 1964, p. 119: wa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 119 : i wa la duo « j'étais pour manger » ; i wa la kɔrã « je voulais partir ».</text></form></note>
  </entry>
  <entry id="va_5577">
    <lexical-unit><form lang="kqs"><text>va</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="va_5577_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ou, donc ; particule interrogative ; exclamation d'émerveillement</text></gloss>
      <gloss lang="en"><text>or, so; question particle; exclamation of wonder</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne trois mots va (p. 59) : « ou, donc », « mot d'exclamation ou d'émerveillement », « une interrogation ». À distinguer du verbe va « être (passé) ».</text></form></note>
  </entry>
  <entry id="va a kɔl tam biɛyo_5578">
    <lexical-unit><form lang="kqs"><text>va a kɔl tam biɛyo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="va a kɔl tam biɛyo_5578_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fâché</text></gloss>
      <gloss lang="en"><text>be angry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va a kɔl tam biɛyo</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; tam est peut-être kɔl-tan « intérieur du cœur ». À vérifier.</text></form></note>
  </entry>
  <entry id="va a ɲaaloo_5579">
    <lexical-unit><form lang="kqs"><text>va a ɲaaloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="va a ɲaaloo_5579_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être content</text></gloss>
      <gloss lang="en"><text>be glad, be happy</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: va a ɲalo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit ɲalo ; la Bible écrit ɲaaloo « joie ».</text></form></note>
  </entry>
  <entry id="vaa_5580">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaa_5580_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte, genre (vaa lende « de cette sorte, tel »)</text></gloss>
      <gloss lang="en"><text>kind, sort (vaa lende 'of that kind, such')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Childs 2000, p. 377: wàà</text></form></note>
    <note><form lang="fr"><text>dɛnɛ kɔlvesɛi bɛndu vaa lende « un si grand mal » (GEN.39.9) ; ɲɛla vaa lende « de telles choses » (1SA.17.39). Homographe de vaa « mille », vaa « cultiver », vaa « être ».</text></form></note>
  </entry>
  <entry id="vaa_5581">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vàálan</text></form></field>
    <variant><form lang="kqs"><text>vabɛlɛ</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="vaa_5581_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>mille</text></gloss>
      <gloss lang="en"><text>thousand</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Paulme 1964, p. 117 (G): vā, vaa /G./; Lexique kissi–français, p. 59: vaa; Childs 2000, p. 377: wàá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 117 et 119 : vā, vaa /G./ ; wabɛlɛ /K./ « mille ». Paulme : vā /G./ ; wabɛlɛ /K./ (p. 117, 119).</text></form></note>
  </entry>
  <entry id="vàá_5582">
    <lexical-unit><form lang="kqs"><text>vàá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vee</text></form></variant>
    <variant><form lang="kqs"><text>veenin</text></form></variant>
    <sense id="vàá_5582_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cultiver, labourer</text></gloss>
      <gloss lang="en"><text>farm, plough</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Keita 1979, p. 115: Vaa; Paulme 1964, p. 119: waā; Lexique kissi–français, p. 59: vaa/ va, vee</text></form></note>
    <note><form lang="fr"><text>le vàá « labourer » (DEU 22,10) ; vee, veenin : radical négatif (PRO 20,4 ; GEN 45,6). Homonyme de vaa « être ». Confirmé au Nord par le Lexique kissi–français, p. 59 (vaa/ va, vee « labourer ») ; la Bible a le vàá « labourer » (DEU.22.10), ɲɛm niaa vàá « ce que vous cultivez » (DEU.14.22). Paulme 1964, p. 119 : tout le travail de la terre ; wana wa, wana va « cultivateur ».</text></form></note>
  </entry>
  <entry id="vaa_5583">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>co</text></form></variant>
    <variant><form lang="kqs"><text>va</text></form></variant>
    <sense id="vaa_5583_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être</text></gloss>
      <gloss lang="en"><text>be</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Keita 1979, p. 115: Vaw; Lexique kissi–français, p. 60: vau/ co, ve, va; Terminologie (langue), n° 43: Vaa</text></form></note>
    <note><form lang="fr"><text>Keita écrit vaw (radicaux tyo, vo, va) ; la Bible a le vaa « être » (GEN 3,12) ; vaw y désigne le palmier (JDG 4,5). Lexique kissi–français, p. 59-60 : vau/ co, ve, va « être » ; radical va « être, être sur ». Académie des langues (terminologie, langue n° 43) : « attribut ».</text></form></note>
  </entry>
  <entry id="vaaliaa_5584">
    <lexical-unit><form lang="kqs"><text>vaaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaaliaa_5584_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir aigre ; (dents) être agacées ; (âme) être amère</text></gloss>
      <gloss lang="en"><text>turn sour; (of teeth) be set on edge; be bitter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.7.11; Childs 2000, p. 377: wààlàá</text></form></note>
  </entry>
  <entry id="vaalio_5585">
    <lexical-unit><form lang="kqs"><text>vaalio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalio_5585_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>maintenant, de nos jours ; actuel (vanndacieea vaalio ho « cette génération »)</text></gloss>
      <gloss lang="en"><text>now, nowadays; present (vanndacieea vaalio ho 'this generation')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.5.14; Terminologie (langue), n° 13: Vaalioo, lediindohoo; Childs 2000, p. 377: wáálíò</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 13) : vaalioo « actualité » (aussi lediindohoo).</text></form></note>
  </entry>
  <entry id="vaalɛiyan_5586">
    <lexical-unit><form lang="kqs"><text>vaalɛiyan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalɛiyan_5586_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aigre (mɔima vaalɛiyan « vinaigre »)</text></gloss>
      <gloss lang="en"><text>sour (mɔima vaalɛiyan 'vinegar')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.6.3; Childs 2000, p. 377: wààlɛ́í</text></form></note>
    <note><form lang="fr"><text>De vaaliaa.</text></form></note>
  </entry>
  <entry id="vaan-vaan_5587">
    <lexical-unit><form lang="kqs"><text>vaan-vaan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="vaan-vaan_5587_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fin, léger (tissu) : kola vaan-vaan « voile »</text></gloss>
      <gloss lang="en"><text>fine, thin (cloth): kola vaan-vaan 'veil'</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note><form lang="fr"><text>Toujours dans kola vaan-vaan « voile » (GEN.38.19, SNG.4.1, 2CO.3.14) ; le sens propre de vaan-vaan est à confirmer.</text></form></note>
  </entry>
  <entry id="vaasan_5588">
    <lexical-unit><form lang="kqs"><text>vaasan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaasan_5588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>incisions, entailles (sur le corps, en signe de deuil)</text></gloss>
      <gloss lang="en"><text>cuts, gashes (on the body, in mourning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first LEV.19.28</text></form></note>
    <note><form lang="fr"><text>keŋnun / kiáŋnun vaasan lekɔɔ « se faire des incisions » (LEV.21.5, LEV.19.28).</text></form></note>
  </entry>
  <entry id="vaiye_5589">
    <lexical-unit><form lang="kqs"><text>vaiye</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vayele</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <variant><form lang="kqs"><text>vaile</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="vaiye_5589_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taro</text></gloss>
      <gloss lang="en"><text>taro</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 117 (G): vayele /G./; Lexique kissi–français, p. 59: [va]iye</text></form></note>
    <note><form lang="fr"><text>Le Lexique met va- entre crochets : lecture incertaine. Paulme 1964, p. 117 et 120 : vayele /G./, wayle /K./, pl. waye. Paulme : vayele /G./ ; wayle /K./ (p. 117).</text></form></note>
  </entry>
  <entry id="vakpa_5590">
    <lexical-unit><form lang="kqs"><text>vakpa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vakpa_5590_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, ouvertement, à découvert</text></gloss>
      <gloss lang="en"><text>clearly, openly, in plain view</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.30.37; Lexique kissi–français, p. 59: vakpa</text></form></note>
    <note><form lang="fr"><text>o fula vannda o hɔl vakpa le « il ne monta pas ouvertement » (JHN.7.10).</text></form></note>
  </entry>
  <entry id="valaa_5591">
    <lexical-unit><form lang="kqs"><text>valaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>valalan</text></form></field>
    <variant><form lang="kqs"><text>vala</text></form></variant>
    <variant><form lang="kqs"><text>varaa</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="valaa_5591_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>natte ; grabat, couche</text></gloss>
      <gloss lang="en"><text>mat; pallet, bed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(sleeping) mat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2SA.17.19; Paulme 1964, p. 119: wala, wará, pl. waralã; Lexique kissi–français, p. 60: varaa; Terminologie (arts), n° 175: Valaa ; lavöö, kandelen; Childs 2000, p. 379: wàlàá</text></form></note>
    <note><form lang="fr"><text>o ɲɛla hinialan coo a o valalan coo « sur des lits et des grabats » (ACT.5.15) ; cua vala nɔmndo « prends ton grabat » (ACT.9.34) ; maa vala « comme une natte (roulée) » (ISA.34.4). Le Lexique kissi–français (p. 60) écrit varaa « le petit tapis, la natte ». Académie des langues (terminologie, arts n° 175) : « natte » (aussi lavöö, kandelen).</text></form></note>
  </entry>
  <entry id="valaa_5592">
    <lexical-unit><form lang="kqs"><text>valaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="valaa_5592_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aigre</text></gloss>
      <gloss lang="en"><text>sour</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 119: wala; Lexique kissi–français, p. 59: valaa</text></form></note>
    <note><form lang="fr"><text>Homographe de valaa « natte ». Paulme 1964, p. 119 : dumbulle le wala « un citron acide » ; ɔ wala « il est acide ».</text></form></note>
  </entry>
  <entry id="valaa_5593">
    <lexical-unit><form lang="kqs"><text>valaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="valaa_5593_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>texte</text></gloss>
      <gloss lang="en"><text>text</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 402: Valaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Homographe de valaa « natte » ; cf. valaa tiimbuuo « étude de texte » (langue n° 162).</text></form></note>
  </entry>
  <entry id="valaa tiimbuuo_5594">
    <lexical-unit><form lang="kqs"><text>valaa tiimbuuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="valaa tiimbuuo_5594_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étude de texte</text></gloss>
      <gloss lang="en"><text>text study</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 162: Valaa tiimbuuo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="válán_5595">
    <lexical-unit><form lang="kqs"><text>válán</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="válán_5595_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, avec certitude ; clair</text></gloss>
      <gloss lang="en"><text>clearly, for certain; clear</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first GEN.22.12; Terminologie (arts), n° 57: Valan</text></form></note>
    <note><form lang="fr"><text>Dans la Bible surtout après sina « savoir » : sina válán « savoir avec certitude » (GEN.22.12, EXO.7.17). L'Académie des langues (terminologie, arts n° 57) en fait le terme pour « clair » (couleur).</text></form></note>
  </entry>
  <entry id="valansɔɔ_5596">
    <lexical-unit><form lang="kqs"><text>valansɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="valansɔɔ_5596_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nomenclature</text></gloss>
      <gloss lang="en"><text>nomenclature</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 281: Valansöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="valehɔlnɔ diompilɔɔ_5597">
    <lexical-unit><form lang="kqs"><text>valehɔlnɔ diompilɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="valehɔlnɔ diompilɔɔ_5597_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>inspecteur du Parti</text></gloss>
      <gloss lang="en"><text>Party inspector</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 378: Valehölnö diompilöö (paatiiyo)</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970) ; paatiiyo « parti ».</text></form></note>
  </entry>
  <entry id="valen_5598">
    <lexical-unit><form lang="kqs"><text>valen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="valen_5598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rayon de miel ; cire d'abeille</text></gloss>
      <gloss lang="en"><text>honeycomb; beeswax</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: valen</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi vaa « cire des abeilles, rayon de miel » (p. 59).</text></form></note>
  </entry>
  <entry id="valiyiyɛi_5599">
    <lexical-unit><form lang="kqs"><text>valiyiyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="valiyiyɛi_5599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prophétie</text></gloss>
      <gloss lang="en"><text>prophecy</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 59: valiyiyɛi</text></form></note>
  </entry>
  <entry id="vallo_5600">
    <lexical-unit><form lang="kqs"><text>vallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>valtan</text></form></field>
    <variant><form lang="kqs"><text>vali</text></form></variant>
    <variant><form lang="kqs"><text>valta</text></form></variant>
    <variant><form lang="kqs"><text>vallon</text></form></variant>
    <sense id="vallo_5600_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage ; activité</text></gloss>
      <gloss lang="en"><text>work, labour; activity</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 137 occurrences, first GEN.2.2; Lexique kissi–français, p. 59: vallo; Terminologie (idéologie), n° 620: Baalaa ; vallo; Childs 2000, p. 379: wàlló</text></form></note>
    <note><form lang="fr"><text>ɲɛm vallon « ustensiles » (Ex 31,8). Lexique kissi–français, p. 59 : « activité ; le travail ».</text></form></note>
  </entry>
  <entry id="valoo_5601">
    <lexical-unit><form lang="kqs"><text>valoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="valoo_5601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sécheresse, temps sec, absence de pluie</text></gloss>
      <gloss lang="en"><text>drought, dry weather, absence of rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a short dry spell, a break in the rains</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.11.17; Childs 2000, p. 379: wàlòó</text></form></note>
    <note><form lang="fr"><text>o tuisi niaa valoo coo « il fera venir la sécheresse sur vous » (DEU.11.17) ; Valoo vanin ni « il fera beau » (MAT.16.2).</text></form></note>
  </entry>
  <entry id="valuo_5602">
    <lexical-unit><form lang="kqs"><text>valuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>varuo</text></form></variant>
    <sense id="valuo_5602_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>saison sèche ; période sans pluie pendant l'hivernage</text></gloss>
      <gloss lang="en"><text>dry season; dry spell in the rainy season</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 120: waruo; Lexique kissi–français, p. 60: varuo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit varuo ; varu bɛnduo « la sécheresse » (p. 60). Paulme 1964, p. 120 : waruo « se dit en hivernage, quand il n'a pas plu depuis 4 ou 5 jours ». Cf. valoo « sécheresse, absence de pluie ».</text></form></note>
  </entry>
  <entry id="vana_5603">
    <lexical-unit><form lang="kqs"><text>vana</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vanaa</text></form></field>
    <sense id="vana_5603_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui qui, quelqu'un (tête de relative) ; personne</text></gloss>
      <gloss lang="en"><text>the one who, someone (head of a relative clause); person</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="2 Person"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9813 occurrences, first GEN.1.26; Paulme 1964, p. 119: wana; Childs 2000, p. 379: wànà-</text></form></note>
    <note><form lang="fr"><text>Pluriel vanaa « ceux qui, les gens » : vanaa mandaa n'cɔlua « ceux qui gardent les troupeaux » (Gn 4,20). Paulme 1964, p. 119-120 : wana pɔno « individu mâle » ; wana kyaya « humanité » ; wana bɔrɔ « charmeur de serpents » ; wana lua kɔla « tisserand » ; wana suanda « tailleur » ; wana yɔya « pêcheur au filet » ; wana sundo « incirconcis » ; wana ũilɛyo « mort, cadavre » ; wana wyɛndo « homme marié ».</text></form></note>
  </entry>
  <entry id="vana bala_5604">
    <lexical-unit><form lang="kqs"><text>vana bala</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vana bara</text></form></variant>
    <sense id="vana bala_5604_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travailleur ; serviteur</text></gloss>
