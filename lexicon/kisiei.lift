    <variant><form lang="kqs"><text>tɔalnin</text></form></variant>
    <sense id="tɔlɔɔ_1735_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>planter ; plante, arbre</text></gloss>
      <gloss lang="en"><text>plant; plant, tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first EXO.10.5; Keita 1979, p. 115: Tölöö</text></form></note>
    <note><form lang="fr"><text>tɔlɔɔ est aussi le nom « arbre, plante » (EXO 10,5).</text></form></note>
  </entry>
