      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 339: sóómàmɛ̀ŋndó</text></form></note>
  </entry>
  <entry id="sòòndìó_3074">
    <lexical-unit><form lang="kqs"><text>sòòndìó</text></form></lexical-unit>
