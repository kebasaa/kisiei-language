  <entry id="yɛ̀ŋgbɛ̀ŋ-yɛ̀ŋgbɛ̂ŋ_6361">
    <lexical-unit><form lang="kqs"><text>yɛ̀ŋgbɛ̀ŋ-yɛ̀ŋgbɛ̂ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
