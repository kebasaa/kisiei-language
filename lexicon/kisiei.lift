      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.30.25; Keita 1979, p. 144: Lasikölöö; Lexique kissi–français, p. 31: lasikɔlɔɔ</text></form></note>
  </entry>
  <entry id="làsìmùèíyó_2363">
    <lexical-unit><form lang="kqs"><text>làsìmùèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làsìmùèíyó_2363_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remède préparé par un marabout musulman</text></gloss>
      <gloss lang="en"><text>medicine made by a Muslim healer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làsìmùèíyó</text></form></note>
  </entry>
  <entry id="lasiɛmbu_2364">
    <lexical-unit><form lang="kqs"><text>lasiɛmbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lasiɛmbu_2364_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honte (lasiɛmbu yɔŋ « avoir honte »)</text></gloss>
      <gloss lang="en"><text>shame (lasiɛmbu yɔŋ 'be ashamed')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.2.25</text></form></note>
    <note><form lang="fr"><text>Cf. siɛmbulan.</text></form></note>
  </entry>
  <entry id="lasoo_2365">
    <lexical-unit><form lang="kqs"><text>lasoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lasoo_2365_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciment, sol cimenté</text></gloss>
      <gloss lang="en"><text>cement, paved floor</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CH.7.3; Lexique kissi–français, p. 31: lasoo</text></form></note>
    <note><form lang="fr"><text>o lasoo-o coo « sur le pavé » (2CH.7.3).</text></form></note>
  </entry>
  <entry id="làsɔ̀ɔ́_2366">
    <lexical-unit><form lang="kqs"><text>làsɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="làsɔ̀ɔ́_2366_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avouer ; dénoncer, rapporter (sur qqn)</text></gloss>
      <gloss lang="en"><text>confess; report on, tell on</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làsɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="latámán_2367">
    <lexical-unit><form lang="kqs"><text>latámán</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="latámán_2367_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sicle (poids, pièce d'argent)</text></gloss>
      <gloss lang="en"><text>shekel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 89 occurrences, first GEN.20.16</text></form></note>
  </entry>
  <entry id="latulu_2368">
    <lexical-unit><form lang="kqs"><text>latulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="latulu_2368_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ensemble, en même temps</text></gloss>
      <gloss lang="en"><text>together, at the same time</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 428 occurrences, first GEN.3.6; Childs 2000, p. 224: làtùlú</text></form></note>
  </entry>
  <entry id="latɔŋndo_2369">
    <lexical-unit><form lang="kqs"><text>latɔŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>latɔŋnda</text></form></field>
    <sense id="latɔŋndo_2369_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loi (de Moïse)</text></gloss>
      <gloss lang="en"><text>law (of Moses)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EZR.7.6</text></form></note>
    <note><form lang="fr"><text>vanaa pɛɛkaa latɔŋnda « les maîtres de la loi ».</text></form></note>
  </entry>
  <entry id="latɔ́ɔ́_2370">
    <lexical-unit><form lang="kqs"><text>latɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>latɔ́ɔ́a</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́lan</text></form></variant>
    <variant><form lang="kqs"><text>latɔ́ɔ́-tɔ́ɔ́</text></form></variant>
    <sense id="latɔ́ɔ́_2370_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noble, grand, précieux</text></gloss>
      <gloss lang="en"><text>noble, great, precious</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.30.20</text></form></note>
    <note><form lang="fr"><text>vanaa latɔ́ɔ́a « les grands » (Jb 3,14). Redoublé latɔ́ɔ́-tɔ́ɔ́ : ɲɛ latɔ́ɔ́-tɔ́ɔ́ « un beau présent » (Gn 30,20) ; Hala latɔ́ɔ́-tɔ́ɔ́ « le Dieu puissant » (Is 10,21).</text></form></note>
  </entry>
  <entry id="làùwó_2371">
    <lexical-unit><form lang="kqs"><text>làùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="làùwó_2371_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tortiller (comme un serpent)</text></gloss>
      <gloss lang="en"><text>wriggle (like a snake), squirm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làùwó</text></form></note>
  </entry>
  <entry id="lavɔɔ_2372">
    <lexical-unit><form lang="kqs"><text>lavɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>law</text></form></variant>
    <sense id="lavɔɔ_2372_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tresses, coiffure tressée ; (law) tresser</text></gloss>
      <gloss lang="en"><text>braids, braided hairstyle; (law) braid, plait</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) plait, braid, weave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.3.24; Lexique kissi–français, p. 31: lavɔɔ; Childs 2000, p. 224: làùwɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>lavɔɔ kɛndɛ o lebol « une belle coiffure » (ISA.3.24) ; A law lavɔɔ báà kala le « qu'elles ne se fassent pas de tresses » (1TI.2.9). Correspondance w (Childs) ~ v (Bible). Cf. lɔu « tresser, tisser ». À distinguer de lavɔɔn « aisselles ; en secret ». Lexique kissi–français, p. 31 : law yinde « tresser (les cheveux) ».</text></form></note>
  </entry>
  <entry id="làwáá_2373">
    <lexical-unit><form lang="kqs"><text>làwáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làwáá_2373_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mille-pattes</text></gloss>
      <gloss lang="en"><text>millipede</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 225: làwáá</text></form></note>
  </entry>
  <entry id="lawnɔɔ_2374">
    <lexical-unit><form lang="kqs"><text>lawnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="lawnɔɔ_2374_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tresseuse</text></gloss>
      <gloss lang="en"><text>hair braider</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Lawnöö; Lexique kissi–français, p. 31: lawnɔɔ</text></form></note>
  </entry>
  <entry id="lawvo_2375">
    <lexical-unit><form lang="kqs"><text>lawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>law</text></form></variant>
    <sense id="lawvo_2375_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se précipiter, se hâter</text></gloss>
      <gloss lang="en"><text>rush, hurry</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.19.2; Lexique kissi–français, p. 31: lawvo/ law</text></form></note>
  </entry>
  <entry id="layindɔɔ_2376">
    <lexical-unit><form lang="kqs"><text>layindɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>layindɔa</text></form></field>
    <sense id="layindɔɔ_2376_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charpente, menuiserie</text></gloss>
      <gloss lang="en"><text>carpentry, woodwork</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MAT.13.55</text></form></note>
    <note><form lang="fr"><text>langbanɔ cuaa layindɔɔ « charpentier » (Mt 13,55) ; vanaa cuaa layindɔa « charpentiers » (2 S 5,11).</text></form></note>
  </entry>
  <entry id="layɛn_2377">
    <lexical-unit><form lang="kqs"><text>layɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="layɛn_2377_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>parmi, entre, au milieu</text></gloss>
      <gloss lang="en"><text>among, between, in the middle</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: rayɛn</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit rayɛn (r pour l). La Bible dit tɛɛn « entre, parmi ».</text></form></note>
  </entry>
  <entry id="làŋgâŋndó_2378">
    <lexical-unit><form lang="kqs"><text>làŋgâŋndó</text></form></lexical-unit>
