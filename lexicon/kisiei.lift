      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold wind, cold season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.7; Childs 2000, p. 134: hùèìyé</text></form></note>
  </entry>
