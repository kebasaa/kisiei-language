    <lexical-unit><form lang="kqs"><text>yɛngɛsɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛngɛsɛɛ_2021_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entier, complet ; tel quel (palɛi ndii yáá yɛngɛsɛɛ « trois jours entiers »)</text></gloss>
      <gloss lang="en"><text>whole, full, entire; just as it was</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.29.14</text></form></note>
    <note><form lang="fr"><text>paangei yɛngɛsɛɛ « un mois entier » (GEN.29.14) ; má mɛi dɔ́ɔ́ngɔ́ɔ̀ lende yɛngɛsɛɛ « ils laissèrent le camp tel quel » (2KI.7.7).</text></form></note>
  </entry>
