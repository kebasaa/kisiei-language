    <trait name="status" value="southern"/>
    <sense id="dúcɔ́_724_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entièrement, en rassemblant tout</text></gloss>
      <gloss lang="en"><text>completely, all gathered together</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dúcɔ́</text></form></note>
  </entry>
  <entry id="dúfìɛ̀_725">
