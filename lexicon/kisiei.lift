    <sense id="yoloma-yoloma_1963_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) épouvanté, saisi d'effroi (yɔŋnun yoloma-yoloma)</text></gloss>
      <gloss lang="en"><text>(ideophone) terrified, dismayed (yɔŋnun yoloma-yoloma)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
