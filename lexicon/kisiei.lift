    <trait name="status" value="attested"/>
    <sense id="kpilo_1895_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très noir, tout noir (piimiaa kpilo « s'obscurcir complètement »)</text></gloss>
      <gloss lang="en"><text>pitch-black (piimiaa kpilo, grow completely dark)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.18.45; Childs 2000, p. 213: kpíló</text></form></note>
