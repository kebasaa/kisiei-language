  <entry id="bɔnɔɔ_142">
    <lexical-unit><form lang="kqs"><text>bɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔnɔ</text></form></variant>
    <variant><form lang="kqs"><text>bɔnɔla</text></form></variant>
    <sense id="bɔnɔɔ_142_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amende, dédommagement ; tribut ; frais</text></gloss>
      <gloss lang="en"><text>fine, compensation; tribute; cost</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.21.22</text></form></note>
    <note><form lang="fr"><text>luɛi bɔnɔ « payer une amende » (Ex 22,16).</text></form></note>
  </entry>
  <entry id="bɔtáà_143">
    <lexical-unit><form lang="kqs"><text>bɔtáà</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bɔtáà_143_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poing</text></gloss>
      <gloss lang="en"><text>fist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.21.18; Keita 1979, p. 131: Bötaa; Childs 2000, p. 30: bɔ̀táá</text></form></note>
    <note><form lang="fr"><text>À distinguer de bɔ̀tàá « poison, amertume » (Dt 29,17 ; 2R 4,40).</text></form></note>
  </entry>
  <entry id="bɔŋaa_144">
    <lexical-unit><form lang="kqs"><text>bɔŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔŋa</text></form></variant>
    <variant><form lang="kqs"><text>bɔŋan</text></form></variant>
    <sense id="bɔŋaa_144_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rencontrer, aller à la rencontre de</text></gloss>
      <gloss lang="en"><text>meet, go to meet</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring together, join, cover; be sufficient</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first GEN.14.17; Keita 1979, p. 110: Bönhaa; Childs 2000, p. 28: bɔ̀ŋàá</text></form></note>
  </entry>
  <entry id="bɔŋallo_145">
    <lexical-unit><form lang="kqs"><text>bɔŋallo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔŋallo_145_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accueillir pour quelqu'un</text></gloss>
      <gloss lang="en"><text>meet, welcome for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meet for someone, bring together for</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bönhallo; Childs 2000, p. 28: bɔ̀ŋàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de bɔŋaa.</text></form></note>
  </entry>
  <entry id="bɔŋan_146">
    <lexical-unit><form lang="kqs"><text>bɔŋan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔŋa</text></form></variant>
    <sense id="bɔŋan_146_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rencontrer, tomber sur</text></gloss>
      <gloss lang="en"><text>meet, come upon</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 52 occurrences, first GEN.4.15</text></form></note>
