      <gloss lang="fr"><text>tous, entièrement</text></gloss>
      <gloss lang="en"><text>all, completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'a lot, everywhere'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 192 occurrences, first GEN.8.17; Childs 2000, p. 99: fáù</text></form></note>
  </entry>
