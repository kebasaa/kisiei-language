      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: lákàsí</text></form></note>
  </entry>
  <entry id="lakasiaa_3020">
    <lexical-unit><form lang="kqs"><text>lakasiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vana lakasiaa</text></form></variant>
    <sense id="lakasiaa_3020_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>subversion ; (vana lakasiaa) subversif</text></gloss>
      <gloss lang="en"><text>subversion; (vana lakasiaa) subversive (person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 600: Vana lakasiaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi idéologie n° 601 « subversion ».</text></form></note>
  </entry>
