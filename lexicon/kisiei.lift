  <entry id="hoeiye_380">
    <lexical-unit><form lang="kqs"><text>hoeiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hoeyii</text></form></variant>
    <sense id="hoeiye_380_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>froid ; souffle, vent ; paludisme, grippe ; air, vent</text></gloss>
      <gloss lang="en"><text>cold; breath, wind; malaria, flu ; air, wind; cold; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold, cold wind; cold dry season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 107 occurrences, first GEN.7.22; Keita 1979, p. 161: Hoeiye; Childs 2000, p. 134: hùɛ̀ìyé</text></form></note>
    <note><form lang="fr"><text>Keita : « le palu, la grippe ». Dans la Bible : « froid » (Gn 8,22) et « souffle » (Gn 7,22).</text></form></note>
  </entry>
