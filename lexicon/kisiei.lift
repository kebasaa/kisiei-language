      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vessie ; ballon en vessie de chèvre (jeu d'enfants)</text></gloss>
      <gloss lang="en"><text>bladder; ball made from a goat's bladder (children's game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
