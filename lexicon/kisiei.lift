    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="núŋgóó_2460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe à toiture poussant sur les rochers plats</text></gloss>
      <gloss lang="en"><text>thatch grass growing on flat rocks</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
