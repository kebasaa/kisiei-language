    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first EXO.2.6; Childs 2000, p. 277: ɲɛ̀éyé</text></form></note>
    <note><form lang="fr"><text>ɲííye bii X « X a pitié ».</text></form></note>
  </entry>
  <entry id="ɲinaa_1513">
    <lexical-unit><form lang="kqs"><text>ɲinaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲinaa_1513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>esprit, démon</text></gloss>
      <gloss lang="en"><text>spirit, demon</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spirit, esp. spirits of the land or of ancestors</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 120 occurrences, first DEU.18.11; Childs 2000, p. 280: ɲínàá</text></form></note>
    <note><form lang="fr"><text>Invariable : ɲinaa vɔɔnda « les esprits mauvais ».</text></form></note>
  </entry>
