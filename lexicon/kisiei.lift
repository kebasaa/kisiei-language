      <gloss lang="fr"><text>d'un geste vif (saisir, arracher)</text></gloss>
      <gloss lang="en"><text>with a grab (snatching away)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pôŋndí</text></form></note>
  </entry>
  <entry id="pû-pù_2683">
    <lexical-unit><form lang="kqs"><text>pû-pù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pû-pù_2683_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de moteur</text></gloss>
      <gloss lang="en"><text>sound of an engine</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pû-pù</text></form></note>
  </entry>
  <entry id="puapilɛ_2684">
    <lexical-unit><form lang="kqs"><text>puapilɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>puapilɛa</text></form></field>
    <sense id="puapilɛ_2684_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prochain, compagnon ; frère (de la même communauté)</text></gloss>
      <gloss lang="en"><text>neighbour, fellow; brother (fellow member)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.4 Neighbor"/>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 209 occurrences, first GEN.9.5</text></form></note>
  </entry>
  <entry id="púéè-púéè_2685">
    <lexical-unit><form lang="kqs"><text>púéè-púéè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púéè-púéè_2685_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, abondamment</text></gloss>
      <gloss lang="en"><text>a lot, plenty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: púéè-púéè</text></form></note>
