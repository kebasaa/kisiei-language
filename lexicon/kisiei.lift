      <gloss lang="fr"><text>rat des palmiers à queue d'écureuil ; gros porc mâle</text></gloss>
      <gloss lang="en"><text>palm rat with a squirrel-like tail; large male pig</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 168: kíŋgìó kíŋgìá</text></form></note>
