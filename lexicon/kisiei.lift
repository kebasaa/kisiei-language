    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kòlìyòmbùéí</text></form></field>
    <sense id="kòlìyòmbòó_1659_s1">
      <grammatical-info value="Noun"/>
