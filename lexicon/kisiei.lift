  <entry id="kabilaa_1394">
    <lexical-unit><form lang="kqs"><text>kabilaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kabilaa_1394_s1">
