      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever, retirer, séparer</text></gloss>
      <gloss lang="en"><text>remove, take away, separate</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>move or remove, take</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.41.34; Keita 1979, p. 110: Fanhaa; Lexique kissi–français, p. 15: faŋaa/ faŋa; Childs 2000, p. 97: fàŋàá</text></form></note>
    <note><form lang="fr"><text>Moyen faŋan « s'éloigner, partir ». Lexique kissi–français, p. 15 : aussi fanŋan « enlever ».</text></form></note>
  </entry>
  <entry id="faŋanndo_952">
