    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lamnda</text></form></field>
    <sense id="lamndo_1985_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauce ; (pl.) légumes</text></gloss>
      <gloss lang="en"><text>sauce, relish; (pl.) vegetables, greens</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sauce or soup poured over rice; soup greens</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.11.10; Childs 2000, p. 222: làmndó</text></form></note>
    <note><form lang="fr"><text>Kiolu ɲɛdiaa mà vow lamndo « trempe ton pain dans la sauce » (RUT.2.14) ; nakɔ lamndo « potager » (DEU.11.10) ; lamnda lapeelan « des légumes » (ROM.14.2). Keita : Lamndo « sauce ».</text></form></note>
  </entry>
