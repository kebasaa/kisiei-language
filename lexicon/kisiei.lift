<?xml version="1.0" encoding="UTF-8"?>
<lift version="0.13" producer="Kisie tools/build_lexicon.py">
  <entry id="-àlè_1">
    <lexical-unit><form lang="kqs"><text>-àlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-àlè_1_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule emphatique (après un ordre, une salutation)</text></gloss>
      <gloss lang="en"><text>emphatic tag (after commands, greetings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: -àlè</text></form></note>
  </entry>
  <entry id="-náá_2">
    <lexical-unit><form lang="kqs"><text>-náá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-náá_2_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>tout petit, très peu (suffixe, seulement pour des choses petites ou courtes)</text></gloss>
      <gloss lang="en"><text>very (small) (suffix, only with small or short things)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.9 Affixes"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 257: -náá</text></form></note>
  </entry>
  <entry id="a_3">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_3_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>tu ; ils, elles (sujet)</text></gloss>
      <gloss lang="en"><text>you (sg.); they (subject)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1; Lexique kissi–français, p. 3: a</text></form></note>
  </entry>
  <entry id="a_4">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_4_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>avec ; et</text></gloss>
      <gloss lang="en"><text>with; and</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1; Lexique kissi–français, p. 3: a</text></form></note>
  </entry>
  <entry id="a yandi_5">
    <lexical-unit><form lang="kqs"><text>a yandi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a yandi_5_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>s'il te plaît, je t'en prie</text></gloss>
      <gloss lang="en"><text>please</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yándíí</text></form></note>
  </entry>
  <entry id="aa_6">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="aa_6_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>introduit les paroles rapportées</text></gloss>
      <gloss lang="en"><text>quotative particle</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'like, as' (comparison)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8249 occurrences, first GEN.1.3; Childs 2000, p. 2: àà</text></form></note>
  </entry>
  <entry id="aa_7">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="aa_7_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>il, elle, ils, elles (avant le verbe, au plus-que-parfait)</text></gloss>
      <gloss lang="en"><text>he, she, they (before the verb, pluperfect)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: aa</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « il, elle, ils, elles avaient (avant les verbes dans le plus-que-parfait) ». Forme et tons à vérifier dans la Bible (cf. ndóò, ndáà « passé révolu ») ; homographe de aa (paroles rapportées).</text></form></note>
  </entry>
  <entry id="akasia_8">
    <lexical-unit><form lang="kqs"><text>akasia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="akasia_8_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acacia (pɛngɛn akasia « bois d'acacia »)</text></gloss>
      <gloss lang="en"><text>acacia (pɛngɛn akasia 'acacia wood')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.25.5</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="amanndiee_9">
    <lexical-unit><form lang="kqs"><text>amanndiee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="amanndiee_9_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amande, amandier (yɔm amanndiee)</text></gloss>
      <gloss lang="en"><text>almond, almond tree (yɔm amanndiee)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.30.37</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="ansan_10">
    <lexical-unit><form lang="kqs"><text>ansan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ansan_10_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>encens</text></gloss>
      <gloss lang="en"><text>incense</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 94 occurrences, first EXO.25.6</text></form></note>
  </entry>
  <entry id="ava_11">
    <lexical-unit><form lang="kqs"><text>ava</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ava_11_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>d'accord, eh bien</text></gloss>
      <gloss lang="en"><text>all right, well then</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.30.15; Lexique kissi–français, p. 3: ava</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, Ava ouvre une réplique (GEN.30.15, JDG.14.13 « Ava, dis ton énigme »).</text></form></note>
  </entry>
  <entry id="ba_12">
    <lexical-unit><form lang="kqs"><text>ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba_12_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté ; (o … ba) chez, auprès de, aux mains de ; (a ba …) du côté de</text></gloss>
      <gloss lang="en"><text>side; (o … ba) with, at, in the hands of; (a ba …) towards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3579 occurrences, first GEN.2.8; Lexique kissi–français, p. 3: ba</text></form></note>
    <note><form lang="fr"><text>a ba paalen le can-ndo « à l'est » ; o ba bɛngu « sous l'autorité de ». Lexique kissi–français, p. 3 : ba, a ba « vers, de ». Aussi Lexique kissi–français, p. 40 : « o ba ». Lexique kissi–français, p. 40 : o ba « en possession de ».</text></form></note>
  </entry>
  <entry id="bâ_13">
    <lexical-unit><form lang="kqs"><text>bâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bâ_13_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une goutte qui tombe sur une surface lisse</text></gloss>
      <gloss lang="en"><text>sound of a drop falling on a smooth surface</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: bâ</text></form></note>
  </entry>
  <entry id="ba kɛndɔɔ_14">
    <lexical-unit><form lang="kqs"><text>ba kɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba kɛndɔɔ_14_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main droite, droite ; (o ba kɛndɔɔ coo) à droite</text></gloss>
      <gloss lang="en"><text>right hand, right side; (o ba kɛndɔɔ coo) on the right</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa kɛndɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit baa kɛndɔɔ et baa kɛndɛ (p. 3) ; la Bible écrit ba kɛndɔɔ (o ba kɛndɔɔ coo « à droite », GEN.13.9).</text></form></note>
  </entry>
  <entry id="ba loo_15">
    <lexical-unit><form lang="kqs"><text>ba loo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ba loo_15_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignet</text></gloss>
      <gloss lang="en"><text>wrist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: ba loo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, (o) ba loo signifie plutôt « dans la main » (2SA.23.6, MAT.13.12). Le sens « poignet » est à confirmer ; cf. bakpeŋndo « poignet ».</text></form></note>
  </entry>
  <entry id="ba mɛllo_16">
    <lexical-unit><form lang="kqs"><text>ba mɛllo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba mɛllo_16_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main gauche, gauche ; (o ba mɛllo coo) à gauche</text></gloss>
      <gloss lang="en"><text>left hand, left side; (o ba mɛllo coo) on the left</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: bamɛllo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit bamɛllo en un mot ; la Bible écrit ba mɛllo (GEN.13.9).</text></form></note>
  </entry>
  <entry id="ba pilɛ_17">
    <lexical-unit><form lang="kqs"><text>ba pilɛ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ba pilɛ_17_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>proche, à côté</text></gloss>
      <gloss lang="en"><text>near, beside</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: ba pilɛ</text></form></note>
    <note><form lang="fr"><text>La Bible a o ba pilɛ « d'une main, d'un côté » (JDG.5.26, JOB.42.15). Le sens « proche » du Lexique est à confirmer.</text></form></note>
  </entry>
  <entry id="bà-ó-bà_18">
    <lexical-unit><form lang="kqs"><text>bà-ó-bà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bà-ó-bà_18_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, où que ce soit</text></gloss>
      <gloss lang="en"><text>everywhere, wherever</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 8: bà-ó-bà</text></form></note>
  </entry>
  <entry id="bàà_19">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bàà_19_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>est-ce que (en tête de question) ; ou bien</text></gloss>
      <gloss lang="en"><text>question marker (sentence-initial); or</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>or, whether</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Childs 2000, p. 2: bàà</text></form></note>
    <note><form lang="fr"><text>Bàà nuaa Hala dimul niaa ni ... ? « Dieu a-t-il vraiment dit ... ? » (GEN.3.1) ; Bàà mì vin Abraham ... ? « Cacherai-je à Abraham ... ? » (GEN.18.17). Ne pas confondre avec baa « main ».</text></form></note>
  </entry>
  <entry id="báà_20">
    <lexical-unit><form lang="kqs"><text>báà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="báà_20_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix, valeur</text></gloss>
      <gloss lang="en"><text>price, value</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 17: Baa (T H D); Lexique kissi–français, p. 3: baa; Childs 2000, p. 3: báá</text></form></note>
    <note><form lang="fr"><text>Keita oppose Baa (ton haut) « le prix » à Baa (ton bas) « la main » ; Fallo vèè kolaa hoo nö yè baa « Monsieur, quel est le prix de ce pagne ? » (p. 59). La Bible écrit báà : mɛɛ cɔlu kon nɔ báà yɛ « selon le prix de l'animal » (Ex 21,34) ; powta báà kàlàla « pierres de grand prix, pierres précieuses » (Ex 25,7) ; ɲɛm báà kalan « objets de valeur » (2 R 20,13).</text></form></note>
  </entry>
  <entry id="baa_21">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>balan</text></form></field>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <sense id="baa_21_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main, bras</text></gloss>
      <gloss lang="en"><text>hand, arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hand, arm; also way, fork in a road</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 131: Baa; Lexique kissi–français, p. 3: baa; Childs 2000, p. 2: bàá</text></form></note>
  </entry>
  <entry id="baa_22">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <variant><form lang="kqs"><text>bee</text></form></variant>
    <sense id="baa_22_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, accrocher</text></gloss>
      <gloss lang="en"><text>tie, hang</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baa; Lexique kissi–français, p. 3: baa/ ba, bee</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : ba, bee. baa est très courant dans la Bible mais avec d'autres sens ; le moyen baanun « attacher » y est attesté (EXO 28,28). Lexique kissi–français, p. 3-4 : baa/ ba, bee « attacher un animal » ; confirmé au Nord.</text></form></note>
  </entry>
  <entry id="baa_23">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baa_23_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>plus (comparatif, avec le)</text></gloss>
      <gloss lang="en"><text>more (comparative, with le)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « plus (accompagné par le mot le) ». Emploi non retrouvé dans la Bible (le bàà y introduit une question) ; à confirmer.</text></form></note>
  </entry>
  <entry id="bàà_24">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bàà_24_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi (jour de marché à Bàà)</text></gloss>
      <gloss lang="en"><text>Monday (market day at Bàà)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bàà</text></form></note>
  </entry>
  <entry id="baa lepilɛ_25">
    <lexical-unit><form lang="kqs"><text>baa lepilɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baa lepilɛ_25_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignée</text></gloss>
      <gloss lang="en"><text>handful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa lepilɛ</text></form></note>
    <note><form lang="fr"><text>Littéralement « une main ». Non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="báà piandaa_26">
    <lexical-unit><form lang="kqs"><text>báà piandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="báà piandaa_26_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix d'achat</text></gloss>
      <gloss lang="en"><text>purchase price</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa piandaa</text></form></note>
    <note><form lang="fr"><text>Composé de báà « prix » ; non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="baa pilɔɔ_27">
    <lexical-unit><form lang="kqs"><text>baa pilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="baa pilɔɔ_27_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>un côté, l'autre côté ; poignée</text></gloss>
      <gloss lang="en"><text>one side, the other side; handful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa pilɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique, p. 3 : « poignée ; la partie de ; l'autre côté ». La Bible a baa pilɔɔ « (d')un côté, en un même lieu » (GEN.1.9, EXO.26.35) ; le sens « poignée » n'y est pas vérifié.</text></form></note>
  </entry>
  <entry id="báà pisia_28">
    <lexical-unit><form lang="kqs"><text>báà pisia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="báà pisia_28_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix de vente</text></gloss>
      <gloss lang="en"><text>selling price</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa pisia</text></form></note>
    <note><form lang="fr"><text>Composé de báà « prix » ; non attesté tel quel dans la Bible.</text></form></note>
  </entry>
  <entry id="baa yulullo_29">
    <lexical-unit><form lang="kqs"><text>baa yulullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baa yulullo_29_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre le bras, montrer (du bras, du doigt), indiquer</text></gloss>
      <gloss lang="en"><text>stretch out the arm, point (with the arm or finger)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baa yulullo</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi baa yurullo (p. 3). Cf. yulu « tendre (la main) » et yulul (PSA.7.13) dans la Bible.</text></form></note>
  </entry>
  <entry id="baala folobaa_30">
    <lexical-unit><form lang="kqs"><text>baala folobaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baala folobaa_30_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>investissement humain (travail collectif)</text></gloss>
      <gloss lang="en"><text>communal labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Baala folobaa; Lexique kissi–français, p. 3: baala folobaa</text></form></note>
    <note><form lang="fr"><text>baala « travail » est attesté ; folobaa n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="baalaa_31">
    <lexical-unit><form lang="kqs"><text>baalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>baalalan</text></form></field>
    <variant><form lang="kqs"><text>baala</text></form></variant>
    <variant><form lang="kqs"><text>baalala</text></form></variant>
    <sense id="baalaa_31_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage ; service</text></gloss>
      <gloss lang="en"><text>work; service</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 809 occurrences, first GEN.2.5; Lexique kissi–français, p. 3: baalaa</text></form></note>
  </entry>
  <entry id="baalandoo_32">
    <lexical-unit><form lang="kqs"><text>baalandoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>baalan</text></form></variant>
    <sense id="baalandoo_32_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer</text></gloss>
      <gloss lang="en"><text>attack</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baarandoo/ baaran</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. baalan existe dans la Bible avec un autre sens (EXO.29.29).</text></form></note>
  </entry>
  <entry id="baalanndo_33">
    <lexical-unit><form lang="kqs"><text>baalanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="baalanndo_33_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balafon, xylophone (des Peuls et des Malinkés)</text></gloss>
      <gloss lang="en"><text>balafon, xylophone (of the Fula and Malinke)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: baalanndo</text></form></note>
    <note><form lang="fr"><text>Homographe : la Bible a baalanndo dans un autre sens (EXO.25.31, travail du métal).</text></form></note>
  </entry>
  <entry id="bààlòó_34">
    <lexical-unit><form lang="kqs"><text>bààlòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààlòlàŋ</text></form></field>
    <sense id="bààlòó_34_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabouret, siège à trois pieds</text></gloss>
      <gloss lang="en"><text>stool, three-legged seat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààlòó</text></form></note>
  </entry>
  <entry id="bààmbàá_35">
    <lexical-unit><form lang="kqs"><text>bààmbàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bààmbàá_35_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, envelopper ; accrocher ; démarrer (en courant)</text></gloss>
      <gloss lang="en"><text>tie up, wrap; hook up; start off (esp. running)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààmbàá</text></form></note>
  </entry>
  <entry id="bààníŋndó_36">
    <lexical-unit><form lang="kqs"><text>bààníŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bààníŋndó_36_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de culte des ancêtres (coin de la maison où l'on dépose offrandes et libations)</text></gloss>
      <gloss lang="en"><text>place of ancestor worship (corner where offerings are placed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààníŋndó</text></form></note>
  </entry>
  <entry id="baanɔnndo_37">
    <lexical-unit><form lang="kqs"><text>baanɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>baanun</text></form></variant>
    <variant><form lang="kqs"><text>beenun</text></form></variant>
    <sense id="baanɔnndo_37_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'accrocher, s'attacher</text></gloss>
      <gloss lang="en"><text>hang on, be attached</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hang, be suspended</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baanönndo; Lexique kissi–français, p. 3: baanɔnndo/ baanun, beenun; Childs 2000, p. 4: bàànɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de baa. Forme attestée dans la Bible : baanun « attacher » (EXO 28,28 ; JDG 3,16).</text></form></note>
  </entry>
  <entry id="báásìà_38">
    <lexical-unit><form lang="kqs"><text>báásìà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="báásìà_38_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essayer, faire effort</text></gloss>
      <gloss lang="en"><text>try, strive, make an effort</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásìà</text></form></note>
  </entry>
  <entry id="báásíó_39">
    <lexical-unit><form lang="kqs"><text>báásíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>báásíláŋ</text></form></field>
    <sense id="báásíó_39_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit flacon (tabac à priser, médicament)</text></gloss>
      <gloss lang="en"><text>small container (snuff, medicine)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásíó</text></form></note>
  </entry>
  <entry id="baavaa_40">
    <lexical-unit><form lang="kqs"><text>baavaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baava</text></form></variant>
    <sense id="baavaa_40_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau ; bath (mesure de liquides)</text></gloss>
      <gloss lang="en"><text>bucket, pail; bath (liquid measure)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EZK.45.11; Childs 2000, p. 4: báávàá</text></form></note>
    <note><form lang="fr"><text>mɛmma ... o baava « une goutte d'un seau » (ISA.40.15) ; mesure de liquides en EZK.45.11.</text></form></note>
  </entry>
  <entry id="bààyàléŋ_41">
    <lexical-unit><form lang="kqs"><text>bààyàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààyààŋ</text></form></field>
    <sense id="bààyàléŋ_41_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rang de perles porté au bras ou à la taille</text></gloss>
      <gloss lang="en"><text>string of beads worn on the arm or waist</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bààyàléŋ</text></form></note>
  </entry>
  <entry id="bááŋtɔ́kpùá_42">
    <lexical-unit><form lang="kqs"><text>bááŋtɔ́kpùá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bááŋtɔ́kpùá_42_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'aubergine amère (mangée par les babouins)</text></gloss>
      <gloss lang="en"><text>species of bitter eggplant (eaten by baboons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bááŋtɔ́kpùá</text></form></note>
  </entry>
  <entry id="bácù_43">
    <lexical-unit><form lang="kqs"><text>bácù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bácù_43_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>démarrage brusque (en projetant du gravier) ; crachat bruyant</text></gloss>
      <gloss lang="en"><text>rapid acceleration (throwing back gravel); noisy spitting</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bácù</text></form></note>
  </entry>
  <entry id="bádò_44">
    <lexical-unit><form lang="kqs"><text>bádò</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bádò_44_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souligne l'adhérence (rester collé)</text></gloss>
      <gloss lang="en"><text>stuck fast</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bádò</text></form></note>
  </entry>
  <entry id="bàfèíyó_45">
    <lexical-unit><form lang="kqs"><text>bàfèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bàfèíyó_45_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri provisoire (au marché)</text></gloss>
      <gloss lang="en"><text>temporary shelter (at markets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bàfèíyó</text></form></note>
  </entry>
  <entry id="bahaviɔɔ_46">
    <lexical-unit><form lang="kqs"><text>bahaviɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bahaviɔɔ_46_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accabler</text></gloss>
      <gloss lang="en"><text>overwhelm, weigh down</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: bahaviɔɔ</text></form></note>
  </entry>
  <entry id="bahavɛiyo_47">
    <lexical-unit><form lang="kqs"><text>bahavɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bahavɛi</text></form></variant>
    <sense id="bahavɛiyo_47_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaire, besoin, demande ; occupation</text></gloss>
      <gloss lang="en"><text>matter, need, request; business</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being busy or preoccupied; being in need or in trouble (lit. 'hand-stuck')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.47.12; Childs 2000, p. 5: bà-hàwɛ́íyó</text></form></note>
    <note><form lang="fr"><text>yungu bahavɛiyo « le clan le plus pauvre » (Jg 6,15) ; o bahavɛiyo pum nin « occupé à quelque affaire » (1 R 18,27).</text></form></note>
  </entry>
  <entry id="bákáá_48">
    <lexical-unit><form lang="kqs"><text>bákáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bákáláŋ</text></form></field>
    <sense id="bákáá_48_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouillie de riz pour enfants</text></gloss>
      <gloss lang="en"><text>rice mush for children</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bákáá</text></form></note>
    <note><form lang="fr"><text>Keita (p. 80) a « a de bakaa » (manger du bakaa), sans glose.</text></form></note>
  </entry>
  <entry id="bákéé_49">
    <lexical-unit><form lang="kqs"><text>bákéé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bákéé_49_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bâillement (souligne le bâillement)</text></gloss>
      <gloss lang="en"><text>yawning widely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bákéé</text></form></note>
  </entry>
  <entry id="bako_50">
    <lexical-unit><form lang="kqs"><text>bako</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bako_50_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(bako bɛɛ + négation) pas un mot, pas du tout</text></gloss>
      <gloss lang="en"><text>(bako bɛɛ + negative) not a word, not at all</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note><form lang="fr"><text>Kɛ bako bɛɛ o suu le « il n'ouvrit pas la bouche » (Es 53,7).</text></form></note>
  </entry>
  <entry id="bakpeŋndo_51">
    <lexical-unit><form lang="kqs"><text>bakpeŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakpeŋndo_51_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignet</text></gloss>
      <gloss lang="en"><text>wrist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Bakpenndo; Lexique kissi–français, p. 3: bakpenndo; Childs 2000, p. 211: kpéŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Bakpenndo ; ŋ d'après Childs (kpéŋndó, var. bàlà kpéŋndáŋ).</text></form></note>
  </entry>
  <entry id="bakɔllo_52">
    <lexical-unit><form lang="kqs"><text>bakɔllo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakɔllo_52_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paume de la main</text></gloss>
      <gloss lang="en"><text>palm of the hand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Baköllo; Lexique kissi–français, p. 3: bakɔllo; Childs 2000, p. 5: bàkɔ̀lló</text></form></note>
  </entry>
  <entry id="bakɔɔ_53">
    <lexical-unit><form lang="kqs"><text>bakɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakɔɔ_53_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dessus de la main, dos de la main</text></gloss>
      <gloss lang="en"><text>back of the hand</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: bakɔɔ</text></form></note>
  </entry>
  <entry id="balaa_54">
    <lexical-unit><form lang="kqs"><text>balaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balaa_54_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pourtour ; (o balaa sɔ́) autour</text></gloss>
      <gloss lang="en"><text>surroundings; (o balaa sɔ́) round about</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOS.21.42</text></form></note>
  </entry>
  <entry id="balahavɛilan_55">
    <lexical-unit><form lang="kqs"><text>balahavɛilan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>balahavɛila</text></form></variant>
    <variant><form lang="kqs"><text>balahavɛiya</text></form></variant>
    <sense id="balahavɛilan_55_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaires, besoins, demandes ; (balahavɛiya) les nécessiteux</text></gloss>
      <gloss lang="en"><text>affairs, needs, requests; (balahavɛiya) the needy</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note><form lang="fr"><text>Lié à bahavɛiyo. vanaa balahavɛiya « les pauvres » (Dt 15,11).</text></form></note>
  </entry>
  <entry id="balan_56">
    <lexical-unit><form lang="kqs"><text>balan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bala</text></form></variant>
    <sense id="balan_56_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main(s)</text></gloss>
      <gloss lang="en"><text>hand(s)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 220 occurrences, first GEN.17.9</text></form></note>
    <note><form lang="fr"><text>vana bala fondoo « pauvre » (litt. « main vide »).</text></form></note>
  </entry>
  <entry id="balanilen_57">
    <lexical-unit><form lang="kqs"><text>balanilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="balanilen_57_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>longue épingle à cheveux (en aluminium)</text></gloss>
      <gloss lang="en"><text>long (aluminium) hairpin</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: balanilen</text></form></note>
  </entry>
  <entry id="balanndo_58">
    <lexical-unit><form lang="kqs"><text>balanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>balan</text></form></variant>
    <sense id="balanndo_58_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accuser</text></gloss>
      <gloss lang="en"><text>accuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: balanndo/ balan</text></form></note>
    <note><form lang="fr"><text>Homographe de balan « mains » (pluriel de baa).</text></form></note>
  </entry>
  <entry id="balen_59">
    <lexical-unit><form lang="kqs"><text>balen</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="respelled"/>
    <sense id="balen_59_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gerbe (de riz)</text></gloss>
      <gloss lang="en"><text>sheaf (of rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: balen; Childs 2000, p. 5: báléŋ</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 3 (« la gerbe »). Pluriel en kissi du Sud (Childs 2000) : báláŋ.</text></form></note>
  </entry>
  <entry id="balika_60">
    <lexical-unit><form lang="kqs"><text>balika</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balika_60_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>merci ; avec l'aide de, grâce à</text></gloss>
      <gloss lang="en"><text>thank you; with the help of, thanks to</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 125 occurrences, first GEN.24.48; Lexique kissi–français, p. 3: balika; Childs 2000, p. 5: báléká</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 3 : aussi « avec l'aide de ; sous la puissance de » ; variante barika (p. 4).</text></form></note>
  </entry>
  <entry id="balikaa_61">
    <lexical-unit><form lang="kqs"><text>balikaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balikaa_61_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remerciement, action de grâces</text></gloss>
      <gloss lang="en"><text>thanks, thanksgiving</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first LEV.7.12</text></form></note>
    <note><form lang="fr"><text>Voir l'interjection balika « merci ».</text></form></note>
  </entry>
  <entry id="balio_62">
    <lexical-unit><form lang="kqs"><text>balio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bali</text></form></variant>
    <sense id="balio_62_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>causer, parler ; causerie ; (balio tosa) faire la causerie</text></gloss>
      <gloss lang="en"><text>chat, talk; conversation; (balio tosa) have a chat</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.55.15; Lexique kissi–français, p. 3: balio/ bali</text></form></note>
    <note><form lang="fr"><text>PSA.55.15 : paandu balio-o « la douce causerie » ; bali dans dow … bali « dire à, informer » (GEN.21.26, 1SA.22.8). Cf. baltan « conversation ».</text></form></note>
  </entry>
  <entry id="bàlléŋ_63">
    <lexical-unit><form lang="kqs"><text>bàlléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàllàŋ</text></form></field>
    <sense id="bàlléŋ_63_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit fruit rouge semblable à une prune</text></gloss>
      <gloss lang="en"><text>small red plum-like fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bàlléŋ</text></form></note>
  </entry>
  <entry id="bállo_64">
    <lexical-unit><form lang="kqs"><text>bállo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>báltan</text></form></field>
    <sense id="bállo_64_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lance</text></gloss>
      <gloss lang="en"><text>spear</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.25.7; Keita 1979, p. 156: Ballo; Lexique kissi–français, p. 3: ballo; Childs 2000, p. 6: bàlló</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi balle « une lance » (p. 3).</text></form></note>
  </entry>
  <entry id="bàlló_65">
    <lexical-unit><form lang="kqs"><text>bàlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàllé</text></form></field>
    <sense id="bàlló_65_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre qui donne le fruit bàlléŋ</text></gloss>
      <gloss lang="en"><text>tree bearing the bàlléŋ fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bàlló</text></form></note>
  </entry>
  <entry id="bàlló_66">
    <lexical-unit><form lang="kqs"><text>bàlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàltáŋ</text></form></field>
    <sense id="bàlló_66_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chute d'eau, cascade</text></gloss>
      <gloss lang="en"><text>waterfall</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bàlló</text></form></note>
  </entry>
  <entry id="baloo_67">
    <lexical-unit><form lang="kqs"><text>baloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balo</text></form></variant>
    <sense id="baloo_67_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture ; (dɔwnun balo) se nourrir</text></gloss>
      <gloss lang="en"><text>food; (dɔwnun balo) feed on</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 102 occurrences, first GEN.1.29</text></form></note>
  </entry>
  <entry id="baltan_68">
    <lexical-unit><form lang="kqs"><text>baltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bali</text></form></variant>
    <sense id="baltan_68_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>conversation, propos ; (dɔw baltan) causer, s'entretenir</text></gloss>
      <gloss lang="en"><text>talk, conversation; (dɔw baltan) talk, converse</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first DEU.6.7; Childs 2000, p. 5: bàlíó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; dɔw baltan « s'entretenir » (DAN.1.19, ACT.10.27). Forme bali dans dow ... bali « informer » (GEN.21.26, 1SA.22.8). À distinguer de báltan « lances ».</text></form></note>
  </entry>
  <entry id="balu_69">
    <lexical-unit><form lang="kqs"><text>balu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balunin</text></form></variant>
    <sense id="balu_69_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire le tour, entourer ; parcourir</text></gloss>
      <gloss lang="en"><text>go around, surround; roam through</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 345 occurrences, first GEN.2.11; Childs 2000, p. 5: bàlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="balufaa_70">
    <lexical-unit><form lang="kqs"><text>balufaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="balufaa_70_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concubine ; fiancée ; ami(e) intime (hors mariage)</text></gloss>
      <gloss lang="en"><text>concubine; betrothed; lover (outside marriage)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first JDG.19.1; Lexique kissi–français, p. 3: balufaa</text></form></note>
    <note><form lang="fr"><text>Distinct de sámáá. balufaa ndɔ « sa fiancée » (1 Co 7,36). Lexique kissi–français, p. 3 : « fiancé(e) ; ami(e), personne avec qui l'on a des rapports sexuels sans être marié » ; variante barafaa (p. 4).</text></form></note>
  </entry>
  <entry id="balufayɛi_71">
    <lexical-unit><form lang="kqs"><text>balufayɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="balufayɛi_71_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>relation amoureuse hors mariage ; fiançailles ; amitié profonde</text></gloss>
      <gloss lang="en"><text>love affair outside marriage; engagement; close friendship</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 3: balufayɛi</text></form></note>
    <note><form lang="fr"><text>Dérivé de balufaa. Le Lexique donne aussi barafayɛi (p. 4).</text></form></note>
  </entry>
  <entry id="baluo_72">
    <lexical-unit><form lang="kqs"><text>baluo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="baluo_72_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourreau</text></gloss>
      <gloss lang="en"><text>sheath, scabbard</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: baruo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="balɔɔ_73">
    <lexical-unit><form lang="kqs"><text>balɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="balɔɔ_73_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avant-bras (Keita) ; autour, à travers (Bible)</text></gloss>
      <gloss lang="en"><text>forearm (Keita); around, throughout (Bible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wrist</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 147 occurrences, first GEN.3.8; Keita 1979, p. 131: Balöö; Lexique kissi–français, p. 3: balɔɔ; Childs 2000, p. 6: bàlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, balɔɔ ne s'emploie que comme locatif « autour, partout dans » (Gn 41,46 ; Ex 19,12 ; Lv 13,13). Childs donne « poignet » ; la partie exacte du bras est à confirmer. Le Lexique kissi–français, p. 3, donne les deux sens, « autour, entourer » et « avant-bras » (variante barɔɔ, p. 4).</text></form></note>
  </entry>
  <entry id="bàmbàkɔ̀ɔ́_74">
    <lexical-unit><form lang="kqs"><text>bàmbàkɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàmbàkɔ̀ɔ̀láŋ</text></form></field>
    <sense id="bàmbàkɔ̀ɔ́_74_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>récipient servant de mesure (env. 2,5 sìààmbùíyó)</text></gloss>
      <gloss lang="en"><text>measuring pan (about 2.5 sìààmbùíyó)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bàmbàkɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bamban_75">
    <lexical-unit><form lang="kqs"><text>bamban</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bambɛi</text></form></variant>
    <sense id="bamban_75_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clochettes, grelots</text></gloss>
      <gloss lang="en"><text>small bells</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bell (singular bàmbèì, plural bàmbăŋ)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.28.33; Lexique kissi–français, p. 4: banbɛi; Childs 2000, p. 6: bàmbèì</text></form></note>
    <note><form lang="fr"><text>Pluriel. bamban pɔmbɔn « clochettes » (Ex 28,33). Le Lexique kissi–français, p. 4, donne le singulier banbɛi « la cloche » (Bible : bambɛi, EXO.28.34).</text></form></note>
  </entry>
  <entry id="bàmbúíyó_76">
    <lexical-unit><form lang="kqs"><text>bàmbúíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàmbúíláŋ</text></form></field>
    <sense id="bàmbúíyó_76_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parapluie, ombrelle en feuilles de bambou</text></gloss>
      <gloss lang="en"><text>umbrella or sunshade of bamboo leaves</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bàmbúíyó</text></form></note>
  </entry>
  <entry id="bana-banaa_77">
    <lexical-unit><form lang="kqs"><text>bana-banaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bana-banaa_77_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gros, grands (bétail, animaux, navires)</text></gloss>
      <gloss lang="en"><text>big, large (livestock, animals, ships)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 2CH.31.6</text></form></note>
    <note><form lang="fr"><text>visia bana-banaa a á pɔmbɔa « animaux grands et petits » (Ps 104,25).</text></form></note>
  </entry>
  <entry id="banaa siaŋaa_78">
    <lexical-unit><form lang="kqs"><text>banaa siaŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="banaa siaŋaa_78_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz jaune (rougeâtre)</text></gloss>
      <gloss lang="en"><text>yellow (reddish) rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: banaa sanaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit sanaa ; la Bible écrit siaŋaa « rouge » (GEN.25.30). banaa n'est pas identifié.</text></form></note>
  </entry>
  <entry id="bánásìíyó_79">
    <lexical-unit><form lang="kqs"><text>bánásìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bándásìíláŋ</text></form></field>
    <sense id="bánásìíyó_79_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>intérêt (sur un prêt)</text></gloss>
      <gloss lang="en"><text>interest (on money)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bánásìíyó</text></form></note>
  </entry>
  <entry id="bandaa_80">
    <lexical-unit><form lang="kqs"><text>bandaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bandaa_80_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fromager ; baobab</text></gloss>
      <gloss lang="en"><text>kapok tree, silk-cotton tree; baobab</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bandaa; Lexique kissi–français, p. 4: bandaa</text></form></note>
    <note><form lang="fr"><text>Ceiba pentandra. Lexique kissi–français, p. 4 : « le fromager ; le baobab ».</text></form></note>
  </entry>
  <entry id="bandalaa_81">
    <lexical-unit><form lang="kqs"><text>bandalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bandalaa_81_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>saillie</text></gloss>
      <gloss lang="en"><text>projection, ledge</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: bandalaa</text></form></note>
  </entry>
  <entry id="bàndàléŋ_82">
    <lexical-unit><form lang="kqs"><text>bàndàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàndàá</text></form></field>
    <sense id="bàndàléŋ_82_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de petit arbre (cotonnier) aux feuilles comestibles</text></gloss>
      <gloss lang="en"><text>species of small cottonwood with edible leaves</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bàndàléŋ</text></form></note>
    <note><form lang="fr"><text>Comparer bandaa « fromager » (Keita p. 139, Bible).</text></form></note>
  </entry>
  <entry id="bandei_83">
    <lexical-unit><form lang="kqs"><text>bandei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bandii</text></form></variant>
    <sense id="bandei_83_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coudée ; mesure, limite ; longueur, hauteur, taille</text></gloss>
      <gloss lang="en"><text>cubit; measure, limit; length, height, size</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) be tall; height, length</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.6.3; Lexique kissi–français, p. 4: bandei; Childs 2000, p. 7: bàndèí</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 4 : « la longueur ; la hauteur ; (la taille ?) ».</text></form></note>
  </entry>
  <entry id="bándìíyó_84">
    <lexical-unit><form lang="kqs"><text>bándìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bándìíláŋ</text></form></field>
    <sense id="bándìíyó_84_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>frontière, limite</text></gloss>
      <gloss lang="en"><text>boundary, border</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 7: bándìíyó</text></form></note>
  </entry>
  <entry id="bandíláà_85">
    <lexical-unit><form lang="kqs"><text>bandíláà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bandílá</text></form></variant>
    <sense id="bandíláà_85_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rocher, roc (pow bandíláà)</text></gloss>
      <gloss lang="en"><text>rock, crag (pow bandíláà)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>big flat rock, often used for drying things</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first JDG.6.20; Childs 2000, p. 7: bándíláá</text></form></note>
  </entry>
  <entry id="bàndóó_86">
    <lexical-unit><form lang="kqs"><text>bàndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bandólan</text></form></field>
    <variant><form lang="kqs"><text>bandóla</text></form></variant>
    <sense id="bàndóó_86_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>estrade, plate-forme ; tour de guet ; table (pour les sacrifices)</text></gloss>
      <gloss lang="en"><text>platform, raised stand; watchtower; table (for sacrifices)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>platform from which birds are driven off the crops</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 2CH.6.13; Lexique kissi–français, p. 4: bandoo; Childs 2000, p. 7: bàndóó</text></form></note>
    <note><form lang="fr"><text>bandólan « tables » du temple (Ez 40,39-42) ; « hauts lieux » (Ez 16,24). Lexique kissi–français, p. 4 : « mirador ; (l'endroit plat pour le riz dans le champ ?) ».</text></form></note>
  </entry>
  <entry id="bandu_87">
    <lexical-unit><form lang="kqs"><text>bandu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bendu</text></form></variant>
    <variant><form lang="kqs"><text>bandunin</text></form></variant>
    <sense id="bandu_87_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être long, haut ; être loin, durer</text></gloss>
      <gloss lang="en"><text>be long, tall; be far, last long</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.13.17; Lexique kissi–français, p. 4: bandu; Childs 2000, p. 7: bàndèì</text></form></note>
    <note><form lang="fr"><text>Négatif bendu : piɔ́m fuɲa naa bendu lɛ le « la mort de mon père n'est pas loin » (Gn 27,41). Cf. bandei « coudée, mesure ».</text></form></note>
  </entry>
  <entry id="bandɛo_88">
