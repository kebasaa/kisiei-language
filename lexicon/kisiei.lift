      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>téter, sucer ; baiser (les pieds) ; (nom) nourrisson</text></gloss>
      <gloss lang="en"><text>suck (at the breast); kiss; (noun) suckling</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nurse (a baby), suck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first DEU.32.25; Childs 2000, p. 384: wɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>mó va mun vɔɛiyo « elle les baisait » (LUK.7.38) ; vɔɛi « téter » (ISA.66.11).</text></form></note>
  </entry>
