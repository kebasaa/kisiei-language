    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doola</text></form></variant>
    <variant><form lang="kqs"><text>doolala</text></form></variant>
    <sense id="doolaa_713_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pressoir (à vin)</text></gloss>
      <gloss lang="en"><text>winepress</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JDG.6.11</text></form></note>
