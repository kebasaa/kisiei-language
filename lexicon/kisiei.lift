      <gloss lang="en"><text>path, road</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 231 occurrences, first GEN.22.3; Keita 1979, p. 142: Nèiyo; Childs 2000, p. 261: nɛ̀ìyó</text></form></note>
