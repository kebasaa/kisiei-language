      <gloss lang="fr"><text>vingt</text></gloss>
      <gloss lang="en"><text>twenty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 327 occurrences, first GEN.6.3; Childs 2000, p. 16: bídìíŋ</text></form></note>
