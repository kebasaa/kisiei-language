  </entry>
  <entry id="lánìbɔ̀kùèìyó_1995">
    <lexical-unit><form lang="kqs"><text>lánìbɔ̀kùèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lánìbɔ̀kùèìyó_1995_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand masque (« diable ») dansant sur échasses</text></gloss>
      <gloss lang="en"><text>tall dancing mask ('devil') on stilts</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 223: lánìbɔ̀kùèìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au bandi.</text></form></note>
  </entry>
