    <note><form lang="fr"><text>ŋ d'après Childs (emprunt au maninka). La Bible dit soon kólaa pour « puits, source » (Gn 16,7).</text></form></note>
  </entry>
  <entry id="kɔlɔɔ_903">
    <lexical-unit><form lang="kqs"><text>kɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔlɔ</text></form></variant>
    <sense id="kɔlɔɔ_903_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaire, cause, raison ; (le kɔlɔ yɛɛ) pourquoi</text></gloss>
      <gloss lang="en"><text>matter, cause, reason; (le kɔlɔ yɛɛ) why</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meaning, significance, rationale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.11.9; Childs 2000, p. 183: kɔ́lɔ́ɔ</text></form></note>
  </entry>
  <entry id="kɔlɲuloo_904">
