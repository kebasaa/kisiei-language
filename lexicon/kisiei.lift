  <entry id="buusial_260">
    <lexical-unit><form lang="kqs"><text>buusial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buusial_260_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>reparler de, revenir sur (une affaire) avec qqn</text></gloss>
      <gloss lang="en"><text>bring up (a matter) again with someone, speak of</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>restart (a discussion); remind someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.3.26; Childs 2000, p. 35: bùùsìálló</text></form></note>
    <note><form lang="fr"><text>I tuɛi lɛ ma buusial-la sɔɛi ken te « ne me reparle plus de cette affaire » (DEU.3.26) ; buusial ndu sɔɛi nɔmnde « lui parler de toi » (1SA.19.3).</text></form></note>
  </entry>
