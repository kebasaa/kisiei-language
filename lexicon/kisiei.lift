    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>terebɛnte</text></form></variant>
    <variant><form lang="kqs"><text>terebɛntiei</text></form></variant>
    <sense id="terebɛnteo_1649_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>térébinthe, chêne</text></gloss>
      <gloss lang="en"><text>terebinth, oak</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first JDG.6.11</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="tiamaa_1650">
    <lexical-unit><form lang="kqs"><text>tiamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiamaalan</text></form></variant>
    <sense id="tiamaa_1650_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>galanterie, séduction ; (vanalanɔ tiamaa) femme dévergondée</text></gloss>
      <gloss lang="en"><text>flirtation, seduction; (vanalanɔ tiamaa) loose woman, seductress</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PRO.5.3</text></form></note>
    <note><form lang="fr"><text>pisulta tiamaalan « (Isaac) caressait (Rébecca) » (Gn 26,8).</text></form></note>
  </entry>
  <entry id="tiilaa_1651">
    <lexical-unit><form lang="kqs"><text>tiilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiila</text></form></variant>
    <sense id="tiilaa_1651_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>assiéger, cerner</text></gloss>
      <gloss lang="en"><text>besiege, surround</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first DEU.20.19; Keita 1979, p. 156: Tiilaa</text></form></note>
  </entry>
  <entry id="tiilanndo_1652">
    <lexical-unit><form lang="kqs"><text>tiilanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiilannde</text></form></variant>
    <variant><form lang="kqs"><text>tiilannda</text></form></variant>
    <variant><form lang="kqs"><text>tiilanndan</text></form></variant>
    <sense id="tiilanndo_1652_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rond, circulaire</text></gloss>
      <gloss lang="en"><text>round, circular</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) be round or full; curve, swirl</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first JDG.8.5; Childs 2000, p. 358: tììlăŋndó</text></form></note>
    <note><form lang="fr"><text>bulu tiilanndo « pain rond » (Jg 8,5) ; nile tiilannde « lobe de l'oreille » (Ex 29,20). Sans doute de la famille de tiilaa « encercler ».</text></form></note>
  </entry>
  <entry id="tiimbuuo_1653">
    <lexical-unit><form lang="kqs"><text>tiimbuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiimbuu</text></form></variant>
    <variant><form lang="kqs"><text>tiimbun</text></form></variant>
    <sense id="tiimbuuo_1653_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dénouer, défaire (les cheveux) ; ôter (des ornements)</text></gloss>
      <gloss lang="en"><text>loosen (hair); take off (ornaments)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.102.21; Childs 2000, p. 359: tììmbùùwó</text></form></note>
    <note><form lang="fr"><text>Forme plurielle (voyelle longue et -uu) de timbio « délier ».</text></form></note>
  </entry>
  <entry id="tiindaa_1654">
    <lexical-unit><form lang="kqs"><text>tiindaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiinda</text></form></variant>
    <sense id="tiindaa_1654_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>affermir, confirmer ; appuyer (la main sur)</text></gloss>
      <gloss lang="en"><text>make firm, confirm; lean (one's hand on)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>step on, press with the feet or hands, press against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EST.9.29; Childs 2000, p. 359: tììndàá</text></form></note>
    <note><form lang="fr"><text>Verbe de base de tiindanndo « se fier à » ; vana tiinda baa o … coo « celui qui s'appuie sur … » (2 R 18,21).</text></form></note>
  </entry>
  <entry id="tiindanndo_1655">
    <lexical-unit><form lang="kqs"><text>tiindanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiindan</text></form></variant>
    <sense id="tiindanndo_1655_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se fier à, compter sur</text></gloss>
      <gloss lang="en"><text>trust in, rely on</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>depend on, trust (middle of 'step on, press')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first DEU.28.52; Childs 2000, p. 359: tììndǎŋndó</text></form></note>
  </entry>
  <entry id="tiiyaa_1656">
    <lexical-unit><form lang="kqs"><text>tiiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiiya</text></form></variant>
    <variant><form lang="kqs"><text>tiiyanin</text></form></variant>
    <sense id="tiiyaa_1656_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>atteindre, arriver à ; suffire</text></gloss>
      <gloss lang="en"><text>reach, arrive at; be enough</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 314 occurrences, first GEN.3.22; Childs 2000, p. 359: tììyàá</text></form></note>
  </entry>
  <entry id="tiiyallo_1657">
    <lexical-unit><form lang="kqs"><text>tiiyallo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiiyal</text></form></variant>
    <sense id="tiiyallo_1657_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter à, faire parvenir à ; annoncer (une nouvelle) à</text></gloss>
      <gloss lang="en"><text>bring to, deliver to; proclaim (news) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go somewhere for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first LEV.21.8; Childs 2000, p. 360: tììyàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tiiyaa.</text></form></note>
  </entry>
  <entry id="timbio_1658">
    <lexical-unit><form lang="kqs"><text>timbio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>timbi</text></form></variant>
    <sense id="timbio_1658_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>délier, détacher ; acquitter (un vœu)</text></gloss>
      <gloss lang="en"><text>untie, loosen; fulfil (a vow)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: explain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.25.21; Childs 2000, p. 360: tìmbìó</text></form></note>
  </entry>
  <entry id="tindaa_1659">
    <lexical-unit><form lang="kqs"><text>tindaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tindalan</text></form></field>
    <variant><form lang="kqs"><text>tinda</text></form></variant>
    <variant><form lang="kqs"><text>tindala</text></form></variant>
    <sense id="tindaa_1659_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâton, canne ; bâton, verge</text></gloss>
      <gloss lang="en"><text>staff, walking stick ; staff, rod</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cane, walking stick</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.32.32; Keita 1979, p. 159: Tindan; Childs 2000, p. 360: tìndàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tindan ; la Bible écrit tindaa, pl. tindalan.</text></form></note>
  </entry>
  <entry id="tindi_1660">
    <lexical-unit><form lang="kqs"><text>tindi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tindi_1660_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>réveiller ; ressusciter (qqn)</text></gloss>
      <gloss lang="en"><text>wake (someone); raise (from the dead)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first LEV.13.23; Childs 2000, p. 360: tìndìó</text></form></note>
    <note><form lang="fr"><text>Causatif de tendu.</text></form></note>
  </entry>
  <entry id="tindilen_1661">
    <lexical-unit><form lang="kqs"><text>tindilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tindile</text></form></variant>
    <sense id="tindilen_1661_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colonne</text></gloss>
      <gloss lang="en"><text>pillar, column</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.44.13</text></form></note>
    <note><form lang="fr"><text>tindile ikumnden « la colonne de nuée ».</text></form></note>
  </entry>
  <entry id="tingɔɔ_1662">
    <lexical-unit><form lang="kqs"><text>tingɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tingu</text></form></variant>
    <sense id="tingɔɔ_1662_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramasser (du bois)</text></gloss>
      <gloss lang="en"><text>gather (firewood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="5.5.6 Fuel"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, fetch; also cut, break (wood)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.15.32; Childs 2000, p. 361: tìŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>yɔmnde tingɔɔ « ramasser du bois ».</text></form></note>
  </entry>
  <entry id="tiondɔɔ_1663">
    <lexical-unit><form lang="kqs"><text>tiondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiondu</text></form></variant>
    <variant><form lang="kqs"><text>tiandu</text></form></variant>
    <variant><form lang="kqs"><text>tindu</text></form></variant>
    <variant><form lang="kqs"><text>tiandunin</text></form></variant>
    <sense id="tiondɔɔ_1663_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réveiller, s'éveiller</text></gloss>
      <gloss lang="en"><text>wake up, awake</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1KI.18.27; Childs 2000, p. 362: tìɔ̀ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tiondu (impératif, Jg 5,12), tiandu (accompli, Gn 41,7), tindu (négatif, 1 S 26,12). Cf. tindi « réveiller (qqn) ».</text></form></note>
  </entry>
  <entry id="tisaa_1664">
    <lexical-unit><form lang="kqs"><text>tisaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tisa</text></form></variant>
    <variant><form lang="kqs"><text>tisanin</text></form></variant>
    <sense id="tisaa_1664_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>poursuivre, attaquer ; presser (qqn)</text></gloss>
      <gloss lang="en"><text>pursue, attack; urge on, hurry (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stumble, fall down; also jump on, assault; follow; bear witness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.56.2; Childs 2000, p. 362: tìsàá</text></form></note>
    <note><form lang="fr"><text>mɛlɛkaa tisa Lɔt kɔɔli « les anges pressèrent Lot » (Gn 19,15).</text></form></note>
  </entry>
  <entry id="tivaa_1665">
    <lexical-unit><form lang="kqs"><text>tivaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tivaa_1665_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>toute l'étendue, la surface entière ; (o tivaa sɔ́) partout</text></gloss>
      <gloss lang="en"><text>whole extent, entire surface; (o tivaa sɔ́) all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note><form lang="fr"><text>nàà siaŋaa va ndu o tivaa sɔ́ « (sa main) était couverte de lèpre » (Ex 4,6) ; naŋɔɔ ndɔɔ co o tivaa o lɛŋnden coo « sa gloire est sur toute la terre » (Ps 148,13).</text></form></note>
  </entry>
  <entry id="tivolla_1666">
    <lexical-unit><form lang="kqs"><text>tivolla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tivoli</text></form></variant>
    <variant><form lang="kqs"><text>tivolaa</text></form></variant>
    <sense id="tivolla_1666_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chacals</text></gloss>
      <gloss lang="en"><text>jackals</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a wild dog-like animal ('fox')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first JOB.30.29; Childs 2000, p. 363: tíwɔ̂lló</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé avec certitude (tivoli, Mi 1,8).</text></form></note>
  </entry>
  <entry id="tiw_1667">
    <lexical-unit><form lang="kqs"><text>tiw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiw_1667_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>suffire, être assez grand pour ; venir à bout de</text></gloss>
      <gloss lang="en"><text>be enough, have room for; master, overcome</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread throughout; be enough, suffice; fit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 206 occurrences, first GEN.4.7; Childs 2000, p. 363: tìùwó</text></form></note>
    <note><form lang="fr"><text>tàndá kon ndóò tiw nda le « le pays ne leur suffisait pas » (Gn 13,6).</text></form></note>
  </entry>
  <entry id="tiwba_1668">
    <lexical-unit><form lang="kqs"><text>tiwba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiwba_1668_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pouvoir, être capable de</text></gloss>
      <gloss lang="en"><text>be able to, can</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4 Semantic constituents related to verbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 256 occurrences, first GEN.34.14</text></form></note>
  </entry>
  <entry id="tiŋio_1669">
    <lexical-unit><form lang="kqs"><text>tiŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiŋi</text></form></variant>
    <variant><form lang="kqs"><text>tiŋia</text></form></variant>
    <variant><form lang="kqs"><text>tiŋii</text></form></variant>
    <sense id="tiŋio_1669_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>noir, sombre</text></gloss>
      <gloss lang="en"><text>black, dark</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>black, dark; also dark blue</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first SNG.1.6; Childs 2000, p. 361: tìŋì-</text></form></note>
    <note><form lang="fr"><text>so tiŋio « cheval noir » (Ap 6,5) ; saa tiŋia « moutons noirs » (Gn 30,32) ; kumii tiŋii « nuages sombres » (Ex 19,16).</text></form></note>
  </entry>
  <entry id="tiŋndo_1670">
    <lexical-unit><form lang="kqs"><text>tiŋndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tiŋndo_1670_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>île</text></gloss>
      <gloss lang="en"><text>island</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tinndo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, tiŋndo signifie « trajet, distance » (1KI.19.7) ; le sens « île » est à confirmer.</text></form></note>
  </entry>
  <entry id="tiŋɔɔ_1671">
    <lexical-unit><form lang="kqs"><text>tiŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tiŋɔɔ_1671_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>provoquer, tenter, mettre à l'épreuve ; harceler</text></gloss>
      <gloss lang="en"><text>provoke, put to the test; harass</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pledge, vow; also start an argument without provocation</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.17.2; Childs 2000, p. 361: tìŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tiɔmɔɔ_1672">
    <lexical-unit><form lang="kqs"><text>tiɔmɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tiɔm</text></form></variant>
    <sense id="tiɔmɔɔ_1672_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>joindre, unir ; (tiɔm balan) battre des mains ; (tiɔmɔɔ a) avoir des relations avec</text></gloss>
      <gloss lang="en"><text>join, unite; (tiɔm balan) clap one's hands; (tiɔmɔɔ a) have sexual relations with</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>card or comb cotton; clap hands, snap fingers; flirt, make love (esp. adulterously)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.36.12; Childs 2000, p. 362: tìɔ̀mɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Elifas va tiɔmɔɔ nda cuaa pum « Éliphaz avait une concubine » (Gn 36,12) ; n kɔ lɔl tiɔmɔɔ « enivrons-nous d'amour » (Pr 7,18).</text></form></note>
  </entry>
  <entry id="tiɔn_1673">
    <lexical-unit><form lang="kqs"><text>tiɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ŋiɔn</text></form></variant>
    <variant><form lang="kqs"><text>ŋiin</text></form></variant>
    <variant><form lang="kqs"><text>miɔn</text></form></variant>
    <sense id="tiɔn_1673_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>deux</text></gloss>
      <gloss lang="en"><text>two</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 168 occurrences, first GEN.1.6; Childs 2000, p. 362: tìɔ́ɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>La forme varie selon la classe du nom compté.</text></form></note>
  </entry>
  <entry id="toal_1674">
    <lexical-unit><form lang="kqs"><text>toal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toalnin</text></form></variant>
    <sense id="toal_1674_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre (sur)</text></gloss>
      <gloss lang="en"><text>come down (upon)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 178 occurrences, first GEN.11.5</text></form></note>
  </entry>
  <entry id="toandaa_1675">
    <lexical-unit><form lang="kqs"><text>toandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toandaa_1675_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, étendre (toile, filet)</text></gloss>
      <gloss lang="en"><text>stretch out, spread (cloth, net)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 354 occurrences, first GEN.9.21</text></form></note>
    <note><form lang="fr"><text>cɛi-kola-toandaa « tente » (maison de toile tendue).</text></form></note>
  </entry>
  <entry id="toaŋaa_1676">
    <lexical-unit><form lang="kqs"><text>toaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toaŋ</text></form></variant>
    <variant><form lang="kqs"><text>toaŋan</text></form></variant>
    <sense id="toaŋaa_1676_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire (galettes), griller (grains)</text></gloss>
      <gloss lang="en"><text>bake (flat bread), parch (grain)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fry, cook</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.29.2; Childs 2000, p. 365: tɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>dɛɛ toaŋaa « galettes » (Ex 29,2) ; kulun toaŋan « grain grillé » (Jos 5,11).</text></form></note>
  </entry>
  <entry id="tofaa_1677">
    <lexical-unit><form lang="kqs"><text>tofaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tofa</text></form></variant>
    <variant><form lang="kqs"><text>tofanin</text></form></variant>
    <sense id="tofaa_1677_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder, voir</text></gloss>
      <gloss lang="en"><text>look at, see</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: inspect, taste, search, find out</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 158 occurrences, first GEN.2.9; Childs 2000, p. 363: tòfàá</text></form></note>
  </entry>
  <entry id="tofan_1678">
    <lexical-unit><form lang="kqs"><text>tofan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tofan_1678_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se retourner pour regarder ; regarder vers</text></gloss>
      <gloss lang="en"><text>look back; look to</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>look at oneself (in a mirror)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.19.17; Childs 2000, p. 363: tòfǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de tofaa.</text></form></note>
  </entry>
  <entry id="tofanndo_1679">
    <lexical-unit><form lang="kqs"><text>tofanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tofanndan</text></form></field>
    <sense id="tofanndo_1679_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>miroir ; regard</text></gloss>
      <gloss lang="en"><text>mirror; looking</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOS.8.20; Keita 1979, p. 144: Tofanndo; Childs 2000, p. 363: tɔ̀fáŋndó</text></form></note>
  </entry>
  <entry id="tolɔɔ_1680">
    <lexical-unit><form lang="kqs"><text>tolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tol</text></form></variant>
    <variant><form lang="kqs"><text>toal</text></form></variant>
    <variant><form lang="kqs"><text>tul</text></form></variant>
    <variant><form lang="kqs"><text>toalnin</text></form></variant>
    <variant><form lang="kqs"><text>tulnin</text></form></variant>
    <sense id="tolɔɔ_1680_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>descendre</text></gloss>
      <gloss lang="en"><text>go down, descend</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>descend, climb or slide down</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 125 occurrences, first GEN.8.3; Keita 1979, p. 115: Tolöö; Childs 2000, p. 364: tòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tul, tulnin : radical négatif (EXO 12,23).</text></form></note>
  </entry>
  <entry id="tomaa_1681">
    <lexical-unit><form lang="kqs"><text>tomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="tomaa_1681_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vieillard (Keita)</text></gloss>
      <gloss lang="en"><text>old man (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Tomaa</text></form></note>
    <note><form lang="fr"><text>Le seul emploi biblique (Ac 11,2, tomaa-a) ne confirme pas le sens « vieillard ».</text></form></note>
  </entry>
  <entry id="tombolaa_1682">
    <lexical-unit><form lang="kqs"><text>tombolaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tombola</text></form></variant>
    <variant><form lang="kqs"><text>tombolal</text></form></variant>
    <sense id="tombolaa_1682_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>joindre, assembler ; raconter, exposer</text></gloss>
      <gloss lang="en"><text>join, couple; tell, recount</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>talk, discuss, explain; join together, line up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.36.18; Childs 2000, p. 364: tɔ̀mbɔ̀làá</text></form></note>
    <note><form lang="fr"><text>tombola lɔma « raconter un rêve » (Gn 40,9) ; tombolal « raconter à » (Gn 41,8) ; tombolaa « assembler (la tente) » (Ex 36,18). Le kissi du Sud a les deux sens dans le même verbe (Childs).</text></form></note>
  </entry>
  <entry id="tomboliaa_1683">
    <lexical-unit><form lang="kqs"><text>tomboliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tomboliaa_1683_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>assembler, coudre ensemble (plusieurs pièces)</text></gloss>
      <gloss lang="en"><text>join together, sew together (many pieces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>line up things or people; talk in sequence</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.26.14; Childs 2000, p. 364: tɔ̀mbɔ̀lìá</text></form></note>
    <note><form lang="fr"><text>Dérivé de tombolaa « joindre ».</text></form></note>
  </entry>
  <entry id="tombon_1684">
    <lexical-unit><form lang="kqs"><text>tombon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tombon_1684_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hauts lieux (lieux de culte)</text></gloss>
      <gloss lang="en"><text>high places (shrines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first 1KI.13.33</text></form></note>
    <note><form lang="fr"><text>Pluriel.</text></form></note>
  </entry>
  <entry id="tondɔɔ_1685">
    <lexical-unit><form lang="kqs"><text>tondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tondu</text></form></variant>
    <variant><form lang="kqs"><text>tondunin</text></form></variant>
    <sense id="tondɔɔ_1685_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser (une tente), suspendre (un rideau)</text></gloss>
      <gloss lang="en"><text>set up, pitch (a tent); hang (a curtain)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.35.18</text></form></note>
  </entry>
  <entry id="tongo_1686">
    <lexical-unit><form lang="kqs"><text>tongo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tongo_1686_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>portique, vestibule, salle</text></gloss>
      <gloss lang="en"><text>porch, hall</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>village hall, open roofed meeting house</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first 1KI.6.3; Childs 2000, p. 365: tɔ̀ŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tongo cɔwvo_1687">
    <lexical-unit><form lang="kqs"><text>tongo cɔwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tongo cɔwvo_1687_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forge</text></gloss>
      <gloss lang="en"><text>forge, smithy</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lit. 'war hut': the smithy, where the weapons were made</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Tongo työwvo; Childs 2000, p. 365: tɔ̀ŋgɔ́-cɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; tongo « hangar, salle » (1 R 7,7) et cɔwvo sont dans la Bible. Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="tongu_1688">
    <lexical-unit><form lang="kqs"><text>tongu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tongu_1688_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être large, vaste ; élargir</text></gloss>
      <gloss lang="en"><text>be wide, spacious; broaden</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NEH.3.8; Childs 2000, p. 365: tɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>dio tongu taw-vo « la porte large » (Mt 7,13) ; a tongu boofiaala ndalan « ils élargissent leurs phylactères » (Mt 23,5).</text></form></note>
  </entry>
  <entry id="too_1689">
    <lexical-unit><form lang="kqs"><text>too</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="too_1689_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sud (a ba too « vers le sud »)</text></gloss>
      <gloss lang="en"><text>south (a ba too 'southward')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>low, lower part, below, down; also Monrovia (down-country)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.12.9; Childs 2000, p. 366: tòò</text></form></note>
  </entry>
  <entry id="tooluo_1690">
    <lexical-unit><form lang="kqs"><text>tooluo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>toolu</text></form></variant>
    <variant><form lang="kqs"><text>toolunin</text></form></variant>
    <sense id="tooluo_1690_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arranger, réparer ; pourvoir</text></gloss>
      <gloss lang="en"><text>arrange, repair; provide for</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>assist, help</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Toolno; Childs 2000, p. 366: tòòlòó</text></form></note>
    <note><form lang="fr"><text>Keita imprime toolno (pour tooluo ?). toolu dans la Bible : « pourvoir largement » (DEU 15,14), « vanner » (JER 51,2) ; sens à préciser.</text></form></note>
  </entry>
  <entry id="tooma pɔɔndo_1691">
    <lexical-unit><form lang="kqs"><text>tooma pɔɔndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tooma pɔɔndo_1691_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tatouages</text></gloss>
      <gloss lang="en"><text>tattoos</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boys' initiation society (Poro)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Tooma Pööndo; Childs 2000, p. 367: tóómá-pɔ̀ɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Sens à confirmer : Childs donne la société d'initiation des garçons ; dans la Bible, tooma est la circoncision.</text></form></note>
  </entry>
  <entry id="toomaa_1692">
    <lexical-unit><form lang="kqs"><text>toomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tooma</text></form></variant>
    <sense id="toomaa_1692_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>circoncision</text></gloss>
      <gloss lang="en"><text>circumcision</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.17</text></form></note>
    <note><form lang="fr"><text>dii toomaa « circoncire ».</text></form></note>
  </entry>
  <entry id="toongoo_1693">
    <lexical-unit><form lang="kqs"><text>toongoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="toongoo_1693_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>neveu, nièce (enfant de la sœur)</text></gloss>
      <gloss lang="en"><text>nephew, niece (sister's child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nephew, sister's son</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.29.12; Keita 1979, p. 134: Toongoo Piaanduo; Childs 2000, p. 365: tòŋóó</text></form></note>
    <note><form lang="fr"><text>En Gn 29,12, Jacob est le toongoo de Laban, frère de sa mère. Keita : Toongoo piaanduo « le neveu », Toongoo laanduo « la nièce ».</text></form></note>
  </entry>
  <entry id="toosiaa_1694">
    <lexical-unit><form lang="kqs"><text>toosiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>toosian</text></form></variant>
    <variant><form lang="kqs"><text>toosial</text></form></variant>
    <sense id="toosiaa_1694_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, fabriquer, préparer ; arranger, réparer (Keita)</text></gloss>
      <gloss lang="en"><text>make, prepare; repair (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 543 occurrences, first GEN.1.16; Keita 1979, p. 113: Toosiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de tosaa ; dans la Bible « faire, créer » (GEN 1,16).</text></form></note>
  </entry>
  <entry id="toosial_1695">
    <lexical-unit><form lang="kqs"><text>toosial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toosial_1695_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, préparer pour (qqn)</text></gloss>
      <gloss lang="en"><text>make, prepare for (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fix, make, dress (someone) for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.2.18; Childs 2000, p. 367: tòòsìàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de toosiaa « faire, arranger ».</text></form></note>
  </entry>
  <entry id="toosian_1696">
    <lexical-unit><form lang="kqs"><text>toosian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="toosian_1696_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fait, préparé (de)</text></gloss>
      <gloss lang="en"><text>be made, prepared (of)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>get prepared; get dressed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 151 occurrences, first GEN.19.3; Childs 2000, p. 367: tòòsìǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de toosiaa : bulu toosian a lɛvɛn too « pain fait sans levain ».</text></form></note>
  </entry>
  <entry id="tootoo_1697">
    <lexical-unit><form lang="kqs"><text>tootoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tootoo_1697_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bas ; humblement ; à voix basse</text></gloss>
      <gloss lang="en"><text>low; humbly; in a whisper</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>underscores how low (ideophone)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first 1SA.2.7; Childs 2000, p. 367: tóòtò</text></form></note>
  </entry>
  <entry id="toovaa_1698">
    <lexical-unit><form lang="kqs"><text>toovaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="toovaa_1698_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taureau</text></gloss>
      <gloss lang="en"><text>bull</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>male animal (cow, sheep, etc.), bull</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Toovaa; Childs 2000, p. 367: tòòyòó</text></form></note>
  </entry>
  <entry id="toovio_1699">
    <lexical-unit><form lang="kqs"><text>toovio</text></form></lexical-unit>
