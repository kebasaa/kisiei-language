      <gloss lang="en"><text>beggar</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: píɛ́íyàá</text></form></note>
