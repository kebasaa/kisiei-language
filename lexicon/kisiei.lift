    <sense id="bàndóó_63_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>estrade, plate-forme ; tour de guet ; table (pour les sacrifices)</text></gloss>
      <gloss lang="en"><text>platform, raised stand; watchtower; table (for sacrifices)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
