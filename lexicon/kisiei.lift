  <entry id="tanaa_1626">
    <lexical-unit><form lang="kqs"><text>tanaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tana</text></form></variant>
    <variant><form lang="kqs"><text>tanala</text></form></variant>
    <variant><form lang="kqs"><text>tanan</text></form></variant>
    <variant><form lang="kqs"><text>tanai</text></form></variant>
    <variant><form lang="kqs"><text>tanalen</text></form></variant>
    <sense id="tanaa_1626_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>interdit, chose sacrée ; sacrilège, blasphème ; (pl.) règles, ordonnances</text></gloss>
      <gloss lang="en"><text>taboo, thing under a ban; sacrilege, blasphemy; (pl.) rules, ordinances</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>law, rule, taboo</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JOS.6.18; Childs 2000, p. 349: tànàá</text></form></note>
    <note><form lang="fr"><text>ɲɛm co o tanaa bɛngu « les choses vouées à l'interdit » (Jos 6,18) ; visi tanaa « animal impur » (Ac 10,14) ; pilan Mɛlɛka tana « offenser le Seigneur » (Ne 1,7) ; diomnde tana, sɔɔn tanan « blasphème(s) » (Jb 1,22 ; 1 R 21,13) ; tanala « ordonnances » (Ps 119,104).</text></form></note>
  </entry>
