  <entry id="búlúdíɔ́ɔ́_384">
    <lexical-unit><form lang="kqs"><text>búlúdíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="búlúdíɔ́ɔ́_384_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain en forme de corne (farine de riz)</text></gloss>
      <gloss lang="en"><text>horn-shaped rice-flour bread</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúdíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="buludɛo_385">
    <lexical-unit><form lang="kqs"><text>buludɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="buludɛo_385_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain de farine de blé</text></gloss>
      <gloss lang="en"><text>wheat bread</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14 (G): buludɛo /G./</text></form></note>
    <note><form lang="fr"><text>Cf. buloo « pain » (Bible).</text></form></note>
  </entry>
  <entry id="búlúlákándáá_386">
    <lexical-unit><form lang="kqs"><text>búlúlákándáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="búlúlákándáá_386_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'insecte (ravageur du riz de bas-fond)</text></gloss>
      <gloss lang="en"><text>species of insect (pest of swamp rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúlákándáá</text></form></note>
  </entry>
  <entry id="bulundo_387">
    <lexical-unit><form lang="kqs"><text>bulundo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bulundo_387_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nœud ; nouer</text></gloss>
      <gloss lang="en"><text>knot; to knot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 15: burundo</text></form></note>
    <note><form lang="fr"><text>Paulme : o yi burundo « il a attaché le nœud ».</text></form></note>
  </entry>
  <entry id="búlúŋndó_388">
    <lexical-unit><form lang="kqs"><text>búlúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>búlúŋndáŋ</text></form></field>
    <sense id="búlúŋndó_388_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nœud</text></gloss>
      <gloss lang="en"><text>knot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: búlúŋndó</text></form></note>
  </entry>
  <entry id="bumba_389">
    <lexical-unit><form lang="kqs"><text>bumba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bumbanin</text></form></variant>
    <sense id="bumba_389_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échouer, ne pas réussir à ; perdre (une bataille) ; manquer ; échec</text></gloss>
      <gloss lang="en"><text>fail, be unable to; lose (a battle); miss; failure</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first DEU.2.36; Terminologie (histoire), n° 311: Bumbaa, demaa; Childs 2000, p. 32: bùmbàá</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 311, 312) : bumbaa « échouer, échec » (aussi demaa).</text></form></note>
  </entry>
  <entry id="bùmbàá_390">
    <lexical-unit><form lang="kqs"><text>bùmbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùmbàláŋ</text></form></field>
    <sense id="bùmbàá_390_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas du dos ; poitrail (d'un animal)</text></gloss>
      <gloss lang="en"><text>lower back; chest (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: bùmbàá</text></form></note>
  </entry>
  <entry id="bumbanndo_391">
    <lexical-unit><form lang="kqs"><text>bumbanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bumbanndo_391_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>invincibilité</text></gloss>
      <gloss lang="en"><text>invincibility</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 408: Bumbanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. bumba « échouer, perdre (une bataille) ».</text></form></note>
  </entry>
  <entry id="bumbo_392">
    <lexical-unit><form lang="kqs"><text>bumbo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bumbuan</text></form></field>
    <sense id="bumbo_392_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil terrestre (« rat palmiste »)</text></gloss>
      <gloss lang="en"><text>ground squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: bumbo, pl. bumbuã</text></form></note>
  </entry>
  <entry id="bumboo_393">
    <lexical-unit><form lang="kqs"><text>bumboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bumboo_393_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agouti</text></gloss>
      <gloss lang="en"><text>cane rat, grasscutter</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 8: bunboo</text></form></note>
    <note><form lang="fr"><text>La Bible écrit mb devant b.</text></form></note>
  </entry>
  <entry id="bùmbòó_394">
    <lexical-unit><form lang="kqs"><text>bùmbòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùmbùá</text></form></field>
    <sense id="bùmbòó_394_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aulacode (« marmotte »), rongeur qui mange le riz</text></gloss>
      <gloss lang="en"><text>cane rat ("groundhog"), rodent eating rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 32: bùmbòó</text></form></note>
  </entry>
  <entry id="bumbula_395">
    <lexical-unit><form lang="kqs"><text>bumbula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bumbulan</text></form></variant>
    <sense id="bumbula_395_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'émousser, être émoussé ; (bumbulan) défaillir, s'affaiblir</text></gloss>
      <gloss lang="en"><text>become blunt, be dull; (bumbulan) grow faint, weaken</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.58.8; Childs 2000, p. 32: bùmbàlàá</text></form></note>
    <note><form lang="fr"><text>Te cuei bumbula pɛ « si le fer est émoussé » (ECC.10.10) ; o sanga le, o bumbulan te « il ne se fatigue ni ne se lasse » (ISA.40.28).</text></form></note>
  </entry>
  <entry id="bumbuo_396">
    <lexical-unit><form lang="kqs"><text>bumbuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bumbulan</text></form></field>
    <sense id="bumbuo_396_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fragment de calebasse, écuelle en bois ; sanza (table faite d'un tel fragment)</text></gloss>
      <gloss lang="en"><text>piece of broken gourd, wooden bowl; thumb piano (with such a sounding board)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: bumbuo, pl. bumburã</text></form></note>
    <note><form lang="fr"><text>Paulme, p. 14 : bumburã aussi « rondelles en calebasse du sistre (wusamba) ». Le pluriel bumbulan de la Bible (ISA.40.28) est un homographe.</text></form></note>
  </entry>
  <entry id="bundua_397">
    <lexical-unit><form lang="kqs"><text>bundua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bundua_397_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunes filles excisées (pendant la retraite)</text></gloss>
      <gloss lang="en"><text>excised girls (during seclusion)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: bundua</text></form></note>
    <note><form lang="fr"><text>Paulme : Fangamadou.</text></form></note>
  </entry>
  <entry id="bundɔn dimioo_398">
    <lexical-unit><form lang="kqs"><text>bundɔn dimioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bundɔn dimioo_398_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>conter</text></gloss>
      <gloss lang="en"><text>tell tales</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 90: Bundön dimioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « dire des fables » (bundɔn, pluriel de bundɛi).</text></form></note>
  </entry>
  <entry id="bundɔɔ_399">
    <lexical-unit><form lang="kqs"><text>bundɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɛlan</text></form></field>
    <variant><form lang="kqs"><text>bundɛ</text></form></variant>
    <variant><form lang="kqs"><text>bundɛla</text></form></variant>
    <sense id="bundɔɔ_399_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forêt, bois</text></gloss>
      <gloss lang="en"><text>forest, wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moist semi-deciduous forest, gallery or riverside forest, jungle, woods</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first DEU.14.16; Paulme 1964, p. 14: bundo, bundo, pl. bundara; Lexique kissi–français, p. 8: bundɔɔ; Childs 2000, p. 33: bùndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale bundɛ : o bundɛ kon nin « dans cette forêt » (1 S 14,26) ; yɔmii bundɛi « les arbres de la forêt » (Ez 15,6). Cf. bundɛcieo « clairière ». Paulme 1964, p. 14 : bundo, pl. bundara « forêt » ; dala bundo « forêt sacrée, interdite » (une par village).</text></form></note>
  </entry>
  <entry id="bundɛcieo_400">
    <lexical-unit><form lang="kqs"><text>bundɛcieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bundɛcieo_400_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clairière</text></gloss>
      <gloss lang="en"><text>clearing</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Bundètyieo; Lexique kissi–français, p. 8: bundɛcieo</text></form></note>
  </entry>
  <entry id="bundɛi_401">
    <lexical-unit><form lang="kqs"><text>bundɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɔn</text></form></field>
    <sense id="bundɛi_401_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parabole, énigme ; (pl.) fables ; conte (souvent d'animaux, avec une morale)</text></gloss>
      <gloss lang="en"><text>parable, riddle; (pl.) fables, myths; folktale (often about animals, with a moral)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>story, tale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EZK.15.6; Paulme 1964, p. 14: bundɛy, pl. bundɔ, bundɔɔ; Terminologie (langue), n° 89: Bundèi; Childs 2000, p. 32: búndèí</text></form></note>
    <note><form lang="fr"><text>À distinguer de yɔmii bundɛi « les arbres de la forêt » (Ez 15,6), de bundɔɔ « forêt ». Paulme 1964, p. 14 : bundɛy, pl. bundɔ, bundɔɔ « conte, souvent d'animaux, invraisemblable et comportant une moralité ». Académie des langues (terminologie, langue n° 89) : « conte » ; bundön dimioo « conter » (n° 90). Académie des langues (terminologie, langue n° 177) : bundèi, taloo « fable ». Académie des langues (terminologie, langue n° 226) : bundèi, taloo « légende ».</text></form></note>
  </entry>
  <entry id="bungɛi_402">
    <lexical-unit><form lang="kqs"><text>bungɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bungan</text></form></field>
    <sense id="bungɛi_402_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>part, morceau, portion ; lobe (du foie)</text></gloss>
      <gloss lang="en"><text>part, piece, portion; lobe (of the liver)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>area, section, plot, portion; also promise, vow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 103 occurrences, first EXO.29.13; Terminologie (langue), n° 17: Bungèi; Childs 2000, p. 33: bùŋèí</text></form></note>
    <note><form lang="fr"><text>bungɛi hiow naŋɔɔ o yemnde « le lobe du foie » (Ex 29,13). Académie des langues (terminologie, langue n° 17) : « alinéa ». Académie des langues (terminologie, langue n° 189) : « fragment ». Académie des langues (terminologie, langue n° 299) : « paragraphe ». Académie des langues (terminologie, langue n° 378) : « strophe ». Académie des langues (terminologie, histoire n° 75) : « arrondissement » (aussi sèksiönndo). Aussi Terminologie, p. 309 : « Bungèi, boondei ». Académie des langues (terminologie, histoire n° 309) : « étape » (aussi boondei).</text></form></note>
  </entry>
  <entry id="bungɛi iconduei_403">
    <lexical-unit><form lang="kqs"><text>bungɛi iconduei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bungɛi iconduei_403_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couplet</text></gloss>
      <gloss lang="en"><text>verse (of a song)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 72: Bungei ityonduei</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « morceau du chant » (bungɛi, condei).</text></form></note>
  </entry>
  <entry id="buo_404">
    <lexical-unit><form lang="kqs"><text>buo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buo_404_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>largeur</text></gloss>
      <gloss lang="en"><text>width</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 96 occurrences, first GEN.6.15</text></form></note>
  </entry>
  <entry id="busa_405">
    <lexical-unit><form lang="kqs"><text>busa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>busanin</text></form></variant>
    <sense id="busa_405_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir, frayer (un chemin)</text></gloss>
      <gloss lang="en"><text>open up, make (a way)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.38.25</text></form></note>
  </entry>
  <entry id="busɔɔ_406">
    <lexical-unit><form lang="kqs"><text>busɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>busullo</text></form></variant>
    <sense id="busɔɔ_406_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aboyer, hurler (animal) ; (busullo) aboyer contre</text></gloss>
      <gloss lang="en"><text>bark, howl; (busullo) bark at</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bark; (of a young animal) open the eyes</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.13.22; Lexique kissi–français, p. 8: busɔɔ/ busu; Childs 2000, p. 33: bùsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>a nɔla busɔɔ le « ils ne peuvent aboyer » (ISA.56.10) ; tunndo ... vanacieo busullo « aucun chien n'aboiera contre personne » (EXO.11.7).</text></form></note>
  </entry>
  <entry id="bútè_407">
    <lexical-unit><form lang="kqs"><text>bútè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bútè_407_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup</text></gloss>
      <gloss lang="en"><text>much, a lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: bútè</text></form></note>
  </entry>
  <entry id="buubuuon_408">
    <lexical-unit><form lang="kqs"><text>buubuuon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buubuuon_408_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collines</text></gloss>
      <gloss lang="en"><text>hills</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a mound</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first PSA.114.4; Childs 2000, p. 34: búúbúúwé</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="búúbúúwé_409">
    <lexical-unit><form lang="kqs"><text>búúbúúwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="búúbúúwé_409_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane rouge à l'intérieur (écorce battue pour faire des cordes)</text></gloss>
      <gloss lang="en"><text>vine red inside (peeled and beaten for rope)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: búúbúúwé</text></form></note>
  </entry>
  <entry id="buukuo_410">
    <lexical-unit><form lang="kqs"><text>buukuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>buukulan</text></form></field>
    <variant><form lang="kqs"><text>buuku</text></form></variant>
    <sense id="buukuo_410_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sabot</text></gloss>
      <gloss lang="en"><text>hoof</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Buukuo; Lexique kissi–français, p. 8: buukuo; Childs 2000, p. 34: bùùkɔ̀ɔ̀</text></form></note>
    <note><form lang="fr"><text>La Bible a la forme radicale buuku (LEV.11.3) et le pluriel buukulan (PSA.69.32).</text></form></note>
  </entry>
  <entry id="buulanndo_411">
    <lexical-unit><form lang="kqs"><text>buulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buulan</text></form></variant>
    <variant><form lang="kqs"><text>buulannda</text></form></variant>
    <sense id="buulanndo_411_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chercher, rechercher ; consulter ; s'inquiéter, se faire du souci ; (buulan te) n'aie pas peur ; être anxieux</text></gloss>
      <gloss lang="en"><text>seek, look for; consult; worry, be anxious; (buulan te) do not be afraid</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.32.12; Lexique kissi–français, p. 8: bulanndo/ bulan; Childs 2000, p. 34: bùùlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Buulan te « ne crains pas » (GEN.21.17, GEN.26.24) ; kɔɔyɔlɔɔ a buulanndo « tristes et soucieux » (GEN.40.6) ; vana-vana buulan le ya « personne ne se soucie de moi » (1SA.22.8). Le sens « chercher, consulter » est déjà enregistré ailleurs ; c'est sans doute le même verbe (« se soucier de »). Le Lexique kissi–français écrit bulanndo/ bulan et buranndo/ buran « être anxieux, se soucier, s'inquiéter » (p. 8).</text></form></note>
  </entry>
  <entry id="bùùlèbúúlíɔ́ɔ́_412">
    <lexical-unit><form lang="kqs"><text>bùùlèbúúlíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùùlèbúúlíá</text></form></field>
    <sense id="bùùlèbúúlíɔ́ɔ́_412_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de rat très prolifique (terrier à plusieurs issues) ; femme à nombreux enfants ; maladie cancéreuse</text></gloss>
      <gloss lang="en"><text>prolific rat species (burrow with many exits); woman with many children; cancerous disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: bùùlèbúúlíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="buululan_413">
    <lexical-unit><form lang="kqs"><text>buululan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buulula</text></form></variant>
    <sense id="buululan_413_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grotte, caverne</text></gloss>
      <gloss lang="en"><text>cave</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hole, cave (used by crocodiles and ground hogs); singular bùùlòó, plural bùùlùláŋ</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first GEN.19.30; Childs 2000, p. 34: bùùlòó</text></form></note>
    <note><form lang="fr"><text>Forme en -lan employée aussi pour une seule grotte (buulula ndɔla, Gn 23,9).</text></form></note>
  </entry>
  <entry id="buuluuo_414">
    <lexical-unit><form lang="kqs"><text>buuluuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buuluu</text></form></variant>
    <variant><form lang="kqs"><text>buuluunin</text></form></variant>
    <sense id="buuluuo_414_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>percer, trouer ; ouvrir une brèche ; creuser</text></gloss>
      <gloss lang="en"><text>pierce, bore; break through; dig</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2CH.32.1; Paulme 1964, p. 14: buruo; Childs 2000, p. 34: bùùlùùwó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 14 : buruo « percer, creuser » (o buru tɛ̄nio « il a percé plusieurs trous »).</text></form></note>
  </entry>
  <entry id="bùùmbàá_415">
    <lexical-unit><form lang="kqs"><text>bùùmbàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bùùmbàá_415_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gratter, racler</text></gloss>
      <gloss lang="en"><text>scrape</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 34: bùùmbàá</text></form></note>
  </entry>
  <entry id="búúmbúúléŋ_416">
    <lexical-unit><form lang="kqs"><text>búúmbúúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>búúmbúúwé</text></form></field>
    <sense id="búúmbúúléŋ_416_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane à intérieur rouge servant de corde</text></gloss>
      <gloss lang="en"><text>vine with red interior used as rope</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 35: búúmbúúléŋ</text></form></note>
  </entry>
  <entry id="buun_417">
    <lexical-unit><form lang="kqs"><text>buun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buun_417_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bosses (du chameau) ; bosse (du bœuf, de l'homme)</text></gloss>
      <gloss lang="en"><text>humps (of camels); hump (of an ox, of a person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>unripe palm nut; hump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.30.6; Paulme 1964, p. 13: būe, pl. buō; Childs 2000, p. 35: bùùwé</text></form></note>
    <note><form lang="fr"><text>o buun ɲɔɔmɛɛa coo « sur la bosse des chameaux » (ISA.30.6). Paulme 1964, p. 13 : būe, pl. buō « bosse (du bœuf ou de l'homme) » ; wane i bu o « bossu ».</text></form></note>
  </entry>
  <entry id="buusial_418">
    <lexical-unit><form lang="kqs"><text>buusial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buusial_418_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>reparler de, revenir sur (une affaire) avec qqn</text></gloss>
      <gloss lang="en"><text>bring up (a matter) again with someone, speak of</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>restart (a discussion); remind someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.3.26; Childs 2000, p. 35: bùùsìálló</text></form></note>
    <note><form lang="fr"><text>I tuɛi lɛ ma buusial-la sɔɛi ken te « ne me reparle plus de cette affaire » (DEU.3.26) ; buusial ndu sɔɛi nɔmnde « lui parler de toi » (1SA.19.3).</text></form></note>
  </entry>
  <entry id="búúù_419">
    <lexical-unit><form lang="kqs"><text>búúù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="búúù_419_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>abondamment, copieusement</text></gloss>
      <gloss lang="en"><text>copiously, abundantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 35: búúù</text></form></note>
  </entry>
  <entry id="bùúŋndó_420">
    <lexical-unit><form lang="kqs"><text>bùúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùúŋndáŋ</text></form></field>
    <sense id="bùúŋndó_420_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hutte, abri provisoire couvert de palmes ; grotte</text></gloss>
      <gloss lang="en"><text>hut, temporary palm-thatched shelter; cave</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 35: bùúŋndó</text></form></note>
  </entry>
  <entry id="bùwàá_421">
    <lexical-unit><form lang="kqs"><text>bùwàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bùwàá_421_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ourler</text></gloss>
      <gloss lang="en"><text>hem</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 36: bùwàá</text></form></note>
  </entry>
  <entry id="buŋabotema_422">
    <lexical-unit><form lang="kqs"><text>buŋabotema</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bukabɔtema</text></form></variant>
    <variant><form lang="kqs"><text>dɔmndo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="buŋabotema_422_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pourghère (arbuste)</text></gloss>
      <gloss lang="en"><text>physic nut (shrub)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14 (G): buŋabotema /G./, bukabɔtema</text></form></note>
    <note><form lang="fr"><text>Paulme : nom à Guéckédou de l'arbuste appelé dɔmdo à Kissidougou ; p. 20 : dɔmdo /K./, pl. dɔmda « pourghère » ; dɔm'tyɛo « pourghère à l'entrée du village ». Paulme : buŋabotema à Guéckédou, dɔmdo /K./ à Kissidougou (p. 14, 20).</text></form></note>
  </entry>
  <entry id="bùŋbùŋndó_423">
    <lexical-unit><form lang="kqs"><text>bùŋbùŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùŋbùŋndé</text></form></field>
    <sense id="bùŋbùŋndó_423_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit arbre peu commun</text></gloss>
      <gloss lang="en"><text>small, uncommon tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 33: bùŋbùŋndó</text></form></note>
  </entry>
  <entry id="bùŋì lètèŋgéí_424">
    <lexical-unit><form lang="kqs"><text>bùŋì lètèŋgéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="bùŋì lètèŋgéí_424_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>asthme</text></gloss>
      <gloss lang="en"><text>asthma</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 33: bùŋì lètèŋgéí</text></form></note>
  </entry>
  <entry id="buŋie_425">
    <lexical-unit><form lang="kqs"><text>buŋie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>buŋuo</text></form></field>
    <sense id="buŋie_425_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite poterie</text></gloss>
      <gloss lang="en"><text>small pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: buŋye, pl. buŋuo</text></form></note>
  </entry>
  <entry id="buŋnde_426">
    <lexical-unit><form lang="kqs"><text>buŋnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buŋnde_426_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poitrine ; (buŋnde lɔɔnɔnndo) se frapper la poitrine</text></gloss>
      <gloss lang="en"><text>chest, breast; (buŋnde lɔɔnɔnndo) beat one's breast</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chest cold, head cold</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.51.22; Childs 2000, p. 33: bùŋndé</text></form></note>
    <note><form lang="fr"><text>mo va buŋnde lɔɔnɔnndo « il se frappait la poitrine » (LUK.18.13) ; voir aussi ISA.51.22.</text></form></note>
  </entry>
  <entry id="bùŋndó_427">
    <lexical-unit><form lang="kqs"><text>bùŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bùŋndáŋ</text></form></field>
    <sense id="bùŋndó_427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>(grosse) graine d'un fruit ; épi de maïs ; fève de cacao</text></gloss>
      <gloss lang="en"><text>(large) seed of a fruit; corn cob; cocoa bean</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 33: bùŋndó</text></form></note>
  </entry>
  <entry id="buŋɛicalle_428">
    <lexical-unit><form lang="kqs"><text>buŋɛicalle</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="buŋɛicalle_428_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racines pour teindre en brun</text></gloss>
      <gloss lang="en"><text>roots for dyeing brown</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: buŋɛytyalle</text></form></note>
    <note><form lang="fr"><text>Paulme : pour le doma basio.</text></form></note>
  </entry>
  <entry id="buɛiyo_429">
    <lexical-unit><form lang="kqs"><text>buɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>buɛyaa</text></form></field>
    <variant><form lang="kqs"><text>buɛi</text></form></variant>
    <sense id="buɛiyo_429_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serviteur, jeune homme</text></gloss>
      <gloss lang="en"><text>servant, young man</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>servant; also apprentice, learner</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first 1SA.9.8; Paulme 1964, p. 12: bɔyo, bɔya, buey, pl. buɔya; Childs 2000, p. 31: bùɛ́íyó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 12 : bɔyo, bɔya, buey, pl. buɔya « domestique » (qu'elle rattache à l'anglais boy).</text></form></note>
  </entry>
  <entry id="buɲde_430">
    <lexical-unit><form lang="kqs"><text>buɲde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="buɲde_430_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure en cimier (sortie des excisées)</text></gloss>
      <gloss lang="en"><text>crested hairstyle (worn by excised girls at their coming out)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 14: bunyde</text></form></note>
    <note><form lang="fr"><text>Paulme : Fangamadou.</text></form></note>
  </entry>
  <entry id="bɔ̂_431">
    <lexical-unit><form lang="kqs"><text>bɔ̂</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̂_431_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'éclaboussure, de chose qui se brise (œuf, pot)</text></gloss>
      <gloss lang="en"><text>sound of splattering or shattering (egg, pot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 25: bɔ̂</text></form></note>
  </entry>
  <entry id="bɔ́áŋ_432">
    <lexical-unit><form lang="kqs"><text>bɔ́áŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀áléŋ</text></form></field>
    <sense id="bɔ́áŋ_432_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauce épaisse de noix de palme fraîches (« beurre de palme »)</text></gloss>
      <gloss lang="en"><text>palm butter (thick liquid from fresh palm nuts)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 25: bɔ́áŋ</text></form></note>
  </entry>
  <entry id="bɔ̀fàá_433">
    <lexical-unit><form lang="kqs"><text>bɔ̀fàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀fàá_433_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cabosser, meurtrir ; être cabossé</text></gloss>
      <gloss lang="en"><text>dent, bruise; be dented</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 25: bɔ̀fàá</text></form></note>
  </entry>
  <entry id="bɔgaa_434">
    <lexical-unit><form lang="kqs"><text>bɔgaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔgaa_434_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jaunisse</text></gloss>
      <gloss lang="en"><text>jaundice</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Bögaa; Lexique kissi–français, p. 7: bɔngaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit bɔngaa « la jaunisse ? » (p. 7).</text></form></note>
  </entry>
  <entry id="bɔinde_435">
    <lexical-unit><form lang="kqs"><text>bɔinde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔindo</text></form></field>
    <sense id="bɔinde_435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cloche en fer (objet d'ordalie)</text></gloss>
      <gloss lang="en"><text>iron bell (ordeal object)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 10: bɔinde, pl, bɔindo</text></form></note>
    <note><form lang="fr"><text>Paulme : Yende, ordalies, objet Yalamelio.</text></form></note>
  </entry>
  <entry id="bɔla_436">
    <lexical-unit><form lang="kqs"><text>bɔla</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔla_436_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent par alliance (femme de l'oncle maternel, sœur du mari, femme du frère aîné…)</text></gloss>
      <gloss lang="en"><text>in-law (maternal uncle's wife, husband's sister, elder brother's wife…)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔra</text></form></note>
    <note><form lang="fr"><text>Paulme : femme de l'oncle utérin, neveu du mari ; sœur cadette du mari, femme du frère aîné, sœur du mari (femme parlant) ; attitude d'entraide. Cf. bɔlaa « beau-frère, belle-sœur » (Keita 1979).</text></form></note>
  </entry>
  <entry id="bɔlaa_437">
    <lexical-unit><form lang="kqs"><text>bɔlaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔlaa_437_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-frère, belle-sœur</text></gloss>
      <gloss lang="en"><text>brother-in-law, sister-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a man's brother's wife, a woman's brother-in-law; joking relative</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bölaa; Lexique kissi–français, p. 7: bɔlaa; Childs 2000, p. 25: bɔ̀làá</text></form></note>
  </entry>
  <entry id="bɔlale_438">
    <lexical-unit><form lang="kqs"><text>bɔlale</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔlaa</text></form></field>
    <sense id="bɔlale_438_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent à plaisanterie</text></gloss>
      <gloss lang="en"><text>joking relative</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔrale, pl. bɔrā</text></form></note>
  </entry>
  <entry id="bɔ̀làléŋ_439">
    <lexical-unit><form lang="kqs"><text>bɔ̀làléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀làléŋ_439_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parenté à plaisanterie (entre beaux-frères et belles-sœurs)</text></gloss>
      <gloss lang="en"><text>joking relationship (between in-laws)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 26: bɔ̀làléŋ</text></form></note>
  </entry>
  <entry id="bɔ́léí_440">
    <lexical-unit><form lang="kqs"><text>bɔ́léí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ́lɔ́ŋ</text></form></field>
    <sense id="bɔ́léí_440_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perle (noire) ; collier porté par les jeunes filles en initiation</text></gloss>
      <gloss lang="en"><text>(black) seed bead; necklace worn by girls during initiation</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 26: bɔ́léí</text></form></note>
  </entry>
  <entry id="bɔ̀linndan_441">
    <lexical-unit><form lang="kqs"><text>bɔ̀linndan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɔ̀linndan_441_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sistres, hochets (instruments à percussion)</text></gloss>
      <gloss lang="en"><text>sistrums, rattles (percussion instruments)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
  </entry>
  <entry id="bɔlɔ_442">
    <lexical-unit><form lang="kqs"><text>bɔlɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɔlɔlan</text></form></field>
    <variant><form lang="kqs"><text>bɔlɔla</text></form></variant>
    <sense id="bɔlɔ_442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sac, outre ; carquois</text></gloss>
      <gloss lang="en"><text>bag, skin bottle; quiver</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.21.14; Paulme 1964, p. 12: bɔrɔ, pl. bɔrɔla; Terminologie (histoire), n° 140: Bölö mabèlènndo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 12 : bɔrɔ, pl. bɔrɔla « petit sac, en cuir ou en raphia » ; bɔrɔ fundo « sac vide », objet d'ordalie sur lequel on jure (Yole, Dembaduno). Académie des langues (terminologie, histoire n° 140) : bɔlɔ mabɛlɛnndo « carquois ».</text></form></note>
  </entry>
  <entry id="bɔlɔ_443">
    <lexical-unit><form lang="kqs"><text>bɔlɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ_443_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier taillé pour le vin ; vin de palme frais</text></gloss>
      <gloss lang="en"><text>palm tapped for wine; fresh palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 12: bɔrɔ, pl. bɔrɔlé</text></form></note>
    <note><form lang="fr"><text>Paulme, p. 12 : aussi nom d'un arbuste près de l'autel des serpents (ŋuo bɔrɔ), d'un remède contre les morsures de serpent (wana bɔrɔ « charmeur de serpents ») et d'un arbre (pl. bɔrɔwã). Homographe de bɔlɔ « sac ».</text></form></note>
  </entry>
  <entry id="bɔlɔ n'cilinndo_444">
    <lexical-unit><form lang="kqs"><text>bɔlɔ n'cilinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ n'cilinndo_444_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cartouchière</text></gloss>
      <gloss lang="en"><text>cartridge pouch</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Bölö ntyilinndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel : bɔlɔ « sac » et n'cilinndo « en fer » (Ez 19,9). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="bɔlɔ ncilinndo_445">
    <lexical-unit><form lang="kqs"><text>bɔlɔ ncilinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ ncilinndo_445_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cartouchière</text></gloss>
      <gloss lang="en"><text>cartridge belt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 7: bɔlɔ ncilinndo</text></form></note>
    <note><form lang="fr"><text>Sans doute « sac à balles » (bɔlɔɔ « sac », cilinnde « balle, cartouche ») ; découpage à confirmer.</text></form></note>
  </entry>
  <entry id="bɔlɔ tumndo_446">
    <lexical-unit><form lang="kqs"><text>bɔlɔ tumndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ tumndo_446_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bananier</text></gloss>
      <gloss lang="en"><text>banana plant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>banana, banana tree</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölö Tumndo; Paulme 1964, p. 11: bɔlɔtumdo; Lexique kissi–français, p. 7: bɔlɔ tumndo; Childs 2000, p. 27: bɔ́lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Voir bɔlɔɔ. Paulme 1964, p. 11 : bɔlɔtumdo « bananier », pl. bɔlɔletumtã (peu usité).</text></form></note>
  </entry>
  <entry id="bɔ́lɔ́-kpáŋgàlàá_447">
    <lexical-unit><form lang="kqs"><text>bɔ́lɔ́-kpáŋgàlàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ́lɔ́-kpáŋgàlàá_447_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de banane plantain</text></gloss>
      <gloss lang="en"><text>variety of plantain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 26: bɔ́lɔ́-kpáŋgàlàá</text></form></note>
  </entry>
  <entry id="bɔ́lɔ́-mùèìyó_448">
    <lexical-unit><form lang="kqs"><text>bɔ́lɔ́-mùèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ́léí-mùèìyé</text></form></field>
    <sense id="bɔ́lɔ́-mùèìyó_448_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« banane d'eau », banane aqueuse (pâte frite)</text></gloss>
      <gloss lang="en"><text>"water banana", watery banana (for fried batter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 26: bɔ́lɔ́-mùèìyó</text></form></note>
  </entry>
  <entry id="bɔ́lɔ́-pɔ́mbɔ̀ɔ́_449">
    <lexical-unit><form lang="kqs"><text>bɔ́lɔ́-pɔ́mbɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ́lɔ́-pɔ́mbɔ̀ɔ́_449_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>banane naine, petite variété</text></gloss>
      <gloss lang="en"><text>finger banana, small variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ́lɔ́-pɔ́mbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔ́lɔ́-yásáá_450">
    <lexical-unit><form lang="kqs"><text>bɔ́lɔ́-yásáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ́lɔ́-yásáá_450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bananes poussant sur une petite tige</text></gloss>
      <gloss lang="en"><text>bananas growing on a small stalk</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ́lɔ́-yásáá</text></form></note>
  </entry>
  <entry id="bɔlɔan_451">
    <lexical-unit><form lang="kqs"><text>bɔlɔan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔan_451_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme extrait du tronc</text></gloss>
      <gloss lang="en"><text>palm wine tapped from the trunk</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölöan; Lexique kissi–français, p. 7: bɔlɔan</text></form></note>
  </entry>
  <entry id="bɔlɔmbɔndo_452">
    <lexical-unit><form lang="kqs"><text>bɔlɔmbɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bɔlɔmbando</text></form></variant>
    <sense id="bɔlɔmbɔndo_452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>graines enfilées (colliers d'enfants)</text></gloss>
      <gloss lang="en"><text>strung seeds (children's necklaces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔlɔmbɔndo, bɔlɔmbando</text></form></note>
    <note><form lang="fr"><text>Paulme : bɔlɔmbɔn tumdo « l'arbre qui les porte ».</text></form></note>
  </entry>
  <entry id="bɔlɔsundo_453">
    <lexical-unit><form lang="kqs"><text>bɔlɔsundo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔsundo_453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>régime de bananes</text></gloss>
      <gloss lang="en"><text>bunch of bananas</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔlɔsundo, pl. bɔllɛisunte</text></form></note>
    <note><form lang="fr"><text>Paulme : pl. bɔllɛisunte.</text></form></note>
  </entry>
  <entry id="bɔlɔɔ_454">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɔlɔlan</text></form></field>
    <variant><form lang="kqs"><text>bɔrɔɔ</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="bɔlɔɔ_454_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sac</text></gloss>
      <gloss lang="en"><text>bag, sack</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.42.27; Keita 1979, p. 159: Bölöö; Lexique kissi–français, p. 7: bɔlɔɔ; Childs 2000, p. 26: bɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔlɔɔ_455">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bɔlɔlɛ</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="bɔlɔɔ_455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>banane</text></gloss>
      <gloss lang="en"><text>banana</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>banana, banana tree</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölöö; Paulme 1964, p. 11: bɔlle, pl. bɔlɛ ; bɔlɔlɛ /G/. bɔlle; Lexique kissi–français, p. 7: bɔlɔɔ; Childs 2000, p. 27: bɔ́lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, bɔlɔɔ est un homonyme « sac » (GEN.42.27, 1SA.1.24). Le Lexique kissi–français donne aussi bɔllen « la banane » (p. 7). Paulme 1964, p. 11 : bɔlle, pl. bɔlɛ ; bɔlɔlɛ /G./ « banane ». Paulme : bɔlle, pl. bɔlɛ ; bɔlɔlɛ /G./ (p. 11).</text></form></note>
  </entry>
  <entry id="bɔ̀lɔ̀ɔbɔ̀lɔ́ɔ́_456">
    <lexical-unit><form lang="kqs"><text>bɔ̀lɔ̀ɔbɔ̀lɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀lɔ̀ɔbɔ̀lɔ́ɔ́_456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>période de décembre (débroussaillage des champs)</text></gloss>
      <gloss lang="en"><text>around December (time of clearing fields)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 26: bɔ̀lɔ̀ɔbɔ̀lɔ́ɔ́</text></form></note>
  </entry>
  <entry id="bɔlɔɔn_457">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔɔn_457_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chapelet</text></gloss>
      <gloss lang="en"><text>prayer beads</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Bölöön; Lexique kissi–français, p. 7: bɔlɔɔn</text></form></note>
  </entry>
  <entry id="bɔlɔɲɛmsɛvaan_458">
    <lexical-unit><form lang="kqs"><text>bɔlɔɲɛmsɛvaan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔɲɛmsɛvaan_458_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écritoire</text></gloss>
      <gloss lang="en"><text>writing desk</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 140: Bölönyèmsèvaan</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="bɔmbille_459">
    <lexical-unit><form lang="kqs"><text>bɔmbille</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔmbillo</text></form></field>
    <variant><form lang="kqs"><text>bɔmbillu</text></form></variant>
    <sense id="bɔmbille_459_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cloche (lame de fer aux côtés incurvés)</text></gloss>
      <gloss lang="en"><text>bell (iron blade with curved sides)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔmbille /sing./, bɔmbillo /pl./, bɔmbillu</text></form></note>
    <note><form lang="fr"><text>Paulme : dans le Dembaduno ; = kɛnde du Kouroumandou.</text></form></note>
  </entry>
  <entry id="bɔ̀mbillon_460">
    <lexical-unit><form lang="kqs"><text>bɔ̀mbillon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔ̀mbillon_460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'instrument de musique</text></gloss>
      <gloss lang="en"><text>a kind of musical instrument</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a metal percussion instrument, a slit pipe struck with a stick</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first NEH.12.27; Childs 2000, p. 27: bɔ̀mbìllé</text></form></note>
    <note><form lang="fr"><text>Pluriel ; cité avec les cymbales (kɛŋun) et les harpes (bangalan) (NEH.12.27).</text></form></note>
  </entry>
  <entry id="bɔmboɲe_461">
    <lexical-unit><form lang="kqs"><text>bɔmboɲe</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔmboɲoo</text></form></field>
    <sense id="bɔmboɲe_461_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grelot sphérique en cuivre</text></gloss>
      <gloss lang="en"><text>spherical copper bell</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 11: bɔmbonye, pl. bɔmbonyō</text></form></note>
    <note><form lang="fr"><text>Paulme : cf. malinké bomboni.</text></form></note>
  </entry>
  <entry id="bɔ̀mbɔ̀làá_462">
    <lexical-unit><form lang="kqs"><text>bɔ̀mbɔ̀làá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀mbɔ̀làá_462_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>traîner, être retardé, aller lentement</text></gloss>
      <gloss lang="en"><text>be delayed, go slowly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ̀mbɔ̀làá</text></form></note>
  </entry>
  <entry id="bɔmbɔniyo_463">
    <lexical-unit><form lang="kqs"><text>bɔmbɔniyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔmbɔniyo_463_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bonbonne</text></gloss>
      <gloss lang="en"><text>demijohn, large bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Bömböniyo; Lexique kissi–français, p. 7: bɔnbɔniyo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; la Bible écrit mb (bambɛi).</text></form></note>
  </entry>
  <entry id="bɔ̀mbɔ́ŋndó_464">
    <lexical-unit><form lang="kqs"><text>bɔ̀mbɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀mbɔ́ŋndó_464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bonbon (de l'idéophone bɔ̂ŋ, joues creusées en suçant)</text></gloss>
      <gloss lang="en"><text>candy (from the ideophone for sucking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ̀mbɔ́ŋndó</text></form></note>
  </entry>
  <entry id="bɔ̀mbɔ̀ɔ́_465">
    <lexical-unit><form lang="kqs"><text>bɔ̀mbɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀mɔ̀láŋ</text></form></field>
    <sense id="bɔ̀mbɔ̀ɔ́_465_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forêt secondaire, fourré sur une ancienne jachère</text></gloss>
      <gloss lang="en"><text>secondary forest, thicket on an old farm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ̀mbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔmɔɔ_466">
    <lexical-unit><form lang="kqs"><text>bɔmɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔmɔɔ_466_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tante</text></gloss>
      <gloss lang="en"><text>aunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>father's sister; also a spirit of the female initiation society</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bömöö; Lexique kissi–français, p. 7: bɔmɔɔ; Childs 2000, p. 27: bɔ́mɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔndii_467">
    <lexical-unit><form lang="kqs"><text>bɔndii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔndii_467_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charge, fardeau</text></gloss>
      <gloss lang="en"><text>load, burden</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>head load wrapped in cloth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.22.17; Childs 2000, p. 27: bɔ́ndìíyó</text></form></note>
    <note><form lang="fr"><text>bɔndii nuu connun fefele « mon fardeau est léger » (MAT.11.30).</text></form></note>
  </entry>
  <entry id="bɔ̀ndóó_468">
    <lexical-unit><form lang="kqs"><text>bɔ̀ndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀ndúláŋ</text></form></field>
    <sense id="bɔ̀ndóó_468_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cambrure des reins (argot)</text></gloss>
      <gloss lang="en"><text>curvature of the lower back (slang)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 27: bɔ̀ndóó</text></form></note>
  </entry>
  <entry id="bɔnɔɔ_469">
    <lexical-unit><form lang="kqs"><text>bɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔnɔ</text></form></variant>
    <variant><form lang="kqs"><text>bɔnɔla</text></form></variant>
    <sense id="bɔnɔɔ_469_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amende, dédommagement ; tribut ; frais ; indemnité</text></gloss>
      <gloss lang="en"><text>fine, compensation; tribute; cost; indemnity, compensation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.21.22; Terminologie (histoire), n° 391: Bönöö, köndöö, kollo</text></form></note>
    <note><form lang="fr"><text>luɛi bɔnɔ « payer une amende » (Ex 22,16). Académie des langues (terminologie, histoire n° 391-393) : « indemnité » ; bɔnɔɔ vuuo « indemniser » ; bɔnɔlueiyaa « indemnisation » (aussi kollo yɔngoo). Académie des langues (terminologie, histoire n° 525) : « redevance » (aussi koeu). Académie des langues (terminologie, histoire n° 563) : bɔnɔ lueyaa « sanction ». Académie des langues (terminologie, idéologie n° 571) : « sanction » (aussi tɔŋndo pionaɔɔ).</text></form></note>
  </entry>
  <entry id="bɔsoo_470">
    <lexical-unit><form lang="kqs"><text>bɔsoo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɔsoo_470_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paire de petits hochets sphériques (coque du fruit du tubɔra)</text></gloss>
      <gloss lang="en"><text>pair of small spherical rattles (shell of the tubɔra fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 12 (G): bɔzō /G./</text></form></note>
    <note><form lang="fr"><text>Paulme : on en joue d'une main en les faisant s'entrechoquer. Paulme écrit z, lettre absente de la Bible ; respelled avec s, à confirmer.</text></form></note>
  </entry>
  <entry id="bɔsɔ_471">
    <lexical-unit><form lang="kqs"><text>bɔsɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔsɔ_471_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amulette de guerre (rend invulnérable)</text></gloss>
      <gloss lang="en"><text>war amulet (makes invulnerable)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 12: bɔsɔ</text></form></note>
  </entry>
  <entry id="bɔsɔkunio_472">
    <lexical-unit><form lang="kqs"><text>bɔsɔkunio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔsɔkunio_472_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit oiseau noir et blanc joueur (nid au sommet des arbres)</text></gloss>
      <gloss lang="en"><text>small playful black and white bird (nests in treetops)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 12: bɔsɔkunio; Childs 2000, p. 30: bɔ̀ɔ́sɔ̀ɔ́-kùèndóó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par Paulme 1964, p. 12 (bɔsɔkunio « petit oiseau blanc et noir, fait son nid avec le coton des champs » ; pl. bɔsɔkunya, animal totémique dans le Sud).</text></form></note>
  </entry>
  <entry id="bɔtà_473">
    <lexical-unit><form lang="kqs"><text>bɔtà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔtà_473_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poison ; empoisonner</text></gloss>
      <gloss lang="en"><text>poison; to poison</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first AMO.6.12; Paulme 1964, p. 12: bɔta, pl. bɔtarã</text></form></note>
    <note><form lang="fr"><text>Paulme : pl. bɔtarã ; o bɔta wando « il a empoisonné un homme ». Dans la Bible, AMO.6.12 « vous avez changé le droit en poison ». Cf. pɔsɔnio « poison » (Lexique).</text></form></note>
  </entry>
  <entry id="bɔtáà_474">
    <lexical-unit><form lang="kqs"><text>bɔtáà</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bɔtáà_474_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poing</text></gloss>
      <gloss lang="en"><text>fist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.21.18; Keita 1979, p. 131: Bötaa; Lexique kissi–français, p. 8: bɔtaa; Childs 2000, p. 30: bɔ̀táá</text></form></note>
    <note><form lang="fr"><text>À distinguer de bɔ̀tàá « poison, amertume » (Dt 29,17 ; 2R 4,40).</text></form></note>
  </entry>
  <entry id="bɔtan_475">
    <lexical-unit><form lang="kqs"><text>bɔtan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔtan_475_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>culte (région de Kossa, Yende)</text></gloss>
      <gloss lang="en"><text>cult (Kossa area, Yende)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 12: bɔtã</text></form></note>
    <note><form lang="fr"><text>Paulme : « nom d'un culte ».</text></form></note>
  </entry>
  <entry id="bɔ̀úléŋ_476">
    <lexical-unit><form lang="kqs"><text>bɔ̀úléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀úwé</text></form></field>
    <sense id="bɔ̀úléŋ_476_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de champignon ; aubergine</text></gloss>
      <gloss lang="en"><text>species of mushroom; eggplant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 30: bɔ̀úléŋ</text></form></note>
  </entry>
  <entry id="bɔ́wvo_477">
    <lexical-unit><form lang="kqs"><text>bɔ́wvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bɔ́wvo_477_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argile ; teinture naturelle (?)</text></gloss>
      <gloss lang="en"><text>clay; natural dye (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JOB.4.19; Lexique kissi–français, p. 8: bɔwvo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, bɔ́wvo désigne l'argile (JOB.4.19, JOB.10.9, PRO.26.23). Le Lexique lui donne la même glose incertaine qu'à beɔlen (« une teinture naturelle ou de la marché ? »).</text></form></note>
  </entry>
  <entry id="bɔ̂ŋ_478">
    <lexical-unit><form lang="kqs"><text>bɔ̂ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̂ŋ_478_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>joues fortement creusées (en suçant) ; ventre rentré</text></gloss>
      <gloss lang="en"><text>cheeks strongly sucked in; stomach drawn in</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ̂ŋ</text></form></note>
  </entry>
  <entry id="bɔŋaa_479">
    <lexical-unit><form lang="kqs"><text>bɔŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔŋa</text></form></variant>
    <variant><form lang="kqs"><text>bɔŋan</text></form></variant>
    <sense id="bɔŋaa_479_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rencontrer, aller à la rencontre de ; accueillir</text></gloss>
      <gloss lang="en"><text>meet, go to meet; welcome</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring together, join, cover; be sufficient</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first GEN.14.17; Keita 1979, p. 110: Bönhaa; Lexique kissi–français, p. 8: bɔŋaa/ bɔŋa; Terminologie (idéologie), n° 549: Bönhaa; Childs 2000, p. 28: bɔ̀ŋàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 7-8 : « rencontrer, accueillir (G.) ». Académie des langues (terminologie, idéologie n° 549) : « réception ».</text></form></note>
  </entry>
  <entry id="bɔŋallo_480">
    <lexical-unit><form lang="kqs"><text>bɔŋallo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔŋallo_480_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accueillir pour quelqu'un</text></gloss>
      <gloss lang="en"><text>meet, welcome for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meet for someone, bring together for</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bönhallo; Lexique kissi–français, p. 8: bɔŋallo/ bɔŋal; Childs 2000, p. 28: bɔ̀ŋàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de bɔŋaa.</text></form></note>
  </entry>
  <entry id="bɔŋan_481">
