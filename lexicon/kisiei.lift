      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 290: páù</text></form></note>
  </entry>
  <entry id="paw pulen_2993">
