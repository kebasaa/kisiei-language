  <entry id="kpúŋmgbúlúŋ_1984">
    <lexical-unit><form lang="kqs"><text>kpúŋmgbúlúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpúŋmgbúlúŋ_1984_s1">
      <grammatical-info value="Ideophone"/>
