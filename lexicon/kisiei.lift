  <entry id="koŋɔɔ_1491">
    <lexical-unit><form lang="kqs"><text>koŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>koaŋ</text></form></variant>
    <variant><form lang="kqs"><text>koŋ</text></form></variant>
    <variant><form lang="kqs"><text>koaŋnin</text></form></variant>
    <sense id="koŋɔɔ_1491_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper, battre, vaincre ; (koaŋ balan) battre des mains</text></gloss>
      <gloss lang="en"><text>strike, beat, defeat; (koaŋ balan) clap one's hands</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also cultivate, break up clods; beat, flog</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.1.44; Childs 2000, p. 177: kòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>koaŋ nda koŋɔɔ pila « il leur infligea une grande défaite » (Jg 8,16).</text></form></note>
  </entry>
