      <gloss lang="fr"><text>charger (sur quelqu'un) ; (siilun) porter (sur soi)</text></gloss>
      <gloss lang="en"><text>load (onto someone); (siilun) carry, take up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
