    <variant><form lang="kqs"><text>siimanndo</text></form></variant>
    <sense id="siiman_1450_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>égaler, être comparable à</text></gloss>
      <gloss lang="en"><text>be equal to, be comparable to</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.9.14; Childs 2000, p. 332: sììmăŋndó</text></form></note>
    <note><form lang="fr"><text>vana-vana siiman a Hala le « nul n'est semblable à Dieu » (Dt 33,26).</text></form></note>
  </entry>
