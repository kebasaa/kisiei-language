      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mùɛ̀-fàŋndé</text></form></note>
  </entry>
  <entry id="mùɛ̀ìmà-nɛ̀ìyáŋ_2303">
    <lexical-unit><form lang="kqs"><text>mùɛ̀ìmà-nɛ̀ìyáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="mùɛ̀ìmà-nɛ̀ìyáŋ_2303_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>whisky (« liqueur forte »)</text></gloss>
      <gloss lang="en"><text>whiskey ('strong liquor')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mùɛ̀ìmà-nɛ̀ìyáŋ</text></form></note>
  </entry>
  <entry id="mùɛ̀ìyáŋ_2304">
    <lexical-unit><form lang="kqs"><text>mùɛ̀ìyáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="mùɛ̀ìyáŋ_2304_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>culpabilité ; (cìŋàá mùɛ̀ìyáŋ) plaider non coupable</text></gloss>
      <gloss lang="en"><text>guilt; (cìŋàá mùɛ̀ìyáŋ) plead innocence</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 254: mùɛ̀ìyáŋ</text></form></note>
    <note><form lang="fr"><text>Homonyme de mùɛ̀ìyáŋ « boisson alcoolisée » (cf. mɔiyan « vin », Bible) : autrefois on offrait de l'alcool au chef pour faire juger une affaire.</text></form></note>
  </entry>
  <entry id="muɛɛn_2305">
    <lexical-unit><form lang="kqs"><text>muɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="muɛɛn_2305_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, tous sans exception</text></gloss>
      <gloss lang="en"><text>completely, every one</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>all, completely</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JDG.5.31; Childs 2000, p. 253: múɛ́ɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : màá yaamɔaa nɔmnda cuu lende muɛɛn « que tous tes ennemis périssent ainsi » (JDG.5.31).</text></form></note>
  </entry>
  <entry id="múɛ̀ɛ̀ŋ_2306">
    <lexical-unit><form lang="kqs"><text>múɛ̀ɛ̀ŋ</text></form></lexical-unit>
