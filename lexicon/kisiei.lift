      <gloss lang="fr"><text>gargouillement (bruit dans le ventre)</text></gloss>
      <gloss lang="en"><text>rumbling of the stomach</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: kutu</text></form></note>
  </entry>
  <entry id="kútù-kùtù_2753">
    <lexical-unit><form lang="kqs"><text>kútù-kùtù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kútù-kùtù_2753_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>gargouillement du ventre (diarrhée)</text></gloss>
      <gloss lang="en"><text>rumbling of the stomach (diarrhoea)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 197: kútù-kùtù</text></form></note>
  </entry>
  <entry id="kuubanɔ_2754">
    <lexical-unit><form lang="kqs"><text>kuubanɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kuubaa</text></form></field>
    <sense id="kuubanɔ_2754_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guerrier vaillant, héros</text></gloss>
      <gloss lang="en"><text>mighty warrior, hero</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first EXO.15.3; Terminologie (histoire), n° 372: Kubanö</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 372) : kubanɔ « guerrier ».</text></form></note>
  </entry>
  <entry id="kuubanɔɔ_2755">
    <lexical-unit><form lang="kqs"><text>kuubanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kuubaa</text></form></field>
    <sense id="kuubanɔɔ_2755_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>héros, guerrier vaillant</text></gloss>
      <gloss lang="en"><text>hero, valiant warrior</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>warrior with magical powers who could capture villages</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.6.12; Keita 1979, p. 156: Kuubanöö; Lexique kissi–français, p. 31: kuubanɔɔ; Childs 2000, p. 197: kúúbánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kùùcùkúúcóó_2756">
    <lexical-unit><form lang="kqs"><text>kùùcùkúúcóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kùùcùkúúcúá</text></form></field>
    <sense id="kùùcùkúúcóó_2756_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termite (termite-lion)</text></gloss>
      <gloss lang="en"><text>termite (lion termite)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 197: kùùcùkúúcóó kùùcùkúúcúá</text></form></note>
  </entry>
  <entry id="kùùlen_2757">
    <lexical-unit><form lang="kqs"><text>kùùlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="kùùlen_2757_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri, hutte ; soufflet de forge</text></gloss>
      <gloss lang="en"><text>shelter, booth; bellows</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.4.6; Keita 1979, p. 159: Kuulen; Childs 2000, p. 198: kùúléŋ</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, kùùlen est un abri, une hutte (Is 4,6 ; Jon 4,5 ; pl. kùùlan, Gn 33,17). Keita et Childs donnent « soufflet » ; peut-être deux mots de tons différents.</text></form></note>
  </entry>
  <entry id="kuuliaa_2758">
    <lexical-unit><form lang="kqs"><text>kuuliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuuliaa_2758_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rugir ; gronder (tonnerre)</text></gloss>
      <gloss lang="en"><text>roar; thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shout (plural of kùlàá 'shout, cheer')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first DEU.32.10; Childs 2000, p. 198: kùùlìá</text></form></note>
  </entry>
  <entry id="kuumbuu_2759">
    <lexical-unit><form lang="kqs"><text>kuumbuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuumbun</text></form></variant>
    <variant><form lang="kqs"><text>kuumbuan</text></form></variant>
    <sense id="kuumbuu_2759_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recouvrir, étendre sur</text></gloss>
      <gloss lang="en"><text>cover over, spread over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.9.23; Childs 2000, p. 198: kùùmbùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel (intensif) de kumbɔɔ « couvrir ».</text></form></note>
  </entry>
  <entry id="kuumiaa_2760">
    <lexical-unit><form lang="kqs"><text>kuumiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuumiaanin</text></form></variant>
    <sense id="kuumiaa_2760_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bourgeonner, pousser des bourgeons</text></gloss>
      <gloss lang="en"><text>bud, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.40.10</text></form></note>
  </entry>
  <entry id="kuunaa_2761">
    <lexical-unit><form lang="kqs"><text>kuunaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuuna</text></form></variant>
    <variant><form lang="kqs"><text>kuunan</text></form></variant>
    <sense id="kuunaa_2761_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interdire, défendre</text></gloss>
      <gloss lang="en"><text>forbid</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stop, prevent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first NUM.22.22; Lexique kissi–français, p. 31: kuunaa; Terminologie (histoire), n° 2: Kuunaa; Childs 2000, p. 198: kùùnàá</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 2 et 5) : « abolition, abolir ».</text></form></note>
  </entry>
  <entry id="kuundiaa_2762">
    <lexical-unit><form lang="kqs"><text>kuundiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuundiaa_2762_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agrandir ; élever, honorer</text></gloss>
      <gloss lang="en"><text>enlarge; exalt, honour</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make big, fatten (plural of kùndàá 'be plentiful')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.12.20; Terminologie (histoire), n° 35: Hungulaa, kuundiaa, työöloo; Childs 2000, p. 198: kùùndìá</text></form></note>
    <note><form lang="fr"><text>Base de kuundian « s'enorgueillir ». lɛŋnde niaalen kuundiaa « agrandir votre territoire » (Dt 12,20). Académie des langues (terminologie, histoire n° 35) : « agrandir ».</text></form></note>
  </entry>
  <entry id="kuundian_2763">
    <lexical-unit><form lang="kqs"><text>kuundian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuundianndo</text></form></variant>
    <sense id="kuundian_2763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'enorgueillir, être arrogant ; orgueil</text></gloss>
      <gloss lang="en"><text>be proud, be arrogant; pride</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first DEU.29.18</text></form></note>
  </entry>
  <entry id="kuundo_2764">
    <lexical-unit><form lang="kqs"><text>kuundo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kuunta</text></form></field>
    <sense id="kuundo_2764_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charge de paille (une dizaine de bottes)</text></gloss>
      <gloss lang="en"><text>load of straw (about ten bundles)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: kūndo, pl. kūnta</text></form></note>
    <note><form lang="fr"><text>Paulme : environ 10 kg, 10 bottes.</text></form></note>
  </entry>
  <entry id="kuundoo_2765">
    <lexical-unit><form lang="kqs"><text>kuundoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuundoo_2765_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>butte, tertre (pour le maïs, etc.)</text></gloss>
      <gloss lang="en"><text>mound, ridge (for maize etc.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: kuundoo</text></form></note>
  </entry>
  <entry id="kuupepelan_2766">
    <lexical-unit><form lang="kqs"><text>kuupepelan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="respelled"/>
    <sense id="kuupepelan_2766_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oreillons</text></gloss>
      <gloss lang="en"><text>mumps</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Kuupepelan; Lexique kissi–français, p. 31: kuupepelan</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 30 : aussi kupeperan « oreillon ».</text></form></note>
  </entry>
  <entry id="kuusuo_2767">
    <lexical-unit><form lang="kqs"><text>kuusuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kuusu</text></form></variant>
    <sense id="kuusuo_2767_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vomir</text></gloss>
      <gloss lang="en"><text>vomit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>vomit, retch</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kuusuo; Paulme 1964, p. 53: kusuo; Lexique kissi–français, p. 31: kuusuo/ kuusu; Childs 2000, p. 192: kùìsìó</text></form></note>
    <note><form lang="fr"><text>La Bible a kuusuu « vomissure » (ISA 19,14 ; JER 48,26). Paulme 1964, p. 53 : kusuo « vomir, vomissement » (mo kusu kwandye « il vomit les patates »).</text></form></note>
  </entry>
  <entry id="kuusuu_2768">
    <lexical-unit><form lang="kqs"><text>kuusuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuusuu_2768_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vomissure</text></gloss>
      <gloss lang="en"><text>vomit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.19.14</text></form></note>
    <note><form lang="fr"><text>Cf. kuisio « vomir ».</text></form></note>
  </entry>
  <entry id="kuuvo_2769">
    <lexical-unit><form lang="kqs"><text>kuuvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kuuvo_2769_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joue</text></gloss>
      <gloss lang="en"><text>cheek</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cheek, jaw</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.24.20; Keita 1979, p. 131: Kuuvo; Childs 2000, p. 200: kùúwó</text></form></note>
    <note><form lang="fr"><text>Kuula nɔmndan « tes joues » (Ct 1,10). Homographe : kuuvo, kùùlan « hutte, cabane » (Is 24,20 ; Ne 8,16).</text></form></note>
  </entry>
  <entry id="kùùwàá_2770">
    <lexical-unit><form lang="kqs"><text>kùùwàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kùùwàá_2770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bégayer ; tergiverser</text></gloss>
      <gloss lang="en"><text>stutter, stammer; delay</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 200: kùùwàá</text></form></note>
  </entry>
  <entry id="kùúwé_2771">
    <lexical-unit><form lang="kqs"><text>kùúwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="kùúwé_2771_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>miette de riz (qui tombe de la main avant la bouche), reste</text></gloss>
      <gloss lang="en"><text>crumb of rice (falling from the hand before the mouth), morsel</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 200: kùúwé</text></form></note>
  </entry>
  <entry id="kùùyùkùùyú-_2772">
    <lexical-unit><form lang="kqs"><text>kùùyùkùùyú-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kùùyùkùùyú-_2772_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grossièrement, n'importe comment (marche)</text></gloss>
      <gloss lang="en"><text>roughly, crudely, sloppily (of walking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.1 Adjectives"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 200: kùùyùkùùyú-</text></form></note>
  </entry>
  <entry id="kùúŋkùúŋndó_2773">
    <lexical-unit><form lang="kqs"><text>kùúŋkùúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kùúŋkùúŋndó_2773_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil arboricole</text></gloss>
      <gloss lang="en"><text>tree squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 199: kùúŋkùúŋndó</text></form></note>
  </entry>
  <entry id="kúùŋndó_2774">
    <lexical-unit><form lang="kqs"><text>kúùŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kúùŋndó_2774_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>butte, planche de culture, pépinière</text></gloss>
      <gloss lang="en"><text>mound, garden bed, nursery</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 199: kúùŋndó</text></form></note>
    <note><form lang="fr"><text>Cf. kungulaa « butter, faire des buttes » (Keita).</text></form></note>
  </entry>
  <entry id="kuvaa_2775">
    <lexical-unit><form lang="kqs"><text>kuvaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kuva</text></form></variant>
    <sense id="kuvaa_2775_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bégayer</text></gloss>
      <gloss lang="en"><text>stammer</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: kuvaa/ kuva</text></form></note>
  </entry>
  <entry id="kuwvo_2776">
    <lexical-unit><form lang="kqs"><text>kuwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kuo</text></form></variant>
    <sense id="kuwvo_2776_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joue ; soufflet (de forge)</text></gloss>
      <gloss lang="en"><text>cheek; bellows</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: kuwvo</text></form></note>
    <note><form lang="fr"><text>Lexique p. 30 : kuo « la joue ; la soufflerie » ; p. 31 : kuwvo « la joue ».</text></form></note>
  </entry>
  <entry id="kuya_2777">
    <lexical-unit><form lang="kqs"><text>kuya</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuya_2777_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en reste, laissé pour le lendemain (nourriture)</text></gloss>
      <gloss lang="en"><text>left over, kept overnight (food)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(of food) left standing in a container for a while, stale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.12.10; Childs 2000, p. 201: kúyá-</text></form></note>
    <note><form lang="fr"><text>Te ɲɛ lɔl pɛ kuya « s'il en reste jusqu'au matin » (EXO.12.10) ; ma de kuya kon te « qu'on ne mange pas ce reste » (EXO.29.34).</text></form></note>
  </entry>
  <entry id="kuŋa_2778">
    <lexical-unit><form lang="kqs"><text>kuŋa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuŋa_2778_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enclore, faire une clôture</text></gloss>
      <gloss lang="en"><text>fence in</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: kuŋa</text></form></note>
    <note><form lang="fr"><text>Paulme : i kuŋa malo « j'ai enclos (le champ de) riz ».</text></form></note>
  </entry>
  <entry id="kuŋa_2779">
    <lexical-unit><form lang="kqs"><text>kuŋa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kuŋala</text></form></field>
    <sense id="kuŋa_2779_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palissade (en bambou ou en roseau)</text></gloss>
      <gloss lang="en"><text>fence (of bamboo or reed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: kuŋa, pl. kuŋara</text></form></note>
  </entry>
  <entry id="kuŋaa_2780">
    <lexical-unit><form lang="kqs"><text>kuŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kuŋa</text></form></variant>
    <sense id="kuŋaa_2780_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper avec un objet émoussé (plat du coupe-coupe) ; être à bout de forces, incapable de finir ; frapper violemment avec le poing</text></gloss>
      <gloss lang="en"><text>strike with something dull (flat of a cutlass); be exhausted, unable to finish; punch hard</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kuŋaa/ kuŋa; Childs 2000, p. 196: kùŋàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 30 (« frapper violemment avec le poing »).</text></form></note>
  </entry>
  <entry id="kúŋgúmáá_2781">
    <lexical-unit><form lang="kqs"><text>kúŋgúmáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kúŋgúmáá_2781_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animal fouisseur semblable au crocodile ; personnage d'une société secrète</text></gloss>
      <gloss lang="en"><text>burrowing crocodile-like animal; secret-society personage</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 196: kúŋgúmáá</text></form></note>
  </entry>
  <entry id="kuŋndan_2782">
    <lexical-unit><form lang="kqs"><text>kuŋndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kuŋ</text></form></variant>
    <variant><form lang="kqs"><text>kuŋndo</text></form></variant>
    <sense id="kuŋndan_2782_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gémir ; mugir, gronder (mer, pluie) ; (… te) ne pas dire mot</text></gloss>
      <gloss lang="en"><text>groan; roar (sea, rain); (… te) make no sound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grunt, groan; also a grunt of assent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.16.11; Lexique kissi–français, p. 30: kuŋɔɔ/ kuŋ; Childs 2000, p. 197: kùŋndó</text></form></note>
    <note><form lang="fr"><text>kuŋndan et kuŋndo servent de forme longue : a va kuŋndan « ils gémissaient » (Ex 2,23) ; mɛmma … và kuŋndo « les eaux qui grondent » (Ez 1,24) ; Yakɔb kuŋ te « Jacob se tut » (Gn 34,5). Lexique kissi–français, p. 30 : kuŋɔɔ/ kuŋ « gémir, pousser des cris de souffrance ».</text></form></note>
  </entry>
  <entry id="kúŋndo_2783">
    <lexical-unit><form lang="kqs"><text>kúŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kúŋndo_2783_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cruche, jarre (à huile)</text></gloss>
      <gloss lang="en"><text>jar, jug (for oil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1KI.17.12</text></form></note>
    <note><form lang="fr"><text>Écrit kúŋndo ; ne pas confondre avec kuŋndo « grondement » (voir kuŋndan).</text></form></note>
  </entry>
  <entry id="kuŋoma_2784">
    <lexical-unit><form lang="kqs"><text>kuŋoma</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuŋoma_2784_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand varan</text></gloss>
      <gloss lang="en"><text>large monitor lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: kuŋoma, pl. kuŋoma</text></form></note>
  </entry>
  <entry id="kùŋɔ̀ɔ́_2785">
    <lexical-unit><form lang="kqs"><text>kùŋɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kùŋèláŋ</text></form></field>
    <sense id="kùŋɔ̀ɔ́_2785_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>partie de l'animal mise à nu quand on le dépouille</text></gloss>
      <gloss lang="en"><text>part of an animal exposed when it is skinned</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 197: kùŋɔ̀ɔ́ kùŋèláŋ</text></form></note>
  </entry>
  <entry id="kuɔn_2786">
    <lexical-unit><form lang="kqs"><text>kuɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuɔn_2786_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collier de cauris (magique, donne la santé)</text></gloss>
      <gloss lang="en"><text>cowrie necklace (magical, gives health)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: kuɔ̃</text></form></note>
    <note><form lang="fr"><text>Paulme renvoie à kɔwã. Cf. koon « cauris ».</text></form></note>
  </entry>
  <entry id="kuɛi_2787">
    <lexical-unit><form lang="kqs"><text>kuɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="kuɛi_2787_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pauvreté, misère</text></gloss>
      <gloss lang="en"><text>poverty, hardship</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>poverty, hardship, heavy toil</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first LEV.25.25; Childs 2000, p. 191: kùéí</text></form></note>
    <note><form lang="fr"><text>Te kuɛi tol pɛ puapilɛ niaa coo « si ton frère devient pauvre » (litt. « si la pauvreté tombe sur… », LEV.25.25).</text></form></note>
  </entry>
  <entry id="kuɛlo_2788">
    <lexical-unit><form lang="kqs"><text>kuɛlo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kuɛlo_2788_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>panthère</text></gloss>
      <gloss lang="en"><text>leopard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 50: kuɛlo</text></form></note>
    <note><form lang="fr"><text>Cf. tambillo-kuello « panthère » (Lexique) ; la Bible dit tambillo.</text></form></note>
  </entry>
  <entry id="kuɛo_2789">
    <lexical-unit><form lang="kqs"><text>kuɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kuɛo_2789_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rapace (plus grand que le kundo, épervier ?)</text></gloss>
      <gloss lang="en"><text>bird of prey (larger than the kundo; sparrowhawk?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 50: kuɛo</text></form></note>
  </entry>
  <entry id="kuɛɛ_2790">
    <lexical-unit><form lang="kqs"><text>kuɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kuɛɛ_2790_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>où ? quel ?</text></gloss>
      <gloss lang="en"><text>where? which?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 236 occurrences, first GEN.3.9; Childs 2000, p. 191: kùɛ́ɛ́</text></form></note>
  </entry>
  <entry id="kɔ_2791">
    <lexical-unit><form lang="kqs"><text>kɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kɔ_2791_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>où ? ; quel, quelle ?</text></gloss>
      <gloss lang="en"><text>where?; which?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 46: kɔ̄; Lexique kissi–français, p. 26: kɔ</text></form></note>
    <note><form lang="fr"><text>Lexique p. 26 : « ou? » et « quel, quelle ». Homographe de kɔ « aller » ; cf. kuɛɛ « où ? quel ? ». Paulme 1964, p. 46 : kɔ̄ … nɛ « où ? » (kɔ̄ Musa tye nɛ « où est Musa ? », kɔɔ̄ fure nɛ « d'où sors-tu ? »).</text></form></note>
  </entry>
  <entry id="kɔ́_2792">
    <lexical-unit><form lang="kqs"><text>kɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ́_2792_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>coup frappé</text></gloss>
      <gloss lang="en"><text>knock, hit</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 181: kɔ́</text></form></note>
  </entry>
  <entry id="kɔandaa_2793">
    <lexical-unit><form lang="kqs"><text>kɔandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔandu</text></form></variant>
    <variant><form lang="kqs"><text>kɔandunin</text></form></variant>
    <sense id="kɔandaa_2793_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>puiser (de l'eau) ; ramasser, emporter</text></gloss>
      <gloss lang="en"><text>draw (water); scoop up, carry off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.25.38</text></form></note>
    <note><form lang="fr"><text>bombola kɔandaa lapultan « pelles à cendres » (Ex 27,3). Proche de kɔndɔɔ.</text></form></note>
  </entry>
  <entry id="kɔannan_2794">
    <lexical-unit><form lang="kqs"><text>kɔannan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔannan_2794_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étendue, largeur ; (o kɔannan) étendu, vaste</text></gloss>
      <gloss lang="en"><text>breadth, extent; (o kɔannan) spread out, wide</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.34.21</text></form></note>
    <note><form lang="fr"><text>lɛŋnden le co le kɔannan kɛ́-kɛ̀ « le pays est assez vaste » (Gn 34,21).</text></form></note>
  </entry>
  <entry id="kɔannun_2795">
    <lexical-unit><form lang="kqs"><text>kɔannun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔannun_2795_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'en aller (avec), emmener ; poursuivre (… kɔɔli)</text></gloss>
      <gloss lang="en"><text>go off (with), take away; pursue (… kɔɔli)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 169 occurrences, first GEN.13.14</text></form></note>
    <note><form lang="fr"><text>Moyen de kɔlan « aller ».</text></form></note>
  </entry>
  <entry id="kɔbi_2796">
    <lexical-unit><form lang="kqs"><text>kɔbi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔbi_2796_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fruit de l'arbre kɔyo (huile amère pour les soins du corps)</text></gloss>
      <gloss lang="en"><text>fruit of the kɔyo tree (bitter oil used on the body)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 46: kɔbi</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 46 : on en tire une huile très amère, utilisée pour les soins du corps, mais non dans la cuisine ; kɔbi tulu « huile du kɔbi » (malinké), kowo (K.).</text></form></note>
  </entry>
  <entry id="kɔ́cù_2797">
    <lexical-unit><form lang="kqs"><text>kɔ́cù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ́cù_2797_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>coup frappé ; égratignure profonde</text></gloss>
      <gloss lang="en"><text>knock; deep scratch</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 181: kɔ́cù</text></form></note>
  </entry>
  <entry id="kɔduuvo_2798">
    <lexical-unit><form lang="kqs"><text>kɔduuvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔduuvo_2798_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coupe-coupe</text></gloss>
      <gloss lang="en"><text>machete</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Köduuvo; Lexique kissi–français, p. 26: kɔduwvo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 25-26 : kɔduwvo « le coupe-coupe », koduo « la machette ».</text></form></note>
  </entry>
  <entry id="kɔ̀fòó_2799">
    <lexical-unit><form lang="kqs"><text>kɔ̀fòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀fòó_2799_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermenter, pourrir</text></gloss>
      <gloss lang="en"><text>ferment, rot</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 181: kɔ̀fòó</text></form></note>
  </entry>
