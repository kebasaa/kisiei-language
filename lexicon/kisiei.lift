      <gloss lang="fr"><text>debout</text></gloss>
      <gloss lang="en"><text>standing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 208 occurrences, first GEN.18.2; Lexique kissi–français, p. 20: isisi</text></form></note>
  </entry>
