      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 581: Bandötyooyèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="bandɛo_126">
    <lexical-unit><form lang="kqs"><text>bandɛo</text></form></lexical-unit>
