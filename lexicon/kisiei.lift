    <note><form lang="fr"><text>Homographe : kafalan « embrasser, serrer dans ses bras » (Gn 33,4).</text></form></note>
  </entry>
  <entry id="kafoo_443">
    <lexical-unit><form lang="kqs"><text>kafoo</text></form></lexical-unit>
