  <entry id="fulal_903">
    <lexical-unit><form lang="kqs"><text>fulal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fulal-le</text></form></variant>
    <sense id="fulal_903_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apparaître à, se montrer à ; surgir contre, tomber sur (l'ennemi)</text></gloss>
      <gloss lang="en"><text>appear to; come out against, fall upon (an enemy)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go out for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first JDG.6.12; Childs 2000, p. 111: fùlàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de fula « sortir ». mɛlɛkanɔ Hala-o fulal laa ndɔ « l'ange de Dieu apparut à la femme » (JDG.13.3) ; fulal nda fɛlɛmɛndɛn a cɔwvo « il fondit sur eux » (JDG.9.43).</text></form></note>
  </entry>
