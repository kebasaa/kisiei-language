    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 147: kándùáŋ kándùléŋ</text></form></note>
  </entry>
  <entry id="kándùléŋ_1952">
    <lexical-unit><form lang="kqs"><text>kándùléŋ</text></form></lexical-unit>
