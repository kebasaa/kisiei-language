  <entry id="sabu_1393">
    <lexical-unit><form lang="kqs"><text>sabu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sabu_1393_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cause, raison ; (le sabu yɛɛ) pourquoi ; (le sabu kon) c'est pourquoi</text></gloss>
      <gloss lang="en"><text>cause, reason; (le sabu yɛɛ) why; (le sabu kon) therefore</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>reason, cause, meaning; also an act of kindness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.20.17; Childs 2000, p. 318: sábòó</text></form></note>
  </entry>
