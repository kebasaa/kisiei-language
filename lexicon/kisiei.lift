  <entry id="yɛngɔnndo_6354">
    <lexical-unit><form lang="kqs"><text>yɛngɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛngun</text></form></variant>
    <sense id="yɛngɔnndo_6354_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pencher, se pencher</text></gloss>
