  <entry id="fɛlɔɔ_472">
    <lexical-unit><form lang="kqs"><text>fɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɛlɛ</text></form></variant>
    <sense id="fɛlɔɔ_472_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>van</text></gloss>
      <gloss lang="en"><text>winnowing tray</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1CO.10.13; Keita 1979, p. 159: Fèlöö</text></form></note>
    <note><form lang="fr"><text>Mt 3,12 : fɛlɛ ndɔ hɛyaa « son van ». La forme pleine fɛlɔɔ n'apparaît qu'en 1 Co 10,13, au sens de « moyen d'en sortir ».</text></form></note>
  </entry>
  <entry id="fɛlɔɔ_473">
    <lexical-unit><form lang="kqs"><text>fɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fɛlɔɔ_473_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rougeole</text></gloss>
      <gloss lang="en"><text>measles</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1CO.10.13; Keita 1979, p. 161: Fèlöö; Childs 2000, p. 104: fɛ̀lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs. Le seul fɛlɔɔ de la Bible (1Co 10,13) est un homographe, « issue, moyen d'en sortir ».</text></form></note>
  </entry>
  <entry id="fɛlɛmɛndɛn_474">
    <lexical-unit><form lang="kqs"><text>fɛlɛmɛndɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛlɛmɛndɛn_474_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>soudain, à l'improviste (surgir contre qqn)</text></gloss>
      <gloss lang="en"><text>suddenly, unexpectedly (come out against)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>describes something coming out (of a socket, from inside) suddenly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first LEV.10.2; Childs 2000, p. 104: félèmèndèŋ</text></form></note>
  </entry>
  <entry id="fɛngɛ_475">
    <lexical-unit><form lang="kqs"><text>fɛngɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛngɛ_475_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bassin, auge</text></gloss>
      <gloss lang="en"><text>basin, trough</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 44 occurrences, first GEN.30.38</text></form></note>
  </entry>
  <entry id="fɛtufɛton_476">
