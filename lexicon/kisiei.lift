    <trait name="status" value="attested"/>
    <sense id="yow_4801_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>emprunter ; prêter</text></gloss>
      <gloss lang="en"><text>borrow; lend</text></gloss>
