    <sense id="kpankpaa ɲala_1814_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>punaises (de lit)</text></gloss>
      <gloss lang="en"><text>bedbugs</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpankpaa ɲara</text></form></note>
    <note><form lang="fr"><text>Écrit kpankpaa ɲara ; glosé « les microbes dans le lit, les punaises ».</text></form></note>
  </entry>
  <entry id="kpannde_1815">
    <lexical-unit><form lang="kqs"><text>kpannde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="kpannde_1815_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joue ; tempe (Keita) ; mâchoire</text></gloss>
      <gloss lang="en"><text>cheek; temple (Keita); jaw</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>temple (upper cheek)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LAM.3.30; Keita 1979, p. 132: Kpannde; Lexique kissi–français, p. 28: kpannde; Childs 2000, p. 206: kpâŋndé</text></form></note>
    <note><form lang="fr"><text>Keita donne « la tempe » ; dans la Bible (Lm 3,30) le mot désigne la joue.</text></form></note>
  </entry>
  <entry id="kpao_1816">
