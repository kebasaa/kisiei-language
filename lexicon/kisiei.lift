  <entry id="lawvo_3075">
    <lexical-unit><form lang="kqs"><text>lawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>law</text></form></variant>
    <sense id="lawvo_3075_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se précipiter, se hâter</text></gloss>
      <gloss lang="en"><text>rush, hurry</text></gloss>
