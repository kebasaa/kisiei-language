      <gloss lang="en"><text>mongoose; gregarious sharp-toothed rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 328: sɛ́ŋndó</text></form></note>
  </entry>
  <entry id="sɛɛdrei_3225">
