    <sense id="ho_544_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe o)</text></gloss>
      <gloss lang="en"><text>this (o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1059 occurrences, first GEN.2.16; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
  <entry id="hoeiye_545">
    <lexical-unit><form lang="kqs"><text>hoeiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hoeyii</text></form></variant>
    <sense id="hoeiye_545_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>froid ; souffle, vent ; paludisme, grippe ; air, vent</text></gloss>
      <gloss lang="en"><text>cold; breath, wind; malaria, flu ; air, wind; cold; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold, cold wind; cold dry season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 107 occurrences, first GEN.7.22; Keita 1979, p. 161: Hoeiye; Childs 2000, p. 134: hùɛ̀ìyé</text></form></note>
    <note><form lang="fr"><text>Keita : « le palu, la grippe ». Dans la Bible : « froid » (Gn 8,22) et « souffle » (Gn 7,22).</text></form></note>
  </entry>
  <entry id="hoeyii_546">
    <lexical-unit><form lang="kqs"><text>hoeyii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hoeyii_546_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vent ; souffle</text></gloss>
      <gloss lang="en"><text>wind; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold wind, cold season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.7; Childs 2000, p. 134: hùèìyé</text></form></note>
  </entry>
  <entry id="hollo_547">
    <lexical-unit><form lang="kqs"><text>hollo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hollo_547_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon</text></gloss>
      <gloss lang="en"><text>mushroom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mushroom; helmet</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Hollo; Childs 2000, p. 130: hòlló</text></form></note>
    <note><form lang="fr"><text>Pluriel holle selon Keita (p. 27).</text></form></note>
  </entry>
  <entry id="holnun_548">
    <lexical-unit><form lang="kqs"><text>holnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>holnɔnndo</text></form></variant>
    <sense id="holnun_548_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>cling to, be joined to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first GEN.2.24</text></form></note>
  </entry>
  <entry id="holɔɔ_549">
    <lexical-unit><form lang="kqs"><text>holɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hol</text></form></variant>
    <variant><form lang="kqs"><text>holnun</text></form></variant>
    <sense id="holɔɔ_549_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, fixer, coller ; monter (Keita)</text></gloss>
      <gloss lang="en"><text>fix, attach, stick; climb (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stick on, lean against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.25.7; Keita 1979, p. 110: Holöö; Childs 2000, p. 130: hòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, hol signifie « fixer, sertir, porter la main sur » (EXO 28,11 ; GEN 22,12) et holnun « s'attacher à » (GEN 2,24). Le sens « monter » de Keita correspond plutôt à hel (Bible) et hèlɔ̀ɔ́ (Childs p. 120).</text></form></note>
  </entry>
  <entry id="hoo_550">
    <lexical-unit><form lang="kqs"><text>hoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hoo_550_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui-ci, ceci</text></gloss>
      <gloss lang="en"><text>this one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 849 occurrences, first GEN.3.3; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
