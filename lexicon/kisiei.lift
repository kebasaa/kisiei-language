    <note type="source"><form lang="en"><text>Childs 2000, p. 240: máláŋndó</text></form></note>
  </entry>
  <entry id="màlìkpáléí_2209">
    <lexical-unit><form lang="kqs"><text>màlìkpáléí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="màlìkpáléí_2209_s1">
