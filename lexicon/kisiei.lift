      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cueillir</text></gloss>
      <gloss lang="en"><text>pick, pluck</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
