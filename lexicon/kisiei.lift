    <trait name="status" value="respelled"/>
    <sense id="tewvo_4000_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gencive édentée</text></gloss>
      <gloss lang="en"><text>toothless gum</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 54: tewvo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « la gencive quand les dents sont tombées ».</text></form></note>
