    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kòlòŋtìɔ́ kòlòŋtèláŋ</text></form></note>
  </entry>
  <entry id="kòlpùlòó_2207">
    <lexical-unit><form lang="kqs"><text>kòlpùlòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
