    <sense id="kpendekele_2426_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>face à face ; clairement, ouvertement</text></gloss>
      <gloss lang="en"><text>face to face; clearly, openly</text></gloss>
