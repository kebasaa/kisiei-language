    <trait name="status" value="attested"/>
    <sense id="fɛtufɛton_476_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>battu, martelé (or)</text></gloss>
      <gloss lang="en"><text>beaten, hammered (gold)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.25.18</text></form></note>
  </entry>
  <entry id="fɛɛ_477">
    <lexical-unit><form lang="kqs"><text>fɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛɛ_477_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en paix, tranquillement ; à l'écart</text></gloss>
      <gloss lang="en"><text>in peace, quietly; aside</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first JOS.6.23</text></form></note>
    <note><form lang="fr"><text>Kɔnnun a kɔlɲulu fɛɛ « va en paix ».</text></form></note>
  </entry>
  <entry id="fɛ́ɛ́-fɛ́ɛ́o_478">
    <lexical-unit><form lang="kqs"><text>fɛ́ɛ́-fɛ́ɛ́o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛ́ɛ́-fɛ́ɛ́o_478_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>douceur ; (diom fɛ́ɛ́-fɛ́ɛ́o) murmure doux</text></gloss>
      <gloss lang="en"><text>gentleness; (diom fɛ́ɛ́-fɛ́ɛ́o) gentle whisper</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.19.12</text></form></note>
  </entry>
  <entry id="fɛɛlɔɔ_479">
    <lexical-unit><form lang="kqs"><text>fɛɛlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fɛɛlɔɔ_479_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>occasion, prétexte</text></gloss>
      <gloss lang="en"><text>occasion, pretext</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.14.4</text></form></note>
  </entry>
  <entry id="fɛɛn_480">
    <lexical-unit><form lang="kqs"><text>fɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɛɛn_480_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éternité ; (le fɛɛn a fɛɛn) pour toujours</text></gloss>
      <gloss lang="en"><text>eternity; (le fɛɛn a fɛɛn) for ever</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 851 occurrences, first GEN.3.14; Childs 2000, p. 101: fééŋ</text></form></note>
  </entry>
  <entry id="fɛɛyaa_481">
    <lexical-unit><form lang="kqs"><text>fɛɛyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyaa_481_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher</text></gloss>
      <gloss lang="en"><text>clear (land)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear away low bushes</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyaa; Childs 2000, p. 102: fèèyàá</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : fɛɛya (JOS 17,15).</text></form></note>
  </entry>
  <entry id="fɛɛyallo_482">
    <lexical-unit><form lang="kqs"><text>fɛɛyallo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyallo_482_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher pour quelqu'un</text></gloss>
      <gloss lang="en"><text>clear land for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyallo</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de fɛɛyaa.</text></form></note>
