    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>loam</text></form></variant>
    <variant><form lang="kqs"><text>loamnin</text></form></variant>
    <sense id="loamaa_2078_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>brûler ; (sálà loamaa) holocauste</text></gloss>
      <gloss lang="en"><text>burn; (sálà loamaa) burnt offering</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 599 occurrences, first GEN.8.20</text></form></note>
    <note><form lang="fr"><text>Pluriel du nom : loamaalan (sálàla loamaalan « holocaustes »).</text></form></note>
  </entry>
