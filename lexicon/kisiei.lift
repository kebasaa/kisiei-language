  <entry id="lóŋíó_2104">
    <lexical-unit><form lang="kqs"><text>lóŋíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lóŋíláŋ</text></form></field>
    <variant><form lang="kqs"><text>lóŋíóó</text></form></variant>
    <variant><form lang="kqs"><text>lóŋgímèíyó</text></form></variant>
    <sense id="lóŋíó_2104_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite marmite à trois pieds</text></gloss>
      <gloss lang="en"><text>small three-legged cooking pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 232: lóŋíó</text></form></note>
  </entry>
  <entry id="lòŋùèí_2105">
