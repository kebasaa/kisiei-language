    <variant><form lang="kqs"><text>soaa</text></form></variant>
    <variant><form lang="kqs"><text>soa</text></form></variant>
    <sense id="sɔɛi_1578_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler ; parole</text></gloss>
      <gloss lang="en"><text>speak; word</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2111 occurrences, first GEN.3.17; Keita 1979, p. 115: Söèi</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : soo, suu, söa.</text></form></note>
