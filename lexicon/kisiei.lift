      <gloss lang="en"><text>corrupt, ruin; confuse (languages)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix up, ruin; play tricks, act foolishly; lose, get lost</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 44 occurrences, first GEN.11.9; Childs 2000, p. 221: làásìá</text></form></note>
    <note><form lang="fr"><text>Causatif de laasian.</text></form></note>
  </entry>
