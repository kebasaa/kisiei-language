    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bèùwé</text></form></field>
    <sense id="bèùwó_213_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre dont la racine donne une teinture jaune</text></gloss>
      <gloss lang="en"><text>large tree whose root gives a yellow dye</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 16: bèùwó</text></form></note>
    <note><form lang="fr"><text>Peut-être le bois de cam ; Lindackeria dentata, Baphia nitida (Childs, d'après Kew).</text></form></note>
