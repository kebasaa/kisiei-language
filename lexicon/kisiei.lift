      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit oiseau mangeur de riz</text></gloss>
      <gloss lang="en"><text>rice bird (small bird that eats rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 231: lìŋndó</text></form></note>
  </entry>
  <entry id="lo_2077">
    <lexical-unit><form lang="kqs"><text>lo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lo_2077_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>chez, auprès de (o … lo)</text></gloss>
      <gloss lang="en"><text>at (someone's place) (o … lo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'to (someone)'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3784 occurrences, first GEN.1.9; Childs 2000, p. 285: ó…ló</text></form></note>
  </entry>
  <entry id="loamaa_2078">
