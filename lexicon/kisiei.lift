    <trait name="status" value="respelled"/>
    <sense id="kpin_1897_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, fort</text></gloss>
      <gloss lang="en"><text>a lot, strongly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpin</text></form></note>
  </entry>
  <entry id="kpingaa_1898">
    <lexical-unit><form lang="kqs"><text>kpingaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kpinga</text></form></variant>
    <variant><form lang="kqs"><text>kpingal</text></form></variant>
    <variant><form lang="kqs"><text>kpinganin</text></form></variant>
    <sense id="kpingaa_1898_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'étonner, être stupéfait, s'exclamer ; (kpingal) s'extasier sur ; parler beaucoup de</text></gloss>
      <gloss lang="en"><text>be astonished, be appalled, exclaim; (kpingal) marvel at; talk a lot about</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.25.18; Lexique kissi–français, p. 29: kpingaa/ kpinga; Childs 2000, p. 214: kpìŋgàá</text></form></note>
    <note><form lang="fr"><text>a kpinga « s'étonnera » (JER.18.16) ; kpingal masaa naŋɔɔ « s'extasièrent (sur elle) devant le roi » (GEN.12.15). Lexique kissi–français, p. 29 : « émerveiller ; parler beaucoup de ».</text></form></note>
  </entry>
  <entry id="kpingbi_1899">
    <lexical-unit><form lang="kqs"><text>kpingbi</text></form></lexical-unit>
