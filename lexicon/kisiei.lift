      <gloss lang="en"><text>tree whose berry juice treats toothache</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lɛ̀ŋgbɛ́sɔ́ɔ́</text></form></note>
  </entry>
  <entry id="lɛŋnden_2169">
