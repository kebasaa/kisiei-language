      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 105: fífí</text></form></note>
  </entry>
  <entry id="fììsàá_1371">
    <lexical-unit><form lang="kqs"><text>fììsàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fììsàá_1371_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre trop peu (d'huile, de sauce) ; se contenter de moins qu'il ne faut</text></gloss>
      <gloss lang="en"><text>use too little (oil, sauce); make do with less than needed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 105: fììsàá</text></form></note>
  </entry>
  <entry id="fíkì-fíkì_1372">
    <lexical-unit><form lang="kqs"><text>fíkì-fíkì</text></form></lexical-unit>
