    <note><form lang="fr"><text>Homographes : kɔ̀ɔ̀ « bouclier » ; o kɔɔ « au lieu, chez ».</text></form></note>
  </entry>
  <entry id="kɔɔfanɔɔ_918">
    <lexical-unit><form lang="kqs"><text>kɔɔfanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
