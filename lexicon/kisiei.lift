    <sense id="dóŋó-dóŋó_721_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en foule serrée, grouillant</text></gloss>
      <gloss lang="en"><text>crowded together, swarming</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 87: dóŋó-dóŋó</text></form></note>
  </entry>
  <entry id="dù-dù_722">
    <lexical-unit><form lang="kqs"><text>dù-dù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
