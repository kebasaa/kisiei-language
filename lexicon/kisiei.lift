    <trait name="status" value="respelled"/>
    <sense id="yeelannɔɔ_4644_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>allié</text></gloss>
      <gloss lang="en"><text>ally</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Yeelannöö</text></form></note>
  </entry>
  <entry id="yééléŋ_4645">
    <lexical-unit><form lang="kqs"><text>yééléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yééléŋ_4645_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>venin</text></gloss>
      <gloss lang="en"><text>venom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yééléŋ</text></form></note>
  </entry>
  <entry id="yeeliaa_4646">
    <lexical-unit><form lang="kqs"><text>yeeliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yeeliaa_4646_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre agréable, rendre savoureux ; faire réussir</text></gloss>
      <gloss lang="en"><text>make pleasant or tasty; make prosper</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.24.21</text></form></note>
    <note><form lang="fr"><text>Causatif de yeela. Mɛlɛka yeeliaa kela ndɔɔ « le Seigneur faisait réussir son voyage » (GEN.24.21).</text></form></note>
  </entry>
  <entry id="yeelɛiyo_4647">
    <lexical-unit><form lang="kqs"><text>yeelɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeelɛi</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛiyon</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛilen</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛilan</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛin</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛiya</text></form></variant>
    <sense id="yeelɛiyo_4647_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>savoureux, délicieux, doux ; agréable</text></gloss>
      <gloss lang="en"><text>tasty, delicious, sweet; pleasant</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.27.7</text></form></note>
    <note><form lang="fr"><text>Cf. yeela « bon, agréable ». ɲɛmahilu yeelɛiyo « un mets savoureux » (GEN.27.7).</text></form></note>
  </entry>
  <entry id="yeemaa_4648">
    <lexical-unit><form lang="kqs"><text>yeemaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeema</text></form></variant>
    <variant><form lang="kqs"><text>yeemanin</text></form></variant>
    <sense id="yeemaa_4648_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vouloir, désirer, aimer</text></gloss>
      <gloss lang="en"><text>want, desire, love</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: need</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first NUM.16.10; Lexique kissi–français, p. 64: yeemaa/ yeema; Childs 2000, p. 400: yèèmàá</text></form></note>
  </entry>
  <entry id="yèèmìá_4649">
    <lexical-unit><form lang="kqs"><text>yèèmìá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yèèmìàláŋ</text></form></field>
    <sense id="yèèmìá_4649_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>interdit alimentaire, tabou</text></gloss>
      <gloss lang="en"><text>taboo, forbidden food</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yèèmìá</text></form></note>
    <note><form lang="fr"><text>Nom ; le verbe correspondant yeemiaa « avoir en horreur » est attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="yeemiaa_4650">
    <lexical-unit><form lang="kqs"><text>yeemiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yeemiaa_4650_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir en horreur, détester, abhorrer</text></gloss>
      <gloss lang="en"><text>loathe, abhor, detest</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dislike, have as a taboo</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.1.13; Childs 2000, p. 401: yèèmìá</text></form></note>
    <note><form lang="fr"><text>I yeemiaa bɔɔ lasikɔlɔ niaa « votre encens m'est en horreur » (ISA.1.13) ; dɛnnda vɔɔnnda ya yeemiaa lan « ces abominations que je hais » (JER.44.4).</text></form></note>
  </entry>
  <entry id="yeemianndo_4651">
    <lexical-unit><form lang="kqs"><text>yeemianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yeemian</text></form></variant>
    <sense id="yeemianndo_4651_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'aimer réciproquement</text></gloss>
      <gloss lang="en"><text>love each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.3 Love"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yemianndo/ yemian</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit yemian ; réécrit d'après yeemaa « aimer » (Bible).</text></form></note>
  </entry>
  <entry id="yéémɔ́ɔ́_4652">
    <lexical-unit><form lang="kqs"><text>yéémɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yéémɔ́ɔ́_4652_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat à ventre blanc</text></gloss>
      <gloss lang="en"><text>white-bellied rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yéémɔ́ɔ́</text></form></note>
  </entry>
  <entry id="yeemɛi_4653">
    <lexical-unit><form lang="kqs"><text>yeemɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yeemɛi_4653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>désir, envie, volonté ; ambition</text></gloss>
      <gloss lang="en"><text>desire, longing, will; ambition</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) wanting, in need of</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 203 occurrences, first GEN.3.6; Lexique kissi–français, p. 64: yemɛi; Childs 2000, p. 400: yèèmɛ̀</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 64) écrit yemɛi « le désir, l'ambition ».</text></form></note>
  </entry>
  <entry id="yééyóó_4654">
    <lexical-unit><form lang="kqs"><text>yééyóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yééyíá</text></form></field>
    <sense id="yééyóó_4654_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mante religieuse</text></gloss>
      <gloss lang="en"><text>praying mantis</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yééyóó</text></form></note>
  </entry>
  <entry id="yèèyɛ́í_4655">
    <lexical-unit><form lang="kqs"><text>yèèyɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yèèyɔ́ŋ</text></form></field>
    <sense id="yèèyɛ́í_4655_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mycose des pieds, infection de la peau</text></gloss>
      <gloss lang="en"><text>athlete's foot, skin infection</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yèèyɛ́í</text></form></note>
  </entry>
  <entry id="yèèŋgòó_4656">
    <lexical-unit><form lang="kqs"><text>yèèŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yèèŋgòó_4656_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sentier laissé entre deux champs</text></gloss>
      <gloss lang="en"><text>path left between farms</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yèèŋgòó</text></form></note>
  </entry>
  <entry id="yeiyo_4657">
    <lexical-unit><form lang="kqs"><text>yeiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yei</text></form></variant>
    <sense id="yeiyo_4657_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insulter, injurier, défier ; blasphémer</text></gloss>
      <gloss lang="en"><text>insult, revile, defy; blaspheme</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1PE.3.9; Childs 2000, p. 401: yèìyó</text></form></note>
    <note><form lang="fr"><text>Vana yei pɛ fuɲa ndɔ « celui qui maudit son père » (MRK.7.10) ; le yei o yei vanaa cɔvaa Hala « parce qu'il a défié l'armée de Dieu » (1SA.17.36).</text></form></note>
  </entry>
  <entry id="yékén_4658">
    <lexical-unit><form lang="kqs"><text>yékén</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yékén_4658_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) attentivement (yaŋ nilan yékén « écouter attentivement »)</text></gloss>
      <gloss lang="en"><text>(ideophone) attentively, intently (yaŋ nilan yékén 'listen closely')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.37.14</text></form></note>
  </entry>
  <entry id="yekpandio_4659">
    <lexical-unit><form lang="kqs"><text>yekpandio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yekpandio_4659_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fusil</text></gloss>
      <gloss lang="en"><text>gun</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Yekpandio; Lexique kissi–français, p. 64: yekpandio; Childs 2000, p. 401: yèkpándìó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 64, 66) écrit aussi yekpando et yokpando.</text></form></note>
  </entry>
  <entry id="yelaa_4660">
    <lexical-unit><form lang="kqs"><text>yelaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yela</text></form></variant>
    <sense id="yelaa_4660_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être sucré, être doux ; faire plaisir</text></gloss>
      <gloss lang="en"><text>be sweet; please</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeraa/ yera</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yelela_4661">
    <lexical-unit><form lang="kqs"><text>yelela</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yelela_4661_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>annonce d'un événement ou d'une fête à venir</text></gloss>
      <gloss lang="en"><text>announcement of a coming event or feast</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yerela</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit yerela ; la Bible a yelela une fois (LAM.4.5) dans un autre sens. Le Lexique donne aussi le verbe yerelaa/ yerela « faire plaisir à qqn » (p. 65). À vérifier.</text></form></note>
  </entry>
  <entry id="yelen_4662">
    <lexical-unit><form lang="kqs"><text>yelen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yelen_4662_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>melon</text></gloss>
      <gloss lang="en"><text>melon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yelen</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « le milon ». Ne pas confondre avec yɛlen « haine ».</text></form></note>
  </entry>
  <entry id="yelenyelenndo_4663">
    <lexical-unit><form lang="kqs"><text>yelenyelenndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yelenyelen</text></form></variant>
    <variant><form lang="kqs"><text>yelenyelennde</text></form></variant>
    <sense id="yelenyelenndo_4663_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flamme</text></gloss>
      <gloss lang="en"><text>flame</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.21.28</text></form></note>
    <note><form lang="fr"><text>yelenyelen leyin « la flamme du feu » (JDG.13.20).</text></form></note>
  </entry>
  <entry id="yèlèŋ-yéléŋndó_4664">
    <lexical-unit><form lang="kqs"><text>yèlèŋ-yéléŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yèlèŋ-yéléŋndó_4664_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grossièreté, conduite folle ou irrespectueuse, crise</text></gloss>
      <gloss lang="en"><text>rudeness, crazy or disrespectful behaviour, fit</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yèlèŋ-yéléŋndó</text></form></note>
  </entry>
  <entry id="yeliaa_4665">
    <lexical-unit><form lang="kqs"><text>yeliaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yelia</text></form></variant>
    <sense id="yeliaa_4665_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sucrer</text></gloss>
      <gloss lang="en"><text>sweeten</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeriaa/ yeria</text></form></note>
    <note><form lang="fr"><text>Causatif de yelaa « être sucré ». Le Lexique écrit r.</text></form></note>
  </entry>
  <entry id="yem_4666">
    <lexical-unit><form lang="kqs"><text>yem</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yem_4666_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>casser, briser</text></gloss>
      <gloss lang="en"><text>break</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.13.13; Lexique kissi–français, p. 64: yem</text></form></note>
    <note><form lang="fr"><text>la yem ndu kɛsei « tu lui briseras la nuque » (EXO.13.13). Le Lexique : « casser (conjugué) » ; cf. yomɔɔ/ yom, yam, yim « casser, détacher » (p. 63, 66).</text></form></note>
  </entry>
  <entry id="yema nde-a_4667">
    <lexical-unit><form lang="kqs"><text>yema nde-a</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yema nde-a_4667_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sœur de la mère</text></gloss>
      <gloss lang="en"><text>mother's sister</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yema nde-a</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; analyse à vérifier.</text></form></note>
  </entry>
  <entry id="yema pua_4668">
    <lexical-unit><form lang="kqs"><text>yema pua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yema pua_4668_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tante (sœur du père)</text></gloss>
      <gloss lang="en"><text>aunt (father's sister)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yema pua</text></form></note>
  </entry>
  <entry id="yemaa_4669">
    <lexical-unit><form lang="kqs"><text>yemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yema</text></form></variant>
    <sense id="yemaa_4669_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sœur (d'un homme), frère (d'une femme)</text></gloss>
      <gloss lang="en"><text>opposite-sex sibling: a man's sister, a woman's brother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sister; brother in some dialects</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.24.55; Keita 1979, p. 134: Yemaa; Lexique kissi–français, p. 64: yemaa; Childs 2000, p. 402: yèmàá</text></form></note>
    <note><form lang="fr"><text>Keita : « la sœur ». Dans la Bible, Laban est aussi le yemaa de Rébecca (Gn 24,55 ; 28,5).</text></form></note>
  </entry>
  <entry id="yémbálló_4670">
    <lexical-unit><form lang="kqs"><text>yémbálló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yémbálló_4670_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de bain des femmes</text></gloss>
      <gloss lang="en"><text>women's bathhouse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yémbálló</text></form></note>
  </entry>
  <entry id="yémbálnɔ̀ɔ́_4671">
    <lexical-unit><form lang="kqs"><text>yémbálnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yémbálnɔ̀ɔ́_4671_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purificateur, exorciste (qui lave personnes et lieux des souillures)</text></gloss>
      <gloss lang="en"><text>exorcist, ritual cleanser</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yémbálnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yembuo_4672">
    <lexical-unit><form lang="kqs"><text>yembuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yembu</text></form></variant>
    <sense id="yembuo_4672_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>célibataire</text></gloss>
      <gloss lang="en"><text>unmarried person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>unmarried adult</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Yembuo; Childs 2000, p. 402: yèmbòó</text></form></note>
    <note><form lang="fr"><text>La Bible a yembu « sans être marié » (1Co 7,8).</text></form></note>
  </entry>
  <entry id="yembuo_4673">
    <lexical-unit><form lang="kqs"><text>yembuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yembuo_4673_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>célibataire, veuf</text></gloss>
      <gloss lang="en"><text>bachelor, widower</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenbuo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb.</text></form></note>
  </entry>
  <entry id="yembɛi_4674">
    <lexical-unit><form lang="kqs"><text>yembɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="yembɛi_4674_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ongle</text></gloss>
      <gloss lang="en"><text>nail (finger, toe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenbɛi</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb. Le Lexique écrit aussi yɛnbɛi (p. 65).</text></form></note>
  </entry>
  <entry id="yèméí_4675">
    <lexical-unit><form lang="kqs"><text>yèméí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="yèméí_4675_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fraternité, lien entre frères et sœurs</text></gloss>
      <gloss lang="en"><text>sibling relationship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yèméí</text></form></note>
  </entry>
  <entry id="yemnde_4676">
    <lexical-unit><form lang="kqs"><text>yemnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yemnde_4676_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foie</text></gloss>
      <gloss lang="en"><text>liver</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.29.13; Keita 1979, p. 133: Yemnde; Lexique kissi–français, p. 64: yemnde; Childs 2000, p. 402: yěmndé</text></form></note>
  </entry>
  <entry id="yendioo_4677">
    <lexical-unit><form lang="kqs"><text>yendioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yendioo_4677_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>néré</text></gloss>
      <gloss lang="en"><text>African locust bean tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Yendioo; Lexique kissi–français, p. 64: yendioo</text></form></note>
    <note><form lang="fr"><text>Parkia biglobosa. Le Lexique kissi–français (p. 64) donne aussi yendelen « l'arbre néré, qui donne une farine jaune ».</text></form></note>
  </entry>
  <entry id="yenge-yenge_4678">
    <lexical-unit><form lang="kqs"><text>yenge-yenge</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yenge-yenge_4678_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>instable, fragile, en mauvaise position, dangereux ; raide</text></gloss>
      <gloss lang="en"><text>unstable, fragile, precarious; stiff</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenge-yenge</text></form></note>
    <note><form lang="fr"><text>vanaa yenge-yengea « des êtres plus fragiles » (1PE.3.7). Le Lexique donne aussi yengeyenge « raide ».</text></form></note>
  </entry>
  <entry id="yengilanndo_4679">
    <lexical-unit><form lang="kqs"><text>yengilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yengilan</text></form></variant>
    <sense id="yengilanndo_4679_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>provoquer</text></gloss>
      <gloss lang="en"><text>provoke</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yengilanndo/ yengilan</text></form></note>
  </entry>
  <entry id="yeo_4680">
    <lexical-unit><form lang="kqs"><text>yeo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>ye</text></form></variant>
    <sense id="yeo_4680_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insulter, jurer (plusieurs fois)</text></gloss>
      <gloss lang="en"><text>insult, swear (repeatedly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yeo</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne le radical ye « insulter, jurer » et yeo « insulter, jurer plusieurs fois ».</text></form></note>
  </entry>
  <entry id="yeoanndo_4681">
    <lexical-unit><form lang="kqs"><text>yeoanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yeoan</text></form></variant>
    <sense id="yeoanndo_4681_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'insulter (l'un l'autre)</text></gloss>
      <gloss lang="en"><text>insult each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yeoanndo/ yeoan</text></form></note>
  </entry>
  <entry id="yeowlan_4682">
    <lexical-unit><form lang="kqs"><text>yeowlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeow</text></form></variant>
    <variant><form lang="kqs"><text>yeowla</text></form></variant>
    <sense id="yeowlan_4682_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se moquer de, insulter ; maudire</text></gloss>
      <gloss lang="en"><text>mock, insult; curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>abuse repeatedly (plural of yèìyó 'insult, curse')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first JDG.8.15; Childs 2000, p. 409: yìòùwó</text></form></note>
  </entry>
  <entry id="yèùwó_4683">
    <lexical-unit><form lang="kqs"><text>yèùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yèùwó_4683_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit animal (plus petit qu'une chèvre) dont la peau sert pour les tambours</text></gloss>
      <gloss lang="en"><text>small animal whose skin is used for drums</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yèùwó</text></form></note>
  </entry>
  <entry id="yeyio_4684">
    <lexical-unit><form lang="kqs"><text>yeyio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yeyio_4684_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte fouisseur (qui s'attaque aux yeux)</text></gloss>
      <gloss lang="en"><text>burrowing insect (said to attack the eyes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeyio</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « un insecte qui creuse, qui enlève les yeux ».</text></form></note>
  </entry>
  <entry id="yeyo_4685">
    <lexical-unit><form lang="kqs"><text>yeyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yeyo_4685_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insulte</text></gloss>
      <gloss lang="en"><text>insult</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeyo</text></form></note>
    <note><form lang="fr"><text>Cf. yeo « insulter ».</text></form></note>
  </entry>
  <entry id="yeŋ_4686">
    <lexical-unit><form lang="kqs"><text>yeŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeŋnun</text></form></variant>
    <variant><form lang="kqs"><text>yeŋnin</text></form></variant>
    <sense id="yeŋ_4686_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>refuser (d'écouter), désobéir (yeŋ … lani)</text></gloss>
      <gloss lang="en"><text>refuse (to listen), disobey (yeŋ … lani)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 44 occurrences, first GEN.42.21</text></form></note>
  </entry>
  <entry id="yéŋé-yéŋé_4687">
    <lexical-unit><form lang="kqs"><text>yéŋé-yéŋé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yéŋé-yéŋé_4687_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en équilibre instable ; aux aguets (oreilles dressées) ; équilibré</text></gloss>
      <gloss lang="en"><text>delicately balanced; alertly (ears pricked); balanced</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yéŋé-yéŋé</text></form></note>
  </entry>
  <entry id="yéŋndó_4688">
    <lexical-unit><form lang="kqs"><text>yéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yéŋndó_4688_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune boa</text></gloss>
      <gloss lang="en"><text>young boa constrictor</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yéŋndó</text></form></note>
  </entry>
  <entry id="yí_4689">
    <lexical-unit><form lang="kqs"><text>yí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yí_4689_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>droit, immobile, tranquillement</text></gloss>
      <gloss lang="en"><text>straight, erect, quietly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yí</text></form></note>
  </entry>
  <entry id="yi sondo_4690">
    <lexical-unit><form lang="kqs"><text>yi sondo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yi sondo_4690_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire la moue</text></gloss>
      <gloss lang="en"><text>pout</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yi sondo</text></form></note>
  </entry>
  <entry id="yia_4691">
    <lexical-unit><form lang="kqs"><text>yia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yia_4691_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>loger, faire loger</text></gloss>
      <gloss lang="en"><text>lodge, put up</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yia</text></form></note>
    <note><form lang="fr"><text>Le Lexique ne donne que le radical.</text></form></note>
  </entry>
  <entry id="yiaan_4692">
    <lexical-unit><form lang="kqs"><text>yiaan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yima</text></form></variant>
    <sense id="yiaan_4692_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faim ; famine</text></gloss>
      <gloss lang="en"><text>hunger; famine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.25.30; Lexique kissi–français, p. 65: yiyan; Childs 2000, p. 406: yìáŋ</text></form></note>
    <note><form lang="fr"><text>yima fofolan « famine » (Gn 12,10). Le Lexique kissi–français (p. 65) écrit yiyan « la faim, la famine », homographe de yiyan « penser ».</text></form></note>
  </entry>
  <entry id="yifa_4693">
    <lexical-unit><form lang="kqs"><text>yifa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yifa_4693_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer (les paupières)</text></gloss>
      <gloss lang="en"><text>close (the eyelids)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>partially close, close without locking; hide</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.132.4; Childs 2000, p. 406: yìfàá</text></form></note>
    <note><form lang="fr"><text>i yifa lɛnin hɔlta koongula nilan « je ne fermerai pas les paupières » (PSA.132.4).</text></form></note>
  </entry>
  <entry id="yìfàá_4694">
    <lexical-unit><form lang="kqs"><text>yìfàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yìfàá_4694_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marque au front des musulmans (à effacer à leur mort)</text></gloss>
      <gloss lang="en"><text>mark Muslims wear on the forehead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yìfàá</text></form></note>
  </entry>
  <entry id="yifanndo_4695">
    <lexical-unit><form lang="kqs"><text>yifanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifan</text></form></variant>
    <sense id="yifanndo_4695_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'abriter, se réfugier ; se retirer, se tenir à l'écart</text></gloss>
      <gloss lang="en"><text>take shelter, take refuge; withdraw, keep apart</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>escape something, take precautions</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.30.2; Childs 2000, p. 406: yìfǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yifa. le kɔlan yifanndo o vunduma Esipte « pour s'abriter à l'ombre de l'Égypte » (ISA.30.2) ; mó yifan « il se tint à l'écart » (GAL.2.12).</text></form></note>
  </entry>
  <entry id="yifidi_4696">
    <lexical-unit><form lang="kqs"><text>yifidi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yifidi_4696_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sombre, obscur</text></gloss>
      <gloss lang="en"><text>dark</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yifidi</text></form></note>
  </entry>
  <entry id="yifidii_4697">
    <lexical-unit><form lang="kqs"><text>yifidii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifidiio</text></form></variant>
    <variant><form lang="kqs"><text>yifidiia</text></form></variant>
    <variant><form lang="kqs"><text>yifidiila</text></form></variant>
    <sense id="yifidii_4697_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>obscurité, ténèbres ; (yɔŋnun yifidii) s'assombrir, se troubler (yeux, visage)</text></gloss>
      <gloss lang="en"><text>darkness, gloom; (yɔŋnun yifidii) grow dark, grow dim</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.28.65</text></form></note>
  </entry>
  <entry id="yifɔɔ_4698">
    <lexical-unit><form lang="kqs"><text>yifɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yifɔlan</text></form></field>
    <variant><form lang="kqs"><text>yifɔ</text></form></variant>
    <sense id="yifɔɔ_4698_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poche</text></gloss>
      <gloss lang="en"><text>pocket</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Yiföö; Lexique kissi–français, p. 65: yifɔɔ; Childs 2000, p. 406: yífɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale yifɔ dans la Bible : « sein, pli du vêtement » (Pr 6,27), « ceinture » où l'on met l'argent (Mc 6,8).</text></form></note>
  </entry>
  <entry id="yíì_4699">
    <lexical-unit><form lang="kqs"><text>yíì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíì_4699_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>(cri d'enfant qui montre une chose laide ou effrayante)</text></gloss>
      <gloss lang="en"><text>(children's exclamation when showing something ugly or scary)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíì</text></form></note>
  </entry>
  <entry id="yiian_4700">
    <lexical-unit><form lang="kqs"><text>yiian</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <sense id="yiian_4700_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fin</text></gloss>
      <gloss lang="en"><text>end</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiian</text></form></note>
  </entry>
  <entry id="yíìì_4701">
    <lexical-unit><form lang="kqs"><text>yíìì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíìì_4701_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(très grand, énorme)</text></gloss>
      <gloss lang="en"><text>(underscores bigness)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíìì</text></form></note>
  </entry>
  <entry id="yiilu_4702">
    <lexical-unit><form lang="kqs"><text>yiilu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiilu_4702_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>conclure (une alliance) avec, promettre à</text></gloss>
      <gloss lang="en"><text>make (a covenant) with, promise to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 139 occurrences, first GEN.9</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de yiiyo.</text></form></note>
  </entry>
  <entry id="yiinanndo_4703">
    <lexical-unit><form lang="kqs"><text>yiinanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiinan</text></form></variant>
    <variant><form lang="kqs"><text>yiinannda</text></form></variant>
    <variant><form lang="kqs"><text>yiinannin</text></form></variant>
    <sense id="yiinanndo_4703_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'unir, se joindre, être lié (à) ; se liguer</text></gloss>
      <gloss lang="en"><text>join together, unite, be bound (to); league together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.30.12</text></form></note>
    <note><form lang="fr"><text>Réciproque de yiiyo « lier, établir ». laa … yiinan a pɔnɔ ndɔ « la femme est liée à son mari » (1CO.7.39).</text></form></note>
  </entry>
  <entry id="yiinde_4704">
    <lexical-unit><form lang="kqs"><text>yiinde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiiŋii</text></form></variant>
    <sense id="yiinde_4704_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheveux, poils ; laine</text></gloss>
      <gloss lang="en"><text>hair; wool</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.25.25; Keita 1979, p. 133: Yiinde; Lexique kissi–français, p. 65: yiinde; Childs 2000, p. 406: yììŋndé</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 66 : yiŋi, yinŋi « les cheveux (suivi d'un adjectif) » ; la Bible a yiŋii (LUK.12.7).</text></form></note>
  </entry>
  <entry id="yiinde lavɔɔ_4705">
    <lexical-unit><form lang="kqs"><text>yiinde lavɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiinde lavɔɔ_4705_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tresser (les cheveux)</text></gloss>
      <gloss lang="en"><text>braid (hair)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: [yi]inde lavɔɔ</text></form></note>
  </entry>
  <entry id="yiinɔnndo_4706">
    <lexical-unit><form lang="kqs"><text>yiinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiinɔnndo_4706_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se ceindre, s'attacher ; s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>gird oneself, tie on; attach oneself to, join</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie (a cloth) around oneself, wrap, wear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.15.12; Lexique kissi–français, p. 65: yiinɔnndo/ yiinun; Childs 2000, p. 406: yììnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yiiyo. yáwlen yiinɔnndo « ceindre la ceinture » (1KI.20.11).</text></form></note>
  </entry>
  <entry id="yiiyaa_4707">
    <lexical-unit><form lang="kqs"><text>yiiyaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yiiyaa_4707_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égards pour un étranger</text></gloss>
      <gloss lang="en"><text>consideration for a stranger</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiiyaa</text></form></note>
    <note><form lang="fr"><text>La Bible a yiiyaa une fois (ISA.24.16), sens non confirmé.</text></form></note>
  </entry>
  <entry id="yiiyo_4708">
    <lexical-unit><form lang="kqs"><text>yiiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yii</text></form></variant>
    <sense id="yiiyo_4708_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>établir, conclure (alliance) ; poser, mettre ; ourdir (complot) ; attacher, lier</text></gloss>
      <gloss lang="en"><text>establish, make (covenant); set, put; hatch (a plot); tie, bind</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie up, wrap; make a charm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first GEN.26.28; Lexique kissi–français, p. 65: yiio/ yii; Childs 2000, p. 407: yììyó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 65 : yiio/ yii « attacher » ; cf. maalon yiiyo tumbulan « nous liions des gerbes » (GEN.37.7).</text></form></note>
  </entry>
  <entry id="yiiyo vando luɛɔ_4709">
    <lexical-unit><form lang="kqs"><text>yiiyo vando luɛɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yiiyo vando luɛɔ_4709_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espérance, confiance en qqn</text></gloss>
      <gloss lang="en"><text>hope, trust in someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiiyo vando luɛɔ</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; forme à vérifier.</text></form></note>
  </entry>
  <entry id="yiiŋii_4710">
    <lexical-unit><form lang="kqs"><text>yiiŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yiiŋii_4710_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poils, pelage</text></gloss>
      <gloss lang="en"><text>body hair, hair</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first GEN.25.25</text></form></note>
  </entry>
  <entry id="yiiŋii lakoongoei_4711">
    <lexical-unit><form lang="kqs"><text>yiiŋii lakoongoei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiiŋii lakoongoei_4711_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cils</text></gloss>
      <gloss lang="en"><text>eyelashes</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yiinhii lakoongoei; Lexique kissi–français, p. 65: yiiŋii lakoongoei</text></form></note>
  </entry>
  <entry id="yiiŋii lamilinde_4712">
    <lexical-unit><form lang="kqs"><text>yiiŋii lamilinde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiiŋii lamilinde_4712_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustache</text></gloss>
      <gloss lang="en"><text>moustache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yiinhii lamilinde; Lexique kissi–français, p. 65: yiiŋii lamilinde</text></form></note>
  </entry>
  <entry id="yikilaa_4713">
    <lexical-unit><form lang="kqs"><text>yikilaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yikilaa_4713_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouillie qui monte à la surface du riz cuit</text></gloss>
      <gloss lang="en"><text>starchy froth on top of cooked rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yikilaa</text></form></note>
  </entry>
  <entry id="yikpa_4714">
    <lexical-unit><form lang="kqs"><text>yikpa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yikpa_4714_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enduire, recouvrir (de)</text></gloss>
      <gloss lang="en"><text>coat, overlay (with)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rub, grind, sharpen; apply plaster</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.6.14; Childs 2000, p. 407: yìkpàá</text></form></note>
  </entry>
  <entry id="yìkpáá_4715">
    <lexical-unit><form lang="kqs"><text>yìkpáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yìkpáá_4715_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>algues au fond de l'eau</text></gloss>
      <gloss lang="en"><text>algae at the bottom of water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yìkpáá</text></form></note>
  </entry>
  <entry id="yíkpè-yìkpè_4716">
    <lexical-unit><form lang="kqs"><text>yíkpè-yìkpè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíkpè-yìkpè_4716_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(secousse, tremblement : boue, herbe)</text></gloss>
      <gloss lang="en"><text>(shaking, quivering)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yíkpè-yìkpè</text></form></note>
  </entry>
  <entry id="yìkpɔ̀ɔ́_4717">
    <lexical-unit><form lang="kqs"><text>yìkpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yìkpɔ̀ɔ́_4717_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dépôt, sédiment (dans l'eau)</text></gloss>
      <gloss lang="en"><text>sediment in water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yìkpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yilankamaa_4718">
    <lexical-unit><form lang="kqs"><text>yilankamaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yilankamaa_4718_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hippopotame</text></gloss>
      <gloss lang="en"><text>hippopotamus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yirankamaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Cf. kamaa « éléphant ».</text></form></note>
  </entry>
  <entry id="yilankunndo_4719">
    <lexical-unit><form lang="kqs"><text>yilankunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yilankunndo_4719_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>météore, étoile filante</text></gloss>
      <gloss lang="en"><text>meteor, shooting star</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yirankunndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yilanndo_4720">
    <lexical-unit><form lang="kqs"><text>yilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yilanndo_4720_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se saluer</text></gloss>
      <gloss lang="en"><text>greet each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Yilanndo; Lexique kissi–français, p. 65: yilanndo/ yilan</text></form></note>
    <note><form lang="fr"><text>Réciproque de yilɔɔ. Forme attestée dans la Bible : yilan (2KI 10,15). Le radical yilan est dans la Bible : La yilan niaa vana o nɛi le « ne saluez personne en chemin » (LUK.10.4).</text></form></note>
  </entry>
  <entry id="yilili_4721">
    <lexical-unit><form lang="kqs"><text>yilili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yilili_4721_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>désert, solitaire, isolé (lieu)</text></gloss>
      <gloss lang="en"><text>deserted, desolate, lonely (place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleepily, weakly, lackadaisically; by oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.32.10; Childs 2000, p. 407: yílílí</text></form></note>
    <note><form lang="fr"><text>Fondaa ho co bɔɔ yilili « cet endroit est désert » (MAT.14.15) ; o fonda yilili « dans un lieu désolé » (DEU.32.10). Rapprochement avec Childs (« seul, à l'écart ») à confirmer.</text></form></note>
  </entry>
  <entry id="yílímìŋndɛ̀ŋ_4722">
    <lexical-unit><form lang="kqs"><text>yílímìŋndɛ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílímìŋndɛ̀ŋ_4722_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entassés ; indistinct (dans la nuit, la foule)</text></gloss>
      <gloss lang="en"><text>all piled together; unrecognizable (in the dark, a crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílímìŋndɛ̀ŋ</text></form></note>
  </entry>
  <entry id="yilisio_4723">
    <lexical-unit><form lang="kqs"><text>yilisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yilisio_4723_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>richesse ; s'enrichir</text></gloss>
      <gloss lang="en"><text>wealth; become rich</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yirisio</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yílíŋ_4724">
    <lexical-unit><form lang="kqs"><text>yílíŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílíŋ_4724_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(groupe informe, attroupement)</text></gloss>
      <gloss lang="en"><text>(amorphous group, crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílíŋ</text></form></note>
  </entry>
  <entry id="yilɔɔ_4725">
    <lexical-unit><form lang="kqs"><text>yilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yil</text></form></variant>
    <variant><form lang="kqs"><text>yilnin</text></form></variant>
    <sense id="yilɔɔ_4725_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saluer ; épouser (une femme)</text></gloss>
      <gloss lang="en"><text>greet; marry (a wife)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greet or salute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.24.7; Keita 1979, p. 114: Yilöö; Lexique kissi–français, p. 65: yilɔɔ/ yil; Childs 2000, p. 407: yìlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, yil lanɔɔ « prendre femme » (GEN 4,19 ; 24,7) ; yil « saluer, s'adresser à » (GEN 27,18).</text></form></note>
  </entry>
  <entry id="yimbu_4726">
    <lexical-unit><form lang="kqs"><text>yimbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimbɔɔ</text></form></variant>
    <sense id="yimbu_4726_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser en broussaille, croître sans soin (cheveux) ; (chemins) devenir déserts, envahis</text></gloss>
      <gloss lang="en"><text>grow wild, grow long (hair); (roads) become deserted, overgrown</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) overgrown, bushy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first LEV.26.22; Childs 2000, p. 408: yìmbàà</text></form></note>
    <note><form lang="fr"><text>yiiŋii ndɔɛi yimbu « ses cheveux poussèrent » (DAN.4.30) ; nɛila niaalan la yimbu « vos chemins seront déserts » (LEV.26.22) ; mal bolii ndɛi yimbɔɔ « laisser pousser leurs cheveux » (EZK.44.20).</text></form></note>
  </entry>
  <entry id="yimbɔɔ_4727">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yimbɔɔ_4727_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam (Keita)</text></gloss>
      <gloss lang="en"><text>drum (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Yimböö</text></form></note>
    <note><form lang="fr"><text>La seule occurrence biblique (Ez 44,20) ne signifie pas « tam-tam » : elle se rattache à yimbu « devenir broussailleux, laisser pousser » (Dn 4,30). Sens de Keita à confirmer.</text></form></note>
  </entry>
  <entry id="yimbɔɔ_4728">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yimbɔɔ_4728_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam</text></gloss>
      <gloss lang="en"><text>drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yinbɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb. Homographe de yimbɔɔ « hirsute ».</text></form></note>
  </entry>
  <entry id="yimbɔɔ_4729">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yimbɔɔ_4729_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sale, négligé ; (tête) non coiffée, hirsute</text></gloss>
      <gloss lang="en"><text>dirty, unkempt; (hair) uncombed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.44.20; Lexique kissi–français, p. 66: yinbɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « sale, étouffé, poussé trop ; une tête non-coiffée ». Sens de EZK.44.20 (cheveux laissés longs) à vérifier.</text></form></note>
  </entry>
  <entry id="yimi_4730">
    <lexical-unit><form lang="kqs"><text>yimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimiyimi</text></form></variant>
    <variant><form lang="kqs"><text>yimio</text></form></variant>
    <sense id="yimi_4730_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser, broyer</text></gloss>
      <gloss lang="en"><text>break, crush</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break into small pieces</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.24.8; Lexique kissi–français, p. 66: yimio/ yimi; Childs 2000, p. 408: yìmìó</text></form></note>
    <note><form lang="fr"><text>yimiyimi « briser en morceaux » (Lv 2,6). Lexique kissi–français, p. 65-66 : yimio/ yimi « casser en morceaux ».</text></form></note>
  </entry>
  <entry id="yimɔɔ_4731">
    <lexical-unit><form lang="kqs"><text>yimɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yimɔɔ_4731_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gronder (tonnerre) ; se lever avec un grand bruit ; bruit de la pluie</text></gloss>
      <gloss lang="en"><text>rumble (thunder); rise with a great noise; sound of rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yimɔɔ/ yim; Childs 2000, p. 408: yìmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 65-66 (yimɔɔ/ yim « se lever avec un grand bruit ; le bruit de la pluie »).</text></form></note>
  </entry>
