    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suendì-suendiaalan</text></form></variant>
    <sense id="suendi_3096_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recoudre, rapiécer ; (suendì-suendiaalan) rapiécé de toutes parts</text></gloss>
      <gloss lang="en"><text>sew up, patch; (suendì-suendiaalan) patched all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sew (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOS.9.4; Childs 2000, p. 342: sùèndìó</text></form></note>
    <note><form lang="fr"><text>Pluriel de sɔndɔɔ « coudre ». bɔlɔla yáwla … sɛɛsiɛila ndáà mingi suendi lan « des outres usées, déchirées et recousues » (JOS.9.4) ; samtala yuulula suendì-suendiaalan « des sandales usées et rapiécées » (JOS.9.5).</text></form></note>
  </entry>
