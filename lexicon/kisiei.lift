  <entry id="yɔɔsɔɔ_4016">
    <lexical-unit><form lang="kqs"><text>yɔɔsɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yɔɔsɔla</text></form></field>
    <sense id="yɔɔsɔɔ_4016_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fil (à tisser) ; (kola-yɔɔsɔɔ) ensouple de tisserand</text></gloss>
      <gloss lang="en"><text>thread, yarn (for weaving); (kola-yɔɔsɔɔ) weaver's beam</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thread of traditional woven cloth; also a young palm tree</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1CH.11.23; Childs 2000, p. 416: yɔ́ɔ́sɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>yɔɔsɔla nda yin a kaan-ndan « fils violet et bleu » (EXO.25.4) ; kola-yɔɔsɔɔ o ndu tɔndaa « ensouple de tisserand » (1CH.11.23).</text></form></note>
  </entry>
  <entry id="yɔ́ɔ́sɔ́ɔ́_4017">
