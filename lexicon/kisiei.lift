    </sense>
    <note type="source"><form lang="en"><text>BKG: 52 occurrences, first GEN.4.15</text></form></note>
  </entry>
  <entry id="bɔŋan taasila laandulan_482">
    <lexical-unit><form lang="kqs"><text>bɔŋan taasila laandulan</text></form></lexical-unit>
