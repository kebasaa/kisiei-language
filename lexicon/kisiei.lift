      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dot, compensation matrimoniale</text></gloss>
      <gloss lang="en"><text>bride price, dowry</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.34.4; Childs 2000, p. 112: fúlóó</text></form></note>
    <note><form lang="fr"><text>dɔw … fulu « payer la dot pour (une femme) ».</text></form></note>
  </entry>
