      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>galette, gâteau</text></gloss>
      <gloss lang="en"><text>cake, wafer</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EXO.29.23</text></form></note>
  </entry>
  <entry id="fúlùkpàtà_1043">
