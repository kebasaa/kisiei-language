    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛmbuu</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛmbuunin</text></form></variant>
    <sense id="tɛɛmbuuo_1758_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>détruire, anéantir ; transgresser (une loi)</text></gloss>
      <gloss lang="en"><text>destroy; break, transgress (a law)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of tàmbéí 'be ruined': spoil, break, misuse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 176 occurrences, first GEN.19.13; Childs 2000, p. 353: tèèmbùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tambu « être ruiné ».</text></form></note>
  </entry>
  <entry id="tɛɛn_1759">
