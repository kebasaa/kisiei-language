    <trait name="status" value="attested"/>
    <sense id="fefele_837_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>léger (de poids)</text></gloss>
      <gloss lang="en"><text>light (in weight)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.25.13; Childs 2000, p. 100: féfélé</text></form></note>
    <note><form lang="fr"><text>bɔndii nuu connun fefele « mon fardeau est léger » (MAT.11.30) ; dɛ̀ndɔ̀ɔ́ … muungu fefele « (pour) alléger le bateau » (JON.1.5).</text></form></note>
  </entry>
