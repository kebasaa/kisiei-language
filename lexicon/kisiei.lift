      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'oiseau noir</text></gloss>
      <gloss lang="en"><text>a species of black bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 178: kóókóó kóókúá</text></form></note>
  </entry>
  <entry id="kòòlònɔ̀ɔ́_1452">
    <lexical-unit><form lang="kqs"><text>kòòlònɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kòòlònɔ̀ɔ́_1452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouffon de la société d'initiation (ossements, becs d'oiseaux, habits déchirés)</text></gloss>
      <gloss lang="en"><text>clown figure of the initiation society (bones, bird bills, torn clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 178: kòòlònɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kòòlòó_1453">
    <lexical-unit><form lang="kqs"><text>kòòlòó</text></form></lexical-unit>
