    <trait name="status" value="respelled"/>
    <sense id="bɛnducieo_117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>notable</text></gloss>
      <gloss lang="en"><text>notable, elder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Bèndutyieo</text></form></note>
  </entry>
  <entry id="bɛnduo_118">
    <lexical-unit><form lang="kqs"><text>bɛnduo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɛnduo_118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand frère, aîné</text></gloss>
      <gloss lang="en"><text>elder brother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>elder, older brother; big one; term of respect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bènduo; Childs 2000, p. 13: bɛ́ndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɛngu_119">
    <lexical-unit><form lang="kqs"><text>bɛngu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛngula</text></form></variant>
    <variant><form lang="kqs"><text>bɛngulan</text></form></variant>
    <sense id="bɛngu_119_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sous, au bas de ; (pl. bɛngulan) pieds, sabots</text></gloss>
      <gloss lang="en"><text>under, at the bottom of; (pl. bɛngulan) feet, hooves</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bottom, beneath, under</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1156 occurrences, first GEN.3.15; Childs 2000, p. 225: lèbèŋgú</text></form></note>
  </entry>
  <entry id="bɛngu lefunndo_120">
    <lexical-unit><form lang="kqs"><text>bɛngu lefunndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛngu lefunndo_120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cotonnier</text></gloss>
      <gloss lang="en"><text>cotton plant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèngu lefunndo</text></form></note>
  </entry>
  <entry id="bɛngufɔnɔ_121">
    <lexical-unit><form lang="kqs"><text>bɛngufɔnɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛngufɔnɔ_121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>novembre</text></gloss>
      <gloss lang="en"><text>November</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>time around November</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Bèngufönö; Childs 2000, p. 15: bɛ̀ŋgúfɔ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɛnguo_122">
    <lexical-unit><form lang="kqs"><text>bɛnguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bɛnguo_122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pied, jambe ; dessous, bas ; patte</text></gloss>
      <gloss lang="en"><text>foot, leg; underside, bottom ; paw, foot (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>leg, foot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.35.7; Keita 1979, p. 131: Bènguo; Childs 2000, p. 14: bɛ̀ŋgóó</text></form></note>
    <note><form lang="fr"><text>Keita : « le pied », confirmé par Childs. Dans la Bible, bɛngu (et bɛnguo, Jr 35,7) s'emploie surtout au sens de « sous, en bas » ; le pied y est d'ordinaire pelei. Dans la Bible, bɛnguo (JER.35.7) est une forme homonyme de bɛngu « dessous ».</text></form></note>
  </entry>
  <entry id="bɛsinndo_123">
    <lexical-unit><form lang="kqs"><text>bɛsinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛsinndo_123_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'écobuer (champ)</text></gloss>
      <gloss lang="en"><text>be burn-cleared</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bèsinndo</text></form></note>
    <note><form lang="fr"><text>Moyen de bɛsio.</text></form></note>
  </entry>
  <entry id="bɛsio_124">
    <lexical-unit><form lang="kqs"><text>bɛsio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>bɛsi</text></form></variant>
    <sense id="bɛsio_124_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écobuer (Keita) ; porter, prendre soin (?)</text></gloss>
      <gloss lang="en"><text>burn-clear a field (Keita); carry, care for (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bèsio</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, bɛsio (DEU 32,10) et bɛsi (ISA 46,3) semblent signifier « porter, entourer de soins », pas « écobuer ». À vérifier.</text></form></note>
  </entry>
  <entry id="bɛsuo_125">
    <lexical-unit><form lang="kqs"><text>bɛsuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bɛsu</text></form></variant>
    <sense id="bɛsuo_125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balai</text></gloss>
      <gloss lang="en"><text>broom</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.5 Sweep, rake"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Bèsuo; Childs 2000, p. 15: bɛ̀sòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale bɛsu dans la Bible (Is 14,23).</text></form></note>
  </entry>
  <entry id="bɛŋianndo_126">
    <lexical-unit><form lang="kqs"><text>bɛŋianndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɛŋianndo_126_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se botter (?)</text></gloss>
      <gloss lang="en"><text>put on boots (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Bènhianndo</text></form></note>
    <note><form lang="fr"><text>Glose de Keita peu claire ; peut-être moyen de bɛŋio « se détacher, se défaire ».</text></form></note>
  </entry>
  <entry id="bɛŋio_127">
    <lexical-unit><form lang="kqs"><text>bɛŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛŋi</text></form></variant>
    <variant><form lang="kqs"><text>bɛŋin</text></form></variant>
    <sense id="bɛŋio_127_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arracher, démonter, détacher</text></gloss>
      <gloss lang="en"><text>knock out, pull out, dismantle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>come out (as a blade from its handle)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.19.9; Keita 1979, p. 110: Bènhia; Childs 2000, p. 14: bèŋìó</text></form></note>
    <note><form lang="fr"><text>Keita écrit bènhia ; la Bible a la forme longue bɛŋio (GEN 19,9). bɛŋi : faire sauter une dent (EXO 21,27) ; bɛŋin : se détacher (fer de hache, DEU 19,5).</text></form></note>
  </entry>
  <entry id="bɛɛ_128">
    <lexical-unit><form lang="kqs"><text>bɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛ_128_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>aussi ; même ; déjà</text></gloss>
      <gloss lang="en"><text>also; even; already</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2221 occurrences, first GEN.1.11</text></form></note>
  </entry>
  <entry id="bɛɛlen_129">
    <lexical-unit><form lang="kqs"><text>bɛɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛɛle</text></form></variant>
    <sense id="bɛɛlen_129_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honneur, gloire ; (ke … bɛɛlen) honorer</text></gloss>
      <gloss lang="en"><text>honour, glory; (ke … bɛɛlen) honour</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 180 occurrences, first GEN.30.20</text></form></note>
  </entry>
  <entry id="bɛɛndiaa_130">
    <lexical-unit><form lang="kqs"><text>bɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛndiaa_130_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>préparer, apprêter ; arranger, réparer</text></gloss>
      <gloss lang="en"><text>prepare, make ready; set right</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.14.14</text></form></note>
  </entry>
  <entry id="bɛɛndian_131">
    <lexical-unit><form lang="kqs"><text>bɛɛndian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛɛndianndo</text></form></variant>
    <sense id="bɛɛndian_131_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se préparer, s'apprêter</text></gloss>
      <gloss lang="en"><text>get ready</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.22</text></form></note>
    <note><form lang="fr"><text>Moyen de bɛɛndiaa « préparer ».</text></form></note>
  </entry>
  <entry id="bɛɛyan vomɔɔ_132">
    <lexical-unit><form lang="kqs"><text>bɛɛyan vomɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɛɛyan vomɔɔ_132_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>divination aux cailloux</text></gloss>
      <gloss lang="en"><text>divination with pebbles</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Bèèyan vomöö</text></form></note>
    <note><form lang="fr"><text>Keita écrit « divissation » ; lu « divination ». Découpage à confirmer.</text></form></note>
  </entry>
  <entry id="caa_133">
    <lexical-unit><form lang="kqs"><text>caa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cee</text></form></variant>
    <sense id="caa_133_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>savoir (faire), être habile</text></gloss>
      <gloss lang="en"><text>know how, be skilled</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 321 occurrences, first GEN.4.7; Keita 1979, p. 115: Tyaa</text></form></note>
    <note><form lang="fr"><text>vana caa kpaasiaa vuuo « habile tireur à l'arc » (GEN 21,20) ; cee : radical négatif (EXO 4,10).</text></form></note>
  </entry>
  <entry id="caan_134">
    <lexical-unit><form lang="kqs"><text>caan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>caanda</text></form></field>
    <sense id="caan_134_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ami, compagnon ; prochain</text></gloss>
      <gloss lang="en"><text>friend, companion; neighbour</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
      <trait name="semantic-domain-ddp4" value="4.1.4 Neighbor"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 142 occurrences, first GEN.38.12; Childs 2000, p. 36: càànndó</text></form></note>
  </entry>
  <entry id="caaŋoo_135">
    <lexical-unit><form lang="kqs"><text>caaŋoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>caaŋaa</text></form></field>
    <sense id="caaŋoo_135_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>compagnon, ami</text></gloss>
      <gloss lang="en"><text>companion, friend</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>friend, companion (plural form)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 2SA.15.37; Childs 2000, p. 36: cààŋàá</text></form></note>
  </entry>
  <entry id="caaɲɛi_136">
    <lexical-unit><form lang="kqs"><text>caaɲɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="caaɲɛi_136_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amitié</text></gloss>
      <gloss lang="en"><text>friendship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>friendship; friend, lover</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Tyaanyèi; Childs 2000, p. 39: càɲèí</text></form></note>
    <note><form lang="fr"><text>La Bible a caando « ami », pluriel caanda.</text></form></note>
  </entry>
  <entry id="calaa_137">
    <lexical-unit><form lang="kqs"><text>calaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cal</text></form></variant>
    <variant><form lang="kqs"><text>calnin</text></form></variant>
    <sense id="calaa_137_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>habiter, demeurer, s'asseoir</text></gloss>
      <gloss lang="en"><text>dwell, stay, sit</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
      <trait name="semantic-domain-ddp4" value="7.1.2 Sit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sit, be seated; stay, live</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.4.14; Childs 2000, p. 37: càllé</text></form></note>
  </entry>
  <entry id="cale tumnden_138">
    <lexical-unit><form lang="kqs"><text>cale tumnden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cale tumnden_138_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>papayer</text></gloss>
      <gloss lang="en"><text>papaya tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tyale tumnden</text></form></note>
    <note><form lang="fr"><text>Les deux mots sont dans la Bible, où cale désigne des ornements en forme de coloquintes (1KI.6.18).</text></form></note>
  </entry>
  <entry id="calen_139">
    <lexical-unit><form lang="kqs"><text>calen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="calen_139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>papaye</text></gloss>
      <gloss lang="en"><text>papaya</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>papaya; pumpkin; anything gourd-shaped</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tyalen; Childs 2000, p. 37: càléŋ</text></form></note>
  </entry>
  <entry id="calnun_140">
    <lexical-unit><form lang="kqs"><text>calnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="calnun_140_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'établir, se fixer</text></gloss>
      <gloss lang="en"><text>settle down</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.4.16</text></form></note>
    <note><form lang="fr"><text>Moyen de calaa « habiter ».</text></form></note>
  </entry>
  <entry id="caltan_141">
    <lexical-unit><form lang="kqs"><text>caltan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>calta</text></form></variant>
    <sense id="caltan_141_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>demeure, tente ; (Calta Mɛlɛka) le tabernacle</text></gloss>
      <gloss lang="en"><text>dwelling, tent; (Calta Mɛlɛka) the tabernacle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lodgings, settlements, living quarters</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first JOS.3.1; Childs 2000, p. 38: càltáŋ</text></form></note>
    <note><form lang="fr"><text>Lié à calaa « habiter ».</text></form></note>
  </entry>
  <entry id="camndo_142">
    <lexical-unit><form lang="kqs"><text>camndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="camndo_142_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>magie</text></gloss>
