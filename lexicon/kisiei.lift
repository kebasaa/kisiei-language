    <variant><form lang="kqs"><text>baŋan</text></form></variant>
    <sense id="baŋaa_30_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>délivrer, sauver</text></gloss>
      <gloss lang="en"><text>deliver, save, set free</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
