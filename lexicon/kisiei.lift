      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOB.29.11; Childs 2000, p. 38: càndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>O candu « il loue » (Gn 29,35, explication du nom de Juda).</text></form></note>
  </entry>
  <entry id="canyɛi_388">
