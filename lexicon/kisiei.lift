      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rub (in), apply</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.29.16; Childs 2000, p. 346: sùùwó</text></form></note>
    <note><form lang="fr"><text>kɔlan Yeesu suiyo « aller oindre Jésus » (Mc 16,1) ; sɔɔlɛmaa suiyo « se moquer de » (Mt 27,31).</text></form></note>
  </entry>
