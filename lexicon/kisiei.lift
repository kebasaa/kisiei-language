  <entry id="sambaa_4385">
    <lexical-unit><form lang="kqs"><text>sambaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sambaa_4385_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadeau</text></gloss>
      <gloss lang="en"><text>gift</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sanbaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit sanbaa ; la Bible n'écrit jamais nb.</text></form></note>
  </entry>
  <entry id="sambillo_4386">
    <lexical-unit><form lang="kqs"><text>sambillo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sambilo</text></form></variant>
    <variant><form lang="kqs"><text>sambele</text></form></variant>
    <sense id="sambillo_4386_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rite d'excision, initiation (du Nord)</text></gloss>
      <gloss lang="en"><text>excision rite, initiation (in the North)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 87: sambele, sambilo, sambillo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 87 : se dit aussi birile ; tomale sambilo « initiation » (N.).</text></form></note>
  </entry>
