      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se faner, se flétrir</text></gloss>
      <gloss lang="en"><text>wither, fade</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 1KI.8.37</text></form></note>
    <note><form lang="fr"><text>ɲɔfɔlɛiya « flétris » (ISA.64.5).</text></form></note>
  </entry>
  <entry id="ɲɔla_2077">
    <lexical-unit><form lang="kqs"><text>ɲɔla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɔla_2077_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre une poignée de, puiser à pleine main</text></gloss>
      <gloss lang="en"><text>take a handful of, scoop up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pinch; give someone a small portion</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.2.7; Childs 2000, p. 281: ɲɔ̀làá</text></form></note>
  </entry>
  <entry id="ɲɔɔloo_2078">
    <lexical-unit><form lang="kqs"><text>ɲɔɔloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲɔɔlu</text></form></variant>
    <sense id="ɲɔɔloo_2078_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supplier ; consoler</text></gloss>
      <gloss lang="en"><text>beg, entreat; comfort</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>beg, beseech, ask forgiveness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.24.67; Childs 2000, p. 281: ɲɔ̀ɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La forme longue sert aussi de nom : « consolation » (Gn 24,67).</text></form></note>
  </entry>
  <entry id="ɲɔɔmɛɔ_2079">
    <lexical-unit><form lang="kqs"><text>ɲɔɔmɛɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɔɔmɛɛa</text></form></field>
    <variant><form lang="kqs"><text>ɲɔɔmɛɛ</text></form></variant>
    <variant><form lang="kqs"><text>ɲɔɔmɛaa</text></form></variant>
    <sense id="ɲɔɔmɛɔ_2079_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chameau</text></gloss>
      <gloss lang="en"><text>camel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.24.64; Childs 2000, p. 281: ɲɔ̀míó</text></form></note>
  </entry>
  <entry id="ɲɛ_2080">
    <lexical-unit><form lang="kqs"><text>ɲɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɛlan</text></form></field>
    <variant><form lang="kqs"><text>ɲɛm</text></form></variant>
    <variant><form lang="kqs"><text>ɲɛla</text></form></variant>
    <sense id="ɲɛ_2080_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose ; ce que</text></gloss>
      <gloss lang="en"><text>thing; what, that which</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thing, something (ɲɛ̀- in compounds)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4401 occurrences, first GEN.1.2; Childs 2000, p. 281: ɲɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>ɲɛla ɲaananndan « chars » (2 S 10,18).</text></form></note>
  </entry>
  <entry id="ɲɛ cɔwvo_2081">
    <lexical-unit><form lang="kqs"><text>ɲɛ cɔwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɛm cɔwvon</text></form></field>
    <sense id="ɲɛ cɔwvo_2081_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arme ; armement (pl.)</text></gloss>
      <gloss lang="en"><text>weapon; weapons</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Nyètyöwvo</text></form></note>
    <note><form lang="fr"><text>Keita écrit en un mot Nyètyöwvo « l'arme » et Nyèmtyöwvon « l'armement » (p. 156) ; la Bible écrit ɲɛm cɔwvon (Nb 31,3).</text></form></note>
  </entry>
  <entry id="ɲɛ-tengaa_2082">
    <lexical-unit><form lang="kqs"><text>ɲɛ-tengaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ-tengaa_2082_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lumière</text></gloss>
      <gloss lang="en"><text>light</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 214 occurrences, first GEN.1.4; Keita 1979, p. 154: Nyètengaa</text></form></note>
  </entry>
  <entry id="ɲɛ-ɲɛ_2083">
    <lexical-unit><form lang="kqs"><text>ɲɛ-ɲɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ-ɲɛ_2083_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>quelque chose ; (nég.) rien</text></gloss>
      <gloss lang="en"><text>anything; (neg.) nothing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 941 occurrences, first GEN.1.2</text></form></note>
  </entry>
  <entry id="ɲɛdiaa_2084">
    <lexical-unit><form lang="kqs"><text>ɲɛdiaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="ɲɛdiaa_2084_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture</text></gloss>
      <gloss lang="en"><text>food</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 541 occurrences, first GEN.3.17; Childs 2000, p. 276: ɲɛ̀dìáá</text></form></note>
    <note><form lang="fr"><text>De ɲɛ « chose » et dioo « manger ».</text></form></note>
  </entry>
  <entry id="ɲɛkɛndɛi_2085">
    <lexical-unit><form lang="kqs"><text>ɲɛkɛndɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛkɛndɛi_2085_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bien, en sûreté</text></gloss>
      <gloss lang="en"><text>well, safely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>well, thoroughly, completely</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 248 occurrences, first GEN.3.5; Childs 2000, p. 277: ɲɛ̀-kɛ̀ndɛ̀</text></form></note>
  </entry>
  <entry id="ɲɛmahiloo_2086">
    <lexical-unit><form lang="kqs"><text>ɲɛmahiloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲɛmahilu</text></form></variant>
    <sense id="ɲɛmahiloo_2086_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mets, plat savoureux (gibier)</text></gloss>
      <gloss lang="en"><text>savoury dish, tasty food (game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.27.3</text></form></note>
    <note><form lang="fr"><text>ɲɛmahilu ledoosoo « du gibier » (GEN.25.28).</text></form></note>
  </entry>
  <entry id="ɲɛsuan_2087">
    <lexical-unit><form lang="kqs"><text>ɲɛsuan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="ɲɛsuan_2087_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tendons, nerfs (pl.) ; spasmes, douleurs (ISA.13.8)</text></gloss>
      <gloss lang="en"><text>sinews, tendons (pl.); pangs (ISA.13.8)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>veins (plural of ɲɛ̀súléŋ 'vein')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.10.11; Childs 2000, p. 278: ɲɛ̀súáŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé. má toosiaa ya paalan a ɲɛsuan « tu m'as tissé d'os et de nerfs » (JOB.10.11).</text></form></note>
  </entry>
</lift>
