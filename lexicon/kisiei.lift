    <trait name="status" value="southern"/>
    <sense id="kííbɔ̀ŋíìyó_1345_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tomate</text></gloss>
      <gloss lang="en"><text>tomato</text></gloss>
