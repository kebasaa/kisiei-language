    <trait name="status" value="southern"/>
    <sense id="làbɛ́ŋù-níŋndó_1963_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« entre les jambes » : euphémisme pour les parties génitales</text></gloss>
      <gloss lang="en"><text>'between the legs': euphemism for the genitals</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 221: làbɛ́ŋù-níŋndó</text></form></note>
  </entry>
