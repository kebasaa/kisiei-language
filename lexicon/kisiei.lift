    <trait name="status" value="respelled"/>
    <sense id="ɲali_5021_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(adverbe de degré)</text></gloss>
      <gloss lang="en"><text>(adverb of degree)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 38: ɲali</text></form></note>
    <note><form lang="fr"><text>Le Lexique ne donne pas le sens précis.</text></form></note>
