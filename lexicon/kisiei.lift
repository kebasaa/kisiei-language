      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ver des lits souillés d'urine</text></gloss>
      <gloss lang="en"><text>worm found in beds often urinated on</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 232: lòmsóó</text></form></note>
  </entry>
