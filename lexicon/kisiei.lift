  <entry id="pelten_1268">
    <lexical-unit><form lang="kqs"><text>pelten</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>peltan</text></form></field>
    <variant><form lang="kqs"><text>pelta</text></form></variant>
    <sense id="pelten_1268_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>œuf</text></gloss>
      <gloss lang="en"><text>egg</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>egg; any egg-shaped object, e.g. a lamp chimney or a hernia</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Pelten; Childs 2000, p. 292: pèltéŋ</text></form></note>
    <note><form lang="fr"><text>La Bible a le pluriel peltan et la forme radicale pelta (DEU.22.6).</text></form></note>
  </entry>
  <entry id="pemalen_1269">
    <lexical-unit><form lang="kqs"><text>pemalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pemale</text></form></variant>
    <variant><form lang="kqs"><text>pemama</text></form></variant>
    <sense id="pemalen_1269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sentier, chemin, passage</text></gloss>
      <gloss lang="en"><text>path, track, way through</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>path or route through the bush; also the parting in someone's hair (slang)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.49.17; Childs 2000, p. 292: pèmáléŋ</text></form></note>
    <note><form lang="fr"><text>pemama ndɔan « ses sentiers » (Pr 3,17).</text></form></note>
  </entry>
  <entry id="pembei_1270">
    <lexical-unit><form lang="kqs"><text>pembei</text></form></lexical-unit>
