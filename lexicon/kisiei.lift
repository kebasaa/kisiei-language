    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lèùwè_2421_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (qui sèche lentement)</text></gloss>
      <gloss lang="en"><text>kind of tree (slow to dry)</text></gloss>
