  <entry id="viovɔɔ_3632">
    <lexical-unit><form lang="kqs"><text>viovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viow</text></form></variant>
    <variant><form lang="kqs"><text>viaw</text></form></variant>
    <variant><form lang="kqs"><text>viawnin</text></form></variant>
    <sense id="viovɔɔ_3632_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, jeter, lancer</text></gloss>
      <gloss lang="en"><text>put, throw, cast</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stay in one place for a long time; (benefactive) throw away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.32.1; Childs 2000, p. 387: wìòùwó</text></form></note>
    <note><form lang="fr"><text>viow kponyoo « pousser des cris de joie » (Ps 33,1) ; viaw … taw « séjourner longtemps » (Gn 21,34).</text></form></note>
  </entry>
  <entry id="visiei_3633">
