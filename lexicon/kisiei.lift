      <gloss lang="fr"><text>fête, festin</text></gloss>
      <gloss lang="en"><text>feast, festival</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.29.22</text></form></note>
