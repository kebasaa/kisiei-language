      <gloss lang="fr"><text>riz non battu</text></gloss>
      <gloss lang="en"><text>unthreshed rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 240: màlìkpáléí</text></form></note>
