  <entry id="kɔllo_896">
    <lexical-unit><form lang="kqs"><text>kɔllo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kɔltan</text></form></field>
    <variant><form lang="kqs"><text>kɔl</text></form></variant>
    <variant><form lang="kqs"><text>kɔlta</text></form></variant>
    <sense id="kɔllo_896_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cœur ; esprit, for intérieur</text></gloss>
      <gloss lang="en"><text>heart ; heart; spirit, inner self</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="3.1 Soul, spirit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heart; seat of the feelings, mind, soul</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 472 occurrences, first GEN.21.11; Keita 1979, p. 131: Köllo; Childs 2000, p. 182: kɔ̀lló</text></form></note>
    <note><form lang="fr"><text>Kɔl Hala « l'Esprit de Dieu » (Gn 1,2). Base de nombreux composés : kɔlkɛndɔɔ, kɔlɲuloo, kɔltuwvo, kɔlvesɛiyo, kɔlkaloo, kɔlkɛsiaa.</text></form></note>
  </entry>
  <entry id="kɔltuwvo_897">
