      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>feast, party, celebration, especially at someone's death</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.13.9; Childs 2000, p. 91: dúɲéí</text></form></note>
