      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cacher</text></gloss>
      <gloss lang="en"><text>hide (something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.2.2; Childs 2000, p. 387: wìòŋɔ̀ɔ́</text></form></note>
