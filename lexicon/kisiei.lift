      <gloss lang="fr"><text>cuillère</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kuruo</text></form></note>
  </entry>
  <entry id="kulutu-kulutu_2099">
    <lexical-unit><form lang="kqs"><text>kulutu-kulutu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kulutu-kulutu_2099_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de souris ou de cafards qui mangent, de soldats qui marchent</text></gloss>
      <gloss lang="en"><text>noise of mice or cockroaches eating, of soldiers marching</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 31: kurutu-kurutu</text></form></note>
  </entry>
  <entry id="kumbanndo_2100">
    <lexical-unit><form lang="kqs"><text>kumbanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kumbannda</text></form></field>
    <variant><form lang="kqs"><text>kumbannda</text></form></variant>
    <variant><form lang="kqs"><text>kumbanndan</text></form></variant>
    <sense id="kumbanndo_2100_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aile</text></gloss>
      <gloss lang="en"><text>wing</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wing of a bird or of an airplane</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first RUT.2.12; Keita 1979, p. 136: Kumbanndo; Lexique kissi–français, p. 30: kunbanndo; Childs 2000, p. 194: kùmbǎŋndó</text></form></note>
  </entry>
  <entry id="kumbi la lɔlle_2101">
    <lexical-unit><form lang="kqs"><text>kumbi la lɔlle</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kumbi la lɔlle_2101_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>quartier</text></gloss>
      <gloss lang="en"><text>quarter (of a town)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kunbi la lɔlle</text></form></note>
    <note><form lang="fr"><text>Analyse obscure ; écrit kunbi la lɔlle.</text></form></note>
  </entry>
  <entry id="kumbin_2102">
    <lexical-unit><form lang="kqs"><text>kumbin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kumbin_2102_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'ouvrir</text></gloss>
      <gloss lang="en"><text>be opened, open</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.3.5</text></form></note>
    <note><form lang="fr"><text>Moyen de kumbio « ouvrir ».</text></form></note>
  </entry>
  <entry id="kumbio_2103">
    <lexical-unit><form lang="kqs"><text>kumbio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kumbi</text></form></variant>
    <variant><form lang="kqs"><text>kumbiaa</text></form></variant>
    <sense id="kumbio_2103_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir</text></gloss>
      <gloss lang="en"><text>open</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>open; cover</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.7; Lexique kissi–français, p. 30: kunbio/ kunbi; Childs 2000, p. 198: kùmbìó</text></form></note>
  </entry>
  <entry id="kùmbùèí_2104">
    <lexical-unit><form lang="kqs"><text>kùmbùèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kùmbɔ̃ŋ</text></form></field>
    <sense id="kùmbùèí_2104_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté (d'une route, d'un mur)</text></gloss>
      <gloss lang="en"><text>side (of a road or wall)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 194: kùmbùèí kùmbɔ̃ŋ</text></form></note>
  </entry>
  <entry id="kumbullen_2105">
    <lexical-unit><form lang="kqs"><text>kumbullen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="kumbullen_2105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de fruit qui pousse au sol</text></gloss>
      <gloss lang="en"><text>kind of fruit growing on the ground</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kunbullen</text></form></note>
  </entry>
  <entry id="kumbuo_2106">
    <lexical-unit><form lang="kqs"><text>kumbuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kumbuo_2106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couvercle, bouchon ; couverture</text></gloss>
      <gloss lang="en"><text>lid, stopper; cover, blanket</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Kumbuo; Lexique kissi–français, p. 30: kunbuo; Childs 2000, p. 194: kùmbòó</text></form></note>
    <note><form lang="fr"><text>Même racine que le verbe kumbuu « couvrir ».</text></form></note>
  </entry>
  <entry id="kumbɔɔ_2107">
    <lexical-unit><form lang="kqs"><text>kumbɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kumbu</text></form></variant>
    <variant><form lang="kqs"><text>kumbunin</text></form></variant>
    <variant><form lang="kqs"><text>kumbun</text></form></variant>
    <sense id="kumbɔɔ_2107_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couvrir ; enterrer ; cacher</text></gloss>
      <gloss lang="en"><text>cover; bury; hide</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first GEN.23; Lexique kissi–français, p. 30: kunbɔɔ/ kunbu; Childs 2000, p. 194: kùmbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kumnde_2108">
    <lexical-unit><form lang="kqs"><text>kumnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kumnde_2108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fumée ; nuée</text></gloss>
      <gloss lang="en"><text>smoke; cloud</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.19.28; Lexique kissi–français, p. 30: kumnde</text></form></note>
  </entry>
  <entry id="kumtulen_2109">
    <lexical-unit><form lang="kqs"><text>kumtulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="kumtulen_2109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fougère</text></gloss>
      <gloss lang="en"><text>fern</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Kumtulen; Lexique kissi–français, p. 30: kumtulen</text></form></note>
  </entry>
  <entry id="kumɔɔ_2110">
    <lexical-unit><form lang="kqs"><text>kumɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kumɔɔ_2110_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de fruit rouge (graines très sucrées à l'intérieur)</text></gloss>
      <gloss lang="en"><text>kind of red fruit (very sweet seeds inside)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kumɔɔ</text></form></note>
  </entry>
  <entry id="kundaa_2111">
    <lexical-unit><form lang="kqs"><text>kundaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kundalan</text></form></field>
    <variant><form lang="kqs"><text>kunda</text></form></variant>
    <variant><form lang="kqs"><text>kundala</text></form></variant>
    <sense id="kundaa_2111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>groupe, troupe, camp ; tas, monceau ; (pl.) parts</text></gloss>
      <gloss lang="en"><text>group, company, camp; heap, pile; (pl.) parts, portions</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.17.5; Childs 2000, p. 195: kúndàá</text></form></note>
    <note><form lang="fr"><text>má dii lan kundaa « ils en firent un monceau » (Gn 31,46) ; piɔw … kundalan « diviser en groupes » (Gn 32,8).</text></form></note>
  </entry>
  <entry id="kùndàá_2112">
    <lexical-unit><form lang="kqs"><text>kùndàá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kùndàá_2112_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grand, important, honoré</text></gloss>
      <gloss lang="en"><text>great, important, honoured</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be enough, be plentiful; grow fat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.17.5; Lexique kissi–français, p. 30: kundaa/ kunda; Childs 2000, p. 195: kùndàá</text></form></note>
    <note><form lang="fr"><text>Écrit kùndàá dans ce sens : vanaa kùndàá « les notables » (Gn 50,7) ; vana kúndàá bɛndoo « un homme très considéré » (Ex 11,3). Lexique kissi–français, p. 30 : kundaa/ kunda « grandir, grossir » (verbe).</text></form></note>
  </entry>
  <entry id="kunde_2113">
    <lexical-unit><form lang="kqs"><text>kunde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kundie</text></form></variant>
    <sense id="kunde_2113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>morceau de brique</text></gloss>
      <gloss lang="en"><text>piece of brick</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kunde</text></form></note>
    <note><form lang="fr"><text>Aussi kundie (p. 30).</text></form></note>
  </entry>
  <entry id="kundei_2114">
    <lexical-unit><form lang="kqs"><text>kundei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="kundei_2114_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>motte de terre ; (parler de Guéckédou) matrice</text></gloss>
      <gloss lang="en"><text>clod of earth; (Guéckédou dialect) womb</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cervix</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 8: Kundei; Childs 2000, p. 195: kúndéí kúndóŋ</text></form></note>
    <note><form lang="fr"><text>Keita (p. 8) le cite comme exemple de mot dont le sens change selon le parler : « motte de terre » en kisiduei, « matrice » en kpekeduei (Guéckédou), sens proche de celui de Childs.</text></form></note>
  </entry>
  <entry id="kundianndo_2115">
    <lexical-unit><form lang="kqs"><text>kundianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kundianndo_2115_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fier, vantard</text></gloss>
      <gloss lang="en"><text>proud, boastful</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kundianndo</text></form></note>
  </entry>
  <entry id="kundio_2116">
    <lexical-unit><form lang="kqs"><text>kundio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kundi</text></form></variant>
    <sense id="kundio_2116_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trépigner</text></gloss>
      <gloss lang="en"><text>stamp one's feet</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kundio/ kundi</text></form></note>
  </entry>
  <entry id="kunduvaa_2117">
    <lexical-unit><form lang="kqs"><text>kunduvaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kundua</text></form></variant>
    <sense id="kunduvaa_2117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marteau</text></gloss>
      <gloss lang="en"><text>hammer</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>blacksmith's large hammer; also a kind of potion</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.4.21; Keita 1979, p. 159: Kunduvaa; Lexique kissi–français, p. 30: kunduvaa; Childs 2000, p. 196: kúndùwáá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 30 : aussi kundua « le marteau » (JER.51.20).</text></form></note>
  </entry>
  <entry id="kundɔɔ_2118">
    <lexical-unit><form lang="kqs"><text>kundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kundu</text></form></variant>
    <sense id="kundɔɔ_2118_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>heurter, frapper ; encorner ; frapper du poing, boxer</text></gloss>
      <gloss lang="en"><text>strike, push against; gore, butt; punch, box</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hit, knock, bump into; also knock on a door</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.21.22; Lexique kissi–français, p. 30: kundɔɔ/ kundu; Childs 2000, p. 195: kùndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kundɛiyo_2119">
    <lexical-unit><form lang="kqs"><text>kundɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kundɛiyo_2119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dimanche</text></gloss>
      <gloss lang="en"><text>Sunday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.28.1; Keita 1979, p. 152: Kundèiyo; Lexique kissi–français, p. 30: kundɛiyo</text></form></note>
  </entry>
  <entry id="kunga_2120">
    <lexical-unit><form lang="kqs"><text>kunga</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kunga_2120_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>clôturer, entourer</text></gloss>
      <gloss lang="en"><text>enclose, fence in</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first EXO.27.9; Childs 2000, p. 196: kùŋgàá</text></form></note>
  </entry>
  <entry id="kungaa_2121">
    <lexical-unit><form lang="kqs"><text>kungaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kungalan</text></form></field>
    <sense id="kungaa_2121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clôture, palissade ; mur, barrière</text></gloss>
      <gloss lang="en"><text>fence, enclosure; wall, fence</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.49.22; Keita 1979, p. 142: Kungaa; Lexique kissi–français, p. 30: kungaa; Childs 2000, p. 196: kùŋgàá</text></form></note>
  </entry>
  <entry id="kungaa_2122">
    <lexical-unit><form lang="kqs"><text>kungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kunga</text></form></variant>
    <variant><form lang="kqs"><text>kunganin</text></form></variant>
    <sense id="kungaa_2122_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>clôturer, entourer ; clôture, mur</text></gloss>
      <gloss lang="en"><text>fence in, enclose; fence, wall</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fence, erect a fence</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.49.22; Keita 1979, p. 110: Kungaa; Lexique kissi–français, p. 30: kungaa/ kunga; Childs 2000, p. 196: kùŋgàá</text></form></note>
    <note><form lang="fr"><text>kungaa est aussi le nom « mur, clôture » (GEN 49,22 ; NUM 22,25).</text></form></note>
  </entry>
  <entry id="kungula_2123">
    <lexical-unit><form lang="kqs"><text>kungula</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kungula_2123_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>butter (les plants), faire un tertre autour</text></gloss>
      <gloss lang="en"><text>earth up (plants)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 30: kungula</text></form></note>
    <note><form lang="fr"><text>Forme courte (passé, inf.). Homographe de kungula (ISA.58.1), d'un autre sens.</text></form></note>
  </entry>
  <entry id="kungulaa_2124">
    <lexical-unit><form lang="kqs"><text>kungulaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kungulaa_2124_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>butter, faire des buttes</text></gloss>
      <gloss lang="en"><text>make mounds, ridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make heaps of dirt</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kungulaa; Childs 2000, p. 196: kùŋgùlàá</text></form></note>
    <note><form lang="fr"><text>kungulan dans la Bible (GEN 6,14 ; EXO 9,2) a d'autres sens.</text></form></note>
  </entry>
  <entry id="kunguma_2125">
