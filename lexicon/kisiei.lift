    <sense id="kpóŋndán_1955_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poutres</text></gloss>
      <gloss lang="en"><text>beams</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.6.9</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="kpóŋó-kpóŋó_1956">
    <lexical-unit><form lang="kqs"><text>kpóŋó-kpóŋó</text></form></lexical-unit>
