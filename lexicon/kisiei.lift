  <entry id="yúŋúlló_6266">
    <lexical-unit><form lang="kqs"><text>yúŋúlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yúŋúltáŋ</text></form></field>
