  <entry id="misimisio_2663">
    <lexical-unit><form lang="kqs"><text>misimisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="misimisio_2663_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>angoisse, effroi, désarroi</text></gloss>
      <gloss lang="en"><text>anguish, dismay, horror</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2SA.19.1</text></form></note>
    <note><form lang="fr"><text>Avec bii « saisir » : misimisio bii masaa David « le roi fut bouleversé » (2 S 19,1).</text></form></note>
  </entry>
  <entry id="misio_2664">
    <lexical-unit><form lang="kqs"><text>misio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>misi</text></form></variant>
    <sense id="misio_2664_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avaler</text></gloss>
      <gloss lang="en"><text>swallow</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MAT.23.24; Lexique kissi–français, p. 35: misio/ misi</text></form></note>
  </entry>
  <entry id="míŋgímáá_2665">
    <lexical-unit><form lang="kqs"><text>míŋgímáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="míŋgímáá_2665_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'abeille (qui pique)</text></gloss>
      <gloss lang="en"><text>kind of bee (stings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 250: míŋgímáá</text></form></note>
  </entry>
  <entry id="mìɔ̀ùwó_2666">
    <lexical-unit><form lang="kqs"><text>mìɔ̀ùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mìɔ̀ùwó_2666_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>nourrir (à la cuillère, à la main), gaver</text></gloss>
      <gloss lang="en"><text>feed (by spoon or hand), force-feed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 251: mìɔ̀ùwó</text></form></note>
  </entry>
  <entry id="miɔw_2667">
    <lexical-unit><form lang="kqs"><text>miɔw</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="miɔw_2667_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être à terme (grossesse)</text></gloss>
      <gloss lang="en"><text>be due (pregnancy)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Miöw; Lexique kissi–français, p. 35: miɔu/ mɛ, miɔ, mia</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : foli miaa « près d'accoucher » (1SA 4,19). Lexique kissi–français, p. 35 : radicaux mɛ, miɔ, mia.</text></form></note>
  </entry>
  <entry id="mìɔ́ɔ́_2668">
    <lexical-unit><form lang="kqs"><text>mìɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mìɔ́ɔ́_2668_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>stade de l'accouchement (fin de grossesse)</text></gloss>
      <gloss lang="en"><text>delivery stage of pregnancy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 250: mìɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Cf. miɔw « être à terme » (Keita).</text></form></note>
  </entry>
  <entry id="mòtóó_2669">
    <lexical-unit><form lang="kqs"><text>mòtóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mòtóláŋ</text></form></field>
    <sense id="mòtóó_2669_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moteur</text></gloss>
      <gloss lang="en"><text>motor, engine</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 251: mòtóó</text></form></note>
    <note><form lang="fr"><text>Emprunt au français moteur.</text></form></note>
  </entry>
  <entry id="moyaa_2670">
    <lexical-unit><form lang="kqs"><text>moyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>moya</text></form></variant>
    <sense id="moyaa_2670_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se noyer ; disparaître au tournant</text></gloss>
      <gloss lang="en"><text>drown; disappear round a bend</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: moyaa/ moya</text></form></note>
  </entry>
  <entry id="múí_2671">
    <lexical-unit><form lang="kqs"><text>múí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="múí_2671_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>durement, vivement (pincer)</text></gloss>
      <gloss lang="en"><text>hard, sharply (of pinching)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 254: múí</text></form></note>
  </entry>
  <entry id="muinda_2672">
    <lexical-unit><form lang="kqs"><text>muinda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="muinda_2672_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>naissance, accouchement</text></gloss>
      <gloss lang="en"><text>birth, childbirth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: muinda</text></form></note>
  </entry>
  <entry id="muiyo_2673">
    <lexical-unit><form lang="kqs"><text>muiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>muiya</text></form></field>
    <sense id="muiyo_2673_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustique ; moucheron</text></gloss>
      <gloss lang="en"><text>mosquito; gnat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Muiyo; Lexique kissi–français, p. 35: muiyo; Childs 2000, p. 254: mùìyó</text></form></note>
    <note><form lang="fr"><text>Le pluriel muiya traduit dans la Bible les moucherons de la troisième plaie d'Égypte (EXO.8.12-14). Lexique kissi–français, p. 36 : aussi muyo « le moustique ».</text></form></note>
  </entry>
  <entry id="mulinndo_2674">
    <lexical-unit><form lang="kqs"><text>mulinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mulin</text></form></variant>
    <variant><form lang="kqs"><text>mulinin</text></form></variant>
    <sense id="mulinndo_2674_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tourner (vers), retourner ; recommencer, refaire</text></gloss>
      <gloss lang="en"><text>turn (to), go back; do again</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 1SA.8.8; Lexique kissi–français, p. 35: mulinndo/ mulin</text></form></note>
  </entry>
  <entry id="mulio_2675">
    <lexical-unit><form lang="kqs"><text>mulio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muli</text></form></variant>
    <variant><form lang="kqs"><text>mulinin</text></form></variant>
    <sense id="mulio_2675_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répondre ; tourner, se tourner ; (nom) réponse</text></gloss>
      <gloss lang="en"><text>answer; turn; (noun) answer</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>turn over; reply</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first 2SA.14.20; Keita 1979, p. 110: Mulio; Lexique kissi–français, p. 35: mulio/ muli; Childs 2000, p. 254: mùlìó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 35 : aussi « la réponse ».</text></form></note>
  </entry>
  <entry id="muloo_2676">
    <lexical-unit><form lang="kqs"><text>muloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="muloo_2676_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>impôt, tribut ; rançon</text></gloss>
      <gloss lang="en"><text>tax, tribute; ransom</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first EXO.30; Keita 1979, p. 148: Muloo; Lexique kissi–français, p. 35: muloo</text></form></note>
  </entry>
  <entry id="muluanndo_2677">
    <lexical-unit><form lang="kqs"><text>muluanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="muluanndo_2677_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>perfide, hypocrite</text></gloss>
      <gloss lang="en"><text>treacherous, hypocritical</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.3.11; Lexique kissi–français, p. 60: vana muluanndo</text></form></note>
    <note><form lang="fr"><text>Yuda muluanndo « Juda la perfide » (JER.3.11). Le Lexique : vana muluanndo « qqn qui déforme les paroles, un hypocrite ».</text></form></note>
  </entry>
  <entry id="mulullo_2678">
    <lexical-unit><form lang="kqs"><text>mulullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mulul</text></form></variant>
    <variant><form lang="kqs"><text>mululnin</text></form></variant>
    <sense id="mulullo_2678_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répondre à ; se tourner vers</text></gloss>
      <gloss lang="en"><text>answer someone; turn to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.45.3; Keita 1979, p. 110: Mulullo; Lexique kissi–français, p. 35: mulullo/ mulul</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de mulio.</text></form></note>
  </entry>
  <entry id="múlúlú_2679">
    <lexical-unit><form lang="kqs"><text>múlúlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="múlúlú_2679_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>réduit en poudre, pulvérisé</text></gloss>
      <gloss lang="en"><text>ground into powder, pulverized</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 254: múlúlú</text></form></note>
  </entry>
  <entry id="mulumulun_2680">
    <lexical-unit><form lang="kqs"><text>mulumulun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mulumulu</text></form></variant>
    <sense id="mulumulun_2680_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rouler, se retourner (sans cesse), se tordre ; (mulumulu) faire rouler, retourner</text></gloss>
      <gloss lang="en"><text>roll over, toss and turn, writhe; (mulumulu) roll, turn over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>roll oneself over; repeat one's words</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JDG.5.27; Childs 2000, p. 255: mùlùmùlɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>vana siɛlɛiyo mulumulun o ndu lo kpele « le paresseux se retourne sur son lit » (PRO.26.14) ; O co nɔm mulumulu « il te fera rouler » (ISA.22.18). Cf. mulio « tourner ».</text></form></note>
  </entry>
  <entry id="mun_2681">
    <lexical-unit><form lang="kqs"><text>mun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mun_2681_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces (pluriel en -on)</text></gloss>
      <gloss lang="en"><text>these, those (-on plural)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1752 occurrences, first GEN.1.14; Lexique kissi–français, p. 35: mun; Childs 2000, p. 255: mùŋ</text></form></note>
  </entry>
  <entry id="mundoo_2682">
    <lexical-unit><form lang="kqs"><text>mundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mundu</text></form></variant>
    <sense id="mundoo_2682_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nuque ; dos</text></gloss>
      <gloss lang="en"><text>nape of the neck; back</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nape of the neck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EXO.33.23; Keita 1979, p. 132: Munduo; Lexique kissi–français, p. 35: munduo; Childs 2000, p. 255: mùndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mungén_2683">
    <lexical-unit><form lang="kqs"><text>mungén</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mungén_2683_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>complètement, entièrement (détruit, consumé)</text></gloss>
      <gloss lang="en"><text>completely, utterly (destroyed, burnt up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 2SA.14.7</text></form></note>
    <note><form lang="fr"><text>Après cuulu « brûler » ou cuu « périr » : má cuulu mungén « il les a entièrement consumés » (Jb 1,16).</text></form></note>
  </entry>
  <entry id="munguo_2684">
    <lexical-unit><form lang="kqs"><text>munguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="munguo_2684_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poudre</text></gloss>
      <gloss lang="en"><text>powder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: munguo</text></form></note>
  </entry>
  <entry id="mungɔɔ_2685">
    <lexical-unit><form lang="kqs"><text>mungɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mungu</text></form></variant>
    <sense id="mungɔɔ_2685_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se retourner</text></gloss>
      <gloss lang="en"><text>turn round</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mungɔɔ/ mungu</text></form></note>
  </entry>
  <entry id="musuario_2686">
    <lexical-unit><form lang="kqs"><text>musuario</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="musuario_2686_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouchoir</text></gloss>
      <gloss lang="en"><text>handkerchief</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: musuario</text></form></note>
    <note><form lang="fr"><text>Emprunt (français mouchoir) ; r gardé comme dans les emprunts.</text></form></note>
  </entry>
  <entry id="músúkú_2687">
    <lexical-unit><form lang="kqs"><text>músúkú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="músúkú_2687_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en petits morceaux ; (sable) fin</text></gloss>
      <gloss lang="en"><text>in small pieces; (sand) fine</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: músúkú</text></form></note>
  </entry>
  <entry id="mutarde_2688">
    <lexical-unit><form lang="kqs"><text>mutarde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mutarde_2688_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moutarde</text></gloss>
      <gloss lang="en"><text>mustard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first MAT.13</text></form></note>
    <note><form lang="fr"><text>Emprunt (français) ; kulii mutarde « graine de moutarde ».</text></form></note>
  </entry>
  <entry id="mùùláŋndó_2689">
    <lexical-unit><form lang="kqs"><text>mùùláŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mùùláŋndó_2689_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, poser</text></gloss>
      <gloss lang="en"><text>put</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: mùùláŋndó</text></form></note>
  </entry>
  <entry id="muulianndo_2690">
    <lexical-unit><form lang="kqs"><text>muulianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muulian</text></form></variant>
    <sense id="muulianndo_2690_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mélanger, mêler ; joindre, associer</text></gloss>
      <gloss lang="en"><text>mix, mingle; join together, combine</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) a mixture, derived from 'turn'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.2.2; Childs 2000, p. 254: mùlìàŋndó</text></form></note>
    <note><form lang="fr"><text>mɔima niaan ma muulian a mɛnndan « ton vin est coupé d'eau » (Es 1,22) ; La bɛnda mì la muulian cɔlua … le « n'accouple pas des bêtes d'espèces différentes » (Lv 19,19). Peut-être apparenté à mulio « tourner » (Childs).</text></form></note>
  </entry>
  <entry id="muuluanndo_2691">
    <lexical-unit><form lang="kqs"><text>muuluanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>muuluannda</text></form></field>
    <sense id="muuluanndo_2691_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hypocrite, homme fourbe</text></gloss>
      <gloss lang="en"><text>hypocrite, deceitful person</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.22.27</text></form></note>
    <note><form lang="fr"><text>Apparenté à muuluo « retourner ». muulɔnndo « hypocrisie, fausseté ; tortueux » (Rm 12,9 ; 2 S 22,27).</text></form></note>
  </entry>
  <entry id="muuluo_2692">
    <lexical-unit><form lang="kqs"><text>muuluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>muulu</text></form></variant>
    <sense id="muuluo_2692_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retourner, renverser</text></gloss>
      <gloss lang="en"><text>turn over, overturn</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Muuluo; Lexique kissi–français, p. 36: muuluo/ muulu</text></form></note>
  </entry>
  <entry id="mùùlɛ̀múúlìáá_2693">
    <lexical-unit><form lang="kqs"><text>mùùlɛ̀múúlìáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mùùlɛ̀múúlìáá_2693_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piqûres de mouches</text></gloss>
      <gloss lang="en"><text>fly bites</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: mùùlɛ̀múúlìáá</text></form></note>
  </entry>
  <entry id="muungoo_2694">
    <lexical-unit><form lang="kqs"><text>muungoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>muungu</text></form></variant>
    <variant><form lang="kqs"><text>muungun</text></form></variant>
    <variant><form lang="kqs"><text>muungunin</text></form></variant>
    <sense id="muungoo_2694_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retourner, revenir</text></gloss>
      <gloss lang="en"><text>return, go back</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>return, go back; also retaliate, replace (variant mùùŋgóó)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.12.9; Childs 2000, p. 249: mìŋìó</text></form></note>
  </entry>
  <entry id="múúyɔ̀ŋ_2695">
    <lexical-unit><form lang="kqs"><text>múúyɔ̀ŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="múúyɔ̀ŋ_2695_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>farine de riz à grains durs et fins</text></gloss>
      <gloss lang="en"><text>rice flour of tiny hard grains</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 256: múúyɔ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Emprunt probable au mendé ; au Liberia kèŋèmùkíóó.</text></form></note>
  </entry>
  <entry id="mùúŋndɔ̀ɔ́_2696">
    <lexical-unit><form lang="kqs"><text>mùúŋndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mùúŋndɔ̀ɔ́_2696_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>deuxièmement</text></gloss>
      <gloss lang="en"><text>secondly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: mùúŋndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mùɛ̀-fàŋndé_2697">
    <lexical-unit><form lang="kqs"><text>mùɛ̀-fàŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="mùɛ̀-fàŋndé_2697_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épée de guerre (env. 60 cm)</text></gloss>
      <gloss lang="en"><text>war sword (about two feet long)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mùɛ̀-fàŋndé</text></form></note>
  </entry>
  <entry id="mùɛ̀ìmà-nɛ̀ìyáŋ_2698">
    <lexical-unit><form lang="kqs"><text>mùɛ̀ìmà-nɛ̀ìyáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="mùɛ̀ìmà-nɛ̀ìyáŋ_2698_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>whisky (« liqueur forte »)</text></gloss>
      <gloss lang="en"><text>whiskey ('strong liquor')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mùɛ̀ìmà-nɛ̀ìyáŋ</text></form></note>
  </entry>
  <entry id="mùɛ̀ìyáŋ_2699">
    <lexical-unit><form lang="kqs"><text>mùɛ̀ìyáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="mùɛ̀ìyáŋ_2699_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>culpabilité ; (cìŋàá mùɛ̀ìyáŋ) plaider non coupable</text></gloss>
      <gloss lang="en"><text>guilt; (cìŋàá mùɛ̀ìyáŋ) plead innocence</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 254: mùɛ̀ìyáŋ</text></form></note>
    <note><form lang="fr"><text>Homonyme de mùɛ̀ìyáŋ « boisson alcoolisée » (cf. mɔiyan « vin », Bible) : autrefois on offrait de l'alcool au chef pour faire juger une affaire.</text></form></note>
  </entry>
  <entry id="muɛɛn_2700">
    <lexical-unit><form lang="kqs"><text>muɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="muɛɛn_2700_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entièrement, tous sans exception</text></gloss>
      <gloss lang="en"><text>completely, every one</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>all, completely</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JDG.5.31; Childs 2000, p. 253: múɛ́ɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : màá yaamɔaa nɔmnda cuu lende muɛɛn « que tous tes ennemis périssent ainsi » (JDG.5.31).</text></form></note>
  </entry>
  <entry id="múɛ̀ɛ̀ŋ_2701">
    <lexical-unit><form lang="kqs"><text>múɛ̀ɛ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="múɛ̀ɛ̀ŋ_2701_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(rire) doucement ; (presser) fermement</text></gloss>
      <gloss lang="en"><text>(laugh) softly; (press) firmly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: múɛ̀ɛ̀ŋ</text></form></note>
  </entry>
  <entry id="mɔ́fíɔ́ɔ́_2702">
    <lexical-unit><form lang="kqs"><text>mɔ́fíɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ́fíɔ́ɔ́_2702_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joues gonflées, grosses joues</text></gloss>
      <gloss lang="en"><text>swollen or fat cheeks</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 251: mɔ́fíɔ́ɔ́</text></form></note>
  </entry>
  <entry id="mɔikpɛnɛnɔɔ_2703">
    <lexical-unit><form lang="kqs"><text>mɔikpɛnɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="mɔikpɛnɛnɔɔ_2703_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>albinos</text></gloss>
      <gloss lang="en"><text>albino</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Möikpènènöö; Lexique kissi–français, p. 35: mɔikpɛnɛnɔɔ; Childs 2000, p. 246: mɛ́kpɛ́nɔ́ɔ́</text></form></note>
  </entry>
  <entry id="mɔima vawvan_2704">
    <lexical-unit><form lang="kqs"><text>mɔima vawvan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔima vawvan_2704_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme</text></gloss>
      <gloss lang="en"><text>palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Möèma vawvan</text></form></note>
    <note><form lang="fr"><text>Keita écrit Möèma ; la Bible écrit mɔima, forme radicale de mɔiyan « vin » (DEU.28.39). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="mɔiyan_2705">
    <lexical-unit><form lang="kqs"><text>mɔiyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔima</text></form></variant>
    <sense id="mɔiyan_2705_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin ; vin de palme</text></gloss>
      <gloss lang="en"><text>wine; palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>liquor (generic), spirits</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 170 occurrences, first GEN.9.21; Lexique kissi–français, p. 35: mɔiyan; Childs 2000, p. 254: mùèìyáŋ</text></form></note>
  </entry>
  <entry id="mɔku-mɔku_2706">
    <lexical-unit><form lang="kqs"><text>mɔku-mɔku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔku-mɔku_2706_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entièrement (couvert)</text></gloss>
      <gloss lang="en"><text>entirely (covered)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.10.5</text></form></note>
    <note><form lang="fr"><text>Après kumbu « couvrir » : kumnde kumbu … mɔku-mɔku « la nuée couvrit entièrement … » (Ex 40,34).</text></form></note>
  </entry>
  <entry id="mɔkɔkɔ_2707">
    <lexical-unit><form lang="kqs"><text>mɔkɔkɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔkɔkɔ_2707_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(adverbe de degré)</text></gloss>
      <gloss lang="en"><text>(degree adverb)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔkɔkɔ</text></form></note>
  </entry>
  <entry id="mɔ́léí_2708">
    <lexical-unit><form lang="kqs"><text>mɔ́léí</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ́léí_2708_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guérisseur, marabout musulman (aussi nom d'homme)</text></gloss>
      <gloss lang="en"><text>medicine man, Muslim healer (also a man's name)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 251: mɔ́léí</text></form></note>
    <note><form lang="fr"><text>Emprunt au mandé.</text></form></note>
  </entry>
  <entry id="mɔmbillo_2709">
    <lexical-unit><form lang="kqs"><text>mɔmbillo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="confirmed"/>
    <sense id="mɔmbillo_2709_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voiture, automobile ; camion</text></gloss>
      <gloss lang="en"><text>car, automobile; truck</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>car; also a children's toy car</text></form></field>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔnbillo; Childs 2000, p. 251: mɔ́mbîlló</text></form></note>
    <note><form lang="fr"><text>Confirmé par un locuteur (octobre 2026) pour toutes les variantes du kisiei. Emprunt au maninka mɔ́mbílí, du français automobile. Forme radicale attendue mɔmbil (mɔmbil bɛndoo « une grande voiture ») ; pluriel attendu mɔmbiltan d'après la règle des choses en -llo (Childs : mɔ́mbîltáŋ), à confirmer. Lexique kissi–français, p. 35 : mɔnbillo « camion », « l'auto ».</text></form></note>
  </entry>
  <entry id="mɔ́mndo_2710">
    <lexical-unit><form lang="kqs"><text>mɔ́mndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="mɔ́mndo_2710_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brouillard ; rosée</text></gloss>
      <gloss lang="en"><text>fog, mist; dew</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dew, morning mist</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first EXO.16.13; Keita 1979, p. 154: Mömndo; Lexique kissi–français, p. 35: mɔmndo; Childs 2000, p. 251: mɔ̌mndó</text></form></note>
  </entry>
  <entry id="mɔmtombolaa_2711">
    <lexical-unit><form lang="kqs"><text>mɔmtombolaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔmtombolaa_2711_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Pléiades (constellation)</text></gloss>
      <gloss lang="en"><text>Pleiades (constellation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.9.9</text></form></note>
    <note><form lang="fr"><text>Mɛlɛka cɔw mɔmtombolaa … a nanga-nsiiyo « celui qui a fait les Pléiades et Orion » (Am 5,8).</text></form></note>
  </entry>
  <entry id="mɔmɔɔ_2712">
    <lexical-unit><form lang="kqs"><text>mɔmɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="mɔmɔɔ_2712_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz cuit (avec la sauce dessus), nourriture</text></gloss>
      <gloss lang="en"><text>cooked rice (with sauce on top), food</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔmɔɔ; Childs 2000, p. 251: mɔ́mɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 35 (« le riz cuit ? »). Pluriel en kissi du Sud (Childs 2000) : mɔ́múéí.</text></form></note>
  </entry>
  <entry id="mɔ̀nííyó_2713">
    <lexical-unit><form lang="kqs"><text>mɔ̀nííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ̀nííyó_2713_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boulettes de farine de riz au citron et au sucre</text></gloss>
      <gloss lang="en"><text>balls of rice flour with lime juice and sugar</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀nííyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au maninka mɔ̀nɔ́.</text></form></note>
  </entry>
  <entry id="mɔntɔrɔ_2714">
    <lexical-unit><form lang="kqs"><text>mɔntɔrɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔntɔrɔ_2714_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>montre</text></gloss>
      <gloss lang="en"><text>watch</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔntɔrɔ</text></form></note>
    <note><form lang="fr"><text>Emprunt ; r conservé.</text></form></note>
  </entry>
  <entry id="mɔnɔnndo_2715">
    <lexical-unit><form lang="kqs"><text>mɔnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>manan</text></form></variant>
    <variant><form lang="kqs"><text>manun</text></form></variant>
    <sense id="mɔnɔnndo_2715_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se nourrir, porter la nourriture à la bouche</text></gloss>
      <gloss lang="en"><text>feed oneself, put food into one's mouth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔnɔnndo/ manan</text></form></note>
    <note><form lang="fr"><text>Aussi manun (rad.), p. 33.</text></form></note>
  </entry>
  <entry id="mɔ̀nɔ̀ɔ́_2716">
    <lexical-unit><form lang="kqs"><text>mɔ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>mɔ̀nɔ̀ɔ̀</text></form></variant>
    <sense id="mɔ̀nɔ̀ɔ́_2716_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coureur de jupons, fait de multiplier les partenaires</text></gloss>
      <gloss lang="en"><text>philandering</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mɔnɛi_2717">
    <lexical-unit><form lang="kqs"><text>mɔnɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔnɛ</text></form></variant>
    <sense id="mɔnɛi_2717_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chagrin, tristesse ; regret</text></gloss>
      <gloss lang="en"><text>grief, sorrow; regret</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sorrow, sadness; pity, remorse, regret</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 281 occurrences, first GEN.6.6; Childs 2000, p. 251: mɔ́nɛ́í</text></form></note>
  </entry>
  <entry id="mɔsaa_2718">
    <lexical-unit><form lang="kqs"><text>mɔsaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɔsa</text></form></variant>
    <sense id="mɔsaa_2718_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer</text></gloss>
      <gloss lang="en"><text>close, shut</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔsaa/ mɔsa</text></form></note>
  </entry>
  <entry id="mɔsillo_2719">
    <lexical-unit><form lang="kqs"><text>mɔsillo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="mɔsillo_2719_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure, turban, bonnet ; chapeau</text></gloss>
      <gloss lang="en"><text>headgear, turban, cap; hat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.28.4; Keita 1979, p. 144: Mösillo; Lexique kissi–français, p. 35: mɔsillo; Childs 2000, p. 253: mɔ́sílló</text></form></note>
  </entry>
  <entry id="mɔsɔŋaa_2720">
    <lexical-unit><form lang="kqs"><text>mɔsɔŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔsɔŋaa_2720_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler ; associer, mettre ensemble</text></gloss>
      <gloss lang="en"><text>gather, put together; associate, put together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix or put together</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhaa; Lexique kissi–français, p. 35: mɔsɔŋaa/ mɔsɔŋa; Childs 2000, p. 253: mɔ̀sɔ̀ŋàá</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : mɔsɔŋa (LEV 22,28), mɔsɔŋan « se rassembler » (GEN 34,30). Lexique kissi–français, p. 35 : aussi « associer, mettre ensemble ».</text></form></note>
  </entry>
  <entry id="mɔsɔŋan_2721">
    <lexical-unit><form lang="kqs"><text>mɔsɔŋan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔsɔŋa</text></form></variant>
    <variant><form lang="kqs"><text>mɔsɔŋian</text></form></variant>
    <variant><form lang="kqs"><text>mɔsɔŋannin</text></form></variant>
    <sense id="mɔsɔŋan_2721_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se joindre, s'unir, se liguer ; (mɔsɔŋa) réunir, faire ensemble</text></gloss>
      <gloss lang="en"><text>join together, unite, ally; (mɔsɔŋa) put together, do together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix, combine, put together</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.34.30; Lexique kissi–français, p. 35: mɔsɔŋa; Childs 2000, p. 253: mɔ̀sɔ̀ŋàá</text></form></note>
    <note><form lang="fr"><text>masaa Amoriaa … a mɔsɔŋian « les rois des Amoréens se sont ligués » (JOS.10.6) ; vanaa … mɔsɔŋan « qu'ils se joignent (à leur voisin) » (EXO.12.4) ; la mɔsɔŋa cɔloo diyɔɔ … nda cuale ndɔlen « n'égorgez pas ensemble la vache et son petit » (LEV.22.28).</text></form></note>
  </entry>
  <entry id="mɔsɔŋiaa_2722">
    <lexical-unit><form lang="kqs"><text>mɔsɔŋiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɔsɔŋia</text></form></variant>
    <sense id="mɔsɔŋiaa_2722_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler (plusieurs)</text></gloss>
      <gloss lang="en"><text>gather (many)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhiaa; Lexique kissi–français, p. 35: mɔsɔŋiaa/ mɔsɔŋia</text></form></note>
    <note><form lang="fr"><text>Pluriel de mɔsɔŋaa. Forme attestée dans la Bible : mɔsɔŋian « se coaliser » (JOS 10,6).</text></form></note>
  </entry>
  <entry id="mɔ́sɔ́ɔ́_2723">
    <lexical-unit><form lang="kqs"><text>mɔ́sɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mɔ́sɔ̀láŋ</text></form></field>
    <variant><form lang="kqs"><text>mɔ́sɔ̀ɔ̀</text></form></variant>
    <sense id="mɔ́sɔ́ɔ́_2723_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>onguent traditionnel (terre mêlée de sel ou de piment, pour les entorses)</text></gloss>
      <gloss lang="en"><text>traditional ointment (earth mixed with salt or pepper, for sprains)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mɔ́sɔ́ɔ́</text></form></note>
  </entry>
  <entry id="mɔ́ŋtɔ́lɔ́ɔ́_2724">
    <lexical-unit><form lang="kqs"><text>mɔ́ŋtɔ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ́ŋtɔ́lɔ́ɔ́_2724_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>montre</text></gloss>
      <gloss lang="en"><text>watch (timepiece)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ́ŋtɔ́lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Emprunt au français montre (parler de Guéckédou).</text></form></note>
  </entry>
  <entry id="mɔɔ_2725">
    <lexical-unit><form lang="kqs"><text>mɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>maw</text></form></variant>
    <sense id="mɔɔ_2725_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire manger qqn, lui mettre la nourriture dans la bouche</text></gloss>
      <gloss lang="en"><text>feed someone, put food into someone's mouth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔɔ/ mau</text></form></note>
    <note><form lang="fr"><text>Aussi mau (rad.), p. 33. Homographe de mɔɔ (PRO.30.14).</text></form></note>
  </entry>
  <entry id="mɔ̀ɔ̀bɛ̀íyó_2726">
    <lexical-unit><form lang="kqs"><text>mɔ̀ɔ̀bɛ̀íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>mɔ̀ɔ̀bɛ̀ɛ́íyo</text></form></variant>
    <sense id="mɔ̀ɔ̀bɛ̀íyó_2726_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure de femme ; style de chapeau</text></gloss>
      <gloss lang="en"><text>woman's hairstyle; style of hat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀ɔ̀bɛ̀íyó</text></form></note>
  </entry>
  <entry id="mɔ́ɔ́ndìɔ̀ŋ-mɔ̀ɔ̀ndìɔ̀ŋ_2727">
    <lexical-unit><form lang="kqs"><text>mɔ́ɔ́ndìɔ̀ŋ-mɔ̀ɔ̀ndìɔ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɔ́ɔ́ndìɔ̀ŋ-mɔ̀ɔ̀ndìɔ̀ŋ_2727_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mou, tendre</text></gloss>
      <gloss lang="en"><text>soft</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ́ɔ́ndìɔ̀ŋ-mɔ̀ɔ̀ndìɔ̀ŋ</text></form></note>
  </entry>
  <entry id="mɔɔsa_2728">
    <lexical-unit><form lang="kqs"><text>mɔɔsa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔɔsu</text></form></variant>
    <sense id="mɔɔsa_2728_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'unir, se joindre ; (mɔɔsa kpeloo) avoir des rapports, coucher ensemble</text></gloss>
      <gloss lang="en"><text>come together, join; (mɔɔsa kpeloo) sleep together, have sexual relations</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold; embrace someone; put together, mix</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.21.5; Childs 2000, p. 252: mɔ̀ɔ̀sàá</text></form></note>
    <note><form lang="fr"><text>Verbe de base de mɔɔsiaa « rassembler ». mɔɔsu « serré, ajusté » (Ez 37,8) correspond à mɔ́ɔ́sú « tightly » chez Childs.</text></form></note>
  </entry>
  <entry id="mɔ̀ɔ̀sàá_2729">
    <lexical-unit><form lang="kqs"><text>mɔ̀ɔ̀sàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɔ̀ɔ̀sàá_2729_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>plier ; manger avec la main repliée ; étreindre ; assembler, mélanger</text></gloss>
      <gloss lang="en"><text>fold; eat with the folded hand; embrace; put together, mix</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀ɔ̀sàá</text></form></note>
    <note><form lang="fr"><text>Cf. mɔɔsa « se joindre », mɔɔsiaa « rassembler » (Bible).</text></form></note>
  </entry>
  <entry id="mɔɔsia_2730">
    <lexical-unit><form lang="kqs"><text>mɔɔsia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔɔsia_2730_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler tout ensemble</text></gloss>
      <gloss lang="en"><text>gather all together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔɔsia</text></form></note>
  </entry>
  <entry id="mɔɔsiaa_2731">
    <lexical-unit><form lang="kqs"><text>mɔɔsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔɔsian</text></form></variant>
    <sense id="mɔɔsiaa_2731_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler ; (mɔɔsian) se rassembler</text></gloss>
      <gloss lang="en"><text>gather; (mɔɔsian) assemble, come together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 61 occurrences, first JOS.2.18</text></form></note>
  </entry>
  <entry id="mɔ́ɔ́sú_2732">
    <lexical-unit><form lang="kqs"><text>mɔ́ɔ́sú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɔ́ɔ́sú_2732_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>étroitement, bien serré</text></gloss>
      <gloss lang="en"><text>tight, tightly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ́ɔ́sú</text></form></note>
  </entry>
  <entry id="mɔ̀ɔ̀tííyó_2733">
    <lexical-unit><form lang="kqs"><text>mɔ̀ɔ̀tííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mɔ̀ɔ̀tííláŋ</text></form></field>
    <sense id="mɔ̀ɔ̀tííyó_2733_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voiture</text></gloss>
      <gloss lang="en"><text>car</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀ɔ̀tííyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais motor.</text></form></note>
  </entry>
  <entry id="mɔɔva_2734">
    <lexical-unit><form lang="kqs"><text>mɔɔva</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɔɔvaa</text></form></variant>
    <sense id="mɔɔva_2734_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être englouti, recouvert ; s'enfoncer (dans la boue, l'eau)</text></gloss>
      <gloss lang="en"><text>be engulfed, be covered over; sink (into mud, water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be buried, completely covered over</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.7.19; Childs 2000, p. 252: mɔ̀ɔ̀wàá</text></form></note>
    <note><form lang="fr"><text>pembun bɛndun … n mɔɔva lenin « les hautes montagnes furent recouvertes » (GEN.7.19) ; I co mɔɔvaa o loolio yingilaa nin « j'enfonce dans la boue profonde » (PSA.69.3). Correspondance w ~ v.</text></form></note>
  </entry>
  <entry id="mɔ́ɔ̀yɔ̀ɔ̀_2735">
    <lexical-unit><form lang="kqs"><text>mɔ́ɔ̀yɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɔ́ɔ̀yɔ̀ɔ̀_2735_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(couvert de honte) totalement</text></gloss>
      <gloss lang="en"><text>utterly (put to shame)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first PSA.44.10</text></form></note>
    <note><form lang="fr"><text>Toujours avec siɛmbulan « honte » : siɛmbulan la tol naa mɔ́ɔ́yɔ̀ɔ̀ « tu nous couvres de honte » (Ps 44,10). Aussi écrit mɔ́ɔ́yɔ̀ɔ̀.</text></form></note>
  </entry>
  <entry id="mɔ̀ɔ̀yɔ́ɔ́_2736">
    <lexical-unit><form lang="kqs"><text>mɔ̀ɔ̀yɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ̀ɔ̀yɔ́ɔ́_2736_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie qui affaiblit et donne de forts vertiges</text></gloss>
      <gloss lang="en"><text>disease causing weakness and severe dizziness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 253: mɔ̀ɔ̀yɔ́ɔ́</text></form></note>
  </entry>
  <entry id="mɔ̀ɔ́ɲɔ̀ɔ̀_2737">
    <lexical-unit><form lang="kqs"><text>mɔ̀ɔ́ɲɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɔ̀ɔ́ɲɔ̀ɔ̀_2737_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fille capturée par des guerriers</text></gloss>
      <gloss lang="en"><text>girl captured by warriors</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 252: mɔ̀ɔ́ɲɔ̀ɔ̀</text></form></note>
  </entry>
  <entry id="mɔɛi_2738">
    <lexical-unit><form lang="kqs"><text>mɔɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɔɔn</text></form></field>
    <sense id="mɔɛi_2738_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couteau ; épée (mɔɛi cɔwve)</text></gloss>
      <gloss lang="en"><text>knife; sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 290 occurrences, first GEN.22.6; Keita 1979, p. 156: Möèi; Lexique kissi–français, p. 35: mɔɛi; Childs 2000, p. 253: mùɛ́í</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 35 : aussi mɔi « couteau ».</text></form></note>
  </entry>
  <entry id="mɔɛma vawvan_2739">
    <lexical-unit><form lang="kqs"><text>mɔɛma vawvan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɔɛma vawvan_2739_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme</text></gloss>
      <gloss lang="en"><text>palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 35: mɔɛma vawvan</text></form></note>
    <note><form lang="fr"><text>Cf. vawvan « palmiers » (EXO.15.27), mɔiyan « vin ».</text></form></note>
  </entry>
  <entry id="mɛinɔnndo_2740">
    <lexical-unit><form lang="kqs"><text>mɛinɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛinɔnndo_2740_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être tranquille, calme ; cesser</text></gloss>
      <gloss lang="en"><text>be quiet, calm; stop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛinɔnndo</text></form></note>
    <note><form lang="fr"><text>Cf. mɛiyo « laisser, cesser ».</text></form></note>
  </entry>
  <entry id="mɛiyo_2741">
    <lexical-unit><form lang="kqs"><text>mɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛi</text></form></variant>
    <variant><form lang="kqs"><text>mɛinin</text></form></variant>
    <sense id="mɛiyo_2741_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser, laisser de côté ; (mɛiyo yoomu) laisser en vie ; abandonner, cesser ; pardonner</text></gloss>
      <gloss lang="en"><text>leave, leave over; (mɛiyo yoomu) let live; abandon, stop; forgive</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>leave; stop, cease (especially talking); arrange, agree</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.1.18; Lexique kissi–français, p. 34: mɛiyo/ mɛi; Childs 2000, p. 246: mèìyɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 34 : « abandonner, cesser » ; « être tranquille ; laisser qqch où il est ; pardonner ».</text></form></note>
  </entry>
  <entry id="mɛ́kpɛ́nɔ́ɔ́_2742">
    <lexical-unit><form lang="kqs"><text>mɛ́kpɛ́nɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mɛ́kpíá</text></form></field>
    <sense id="mɛ́kpɛ́nɔ́ɔ́_2742_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>albinos</text></gloss>
      <gloss lang="en"><text>albino</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 246: mɛ́kpɛ́nɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Cf. mɔikpɛnɛnɔɔ « albinos » (Keita).</text></form></note>
  </entry>
  <entry id="mɛlimɛlio_2743">
    <lexical-unit><form lang="kqs"><text>mɛlimɛlio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɛlimɛli</text></form></variant>
    <sense id="mɛlimɛlio_2743_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber çà et là</text></gloss>
      <gloss lang="en"><text>let fall here and there</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mèlimèlio; Lexique kissi–français, p. 34: mɛlimɛlio</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : mɛlimɛli « laisser tomber (des épis) » (RUT 2,16). Radical mɛlimɛli dans la Bible (RUT.2.16).</text></form></note>
  </entry>
  <entry id="mɛlio_2744">
    <lexical-unit><form lang="kqs"><text>mɛlio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛli</text></form></variant>
    <variant><form lang="kqs"><text>mɛlinin</text></form></variant>
    <sense id="mɛlio_2744_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber ; pousser (un cri)</text></gloss>
      <gloss lang="en"><text>make fall; utter (a cry)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.22.24; Keita 1979, p. 110: Mèlio; Lexique kissi–français, p. 34: mɛlio/ mɛli</text></form></note>
    <note><form lang="fr"><text>Causatif de delɔɔ ; yeelan mɛli « pousser des cris » (DEU 22,24).</text></form></note>
  </entry>
  <entry id="mɛllo_2745">
    <lexical-unit><form lang="kqs"><text>mɛllo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛl</text></form></variant>
    <sense id="mɛllo_2745_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gauche (o ba mɛllo coo « à gauche »)</text></gloss>
      <gloss lang="en"><text>left (o ba mɛllo coo, on the left)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>left side</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first GEN.13.9; Childs 2000, p. 249: mìàllé</text></form></note>
    <note><form lang="fr"><text>o ba mɛllo coo … o ba kɛndɔɔ coo « à gauche … à droite » (GEN.13.9) ; o ba mɛl ndaa « à leur gauche » (EXO.14.29). Correspondance ia (Childs) ~ ɛ (Bible), comme lìáŋ ~ lɛan « miel ».</text></form></note>
  </entry>
  <entry id="mɛlɛkanɔɔ_2746">
    <lexical-unit><form lang="kqs"><text>mɛlɛkanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɛlɛkaa</text></form></field>
    <variant><form lang="kqs"><text>mɛlɛkanɔ</text></form></variant>
    <sense id="mɛlɛkanɔɔ_2746_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ange</text></gloss>
      <gloss lang="en"><text>angel</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.19.17; Keita 1979, p. 150: Mèlèkanöö; Lexique kissi–français, p. 34: mɛlɛkanɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 34 : aussi mɛlɛka « l'ange ».</text></form></note>
  </entry>
  <entry id="mɛlɛsoŋnɔ_2747">
    <lexical-unit><form lang="kqs"><text>mɛlɛsoŋnɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mɛlɛsoŋnda</text></form></field>
    <variant><form lang="kqs"><text>mɛlɛsoŋaa</text></form></variant>
    <sense id="mɛlɛsoŋnɔ_2747_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chef de corvée, contremaître</text></gloss>
      <gloss lang="en"><text>taskmaster, overseer of forced labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.6.7</text></form></note>
  </entry>
  <entry id="mɛ̀lɛ̀ŋgàá_2748">
    <lexical-unit><form lang="kqs"><text>mɛ̀lɛ̀ŋgàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>mɛ̀ɛ̀ŋgàà</text></form></variant>
    <sense id="mɛ̀lɛ̀ŋgàá_2748_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apercevoir, savoir ; (mɛ́ɛ́ŋgáá) voici que</text></gloss>
      <gloss lang="en"><text>perceive, know; (mɛ́ɛ́ŋgáá) behold</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 246: mɛ̀lɛ̀ŋgàá</text></form></note>
  </entry>
  <entry id="mɛmi_2749">
    <lexical-unit><form lang="kqs"><text>mɛmi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛminin</text></form></variant>
    <sense id="mɛmi_2749_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire rire ; amuser ; prêter à rire</text></gloss>
      <gloss lang="en"><text>make laugh; amuse; make a laughing-stock</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.21.6; Childs 2000, p. 247: mɛ̀mìó</text></form></note>
    <note><form lang="fr"><text>Causatif de mamɔɔ « rire ». Hala mɛmi ya « Dieu m'a fait rire » (GEN.21.6) ; mò hun mɛmi naa « qu'il vienne nous divertir » (JDG.16.25).</text></form></note>
  </entry>
  <entry id="mɛminndo_2750">
    <lexical-unit><form lang="kqs"><text>mɛminndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɛmin</text></form></variant>
    <sense id="mɛminndo_2750_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accueillir avec plaisir ; embrasser</text></gloss>
      <gloss lang="en"><text>welcome gladly; embrace</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
      <trait name="semantic-domain-ddp4" value="4.2 Social activity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛminndo/ mɛmin</text></form></note>
    <note><form lang="fr"><text>Le radical mɛmin est dans la Bible : mí Esekia mɛmin mialaa kan « Ézéchias accueillit ces étrangers » (2KI.20.13).</text></form></note>
  </entry>
  <entry id="mɛmma pɔlulan_2751">
    <lexical-unit><form lang="kqs"><text>mɛmma pɔlulan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛmma pɔlulan_2751_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>eau tiède</text></gloss>
      <gloss lang="en"><text>lukewarm water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛmna pɔlulan</text></form></note>
  </entry>
  <entry id="mɛmma tuwvan_2752">
    <lexical-unit><form lang="kqs"><text>mɛmma tuwvan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛmma tuwvan_2752_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>eau chaude</text></gloss>
      <gloss lang="en"><text>hot water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛnma tuwvan</text></form></note>
  </entry>
  <entry id="mɛmma ɲuluan_2753">
    <lexical-unit><form lang="kqs"><text>mɛmma ɲuluan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛmma ɲuluan_2753_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>eau fraîche</text></gloss>
      <gloss lang="en"><text>cool water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛmna ɲuluan</text></form></note>
    <note><form lang="fr"><text>Écrit mɛmna ɲuluan ; la Bible écrit mɛmma.</text></form></note>
  </entry>
  <entry id="mɛmɛ_2754">
    <lexical-unit><form lang="kqs"><text>mɛmɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛmɛ_2754_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>quelques ; quand même</text></gloss>
      <gloss lang="en"><text>some, a few; all the same</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛmɛ</text></form></note>
  </entry>
  <entry id="mɛmɛan_2755">
    <lexical-unit><form lang="kqs"><text>mɛmɛan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="mɛmɛan_2755_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>larmes</text></gloss>
      <gloss lang="en"><text>tears</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first 2SA.13.36; Keita 1979, p. 132: Mèmèan; Lexique kissi–français, p. 34: mɛmɛan; Childs 2000, p. 247: mɛ́míáŋ</text></form></note>
  </entry>
  <entry id="mɛnalanndo_2756">
    <lexical-unit><form lang="kqs"><text>mɛnalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛnalan</text></form></variant>
    <sense id="mɛnalanndo_2756_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire jurer ; promettre par serment (à quelqu'un)</text></gloss>
      <gloss lang="en"><text>make someone swear; swear (to someone), promise on oath</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.29.13; Childs 2000, p. 244: mènàlló</text></form></note>
    <note><form lang="fr"><text>Dérivé de mɛnanndo « jurer ». lɛŋnde ya mɛnalan Abraham « le pays que j'ai juré de donner à Abraham » (Ex 6,8).</text></form></note>
  </entry>
  <entry id="mɛnanndo_2757">
    <lexical-unit><form lang="kqs"><text>mɛnanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛnan</text></form></variant>
    <variant><form lang="kqs"><text>mɛnannin</text></form></variant>
    <sense id="mɛnanndo_2757_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jurer, prêter serment ; serment</text></gloss>
      <gloss lang="en"><text>swear, take an oath; oath</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 38 occurrences, first GEN.26.33; Lexique kissi–français, p. 34: mɛnanndo/ mɛnan; Childs 2000, p. 244: mènǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de mɛna « maudire ». Bɛɛr-Seba … « Soon kólaa mɛnanndo » « le puits du serment » (Gn 26,33) ; sendí n mɛnan-ndo « le serment que tu as juré » (Gn 24,8).</text></form></note>
  </entry>
  <entry id="mɛndei_2758">
    <lexical-unit><form lang="kqs"><text>mɛndei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="mɛndei_2758_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue, dialecte</text></gloss>
      <gloss lang="en"><text>language, dialect</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛndei</text></form></note>
  </entry>
  <entry id="mɛndul_2759">
    <lexical-unit><form lang="kqs"><text>mɛndul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛndullo</text></form></variant>
    <sense id="mɛndul_2759_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allumer (le feu) ; allumer (une lampe)</text></gloss>
      <gloss lang="en"><text>kindle (a fire); light (a lamp)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>light, build a fire</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.35.3; Lexique kissi–français, p. 34: mɛndullo/ mɛndul; Childs 2000, p. 247: mèndùlló</text></form></note>
  </entry>
  <entry id="mɛngɔɔ_2760">
    <lexical-unit><form lang="kqs"><text>mɛngɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛngɔɔ_2760_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>limace, escargot</text></gloss>
      <gloss lang="en"><text>slug, snail</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slug, freshwater snail</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.58.9; Childs 2000, p. 248: mɛ̀ŋɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : mɛɛ mɛngɔɔ kɔa a tengaa « comme la limace qui fond en s'en allant » (PSA.58.9).</text></form></note>
  </entry>
  <entry id="mɛngɛla_2761">
    <lexical-unit><form lang="kqs"><text>mɛngɛla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛngɛla_2761_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guetter, épier, tendre une embuscade à</text></gloss>
      <gloss lang="en"><text>lie in wait for, watch secretly, ambush</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>watch secretly, spy on, sneak up on</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first EXO.21.13; Childs 2000, p. 247: mɛ̀ŋɛ̀làá</text></form></note>
    <note><form lang="fr"><text>o mɛngɛla ndu « il le guettait » (EXO.21.13) ; mí mɛngɛla niaa … maa tambili « je vous guetterai comme un léopard » (HOS.13.7). Cf. mɛngɛlaa « poste de guet ».</text></form></note>
  </entry>
  <entry id="mɛngɛlaa_2762">
    <lexical-unit><form lang="kqs"><text>mɛngɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛngɛlaa_2762_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guet, poste de guet</text></gloss>
      <gloss lang="en"><text>lookout, watch</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first NUM.23.14</text></form></note>
  </entry>
  <entry id="mɛnianndo_2763">
    <lexical-unit><form lang="kqs"><text>mɛnianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɛnian</text></form></variant>
    <sense id="mɛnianndo_2763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jurer plusieurs fois</text></gloss>
      <gloss lang="en"><text>swear repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: menianndo/ menian</text></form></note>
    <note><form lang="fr"><text>Écrit menianndo ; cf. mɛnanndo « jurer » (Bible).</text></form></note>
  </entry>
  <entry id="mɛnndan_2764">
    <lexical-unit><form lang="kqs"><text>mɛnndan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛmma</text></form></variant>
    <sense id="mɛnndan_2764_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>eau</text></gloss>
      <gloss lang="en"><text>water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 444 occurrences, first GEN.1.2; Keita 1979, p. 155: Mènndan; Lexique kissi–français, p. 34: mɛnndan; Childs 2000, p. 248: mɛ̀ŋndáŋ</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi mɛmma tuwvan « eau chaude » et mɛmma ɲuluan « eau fraîche ».</text></form></note>
  </entry>
  <entry id="mɛ́sɛ́kɛ́ɛ́_2765">
    <lexical-unit><form lang="kqs"><text>mɛ́sɛ́kɛ́ɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɛ́sɛ́kɛ́ɛ́_2765_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très maigre</text></gloss>
      <gloss lang="en"><text>very thin</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 248: mɛ́sɛ́kɛ́ɛ́</text></form></note>
  </entry>
  <entry id="mɛsɛla_2766">
    <lexical-unit><form lang="kqs"><text>mɛsɛla</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛsɛla_2766_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fin ; étroit</text></gloss>
      <gloss lang="en"><text>thin; narrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛsɛra</text></form></note>
    <note><form lang="fr"><text>Écrit mɛsɛra ; aussi mɛsɛla sans glose (p. 34).</text></form></note>
  </entry>
  <entry id="mɛ̀sɛ̀làá_2767">
    <lexical-unit><form lang="kqs"><text>mɛ̀sɛ̀làá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɛ̀sɛ̀làá_2767_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être petit, maigrir ; réduire (en regroupant, en entassant)</text></gloss>
      <gloss lang="en"><text>be small, become thin; reduce (by grouping or piling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
      <trait name="semantic-domain-ddp4" value="2.4.2 Weak"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 248: mɛ̀sɛ̀làá</text></form></note>
  </entry>
  <entry id="mɛ́tɛ́lèíyó_2768">
    <lexical-unit><form lang="kqs"><text>mɛ́tɛ́lèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mɛ́tɛ́lèíyá</text></form></field>
    <sense id="mɛ́tɛ́lèíyó_2768_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maître d'école, enseignant</text></gloss>
      <gloss lang="en"><text>teacher</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6.2 School"/>
      <trait name="semantic-domain-ddp4" value="6.6 Occupation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 249: mɛ́tɛ́lèíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au français maître (parler de Guéckédou selon Childs).</text></form></note>
  </entry>
  <entry id="mɛtɛrɔ_2769">
    <lexical-unit><form lang="kqs"><text>mɛtɛrɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛtɛrɔ_2769_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mètre</text></gloss>
      <gloss lang="en"><text>metre</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛtɛrɔ</text></form></note>
    <note><form lang="fr"><text>Emprunt ; r conservé.</text></form></note>
  </entry>
  <entry id="mɛyaa_2770">
    <lexical-unit><form lang="kqs"><text>mɛyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɛya</text></form></variant>
    <sense id="mɛyaa_2770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couler, se noyer ; plonger dans l'eau</text></gloss>
      <gloss lang="en"><text>sink, drown; dive</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛyaa/ mɛya</text></form></note>
  </entry>
  <entry id="mɛɛ_2771">
    <lexical-unit><form lang="kqs"><text>mɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mɛɛ_2771_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>quand ; comme</text></gloss>
      <gloss lang="en"><text>when; as, like</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'since, after, while; except, unless'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4301 occurrences, first GEN.1; Lexique kissi–français, p. 34: mɛɛ; Childs 2000, p. 244: mɛ̀ɛ́</text></form></note>
  </entry>
  <entry id="mɛ̀ɛ̀kììyó_2772">
    <lexical-unit><form lang="kqs"><text>mɛ̀ɛ̀kììyó</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="mɛ̀ɛ̀kììyó_2772_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>scarifications (de beauté), surtout chez les femmes</text></gloss>
      <gloss lang="en"><text>(beauty) scars, mostly on women</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 244: mɛ̀ɛ̀kììyó</text></form></note>
  </entry>
  <entry id="mɛɛlaa_2773">
    <lexical-unit><form lang="kqs"><text>mɛɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlaala</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlaalan</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlaalen</text></form></variant>
    <sense id="mɛɛlaa_2773_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dernier, final</text></gloss>
      <gloss lang="en"><text>last, final</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.18.32; Childs 2000, p. 245: mèèlà-</text></form></note>
    <note><form lang="fr"><text>paale mɛɛlaalen « le dernier jour » (Ne 8,18) ; kpundɛ mɛɛlaa « une dernière plaie » (Ex 11,1).</text></form></note>
  </entry>
  <entry id="mɛɛlen_2774">
    <lexical-unit><form lang="kqs"><text>mɛɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="mɛɛlen_2774_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sein</text></gloss>
      <gloss lang="en"><text>breast</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>breast, breast milk; pus</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.21.8; Keita 1979, p. 132: Mèèlen; Lexique kissi–français, p. 34: mɛɛlen; Childs 2000, p. 246: mɛ̀ɛ̀yáŋ</text></form></note>
  </entry>
  <entry id="mɛ́ɛ́lìíyé_2775">
    <lexical-unit><form lang="kqs"><text>mɛ́ɛ́lìíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="mɛ́ɛ́lìíyé_2775_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pressoir à canne à sucre</text></gloss>
      <gloss lang="en"><text>sugar-cane press</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 245: mɛ́ɛ́lìíyé</text></form></note>
    <note><form lang="fr"><text>Emprunt probable à l'anglais (mill ?).</text></form></note>
  </entry>
  <entry id="mɛɛloo_2776">
    <lexical-unit><form lang="kqs"><text>mɛɛloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlu</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛlunin</text></form></variant>
    <sense id="mɛɛloo_2776_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, s'achever, arriver au bout</text></gloss>
      <gloss lang="en"><text>end, finish, come to an end</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also stop, reach an end or boundary</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2CH.35.26; Childs 2000, p. 245: mèèlòó</text></form></note>
    <note><form lang="fr"><text>kandɔɔ a … kɔ mɛɛlu a … « en commençant par … et en finissant par … » (Gn 44,12) ; lɛŋnden le mɛɛlu-a « les extrémités de la terre » (Dt 28,49). Voir mɛɛlulan « fin ».</text></form></note>
  </entry>
  <entry id="mɛɛlulan_2777">
    <lexical-unit><form lang="kqs"><text>mɛɛlulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛlula</text></form></variant>
    <sense id="mɛɛlulan_2777_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fin, dernier moment ; (o mɛɛlulan) à la fin, finalement</text></gloss>
      <gloss lang="en"><text>end, last part; (o mɛɛlulan) finally, afterwards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 166 occurrences, first GEN.30.21</text></form></note>
  </entry>
  <entry id="mɛ̀ɛ̀mɛ́í_2778">
    <lexical-unit><form lang="kqs"><text>mɛ̀ɛ̀mɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="mɛ̀ɛ̀mɛ́í_2778_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>noix de palme en germination</text></gloss>
      <gloss lang="en"><text>sprouting palm nut</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 245: mɛ̀ɛ̀mɛ́í</text></form></note>
  </entry>
  <entry id="mɛɛmɛɛ_2779">
    <lexical-unit><form lang="kqs"><text>mɛɛmɛɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mɛɛmɛɛ_2779_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>quel que soit</text></gloss>
      <gloss lang="en"><text>whatever, whichever</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 34: mɛɛmɛɛ</text></form></note>
  </entry>
  <entry id="mɛɛnaa_2780">
    <lexical-unit><form lang="kqs"><text>mɛɛnaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mɛɛna</text></form></variant>
    <sense id="mɛɛnaa_2780_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maudire</text></gloss>
      <gloss lang="en"><text>curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mèènaa; Lexique kissi–français, p. 34: mɛɛnaa/ mɛɛna</text></form></note>
    <note><form lang="fr"><text>La Bible emploie mɛɛniaa pour « maudire ».</text></form></note>
  </entry>
  <entry id="mɛɛndanndo_2781">
    <lexical-unit><form lang="kqs"><text>mɛɛndanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛndan</text></form></variant>
    <variant><form lang="kqs"><text>mɛɛndannin</text></form></variant>
    <sense id="mɛɛndanndo_2781_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder, observer, examiner</text></gloss>
      <gloss lang="en"><text>look, watch, observe, inspect</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>look into deeply, ponder, scrutinize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.24.21; Childs 2000, p. 245: mèèndǎŋndó</text></form></note>
    <note><form lang="fr"><text>Verbe de base de mɛɛndianndo. Mɛɛndan-ndɔ « regarde ! » (Gn 15,5) ; o … mɛɛndanndo « pour espionner » (Gn 42,12).</text></form></note>
  </entry>
  <entry id="mɛɛndianndo_2782">
    <lexical-unit><form lang="kqs"><text>mɛɛndianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛndian</text></form></variant>
    <sense id="mɛɛndianndo_2782_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder (autour), examiner, observer ; chercher</text></gloss>
      <gloss lang="en"><text>look around, examine, observe; look for</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of mèèndăŋndɔ́ 'look into': look around, ponder, scrutinize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first LEV.13.11; Lexique kissi–français, p. 34: mɛndianndo/ mɛndian; Childs 2000, p. 245: mèèndìàŋndɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 34 : écrit mɛndianndo/ mɛndian « chercher, regarder ».</text></form></note>
  </entry>
  <entry id="mɛɛniaa_2783">
    <lexical-unit><form lang="kqs"><text>mɛɛniaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛnian</text></form></variant>
    <sense id="mɛɛniaa_2783_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maudire ; maudire plusieurs fois (Keita)</text></gloss>
      <gloss lang="en"><text>curse; curse repeatedly (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.2.8; Keita 1979, p. 110: Mèèniaa; Lexique kissi–français, p. 34: mɛɛniaa/ mɛɛnia</text></form></note>
    <note><form lang="fr"><text>Pluriel de mɛɛnaa selon Keita ; dans la Bible, sens simple « maudire » (1KI 2,8 ; JAS 3,9). Le Lexique kissi–français donne aussi : mɛɛnia.</text></form></note>
  </entry>
  <entry id="mɛ́ɛ́ú_2784">
    <lexical-unit><form lang="kqs"><text>mɛ́ɛ́ú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mɛ́ɛ́ú_2784_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de manger ou d'avaler (tout d'un coup)</text></gloss>
      <gloss lang="en"><text>sound of eating or swallowing (all at once)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 245: mɛ́ɛ́ú</text></form></note>
  </entry>
  <entry id="mɛɛyaa_2785">
    <lexical-unit><form lang="kqs"><text>mɛɛyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mɛɛyanin</text></form></variant>
    <sense id="mɛɛyaa_2785_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sombrer, couler, s'enfoncer (dans l'eau)</text></gloss>
      <gloss lang="en"><text>sink, go under (water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>imbibe, drink deeply; sink, dive; get oneself into trouble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.69; Childs 2000, p. 245: mɛ̀ɛ̀yàá</text></form></note>
    <note><form lang="fr"><text>mí la kandu mɛɛyaa « au point qu'elles enfonçaient » (LUK.5.7) ; mɛɛyanin o mɛmma ihɛllan tɛɛn « sombreront au cœur des mers » (EZK.27.27).</text></form></note>
  </entry>
  <entry id="mɛɛyan_2786">
    <lexical-unit><form lang="kqs"><text>mɛɛyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <sense id="mɛɛyan_2786_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lait (maternel) ; seins</text></gloss>
      <gloss lang="en"><text>(breast) milk; breasts</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>breast, breast milk; also pus</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.3.12; Childs 2000, p. 246: mɛ̀ɛ̀yáŋ</text></form></note>
    <note><form lang="fr"><text>mɛɛyan … le ya vɔɛsio « des seins pour m'allaiter » (JOB.3.12) ; fɔ mɛɛyan « (il vous faut) du lait » (HEB.5.12). Cf. mɛɛlen « sein ».</text></form></note>
  </entry>
  <entry id="mɛ̀ɲjɛ̀ìyó_2787">
    <lexical-unit><form lang="kqs"><text>mɛ̀ɲjɛ̀ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mɛ̀ɲjɛ̀ìyó_2787_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grande mesure (gobelet doseur)</text></gloss>
      <gloss lang="en"><text>large measuring cup</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 248: mɛ̀ɲjɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais measure.</text></form></note>
  </entry>
  <entry id="n_2788">
    <lexical-unit><form lang="kqs"><text>n</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="n_2788_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>nous (sujet) ; tu (relative, question)</text></gloss>
      <gloss lang="en"><text>we (subject); you (sg., in relatives and questions)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>we; also the ordinary 2sg subject 'you'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7904 occurrences, first GEN.1.26; Lexique kissi–français, p. 36: n; Childs 2000, p. 269: ŋ̀</text></form></note>
  </entry>
  <entry id="naa_2789">
    <lexical-unit><form lang="kqs"><text>naa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="naa_2789_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>nous (indépendant) ; notre</text></gloss>
      <gloss lang="en"><text>us (independent); our</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4651 occurrences, first GEN.1.26; Lexique kissi–français, p. 36: naa; Childs 2000, p. 257: náá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 36 : aussi na « nous ».</text></form></note>
  </entry>
  <entry id="nàà_2790">
    <lexical-unit><form lang="kqs"><text>nàà</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>naalan</text></form></field>
    <sense id="nàà_2790_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie ; (verbe naa/ na) être malade, tomber malade</text></gloss>
      <gloss lang="en"><text>illness, disease; (verb naa/ na) be ill, fall ill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.1 Sick"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4651 occurrences, first GEN.1.26; Keita 1979, p. 161: Naa; Lexique kissi–français, p. 36: naa; Childs 2000, p. 257: nàá</text></form></note>
    <note><form lang="fr"><text>La Bible écrit en général nàà avec tons, ce qui le distingue de naa « nous ». Lexique kissi–français, p. 36 : naa/ na « être tombé malade ».</text></form></note>
  </entry>
  <entry id="nàà ciŋnde_2791">
    <lexical-unit><form lang="kqs"><text>nàà ciŋnde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà ciŋnde_2791_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mal de dents</text></gloss>
      <gloss lang="en"><text>toothache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa ntyinndo; Lexique kissi–français, p. 36: naa ncinndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel ; Keita écrit Naa ntyinndo. Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="nàà dembe_2792">
    <lexical-unit><form lang="kqs"><text>nàà dembe</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nàà dembe_2792_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mal de ventre, maladie des entrailles</text></gloss>
      <gloss lang="en"><text>stomach ache, bowel disease</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa demboo; Lexique kissi–français, p. 36: naa denboo</text></form></note>
  </entry>
  <entry id="nàà la hɔllo_2793">
    <lexical-unit><form lang="kqs"><text>nàà la hɔllo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà la hɔllo_2793_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maux d'yeux</text></gloss>
      <gloss lang="en"><text>eye disease, sore eyes</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: naa la hɔllo</text></form></note>
    <note><form lang="fr"><text>De nàà « maladie ». La Bible a hɔllo dans un autre sens (« bout », EST.5.2).</text></form></note>
  </entry>
  <entry id="nàà le bollo_2794">
    <lexical-unit><form lang="kqs"><text>nàà le bollo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà le bollo_2794_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mal de tête</text></gloss>
      <gloss lang="en"><text>headache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: naa le bollo</text></form></note>
    <note><form lang="fr"><text>De nàà « maladie » et bollen « tête ».</text></form></note>
  </entry>
  <entry id="nàà malɔɔ_2795">
    <lexical-unit><form lang="kqs"><text>nàà malɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà malɔɔ_2795_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie du sommeil</text></gloss>
      <gloss lang="en"><text>sleeping sickness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Naa malöö; Lexique kissi–français, p. 36: naa malɔɔ</text></form></note>
    <note><form lang="fr"><text>Keita : « -"- de sommeil » ; malɔɔ est attesté dans la Bible, mais dans un autre sens. Confirmé au Nord par le Lexique kissi–français, p. 36 (« la maladie du sommeil »).</text></form></note>
  </entry>
  <entry id="nàà siaŋaa_2796">
    <lexical-unit><form lang="kqs"><text>nàà siaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nàà siaŋaa_2796_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèpre</text></gloss>
      <gloss lang="en"><text>leprosy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: naa sianhaa; Lexique kissi–français, p. 36: naa saŋaa</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 36 : naa saŋaa et naa saiŋaa « la lèpre ».</text></form></note>
  </entry>
  <entry id="nàà tueiyaa_2797">
    <lexical-unit><form lang="kqs"><text>nàà tueiyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nàà tueiyaa_2797_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colère ; être fâché</text></gloss>
      <gloss lang="en"><text>anger; be angry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: naa tueiyaa</text></form></note>
  </entry>
  <entry id="nàà-kìòlèìyó_2798">
    <lexical-unit><form lang="kqs"><text>nàà-kìòlèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nàà-kìòlèìyó_2798_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèpre, « maladie qui coupe »</text></gloss>
      <gloss lang="en"><text>leprosy, 'cutting sickness'</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 257: nàà-kìòlèìyó</text></form></note>
  </entry>
  <entry id="nàà-kɔ̀ŋjáá_2799">
    <lexical-unit><form lang="kqs"><text>nàà-kɔ̀ŋjáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>nàalà-ŋkɔ̀ŋjáláŋ</text></form></field>
    <sense id="nàà-kɔ̀ŋjáá_2799_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>longue maladie, souvent mortelle</text></gloss>
      <gloss lang="en"><text>long illness, usually fatal</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 257: nàà-kɔ̀ŋjáá</text></form></note>
  </entry>
  <entry id="nàá-ó-nàá_2800">
    <lexical-unit><form lang="kqs"><text>nàá-ó-nàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>nàánàá</text></form></variant>
    <sense id="nàá-ó-nàá_2800_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, n'importe où, de place en place</text></gloss>
      <gloss lang="en"><text>everywhere, anywhere, from place to place</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nàá-ó-nàá</text></form></note>
  </entry>
  <entry id="naamu_2801">
    <lexical-unit><form lang="kqs"><text>naamu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>naamula</text></form></field>
    <sense id="naamu_2801_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coutume, tradition</text></gloss>
      <gloss lang="en"><text>custom, tradition</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first 1KI.18.28; Lexique kissi–français, p. 36: namuo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 36 écrit namuo « la coutume ».</text></form></note>
  </entry>
  <entry id="naanɔɔ_2802">
    <lexical-unit><form lang="kqs"><text>naanɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="naanɔɔ_2802_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>août</text></gloss>
      <gloss lang="en"><text>August</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around August (literally 'his sickness')</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Naanöö; Lexique kissi–français, p. 36: naanɔɔ; Childs 2000, p. 257: nààndɔ́ɔ</text></form></note>
  </entry>
  <entry id="nàápúm_2803">
    <lexical-unit><form lang="kqs"><text>nàápúm</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="nàápúm_2803_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>peut-être ; parfois</text></gloss>
      <gloss lang="en"><text>maybe, perhaps; sometimes</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.4 Semantic constituents related to verbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nàápúm</text></form></note>
  </entry>
  <entry id="náàtàtà_2804">
    <lexical-unit><form lang="kqs"><text>náàtàtà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ŋáàtàtà</text></form></variant>
    <sense id="náàtàtà_2804_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un arbre qui tombe dans la tempête, du vent violent, du bois qui se tord</text></gloss>
      <gloss lang="en"><text>sound of a tree falling in a storm, of strong wind, of twisting wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: náàtàtà</text></form></note>
  </entry>
  <entry id="nákà-nàkà_2805">
    <lexical-unit><form lang="kqs"><text>nákà-nàkà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nákà-nàkà_2805_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(trembler) de tout son corps, violemment</text></gloss>
      <gloss lang="en"><text>(tremble) violently, all over</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first 1SA.31.3</text></form></note>
    <note><form lang="fr"><text>Avec ɲiiya « trembler » : diallon ɲiiya ya nákà-nàkà « tout mon corps tremble » (Jb 21,6).</text></form></note>
  </entry>
  <entry id="nakɔɔ_2806">
    <lexical-unit><form lang="kqs"><text>nakɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nakɔlan</text></form></field>
    <variant><form lang="kqs"><text>nakɔ</text></form></variant>
    <variant><form lang="kqs"><text>nakɔla</text></form></variant>
    <sense id="nakɔɔ_2806_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jardin, plantation ; jardin, champ cultivé, plantation</text></gloss>
      <gloss lang="en"><text>garden, plantation ; garden, cultivated field, plantation</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>garden (Guéckédou dialect, borrowed from Maninka)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.2; Keita 1979, p. 142: Naaköö; Lexique kissi–français, p. 36: nakɔɔ; Childs 2000, p. 258: nákóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit une voyelle longue (Naaköö) ; la Bible écrit nakɔɔ (le jardin d'Éden).</text></form></note>
  </entry>
  <entry id="nambaa_2807">
    <lexical-unit><form lang="kqs"><text>nambaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>namba</text></form></variant>
    <sense id="nambaa_2807_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>glisser ; ramper ; monter sur (qqch)</text></gloss>
      <gloss lang="en"><text>slip, slide; crawl; climb onto (something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Nambaa; Lexique kissi–français, p. 36: nanbaa/ nanba</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence dans la Bible (JER 32,24), au sens incertain (« escalader » ?). Lexique kissi–français, p. 36 : nanbaa/ nanba « ramper ; monter sur qqch, glisser ».</text></form></note>
  </entry>
  <entry id="nàmbàwɛ́íyó_2808">
    <lexical-unit><form lang="kqs"><text>nàmbàwɛ́íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nàmbàwɛ́íyó_2808_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de banane</text></gloss>
      <gloss lang="en"><text>kind of banana</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nàmbàwɛ́íyó</text></form></note>
  </entry>
  <entry id="namtalen_2809">
    <lexical-unit><form lang="kqs"><text>namtalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="namtalen_2809_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut physique, infirmité ; paralysie</text></gloss>
      <gloss lang="en"><text>physical defect, infirmity; paralysis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.22.25; Keita 1979, p. 162: Namtalen; Lexique kissi–français, p. 36: namtalen; Childs 2000, p. 258: nâmtàá</text></form></note>
    <note><form lang="fr"><text>Keita : « paralysie » ; dans la Bible, « défaut » d'un animal (Dt 15,21).</text></form></note>
  </entry>
  <entry id="namtanɔɔ_2810">
    <lexical-unit><form lang="kqs"><text>namtanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>namtaa</text></form></field>
    <sense id="namtanɔɔ_2810_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>infirme, estropié ; personne ou animal ayant un défaut physique</text></gloss>
      <gloss lang="en"><text>cripple, lame person; person or animal with a physical defect</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.21.17; Childs 2000, p. 258: nâmtàá</text></form></note>
    <note><form lang="fr"><text>vanaa sumɛiya a namtaa « les aveugles et les boiteux » (2SA.5.6). Cf. namtalen « défaut, infirmité ».</text></form></note>
  </entry>
  <entry id="nánde_2811">
    <lexical-unit><form lang="kqs"><text>nánde</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>náŋndéè</text></form></variant>
    <sense id="nánde_2811_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>cette année</text></gloss>
      <gloss lang="en"><text>this year</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nánde</text></form></note>
  </entry>
  <entry id="nannde_2812">
    <lexical-unit><form lang="kqs"><text>nannde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nannde_2812_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>cette année</text></gloss>
      <gloss lang="en"><text>this year</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: nannde</text></form></note>
    <note><form lang="fr"><text>Lexique, p. 36 : aussi nan « cette année ». Childs : nánde (kissi du Sud).</text></form></note>
  </entry>
  <entry id="nanu_2813">
    <lexical-unit><form lang="kqs"><text>nanu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nanu_2813_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ici</text></gloss>
      <gloss lang="en"><text>here</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 506 occurrences, first GEN.15.16; Lexique kissi–français, p. 36: nanu; Childs 2000, p. 258: nánùŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 36 : aussi na et nanun « ici ».</text></form></note>
  </entry>
  <entry id="nanɔɔ_2814">
    <lexical-unit><form lang="kqs"><text>nanɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nan</text></form></variant>
    <variant><form lang="kqs"><text>nannin</text></form></variant>
    <variant><form lang="kqs"><text>nennin</text></form></variant>
    <sense id="nanɔɔ_2814_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tirer</text></gloss>
      <gloss lang="en"><text>pull, draw</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pull, suck, drag</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.34.3; Keita 1979, p. 114: Nanöö; Lexique kissi–français, p. 36: nanɔɔ/ nan, nen; Childs 2000, p. 258: nànɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Radical en e de Keita : nen ; nennin (JDG 4,7). Le Lexique kissi–français donne aussi : nen.</text></form></note>
  </entry>
  <entry id="naw cuao_2815">
    <lexical-unit><form lang="kqs"><text>naw cuao</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="naw cuao_2815_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>veau</text></gloss>
      <gloss lang="en"><text>calf</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: naw cuao</text></form></note>
    <note><form lang="fr"><text>naw « bovin » et cuao « petit (d'animal) » sont dans la Bible séparément.</text></form></note>
  </entry>
  <entry id="nawvo_2816">
    <lexical-unit><form lang="kqs"><text>nawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>nawva</text></form></field>
    <variant><form lang="kqs"><text>naw</text></form></variant>
    <variant><form lang="kqs"><text>navaa</text></form></variant>
    <sense id="nawvo_2816_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vache, bœuf ; bovin</text></gloss>
      <gloss lang="en"><text>cow, ox; cattle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.21.28; Lexique kissi–français, p. 36: nawvo; Childs 2000, p. 259: nàùwɔ́</text></form></note>
    <note><form lang="fr"><text>navaa tovaa « jeunes taureaux ».</text></form></note>
  </entry>
  <entry id="náŋ_2817">
    <lexical-unit><form lang="kqs"><text>náŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="náŋ_2817_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>déjà, autrefois, auparavant ; ici</text></gloss>
      <gloss lang="en"><text>already, once, before; here</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: náŋ</text></form></note>
  </entry>
  <entry id="nàŋǎŋndó_2818">
    <lexical-unit><form lang="kqs"><text>nàŋǎŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>nàŋáŋndó</text></form></variant>
    <variant><form lang="kqs"><text>nààŋáŋndó</text></form></variant>
    <sense id="nàŋǎŋndó_2818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amitié ; meilleur ami</text></gloss>
      <gloss lang="en"><text>friendship; best friend</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 259: nàŋǎŋndó</text></form></note>
    <note><form lang="fr"><text>Dérivé de nàŋɔ̀ɔ́ « être bon » (cf. naŋɔɔ, Bible).</text></form></note>
  </entry>
  <entry id="nàŋgàá_2819">
    <lexical-unit><form lang="kqs"><text>nàŋgàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nàŋgàá_2819_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>natte souple (pour jouer à la toupie) ; maladie par manque de sang ; coiffure de femme</text></gloss>
      <gloss lang="en"><text>soft mat (used for playing tops); sickness from lack of blood; a woman's hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 259: nàŋgàá</text></form></note>
  </entry>
  <entry id="naŋu_2820">
    <lexical-unit><form lang="kqs"><text>naŋu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>naŋun</text></form></variant>
    <sense id="naŋu_2820_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>incliner, abaisser ; (naŋun) se pencher</text></gloss>
      <gloss lang="en"><text>bend down, bow (something); (naŋun) lean down, stoop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bend, be bent; tip; settle a matter secretly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.18.10; Childs 2000, p. 259: nàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Mó naŋu halataalaa « il abaissa les cieux » (PSA.18.10) ; mó naŋun le tofaa « il s'est penché pour regarder » (PSA.102.20). À distinguer de naŋɔɔ « être bon ».</text></form></note>
  </entry>
  <entry id="naŋɔɔ_2821">
    <lexical-unit><form lang="kqs"><text>naŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>naŋ</text></form></variant>
    <variant><form lang="kqs"><text>naŋnin</text></form></variant>
    <sense id="naŋɔɔ_2821_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être bon, beau, agréable ; plaire ; bonté, beauté</text></gloss>
      <gloss lang="en"><text>be good, beautiful, pleasing; goodness, beauty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be good, fine, beautiful; be generous, morally good</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 170 occurrences, first GEN.2.12; Lexique kissi–français, p. 36: naŋɔɔ/ naŋ, niŋ; Childs 2000, p. 259: nàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>naŋ kɔl a … « aimer, apprécier » (1 S 18,5). Lexique kissi–français, p. 36 : aussi naŋoo « bienfaits, beauté ».</text></form></note>
  </entry>
  <entry id="nda_2822">
    <lexical-unit><form lang="kqs"><text>nda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nda_2822_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>eux, elles, les</text></gloss>
      <gloss lang="en"><text>them (independent)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15820 occurrences, first GEN.1.21; Lexique kissi–français, p. 36: nda; Childs 2000, p. 266: ndá</text></form></note>
  </entry>
  <entry id="nda_2823">
    <lexical-unit><form lang="kqs"><text>nda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
