    <trait name="status" value="southern"/>
    <sense id="kpûlɛ́ɛ̀-kpûlɛ́ɛ̀_1975_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mouvement lent et pénible (dans un liquide épais)</text></gloss>
      <gloss lang="en"><text>slow, laboured movement (in a thick liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 219: kpûlɛ́ɛ̀-kpûlɛ́ɛ̀</text></form></note>
  </entry>
  <entry id="kpundɔɔ_1976">
    <lexical-unit><form lang="kqs"><text>kpundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpundɔɔ_1976_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>malheur, calamité, désastre</text></gloss>
      <gloss lang="en"><text>misfortune, calamity, disaster</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>accident, mishap, trouble; also a braided sacrificial vine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.19.19; Childs 2000, p. 219: kpùndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>mò baŋa ya a kpundɔɔ ho « qu'il éloigne de moi ce fléau » (EXO.10.17).</text></form></note>
  </entry>
  <entry id="kpundɛ_1977">
    <lexical-unit><form lang="kqs"><text>kpundɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kpundɛlan</text></form></field>
    <sense id="kpundɛ_1977_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fléau, calamité</text></gloss>
      <gloss lang="en"><text>plague, calamity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>trouble, mishap, misfortune</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 68 occurrences, first GEN.9.11; Childs 2000, p. 219: kpùndéláŋ</text></form></note>
  </entry>
  <entry id="kpungbɛi_1978">
    <lexical-unit><form lang="kqs"><text>kpungbɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kpungban</text></form></field>
    <sense id="kpungbɛi_1978_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>morceau, bloc, masse</text></gloss>
      <gloss lang="en"><text>lump, piece, mass</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.14.35</text></form></note>
    <note><form lang="fr"><text>cuɛima nɔnɔan man kpungban tɔ́ « dix fromages » (1 S 17,18) ; sianin kpungban « pièces d'or » (Esd 2,69).</text></form></note>
  </entry>
  <entry id="kpuo_1979">
    <lexical-unit><form lang="kqs"><text>kpuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kpuo_1979_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pièce</text></gloss>
      <gloss lang="en"><text>piece (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 29: kpuo</text></form></note>
    <note><form lang="fr"><text>Sens précis de « pièce » (morceau, monnaie, chambre ?) à confirmer.</text></form></note>
  </entry>
  <entry id="kpúù_1980">
    <lexical-unit><form lang="kqs"><text>kpúù</text></form></lexical-unit>
