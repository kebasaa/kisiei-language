    <variant><form lang="kqs"><text>kpingbian</text></form></variant>
    <sense id="kpingbi_1899_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(obscurité) épaisse, profonde</text></gloss>
      <gloss lang="en"><text>(darkness) thick, deep</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.1.2; Childs 2000, p. 214: kpíŋmgbí</text></form></note>
    <note><form lang="fr"><text>ɲumma … matoalaa kpingbi « les ténèbres couvraient » (GEN.1.2).</text></form></note>
  </entry>
