    <trait name="status" value="attested"/>
    <sense id="éé_784_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ô ! (vocatif, en s'adressant à qqn)</text></gloss>
      <gloss lang="en"><text>O! (vocative, addressing someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>vocative particle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 280 occurrences, first GEN.19.18; Childs 2000, p. 92: ê</text></form></note>
    <note><form lang="fr"><text>Éé Mɛlɛka ! « Ô Seigneur ! » (GEN.49.18) ; Éé Pua « Ô mon père » (GEN.27.34).</text></form></note>
  </entry>
  <entry id="èèè_785">
