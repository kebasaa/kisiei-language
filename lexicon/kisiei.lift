    <trait name="status" value="attested"/>
    <sense id="len_2409_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce, cette (classe len)</text></gloss>
      <gloss lang="en"><text>this, that (len class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2940 occurrences, first GEN.2.3; Childs 2000, p. 227: léŋ</text></form></note>
  </entry>
  <entry id="lenamta_2410">
    <lexical-unit><form lang="kqs"><text>lenamta</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lenamta_2410_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut, tare (nɔ lenamta loo « sans défaut »)</text></gloss>
      <gloss lang="en"><text>blemish, defect (nɔ lenamta loo 'without blemish')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first EXO.12.5; Childs 2000, p. 258: nâmtàá</text></form></note>
  </entry>
  <entry id="lende_2411">
    <lexical-unit><form lang="kqs"><text>lende</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lende_2411_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ainsi, de cette façon, comme cela</text></gloss>
      <gloss lang="en"><text>thus, so, in this way, like that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1554 occurrences, first GEN.1.7; Childs 2000, p. 226: léndé</text></form></note>
    <note><form lang="fr"><text>Mí ɲɔɔ tosan lende « et il en fut ainsi » (GEN.1.7) ; lende koni « de même ».</text></form></note>
  </entry>
  <entry id="lèndè-_2412">
    <lexical-unit><form lang="kqs"><text>lèndè-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lèndè-_2412_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>jeune, petit ; second, adjoint (vice-)</text></gloss>
      <gloss lang="en"><text>young, small; second, deputy (vice-)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 227: lèndè-</text></form></note>
    <note><form lang="fr"><text>Cf. peut-être lendòó (Bible, JOB.21.19), au sens incertain.</text></form></note>
  </entry>
  <entry id="lendulun_2413">
    <lexical-unit><form lang="kqs"><text>lendulun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lendulɔn</text></form></variant>
    <sense id="lendulun_2413_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vendre, se mettre en gage (comme serviteur)</text></gloss>
      <gloss lang="en"><text>sell oneself, pawn oneself (as a servant)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first LEV.25.39; Childs 2000, p. 227: lèndùlɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>o lendulun bɛngu « pendant le temps où il s'est vendu » (Lv 25,51).</text></form></note>
  </entry>
  <entry id="lenin_2414">
    <lexical-unit><form lang="kqs"><text>lenin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lenin_2414_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dedans, à l'intérieur ; dans (après le nom)</text></gloss>
      <gloss lang="en"><text>inside, within; in (after the noun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.4 Inner part"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 591 occurrences, first GEN.2.1; Childs 2000, p. 227: lènìŋ</text></form></note>
    <note><form lang="fr"><text>mà yikpa ndu lenin a lekɔɔli « tu l'enduiras dedans et dehors » (GEN.6.14).</text></form></note>
  </entry>
  <entry id="leo_2415">
    <lexical-unit><form lang="kqs"><text>leo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>leelan</text></form></field>
    <sense id="leo_2415_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corne</text></gloss>
      <gloss lang="en"><text>horn</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.41.18; Keita 1979, p. 136: Leu; Lexique kissi–français, p. 32: leu; Childs 2000, p. 226: lèèyó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Leu ; la Bible a leo (HOS.5.8), la forme radicale lee et le pluriel leelan (DAN.8.3). Lexique kissi–français, p. 32 : écrit leu « la corne ».</text></form></note>
  </entry>
  <entry id="lepalaa_2416">
    <lexical-unit><form lang="kqs"><text>lepalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lepala</text></form></variant>
    <sense id="lepalaa_2416_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>chaque jour (lepalaa-lepala), tous les jours</text></gloss>
      <gloss lang="en"><text>daily, every day (lepalaa-lepala)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 123 occurrences, first GEN.6.5; Lexique kissi–français, p. 32: lepala</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 32 : le pala o le pala, lepala-lepala « chaque jour ».</text></form></note>
  </entry>
  <entry id="lepɔtɔllo_2417">
    <lexical-unit><form lang="kqs"><text>lepɔtɔllo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lepɔtɔltan</text></form></variant>
    <variant><form lang="kqs"><text>lepɔtɔl</text></form></variant>
    <variant><form lang="kqs"><text>lepɔtɔlta</text></form></variant>
    <sense id="lepɔtɔllo_2417_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>forcé, pénible (travail)</text></gloss>
