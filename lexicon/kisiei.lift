  <entry id="tamalaa_1619">
    <lexical-unit><form lang="kqs"><text>tamalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tamala</text></form></variant>
    <variant><form lang="kqs"><text>tamalanin</text></form></variant>
    <sense id="tamalaa_1619_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tarder, s'attarder ; durer longtemps</text></gloss>
      <gloss lang="en"><text>delay, tarry; last long</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) spending time unproductively, wasting time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.5.28; Childs 2000, p. 348: támáláá</text></form></note>
    <note><form lang="fr"><text>la tamalanin le cuvɔɔ « vous ne prolongerez pas vos jours » (Dt 4,26).</text></form></note>
  </entry>
