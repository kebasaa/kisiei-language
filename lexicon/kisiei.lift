      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tante</text></gloss>
      <gloss lang="en"><text>aunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>father's sister; also a spirit of the female initiation society</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bömöö; Childs 2000, p. 27: bɔ́mɔ̀ɔ́</text></form></note>
  </entry>
