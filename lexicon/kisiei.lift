    <lexical-unit><form lang="kqs"><text>isɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="isɔw_1357_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut, tache, imperfection</text></gloss>
      <gloss lang="en"><text>blemish, flaw</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first 2SA.14.25</text></form></note>
    <note><form lang="fr"><text>nɔ isɔw le « être sans défaut, intègre » (Ps 26,1).</text></form></note>
  </entry>
