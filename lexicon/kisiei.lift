  <entry id="cilinnde_212">
    <lexical-unit><form lang="kqs"><text>cilinnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cilinndon</text></form></field>
    <sense id="cilinnde_212_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer, métal ; balle, cartouche</text></gloss>
      <gloss lang="en"><text>iron, metal; bullet, cartridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, iron; twisted iron strips formerly used as money</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.34.17; Keita 1979, p. 156: Tyilinnde; Childs 2000, p. 48: cìlíŋndé</text></form></note>
    <note><form lang="fr"><text>La Bible n'a que le sens « fer, métal » ; « balle, cartouche » vient de Keita.</text></form></note>
  </entry>
  <entry id="cilinndon_213">
    <lexical-unit><form lang="kqs"><text>cilinndon</text></form></lexical-unit>
