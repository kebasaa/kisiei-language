  <entry id="luakolanɔɔ_2106">
    <lexical-unit><form lang="kqs"><text>luakolanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="luakolanɔɔ_2106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tisserand</text></gloss>
      <gloss lang="en"><text>weaver</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Luakolanöö</text></form></note>
  </entry>
  <entry id="luaŋ_2107">
    <lexical-unit><form lang="kqs"><text>luaŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luaŋ_2107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haut, côté supérieur ; nord (a ba luaŋ-ndo « vers le nord »)</text></gloss>
      <gloss lang="en"><text>top, upper side; north (a ba luaŋ-ndo, northward)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>upper part, up(hill)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 127 occurrences, first GEN.13.14; Childs 2000, p. 236: lùàŋ</text></form></note>
    <note><form lang="fr"><text>a ba luaŋ-ndo « au nord » (GEN.13.14) ; kèédei coo a ba luaŋ-ndo « sur le linteau » (EXO.12.7). Cf. maluaŋ « nord ».</text></form></note>
  </entry>
  <entry id="lùàŋndé_2108">
    <lexical-unit><form lang="kqs"><text>lùàŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ráŋndé</text></form></variant>
    <sense id="lùàŋndé_2108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colline, montagne ; clairière sur une hauteur ; lieu sacré</text></gloss>
      <gloss lang="en"><text>hill, mountain; clearing on a hill; sacred place</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 235: lùàŋndé</text></form></note>
    <note><form lang="fr"><text>Cf. luaŋ « haut, nord » (Bible).</text></form></note>
  </entry>
  <entry id="lùáŋndé-sòòlùùwó_2109">
    <lexical-unit><form lang="kqs"><text>lùáŋndé-sòòlùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lùáŋndé-sòòlùùwó_2109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cérémonie d'apaisement des ancêtres (repas préparé sur un rocher, part laissée aux ancêtres)</text></gloss>
      <gloss lang="en"><text>ceremony to appease the ancestors (meal cooked on a rocky hill, a share left for them)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùáŋndé-sòòlùùwó</text></form></note>
  </entry>
  <entry id="lueinun_2110">
    <lexical-unit><form lang="kqs"><text>lueinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lueinun_2110_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller vers (une femme) ; (… yoomuan) prendre courage, se fortifier</text></gloss>
      <gloss lang="en"><text>go in to (a woman); (… yoomuan) take courage, be strong</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.6.19</text></form></note>
    <note><form lang="fr"><text>Moyen de lueiyo. lueinun … coo « aller vers (une femme) » (Gn 16,2) ; réciproque lueinan yoomuan « s'encourager mutuellement » (1 Th 5,11).</text></form></note>
  </entry>
  <entry id="lueiyo_2111">
    <lexical-unit><form lang="kqs"><text>lueiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>luei</text></form></variant>
    <variant><form lang="kqs"><text>lueinin</text></form></variant>
    <sense id="lueiyo_2111_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire entrer, introduire, mettre dans ; causer (un malheur)</text></gloss>
      <gloss lang="en"><text>bring in, put in; cause (grief)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put in; also carry back, put away, return</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 114 occurrences, first GEN.6.5; Childs 2000, p. 236: lùèìyó</text></form></note>
    <note><form lang="fr"><text>Causatif de luɛyɔɔ « entrer ». luei … mɔnɛi lueiyo « causer du chagrin » (Gn 26,35). Bénéfactif lueilul « rapporter (un profit) à » (Pr 3,14).</text></form></note>
  </entry>
  <entry id="lùèíyó_2112">
    <lexical-unit><form lang="kqs"><text>lùèíyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lùèíyó_2112_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être tranchant, aiguisé</text></gloss>
      <gloss lang="en"><text>be sharp</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùèíyó</text></form></note>
  </entry>
  <entry id="lullo_2113">
    <lexical-unit><form lang="kqs"><text>lullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lul</text></form></variant>
    <sense id="lullo_2113_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fuir, laisser passer l'eau ; s'écouler</text></gloss>
      <gloss lang="en"><text>leak; drain away</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ECC.10.18; Childs 2000, p. 236: lùlló</text></form></note>
    <note><form lang="fr"><text>Lullo cɛiyo lul « le toit de la maison fuit » (ECC.10.18) ; mɛmma … co lullo « des eaux qui s'écoulent » (NAM.2.9).</text></form></note>
  </entry>
  <entry id="lum_2114">
    <lexical-unit><form lang="kqs"><text>lum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lum_2114_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire (au four), préparer (un repas)</text></gloss>
      <gloss lang="en"><text>bake, prepare (a meal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.19.3</text></form></note>
  </entry>
  <entry id="lùmbìáŋ_2115">
    <lexical-unit><form lang="kqs"><text>lùmbìáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lùmbèléŋ</text></form></field>
    <sense id="lùmbìáŋ_2115_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de raphia (piassava)</text></gloss>
      <gloss lang="en"><text>(piassava) palm wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùmbìáŋ</text></form></note>
    <note><form lang="fr"><text>Les notes manuscrites sur Keita portent « lumbian » à côté de Senhan « vin de raphia », avec un point d'interrogation.</text></form></note>
  </entry>
  <entry id="lùmbɔ́ɔ́_2116">
    <lexical-unit><form lang="kqs"><text>lùmbɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lùmbíáŋ</text></form></field>
    <sense id="lùmbɔ́ɔ́_2116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier raphia (piassava), qui donne du vin</text></gloss>
      <gloss lang="en"><text>piassava (raffia) palm, tapped for wine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùmbɔ́ɔ́</text></form></note>
  </entry>
  <entry id="lùmndé_2117">
    <lexical-unit><form lang="kqs"><text>lùmndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lùmndé_2117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>partie la plus profonde d'une rivière, tourbillon ; mort</text></gloss>
      <gloss lang="en"><text>deepest part of a river, whirlpool; death</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 236: lùmndé</text></form></note>
  </entry>
  <entry id="lumndo_2118">
    <lexical-unit><form lang="kqs"><text>lumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lumndo_2118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadet, le plus jeune (des enfants)</text></gloss>
      <gloss lang="en"><text>youngest child, last-born</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>last child born to a woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.42.13; Childs 2000, p. 236: lùmndó</text></form></note>
    <note><form lang="fr"><text>pɔmbɔ naa lumndo « notre plus jeune frère » (GEN.42.13).</text></form></note>
  </entry>
  <entry id="lusullo_2119">
    <lexical-unit><form lang="kqs"><text>lusullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lusul</text></form></variant>
    <variant><form lang="kqs"><text>lusulaa</text></form></variant>
    <sense id="lusullo_2119_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être lourd ; poids</text></gloss>
      <gloss lang="en"><text>be heavy; weight</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.14.25</text></form></note>
  </entry>
  <entry id="luusian_2120">
    <lexical-unit><form lang="kqs"><text>luusian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luusian_2120_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>errer, s'égarer ; être perdu</text></gloss>
      <gloss lang="en"><text>wander, go astray; be lost</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>play tricks, act foolishly; get lost, go missing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.21.14; Childs 2000, p. 237: lùùsìá</text></form></note>
  </entry>
  <entry id="luŋ_2121">
    <lexical-unit><form lang="kqs"><text>luŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="luŋ_2121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>place publique ; (o luŋ) en public, dehors</text></gloss>
      <gloss lang="en"><text>public square; (o luŋ) in public, outside</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.4.10</text></form></note>
    <note><form lang="fr"><text>cal o luŋ « s'asseoir sur la place » (Jg 19,15) ; yonda … o luŋ kpendekele « proclamer en public » (Lc 12,3).</text></form></note>
  </entry>
  <entry id="lúŋndéŋ_2122">
    <lexical-unit><form lang="kqs"><text>lúŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="lúŋndéŋ_2122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand palmier mort sans palmes (souvent frappé par la foudre)</text></gloss>
      <gloss lang="en"><text>tall dead palm tree without fronds (often struck by lightning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 237: lúŋndéŋ</text></form></note>
  </entry>
  <entry id="luɛyaa_2123">
    <lexical-unit><form lang="kqs"><text>luɛyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>luɛyaalan</text></form></field>
    <variant><form lang="kqs"><text>luɛyaala</text></form></variant>
    <sense id="luɛyaa_2123_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entrée, porte (de ville)</text></gloss>
      <gloss lang="en"><text>entrance, gate</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first EXO.4.25</text></form></note>
    <note><form lang="fr"><text>Nom verbal de luɛyɔɔ « entrer ».</text></form></note>
  </entry>
  <entry id="luɛyɔɔ_2124">
    <lexical-unit><form lang="kqs"><text>luɛyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>luɛi</text></form></variant>
    <variant><form lang="kqs"><text>luɛinin</text></form></variant>
    <sense id="luɛyɔɔ_2124_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entrer ; arriver, survenir</text></gloss>
      <gloss lang="en"><text>enter, go in; come, arrive</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>enter, come in; put in; produce in quantity (crops)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 209 occurrences, first GEN.6.18; Childs 2000, p. 236: lùèyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="luɛyɔɔninndo_2125">
    <lexical-unit><form lang="kqs"><text>luɛyɔɔninndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="luɛyɔɔninndo_2125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pot-de-vin</text></gloss>
      <gloss lang="en"><text>bribe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first DEU.27.25</text></form></note>
    <note><form lang="fr"><text>De luɛyɔɔ « entrer ». cɛl luɛyɔɔninndo « accepter un pot-de-vin » (Dt 27,25).</text></form></note>
  </entry>
  <entry id="lɔ́-kùɛ̀ɛ́nɛ́_2126">
    <lexical-unit><form lang="kqs"><text>lɔ́-kùɛ̀ɛ́nɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lɔ́-kùɛ̀ɛ́nɛ́_2126_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>quand ? (litt. « quel (jour de) marché »)</text></gloss>
      <gloss lang="en"><text>when? (literally 'which market day')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 234: lɔ́-kùɛ̀ɛ́nɛ́</text></form></note>
  </entry>
  <entry id="lɔaa_2127">
    <lexical-unit><form lang="kqs"><text>lɔaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔanin</text></form></variant>
    <variant><form lang="kqs"><text>lɔa</text></form></variant>
    <sense id="lɔaa_2127_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper ; jouer (d'un instrument) ; frapper (à la porte)</text></gloss>
      <gloss lang="en"><text>strike, beat; play (an instrument) ; strike, beat; play (an instrument); knock</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hit, beat, strike</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.4.21; Keita 1979, p. 115: Löö; Childs 2000, p. 235: lɔ̀wàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit löö (radicaux lö, loo, löa) ; la Bible a lɔaa (GEN 32,26 ; GEN 4,21) et lɔanin (ISA 11,4).</text></form></note>
  </entry>
  <entry id="lɔalaa_2128">
    <lexical-unit><form lang="kqs"><text>lɔalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔalu</text></form></variant>
    <variant><form lang="kqs"><text>lɔalunin</text></form></variant>
    <sense id="lɔalaa_2128_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accuser, dénoncer, calomnier</text></gloss>
      <gloss lang="en"><text>accuse, denounce, slander</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ZEC.3.1</text></form></note>
    <note><form lang="fr"><text>vana lɔalaa n'vanndo « l'accusateur » (Za 3,1).</text></form></note>
  </entry>
  <entry id="lɔan_2129">
    <lexical-unit><form lang="kqs"><text>lɔan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔma</text></form></variant>
    <sense id="lɔan_2129_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sommeil</text></gloss>
      <gloss lang="en"><text>sleep</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleep (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 123 occurrences, first GEN.2.21; Childs 2000, p. 235: lùáŋ</text></form></note>
  </entry>
  <entry id="lɔ̀cɔ̀ɔ́_2130">
    <lexical-unit><form lang="kqs"><text>lɔ̀cɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>lɔ̀cɔ̀léŋ</text></form></field>
    <sense id="lɔ̀cɔ̀ɔ́_2130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante comestible gluante (sert aussi à graisser les moules à briques)</text></gloss>
      <gloss lang="en"><text>slimy edible plant (also used to grease brick moulds)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 233: lɔ̀cɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="lɔl_2131">
    <lexical-unit><form lang="kqs"><text>lɔl</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lɔl_2131_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer la nuit, loger, séjourner</text></gloss>
      <gloss lang="en"><text>spend the night, lodge, dwell</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.4.20</text></form></note>
    <note><form lang="fr"><text>Forme longue non attestée dans la Bible.</text></form></note>
  </entry>
  <entry id="lɔlnun_2132">
    <lexical-unit><form lang="kqs"><text>lɔlnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lɔlnin</text></form></variant>
    <sense id="lɔlnun_2132_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se coucher pour dormir, dormir ; passer la nuit</text></gloss>
      <gloss lang="en"><text>lie down to sleep, sleep; spend the night</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first JDG.19.6; Childs 2000, p. 234: lɔ̀lnɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>i lɔlnun a kɔlɲuloo « je me couche et je dors en paix » (PSA.4.9) ; Cɛl mì n lɔlnun vɛlɛ hau nanu « reste encore cette nuit ici » (JDG.19.6). Cf. lɔl « passer la nuit ».</text></form></note>
  </entry>
  <entry id="lɔloo_2133">
    <lexical-unit><form lang="kqs"><text>lɔloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lɔlulan</text></form></field>
    <variant><form lang="kqs"><text>lɔlu</text></form></variant>
    <sense id="lɔloo_2133_s1">
