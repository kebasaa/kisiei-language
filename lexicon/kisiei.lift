  <entry id="ɲuluan_4188">
    <lexical-unit><form lang="kqs"><text>ɲuluan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲuluma</text></form></variant>
    <variant><form lang="kqs"><text>ɲuluei</text></form></variant>
    <sense id="ɲuluan_4188_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>frais, froid</text></gloss>
      <gloss lang="en"><text>cool, cold</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PRO.25.25; Childs 2000, p. 282: ɲùlú-</text></form></note>
    <note><form lang="fr"><text>mɛmma ɲuluan « eau fraîche » (MAT.10.42, PRO.25.25) ; mɛmma ɲuluma (JER.18.14) ; ɲuluei (PRO.25.13, fraîcheur de la neige).</text></form></note>
  </entry>
  <entry id="ɲùlùáŋ_4189">
    <lexical-unit><form lang="kqs"><text>ɲùlùáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="ɲùlùáŋ_4189_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potion, remède (eau froide mêlée de feuilles)</text></gloss>
      <gloss lang="en"><text>potion, medicine (cold water mixed with leaves)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 282: ɲùlùáŋ</text></form></note>
  </entry>
  <entry id="ɲulul_4190">
    <lexical-unit><form lang="kqs"><text>ɲulul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲulul_4190_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se calmer, s'apaiser (kɔl)</text></gloss>
      <gloss lang="en"><text>calm down, be appeased (kɔl)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.27.44</text></form></note>
  </entry>
  <entry id="ɲúmbàltéŋ_4191">
    <lexical-unit><form lang="kqs"><text>ɲúmbàltéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="ɲúmbàltéŋ_4191_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (sert à faire des pièges à rats)</text></gloss>
      <gloss lang="en"><text>a tree species (used for rat traps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 282: ɲúmbàltéŋ</text></form></note>
  </entry>
  <entry id="ɲúmbùláá_4192">
    <lexical-unit><form lang="kqs"><text>ɲúmbùláá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="ɲúmbùláá_4192_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pénis non circoncis</text></gloss>
      <gloss lang="en"><text>uncircumcised penis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 282: ɲúmbùláá</text></form></note>
  </entry>
  <entry id="ɲumbɔɔ_4193">
    <lexical-unit><form lang="kqs"><text>ɲumbɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲuumbun</text></form></variant>
    <sense id="ɲumbɔɔ_4193_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tourner (la meule), moudre ; (ɲuumbun) tourner (sur ses gonds)</text></gloss>
      <gloss lang="en"><text>turn (a millstone), grind; (ɲuumbun) turn (on its hinges)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>twist, turn, braid</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JDG.16.21; Childs 2000, p. 282: ɲùmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>pow bɛndu cuiyaa n'kullo ɲumbɔɔ « tourner la grosse meule » (JDG.16.21) ; mɛɛ dioo ɲuumbun o boondun ndɔn coo « comme la porte tourne sur ses gonds » (PRO.26.14).</text></form></note>
  </entry>
  <entry id="ɲumi_4194">
    <lexical-unit><form lang="kqs"><text>ɲumi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲumi_4194_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>effacer, anéantir</text></gloss>
      <gloss lang="en"><text>wipe out, blot out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first EXO.32.32</text></form></note>
  </entry>
  <entry id="ɲùmícílìó_4195">
