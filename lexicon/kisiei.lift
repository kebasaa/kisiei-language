      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meet, confront; also combat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.29; Childs 2000, p. 45: cììkăŋndó</text></form></note>
  </entry>
  <entry id="ciiku_426">
    <lexical-unit><form lang="kqs"><text>ciiku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciiku_426_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>découvrir, s'apercevoir de ; soupçonner</text></gloss>
      <gloss lang="en"><text>find out, notice; suspect</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.5; Childs 2000, p. 45: cììkùùwó</text></form></note>
    <note><form lang="fr"><text>mò ciiku laa ndɔ « s'il soupçonne sa femme » (Nb 5,14).</text></form></note>
  </entry>
  <entry id="cììmàá_427">
    <lexical-unit><form lang="kqs"><text>cììmàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cììmàá_427_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frotter avec les mains, presser, tordre (le linge)</text></gloss>
      <gloss lang="en"><text>rub with the hands, press, squeeze, wring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 45: cììmàá</text></form></note>
    <note><form lang="fr"><text>Comparer ciimiaa « écraser, piétiner » (Bible), qui a la forme du pluriel verbal.</text></form></note>
  </entry>
  <entry id="ciimbuu_428">
