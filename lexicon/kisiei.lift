    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùùyéláŋ</text></form></field>
    <sense id="fùùyɔ́ɔ́_927_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine haute ; coiffe des initiées</text></gloss>
      <gloss lang="en"><text>high female hairstyle; headpiece of female initiates</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùyɔ́ɔ́</text></form></note>
  </entry>
  <entry id="fúwáléŋ_928">
