    <trait name="status" value="respelled"/>
    <sense id="takan_3897_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>il y a trois ans</text></gloss>
      <gloss lang="en"><text>three years ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: takan</text></form></note>
