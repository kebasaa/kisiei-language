      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>entre, parmi</text></gloss>
      <gloss lang="en"><text>between, among</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2313 occurrences, first GEN.1.6</text></form></note>
  </entry>
  <entry id="tɛ̀ɛ̀ndo_1293">
    <lexical-unit><form lang="kqs"><text>tɛ̀ɛ̀ndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛ̀ɛ̀ndo_1293_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>teigne</text></gloss>
      <gloss lang="en"><text>scalp ringworm, scall</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ringworm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.11.4; Keita 1979, p. 162: Tèèndo; Childs 2000, p. 355: tɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit tɛ̀ɛ̀ndo dans ce sens ; tɛɛndo sans ton y signifie « du milieu » (Ex 26,28).</text></form></note>
  </entry>
  <entry id="tɛɛngaa_1294">
    <lexical-unit><form lang="kqs"><text>tɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛngaa_1294_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, transporter ; transmettre (un message)</text></gloss>
      <gloss lang="en"><text>convey, carry across; deliver (a message)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 619 occurrences, first GEN.20.7</text></form></note>
    <note><form lang="fr"><text>vana-tɛɛngaa-diom-Hala « prophète » ; vanaa tɛɛngaa « les marins » (Jon 1,5).</text></form></note>
  </entry>
