      <gloss lang="en"><text>(fine) linen</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first EXO.28.5</text></form></note>
  </entry>
  <entry id="kééwéé-kééwéé_1298">
