      <gloss lang="fr"><text>écuelle</text></gloss>
      <gloss lang="en"><text>bowl</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Bokio; Lexique kissi–français, p. 7: bokio</text></form></note>
  </entry>
  <entry id="bókpɔ̀nì_225">
    <lexical-unit><form lang="kqs"><text>bókpɔ̀nì</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bókpɔ̀nìá</text></form></field>
    <sense id="bókpɔ̀nì_225_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune fille (16 ans ou moins)</text></gloss>
      <gloss lang="en"><text>young girl (16 or younger)</text></gloss>
