      <gloss lang="fr"><text>sûrement, certainement ; obligatoire, il faut</text></gloss>
      <gloss lang="en"><text>surely, certainly; compulsory, necessarily</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>truly; marks obligation, must</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.41.32; Lexique kissi–français, p. 21: kangaran; Childs 2000, p. 148: káŋgáláŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 21 : kangaran « obligatoire, il faut ».</text></form></note>
  </entry>
