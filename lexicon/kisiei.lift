      <gloss lang="fr"><text>nom d'un culte (gardé par le sarino)</text></gloss>
      <gloss lang="en"><text>name of a cult (kept by the sarino)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: kɔsɔa</text></form></note>
  </entry>
  <entry id="kɔsɔndo_2875">
    <lexical-unit><form lang="kqs"><text>kɔsɔndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔsɔndo_2875_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand panier luté à la bouse de vache (pour le riz battu)</text></gloss>
      <gloss lang="en"><text>large basket sealed with cow dung (for threshed rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: kɔsɔndo</text></form></note>
  </entry>
  <entry id="kɔsɔnndo_2876">
