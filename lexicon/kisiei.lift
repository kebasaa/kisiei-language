    <sense id="yàwǎŋndó_4628_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se détacher en pelant (croûte)</text></gloss>
      <gloss lang="en"><text>peel off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 400: yàwǎŋndó</text></form></note>
  </entry>
  <entry id="yáwèlè-yáwèlè_4629">
    <lexical-unit><form lang="kqs"><text>yáwèlè-yáwèlè</text></form></lexical-unit>
