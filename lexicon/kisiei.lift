  <entry id="kolɔɔ_1671">
    <lexical-unit><form lang="kqs"><text>kolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kol</text></form></variant>
    <variant><form lang="kqs"><text>kola</text></form></variant>
    <variant><form lang="kqs"><text>kolnin</text></form></variant>
    <sense id="kolɔɔ_1671_s1">
      <grammatical-info value="Verb"/>
