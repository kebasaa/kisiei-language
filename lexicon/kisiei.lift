      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.21.30; Lexique kissi–français, p. 47: seelen; Childs 2000, p. 324: séìlɛ́ŋ</text></form></note>
