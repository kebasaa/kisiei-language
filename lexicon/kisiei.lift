      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pour</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.28.18; Childs 2000, p. 348: tàlàá</text></form></note>
  </entry>
  <entry id="táláá_3265">
    <lexical-unit><form lang="kqs"><text>táláá</text></form></lexical-unit>
