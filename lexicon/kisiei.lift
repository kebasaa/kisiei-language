  <entry id="siɛdiiyo_4646">
    <lexical-unit><form lang="kqs"><text>siɛdiiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɛdiiyo_4646_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>temps futur</text></gloss>
      <gloss lang="en"><text>future tense</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 397: Sièdiiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="síɛ́kísíɛ́kíó_4647">
    <lexical-unit><form lang="kqs"><text>síɛ́kísíɛ́kíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="síɛ́kísíɛ́kíó_4647_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte (genre abeille) qui fait du bruit en hochant la tête</text></gloss>
      <gloss lang="en"><text>bee-like insect that makes a noise by nodding its head</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 331: síɛ́kísíɛ́kíó</text></form></note>
  </entry>
  <entry id="siɛlaa_4648">
    <lexical-unit><form lang="kqs"><text>siɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛla</text></form></variant>
    <variant><form lang="kqs"><text>siɛlanin</text></form></variant>
    <sense id="siɛlaa_4648_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trébucher, glisser, chanceler</text></gloss>
      <gloss lang="en"><text>stumble, slip, totter</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slip; also change the topic; dance</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.55.23; Lexique kissi–français, p. 48: sɛlaa/ sɛla; Childs 2000, p. 331: sìɛ̀làá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 48 : écrit sɛlaa/ sɛla.</text></form></note>
  </entry>
  <entry id="siɛlii mamɛnndo_4649">
    <lexical-unit><form lang="kqs"><text>siɛlii mamɛnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɛlii mamɛnndo_4649_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aquarelle</text></gloss>
      <gloss lang="en"><text>watercolour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 9: Sièlii mamènndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="siɛlɛiyo_4650">
    <lexical-unit><form lang="kqs"><text>siɛlɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siɛlɛiyo_4650_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>paresseux ; paresse</text></gloss>
      <gloss lang="en"><text>lazy; laziness</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first JDG.18.9; Terminologie (idéologie), n° 482: Dièi, Sièlèiyo; Childs 2000, p. 331: sìèlɛ́í-</text></form></note>
  </entry>
  <entry id="siɛmbulan_4651">
    <lexical-unit><form lang="kqs"><text>siɛmbulan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛmbula</text></form></variant>
    <sense id="siɛmbulan_4651_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honte, opprobre</text></gloss>
      <gloss lang="en"><text>shame, disgrace</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shame; shyness, bashfulness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 233 occurrences, first GEN.30.23; Paulme 1964, p. 91: sɛmbura; Lexique kissi–français, p. 48: sɛnburan; Childs 2000, p. 336: sìɔ́mbúlɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 48 : écrit sɛnburan. Paulme 1964, p. 91 : sɛmbura ta bi ya « la honte m'a attrapé » ; ɔ nɔra sɛmbure « il n'a pas honte » ; se dit du mari qui, ne pouvant payer la dot, s'installe chez ses beaux-parents et travaille pour eux.</text></form></note>
  </entry>
  <entry id="siɛmbulan tuisioo_4652">
    <lexical-unit><form lang="kqs"><text>siɛmbulan tuisioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>dɔɔniaa</text></form></variant>
    <variant><form lang="kqs"><text>kpaayɔ suiyo</text></form></variant>
    <sense id="siɛmbulan tuisioo_4652_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>humiliation</text></gloss>
      <gloss lang="en"><text>humiliation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 344: Sièmbulan tuisioo, dööniaa, kpaayö suiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « abaisser la honte » ? ; aussi dɔɔniaa, kpaayɔ suiyo.</text></form></note>
  </entry>
  <entry id="siɛmbullo_4653">
    <lexical-unit><form lang="kqs"><text>siɛmbullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>siɛmbullon</text></form></field>
    <variant><form lang="kqs"><text>siɛmbulle</text></form></variant>
    <sense id="siɛmbullo_4653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ronce, buisson épineux</text></gloss>
      <gloss lang="en"><text>brier, thorn bush</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the fern tree (thorny) and its flowers</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.7.16; Childs 2000, p. 336: sìɔ̀mbúllɔ́</text></form></note>
    <note><form lang="fr"><text>hɛɛnndon a siɛmbulle « épines et ronces » (Es 7,23).</text></form></note>
  </entry>
  <entry id="siɛndi_4654">
    <lexical-unit><form lang="kqs"><text>siɛndi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siɛndi_4654_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre (la main)</text></gloss>
      <gloss lang="en"><text>stretch out (the hand)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 63 occurrences, first GEN.8.9</text></form></note>
  </entry>
  <entry id="síɛ́ndìíyáŋ_4655">
    <lexical-unit><form lang="kqs"><text>síɛ́ndìíyáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="síɛ́ndìíyáŋ_4655_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parfum</text></gloss>
      <gloss lang="en"><text>perfume</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 331: síɛ́ndìíyáŋ</text></form></note>
  </entry>
  <entry id="siɛndilen_4656">
    <lexical-unit><form lang="kqs"><text>siɛndilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="siɛndilen_4656_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aiguille</text></gloss>
      <gloss lang="en"><text>needle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Sièndilen; Paulme 1964, p. 91 (G): sɛnde, pl. sɛndya; Lexique kissi–français, p. 49: siɛndilen; Childs 2000, p. 331: sìɛ̀ndíléŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 48 : aussi sɛndilen. Paulme 1964, p. 91 : sɛnde, pl. sɛndya ; syɛndile /G./ « aiguille ».</text></form></note>
  </entry>
  <entry id="siɛttullo_4657">
    <lexical-unit><form lang="kqs"><text>siɛttullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɛttullo_4657_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>action (titre)</text></gloss>
      <gloss lang="en"><text>share (finance)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
      <trait name="semantic-domain-ddp4" value="6.9 Business organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 15: Yönndo, sièttullo, sièttio</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi siɛttio et yɔnndo ; « actionnaire » : vana sièttulaa sièttulnö (histoire n° 16).</text></form></note>
  </entry>
  <entry id="siɛtullan_4658">
    <lexical-unit><form lang="kqs"><text>siɛtullan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɛtullan_4658_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>huile (beurre) de karité</text></gloss>
      <gloss lang="en"><text>shea butter</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Siètullan; Lexique kissi–français, p. 49: siɛtullan</text></form></note>
  </entry>
  <entry id="síɛ́ŋndó_4659">
    <lexical-unit><form lang="kqs"><text>síɛ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="síɛ́ŋndó_4659_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grillon</text></gloss>
      <gloss lang="en"><text>cricket</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 332: síɛ́ŋndó</text></form></note>
  </entry>
  <entry id="siɛɛliaa_4660">
    <lexical-unit><form lang="kqs"><text>siɛɛliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛlia</text></form></variant>
    <sense id="siɛɛliaa_4660_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>glisser, chanceler, tituber ; (nɛi … siɛɛliaa) chemin glissant</text></gloss>
      <gloss lang="en"><text>slip, stagger, totter; (nɛi … siɛɛliaa) slippery path</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slip, slide (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.35.6; Childs 2000, p. 331: sìɛ̀ɛ̀lìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de siɛlaa « trébucher ». o co naa malɔɔ siɛɛliaa « il ne laisse pas nos pieds glisser » (PSA.66.9) ; mɛɛ vana mɔiyan ma co o hɔl-lo siɛɛliaa « comme un homme ivre qui titube » (ISA.24.20) ; nɛi vana siɛɛliaa coo (PSA.35.6).</text></form></note>
  </entry>
  <entry id="siɛɛlii macuɛiyo_4661">
    <lexical-unit><form lang="kqs"><text>siɛɛlii macuɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɛɛlii macuɛiyo_4661_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peinture à l'huile</text></gloss>
      <gloss lang="en"><text>oil painting</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 212: Sièèlii matyuèiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. siɛlii mamɛnndo « aquarelle ».</text></form></note>
  </entry>
  <entry id="síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀_4662">
