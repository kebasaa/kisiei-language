  <entry id="médèíyé_2244">
    <lexical-unit><form lang="kqs"><text>médèíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>méédèíyé</text></form></variant>
    <sense id="médèíyé_2244_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insigne, médaille</text></gloss>
      <gloss lang="en"><text>badge, medal</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 244: médèíyé</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais medal.</text></form></note>
  </entry>
  <entry id="meilul_2245">
    <lexical-unit><form lang="kqs"><text>meilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>meilu</text></form></variant>
    <sense id="meilul_2245_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se taire (pour écouter), faire silence ; laisser (impuni)</text></gloss>
      <gloss lang="en"><text>be quiet (and listen), stop talking; let off, leave (unpunished)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stop, desist (usually from talking) for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.13.13; Childs 2000, p. 246: mɛ̀ìlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de meiyo « se taire ». Meilu vana nanu ! « Arrête ! » (1SA.15.16) ; meilul-la « taisez-vous » (JOB.13.13) ; mì meilul … « laisserais-je impunis … » (MIC.6.11).</text></form></note>
  </entry>
  <entry id="meiyo_2246">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="meiyo_2246_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>silence, calme (o meiyo nin)</text></gloss>
      <gloss lang="en"><text>silence, quiet (o meiyo nin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) keep quiet; set a time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Childs 2000, p. 243: mèìyɔ́</text></form></note>
  </entry>
  <entry id="meiyo_2247">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mei</text></form></variant>
    <variant><form lang="kqs"><text>meinin</text></form></variant>
    <sense id="meiyo_2247_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se taire</text></gloss>
      <gloss lang="en"><text>be silent</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>keep quiet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Keita 1979, p. 110: Maiyo; Childs 2000, p. 243: mèìyó</text></form></note>
    <note><form lang="fr"><text>Keita écrit maiyo ; la Bible écrit meiyo (ECC 3,7). Moyen meinun.</text></form></note>
  </entry>
  <entry id="méléká_2248">
    <lexical-unit><form lang="kqs"><text>méléká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="méléká_2248_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>de façon inconvenante, turbulente ; volage</text></gloss>
      <gloss lang="en"><text>in an unseemly or unruly way, frisky; promiscuous</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: méléká</text></form></note>
  </entry>
  <entry id="mello_2249">
    <lexical-unit><form lang="kqs"><text>mello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mel</text></form></variant>
    <variant><form lang="kqs"><text>melnin</text></form></variant>
    <sense id="mello_2249_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser (partir), permettre ; garder pour (Keita)</text></gloss>
      <gloss lang="en"><text>let go, allow; keep for (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first EXO.4.23; Keita 1979, p. 110: Mello</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mello signifie « laisser partir » (EXO 4,23) ; mel et melnin sont les formes négatives de mal « laisser » (GEN 28,15).</text></form></note>
  </entry>
  <entry id="mèlló_2250">
    <lexical-unit><form lang="kqs"><text>mèlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mèlló_2250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture mise de côté pour quelqu'un</text></gloss>
      <gloss lang="en"><text>food kept aside for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: mèlló</text></form></note>
    <note><form lang="fr"><text>Nom dérivé de màlɔ̀ɔ́ « laisser » ; cf. mello « laisser, garder pour » (Bible, Keita).</text></form></note>
  </entry>
  <entry id="méŋèlěŋ_2251">
    <lexical-unit><form lang="kqs"><text>méŋèlěŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="méŋèlěŋ_2251_s1">
