    <trait name="status" value="southern"/>
    <sense id="pókópókóó_4057_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'oiseau</text></gloss>
      <gloss lang="en"><text>a bird species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pókópókóó</text></form></note>
  </entry>
  <entry id="polale lemasalen_4058">
    <lexical-unit><form lang="kqs"><text>polale lemasalen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="polale lemasalen_4058_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lignée royale, dynastie</text></gloss>
      <gloss lang="en"><text>royal line, dynasty</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 267: Polale lemasalen</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 267) : « dynastie ».</text></form></note>
  </entry>
  <entry id="polalen_4059">
    <lexical-unit><form lang="kqs"><text>polalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>polale</text></form></variant>
    <variant><form lang="kqs"><text>polama</text></form></variant>
    <sense id="polalen_4059_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lignée, descendance, tribu ; généalogie ; ligne, rang</text></gloss>
      <gloss lang="en"><text>lineage, descendants, tribe; generations; line, row</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first EXO.40.23; Lexique kissi–français, p. 43: polalen; Terminologie (arts), n° 93: Polalen</text></form></note>
    <note><form lang="fr"><text>polale Noe len « la descendance de Noé » ; au pluriel, forme radicale polama (polama Israɛlla « les tribus d'Israël »). Académie des langues (terminologie, arts n° 93) : « (ligne) droite ». Aussi Terminologie, p. 256 : « Polalen ». Académie des langues (terminologie, histoire n° 374) : polale yungulen « généalogie ».</text></form></note>
  </entry>
  <entry id="polen_4060">
    <lexical-unit><form lang="kqs"><text>polen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pole</text></form></variant>
    <sense id="polen_4060_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant unique, fils unique (pole pilɛlen)</text></gloss>
      <gloss lang="en"><text>only child, only son (pole pilɛlen)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>only male child; young male child</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LUK.9.38; Childs 2000, p. 306: póléŋ</text></form></note>
    <note><form lang="fr"><text>a túŋ ya pole nɔmnde pilɛlen nden te « tu ne m'as pas refusé ton fils unique » (GEN.22.12) ; polen nden koni ya nɔ ni « c'est mon unique enfant » (LUK.9.38).</text></form></note>
  </entry>
  <entry id="polisioo_4061">
    <lexical-unit><form lang="kqs"><text>polisioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="polisioo_4061_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>police</text></gloss>
      <gloss lang="en"><text>police</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 481: Polisioo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français, proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pollo_4062">
    <lexical-unit><form lang="kqs"><text>pollo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pollo_4062_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rase campagne, pleine campagne ; brousse</text></gloss>
      <gloss lang="en"><text>open country, open field; bush</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>desert area</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.19.28; Paulme 1964, p. 83: pullo; Lexique kissi–français, p. 43: pollo; Childs 2000, p. 306: pólló</text></form></note>
    <note><form lang="fr"><text>a kɔ del lɛŋ o pollo nin « tu tomberas en pleine campagne » (EZK.29.5) ; o pollo coo (1CH.19.9) ; hu pollo, nom d'un oiseau (DEU.14.16). Paulme 1964, p. 83 : pullo « brousse » ; tyɛy pulla « champ » ; malo n pullo « riz de montagne ».</text></form></note>
  </entry>
  <entry id="pòlló_4063">
    <lexical-unit><form lang="kqs"><text>pòlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pòltáŋ</text></form></field>
    <sense id="pòlló_4063_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie douloureuse du sommet du crâne (peut rendre fou)</text></gloss>
      <gloss lang="en"><text>painful disease of the top of the head (can cause madness)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pòlló</text></form></note>
  </entry>
  <entry id="polo_4064">
    <lexical-unit><form lang="kqs"><text>polo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔlɔ</text></form></variant>
    <sense id="polo_4064_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont l'écorce sert aux objets magiques)</text></gloss>
      <gloss lang="en"><text>kind of tree (bark used for magic objects)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: polo, pɔlɔ, poro</text></form></note>
    <note><form lang="fr"><text>Paulme : cf. barakawo.</text></form></note>
  </entry>
  <entry id="pólòlí_4065">
    <lexical-unit><form lang="kqs"><text>pólòlí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pólòlí_4065_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>brusquement, d'un coup</text></gloss>
      <gloss lang="en"><text>abruptly, brusquely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pólòlí</text></form></note>
  </entry>
  <entry id="polon_4066">
    <lexical-unit><form lang="kqs"><text>polon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="polon_4066_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dehors, au loin</text></gloss>
      <gloss lang="en"><text>outside, away</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>far, high up, far away; deep</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 102 occurrences, first GEN.21.10; Childs 2000, p. 306: pólóŋ</text></form></note>
  </entry>
  <entry id="polopakanndo_4067">
    <lexical-unit><form lang="kqs"><text>polopakanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="polopakanndo_4067_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>propagande</text></gloss>
      <gloss lang="en"><text>propaganda</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 528: Polopakanndo</text></form></note>
    <note><form lang="fr"><text>Emprunt (propagande), proposé par l'Académie des langues (années 1970). La liste numérote 528 deux fois.</text></form></note>
  </entry>
  <entry id="pondaa_4068">
    <lexical-unit><form lang="kqs"><text>pondaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pondaa_4068_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fard noir</text></gloss>
      <gloss lang="en"><text>black make-up paint</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Pondaa; Lexique kissi–français, p. 43: pondaa; Terminologie (arts), n° 13: Pondaa</text></form></note>
    <note><form lang="fr"><text>Même racine probable que pondalen « marque, sceau » (Gn 4,15). Académie des langues (terminologie, arts n° 13) : « ardoisine » (couleur noire).</text></form></note>
  </entry>
  <entry id="póndáá_4069">
    <lexical-unit><form lang="kqs"><text>póndáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="póndáá_4069_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre dont le fruit sert à peindre le corps (initiation)</text></gloss>
      <gloss lang="en"><text>tree whose fruit is used for body painting (initiation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: póndáá</text></form></note>
  </entry>
  <entry id="pondaa sɛvaa_4070">
    <lexical-unit><form lang="kqs"><text>pondaa sɛvaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pondaa sɛvaa_4070_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>encre</text></gloss>
      <gloss lang="en"><text>ink</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Pondaa sèvaa; Lexique kissi–français, p. 43: pondaa sɛvaa</text></form></note>
    <note><form lang="fr"><text>sɛvaa « écrire » est attesté (Ex 28,36).</text></form></note>
  </entry>
  <entry id="pondalen_4071">
    <lexical-unit><form lang="kqs"><text>pondalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pondale</text></form></variant>
    <sense id="pondalen_4071_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marque, signe ; sceau</text></gloss>
      <gloss lang="en"><text>mark, sign; seal</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.4.15</text></form></note>
  </entry>
  <entry id="pondoo_4072">
    <lexical-unit><form lang="kqs"><text>pondoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pondoo_4072_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>janvier</text></gloss>
      <gloss lang="en"><text>January</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Pondoo; Lexique kissi–français, p. 43: pondoo; Terminologie (langue), n° 437: Pondoo ✎ 5</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 437) : « janvier », numéroté à la main 5 (l'année commence en septembre).</text></form></note>
  </entry>
  <entry id="pondoo vɔmndo_4073">
    <lexical-unit><form lang="kqs"><text>pondoo vɔmndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pondoo vɔmndo_4073_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre à feu et à sang</text></gloss>
      <gloss lang="en"><text>put to fire and sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 426: Pondoo vömndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pondɔɔ_4074">
    <lexical-unit><form lang="kqs"><text>pondɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pondu</text></form></variant>
    <sense id="pondɔɔ_4074_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>exploser, éclater ; crier</text></gloss>
      <gloss lang="en"><text>explode, burst; shout</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 43: pondɔɔ/ pondu</text></form></note>
    <note><form lang="fr"><text>À distinguer de pondɔɔ/ pandu « acheter » du même Lexique (Bible piondɔɔ).</text></form></note>
  </entry>
  <entry id="pongan_4075">
    <lexical-unit><form lang="kqs"><text>pongan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pongan_4075_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taches, mouchetures (du pelage)</text></gloss>
      <gloss lang="en"><text>spots, speckles (of an animal's coat)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.30.35</text></form></note>
    <note><form lang="fr"><text>cɔlu oo cɔlu nɔ pongan « toute bête qui avait des taches » (Gn 30,35).</text></form></note>
  </entry>
  <entry id="ponono_4076">
    <lexical-unit><form lang="kqs"><text>ponono</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ponono_4076_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent à plaisanterie (femme parlant d'un homme)</text></gloss>
      <gloss lang="en"><text>joking relative (woman speaking of a man)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: ponono</text></form></note>
    <note><form lang="fr"><text>Paulme : p. ex. la femme de l'oncle utérin parlant au neveu ; terme réciproque : vɛn nu.</text></form></note>
  </entry>
  <entry id="poo_4077">
    <lexical-unit><form lang="kqs"><text>poo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>poaa</text></form></field>
    <variant><form lang="kqs"><text>po</text></form></variant>
    <sense id="poo_4077_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fils, enfant (mâle) ; (pl.) fils, descendants</text></gloss>
      <gloss lang="en"><text>son, (male) child; (pl.) sons, descendants</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boy, youth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 87 occurrences, first GEN.4.26; Paulme 1964, p. 82: pono, pu, punu; Lexique kissi–français, p. 43: po; Childs 2000, p. 307: pòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale po : po ndɔɔ « son fils », po vanalanɔɔ « le fils de la femme » (Gn 3,15) ; poaa Israɛl « les Israélites ». Vocatif ponndo « mon fils ! » (Gn 43,29) ; pole pilɛlen « fils unique » (Gn 22,12 ; Childs póléŋ « only male child »). Lexique kissi–français, p. 43 : po « garçon ». Paulme 1964, p. 82 : « fils, fils du frère » ; punu ni « c'est mon fils » ; pu Fara ni « c'est le fils de Fara ».</text></form></note>
  </entry>
  <entry id="pòó_4078">
    <lexical-unit><form lang="kqs"><text>pòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pòláŋ</text></form></field>
    <sense id="pòó_4078_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entaille profonde dans un arbre</text></gloss>
      <gloss lang="en"><text>gash or deep cut in a tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 307: pòó</text></form></note>
  </entry>
  <entry id="poolan_4079">
    <lexical-unit><form lang="kqs"><text>poolan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>poola</text></form></variant>
    <variant><form lang="kqs"><text>posian</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="poolan_4079_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>excréments, fiente, bouse</text></gloss>
      <gloss lang="en"><text>dung, excrement</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MAL.2.3; Paulme 1964, p. 81 (G/K): pɔla, pɔlã, /K./; Childs 2000, p. 307: pòòléŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 81 : pɔla, pɔlã /K./, posyã /G./ « excréments ». Paulme : pɔla, pɔlã /K./, posyã /G./ (p. 81).</text></form></note>
  </entry>
  <entry id="póólóó_4080">
    <lexical-unit><form lang="kqs"><text>póólóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>póólúá</text></form></field>
    <sense id="póólóó_4080_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit insecte (moucheron) dont la piqûre démange</text></gloss>
      <gloss lang="en"><text>small gnat-like insect with itchy bite</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 307: póólóó</text></form></note>
  </entry>
  <entry id="poombɔɔ_4081">
    <lexical-unit><form lang="kqs"><text>poombɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>poambɔa</text></form></field>
    <variant><form lang="kqs"><text>poombɔ</text></form></variant>
    <sense id="poombɔɔ_4081_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>garçon, jeune homme</text></gloss>
      <gloss lang="en"><text>boy, young man</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boy, small boy; son, male child</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 87 occurrences, first GEN.21.12; Childs 2000, p. 307: pòómbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="poondaa_4082">
    <lexical-unit><form lang="kqs"><text>poondaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>poonda</text></form></variant>
    <variant><form lang="kqs"><text>poondan</text></form></variant>
    <variant><form lang="kqs"><text>poondanin</text></form></variant>
    <sense id="poondaa_4082_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever, arracher, prendre de force ; (poondan) s'échapper</text></gloss>
      <gloss lang="en"><text>take away, snatch, seize by force; (poondan) escape</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away, pull off; also shuck; (middle) slip out</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.11.23; Lexique kissi–français, p. 43: poondaa/ poonda; Childs 2000, p. 307: pòòndàá</text></form></note>
    <note><form lang="fr"><text>Verbe de base de poondiaa. I poondanin Salomɔn masalen … o ba « j'arracherai le royaume des mains de Salomon » (1 R 11,34) ; Yalaa timbinndo, mí n poondan « le filet s'est rompu et nous nous sommes échappés » (Ps 124,7).</text></form></note>
  </entry>
  <entry id="poondiaa_4083">
    <lexical-unit><form lang="kqs"><text>poondiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="poondiaa_4083_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>emmener (comme butin, en captivité), enlever, confisquer</text></gloss>
      <gloss lang="en"><text>carry off (as plunder, captive), take away, confiscate</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away (plural action); shuck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first NUM.14.3; Childs 2000, p. 307: pòòndìá</text></form></note>
  </entry>
  <entry id="poonpoon_4084">
    <lexical-unit><form lang="kqs"><text>poonpoon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="poonpoon_4084_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colombe</text></gloss>
      <gloss lang="en"><text>dove</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.8.9</text></form></note>
  </entry>
  <entry id="poonpoondo_4085">
    <lexical-unit><form lang="kqs"><text>poonpoondo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>poonpoonda</text></form></field>
    <sense id="poonpoondo_4085_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pigeon vert ; colombe</text></gloss>
      <gloss lang="en"><text>green pigeon; dove</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.8.8; Keita 1979, p. 137: Poonpoonndo; Lexique kissi–français, p. 43: poonpoonndo</text></form></note>
    <note><form lang="fr"><text>Keita : pigeon vert ; la Bible l'emploie pour la colombe.</text></form></note>
  </entry>
  <entry id="poopoo_4086">
    <lexical-unit><form lang="kqs"><text>poopoo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="poopoo_4086_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insolence, outrage ; (vana poopoo) vaurien, effronté</text></gloss>
      <gloss lang="en"><text>insolence, disgrace; (vana poopoo) scoundrel, brazen person</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note><form lang="fr"><text>sui … poopoo « outrager, déshonorer, importuner » (Dt 22,19 ; Rt 2,9) ; vanalanɔ poopoo « femme effrontée » (Pr 7,11). Sens à confirmer.</text></form></note>
  </entry>
  <entry id="pooɲiaa_4087">
    <lexical-unit><form lang="kqs"><text>pooɲiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pooɲia</text></form></variant>
    <variant><form lang="kqs"><text>poɲa</text></form></variant>
    <sense id="pooɲiaa_4087_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tacher, couvrir de taches ; (poɲa) être taché</text></gloss>
      <gloss lang="en"><text>spot, cover with spots; (poɲa) be stained</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be spotted all over; write (plural of 'be spotted')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.13.57; Lexique kissi–français, p. 43: poɲa; Childs 2000, p. 307: pòòɲìá</text></form></note>
    <note><form lang="fr"><text>mɛɛ nàà siaŋaa pooɲiaa volɔɔ « si la lèpre tache le vêtement » (LEV.13.57) ; tambillo nɔla pá pooɲia yáw ndɔɔ mangala « le léopard peut-il changer ses taches » (JER.13.23) ; volɔɔla nila la poɲa « mes vêtements sont tachés » (ISA.63.3). Voir pooɲɛi « tacheté ». Lexique kissi–français, p. 43 : poɲa « rayé ».</text></form></note>
  </entry>
  <entry id="pooɲɛi_4088">
    <lexical-unit><form lang="kqs"><text>pooɲɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pooɲɛiya</text></form></variant>
    <variant><form lang="kqs"><text>pooɲɛila</text></form></variant>
    <variant><form lang="kqs"><text>pooɲɛilen</text></form></variant>
    <sense id="pooɲɛi_4088_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tacheté, moucheté</text></gloss>
      <gloss lang="en"><text>speckled, spotted</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spotted, colourful, multicoloured</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.30.33; Paulme 1964, p. 84: punyɛye; Childs 2000, p. 307: pòɲéí-</text></form></note>
    <note><form lang="fr"><text>cɔlua pooɲɛiya « les bêtes tachetées » (Gn 30,32). Paulme 1964, p. 84 : tambilo ɔ tyɔ punyɛy « la panthère est rayée (tachetée) ».</text></form></note>
  </entry>
  <entry id="pótè_4089">
    <lexical-unit><form lang="kqs"><text>pótè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pótè_4089_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>arraché d'un coup, complètement (plante, œil)</text></gloss>
      <gloss lang="en"><text>pulled out abruptly, completely (plant, eye)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pótè</text></form></note>
  </entry>
  <entry id="pòtómánɔ̀ɔ́_4090">
    <lexical-unit><form lang="kqs"><text>pòtómánɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pòtómánɔ̀ɔ́_4090_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>garçon initié (à l'école de brousse)</text></gloss>
      <gloss lang="en"><text>initiate boy (in bush school)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pòtómánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pow le sumndo_4091">
    <lexical-unit><form lang="kqs"><text>pow le sumndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pow le sumndo_4091_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclume</text></gloss>
      <gloss lang="en"><text>anvil</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pow le sumndo</text></form></note>
    <note><form lang="fr"><text>De pow « pierre » ; expression non attestée dans la Bible.</text></form></note>
  </entry>
  <entry id="pow lesumndo_4092">
    <lexical-unit><form lang="kqs"><text>pow lesumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pow lesumndo_4092_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclume</text></gloss>
      <gloss lang="en"><text>anvil</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 100: Pow lesumndo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, o pow lesumndo coo « sur l'enclume » (ISA.41.7) ; pow « fer ».</text></form></note>
  </entry>
  <entry id="powvo_4093">
    <lexical-unit><form lang="kqs"><text>powvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>powtan</text></form></field>
    <variant><form lang="kqs"><text>puo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="powvo_4093_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pierre, caillou</text></gloss>
      <gloss lang="en"><text>stone, pebble</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rock, large stone; battery</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.28.11; Keita 1979, p. 155: Powvo; Paulme 1964, p. 83 (G/K): povo, pl. potã /G./; Lexique kissi–français, p. 44: powvo; Childs 2000, p. 308: pòùwó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 43-44 : aussi poo « la pierre » ; powvo y est aussi glosé « pile ». Paulme 1964, p. 83 : povo, pl. potã /G./ ; puo /K./, pl. potã « pierre ». Paulme : povo, pl. potã /G./ ; puo /K./ (p. 83).</text></form></note>
  </entry>
  <entry id="poŋ_4094">
    <lexical-unit><form lang="kqs"><text>poŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="poŋ_4094_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>dur, ferme, solide</text></gloss>
      <gloss lang="en"><text>hard, firm, solid</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.24.21</text></form></note>
    <note><form lang="fr"><text>mɛmma … ma kendu poŋ « les eaux gèlent » (Jb 37,10) ; calta niaalan la co lakala poŋ « ta demeure est solide » (Nb 24,21).</text></form></note>
  </entry>
  <entry id="pôŋ_4095">
    <lexical-unit><form lang="kqs"><text>pôŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pôŋ_4095_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en éclats (ce qui se brise, gicle)</text></gloss>
      <gloss lang="en"><text>shattering, splattering</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pôŋ</text></form></note>
  </entry>
  <entry id="pôŋndí_4096">
    <lexical-unit><form lang="kqs"><text>pôŋndí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pôŋndí_4096_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>d'un geste vif (saisir, arracher)</text></gloss>
      <gloss lang="en"><text>with a grab (snatching away)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 306: pôŋndí</text></form></note>
  </entry>
  <entry id="poŋɔɔ_4097">
    <lexical-unit><form lang="kqs"><text>poŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>paŋ</text></form></variant>
    <sense id="poŋɔɔ_4097_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>germer, pousser</text></gloss>
      <gloss lang="en"><text>germinate, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 43: poŋɔɔ/ paŋ</text></form></note>
    <note><form lang="fr"><text>paŋ est dans la Bible au sens de « fade » (LUK.14.34).</text></form></note>
  </entry>
  <entry id="pû-pù_4098">
    <lexical-unit><form lang="kqs"><text>pû-pù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pû-pù_4098_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de moteur</text></gloss>
      <gloss lang="en"><text>sound of an engine</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pû-pù</text></form></note>
  </entry>
  <entry id="pua_4099">
    <lexical-unit><form lang="kqs"><text>pua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pua_4099_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>père (terme d'adresse : « Père ! »), mon père</text></gloss>
      <gloss lang="en"><text>father (term of address: 'Father!'), my father</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 132 occurrences, first GEN.22.7; Paulme 1964, p. 83: pua /vocatif/; Lexique kissi–français, p. 44: pua</text></form></note>
    <note><form lang="fr"><text>Comme nde « mère ». Paulme 1964, p. 83 : « père (au sens large) » ; pua bɛndu « frère aîné du père » ; pua pɔmbo « frère cadet du père » ; pua veria « le père qui m'a engendré ».</text></form></note>
  </entry>
  <entry id="puapilɛ_4100">
    <lexical-unit><form lang="kqs"><text>puapilɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>puapilɛa</text></form></field>
    <sense id="puapilɛ_4100_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prochain, compagnon ; frère (de la même communauté)</text></gloss>
      <gloss lang="en"><text>neighbour, fellow; brother (fellow member)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.4 Neighbor"/>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 209 occurrences, first GEN.9.5</text></form></note>
  </entry>
  <entry id="púéè-púéè_4101">
    <lexical-unit><form lang="kqs"><text>púéè-púéè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púéè-púéè_4101_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup, abondamment</text></gloss>
      <gloss lang="en"><text>a lot, plenty</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: púéè-púéè</text></form></note>
  </entry>
  <entry id="púéíyé_4102">
    <lexical-unit><form lang="kqs"><text>púéíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="púéíyé_4102_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pipe</text></gloss>
      <gloss lang="en"><text>pipe (for smoking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: púéíyé</text></form></note>
  </entry>
  <entry id="puilen_4103">
    <lexical-unit><form lang="kqs"><text>puilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puile</text></form></variant>
    <sense id="puilen_4103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>queue</text></gloss>
      <gloss lang="en"><text>tail</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a brush of tied grass used by a praise singer, often replaced by a cow's tail</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.4.4; Childs 2000, p. 311: pùìléŋ</text></form></note>
    <note><form lang="fr"><text>puile ndɔlen « sa queue (grasse) » (Lv 3,9).</text></form></note>
  </entry>
  <entry id="puiyaa_4104">
    <lexical-unit><form lang="kqs"><text>puiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pui</text></form></variant>
    <variant><form lang="kqs"><text>puinin</text></form></variant>
    <sense id="puiyaa_4104_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, verdir, repousser ; verdure</text></gloss>
      <gloss lang="en"><text>sprout, grow green, shoot again; greenery</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sprout new growth, grow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.13.10; Lexique kissi–français, p. 44: puiyo/ pui; Childs 2000, p. 311: pùìyó</text></form></note>
    <note><form lang="fr"><text>o muungu vɛlɛ o pui « il repousse » (Jb 14,7) ; dɛɛla … va o puiyaa ɲɛkɛndɛi « la plaine était bien arrosée, verdoyante » (Gn 13,10). Lexique kissi–français, p. 44 écrit puiyo/ pui « la reprise des branches, pousser, donner des branches ».</text></form></note>
  </entry>
  <entry id="puiyo_4105">
    <lexical-unit><form lang="kqs"><text>puiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="puiyo_4105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paille ; herbes pour le toit</text></gloss>
      <gloss lang="en"><text>straw; thatching grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>new sprouts; thatch, grass cut for thatching</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.19.19; Keita 1979, p. 140: Puiyo; Lexique kissi–français, p. 44: puiyo; Childs 2000, p. 311: pùìyó</text></form></note>
  </entry>
  <entry id="pùkéé_4106">
    <lexical-unit><form lang="kqs"><text>pùkéé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùkéé_4106_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du riz qui tombe dans le van</text></gloss>
      <gloss lang="en"><text>whooshing sound of rice falling into a fanner</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùkéé</text></form></note>
  </entry>
  <entry id="pùlàléŋ_4107">
    <lexical-unit><form lang="kqs"><text>pùlàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pùlàléŋ_4107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>file, colonne (de gens, de fourmis) ; lignée</text></gloss>
      <gloss lang="en"><text>line, column (of people, ants); ancestral line</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùlàléŋ</text></form></note>
  </entry>
  <entry id="pule tando_4108">
    <lexical-unit><form lang="kqs"><text>pule tando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pule tando_4108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pierre de foudre (hache néolithique, sert à aiguiser les couteaux)</text></gloss>
      <gloss lang="en"><text>thunderstone (neolithic axe, used to sharpen knives)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 83: pule tando /de puo = pierre/</text></form></note>
  </entry>
  <entry id="pulen_4109">
    <lexical-unit><form lang="kqs"><text>pulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pule</text></form></variant>
    <sense id="pulen_4109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nombril ; cordon ombilical ; intestin</text></gloss>
      <gloss lang="en"><text>navel; umbilical cord; intestine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Pulen; Paulme 1964, p. 83: pule, pulle; Lexique kissi–français, p. 44: pulen; Childs 2000, p. 311: pùléŋ</text></form></note>
    <note><form lang="fr"><text>Forme radicale pule attestée (Ez 16,4 ; Ct 7,3). Paulme 1964, p. 83 : pule, pulle « intestin, nombril ». La Bible a pule « nombril » (SNG.7.3).</text></form></note>
  </entry>
  <entry id="pulikola_4110">
    <lexical-unit><form lang="kqs"><text>pulikola</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kula</text></form></variant>
    <sense id="pulikola_4110_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bande d'étoffe tissée</text></gloss>
      <gloss lang="en"><text>woven cloth strip</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 83: pulikola ou kura</text></form></note>
    <note><form lang="fr"><text>Paulme : pl. purun kurɛy.</text></form></note>
  </entry>
  <entry id="pullino_4111">
    <lexical-unit><form lang="kqs"><text>pullino</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>pullinda</text></form></field>
    <sense id="pullino_4111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>albinos ; revenant</text></gloss>
      <gloss lang="en"><text>albino; ghost</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 83: pullino, pl. pullinda</text></form></note>
  </entry>
  <entry id="pulon_4112">
    <lexical-unit><form lang="kqs"><text>pulon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pulon_4112_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entrailles, intestins</text></gloss>
      <gloss lang="en"><text>entrails, intestines</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stomach, intestines (plural pùlóŋ); also a woman's labour stage, a strip of cloth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first LEV.3.3; Lexique kissi–français, p. 45: puruon; Childs 2000, p. 311: pùléí</text></form></note>
    <note><form lang="fr"><text>cuɛima kumbu pulon « la graisse qui couvre les entrailles » (Lv 3,3). Voir pulen « nombril ». Lexique kissi–français, p. 45 écrit puruon « les intestins » et purie « la grossesse, l'intestin ».</text></form></note>
  </entry>
  <entry id="pùlóó_4113">
    <lexical-unit><form lang="kqs"><text>pùlóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùlúláŋ</text></form></field>
    <sense id="pùlóó_4113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grappe, gousse (noix de kola, noix de palme)</text></gloss>
      <gloss lang="en"><text>cluster, pod (kola nuts, palm nuts)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùlóó</text></form></note>
  </entry>
  <entry id="pulta_4114">
    <lexical-unit><form lang="kqs"><text>pulta</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pultan</text></form></field>
    <sense id="pulta_4114_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cendre</text></gloss>
      <gloss lang="en"><text>ash</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.9.8; Paulme 1964, p. 84: putã; Lexique kissi–français, p. 45: puten; Childs 2000, p. 312: pùltáŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 45 écrit puten « la cendre ». Paulme 1964, p. 84 : basu putã « balaie les cendres ».</text></form></note>
  </entry>
  <entry id="púlú_4115">
    <lexical-unit><form lang="kqs"><text>púlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púlú_4115_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, soudain</text></gloss>
      <gloss lang="en"><text>quickly, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púlú</text></form></note>
  </entry>
  <entry id="puluei_4116">
    <lexical-unit><form lang="kqs"><text>puluei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>puruei</text></form></variant>
    <sense id="puluei_4116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue des Blancs (français, anglais…)</text></gloss>
      <gloss lang="en"><text>language of white people (French, English…)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: puruei</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit puruei. La Bible a puluei dans un autre sens (kpɛɛnɛi puluei « vase de terre », JER.19.1).</text></form></note>
  </entry>
  <entry id="pululan_4117">
    <lexical-unit><form lang="kqs"><text>pululan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>purulan</text></form></variant>
    <sense id="pululan_4117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corde (de palmier)</text></gloss>
      <gloss lang="en"><text>rope (of palm fibre)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: purulan</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit purulan.</text></form></note>
  </entry>
  <entry id="pululen_4118">
    <lexical-unit><form lang="kqs"><text>pululen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulule</text></form></variant>
    <variant><form lang="kqs"><text>purulen</text></form></variant>
    <sense id="pululen_4118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gloutonnerie, gourmandise, excès de table ; gourmand, vorace</text></gloss>
      <gloss lang="en"><text>gluttony, greed (for food), carousing; greedy, glutton</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PRO.21.17; Paulme 1964, p. 84: purule, puruo; Lexique kissi–français, p. 45: purulen; Childs 2000, p. 312: pùlúléŋ</text></form></note>
    <note><form lang="fr"><text>De pulei « ventre ». mɔiyan yɔngɔnndo, pululen « l'ivrognerie, les excès de table » (GAL.5.21) ; mɔiyan a pululen (PRO.21.17, LUK.21.34) ; a pulule ndɔlen « à sa voracité » (JOB.20.21). Paulme 1964, p. 84 : a nɔ purule n tau « tu es un vorace, jamais rassasié ».</text></form></note>
  </entry>
  <entry id="púlùtù_4119">
    <lexical-unit><form lang="kqs"><text>púlùtù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púlùtù_4119_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'herbe arrachée, de tissu déchiré, de petite moto</text></gloss>
      <gloss lang="en"><text>sound of grass uprooted, cloth tearing, a small motorbike</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púlùtù</text></form></note>
  </entry>
  <entry id="pulɔn sɛllo_4120">
    <lexical-unit><form lang="kqs"><text>pulɔn sɛllo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pulɔn sɛllo_4120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ablution</text></gloss>
      <gloss lang="en"><text>ritual ablution</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Pulön sèllo; Lexique kissi–français, p. 44: pulɔn sɛllo</text></form></note>
  </entry>
  <entry id="pulɔnndo_4121">
    <lexical-unit><form lang="kqs"><text>pulɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulun</text></form></variant>
    <variant><form lang="kqs"><text>pulɔn</text></form></variant>
    <variant><form lang="kqs"><text>puru</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>pilu</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="pulɔnndo_4121_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se laver</text></gloss>
      <gloss lang="en"><text>wash oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.2.5; Keita 1979, p. 115: Pulönndo; Paulme 1964, p. 84 (G/K): purondo; Lexique kissi–français, p. 44: pulɔnndo/ pulɔn, pulun</text></form></note>
    <note><form lang="fr"><text>Moyen de pulɔɔ. Lexique kissi–français, p. 45 : aussi purɔnndo/ purun « se laver ». Paulme 1964, p. 84 : i puro, i puru /K./, i pilu /G./ « je me lave » ; i kwa purando ɔ pɛo « je vais me laver au marigot ». Paulme : i puro, i puru /K./ ; i pilu /G./ « je me lave » (p. 84).</text></form></note>
  </entry>
  <entry id="pulɔɔ_4122">
    <lexical-unit><form lang="kqs"><text>pulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulu</text></form></variant>
    <variant><form lang="kqs"><text>pilu</text></form></variant>
    <sense id="pulɔɔ_4122_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver (personnes, corps)</text></gloss>
      <gloss lang="en"><text>wash (people, body)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wash, bathe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.18.4; Keita 1979, p. 115: Pulöö; Lexique kissi–français, p. 44: pulɔɔ/ pulu, pilu; Childs 2000, p. 312: pùlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>pilu : radical négatif (MRK 7,2). Lexique kissi–français, p. 45 : aussi purɔɔ/ puru « laver qq'un ».</text></form></note>
  </entry>
  <entry id="pum_4123">
    <lexical-unit><form lang="kqs"><text>pum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pum_4123_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>un certain, un</text></gloss>
      <gloss lang="en"><text>a certain, some</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'a few, part, a little'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1454 occurrences, first GEN.2.10; Paulme 1964, p. 83: pum; Lexique kissi–français, p. 44: pum; Childs 2000, p. 312: pùm</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 83 : pum « chaque, chacun, tous » (tuambua pum « tous les enfants ») ; lɔ pum « une autre fois, plus tard » ; tuma pum « tout à l'heure ».</text></form></note>
  </entry>
  <entry id="pumboo_4124">
    <lexical-unit><form lang="kqs"><text>pumboo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pumboo_4124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nid, essaim (d'abeilles)</text></gloss>
      <gloss lang="en"><text>nest, swarm (of bees)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nest of wasps or of a kind of ant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JDG.14.8; Lexique kissi–français, p. 44: punbuo; Terminologie (idéologie), n° 610: Pumboo, söön hèènduan; Childs 2000, p. 312: pùmbòó</text></form></note>
    <note><form lang="fr"><text>mó komal lɛa pumboo o visi kalaa nin « il trouva un essaim d'abeilles dans le cadavre (du lion) » (JDG.14.8). Lexique kissi–français, p. 44 : punbuo « le nid des fourmis, des guêpes ». Académie des langues (terminologie, idéologie n° 610, 401) : « système » (aussi sɔɔn hɛɛnduan) ; « ligue » (avec dumboo).</text></form></note>
  </entry>
  <entry id="pumbu_4125">
    <lexical-unit><form lang="kqs"><text>pumbu</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pumbu_4125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu fixe, établissement (icali o pumbu « demeurer à un endroit fixe »)</text></gloss>
      <gloss lang="en"><text>settled place (icali o pumbu 'live in a fixed place')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note><form lang="fr"><text>A ve lɛnin icali o pumbú le « tu ne demeureras nulle part (tu seras errant) » (Gn 4,12) ; vanaa cel o pumbu le « les nomades » (Jg 8,11). Aussi écrit pumbú. Sens à confirmer.</text></form></note>
  </entry>
  <entry id="pumbu le yulaa_4126">
    <lexical-unit><form lang="kqs"><text>pumbu le yulaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pumbu le yulaa_4126_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>compagnie commerciale</text></gloss>
      <gloss lang="en"><text>trading company</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.9 Business organization"/>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 179: Pumbu le yulaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pumndo_4127">
    <lexical-unit><form lang="kqs"><text>pumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pum</text></form></variant>
    <sense id="pumndo_4127_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être rassasié ; satiété</text></gloss>
      <gloss lang="en"><text>be full, satisfied; fullness</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be full</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.16.21; Paulme 1964, p. 83: pumdo; Lexique kissi–français, p. 44: pumndo/ pum; Childs 2000, p. 312: pùmndó</text></form></note>
    <note><form lang="fr"><text>la vanin dioo mì la va pumndo « tu mangeras et tu seras rassasié » (DEU.8.10) ; mɛɛ ndóò nɔla pumndo yɛ « selon ce qu'il pouvait manger » (EXO.16.21). Voir pim « être rassasié ». Paulme 1964, p. 83 : pumdo « satiété », cf. pim.</text></form></note>
  </entry>
  <entry id="pumpunndo_4128">
    <lexical-unit><form lang="kqs"><text>pumpunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pumpunndo_4128_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand oiseau (espèce)</text></gloss>
      <gloss lang="en"><text>large bird (species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: punpunndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit punpunndo.</text></form></note>
  </entry>
  <entry id="pundaa_4129">
    <lexical-unit><form lang="kqs"><text>pundaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="pundaa_4129_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cécité, vue voilée ; cataracte</text></gloss>
      <gloss lang="en"><text>blindness, dimness of sight; cataract</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>white filmy growth that causes cataracts and blindness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.27.1; Lexique kissi–français, p. 44: pundaa; Childs 2000, p. 312: púndáá</text></form></note>
    <note><form lang="fr"><text>pundaa cal ndu o lahɔl « ses yeux s'étaient affaiblis » (Gn 27,1).</text></form></note>
  </entry>
  <entry id="pundo_4130">
    <lexical-unit><form lang="kqs"><text>pundo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pundo_4130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>onzième mois</text></gloss>
      <gloss lang="en"><text>eleventh month</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 83: pundo</text></form></note>
  </entry>
  <entry id="pùndóó_4131">
    <lexical-unit><form lang="kqs"><text>pùndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùndóó_4131_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat des marais très poilu</text></gloss>
      <gloss lang="en"><text>hairy swamp rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: pùndóó</text></form></note>
  </entry>
  <entry id="púndúkúlúŋ_4132">
    <lexical-unit><form lang="kqs"><text>púndúkúlúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púndúkúlúŋ_4132_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de très bonne heure (le matin)</text></gloss>
      <gloss lang="en"><text>very early in the morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púndúkúlúŋ</text></form></note>
  </entry>
  <entry id="pundule_4133">
    <lexical-unit><form lang="kqs"><text>pundule</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>punduo</text></form></field>
    <sense id="pundule_4133_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe des jumeaux (fébrifuge)</text></gloss>
      <gloss lang="en"><text>twins' herb (febrifuge)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 83: pundule, pl. punduo</text></form></note>
    <note><form lang="fr"><text>Paulme : ses feuilles soignent les malades et la fièvre ; antidote du sambiyo ; p. 84 : pundule jundo, liane (ou racines) du kundo.</text></form></note>
  </entry>
  <entry id="púndùŋ_4134">
    <lexical-unit><form lang="kqs"><text>púndùŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púndùŋ_4134_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>plouf (nage, chute dans l'eau)</text></gloss>
      <gloss lang="en"><text>splash (swimming, falling into water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púndùŋ</text></form></note>
  </entry>
  <entry id="pundɔɔ_4135">
    <lexical-unit><form lang="kqs"><text>pundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pundɔɔ_4135_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pétrir, humecter (la farine avec l'huile) ; faire tremper</text></gloss>
      <gloss lang="en"><text>knead, moisten (flour with oil); soak</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze, mash</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.46.14; Lexique kissi–français, p. 44: pundɔɔ/ pundu; Childs 2000, p. 312: pùndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cuɛiyan … le kpeyanndo pundɔɔ « de l'huile pour humecter la farine » (EZK.46.14). Le Lexique kissi–français donne aussi : pundu.</text></form></note>
  </entry>
  <entry id="pungaa_4136">
    <lexical-unit><form lang="kqs"><text>pungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>punga</text></form></variant>
    <variant><form lang="kqs"><text>pungapungaa</text></form></variant>
    <sense id="pungaa_4136_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piller, ravir ; pillage, butin ; saisir (avec violence ou rapidement)</text></gloss>
      <gloss lang="en"><text>plunder, loot; plunder, spoil; seize (violently or quickly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fight or squabble over something (e.g. food); also blossom</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1SA.14.48; Lexique kissi–français, p. 45: punga; Childs 2000, p. 313: pùŋàá</text></form></note>
    <note><form lang="fr"><text>vannda punga ɲɛm naan « on a pillé nos biens » (Esd 9,7) ; siŋnun pungapungaa « devenir une proie » (Ez 26,5 ; 34,22).</text></form></note>
  </entry>
  <entry id="puo bɔlɔ_4137">
    <lexical-unit><form lang="kqs"><text>puo bɔlɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="puo bɔlɔ_4137_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>autel du culte des serpents</text></gloss>
      <gloss lang="en"><text>altar of the snake cult</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84: puo bɔrɔ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 84 : puo « pierre » ; aussi puo pɛndua « autel des jumeaux ».</text></form></note>
  </entry>
  <entry id="puo kunduo_4138">
    <lexical-unit><form lang="kqs"><text>puo kunduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="puo kunduo_4138_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>scories (pour les amulettes)</text></gloss>
      <gloss lang="en"><text>slag (used in charms)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84: puo kunduo</text></form></note>
    <note><form lang="fr"><text>Paulme : pl. pua kundurã.</text></form></note>
  </entry>
  <entry id="pùóó_4139">
    <lexical-unit><form lang="kqs"><text>pùóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùóó_4139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entaille faite pour abattre un arbre</text></gloss>
      <gloss lang="en"><text>notch made when felling a tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùóó</text></form></note>
  </entry>
  <entry id="pupabɛndo_4140">
    <lexical-unit><form lang="kqs"><text>pupabɛndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pupabɛndo_4140_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand-père</text></gloss>
      <gloss lang="en"><text>grandfather</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84 (G): pupabɛndo /G./</text></form></note>
    <note><form lang="fr"><text>Cf. pua « père », bɛndo « grand ».</text></form></note>
  </entry>
  <entry id="pupayɛi_4141">
    <lexical-unit><form lang="kqs"><text>pupayɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pupayɛi_4141_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>patriarcat</text></gloss>
      <gloss lang="en"><text>patriarchy</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 460: Pupayèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="pupulaa_4142">
    <lexical-unit><form lang="kqs"><text>pupulaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pupulaa_4142_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gris</text></gloss>
      <gloss lang="en"><text>grey</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 137: Pupulaa, pulpul</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi pulpul ; cf. kaa pupulaa « bleu clair ». La Bible a pupulaa pour un oiseau (LEV.11.18) ; à vérifier.</text></form></note>
  </entry>
  <entry id="pùsàá_4143">
    <lexical-unit><form lang="kqs"><text>pùsàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùsàá_4143_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>produire de nouveaux fruits (ananas, bananier)</text></gloss>
      <gloss lang="en"><text>produce new fruit (pineapple, banana)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùsàá</text></form></note>
  </entry>
  <entry id="pusianndo_4144">
    <lexical-unit><form lang="kqs"><text>pusianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pusian</text></form></variant>
    <sense id="pusianndo_4144_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se remuer ; troubler</text></gloss>
      <gloss lang="en"><text>stir; disturb</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: pusianndo/ pusian</text></form></note>
  </entry>
  <entry id="pùsìèí_4145">
    <lexical-unit><form lang="kqs"><text>pùsìèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùsɔ́ŋ</text></form></field>
    <sense id="pùsìèí_4145_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fesses, anus (vulgaire)</text></gloss>
      <gloss lang="en"><text>buttocks, anus (vulgar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùsìèí</text></form></note>
  </entry>
  <entry id="pute_4146">
    <lexical-unit><form lang="kqs"><text>pute</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pote</text></form></variant>
    <sense id="pute_4146_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit piment</text></gloss>
      <gloss lang="en"><text>small chili pepper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84: pute, kisɛy pute, pote</text></form></note>
    <note><form lang="fr"><text>Paulme : aussi kisɛy pute (cf. kisɛi « piment »).</text></form></note>
  </entry>
  <entry id="puuloo_4147">
    <lexical-unit><form lang="kqs"><text>puuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puulu</text></form></variant>
    <sense id="puuloo_4147_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terre, sol ; poussière ; boue, argile</text></gloss>
      <gloss lang="en"><text>earth, soil, ground; dust ; dust; mud, clay</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mud, dirt, stoneless soil; mortar</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first GEN.2.7; Keita 1979, p. 155: Puuluo; Paulme 1964, p. 83 (G): pulo, pl. puli; Lexique kissi–français, p. 45: puuloo; Childs 2000, p. 313: pùùlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Puuluo ; la Bible puuloo. Lexique kissi–français, p. 45 : aussi puuluo « la terre » et puruo « la saleté ; terre ». Paulme 1964, p. 83 : pulo, pl. puli « argile, terre », puro /G./ ; bɛne purye « pot en terre » ; pulo saŋa « terre rouge » ; pulo tiŋe « terre noire ». P. 84 : puruo « terre, poussière » ; puro ndo pisio ɔ sɔndo « enlever la terre de la bouche », nom du premier sacrifice offert au mort, le lendemain ou le surlendemain de l'enterrement.</text></form></note>
  </entry>
  <entry id="pùùlù-_4148">
    <lexical-unit><form lang="kqs"><text>pùùlù-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùùlù-_4148_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>étranger, européen, occidental, moderne ; officiel</text></gloss>
      <gloss lang="en"><text>foreign, European, Western, modern; governmental</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùùlù-</text></form></note>
  </entry>
  <entry id="pùùlùéí_4149">
    <lexical-unit><form lang="kqs"><text>pùùlùéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="pùùlùéí_4149_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue européenne (non locale)</text></gloss>
      <gloss lang="en"><text>European or non-local language</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùéí</text></form></note>
  </entry>
  <entry id="puululen_4150">
    <lexical-unit><form lang="kqs"><text>puululen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="puululen_4150_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>indigénat, joug colonial</text></gloss>
      <gloss lang="en"><text>native status (colonial), colonial yoke</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 412: Puululen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970) pour « indigénat » et « joug colonial » (histoire n° 414 ; idéologie n° 357). À distinguer de pululen « gloutonnerie ».</text></form></note>
  </entry>
  <entry id="pùùlùléŋ_4151">
    <lexical-unit><form lang="kqs"><text>pùùlùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pùùlùléŋ_4151_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mode de vie occidental, « civilisation »</text></gloss>
      <gloss lang="en"><text>Western way of life, 'civilization'</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùléŋ</text></form></note>
  </entry>
  <entry id="puulun_4152">
    <lexical-unit><form lang="kqs"><text>puulun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="puulun_4152_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire cas de, compter sur, s'attacher à ; tenir compte de (fautes)</text></gloss>
      <gloss lang="en"><text>set one's mind on, rely on; take note of, keep account of (sins)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pay attention to, mark, mind</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.24.14; Childs 2000, p. 313: pùùlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Taa puulun pɛ tɛɛmbuula naalan « si tu tenais compte de nos fautes » (PSA.130.3) ; má puulun naŋɔɔ nɔmndo « tu t'es fiée à ta beauté » (EZK.16.15) ; Puulùn ɲɛdiaa ndɔ kɛndɔɔ le « ne convoite pas ses mets délicats » (PRO.23.3). Sens à préciser.</text></form></note>
  </entry>
  <entry id="pùùlùnɔ̀ɔ́_4153">
    <lexical-unit><form lang="kqs"><text>pùùlùnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùùlùá</text></form></field>
    <sense id="pùùlùnɔ̀ɔ́_4153_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Européen, Blanc ; personne à la manière occidentale</text></gloss>
      <gloss lang="en"><text>European, white person; someone following Western ways</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="puundulen_4154">
    <lexical-unit><form lang="kqs"><text>puundulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>puundun</text></form></field>
    <variant><form lang="kqs"><text>puundule</text></form></variant>
    <sense id="puundulen_4154_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racine</text></gloss>
      <gloss lang="en"><text>root</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Puundulen; Lexique kissi–français, p. 45: puundulen; Childs 2000, p. 314: pùùndúléŋ</text></form></note>
    <note><form lang="fr"><text>La Bible a la forme radicale puundule (ISA.53.2) et le pluriel puundun (2KI.19.30). Lexique kissi–français, p. 45 : aussi pundulen « la vigne, la racine ».</text></form></note>
  </entry>
  <entry id="puusiaa_4155">
    <lexical-unit><form lang="kqs"><text>puusiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puusian</text></form></variant>
    <sense id="puusiaa_4155_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>disperser, déranger</text></gloss>
      <gloss lang="en"><text>scatter, disperse</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scatter, spread about</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.11.8; Keita 1979, p. 113: Puusiaa; Lexique kissi–français, p. 45: puusiaa/ puusia; Terminologie (histoire), n° 266: Piölöö, puusiaa; Childs 2000, p. 314: pùùsìá</text></form></note>
    <note><form lang="fr"><text>Moyen puusian « se disperser » (1SA 13,8). Académie des langues (terminologie, histoire n° 266) : « disloquer » (aussi piɔlɔɔ).</text></form></note>
  </entry>
  <entry id="puusianɔɔ_4156">
    <lexical-unit><form lang="kqs"><text>puusianɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="puusianɔɔ_4156_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>réactionnaire (Keita)</text></gloss>
      <gloss lang="en"><text>reactionary (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Puusianöö; Lexique kissi–français, p. 45: puusianɔɔ; Terminologie (idéologie), n° 544: Puusiaanöö</text></form></note>
    <note><form lang="fr"><text>La Bible a puusiaa « disperser » (Gn 11,8) ; le sens exact du dérivé est à confirmer. Confirmé au Nord par le Lexique kissi–français, p. 45 (« réactionnaire »).</text></form></note>
  </entry>
  <entry id="puusoo_4157">
    <lexical-unit><form lang="kqs"><text>puusoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="puusoo_4157_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière</text></gloss>
      <gloss lang="en"><text>termite hill</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84: puso, pusuo, pl. pusura; Lexique kissi–français, p. 45: puusoo; Childs 2000, p. 314: pùùsóó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 45 (puusoo « termitière » ; aussi pusuo « le tertre des fourmis, la termitière »). Pluriel en kissi du Sud (Childs 2000) : pùùsúláŋ. Paulme 1964, p. 84 : puso, pusuo, pl. pusura « termitière ».</text></form></note>
  </entry>
  <entry id="puuvo_4158">
    <lexical-unit><form lang="kqs"><text>puuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puu</text></form></variant>
    <variant><form lang="kqs"><text>puunin</text></form></variant>
    <variant><form lang="kqs"><text>puunun</text></form></variant>
    <variant><form lang="kqs"><text>puununnin</text></form></variant>
    <sense id="puuvo_4158_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre, enlever, arracher ; reprendre, récupérer</text></gloss>
      <gloss lang="en"><text>take, take away, snatch; take back, recover</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away, seize, snatch; also become engaged to, hire</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.10.2; Childs 2000, p. 315: pùùwó</text></form></note>
    <note><form lang="fr"><text>Mó puu vɛlɛ Lɔt « il reprit aussi Lot » (Gn 14,16) ; buɛyaa Abimelɛk-a ndáà puu a paa-kala « dont les serviteurs d'Abimélek s'étaient emparés » (Gn 21,25) ; puunun « s'emparer, être enlevé ».</text></form></note>
  </entry>
  <entry id="pùùwó_4159">
    <lexical-unit><form lang="kqs"><text>pùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùùwó_4159_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entraide (échange de travail)</text></gloss>
      <gloss lang="en"><text>assistance in a work-exchange agreement</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2 Social activity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùwó</text></form></note>
  </entry>
  <entry id="púúwɔ́ɔ́_4160">
    <lexical-unit><form lang="kqs"><text>púúwɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="púúwɔ́ɔ́_4160_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animal qui ressemble à une chèvre (antilope ?)</text></gloss>
      <gloss lang="en"><text>goat-like animal</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: púúwɔ́ɔ́</text></form></note>
  </entry>
  <entry id="púvɔ́ɔ́_4161">
    <lexical-unit><form lang="kqs"><text>púvɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>púwvɛa</text></form></field>
    <variant><form lang="kqs"><text>púvɛ</text></form></variant>
    <sense id="púvɔ́ɔ́_4161_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gazelle, chevreuil</text></gloss>
      <gloss lang="en"><text>gazelle, deer</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.12.15</text></form></note>
    <note><form lang="fr"><text>maa púvɛ « comme une gazelle » (2 S 2,18 ; Ct 2,17).</text></form></note>
  </entry>
  <entry id="puya-puya_4162">
    <lexical-unit><form lang="kqs"><text>puya-puya</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="puya-puya_4162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bruine, petite pluie</text></gloss>
      <gloss lang="en"><text>drizzle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: puya-puya</text></form></note>
  </entry>
  <entry id="púŋ_4163">
    <lexical-unit><form lang="kqs"><text>púŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="púŋ_4163_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idiiyo púŋ) de grand matin</text></gloss>
      <gloss lang="en"><text>(idiiyo púŋ) very early in the morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.19.27</text></form></note>
  </entry>
  <entry id="púŋ_4164">
    <lexical-unit><form lang="kqs"><text>púŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púŋ_4164_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>soudain, tout d'un coup</text></gloss>
      <gloss lang="en"><text>suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: púŋ</text></form></note>
  </entry>
  <entry id="pûŋ_4165">
    <lexical-unit><form lang="kqs"><text>pûŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pûŋ_4165_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>à l'excès (action exagérée)</text></gloss>
      <gloss lang="en"><text>excessively (an overdone action)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pûŋ</text></form></note>
  </entry>
  <entry id="pùŋpùùŋndó_4166">
    <lexical-unit><form lang="kqs"><text>pùŋpùùŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùŋpùùŋndó_4166_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte, bestiole</text></gloss>
      <gloss lang="en"><text>insect, bug</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùŋpùùŋndó</text></form></note>
  </entry>
  <entry id="puɔ_4167">
    <lexical-unit><form lang="kqs"><text>puɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="puɔ_4167_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramener ; épouser</text></gloss>
      <gloss lang="en"><text>bring back; marry</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: puɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit « remmener ; épouser » (« amener » ajouté à la main). À confirmer.</text></form></note>
  </entry>
  <entry id="puɔ_4168">
    <lexical-unit><form lang="kqs"><text>puɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔwvo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="puɔ_4168_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont l'écorce entre dans le kowã)</text></gloss>
      <gloss lang="en"><text>kind of tree (bark used in kowã charms)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 84: puɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : = pɔwo /K./ ; élément du tɛmbo qui protège les excisées (Fangamadou). Paulme : puɔ = pɔwo /K./ (p. 84).</text></form></note>
  </entry>
  <entry id="pɔ́_4169">
    <lexical-unit><form lang="kqs"><text>pɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔ́-pɔ́</text></form></variant>
    <sense id="pɔ́_4169_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>loin, très loin ; très haut</text></gloss>
      <gloss lang="en"><text>far, far away; very high</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>far up or off, very high, at the top</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 52 occurrences, first LEV.14.7; Childs 2000, p. 308: pɔ́</text></form></note>
    <note><form lang="fr"><text>levil pɔ́-pɔ́ « très loin » (Lv 14,7) ; coocoo pɔ́ « tout là-haut » (Jb 22,12).</text></form></note>
  </entry>
  <entry id="pɔ_4170">
    <lexical-unit><form lang="kqs"><text>pɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pɔ_4170_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>être rempli</text></gloss>
      <gloss lang="en"><text>be full</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔ</text></form></note>
    <note><form lang="fr"><text>Sens donné par le Lexique ; la Bible a pɔ́ « loin, très haut ». À vérifier.</text></form></note>
  </entry>
  <entry id="pɔ_4171">
    <lexical-unit><form lang="kqs"><text>pɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔ_4171_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 80: pɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : son écorce entre dans le nyuruwa kundɔ (Kwakɛ, Guéckédou) ; fruits pɔwa. Homographe de pɔ́ « loin ».</text></form></note>
  </entry>
  <entry id="pɔ̂_4172">
    <lexical-unit><form lang="kqs"><text>pɔ̂</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ̂_4172_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>crac (objet fragile qui se brise)</text></gloss>
      <gloss lang="en"><text>crack (breaking of a fragile object)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pɔ̂</text></form></note>
  </entry>
  <entry id="pɔ́bɔ̀_4173">
    <lexical-unit><form lang="kqs"><text>pɔ́bɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ́bɔ̀_4173_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sensation de piqûre (épine, aiguille)</text></gloss>
      <gloss lang="en"><text>feeling of being pricked (thorn, needle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.5 Sense of touch"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pɔ́bɔ̀</text></form></note>
  </entry>
  <entry id="pɔbɔn_4174">
    <lexical-unit><form lang="kqs"><text>pɔbɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔbɔn_4174_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dur</text></gloss>
      <gloss lang="en"><text>hard</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔbɔ̃</text></form></note>
  </entry>
  <entry id="pɔda_4175">
    <lexical-unit><form lang="kqs"><text>pɔda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔda_4175_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont l'écorce protège des sorciers)</text></gloss>
      <gloss lang="en"><text>kind of tree (bark used against witches)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔda</text></form></note>
    <note><form lang="fr"><text>Paulme : l'écorce pilée (suo) protège contre les sorciers.</text></form></note>
  </entry>
  <entry id="pɔkena_4176">
    <lexical-unit><form lang="kqs"><text>pɔkena</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔkena_4176_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forme d'initiation masculine</text></gloss>
      <gloss lang="en"><text>kind of male initiation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔkena</text></form></note>
  </entry>
  <entry id="pɔ̀kìtáŋndó_4177">
    <lexical-unit><form lang="kqs"><text>pɔ̀kìtáŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀kìtáŋndó_4177_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouchoir</text></gloss>
      <gloss lang="en"><text>handkerchief</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pɔ̀kìtáŋndó</text></form></note>
  </entry>
  <entry id="pɔlaa_4178">
    <lexical-unit><form lang="kqs"><text>pɔlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔla</text></form></variant>
    <variant><form lang="kqs"><text>pɔlanin</text></form></variant>
    <sense id="pɔlaa_4178_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>oindre, enduire ; tremper, mouiller (Keita) ; asperger</text></gloss>
      <gloss lang="en"><text>anoint; soak, wet (Keita); sprinkle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>soak, immerse in water</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first EXO.25.6; Keita 1979, p. 113: Pölaa; Paulme 1964, p. 81: pɔla; Lexique kissi–français, p. 44: pɔlaa/ pɔla; Childs 2000, p. 310: pɔ̀ɔ̀làá</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, pɔla s'emploie pour l'onction (EXO 28,41 ; 40,15). Paulme 1964, p. 81 : pɔla malo « mouille le riz ».</text></form></note>
  </entry>
  <entry id="pɔli_4179">
    <lexical-unit><form lang="kqs"><text>pɔli</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔli_4179_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cultures, champs</text></gloss>
      <gloss lang="en"><text>farms, fields</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔli</text></form></note>
    <note><form lang="fr"><text>Paulme : a kwɛ ɔ pɔli « ils sont allés aux champs » ; cf. pullo (pollo « campagne »). Homographe de pɔ́lì dans la Bible (GEN.41.31), autre mot.</text></form></note>
  </entry>
  <entry id="pɔli_4180">
    <lexical-unit><form lang="kqs"><text>pɔli</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔli_4180_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>farine d'écorce du bakɛo</text></gloss>
      <gloss lang="en"><text>flour of bakɛo bark</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔri</text></form></note>
    <note><form lang="fr"><text>Homographe de pɔli « champs ».</text></form></note>
  </entry>
  <entry id="pɔ̀ĺìó_4181">
    <lexical-unit><form lang="kqs"><text>pɔ̀ĺìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀ĺìó_4181_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remède traditionnel</text></gloss>
      <gloss lang="en"><text>traditional medicine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pɔ̀ĺìó</text></form></note>
  </entry>
  <entry id="pɔlullo_4182">
    <lexical-unit><form lang="kqs"><text>pɔlullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔlul</text></form></variant>
    <variant><form lang="kqs"><text>pɔlulnin</text></form></variant>
    <sense id="pɔlullo_4182_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se calmer, s'apaiser (colère, douleur) ; apaiser ; pierre sculptée (des tombes et des autels des ancêtres)</text></gloss>
      <gloss lang="en"><text>cool down, abate (anger, pain); calm; carved stone figure (on graves and ancestor altars)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cool (something, someone with a fever)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ZEC.6.8; Paulme 1964, p. 82: pɔmdo, pyɔmdo, pl. pɔmta; Terminologie (histoire), n° 8: Tyalle ; pölullo, landöö; Childs 2000, p. 309: pɔ̀lùlló</text></form></note>
    <note><form lang="fr"><text>haliko mi kɔltuw Mɛlɛka Hala niaa pɔlul « afin que la colère du Seigneur s'apaise » (DEU.13.18) ; sanga nuu pɔlulnin te « ma douleur ne s'apaise pas » (JOB.16.6) ; kɔl nuu pɔlullo « apaiser mon esprit » (ZEC.6.8). Paulme 1964, p. 82 : « pierre sculptée qu'on trouve sur les tombes et les autels des ancêtres » ; pɔm'wama « pierre qui devine, transmet le message » ; pɔm'kandya « pɔmdo habillé (pour la divination) » ; p. 89 : pɔm'saŋala « pɔmdo sur le brancard (qui devine) ». Académie des langues (terminologie, histoire n° 8) : pölullo (aussi tyalle, landöö) « accalmie ».</text></form></note>
  </entry>
  <entry id="pɔ́lɔ̀kɔ̀pɔ́lɔ̀kɔ̀_4183">
    <lexical-unit><form lang="kqs"><text>pɔ́lɔ̀kɔ̀pɔ́lɔ̀kɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ́lɔ̀kɔ̀pɔ́lɔ̀kɔ̀_4183_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bien mélangé, boueux (consistance)</text></gloss>
      <gloss lang="en"><text>thoroughly mixed, muddy (consistency)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 308: pɔ́lɔ̀kɔ̀pɔ́lɔ̀kɔ̀</text></form></note>
  </entry>
  <entry id="pɔ́lɔ́nndo_4184">
    <lexical-unit><form lang="kqs"><text>pɔ́lɔ́nndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="pɔ́lɔ́nndo_4184_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marécage</text></gloss>
      <gloss lang="en"><text>swamp, marsh</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.40.3; Keita 1979, p. 155: Pölönndo; Lexique kissi–français, p. 44: pɔlɔnndo</text></form></note>
  </entry>
  <entry id="pɔlɔɔ_4185">
    <lexical-unit><form lang="kqs"><text>pɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔrɔɔ</text></form></variant>
    <sense id="pɔlɔɔ_4185_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mauvais goût</text></gloss>
      <gloss lang="en"><text>bad taste</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔrɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit pɔrɔɔ ; homographe de pɔlɔɔ « casser » du même Lexique. Voir aussi pɔndɔkɔlɔn.</text></form></note>
  </entry>
  <entry id="pɔlɛo_4186">
    <lexical-unit><form lang="kqs"><text>pɔlɛo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pɔlɛo_4186_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson (espèce)</text></gloss>
      <gloss lang="en"><text>fish (species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 43: pɔlɛo</text></form></note>
    <note><form lang="fr"><text>Lexique, p. 43 : aussi poleo « un poisson ».</text></form></note>
  </entry>
  <entry id="pɔmbian_4187">
    <lexical-unit><form lang="kqs"><text>pɔmbian</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔmbian_4187_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante d'eau ; arbre (espèce)</text></gloss>
      <gloss lang="en"><text>water plant; kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 82: pɔmbiã</text></form></note>
    <note><form lang="fr"><text>Paulme : plante d'eau (Dogbɔdu, Wendé) ; variété d'arbre (Kenema Bɛndu).</text></form></note>
  </entry>
  <entry id="pɔmbile_4188">
    <lexical-unit><form lang="kqs"><text>pɔmbile</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pɔmbale</text></form></variant>
    <sense id="pɔmbile_4188_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dragonnier (plante des lieux de culte)</text></gloss>
      <gloss lang="en"><text>dragon tree (plant of shrines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔmbale, pɔmbile</text></form></note>
    <note><form lang="fr"><text>Dracaena. Paulme : « cactée » fréquente sur les lieux de culte ; pɔm bile « l'herbe des morts ? ».</text></form></note>
  </entry>
  <entry id="pɔ̀mbìléŋ_4189">
    <lexical-unit><form lang="kqs"><text>pɔ̀mbìléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀mbìléŋ_4189_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante des marais</text></gloss>
      <gloss lang="en"><text>a swamp plant species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 309: pɔ̀mbìléŋ</text></form></note>
  </entry>
  <entry id="pɔ̀mbúíínáá-_4190">
    <lexical-unit><form lang="kqs"><text>pɔ̀mbúíínáá-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀mbúíínáá-_4190_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>petit</text></gloss>
      <gloss lang="en"><text>small</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 309: pɔ̀mbúíínáá-</text></form></note>
  </entry>
  <entry id="pɔmbɔɔ_4191">
    <lexical-unit><form lang="kqs"><text>pɔmbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pɔmbɔa</text></form></field>
    <variant><form lang="kqs"><text>pɔmbɔ</text></form></variant>
    <sense id="pɔmbɔɔ_4191_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadet, frère ou sœur cadet(te) ; petit ; cousin(e) plus jeune</text></gloss>
      <gloss lang="en"><text>younger sibling; small, lesser; younger cousin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>small</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 155 occurrences, first GEN.1.16; Keita 1979, p. 134: Pömböö; Paulme 1964, p. 82: pɔmbo; Lexique kissi–français, p. 44: pɔnbɔɔ; Terminologie (idéologie), n° 310: Pömböö, bènduoo, ndepillo, pupapillo; Childs 2000, p. 309: pɔ̀mbɔ̀-</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 44 : pɔnbɔɔ « petit » ; « jeune frère, sœur, cousin, cousine ». Paulme 1964, p. 82 : pɔmbo « petit ; moins » ; pɔmbonu « frère cadet (au sens large) » ; pɔmbo suini « extrêmement petit ». Académie des langues (terminologie, idéologie n° 310) : « frère » (aussi bɛnduoo, ndepillo, pupapillo).</text></form></note>
  </entry>
  <entry id="pɔmndo_4192">
    <lexical-unit><form lang="kqs"><text>pɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pɔmndan</text></form></field>
    <sense id="pɔmndo_4192_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ruine (de ville), lieu dévasté</text></gloss>
      <gloss lang="en"><text>ruin, ruined town</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a deserted or abandoned town, former town site</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.13.17; Terminologie (histoire), n° 559: Sallo; pömndo; Childs 2000, p. 309: pɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>ciee pɔmndo « un monceau de ruines » (Jos 8,28) ; kobila … la siŋnun pɔmndan « vos villes deviendront des ruines » (Lv 26,33). Académie des langues (terminologie, histoire n° 559) : « ruines » (aussi sallo).</text></form></note>
  </entry>
  <entry id="pɔ̀mpɔ́mbɔ̀_4193">
    <lexical-unit><form lang="kqs"><text>pɔ̀mpɔ́mbɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀mpɔ́mbɔ̀_4193_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un peu, peu à peu</text></gloss>
      <gloss lang="en"><text>a little, little by little</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 309: pɔ̀mpɔ́mbɔ̀</text></form></note>
  </entry>
  <entry id="pɔmtɛrie_4194">
    <lexical-unit><form lang="kqs"><text>pɔmtɛrie</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔmtɛrie_4194_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pomme de terre</text></gloss>
      <gloss lang="en"><text>potato</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔmtɛrie</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; r gardé comme dans les emprunts.</text></form></note>
  </entry>
  <entry id="pɔndoo_4195">
    <lexical-unit><form lang="kqs"><text>pɔndoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔndoo_4195_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pont</text></gloss>
      <gloss lang="en"><text>bridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 44: pɔndoo; Sandara Kisia, fable 12: pɔndo</text></form></note>
    <note><form lang="fr"><text>Emprunt au français ; Keita donne tallo.</text></form></note>
  </entry>
  <entry id="pɔndu_4196">
    <lexical-unit><form lang="kqs"><text>pɔndu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pɔndu_4196_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se plaindre, gémir ; louer à grands cris (griot)</text></gloss>
      <gloss lang="en"><text>lament, wail; praise loudly (griot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 81: pɔndu</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 81 : ɔ pɔndu « il s'est plaint, a beaucoup pleuré » ; nyamakala pɔndu « le griot a fait la louange très fort » ; tyando pɔndo « sanglot du deuil » ; pɔnduo « gémissement, plainte ». Cf. pondɔɔ « éclater ; crier » (Lexique).</text></form></note>
  </entry>
  <entry id="pɔ̀ndɔ̀kìlìŋndó_4197">
    <lexical-unit><form lang="kqs"><text>pɔ̀ndɔ̀kìlìŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀ndɔ̀kìlìŋndó_4197_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (riche en eau)</text></gloss>
      <gloss lang="en"><text>a tree species (holding much water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 309: pɔ̀ndɔ̀kìlìŋndó</text></form></note>
  </entry>
  <entry id="pɔndɔkɔlɔn_4198">
    <lexical-unit><form lang="kqs"><text>pɔndɔkɔlɔn</text></form></lexical-unit>
