    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>daɲɛi</text></form></variant>
    <sense id="daɲan_735_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bronze, cuivre</text></gloss>
      <gloss lang="en"><text>bronze, copper</text></gloss>
