    <trait name="status" value="respelled"/>
    <sense id="fuo_918_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mars</text></gloss>
      <gloss lang="en"><text>March</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around February or March, end of the dry season</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Fuo; Childs 2000, p. 113: fúóò</text></form></note>
  </entry>
