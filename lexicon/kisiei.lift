      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 38: ɲaiyo</text></form></note>
    <note><form lang="fr"><text>Comparer ɲaayoo « chat ».</text></form></note>
  </entry>
  <entry id="ɲakpa_6481">
    <lexical-unit><form lang="kqs"><text>ɲakpa</text></form></lexical-unit>
