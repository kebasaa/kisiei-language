    <trait name="status" value="respelled"/>
    <sense id="yɛngiyo_6352_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse exécutée sur du bois</text></gloss>
      <gloss lang="en"><text>dance performed on wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Yèngiyo; Lexique kissi–français, p. 65: yɛngiyo</text></form></note>
  </entry>
  <entry id="yɛnguo_6353">
    <lexical-unit><form lang="kqs"><text>yɛnguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛngu</text></form></variant>
