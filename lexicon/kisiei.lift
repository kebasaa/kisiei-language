    <trait name="status" value="attested"/>
    <sense id="te_3955_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>si (te … pɛ)</text></gloss>
      <gloss lang="en"><text>if (te … pɛ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>if, when</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7156 occurrences, first GEN.3.3; Lexique kissi–français, p. 53: ta; Childs 2000, p. 350: tè … pɛ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 53 : ta « si » ; p. 55 : ti, ti … pɛ « si ».</text></form></note>
  </entry>
  <entry id="te_3956">
    <lexical-unit><form lang="kqs"><text>te</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="te_3956_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ne … pas (négation)</text></gloss>
      <gloss lang="en"><text>not (negation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 54: te</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « pas (neg) ». Dans la Bible, te est surtout « si » ; la négation finale est le. À confirmer.</text></form></note>
  </entry>
