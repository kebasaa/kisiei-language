  <entry id="lasikɔlɔɔ_3060">
    <lexical-unit><form lang="kqs"><text>lasikɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="lasikɔlɔɔ_3060_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parfum, aromates</text></gloss>
      <gloss lang="en"><text>perfume, spices</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.30.25; Keita 1979, p. 144: Lasikölöö; Lexique kissi–français, p. 31: lasikɔlɔɔ</text></form></note>
  </entry>
  <entry id="làsìmùèíyó_3061">
    <lexical-unit><form lang="kqs"><text>làsìmùèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làsìmùèíyó_3061_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>remède préparé par un marabout musulman</text></gloss>
      <gloss lang="en"><text>medicine made by a Muslim healer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làsìmùèíyó</text></form></note>
  </entry>
  <entry id="lasiɛmbu_3062">
    <lexical-unit><form lang="kqs"><text>lasiɛmbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lasiɛmbu_3062_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honte (lasiɛmbu yɔŋ « avoir honte »)</text></gloss>
      <gloss lang="en"><text>shame (lasiɛmbu yɔŋ 'be ashamed')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.2.25</text></form></note>
    <note><form lang="fr"><text>Cf. siɛmbulan.</text></form></note>
  </entry>
  <entry id="lasoo_3063">
    <lexical-unit><form lang="kqs"><text>lasoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lasoo_3063_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciment, sol cimenté</text></gloss>
      <gloss lang="en"><text>cement, paved floor</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CH.7.3; Lexique kissi–français, p. 31: lasoo</text></form></note>
    <note><form lang="fr"><text>o lasoo-o coo « sur le pavé » (2CH.7.3).</text></form></note>
  </entry>
  <entry id="lasɔɔ_3064">
    <lexical-unit><form lang="kqs"><text>lasɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lasɔɔ_3064_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avouer ; dénoncer, rapporter (sur qqn) ; accuser, accusation</text></gloss>
      <gloss lang="en"><text>confess; report on, tell on; accuse, accusation</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 14: Söèi nyiindai, viöw, lasöö; Childs 2000, p. 224: làsɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par l'Académie des langues (terminologie, histoire n° 14) : lasöö « accusation » (aussi söèi nyiindai, viöw).</text></form></note>
  </entry>
  <entry id="latámán_3065">
    <lexical-unit><form lang="kqs"><text>latámán</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="latámán_3065_s1">
