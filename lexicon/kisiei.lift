  <entry id="kééfáyɔ́lɔ̀ɔ́_1290">
    <lexical-unit><form lang="kqs"><text>kééfáyɔ́lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kééfáyɔ́lúéí</text></form></field>
    <sense id="kééfáyɔ́lɔ̀ɔ́_1290_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (femelle des marais, mâle de terre ferme) à fruits oléagineux et latex blanc</text></gloss>
      <gloss lang="en"><text>tree species (female in swamps, male on dry ground) with oil-bearing fruit and white latex</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 151: kééfáyɔ́lɔ̀ɔ́ kééfáyɔ́lúéí</text></form></note>
  </entry>
  <entry id="keeku_1291">
    <lexical-unit><form lang="kqs"><text>keeku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>keekan</text></form></variant>
    <sense id="keeku_1291_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, conduire à travers</text></gloss>
      <gloss lang="en"><text>lead through, make pass through</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pass through or by; experience; repeat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.106.9; Childs 2000, p. 151: kèèkòó</text></form></note>
    <note><form lang="fr"><text>Mó keeku nda o lɛŋnde va o mɛmndan bɛngu len « il les conduisit à travers l'abîme » (PSA.106.9). Keita (p. 52) : « Vèènè n keeku yè ma bolin ? » (passer).</text></form></note>
  </entry>
  <entry id="keelaa_1292">
    <lexical-unit><form lang="kqs"><text>keelaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>keela</text></form></variant>
    <sense id="keelaa_1292_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller et venir, parcourir ; (keela kɔllo) méditer, réfléchir</text></gloss>
      <gloss lang="en"><text>go about, walk about; (keela kɔllo) meditate, reflect</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stroll, saunter, walk about</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first JOS.1.8; Childs 2000, p. 151: kèèlàá</text></form></note>
    <note><form lang="fr"><text>Cf. kelaa « marcher ».</text></form></note>
  </entry>
  <entry id="keeliaa_1293">
    <lexical-unit><form lang="kqs"><text>keeliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="keeliaa_1293_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire marcher, promener ; promener (le regard)</text></gloss>
      <gloss lang="en"><text>lead about; look around</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.13.10; Keita 1979, p. 110: Keeliaa</text></form></note>
    <note><form lang="fr"><text>Causatif de kelaa : keeliaa hɔlla « promener les yeux » (GEN 13,10).</text></form></note>
  </entry>
  <entry id="kèèlúŋndó_1294">
    <lexical-unit><form lang="kqs"><text>kèèlúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kèèlúŋndó_1294_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de petit oiseau</text></gloss>
      <gloss lang="en"><text>a small species of bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 152: kèèlúŋndó</text></form></note>
  </entry>
  <entry id="kééndéíyé_1295">
    <lexical-unit><form lang="kqs"><text>kééndéíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="kééndéíyé_1295_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lame de rasoir traditionnelle</text></gloss>
      <gloss lang="en"><text>traditional razor blade</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 158: kééndéíyé</text></form></note>
  </entry>
  <entry id="keenduu_1296">
    <lexical-unit><form lang="kqs"><text>keenduu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>keendun</text></form></variant>
    <sense id="keenduu_1296_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cueillir, arracher, dépouiller (fruits, feuilles) ; (keendun) tomber (cheveux)</text></gloss>
      <gloss lang="en"><text>pick off, strip off (fruit, leaves); (keendun) fall out (hair)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pick (many fruits), plural of 'pick, pluck'; (middle) drop, fall</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EZK.17.9; Childs 2000, p. 152: kèèndùùwó</text></form></note>
    <note><form lang="fr"><text>La keenduu pei ndɔɛi kpow « arrachez tout son feuillage » (DAN.4.11) ; keenduu kpɔ̀nyɔ̀la « vendanger les grappes » (REV.14.18) ; yiiŋii … keendun « les cheveux tombent » (LEV.13.40). Cf. kiɔndɔɔ « cueillir ».</text></form></note>
  </entry>
  <entry id="keesoo_1297">
    <lexical-unit><form lang="kqs"><text>keesoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>keese</text></form></variant>
    <variant><form lang="kqs"><text>keesela</text></form></variant>
    <sense id="keesoo_1297_s1">
