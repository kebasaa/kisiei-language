    <trait name="status" value="attested"/>
    <sense id="sɔ́_3146_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>partout, tout autour ; entièrement (remplir)</text></gloss>
      <gloss lang="en"><text>all over, all around; completely (fill)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 106 occurrences, first GEN.9.7; Childs 2000, p. 339: sɔ́</text></form></note>
    <note><form lang="fr"><text>tiw … sɔ́ « remplir entièrement » (Gn 9,7) ; balu cieo sɔ́ « entourer la ville » (Ps 59,7) ; o tivaa sɔ́ « sur toute la surface » (Ex 4,6).</text></form></note>
  </entry>
