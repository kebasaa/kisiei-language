    <trait name="noun-class" value="o"/>
    <trait name="status" value="confirmed"/>
    <field type="plural"><form lang="kqs"><text>ŋɔɔŋɔɔnda</text></form></field>
    <variant><form lang="kqs"><text>ŋɔɔŋɔŋaa</text></form></variant>
    <sense id="ŋɔ́ɔ́ŋŋɔ́ɔ́ŋndó_2041_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grenouille-taureau, grosse grenouille ; (pl.) grenouilles</text></gloss>
      <gloss lang="en"><text>bullfrog, large frog; (pl.) frogs</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 271: ŋɔ́ɔ́ŋŋɔ́ɔ́ŋndó</text></form></note>
    <note><form lang="fr"><text>Singulier confirmé par un locuteur du kisiei (kissi du Nord) ; il est aussi en kissi du Sud (Childs 2000). Le pluriel ŋɔɔŋɔɔnda est attesté dans la Bible (Ex 8,2).</text></form></note>
  </entry>
