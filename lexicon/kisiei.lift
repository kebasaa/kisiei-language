      <trait name="semantic-domain-ddp4" value="8.1.2 Count"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 550: Sèva muloo, sèvaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « inscrire (pour) l'impôt » (sɛvaa « écrire », muloo « impôt »).</text></form></note>
  </entry>
  <entry id="sɛvaa_4985">
    <lexical-unit><form lang="kqs"><text>sɛvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛva</text></form></variant>
    <variant><form lang="kqs"><text>sɛvanin</text></form></variant>
    <variant><form lang="kqs"><text>sɛvan</text></form></variant>
