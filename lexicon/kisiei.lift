      <gloss lang="en"><text>eddo, taro</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 378: wááyéléŋ</text></form></note>
