      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>canoe, boat; also an airplane</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 138 occurrences, first GEN.6.18; Keita 1979, p. 159: Dèndöö; Childs 2000, p. 75: dèndɔ̀ɔ́</text></form></note>
