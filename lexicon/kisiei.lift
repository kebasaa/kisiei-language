  <entry id="baloo_19">
    <lexical-unit><form lang="kqs"><text>baloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balo</text></form></variant>
    <sense id="baloo_19_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture ; (dɔwnun balo) se nourrir</text></gloss>
      <gloss lang="en"><text>food; (dɔwnun balo) feed on</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 102 occurrences, first GEN.1.29</text></form></note>
  </entry>
  <entry id="balu_20">
    <lexical-unit><form lang="kqs"><text>balu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>balunin</text></form></variant>
    <sense id="balu_20_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire le tour, entourer ; parcourir</text></gloss>
      <gloss lang="en"><text>go around, surround; roam through</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 345 occurrences, first GEN.2.11; Childs 2000, p. 5: bàlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="balɔɔ_21">
    <lexical-unit><form lang="kqs"><text>balɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="balɔɔ_21_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avant-bras (Keita) ; autour, à travers (Bible)</text></gloss>
      <gloss lang="en"><text>forearm (Keita); around, throughout (Bible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wrist</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Balöö; Childs 2000, p. 6: bàlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, balɔɔ ne s'emploie que comme locatif « autour, partout dans » (Gn 41,46 ; Ex 19,12 ; Lv 13,13). Childs donne « poignet » ; la partie exacte du bras est à confirmer.</text></form></note>
  </entry>
  <entry id="bandaa_22">
    <lexical-unit><form lang="kqs"><text>bandaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bandaa_22_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fromager</text></gloss>
      <gloss lang="en"><text>kapok tree, silk-cotton tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bandaa</text></form></note>
    <note><form lang="fr"><text>Ceiba pentandra.</text></form></note>
  </entry>
  <entry id="bandei_23">
    <lexical-unit><form lang="kqs"><text>bandei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bandii</text></form></variant>
    <sense id="bandei_23_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coudée ; mesure, limite</text></gloss>
      <gloss lang="en"><text>cubit; measure, limit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) be tall; height, length</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.6.3; Childs 2000, p. 7: bàndèí</text></form></note>
  </entry>
