      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làŋgúéíyó</text></form></note>
  </entry>
  <entry id="le_2382">
    <lexical-unit><form lang="kqs"><text>le</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="le_2382_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>pour, à cause de</text></gloss>
      <gloss lang="en"><text>for, because of</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24773 occurrences, first GEN.1.2; Lexique kissi–français, p. 32: le; Childs 2000, p. 225: lé</text></form></note>
  </entry>
  <entry id="le_2383">
    <lexical-unit><form lang="kqs"><text>le</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>te</text></form></variant>
    <sense id="le_2383_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ne… pas (négation finale)</text></gloss>
      <gloss lang="en"><text>not (clause-final negation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24773 occurrences, first GEN.1.2; Lexique kissi–français, p. 45: re; Childs 2000, p. 225: lé</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 45 : re, allomorphe de le et te après l, m, n, t (« seulement en kissi du nord ») ; ro, contraction de re et o en fin de phrase.</text></form></note>
  </entry>
  <entry id="le hee_2384">
    <lexical-unit><form lang="kqs"><text>le hee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="le hee_2384_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>alors ; c'est pourquoi</text></gloss>
      <gloss lang="en"><text>then; therefore</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
  </entry>
  <entry id="le tùú_2385">
    <lexical-unit><form lang="kqs"><text>le tùú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="le tùú_2385_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>parce que</text></gloss>
      <gloss lang="en"><text>because</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
  </entry>
  <entry id="lebollo_2386">
    <lexical-unit><form lang="kqs"><text>lebollo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lebollo_2386_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>principal</text></gloss>
      <gloss lang="en"><text>main, principal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first NUM.21.26; Lexique kissi–français, p. 32: lebollo</text></form></note>
    <note><form lang="fr"><text>kobi lebollo « ville principale, capitale » (NUM.21.26 ; DEU.1.4).</text></form></note>
  </entry>
  <entry id="lebɛngu_2387">
    <lexical-unit><form lang="kqs"><text>lebɛngu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lebɛngu_2387_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dessous, en dessous</text></gloss>
      <gloss lang="en"><text>underneath, below</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>under, between</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.1.7; Childs 2000, p. 14: bèŋù</text></form></note>
  </entry>
  <entry id="lecoo_2388">
    <lexical-unit><form lang="kqs"><text>lecoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lecoo_2388_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dessus, en haut</text></gloss>
      <gloss lang="en"><text>on top, above</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'about, concerning'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 538 occurrences, first GEN.1.2; Lexique kissi–français, p. 32: lecoo; Childs 2000, p. 225: lécòó</text></form></note>
  </entry>
  <entry id="lediom_2389">
    <lexical-unit><form lang="kqs"><text>lediom</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lediom_2389_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vérité, fidélité, droiture (o lediom coo)</text></gloss>
      <gloss lang="en"><text>truth, faithfulness, uprightness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 188 occurrences, first GEN.47.29</text></form></note>
  </entry>
  <entry id="lee_2390">
    <lexical-unit><form lang="kqs"><text>lee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>leelan</text></form></field>
    <variant><form lang="kqs"><text>leela</text></form></variant>
    <sense id="lee_2390_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corne ; trompe (en corne)</text></gloss>
      <gloss lang="en"><text>horn; (horn) trumpet</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 100 occurrences, first GEN.36.7; Childs 2000, p. 226: lèèyɔ́</text></form></note>
  </entry>
  <entry id="leeloo_2391">
    <lexical-unit><form lang="kqs"><text>leeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="leeloo_2391_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>de l'autre côté de, au-delà de</text></gloss>
      <gloss lang="en"><text>on the other side of, beyond</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>across, on the other side; in Liberia also a name for Guinea</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 110 occurrences, first GEN.50.10; Childs 2000, p. 225: lèèlò</text></form></note>
  </entry>
  <entry id="leemu-leemu_2392">
    <lexical-unit><form lang="kqs"><text>leemu-leemu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>leemu-leemoo</text></form></variant>
    <sense id="leemu-leemu_2392_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souple, flexible, qui plie</text></gloss>
      <gloss lang="en"><text>supple, pliant, bending</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flexibly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.49.24; Childs 2000, p. 228: lɛ́ɛ̀mù</text></form></note>
    <note><form lang="fr"><text>congúla ndɔlan … la co vɔ leemu-leemu « ses bras restent souples » (GEN.49.24) ; tiindan leemu-leemoo « un appui qui plie » (EZK.29.6).</text></form></note>
  </entry>
  <entry id="leendo_2393">
    <lexical-unit><form lang="kqs"><text>leendo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>leenda</text></form></field>
    <sense id="leendo_2393_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>margouillat</text></gloss>
      <gloss lang="en"><text>agama lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gecko, a black lizard</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Leendo; Lexique kissi–français, p. 32: leendo; Childs 2000, p. 226: lééŋndó</text></form></note>
    <note><form lang="fr"><text>Le pluriel leenda « lézards » est dans la Bible (LEV.11.29, PRO.30.28).</text></form></note>
  </entry>
  <entry id="lèéŋndé_2394">
    <lexical-unit><form lang="kqs"><text>lèéŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="lèéŋndé_2394_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>déchets, gaspillage</text></gloss>
      <gloss lang="en"><text>waste</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 226: lèéŋndé</text></form></note>
  </entry>
  <entry id="lefoo_2395">
    <lexical-unit><form lang="kqs"><text>lefoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefoo_2395_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-père ; (lefu … laandoo) belle-mère</text></gloss>
      <gloss lang="en"><text>father-in-law; (lefu … laandoo) mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.18.1</text></form></note>
  </entry>
  <entry id="lefuo_2396">
    <lexical-unit><form lang="kqs"><text>lefuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lefua</text></form></field>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefuo_2396_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent par alliance : gendre, bru, beau-père, belle-mère</text></gloss>
      <gloss lang="en"><text>in-law: son-in-law, daughter-in-law, father-in-law, mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in-law</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Lefuo; Lexique kissi–français, p. 32: lefuo; Childs 2000, p. 226: lèfòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale lefu attestée (Jéthro, beau-père de Moïse, Ex 3,1) ; pluriel lefua « gendres » (Gn 19,14). Keita donne aussi Nde lefu « la belle-mère ».</text></form></note>
  </entry>
  <entry id="lèíyó_2397">
    <lexical-unit><form lang="kqs"><text>lèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lèíyó_2397_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'insecte volant (qui pique)</text></gloss>
      <gloss lang="en"><text>kind of flying insect (stings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 229: lèíyó</text></form></note>
  </entry>
  <entry id="lekáá_2398">
    <lexical-unit><form lang="kqs"><text>lekáá</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lekáá_2398_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éloignement, exil (o lekáá « au loin, banni, perdu »)</text></gloss>
      <gloss lang="en"><text>absence, exile (o lekáá 'away, banished, lost')</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note><form lang="fr"><text>Simeɔn bɛɛ lo o lekáá « Siméon aussi n'est plus » (Gn 42,36) ; po nɔm co o lekáá-o « ton fils banni » (2 S 14,13).</text></form></note>
  </entry>
  <entry id="lekaando_2399">
    <lexical-unit><form lang="kqs"><text>lekaando</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lekaan</text></form></variant>
    <variant><form lang="kqs"><text>lekaannda</text></form></variant>
    <variant><form lang="kqs"><text>lekaandan</text></form></variant>
    <variant><form lang="kqs"><text>lekaandon</text></form></variant>
    <sense id="lekaando_2399_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>du culte, cultuel</text></gloss>
      <gloss lang="en"><text>of worship, cultic</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first DEU.16.8</text></form></note>
    <note><form lang="fr"><text>baala lekaando « service du culte » (2 R 25,14) ; cuungian lekaando « assemblée solennelle » (Dt 16,8) ; cɛi lekaan « synagogue » (Mt 12,9).</text></form></note>
  </entry>
  <entry id="lèkpààdóó_2400">
    <lexical-unit><form lang="kqs"><text>lèkpààdóó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lèkpààdóó_2400_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mardi (jour de marché)</text></gloss>
      <gloss lang="en"><text>Tuesday (market day)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 226: lèkpààdóó</text></form></note>
  </entry>
  <entry id="lekɔɔ_2401">
    <lexical-unit><form lang="kqs"><text>lekɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lekɔɔ_2401_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sur (le corps), sur soi ; auprès de</text></gloss>
      <gloss lang="en"><text>on (the body), on oneself; next to</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>on, near, next to, behind</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 259 occurrences, first GEN.13.12; Childs 2000, p. 226: lèkɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Esau … nɔ yiinde lekɔɔ taw « Ésaü est velu » (GEN.27.11) ; soli ndu doma … lekɔɔ « lui ôtèrent sa tunique » (GEN.37.23). Cf. lekɔɔli « dehors ».</text></form></note>
  </entry>
  <entry id="lekɔɔli_2402">
    <lexical-unit><form lang="kqs"><text>lekɔɔli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lekɔɔli_2402_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dehors, à l'extérieur</text></gloss>
      <gloss lang="en"><text>outside, on the outside</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.4 Inner part"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.6.14</text></form></note>
  </entry>
  <entry id="lekɛ́ndɛi_2403">
    <lexical-unit><form lang="kqs"><text>lekɛ́ndɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lekɛ́ndɛi_2403_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>vraiment, en vérité</text></gloss>
      <gloss lang="en"><text>truly, really</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 155 occurrences, first GEN.12.14</text></form></note>
  </entry>
  <entry id="lelan_2404">
    <lexical-unit><form lang="kqs"><text>lelan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lelan_2404_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>c'est pourquoi, donc</text></gloss>
      <gloss lang="en"><text>therefore, so</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1437 occurrences, first GEN.2.24; Childs 2000, p. 226: léláŋ</text></form></note>
  </entry>
  <entry id="lemasaa_2405">
    <lexical-unit><form lang="kqs"><text>lemasaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lemasalan</text></form></field>
    <variant><form lang="kqs"><text>lemasa</text></form></variant>
    <variant><form lang="kqs"><text>lemasala</text></form></variant>
    <sense id="lemasaa_2405_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>royauté, majesté ; (après un nom) royal</text></gloss>
      <gloss lang="en"><text>kingship, majesty; (after a noun) royal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 294 occurrences, first GEN.14.17</text></form></note>
    <note><form lang="fr"><text>cɛi lemasaa « palais royal ».</text></form></note>
  </entry>
  <entry id="lemboo_2406">
    <lexical-unit><form lang="kqs"><text>lemboo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lemboa</text></form></field>
    <variant><form lang="kqs"><text>lembu</text></form></variant>
    <sense id="lemboo_2406_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vierge (jeune fille non mariée)</text></gloss>
      <gloss lang="en"><text>virgin (unmarried girl)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first NUM.30.4</text></form></note>
    <note><form lang="fr"><text>cuaambɔ lembu « jeune fille vierge » (Gn 24,16) ; cuaambɔa lemboa (Nb 31,35).</text></form></note>
  </entry>
  <entry id="lembulten_2407">
    <lexical-unit><form lang="kqs"><text>lembulten</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="lembulten_2407_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>citron</text></gloss>
      <gloss lang="en"><text>lemon, lime</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>citrus fruit: orange, lemon, lime</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Lembulten; Lexique kissi–français, p. 32: lenbulten; Childs 2000, p. 91: dùmbúltéŋ</text></form></note>
  </entry>
  <entry id="lémcíóó_2408">
