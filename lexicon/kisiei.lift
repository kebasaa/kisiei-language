      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>feuilles de manioc (légume)</text></gloss>
      <gloss lang="en"><text>cassava leaves (greens)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sókócáá</text></form></note>
  </entry>
  <entry id="sókólápòó_4678">
    <lexical-unit><form lang="kqs"><text>sókólápòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sókólápúá</text></form></field>
    <sense id="sókólápòó_4678_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque (esprit) qui joue de la trompe, interdit aux femmes et non-initiés</text></gloss>
      <gloss lang="en"><text>masked spirit playing horns, not to be seen by women or non-initiates</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sókólápòó</text></form></note>
  </entry>
  <entry id="sókóléŋ_4679">
    <lexical-unit><form lang="kqs"><text>sókóléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sókóléŋ_4679_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>activité de guérisseur, d'herboriste</text></gloss>
      <gloss lang="en"><text>practice of a herbalist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sókóléŋ</text></form></note>
  </entry>
  <entry id="sokonɔ-vialaa_4680">
    <lexical-unit><form lang="kqs"><text>sokonɔ-vialaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sokoa-vialaa</text></form></field>
    <sense id="sokonɔ-vialaa_4680_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sage-femme, accoucheuse</text></gloss>
      <gloss lang="en"><text>midwife</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="6.6 Occupation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.35.17</text></form></note>
    <note><form lang="fr"><text>Composé de sokonɔɔ « guérisseur » et vialaa « mettre au monde ».</text></form></note>
  </entry>
  <entry id="sokonɔɔ_4681">
    <lexical-unit><form lang="kqs"><text>sokonɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sokonɔɔ_4681_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médecin, guérisseur</text></gloss>
      <gloss lang="en"><text>healer, doctor</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>herbalist, traditional healer, shaman</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Sokonöö; Lexique kissi–français, p. 50: sokonɔɔ; Childs 2000, p. 338: sókónɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La Bible a sokonɔ-vialaa « sage-femme » (Gn 38,28).</text></form></note>
  </entry>
  <entry id="sókónɔ̀ɔ́_4682">
    <lexical-unit><form lang="kqs"><text>sókónɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sókùá</text></form></field>
