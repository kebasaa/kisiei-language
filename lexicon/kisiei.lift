  <entry id="ɲiimu-ɲiimu_4173">
    <lexical-unit><form lang="kqs"><text>ɲiimu-ɲiimu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲiimu-ɲiimoo</text></form></variant>
    <sense id="ɲiimu-ɲiimu_4173_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) en chuchotant, à voix basse ; murmure</text></gloss>
      <gloss lang="en"><text>(ideophone) in a whisper, in a low voice; whispering</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first ISA.29.4; Childs 2000, p. 279: ɲíímú-ɲììmù</text></form></note>
  </entry>
  <entry id="ɲiinduuo_4174">
    <lexical-unit><form lang="kqs"><text>ɲiinduuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲiinduu</text></form></variant>
    <sense id="ɲiinduuo_4174_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accuser (faussement) ; précipiter, pousser (en bas)</text></gloss>
      <gloss lang="en"><text>accuse (falsely); push down, hurl down</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 1KI.21.13; Childs 2000, p. 279: ɲììndùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de ɲindu « pousser ».</text></form></note>
  </entry>
  <entry id="ɲiiyaa_4175">
    <lexical-unit><form lang="kqs"><text>ɲiiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲiiya</text></form></variant>
    <variant><form lang="kqs"><text>ɲiiyanin</text></form></variant>
    <sense id="ɲiiyaa_4175_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trembler</text></gloss>
      <gloss lang="en"><text>tremble, shake</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shiver (from cold or fever); be anxious</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first JDG.5.5; Childs 2000, p. 279: ɲììyáá</text></form></note>
  </entry>
  <entry id="ɲììyàá-dìàlóŋ_4176">
    <lexical-unit><form lang="kqs"><text>ɲììyàá-dìàlóŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="ɲììyàá-dìàlóŋ_4176_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tremblements du corps ; paludisme</text></gloss>
      <gloss lang="en"><text>body trembling, shaking; malaria</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 280: ɲììyàá-dìàlóŋ</text></form></note>
    <note><form lang="fr"><text>Cf. ɲiiyaa « trembler » (Bible).</text></form></note>
  </entry>
  <entry id="ɲííye_4177">
    <lexical-unit><form lang="kqs"><text>ɲííye</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲííye_4177_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pitié, compassion</text></gloss>
      <gloss lang="en"><text>pity, compassion</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sorrow, pity, mercy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first EXO.2.6; Childs 2000, p. 277: ɲɛ̀éyé</text></form></note>
    <note><form lang="fr"><text>ɲííye bii X « X a pitié ».</text></form></note>
  </entry>
  <entry id="ɲílífɔ̀ŋndó_4178">
    <lexical-unit><form lang="kqs"><text>ɲílífɔ̀ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="ɲílífɔ̀ŋndó_4178_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>uniforme</text></gloss>
      <gloss lang="en"><text>uniform</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 280: ɲílífɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais uniform.</text></form></note>
