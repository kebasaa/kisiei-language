    <note><form lang="fr"><text>Le pluriel tɔmnda est dans la Bible (1KI.10.22).</text></form></note>
  </entry>
  <entry id="tɔndaa_3514">
    <lexical-unit><form lang="kqs"><text>tɔndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔnda</text></form></variant>
    <sense id="tɔndaa_3514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tisser, ourdir (le fil)</text></gloss>
      <gloss lang="en"><text>weave, warp (thread)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make the warp thread for weaving, wrap spools; also defame someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1CH.11.23; Childs 2000, p. 369: tɔ̀ndàá</text></form></note>
    <note><form lang="fr"><text>kola nda tɔnda « l'étoffe qu'ils tissèrent » (EXO.39.22) ; vanaa co funnden tɔndaa « ceux qui travaillent le lin » (ISA.19.9) ; kola-yɔɔsɔɔ o ndu tɔndaa « ensouple de tisserand » (1CH.11.23).</text></form></note>
  </entry>
  <entry id="tɔndikɔɔliei_3515">
