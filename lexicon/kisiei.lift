      <gloss lang="en"><text>small reddish swamp mouse (edible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 149: kásáá</text></form></note>
  </entry>
