  <entry id="fíɲɔ́ɔ́_870">
    <lexical-unit><form lang="kqs"><text>fíɲɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
