    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>liviaa</text></form></variant>
    <sense id="liva_2075_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être mouillé, trempé</text></gloss>
      <gloss lang="en"><text>be wet, be drenched</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.6.39; Childs 2000, p. 231: lìwàá</text></form></note>
    <note><form lang="fr"><text>fonda tɔ̀u kpow liva a kɛmndan « tout le sol était mouillé de rosée » (Jg 6,40). liviaa « mouiller, tremper » (Jb 24,8).</text></form></note>
  </entry>
  <entry id="lìŋndó_2076">
    <lexical-unit><form lang="kqs"><text>lìŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
