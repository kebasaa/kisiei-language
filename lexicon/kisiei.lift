      <gloss lang="fr"><text>lèpre (doigts tordus et rongés)</text></gloss>
      <gloss lang="en"><text>leprosy (with twisted, decaying fingers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 156: kèŋndó</text></form></note>
  </entry>
  <entry id="kèŋndóŋ_1569">
