    <trait name="status" value="respelled"/>
    <sense id="kungulaa_1798_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>butter, faire des buttes</text></gloss>
      <gloss lang="en"><text>make mounds, ridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make heaps of dirt</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kungulaa; Childs 2000, p. 196: kùŋgùlàá</text></form></note>
    <note><form lang="fr"><text>kungulan dans la Bible (GEN 6,14 ; EXO 9,2) a d'autres sens.</text></form></note>
