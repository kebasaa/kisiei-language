      <gloss lang="en"><text>a rice variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 324: sèlèbùéí</text></form></note>
  </entry>
  <entry id="sélébúŋgéŋndó_4482">
    <lexical-unit><form lang="kqs"><text>sélébúŋgéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sélébúŋgéŋndó_4482_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauterelle comestible</text></gloss>
      <gloss lang="en"><text>edible grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 324: sélébúŋgéŋndó</text></form></note>
  </entry>
  <entry id="sèléí_4483">
