    <sense id="ɲɛ̀-sìmàá_5107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point de côté, douleur thoracique, crampe ; pneumonie (« chose debout »)</text></gloss>
      <gloss lang="en"><text>side or chest pain, cramp; pneumonia ('thing standing')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 278: ɲɛ̀-sìmàá</text></form></note>
  </entry>
