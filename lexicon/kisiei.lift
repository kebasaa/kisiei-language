  <entry id="sontɛndɔɔ_4713">
    <lexical-unit><form lang="kqs"><text>sontɛndɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sontɛndɔɔ_4713_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>araignée</text></gloss>
      <gloss lang="en"><text>spider</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.59.5; Lexique kissi–français, p. 51: sontɛndɔɔ; Childs 2000, p. 339: sóóŋtɛ́ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 51 et par la Bible (sontɛndɔɔ lɔu « toile d'araignée », ISA.59.5).</text></form></note>
  </entry>
  <entry id="sonuo_4714">
    <lexical-unit><form lang="kqs"><text>sonuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sonuo_4714_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauterelle</text></gloss>
      <gloss lang="en"><text>grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 51: sonuo</text></form></note>
    <note><form lang="fr"><text>Comparer sóónɔɔ « sauterelle, criquet » (Bible).</text></form></note>
  </entry>
  <entry id="soo_4715">
    <lexical-unit><form lang="kqs"><text>soo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="soo_4715_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médicament noir frotté sur les blessures</text></gloss>
      <gloss lang="en"><text>black medicine rubbed on wounds</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 51: soo</text></form></note>
    <note><form lang="fr"><text>Homographe de soo (forme de sɔɛi « parler »).</text></form></note>
  </entry>
  <entry id="soo_4716">
    <lexical-unit><form lang="kqs"><text>soo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="soo_4716_s1">
