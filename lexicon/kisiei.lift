    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpàá</text></form></field>
    <sense id="kpàà_1497_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grosse fourmi rouge à morsure douloureuse (forme des ponts)</text></gloss>
      <gloss lang="en"><text>large red ant with a painful bite (builds bridges)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpàà kpàá</text></form></note>
