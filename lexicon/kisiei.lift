  <entry id="nɛa soalaa_1228">
    <lexical-unit><form lang="kqs"><text>nɛa soalaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="nɛa soalaa_1228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieux d'aisance, latrines</text></gloss>
      <gloss lang="en"><text>latrine, toilet</text></gloss>
