    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 338: sòndò-kàá</text></form></note>
  </entry>
  <entry id="sondoo_3070">
    <lexical-unit><form lang="kqs"><text>sondoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sondo</text></form></variant>
    <sense id="sondoo_3070_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouche ; entrée, porte (d'une ville)</text></gloss>
      <gloss lang="en"><text>mouth; entrance, gate</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mouth; opening, hole</text></form></field>
