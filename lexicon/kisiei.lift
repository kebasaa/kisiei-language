      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 29: kpua</text></form></note>
    <note><form lang="fr"><text>Forme courte (inf., passé).</text></form></note>
