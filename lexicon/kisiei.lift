  <entry id="fondoo_1412">
    <lexical-unit><form lang="kqs"><text>fondoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fondo</text></form></variant>
    <variant><form lang="kqs"><text>fondoa</text></form></variant>
    <variant><form lang="kqs"><text>fondon</text></form></variant>
    <variant><form lang="kqs"><text>fondolan</text></form></variant>
    <sense id="fondoo_1412_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vide, nu ; vain, sans valeur</text></gloss>
      <gloss lang="en"><text>empty, bare; vain, worthless</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dry (well), empty, bare, worthless; (with negation) at all</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 173 occurrences, first EXO.23.3; Paulme 1964, p. 28: fundo, fundɔ; Lexique kissi–français, p. 16: fondoo; Childs 2000, p. 108: fóndò</text></form></note>
    <note><form lang="fr"><text>tum fondo « tout nu » ; vanaa bala fondoa « les pauvres » ; bala fondolan « la pauvreté » ; halaa fondoa « les idoles ». Aussi Lexique kissi–français, p. 58 : « tum fondo ». Lexique kissi–français, p. 58 : tum fondo « la nudité ». Paulme 1964, p. 28 : fundo « vide » (bɔrɔfundo « sac vide » ; tala fundo ni « la calebasse est vide »).</text></form></note>
  </entry>
