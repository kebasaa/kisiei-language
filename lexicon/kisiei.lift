    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kóóŋgúéí</text></form></field>
    <sense id="kóóŋgóó_2259_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (bois de planches)</text></gloss>
