  <entry id="pena_2566">
    <lexical-unit><form lang="kqs"><text>pena</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pena_2566_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lever tôt, faire (quelque chose) de bon matin</text></gloss>
      <gloss lang="en"><text>rise early, do (something) early in the morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be on time or early, go out early in the day; also an incipient tense marker</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.19.2; Childs 2000, p. 292: pènàá</text></form></note>
    <note><form lang="fr"><text>Souvent avec idiiyo púŋ « tôt le matin » : Diimandɔɔ idiiyo púŋ, mí Abraham pena buloo cua « Abraham se leva de bon matin, prit du pain » (Gn 21,14).</text></form></note>
  </entry>
  <entry id="pendei_2567">
    <lexical-unit><form lang="kqs"><text>pendei</text></form></lexical-unit>
