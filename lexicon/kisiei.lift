    <trait name="status" value="southern"/>
    <sense id="héú_1030_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très gros, énorme</text></gloss>
      <gloss lang="en"><text>very big, enormous</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: héú</text></form></note>
  </entry>
  <entry id="héŋbéndéŋ_1031">
