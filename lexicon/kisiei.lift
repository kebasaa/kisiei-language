    <sense id="kolaa_1653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagne, tissu</text></gloss>
      <gloss lang="en"><text>cloth, wrapper</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 194 occurrences, first GEN.16.7; Keita 1979, p. 144: Kolaa; Lexique kissi–français, p. 25: kolaa; Childs 2000, p. 172: kòlàá</text></form></note>
    <note><form lang="fr"><text>À distinguer de kólaa dans soon kólaa « puits, source ». Lexique kissi–français, p. 26 : aussi koraa « pagne ».</text></form></note>
