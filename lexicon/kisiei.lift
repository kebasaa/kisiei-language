  <entry id="bidiinndɔɔ_66">
    <lexical-unit><form lang="kqs"><text>bidiinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bidiinndɔɔ_66_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>vingtième</text></gloss>
      <gloss lang="en"><text>twentieth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1KI.15.9</text></form></note>
    <note><form lang="fr"><text>Ordinal de bidiin « vingt ».</text></form></note>
  </entry>
  <entry id="bii_67">
    <lexical-unit><form lang="kqs"><text>bii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biinin</text></form></variant>
    <sense id="bii_67_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, attraper, tenir ; garder, observer (un commandement)</text></gloss>
      <gloss lang="en"><text>seize, catch, hold; keep (a commandment)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2065 occurrences, first GEN.3.6; Childs 2000, p. 20: bìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="biiloo_68">
    <lexical-unit><form lang="kqs"><text>biiloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biilu</text></form></variant>
    <variant><form lang="kqs"><text>biilunin</text></form></variant>
    <sense id="biiloo_68_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier, adorer</text></gloss>
      <gloss lang="en"><text>praise, glorify, worship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 316 occurrences, first GEN.9.26</text></form></note>
  </entry>
  <entry id="biilɔnndo_69">
    <lexical-unit><form lang="kqs"><text>biilɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="biilɔnndo_69_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être glorifié, être loué</text></gloss>
      <gloss lang="en"><text>be glorified, be praised</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.12.5</text></form></note>
    <note><form lang="fr"><text>Moyen de biiloo « louer ».</text></form></note>
  </entry>
  <entry id="biinun_70">
    <lexical-unit><form lang="kqs"><text>biinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="biinun_70_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rattraper, se saisir de</text></gloss>
      <gloss lang="en"><text>overtake, take hold of</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.15.9</text></form></note>
    <note><form lang="fr"><text>Moyen de bii « saisir ».</text></form></note>
  </entry>
  <entry id="biisio_71">
    <lexical-unit><form lang="kqs"><text>biisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>biisilan</text></form></field>
    <variant><form lang="kqs"><text>biisi</text></form></variant>
    <sense id="biisio_71_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>deuil, funérailles</text></gloss>
      <gloss lang="en"><text>mourning, funeral</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>funeral arrangements, wake</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.50.7; Childs 2000, p. 17: bììsììyó</text></form></note>
  </entry>
  <entry id="biiŋoo_72">
    <lexical-unit><form lang="kqs"><text>biiŋoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biiŋuu</text></form></variant>
    <sense id="biiŋoo_72_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>remuer, agiter, secouer ; soulever (une foule)</text></gloss>
      <gloss lang="en"><text>stir, shake, agitate; stir up (a crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3 Move something"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stir (food while cooking); stir up (fish)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 1SA.1.13; Childs 2000, p. 19: bìŋìó</text></form></note>
  </entry>
  <entry id="biiŋun_73">
    <lexical-unit><form lang="kqs"><text>biiŋun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biiŋɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>biiŋɔn</text></form></variant>
    <sense id="biiŋun_73_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être secoué, s'agiter, s'émouvoir</text></gloss>
      <gloss lang="en"><text>be shaken, be stirred, toss</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake, quiver (a form of bìŋìó 'stir')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first RUT.1.19; Childs 2000, p. 18: bìŋìáŋ</text></form></note>
    <note><form lang="fr"><text>Moyen de biiŋoo.</text></form></note>
  </entry>
  <entry id="bila_74">
    <lexical-unit><form lang="kqs"><text>bila</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bila_74_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sens ; (bii … bila) comprendre</text></gloss>
      <gloss lang="en"><text>meaning; (bii … bila) understand</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 216 occurrences, first GEN.19.9</text></form></note>
  </entry>
  <entry id="bilio_75">
    <lexical-unit><form lang="kqs"><text>bilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bilio_75_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rue</text></gloss>
      <gloss lang="en"><text>street</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Bilio; Childs 2000, p. 17: bílíó</text></form></note>
    <note><form lang="fr"><text>Keita glose « la rue (route) » ; la Bible dit nɛiyo pour « chemin, route ».</text></form></note>
  </entry>
  <entry id="billo_76">
    <lexical-unit><form lang="kqs"><text>billo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bil</text></form></variant>
    <variant><form lang="kqs"><text>bilten</text></form></variant>
    <variant><form lang="kqs"><text>bilte</text></form></variant>
    <sense id="billo_76_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe ; herbe, plante, verdure</text></gloss>
      <gloss lang="en"><text>grass ; grass, plant, vegetation</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.1.11; Keita 1979, p. 139: Billo</text></form></note>
  </entry>
  <entry id="bingi_77">
    <lexical-unit><form lang="kqs"><text>bingi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bingi_77_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>court ; (telen bingi) un peu de temps</text></gloss>
      <gloss lang="en"><text>short; (telen bingi) a short while</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>short; also little, small</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.12.10; Childs 2000, p. 18: bìŋì</text></form></note>
  </entry>
  <entry id="bingulanndo_78">
    <lexical-unit><form lang="kqs"><text>bingulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bingulan</text></form></variant>
    <sense id="bingulanndo_78_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se mélanger, être mêlé</text></gloss>
      <gloss lang="en"><text>be mixed</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.23.30</text></form></note>
  </entry>
  <entry id="binɔnndo_79">
    <lexical-unit><form lang="kqs"><text>binɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="binɔnndo_79_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entretenir (propriété)</text></gloss>
      <gloss lang="en"><text>keep, maintain (property)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Binönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de biyɔɔ ; sens à préciser.</text></form></note>
  </entry>
  <entry id="biondɔnndo_80">
    <lexical-unit><form lang="kqs"><text>biondɔnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>biondɔnndan</text></form></field>
    <variant><form lang="kqs"><text>biondɔn</text></form></variant>
    <variant><form lang="kqs"><text>biondɔnnda</text></form></variant>
    <sense id="biondɔnndo_80_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faute, erreur, péché involontaire</text></gloss>
      <gloss lang="en"><text>fault, error, unintentional sin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) make a mistake, miss (oneself)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.18.1; Childs 2000, p. 19: bìòndɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="biwnun_81">
    <lexical-unit><form lang="kqs"><text>biwnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biuvɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>biuvɔn</text></form></variant>
    <sense id="biwnun_81_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supporter, endurer ; patienter</text></gloss>
      <gloss lang="en"><text>bear, endure; be patient</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first NEH.9.17</text></form></note>
  </entry>
  <entry id="biwvo_82">
    <lexical-unit><form lang="kqs"><text>biwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biw</text></form></variant>
    <variant><form lang="kqs"><text>biwnin</text></form></variant>
    <sense id="biwvo_82_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre, saisir, emmener ; rassembler (butin, argent) ; (biw vanalanɔɔ) se fiancer</text></gloss>
      <gloss lang="en"><text>take, seize, carry off; collect (spoil, money); (biw vanalanɔɔ) become engaged</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of 'hold': take from several places; keep for someone over time, e.g. a girl for later marriage</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JER.9.20; Childs 2000, p. 20: bìùwó</text></form></note>
  </entry>
  <entry id="biyanndo_83">
    <lexical-unit><form lang="kqs"><text>biyanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="biyanndo_83_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attraper, se saisir l'un l'autre</text></gloss>
      <gloss lang="en"><text>seize each other, grapple</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Biyanndo</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : biyan « se battre, se saisir » (DEU 25,11), biyannin (ZEC 14,13).</text></form></note>
  </entry>
  <entry id="biyɔɔ_84">
    <lexical-unit><form lang="kqs"><text>biyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bii</text></form></variant>
    <variant><form lang="kqs"><text>bil</text></form></variant>
    <sense id="biyɔɔ_84_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attraper, saisir, tenir</text></gloss>
      <gloss lang="en"><text>catch, seize, hold</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take, seize, capture; have; begin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 740 occurrences, first GEN.1.15; Keita 1979, p. 110: Biyöö; Childs 2000, p. 20: bìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>bil : « porter (de la semence), tenir » (GEN 1,29).</text></form></note>
  </entry>
  <entry id="biŋinndo_85">
    <lexical-unit><form lang="kqs"><text>biŋinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biŋin</text></form></variant>
    <sense id="biŋinndo_85_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bouger, chanceler, être ébranlé ; (pulei biŋin X) être prise par les douleurs de l'accouchement</text></gloss>
      <gloss lang="en"><text>move, waver, be shaken; (pulei biŋin X) go into labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.66.8</text></form></note>
  </entry>
  <entry id="biɔmnɔnndo_86">
    <lexical-unit><form lang="kqs"><text>biɔmnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="biɔmnɔnndo_86_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se blottir, s'accroupir</text></gloss>
      <gloss lang="en"><text>crouch, huddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Biömnönndo</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : biɔmnun « il s'est accroupi » (GEN 49,9).</text></form></note>
  </entry>
  <entry id="biɔŋɔɔ_87">
    <lexical-unit><form lang="kqs"><text>biɔŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="biɔŋɔɔ_87_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cligner des yeux ; clin d'œil</text></gloss>
      <gloss lang="en"><text>blink; blink of an eye</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sting; blink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.4.20; Keita 1979, p. 116: Biönhöö; Childs 2000, p. 19: bìɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>o biɔŋɔɔ lepilɔɔ « en un clin d'œil » (JER 4,20).</text></form></note>
  </entry>
  <entry id="bobonɔɔ_88">
    <lexical-unit><form lang="kqs"><text>bobonɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>boboa</text></form></field>
    <sense id="bobonɔɔ_88_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>muet</text></gloss>
      <gloss lang="en"><text>mute person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deaf-mute person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.4.11; Keita 1979, p. 161: Bobönöö; Childs 2000, p. 21: bóbónɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit Bobönöö ; la Bible a bobonɔɔ, pl. boboa.</text></form></note>
  </entry>
  <entry id="bokio_89">
    <lexical-unit><form lang="kqs"><text>bokio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bokio_89_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écuelle</text></gloss>
      <gloss lang="en"><text>bowl</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Bokio</text></form></note>
  </entry>
  <entry id="bolinndo_90">
    <lexical-unit><form lang="kqs"><text>bolinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bolin</text></form></variant>
    <sense id="bolinndo_90_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>blessure</text></gloss>
      <gloss lang="en"><text>wound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Bolinndo</text></form></note>
    <note><form lang="fr"><text>Forme radicale bolin attestée (Gn 4,23 ; 1R 22,35).</text></form></note>
  </entry>
  <entry id="bolinndo_91">
    <lexical-unit><form lang="kqs"><text>bolinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bolinndo_91_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se blesser</text></gloss>
      <gloss lang="en"><text>hurt oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bolinndo</text></form></note>
    <note><form lang="fr"><text>Moyen de bolio.</text></form></note>
  </entry>
  <entry id="bolio_92">
    <lexical-unit><form lang="kqs"><text>bolio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bolio_92_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>blesser</text></gloss>
      <gloss lang="en"><text>wound, injure</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bolio; Childs 2000, p. 21: bòlìó</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : boli (EXO 21,25), bolin (GEN 4,23).</text></form></note>
  </entry>
  <entry id="bolle sɛllo_93">
    <lexical-unit><form lang="kqs"><text>bolle sɛllo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bolle sɛllo_93_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>imam</text></gloss>
      <gloss lang="en"><text>imam</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Bolle</text></form></note>
    <note><form lang="fr"><text>Keita écrit Bolle et Sèllo sur deux lignes, tous deux glosés « l'imam » : sans doute « chef (bolle) de la prière (sɛllo) », cf. Yondanɔɔ sɛllo « muezzin ». Dans la Bible, bolle « chef, tête » est attesté, mais sɛ̀llo y signifie « poix » (Ex 2,3).</text></form></note>
  </entry>
  <entry id="bollen_94">
    <lexical-unit><form lang="kqs"><text>bollen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bóltan</text></form></field>
    <variant><form lang="kqs"><text>bolle</text></form></variant>
    <sense id="bollen_94_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tête ; sommet</text></gloss>
      <gloss lang="en"><text>head; top</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>head; point, tip, edge, top</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 274 occurrences, first GEN.3.15; Keita 1979, p. 131: Bollen; Childs 2000, p. 21: bòlléŋ</text></form></note>
  </entry>
  <entry id="bolofaa_95">
    <lexical-unit><form lang="kqs"><text>bolofaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bolofaa_95_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>richesse(s)</text></gloss>
      <gloss lang="en"><text>wealth, riches</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 373 occurrences, first GEN.13.2</text></form></note>
  </entry>
  <entry id="bololan_96">
    <lexical-unit><form lang="kqs"><text>bololan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bolola</text></form></variant>
    <sense id="bololan_96_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cou, gorge ; (kialu … bololan) égorger</text></gloss>
      <gloss lang="en"><text>neck, throat; (kialu … bololan) slaughter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.22.10</text></form></note>
  </entry>
  <entry id="bololen_97">
    <lexical-unit><form lang="kqs"><text>bololen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="bololen_97_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gorge</text></gloss>
      <gloss lang="en"><text>throat</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.2.25; Keita 1979, p. 131: Bololen</text></form></note>
  </entry>
  <entry id="boloo_98">
    <lexical-unit><form lang="kqs"><text>boloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bolo</text></form></variant>
    <sense id="boloo_98_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>navette (de tisserand)</text></gloss>
      <gloss lang="en"><text>weaver's shuttle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>weaver's shuttle; anything of similar shape</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Boloo; Childs 2000, p. 22: bólóó</text></form></note>
    <note><form lang="fr"><text>Forme radicale bolo dans la Bible (Jb 7,6).</text></form></note>
  </entry>
  <entry id="bólta_99">
    <lexical-unit><form lang="kqs"><text>bólta</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bólta_99_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vallées, ravins</text></gloss>
      <gloss lang="en"><text>valleys, ravines</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>valley, base of a steep hill (singular bŏlló)</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 21: bŏlló</text></form></note>
    <note><form lang="fr"><text>Forme radicale d'un pluriel en -lan (o bólta lan nin, Dt 2,36) ; la forme pleine se confondrait avec bóltan « têtes » (pluriel de bollen). Singulier non relevé.</text></form></note>
  </entry>
  <entry id="bombo_100">
    <lexical-unit><form lang="kqs"><text>bombo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bombola</text></form></variant>
    <sense id="bombo_100_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plat, plaque ; (bombola kɔandaa) pelles à cendres</text></gloss>
      <gloss lang="en"><text>pan, plate; (bombola kɔandaa) ash shovels</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 2KI.25.15</text></form></note>
    <note><form lang="fr"><text>bombo icilinndo « plaque de fer » (Ez 4,3). À distinguer de l'idéophone bómbò (ɲum bómbò « disparaître », Ps 37,20).</text></form></note>
  </entry>
  <entry id="bombosoo_101">
    <lexical-unit><form lang="kqs"><text>bombosoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bombosoo_101_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variole</text></gloss>
      <gloss lang="en"><text>smallpox</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Bombosoo; Childs 2000, p. 22: bòmbòósòó</text></form></note>
  </entry>
  <entry id="bomndo_102">
    <lexical-unit><form lang="kqs"><text>bomndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bomndo_102_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oncle</text></gloss>
      <gloss lang="en"><text>uncle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>maternal uncle (mother's brother)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bomndo; Childs 2000, p. 22: bòmndó</text></form></note>
  </entry>
  <entry id="bondokpaa_103">
    <lexical-unit><form lang="kqs"><text>bondokpaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bondokpaa_103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hémorroïdes, tumeurs</text></gloss>
      <gloss lang="en"><text>haemorrhoids, tumours</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.5.6; Keita 1979, p. 161: Bondokpaa</text></form></note>
  </entry>
  <entry id="bondomaa_104">
    <lexical-unit><form lang="kqs"><text>bondomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bondomalan</text></form></field>
    <variant><form lang="kqs"><text>bondomala</text></form></variant>
    <sense id="bondomaa_104_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>harpe, lyre</text></gloss>
      <gloss lang="en"><text>harp, lyre</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first PSA.33.2</text></form></note>
    <note><form lang="fr"><text>Cf. bondomanɔɔ « joueur de harpe ».</text></form></note>
  </entry>
  <entry id="bondomanɔɔ_105">
    <lexical-unit><form lang="kqs"><text>bondomanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bondomanɔɔ_105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joueur de guitare, de harpe</text></gloss>
      <gloss lang="en"><text>guitar or harp player</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Bondomanöö</text></form></note>
    <note><form lang="fr"><text>bondomaa « harpe, lyre » est attesté (Ps 33,2).</text></form></note>
  </entry>
  <entry id="bonyii_106">
    <lexical-unit><form lang="kqs"><text>bonyii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bonyun</text></form></field>
    <sense id="bonyii_106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jarre, cruche, récipient</text></gloss>
      <gloss lang="en"><text>jar, pitcher, vessel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.24.14</text></form></note>
  </entry>
  <entry id="boo_107">
    <lexical-unit><form lang="kqs"><text>boo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="boo_107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coque, écorce, peau de fruit ; fourreau</text></gloss>
      <gloss lang="en"><text>shell, bark, peel; sheath</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first JOS.5.13; Keita 1979, p. 139: Boo; Childs 2000, p. 23: bòó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, le fourreau de l'épée (1SA.17.51, 1CH.21.27).</text></form></note>
  </entry>
  <entry id="boo tɛɛngaa_108">
    <lexical-unit><form lang="kqs"><text>boo tɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="boo tɛɛngaa_108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagaie</text></gloss>
      <gloss lang="en"><text>paddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Boo tèèngaa</text></form></note>
    <note><form lang="fr"><text>tɛɛngaa « ramer » est attesté (vanaa tɛɛngaa ladɛ̀ndɛ̀a « les rameurs », Ez 27,8) ; dans la Bible, boo signifie « fourreau » (1 S 17,51).</text></form></note>
  </entry>
  <entry id="booluu_109">
    <lexical-unit><form lang="kqs"><text>booluu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="booluu_109_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>blesser, frapper (à plusieurs reprises) ; inciser (le corps)</text></gloss>
      <gloss lang="en"><text>wound, strike (repeatedly); cut (the body)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first LEV.19.28; Childs 2000, p. 23: bòòlùùwó</text></form></note>
    <note><form lang="fr"><text>Dérivé intensif de bolio « blesser ».</text></form></note>
  </entry>
  <entry id="boolɔnndo_110">
    <lexical-unit><form lang="kqs"><text>boolɔnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>boolɔnndan</text></form></field>
    <variant><form lang="kqs"><text>boolɔnnda</text></form></variant>
    <sense id="boolɔnndo_110_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>blessure, plaie</text></gloss>
      <gloss lang="en"><text>wound, sore</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1KI.18.28; Childs 2000, p. 23: bòòlɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="boondei_111">
    <lexical-unit><form lang="kqs"><text>boondei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="check"/>
    <field type="plural"><form lang="kqs"><text>boondon</text></form></field>
    <variant><form lang="kqs"><text>boondii</text></form></variant>
    <variant><form lang="kqs"><text>boondun</text></form></variant>
    <sense id="boondei_111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>articulation, jointure ; gond ; bouton (du chandelier) ; moment, époque</text></gloss>
      <gloss lang="en"><text>joint, socket; hinge; knob (of the lampstand); time, season</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>joint, knuckle, ankle</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 23: bòòndéí</text></form></note>
    <note><form lang="fr"><text>boondii ken « en ce temps-là » (Gn 6,4) ; a boondei he ɲinasiaŋ « l'an prochain à cette époque » (Gn 18,10) ; boondon « boutons » du chandelier (Ex 25,31).</text></form></note>
  </entry>
  <entry id="bosio_112">
    <lexical-unit><form lang="kqs"><text>bosio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bosi</text></form></variant>
    <variant><form lang="kqs"><text>bosilan</text></form></variant>
    <sense id="bosio_112_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>testicules (vana nda tɛnda bosio « eunuque »)</text></gloss>
      <gloss lang="en"><text>testicles (vana nda tɛnda bosio 'eunuch')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.21.20; Childs 2000, p. 24: bòsìóó</text></form></note>
  </entry>
  <entry id="boŋaa_113">
    <lexical-unit><form lang="kqs"><text>boŋaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>boŋnin</text></form></variant>
    <sense id="boŋaa_113_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire trébucher ; piège ; talocher (Keita)</text></gloss>
      <gloss lang="en"><text>make stumble; snare; slap (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>trip, stumble, stub one's toe; knock, strike</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bonhaa; Childs 2000, p. 23: bòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, pow boŋaa « pierre d'achoppement, piège » (JDG 2,3 ; ISA 8,14) et boŋnin « (ne) trébuchera (pas) » (PSA 62,3). Le sens « talocher » de Keita correspond au bɔ̀ŋàá « frapper » de Childs (p. 22).</text></form></note>
  </entry>
  <entry id="bukuloo_114">
    <lexical-unit><form lang="kqs"><text>bukuloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bukuloo_114_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mai</text></gloss>
      <gloss lang="en"><text>May</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around May or June</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Bukuloo; Childs 2000, p. 31: búkúlɔ́ɔ</text></form></note>
  </entry>
  <entry id="buloo_115">
    <lexical-unit><form lang="kqs"><text>buloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bululan</text></form></field>
    <variant><form lang="kqs"><text>bulu</text></form></variant>
    <variant><form lang="kqs"><text>bulula</text></form></variant>
    <sense id="buloo_115_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain</text></gloss>
      <gloss lang="en"><text>bread</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 111 occurrences, first GEN.14.18</text></form></note>
  </entry>
  <entry id="bulu yekpandio_116">
    <lexical-unit><form lang="kqs"><text>bulu yekpandio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bulu yekpandio_116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canon de fusil</text></gloss>
      <gloss lang="en"><text>gun barrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Bulu yekpandio</text></form></note>
  </entry>
  <entry id="bumba_117">
    <lexical-unit><form lang="kqs"><text>bumba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bumbanin</text></form></variant>
    <sense id="bumba_117_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échouer, ne pas réussir à ; perdre (une bataille) ; manquer</text></gloss>
      <gloss lang="en"><text>fail, be unable to; lose (a battle); miss</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first DEU.2.36; Childs 2000, p. 32: bùmbàá</text></form></note>
  </entry>
  <entry id="bundɔɔ_118">
    <lexical-unit><form lang="kqs"><text>bundɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɛlan</text></form></field>
    <variant><form lang="kqs"><text>bundɛ</text></form></variant>
    <variant><form lang="kqs"><text>bundɛla</text></form></variant>
    <sense id="bundɔɔ_118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forêt, bois</text></gloss>
      <gloss lang="en"><text>forest, wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moist semi-deciduous forest, gallery or riverside forest, jungle, woods</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first DEU.14.16; Childs 2000, p. 33: bùndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale bundɛ : o bundɛ kon nin « dans cette forêt » (1 S 14,26) ; yɔmii bundɛi « les arbres de la forêt » (Ez 15,6). Cf. bundɛcieo « clairière ».</text></form></note>
  </entry>
  <entry id="bundɛcieo_119">
    <lexical-unit><form lang="kqs"><text>bundɛcieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bundɛcieo_119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clairière</text></gloss>
      <gloss lang="en"><text>clearing</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Bundètyieo</text></form></note>
  </entry>
  <entry id="bundɛi_120">
    <lexical-unit><form lang="kqs"><text>bundɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bundɔn</text></form></field>
    <sense id="bundɛi_120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parabole, énigme ; (pl.) fables</text></gloss>
      <gloss lang="en"><text>parable, riddle; (pl.) fables, myths</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>story, tale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EZK.15.6; Childs 2000, p. 32: búndèí</text></form></note>
    <note><form lang="fr"><text>À distinguer de yɔmii bundɛi « les arbres de la forêt » (Ez 15,6), de bundɔɔ « forêt ».</text></form></note>
  </entry>
  <entry id="bungɛi_121">
    <lexical-unit><form lang="kqs"><text>bungɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bungan</text></form></field>
    <sense id="bungɛi_121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>part, morceau, portion ; lobe (du foie)</text></gloss>
      <gloss lang="en"><text>part, piece, portion; lobe (of the liver)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>area, section, plot, portion; also promise, vow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 103 occurrences, first EXO.29.13; Childs 2000, p. 33: bùŋèí</text></form></note>
    <note><form lang="fr"><text>bungɛi hiow naŋɔɔ o yemnde « le lobe du foie » (Ex 29,13).</text></form></note>
  </entry>
  <entry id="buo_122">
    <lexical-unit><form lang="kqs"><text>buo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buo_122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>largeur</text></gloss>
      <gloss lang="en"><text>width</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 96 occurrences, first GEN.6.15</text></form></note>
  </entry>
  <entry id="busa_123">
    <lexical-unit><form lang="kqs"><text>busa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>busanin</text></form></variant>
    <sense id="busa_123_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir, frayer (un chemin)</text></gloss>
      <gloss lang="en"><text>open up, make (a way)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.38.25</text></form></note>
  </entry>
  <entry id="buubuuon_124">
    <lexical-unit><form lang="kqs"><text>buubuuon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="buubuuon_124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collines</text></gloss>
      <gloss lang="en"><text>hills</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a mound</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first PSA.114.4; Childs 2000, p. 34: búúbúúwé</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="buukuo_125">
    <lexical-unit><form lang="kqs"><text>buukuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>buukulan</text></form></field>
    <variant><form lang="kqs"><text>buuku</text></form></variant>
    <sense id="buukuo_125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sabot</text></gloss>
      <gloss lang="en"><text>hoof</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Buukuo; Childs 2000, p. 34: bùùkɔ̀ɔ̀</text></form></note>
    <note><form lang="fr"><text>La Bible a la forme radicale buuku (LEV.11.3) et le pluriel buukulan (PSA.69.32).</text></form></note>
  </entry>
  <entry id="buulanndo_126">
    <lexical-unit><form lang="kqs"><text>buulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buulan</text></form></variant>
    <sense id="buulanndo_126_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chercher, rechercher ; consulter</text></gloss>
      <gloss lang="en"><text>seek, look for; consult</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.32.12</text></form></note>
  </entry>
  <entry id="buululan_127">
    <lexical-unit><form lang="kqs"><text>buululan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buulula</text></form></variant>
    <sense id="buululan_127_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grotte, caverne</text></gloss>
      <gloss lang="en"><text>cave</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hole, cave (used by crocodiles and ground hogs); singular bùùlòó, plural bùùlùláŋ</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first GEN.19.30; Childs 2000, p. 34: bùùlòó</text></form></note>
    <note><form lang="fr"><text>Forme en -lan employée aussi pour une seule grotte (buulula ndɔla, Gn 23,9).</text></form></note>
  </entry>
  <entry id="buuluuo_128">
    <lexical-unit><form lang="kqs"><text>buuluuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>buuluu</text></form></variant>
    <variant><form lang="kqs"><text>buuluunin</text></form></variant>
    <sense id="buuluuo_128_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>percer, trouer ; ouvrir une brèche</text></gloss>
      <gloss lang="en"><text>pierce, bore; break through</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2CH.32.1; Childs 2000, p. 34: bùùlùùwó</text></form></note>
  </entry>
  <entry id="buɛiyo_129">
    <lexical-unit><form lang="kqs"><text>buɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>buɛyaa</text></form></field>
    <variant><form lang="kqs"><text>buɛi</text></form></variant>
    <sense id="buɛiyo_129_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serviteur, jeune homme</text></gloss>
      <gloss lang="en"><text>servant, young man</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>servant; also apprentice, learner</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first 1SA.9.8; Childs 2000, p. 31: bùɛ́íyó</text></form></note>
  </entry>
  <entry id="bɔgaa_130">
    <lexical-unit><form lang="kqs"><text>bɔgaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔgaa_130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jaunisse</text></gloss>
      <gloss lang="en"><text>jaundice</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Bögaa</text></form></note>
  </entry>
  <entry id="bɔlaa_131">
    <lexical-unit><form lang="kqs"><text>bɔlaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔlaa_131_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-frère, belle-sœur</text></gloss>
      <gloss lang="en"><text>brother-in-law, sister-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a man's brother's wife, a woman's brother-in-law; joking relative</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bölaa; Childs 2000, p. 25: bɔ̀làá</text></form></note>
  </entry>
  <entry id="bɔ̀linndan_132">
    <lexical-unit><form lang="kqs"><text>bɔ̀linndan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɔ̀linndan_132_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sistres, hochets (instruments à percussion)</text></gloss>
      <gloss lang="en"><text>sistrums, rattles (percussion instruments)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
  </entry>
  <entry id="bɔlɔ_133">
    <lexical-unit><form lang="kqs"><text>bɔlɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɔlɔlan</text></form></field>
    <variant><form lang="kqs"><text>bɔlɔla</text></form></variant>
    <sense id="bɔlɔ_133_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sac, outre ; carquois</text></gloss>
      <gloss lang="en"><text>bag, skin bottle; quiver</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.21.14</text></form></note>
  </entry>
  <entry id="bɔlɔ n'cilinndo_134">
    <lexical-unit><form lang="kqs"><text>bɔlɔ n'cilinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ n'cilinndo_134_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cartouchière</text></gloss>
      <gloss lang="en"><text>cartridge pouch</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Bölö ntyilinndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel : bɔlɔ « sac » et n'cilinndo « en fer » (Ez 19,9). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="bɔlɔ tumndo_135">
    <lexical-unit><form lang="kqs"><text>bɔlɔ tumndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔ tumndo_135_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bananier</text></gloss>
      <gloss lang="en"><text>banana plant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>banana, banana tree</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölö Tumndo; Childs 2000, p. 27: bɔ́lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Voir bɔlɔɔ.</text></form></note>
  </entry>
  <entry id="bɔlɔan_136">
    <lexical-unit><form lang="kqs"><text>bɔlɔan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔan_136_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme extrait du tronc</text></gloss>
      <gloss lang="en"><text>palm wine tapped from the trunk</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölöan</text></form></note>
  </entry>
  <entry id="bɔlɔɔ_137">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɔlɔlan</text></form></field>
    <sense id="bɔlɔɔ_137_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sac</text></gloss>
      <gloss lang="en"><text>bag, sack</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.42.27; Keita 1979, p. 159: Bölöö; Childs 2000, p. 26: bɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔlɔɔ_138">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔɔ_138_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>banane</text></gloss>
      <gloss lang="en"><text>banana</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>banana, banana tree</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bölöö; Childs 2000, p. 27: bɔ́lɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, bɔlɔɔ est un homonyme « sac » (GEN.42.27, 1SA.1.24).</text></form></note>
  </entry>
  <entry id="bɔlɔɔn_139">
    <lexical-unit><form lang="kqs"><text>bɔlɔɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɔlɔɔn_139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chapelet</text></gloss>
      <gloss lang="en"><text>prayer beads</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Bölöön</text></form></note>
  </entry>
  <entry id="bɔmbɔniyo_140">
