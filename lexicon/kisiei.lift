      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 575 occurrences, first GEN.27.42; Childs 2000, p. 381: wàŋndó</text></form></note>
