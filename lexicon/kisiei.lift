    <trait name="status" value="southern"/>
    <sense id="dúfìɛ̀_725_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mou, moelleux (éponge, lit)</text></gloss>
      <gloss lang="en"><text>soft, squishy (sponge, bed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dúfìɛ̀</text></form></note>
  </entry>
  <entry id="dùkúdùkú-sèndíó_726">
    <lexical-unit><form lang="kqs"><text>dùkúdùkú-sèndíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dùkúdùkú-sèndíó_726_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'oiseau (des bas-fonds)</text></gloss>
      <gloss lang="en"><text>kind of bird (lives in swamps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dùkúdùkú-sèndíó</text></form></note>
  </entry>
  <entry id="dúkúdúkùlan_727">
    <lexical-unit><form lang="kqs"><text>dúkúdúkùlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dúkúdúkùla</text></form></variant>
    <sense id="dúkúdúkùlan_727_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collines, buttes, bosses (du terrain)</text></gloss>
      <gloss lang="en"><text>hills, humps, rounded heights</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) stout, stocky, short and round</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.68.16; Childs 2000, p. 90: dùkúlú</text></form></note>
    <note><form lang="fr"><text>Pluriel. Pembii nɔ dúkúdúkùlan « montagne aux nombreux sommets » (PSA.68.16).</text></form></note>
  </entry>
  <entry id="dulunndo_728">
    <lexical-unit><form lang="kqs"><text>dulunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dulunndo_728_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coude</text></gloss>
      <gloss lang="en"><text>elbow</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Dulunndo; Childs 2000, p. 91: dùŋndó</text></form></note>
  </entry>
  <entry id="dúmbú_729">
    <lexical-unit><form lang="kqs"><text>dúmbú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dúmbú_729_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trahison ; (yii … dúmbú) trahir, tromper</text></gloss>
      <gloss lang="en"><text>treachery; (yii … dúmbú) betray, deceive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.21.23</text></form></note>
  </entry>
  <entry id="dumbu kilitia_730">
    <lexical-unit><form lang="kqs"><text>dumbu kilitia</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dumbu kilitia_730_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>religion chrétienne (Keita)</text></gloss>
      <gloss lang="en"><text>Christian religion (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Dumbu kilitia</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, dúmbú signifie « tromperie, ruse » (Gn 27,36) ; forme et sens à confirmer.</text></form></note>
  </entry>
  <entry id="dùmbúéí_731">
    <lexical-unit><form lang="kqs"><text>dùmbúéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dùmbǒŋ</text></form></field>
    <sense id="dùmbúéí_731_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jarre en terre pour conserver viande ou huile</text></gloss>
      <gloss lang="en"><text>clay pot for storing meat or oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dùmbúéí</text></form></note>
  </entry>
  <entry id="dumbulen_732">
    <lexical-unit><form lang="kqs"><text>dumbulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dumbon</text></form></field>
    <variant><form lang="kqs"><text>dumbule</text></form></variant>
    <variant><form lang="kqs"><text>dumbun</text></form></variant>
    <sense id="dumbulen_732_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racine ; souche</text></gloss>
      <gloss lang="en"><text>root; stock</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>buttress or stilt roots, roots standing above the ground</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.14.30; Childs 2000, p. 90: dùmbùéí</text></form></note>
    <note><form lang="fr"><text>dumbule ndɔlen le vesa « leur racine est desséchée » (HOS.9.16) ; mó soli dumbon « elle poussa des racines » (PSA.80.10) ; o dumbun ndɔn « de ses racines » (ISA.11.1).</text></form></note>
  </entry>
  <entry id="dundoo_733">
    <lexical-unit><form lang="kqs"><text>dundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dundulan</text></form></field>
    <sense id="dundoo_733_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour, tambourin</text></gloss>
      <gloss lang="en"><text>drum, tambourine</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>big round drum, bass drum</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.15.20; Keita 1979, p. 163: Dunduo; Childs 2000, p. 91: dùndòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Dunduo ; la Bible écrit dundoo.</text></form></note>
  </entry>
  <entry id="dùndúsɔ̀ɔ́_734">
    <lexical-unit><form lang="kqs"><text>dùndúsɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dùndúsɔ̀ɔ́wá</text></form></field>
    <sense id="dùndúsɔ̀ɔ́_734_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit crapaud brun à dos rugueux (qui se gonfle)</text></gloss>
      <gloss lang="en"><text>small brown rough-backed toad (puffs up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 91: dùndúsɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="duniaa_735">
    <lexical-unit><form lang="kqs"><text>duniaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="duniaa_735_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>humanité ; monde</text></gloss>
      <gloss lang="en"><text>humanity; world</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Duniaa</text></form></note>
