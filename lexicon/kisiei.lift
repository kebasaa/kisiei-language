  <entry id="masalen_3412">
    <lexical-unit><form lang="kqs"><text>masalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masale</text></form></variant>
    <sense id="masalen_3412_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>royaume, règne, royauté ; chefferie</text></gloss>
      <gloss lang="en"><text>kingdom, reign, kingship; chieftaincy</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chieftaincy, rule</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 482 occurrences, first GEN.1.28; Terminologie (histoire), n° 90: Masalen, masaa; Childs 2000, p. 243: màsàlɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>De masaa « roi ». Académie des langues (terminologie, histoire n° 90) : masalen (aussi masaa) « autorité ». Aussi Terminologie, p. 151 : « Masalen ». Académie des langues (terminologie, histoire n° 522) : masalen sullo « règne ». Académie des langues (terminologie, idéologie n° 558) : « régime ».</text></form></note>
  </entry>
