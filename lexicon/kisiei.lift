    <trait name="status" value="respelled"/>
    <sense id="soli makoo_4685_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fonctionnel</text></gloss>
      <gloss lang="en"><text>functional</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 188: Soli makoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="solidenndo_4686">
    <lexical-unit><form lang="kqs"><text>solidenndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="solidenndo_4686_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>révélateur</text></gloss>
      <gloss lang="en"><text>developer (photo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 220: Solidenndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Révéler » : solioo den (arts n° 222).</text></form></note>
