  <entry id="o_2936">
    <lexical-unit><form lang="kqs"><text>o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o_2936_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>il, elle (sujet, classe o)</text></gloss>
      <gloss lang="en"><text>he, she, it (subject, o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 58042 occurrences, first GEN.1.1; Lexique kissi–français, p. 40: o; Childs 2000, p. 284: ò</text></form></note>
  </entry>
  <entry id="o_2937">
    <lexical-unit><form lang="kqs"><text>o</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o_2937_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>à, dans, sur (lieu, temps) ; de ; devant</text></gloss>
      <gloss lang="en"><text>at, in, on (place, time); from; in front of</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'to, from, against, near'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58042 occurrences, first GEN.1.1; Lexique kissi–français, p. 40: o; Childs 2000, p. 284: ó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 40 : o « de », « dans », « devant ».</text></form></note>
  </entry>
  <entry id="o co le_2938">
    <lexical-unit><form lang="kqs"><text>o co le</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o co le_2938_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ce n'est pas ; n'est-ce pas ?</text></gloss>
      <gloss lang="en"><text>it is not; isn't it?</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: o co re</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit o co re (r pour l).</text></form></note>
  </entry>
  <entry id="o cueo_2939">
    <lexical-unit><form lang="kqs"><text>o cueo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="o cueo_2939_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point</text></gloss>
      <gloss lang="en"><text>point, dot (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: o cueo</text></form></note>
    <note><form lang="fr"><text>Sens précis non donné par le Lexique (comparer pɔntie « point »).</text></form></note>
  </entry>
  <entry id="o kon kɔɔli_2940">
    <lexical-unit><form lang="kqs"><text>o kon kɔɔli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="o kon kɔɔli_2940_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>après cela, ensuite, puis</text></gloss>
      <gloss lang="en"><text>after that, then, afterwards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in addition, moreover, besides</text></form></field>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: o kon kɔɔli; Childs 2000, p. 285: ó kɔ́ŋ kɔ́ɔ́lì</text></form></note>
    <note><form lang="fr"><text>Litt. « derrière cela » : o … kɔɔli « derrière, après » et kon « cela ». O kon kɔɔli, mí Mɛlɛka Hala soli nakɔɔ … « ensuite le Seigneur Dieu planta un jardin … » (GEN.2.8). Très fréquent en début de phrase.</text></form></note>
  </entry>
  <entry id="oi_2941">
    <lexical-unit><form lang="kqs"><text>oi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="oi_2941_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>oui</text></gloss>
      <gloss lang="en"><text>yes</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.24.58</text></form></note>
  </entry>
  <entry id="oliviee_2942">
    <lexical-unit><form lang="kqs"><text>oliviee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>oliviei</text></form></variant>
    <sense id="oliviee_2942_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>olivier, olive</text></gloss>
      <gloss lang="en"><text>olive tree, olive</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.8.11</text></form></note>
  </entry>
  <entry id="onikse_2943">
    <lexical-unit><form lang="kqs"><text>onikse</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="onikse_2943_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>onyx</text></gloss>
      <gloss lang="en"><text>onyx</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.2.12</text></form></note>
    <note><form lang="fr"><text>Emprunt ; pow onikse « pierre d'onyx ».</text></form></note>
  </entry>
  <entry id="oo_2944">
    <lexical-unit><form lang="kqs"><text>oo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="oo_2944_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>chaque, tout (entre deux noms répétés : X oo X)</text></gloss>
      <gloss lang="en"><text>every, any (between a repeated noun: X oo X)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 819 occurrences, first GEN.1.29; Childs 2000, p. 284: -ó-</text></form></note>
  </entry>
  <entry id="pá_2945">
    <lexical-unit><form lang="kqs"><text>pá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pá_2945_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>du tout, jamais, encore (dans les questions) ; (lɔ́ɔ́ pá) avant que</text></gloss>
      <gloss lang="en"><text>at all, ever, still (in questions); (lɔ́ɔ́ pá) before</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ever, at all; long ago, for a long time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 385 occurrences, first GEN.3.19; Lexique kissi–français, p. 40: pa; Childs 2000, p. 286: pá</text></form></note>
    <note><form lang="fr"><text>Ɲɛ kɛndɔɔ nɔla pá fulaa Nasarɛt? « Peut-il sortir quelque chose de bon de Nazareth ? » (JHN.1.46) ; lɔ́ɔ́ pá mi Abraham fula « avant qu'Abraham fût » (JHN.8.58).</text></form></note>
  </entry>
  <entry id="pâ_2946">
    <lexical-unit><form lang="kqs"><text>pâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pâ_2946_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>ploc (liquide qui tombe goutte à goutte)</text></gloss>
      <gloss lang="en"><text>plop (liquid dripping onto a flat surface)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 286: pâ</text></form></note>
  </entry>
  <entry id="pá-pá_2947">
    <lexical-unit><form lang="kqs"><text>pá-pá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pá-pá_2947_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'eau qui goutte</text></gloss>
      <gloss lang="en"><text>sound of water dripping</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pá-pá</text></form></note>
  </entry>
  <entry id="paa_2948">
    <lexical-unit><form lang="kqs"><text>paa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>paalan</text></form></field>
    <sense id="paa_2948_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>os</text></gloss>
      <gloss lang="en"><text>bone</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bone; also gambling tops</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.2.23; Keita 1979, p. 132: Paa; Lexique kissi–français, p. 40: paa; Childs 2000, p. 286: pàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 40 : aussi « le bouton ».</text></form></note>
  </entry>
  <entry id="paa congu tumndo_2949">
    <lexical-unit><form lang="kqs"><text>paa congu tumndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paa congu tumndo_2949_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>omoplate</text></gloss>
      <gloss lang="en"><text>shoulder blade</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: paa congu tumndo</text></form></note>
    <note><form lang="fr"><text>paa « os », congú et tumndo sont dans la Bible séparément, pas l'expression.</text></form></note>
  </entry>
  <entry id="paa iyindo_2950">
    <lexical-unit><form lang="kqs"><text>paa iyindo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paa iyindo_2950_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peigne (de femme)</text></gloss>
      <gloss lang="en"><text>(woman's) comb</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: paa iyindo</text></form></note>
  </entry>
  <entry id="paa yomɛiyo_2951">
    <lexical-unit><form lang="kqs"><text>paa yomɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paa yomɛiyo_2951_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fracture</text></gloss>
      <gloss lang="en"><text>fracture</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: Paa Yomèiyo; Lexique kissi–français, p. 40: paa yomɛiyo</text></form></note>
    <note><form lang="fr"><text>yomɛiyo « cassé » est attesté (Lv 21,19). Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="pàà-tókpɔ̀ɔ́_2952">
    <lexical-unit><form lang="kqs"><text>pàà-tókpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pàà-tókpɔ̀ɔ́_2952_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (bois très dur)</text></gloss>
      <gloss lang="en"><text>a tree species (very hard wood)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pàà-tókpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="paale kalalen_2953">
    <lexical-unit><form lang="kqs"><text>paale kalalen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="paale kalalen_2953_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>midi ; soleil de midi</text></gloss>
      <gloss lang="en"><text>noon, midday sun</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 154: Paale kalalen; Lexique kissi–français, p. 41: palle kalalen</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 41 : aussi pallen o pol « midi ».</text></form></note>
  </entry>
  <entry id="paale siaalen_2954">
    <lexical-unit><form lang="kqs"><text>paale siaalen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="paale siaalen_2954_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point du jour, aube</text></gloss>
      <gloss lang="en"><text>daybreak, dawn</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: palle saalen; Childs 2000, p. 286: pààlé-síàléŋ</text></form></note>
    <note><form lang="fr"><text>De paalen « jour, soleil » et siɔu « se lever (le jour) ». A telen paale siaalen « à l'aube » (GEN.19.15) ; háá telen paale siaalen « jusqu'au lever du jour » (GEN.32.25).</text></form></note>
  </entry>
  <entry id="paale sɛlalen_2955">
    <lexical-unit><form lang="kqs"><text>paale sɛlalen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paale sɛlalen_2955_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>milieu de l'après-midi (vers 15-16 h)</text></gloss>
      <gloss lang="en"><text>mid-afternoon (about 3-4 pm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: palle sɛlalen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit palle ; la Bible écrit paale (paale kalalen « midi »).</text></form></note>
  </entry>
  <entry id="paale sɛllen_2956">
    <lexical-unit><form lang="kqs"><text>paale sɛllen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paale sɛllen_2956_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jour de fête, la fête</text></gloss>
      <gloss lang="en"><text>feast day, festival</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: palle sɛllen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit palle ; la Bible écrit paale.</text></form></note>
  </entry>
  <entry id="paalei i cɔllo_2957">
    <lexical-unit><form lang="kqs"><text>paalei i cɔllo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="paalei i cɔllo_2957_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>l'après-midi</text></gloss>
      <gloss lang="en"><text>afternoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: pallei i cɔllo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit pallei i cɔllo ; graphie et découpage à confirmer (la Bible dit yɔngannden « après-midi »).</text></form></note>
  </entry>
  <entry id="paalen_2958">
    <lexical-unit><form lang="kqs"><text>paalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="paalen_2958_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soleil ; jour</text></gloss>
      <gloss lang="en"><text>sun; day</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>day, sun; midday, noon, afternoon</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.14; Keita 1979, p. 154: Paalen; Lexique kissi–français, p. 40: paalen; Childs 2000, p. 286: pààléŋ</text></form></note>
    <note><form lang="fr"><text>Keita le donne aux p. 152 (le jour) et 154 (le soleil). Lexique kissi–français, p. 41 : aussi pallen « le soleil ; la journée ».</text></form></note>
  </entry>
  <entry id="paalenda_2959">
    <lexical-unit><form lang="kqs"><text>paalenda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>paalennda</text></form></variant>
    <variant><form lang="kqs"><text>paaleenda</text></form></variant>
    <variant><form lang="kqs"><text>paaleŋaa</text></form></variant>
    <sense id="paalenda_2959_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de criquets (pl.)</text></gloss>
      <gloss lang="en"><text>a kind of locusts (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>an edible locust-like insect living in the ground</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.11.22; Childs 2000, p. 286: páálèŋndó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. Cité avec sóónɔa « sauterelles » (LEV.11.22, PSA.105.34, JOL.1.4, JOL.2.25).</text></form></note>
  </entry>
  <entry id="paaliaa_2960">
    <lexical-unit><form lang="kqs"><text>paaliaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>paalia</text></form></variant>
    <sense id="paaliaa_2960_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déranger plusieurs fois</text></gloss>
      <gloss lang="en"><text>bother repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: paaliaa/ paalia</text></form></note>
    <note><form lang="fr"><text>Pluriel de palaa « déranger ».</text></form></note>
  </entry>
  <entry id="paamaa_2961">
    <lexical-unit><form lang="kqs"><text>paamaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="paamaa_2961_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe de femme</text></gloss>
      <gloss lang="en"><text>women's loincloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>loincloth of homespun thread, worn by women and children</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Paamaa; Lexique kissi–français, p. 40: paamaa; Childs 2000, p. 286: pààmàá</text></form></note>
  </entry>
  <entry id="paandoo_2962">
    <lexical-unit><form lang="kqs"><text>paandoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>paandua</text></form></variant>
    <variant><form lang="kqs"><text>paanduan</text></form></variant>
    <variant><form lang="kqs"><text>paanduei</text></form></variant>
    <variant><form lang="kqs"><text>paandulan</text></form></variant>
    <sense id="paandoo_2962_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>ancien, vieux, d'autrefois</text></gloss>
      <gloss lang="en"><text>old, former, ancient</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first 1CH.12.20; Lexique kissi–français, p. 41: panduo; Childs 2000, p. 286: pààndù-</text></form></note>
    <note><form lang="fr"><text>De paandu « autrefois ». o fonda ndɔ paandoo coo « à son ancien emplacement » (EZR.2.68) ; mɔima paanduan « le vin vieux » (LUK.5.39) ; vanacieeyɛi paanduei « le vieil homme » (EPH.4.22) ; naamula ndala paandulan « leurs anciennes coutumes » (2KI.17.34). Lexique kissi–français, p. 41 : panduo « les choses anciennes ou bien utilisées » ; aussi « un homme ».</text></form></note>
  </entry>
  <entry id="paandu_2963">
    <lexical-unit><form lang="kqs"><text>paandu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="paandu_2963_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>auparavant, autrefois, d'abord ; il y a longtemps</text></gloss>
      <gloss lang="en"><text>before, formerly, at first; long ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 245 occurrences, first GEN.13.3; Lexique kissi–français, p. 41: pandu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 41 écrit pandu.</text></form></note>
  </entry>
  <entry id="paandua_2964">
    <lexical-unit><form lang="kqs"><text>paandua</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="paandua_2964_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune garçon (?)</text></gloss>
      <gloss lang="en"><text>young boy (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: paandua</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, paandua est le pluriel de paandoo « ancien » (ISA.19.11) ; le sens donné par le Lexique est à vérifier.</text></form></note>
  </entry>
  <entry id="paangei_2965">
    <lexical-unit><form lang="kqs"><text>paangei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="paangei_2965_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lune</text></gloss>
      <gloss lang="en"><text>moon</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moon, month; menstrual period</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first GEN.1.16; Keita 1979, p. 154: Paangei; Lexique kissi–français, p. 40: paangei; Childs 2000, p. 289: pàŋɛ́í</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 41 : aussi pangie « le mois ; la lune ».</text></form></note>
  </entry>
  <entry id="paangii_2966">
    <lexical-unit><form lang="kqs"><text>paangii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>paangon</text></form></field>
    <sense id="paangii_2966_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mois</text></gloss>
      <gloss lang="en"><text>month</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moon, month; menstrual period</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 211 occurrences, first GEN.7.11; Keita 1979, p. 152: Paangiei; Lexique kissi–français, p. 40: paangiei; Childs 2000, p. 289: pàŋɛ́í</text></form></note>
    <note><form lang="fr"><text>Keita écrit Paangiei ; la Bible écrit paangii (pluriel paangon), distinct de paangei « lune ».</text></form></note>
  </entry>
  <entry id="páápáá_2967">
    <lexical-unit><form lang="kqs"><text>páápáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="páápáá_2967_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de selles liquides (diarrhée)</text></gloss>
      <gloss lang="en"><text>sound of loose stools (diarrhoea)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: páápáá</text></form></note>
  </entry>
  <entry id="pààsìá_2968">
    <lexical-unit><form lang="kqs"><text>pààsìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pààsìá_2968_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écarter les jambes (plur.) ; danser en groupe</text></gloss>
      <gloss lang="en"><text>spread one's legs (plural); dance in a group</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààsìá</text></form></note>
  </entry>
  <entry id="pààtìóŋ_2969">
    <lexical-unit><form lang="kqs"><text>pààtìóŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pààtìóŋ_2969_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz</text></gloss>
      <gloss lang="en"><text>a rice variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààtìóŋ</text></form></note>
  </entry>
  <entry id="pààtòó_2970">
    <lexical-unit><form lang="kqs"><text>pààtòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pààtòléŋ</text></form></field>
    <sense id="pààtòó_2970_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe difficile à arracher (mauvaise herbe des rizières)</text></gloss>
      <gloss lang="en"><text>grass that is hard to weed (rice-field weed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààtòó</text></form></note>
  </entry>
  <entry id="pààwàá_2971">
    <lexical-unit><form lang="kqs"><text>pààwàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pààwàá_2971_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paiement, frais, taxe ; (verbe) payer</text></gloss>
      <gloss lang="en"><text>payment, fee, tax; (verb) pay</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààwàá</text></form></note>
  </entry>
  <entry id="pákù_2972">
    <lexical-unit><form lang="kqs"><text>pákù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pákù_2972_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout, entièrement, complètement</text></gloss>
      <gloss lang="en"><text>all, completely, thoroughly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pákù</text></form></note>
  </entry>
  <entry id="pál-pál_2973">
    <lexical-unit><form lang="kqs"><text>pál-pál</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pál-pál_2973_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>goutte à goutte (eau qui fuit)</text></gloss>
      <gloss lang="en"><text>drop by drop (water leaking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pál-pál</text></form></note>
  </entry>
  <entry id="pala_2974">
    <lexical-unit><form lang="kqs"><text>pala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>palan</text></form></variant>
    <variant><form lang="kqs"><text>palanin</text></form></variant>
    <sense id="pala_2974_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>nuire à, maltraiter, tourmenter ; tromper ; déranger ; (palan) se nuire, se tromper soi-même ; fatiguer (qqn)</text></gloss>
      <gloss lang="en"><text>harm, wrong, torment; deceive; bother; (palan) harm or deceive oneself; tire (someone) out</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bother, tease, harass, hinder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.3.13; Lexique kissi–français, p. 40: palaa/ pala; Childs 2000, p. 287: pàlàá</text></form></note>
    <note><form lang="fr"><text>Pala ya le! « ne m'importune pas ! » (LUK.11.7) ; La pala miallo le « n'opprimez pas l'étranger » (JER.22.3) ; Kɛwvo pálá ya « le serpent m'a trompée » (GEN.3.13) ; ɲɔɔ pala nda taw « ils furent furieux » (ACT.7.54) ; paangei palanin nɔm icɔl te « la lune ne te frappera pas la nuit » (PSA.121.6).</text></form></note>
  </entry>
  <entry id="palaa_2975">
    <lexical-unit><form lang="kqs"><text>palaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>palaala</text></form></variant>
    <variant><form lang="kqs"><text>palaalan</text></form></variant>
    <variant><form lang="kqs"><text>palaalen</text></form></variant>
    <sense id="palaa_2975_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mauvais ; (dɛnɛ palaa) malheur, mal</text></gloss>
      <gloss lang="en"><text>bad, evil; (dɛnɛ palaa) misfortune, woe</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 557 occurrences, first GEN.19.15</text></form></note>
  </entry>
  <entry id="pálálá_2976">
    <lexical-unit><form lang="kqs"><text>pálálá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pálálá_2976_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>clairement, complètement (voir, guérir) ; (adj.) clair</text></gloss>
      <gloss lang="en"><text>clearly, fully (seeing, healing); (adj.) clear</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pálálá</text></form></note>
  </entry>
  <entry id="pálápáláŋ_2977">
    <lexical-unit><form lang="kqs"><text>pálápáláŋ</text></form></lexical-unit>
    <trait name="noun-class" value="la"/>
    <trait name="status" value="southern"/>
    <sense id="pálápáláŋ_2977_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roue (acrobatie)</text></gloss>
      <gloss lang="en"><text>cartwheel (acrobatics)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pálápáláŋ</text></form></note>
  </entry>
  <entry id="palɛi_2978">
    <lexical-unit><form lang="kqs"><text>palɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="palɛi_2978_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jour (durée), journée ; (au pluriel) époque</text></gloss>
      <gloss lang="en"><text>day (as a unit of time); (pl.) days, time</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 633 occurrences, first GEN.1.14</text></form></note>
    <note><form lang="fr"><text>palɛi ndii ŋɔmmɛw « sept jours ».</text></form></note>
  </entry>
  <entry id="pámbáléŋ_2979">
    <lexical-unit><form lang="kqs"><text>pámbáléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pámbáléŋ_2979_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piquet de clôture (bouture qui pousse vite)</text></gloss>
      <gloss lang="en"><text>stick used for border fences (grows quickly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pámbáléŋ</text></form></note>
  </entry>
  <entry id="pàmbúléŋ_2980">
    <lexical-unit><form lang="kqs"><text>pàmbúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pàmbúléŋ_2980_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane de forêt (sert de corde, pour les ponts)</text></gloss>
      <gloss lang="en"><text>forest creeper (used as rope, for bridges)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pàmbúléŋ</text></form></note>
  </entry>
  <entry id="pampannden_2981">
    <lexical-unit><form lang="kqs"><text>pampannden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pampannden_2981_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guimbarde (« harpe des Juifs »)</text></gloss>
      <gloss lang="en"><text>jaw harp</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: panpannden</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit panpannden.</text></form></note>
  </entry>
  <entry id="pàndà_2982">
    <lexical-unit><form lang="kqs"><text>pàndà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pàndà_2982_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>peut-être</text></gloss>
      <gloss lang="en"><text>perhaps</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pàndà</text></form></note>
  </entry>
  <entry id="pangaa_2983">
    <lexical-unit><form lang="kqs"><text>pangaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>panga</text></form></variant>
    <variant><form lang="kqs"><text>pangala</text></form></variant>
    <sense id="pangaa_2983_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>case de champ, abri ; champ</text></gloss>
      <gloss lang="en"><text>field hut, shelter; field, farm</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>farm kitchen, thatched hut at the farm (also for sleeping); the rice farm itself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.1.8; Lexique kissi–français, p. 41: pangaa; Childs 2000, p. 289: pàŋáá</text></form></note>
    <note><form lang="fr"><text>mɛɛ pangaa … o nakɔ n'rɛsɛnndo nin « comme une cabane dans une vigne » (Es 1,8) ; n va maalon yiiyo tumbulan o panga « nous liions des gerbes au champ » (Gn 37,7) ; o Boas lo panga « dans le champ de Booz » (Rt 2,17).</text></form></note>
  </entry>
  <entry id="pangeloo_2984">
    <lexical-unit><form lang="kqs"><text>pangeloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="pangeloo_2984_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lueur, lumière ; éclat, gloire</text></gloss>
      <gloss lang="en"><text>glow, light; splendour</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>brightness, light, especially coming from afar</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first EXO.14.20; Keita 1979, p. 154: Pangeloo; Lexique kissi–français, p. 41: pangeloo; Childs 2000, p. 289: páŋèlóó</text></form></note>
  </entry>
  <entry id="pantalaa_2985">
    <lexical-unit><form lang="kqs"><text>pantalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pantalaa_2985_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pantalon</text></gloss>
      <gloss lang="en"><text>trousers</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: pantalaa</text></form></note>
    <note><form lang="fr"><text>Emprunt au français.</text></form></note>
  </entry>
  <entry id="pápá_2986">
    <lexical-unit><form lang="kqs"><text>pápá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pápá_2986_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout droit</text></gloss>
      <gloss lang="en"><text>straight</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pápá</text></form></note>
  </entry>
  <entry id="pàpɛ̀í_2987">
    <lexical-unit><form lang="kqs"><text>pàpɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="pàpɛ̀í_2987_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe de forêt pour le chaume ; neveu qui parle au fils défunt au nom du père</text></gloss>
      <gloss lang="en"><text>forest grass used for thatch; nephew who speaks to a dead son for the father</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pàpɛ̀í</text></form></note>
  </entry>
  <entry id="pasa_2988">
    <lexical-unit><form lang="kqs"><text>pasa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pasa_2988_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'irriter, menacer (?)</text></gloss>
      <gloss lang="en"><text>get angry, threaten (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread one's legs; dance; bristle with vexation</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pàsàá</text></form></note>
    <note><form lang="fr"><text>Un seul emploi : ndu nda saangiaa, o pasa loo « quand on le maltraitait, il ne menaçait pas » (1PE.2.23). Sens déduit du contexte et du sens « s'irriter » donné par Childs ; à confirmer.</text></form></note>
  </entry>
  <entry id="pasaa_2989">
    <lexical-unit><form lang="kqs"><text>pasaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pasa</text></form></variant>
    <sense id="pasaa_2989_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire un pas</text></gloss>
      <gloss lang="en"><text>take a step</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: pasaa/ pasa</text></form></note>
    <note><form lang="fr"><text>Childs (p. 289) donne pàsàá « écarter les jambes ». À distinguer de pasa « s'irriter, menacer (?) » (1PE.2.23).</text></form></note>
  </entry>
  <entry id="pásáŋ_2990">
    <lexical-unit><form lang="kqs"><text>pásáŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pásáŋ_2990_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>pleinement, complètement ; éclatant (rouge, peau claire)</text></gloss>
      <gloss lang="en"><text>fully, completely; bright (red, light skin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 290: pásáŋ</text></form></note>
  </entry>
  <entry id="páú_2991">
