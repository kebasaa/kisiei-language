      <gloss lang="fr"><text>poumon</text></gloss>
      <gloss lang="en"><text>lung</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Föyönnde</text></form></note>
  </entry>
  <entry id="fɔ́ɔ́fɔ̀_469">
