      <gloss lang="fr"><text>tabatière</text></gloss>
      <gloss lang="en"><text>snuffbox</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Pilannde</text></form></note>
  </entry>
  <entry id="pilanndo_2601">
    <lexical-unit><form lang="kqs"><text>pilanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pilan</text></form></variant>
