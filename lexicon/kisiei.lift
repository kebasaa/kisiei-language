  <entry id="kisikisi_1385">
    <lexical-unit><form lang="kqs"><text>kisikisi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kisikisinndo</text></form></variant>
    <variant><form lang="kqs"><text>kisikisianndo</text></form></variant>
    <sense id="kisikisi_1385_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mordre à plusieurs reprises, dévorer, déchirer ; (kisikisinndo) se mordre ; (kisikisianndo) se mordre l'un l'autre</text></gloss>
      <gloss lang="en"><text>bite repeatedly, devour, tear; (kisikisinndo) bite (one's tongue); (kisikisianndo) bite one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.78.45; Childs 2000, p. 171: kìsìkìsìó</text></form></note>
    <note><form lang="fr"><text>sunbungaa kan kisikisi nda « ces mouches les dévorèrent » (PSA.78.45) ; ma kisikisi niaa « et ne vous déchirent » (MAT.7.6) ; diɛɛmuei kisikisinndo « ils se mordaient la langue » (REV.16.10) ; kisikisianndo (GAL.5.15). Pluriel verbal de kisio.</text></form></note>
  </entry>
  <entry id="kisio_1386">
