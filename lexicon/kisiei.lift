    <trait name="status" value="attested"/>
    <sense id="tue_3450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>goutte ; (tue-tue) goutte à goutte</text></gloss>
      <gloss lang="en"><text>drop; (tue-tue) drop by drop</text></gloss>
