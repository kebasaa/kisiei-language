    <sense id="ɲɛi laandui_5125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vase, récipient, pot (en terre)</text></gloss>
      <gloss lang="en"><text>vessel, container, (earthen) pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
