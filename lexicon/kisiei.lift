  <entry id="ɲàmàlàà_6490">
    <lexical-unit><form lang="kqs"><text>ɲàmàlàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="ɲàmàlàà_6490_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être à moitié sec (arbre, brousse, herbe)</text></gloss>
      <gloss lang="en"><text>be half-dry (of a tree, bush or grass)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 274: ɲàmàlàà</text></form></note>
  </entry>
  <entry id="ɲamavuloo_6491">
    <lexical-unit><form lang="kqs"><text>ɲamavuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>ɲamavulua</text></form></field>
    <sense id="ɲamavuloo_6491_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fantôme</text></gloss>
      <gloss lang="en"><text>ghost</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Nyamavuloo; Lexique kissi–français, p. 39: ɲamavuloo; Terminologie (idéologie), n° 293: Nyamavuloo, vana vilèiyo</text></form></note>
    <note><form lang="fr"><text>Pluriel ɲamavulua attesté (Is 34,14). Académie des langues (terminologie, idéologie n° 293) : aussi vana vílɛ́iyo.</text></form></note>
  </entry>
  <entry id="ɲàndèíwé_6492">
