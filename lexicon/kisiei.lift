    <note><form lang="fr"><text>Moyen de hawvo ; hawnun « se porter caution » (PRO 6,1).</text></form></note>
  </entry>
  <entry id="hawvo_505">
    <lexical-unit><form lang="kqs"><text>hawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>haw</text></form></variant>
    <variant><form lang="kqs"><text>hawnin</text></form></variant>
    <sense id="hawvo_505_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bloquer, coincer, presser</text></gloss>
      <gloss lang="en"><text>block, trap, press</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck or trapped</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.27.3; Keita 1979, p. 114: Hawvo; Childs 2000, p. 119: hàùwó</text></form></note>
    <note><form lang="fr"><text>haw : presser (les raisins, GEN 40,11) ; hawnin : être pris (au piège, ISA 24,18).</text></form></note>
  </entry>
  <entry id="he_506">
    <lexical-unit><form lang="kqs"><text>he</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="he_506_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe i)</text></gloss>
      <gloss lang="en"><text>this (i class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 213 occurrences, first GEN.9.17; Childs 2000, p. 120: héì</text></form></note>
  </entry>
  <entry id="heelanndo_507">
    <lexical-unit><form lang="kqs"><text>heelanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelanndo_507_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orgueil, fierté ; ce dont on se glorifie</text></gloss>
      <gloss lang="en"><text>pride, haughtiness; one's glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.17.6</text></form></note>
    <note><form lang="fr"><text>Dérivé de heeloo « lever ». tofa heelanndo « regard hautain » (Pr 21,4).</text></form></note>
  </entry>
  <entry id="heeloo_508">
    <lexical-unit><form lang="kqs"><text>heeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <variant><form lang="kqs"><text>heelunin</text></form></variant>
    <variant><form lang="kqs"><text>heelaa</text></form></variant>
    <sense id="heeloo_508_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever</text></gloss>
      <gloss lang="en"><text>lift up, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>raise; praise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first 2SA.22.42; Childs 2000, p. 120: hèèlòó</text></form></note>
  </entry>
  <entry id="heeluo_509">
    <lexical-unit><form lang="kqs"><text>heeluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="heeluo_509_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever, faire monter</text></gloss>
      <gloss lang="en"><text>lift, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put up, raise, lift, erect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Heeluo; Childs 2000, p. 119: hèèlòó</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : heelu (lever les yeux, la main), heelunin, heelun (GEN 5,24).</text></form></note>
  </entry>
  <entry id="heelɔnndo_510">
    <lexical-unit><form lang="kqs"><text>heelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelɔnndo_510_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'élever, s'enorgueillir ; (sondoo heelɔnndo) parler avec arrogance</text></gloss>
      <gloss lang="en"><text>exalt oneself, be proud; (sondoo heelɔnndo) speak arrogantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.73.9</text></form></note>
    <note><form lang="fr"><text>Moyen de heeloo « lever ».</text></form></note>
  </entry>
  <entry id="helɔɔ_511">
    <lexical-unit><form lang="kqs"><text>helɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hel</text></form></variant>
    <variant><form lang="kqs"><text>helnin</text></form></variant>
    <sense id="helɔɔ_511_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter ; hauteur</text></gloss>
      <gloss lang="en"><text>go up, climb; height</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>climb, go up, rise; also mount, breed (animals)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.6.16; Childs 2000, p. 120: hèlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="hemndo_512">
    <lexical-unit><form lang="kqs"><text>hemndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hemndan</text></form></field>
    <sense id="hemndo_512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gourde, outre</text></gloss>
      <gloss lang="en"><text>gourd, skin bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gourd for keeping oil or wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.6.19; Keita 1979, p. 139: Hemndo; Childs 2000, p. 120: hěmndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mɔiyan hemndo « une outre de vin ».</text></form></note>
  </entry>
  <entry id="hendullo_513">
    <lexical-unit><form lang="kqs"><text>hendullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hendul</text></form></variant>
    <variant><form lang="kqs"><text>hendulun</text></form></variant>
    <sense id="hendullo_513_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner (un ordre) à ; tendre (un piège) à</text></gloss>
      <gloss lang="en"><text>give (an order) to; set (a snare) for</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put or place something for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.28.9; Childs 2000, p. 120: hèndùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de handɔɔ « mettre ». hendul … tɔŋndo « ordonner » ; yaŋɔɔlen hendullo « tendre un piège ».</text></form></note>
  </entry>
  <entry id="hialu_514">
    <lexical-unit><form lang="kqs"><text>hialu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hialun</text></form></variant>
    <variant><form lang="kqs"><text>hialunin</text></form></variant>
    <sense id="hialu_514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dérober, enlever par ruse ; s'échapper, disparaître</text></gloss>
      <gloss lang="en"><text>take by stealth; slip away, disappear</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.27.35</text></form></note>
  </entry>
  <entry id="hiawnanndo_515">
    <lexical-unit><form lang="kqs"><text>hiawnanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hiawnannda</text></form></field>
    <variant><form lang="kqs"><text>hiavannda</text></form></variant>
    <sense id="hiawnanndo_515_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passant, voyageur ; étranger de passage</text></gloss>
      <gloss lang="en"><text>passer-by, traveller; sojourner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.39.13</text></form></note>
    <note><form lang="fr"><text>Dérivé de hiovɔɔ « passer » : vanaa hiawnannda « les passants, les étrangers ».</text></form></note>
  </entry>
  <entry id="hiilaa_516">
    <lexical-unit><form lang="kqs"><text>hiilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiila</text></form></variant>
    <variant><form lang="kqs"><text>hiiliaa</text></form></variant>
    <sense id="hiilaa_516_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lamenter, pousser des cris ; rugir</text></gloss>
      <gloss lang="en"><text>wail, lament; roar</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hiccup; (plural hììlíá) sob or weep quietly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.21.16; Childs 2000, p. 124: hììlàá</text></form></note>
    <note><form lang="fr"><text>hiiliaa hiko-hiko a caŋndo « sangloter en pleurant » (Rt 1,9).</text></form></note>
  </entry>
  <entry id="hiiloo_517">
    <lexical-unit><form lang="kqs"><text>hiiloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluunin</text></form></variant>
    <sense id="hiiloo_517_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>secouer, agiter, ébranler</text></gloss>
      <gloss lang="en"><text>shake, toss, move</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake (transitive)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 2KI.19.21; Childs 2000, p. 124: hììlùùwó</text></form></note>
    <note><form lang="fr"><text>bolle hiiloo « hocher la tête » ; hiiluu (pluriel) « remuer, ébranler » : vana-vana hiiluu suei le (Gn 41,44).</text></form></note>
  </entry>
  <entry id="hiilɔnndo_518">
    <lexical-unit><form lang="kqs"><text>hiilɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilun</text></form></variant>
    <variant><form lang="kqs"><text>hiilunnin</text></form></variant>
    <sense id="hiilɔnndo_518_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trembler, être ébranlé ; être troublé</text></gloss>
      <gloss lang="en"><text>tremble, be shaken; be troubled</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first PSA.46.7; Childs 2000, p. 124: hììlɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiiloo. kɔlta hiilun niaa nin le « ne soyez pas troublés » (Gn 45,5).</text></form></note>
  </entry>
  <entry id="hiilɛi_519">
    <lexical-unit><form lang="kqs"><text>hiilɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hiilɛi_519_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fureur, colère violente</text></gloss>
      <gloss lang="en"><text>fury, rage</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 1SA.2.10</text></form></note>
  </entry>
  <entry id="hiiyo_520">
    <lexical-unit><form lang="kqs"><text>hiiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hiiyo_520_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écume</text></gloss>
      <gloss lang="en"><text>foam</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.49.4; Childs 2000, p. 125: hìíyó</text></form></note>
  </entry>
  <entry id="hiko-hiko_521">
    <lexical-unit><form lang="kqs"><text>hiko-hiko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiko-hiko_521_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(pleurer) en sanglotant</text></gloss>
      <gloss lang="en"><text>(weep) sobbing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.42.24</text></form></note>
  </entry>
  <entry id="hilihiliei_522">
    <lexical-unit><form lang="kqs"><text>hilihiliei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="hilihiliei_522_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hoquet</text></gloss>
      <gloss lang="en"><text>hiccup</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>to hiccup; to sob</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Hilihiliei; Childs 2000, p. 124: hììlàá</text></form></note>
  </entry>
  <entry id="hindɔɔ_523">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hindu</text></form></variant>
    <variant><form lang="kqs"><text>hindunin</text></form></variant>
    <sense id="hindɔɔ_523_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, grandir</text></gloss>
      <gloss lang="en"><text>grow, grow up</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grow, mature; also swell, bloat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le nom verbal hindɔɔ « croissance » a sa propre entrée.</text></form></note>
  </entry>
  <entry id="hindɔɔ_524">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hindɔɔ_524_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>furoncle ; croissance, fait de pousser</text></gloss>
      <gloss lang="en"><text>boil; growth, growing</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boil, swelling, lump, sore; growing up, coming to maturity</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Keita 1979, p. 161: Hindöö; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « le furoncle », confirmé par Childs ; dans la Bible, hindɔɔ « pousser, croissance » (Nb 6,5 ; Ex 10,5).</text></form></note>
  </entry>
  <entry id="hini_525">
    <lexical-unit><form lang="kqs"><text>hini</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hini_525_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être couché, se coucher</text></gloss>
      <gloss lang="en"><text>lie, lie down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lie down, rest, sleep</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 124 occurrences, first GEN.9.16; Childs 2000, p. 126: hìníláŋ</text></form></note>
  </entry>
  <entry id="hinia_526">
    <lexical-unit><form lang="kqs"><text>hinia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hinilan</text></form></field>
    <sense id="hinia_526_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lit, couche</text></gloss>
      <gloss lang="en"><text>bed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.24.31</text></form></note>
    <note><form lang="fr"><text>Lié à hini « être couché ».</text></form></note>
  </entry>
  <entry id="hinul_527">
    <lexical-unit><form lang="kqs"><text>hinul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hinul_527_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer, faire la guerre à (… a cɔwvo)</text></gloss>
      <gloss lang="en"><text>attack, wage war on (… a cɔwvo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.31.52</text></form></note>
  </entry>
  <entry id="hinullo_528">
    <lexical-unit><form lang="kqs"><text>hinullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hinul</text></form></variant>
    <variant><form lang="kqs"><text>hinulnin</text></form></variant>
    <sense id="hinullo_528_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir contre, s'avancer vers ; menacer</text></gloss>
      <gloss lang="en"><text>come against, advance on; threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.14.10; Keita 1979, p. 110: Hinullo</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hunɔɔ (radical négatif hin). Dans la Bible : « marcher contre » (EXO 14,10), « tourner sa face contre » (LEV 20,6).</text></form></note>
  </entry>
  <entry id="hiovɔɔ_529">
    <lexical-unit><form lang="kqs"><text>hiovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiow</text></form></variant>
    <variant><form lang="kqs"><text>hiaw</text></form></variant>
    <variant><form lang="kqs"><text>hiw</text></form></variant>
    <variant><form lang="kqs"><text>hiawnin</text></form></variant>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <variant><form lang="kqs"><text>hiownun</text></form></variant>
    <sense id="hiovɔɔ_529_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, dépasser ; dépasser, surpasser</text></gloss>
      <gloss lang="en"><text>pass, surpass ; pass; exceed, surpass</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go by, pass</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.4.3; Keita 1979, p. 115: Hiowvöö; Childs 2000, p. 127: hìòùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit hiowvöö ; la Bible écrit hiovɔɔ. hiw, hiwnin : radical négatif (GEN 6,3 ; MAT 24,34). hiow … vaa « plus que » (comparatif).</text></form></note>
  </entry>
  <entry id="hisɔp_530">
    <lexical-unit><form lang="kqs"><text>hisɔp</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hisɔp_530_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hysope</text></gloss>
      <gloss lang="en"><text>hyssop</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.12.22</text></form></note>
  </entry>
  <entry id="hivi_531">
    <lexical-unit><form lang="kqs"><text>hivi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <sense id="hivi_531_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, livrer, remettre</text></gloss>
      <gloss lang="en"><text>hand over, deliver to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lift over; circumcise; translate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.16.3; Childs 2000, p. 125: hììwìó</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ « passer ».</text></form></note>
  </entry>
  <entry id="hivihivio_532">
    <lexical-unit><form lang="kqs"><text>hivihivio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hivihivio_532_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer plusieurs fois</text></gloss>
      <gloss lang="en"><text>make pass repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Hivihivio</text></form></note>
    <note><form lang="fr"><text>Redoublement de hivio.</text></form></note>
  </entry>
  <entry id="hivio_533">
    <lexical-unit><form lang="kqs"><text>hivio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivi</text></form></variant>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <variant><form lang="kqs"><text>hivin</text></form></variant>
    <sense id="hivio_533_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer</text></gloss>
      <gloss lang="en"><text>make pass, send ahead</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first JOB.18.19; Keita 1979, p. 110: Hivio</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ ; vana hivia isɔɔ « interprète » (GEN 42,23).</text></form></note>
  </entry>
  <entry id="hiw_534">
    <lexical-unit><form lang="kqs"><text>hiw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <sense id="hiw_534_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépasser (une limite)</text></gloss>
      <gloss lang="en"><text>exceed, go beyond</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.6.3</text></form></note>
  </entry>
  <entry id="hiyanndo_535">
    <lexical-unit><form lang="kqs"><text>hiyanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiyan</text></form></variant>
    <sense id="hiyanndo_535_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire une différence, distinguer ; faire acception de personnes</text></gloss>
      <gloss lang="en"><text>make a distinction; show partiality</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.11.47</text></form></note>
    <note><form lang="fr"><text>hiyan kɛ́-kɛ̀ co … tɛɛn te « il n'y a aucune différence entre … » (Jos 22,28).</text></form></note>
  </entry>
  <entry id="hiyinɔɔ_536">
    <lexical-unit><form lang="kqs"><text>hiyinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyinɔɔ_536_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerin</text></gloss>
      <gloss lang="en"><text>pilgrim</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyinöö</text></form></note>
  </entry>
  <entry id="hiyioo_537">
    <lexical-unit><form lang="kqs"><text>hiyioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyioo_537_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerinage</text></gloss>
      <gloss lang="en"><text>pilgrimage</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyioo</text></form></note>
  </entry>
  <entry id="hiŋndo_538">
    <lexical-unit><form lang="kqs"><text>hiŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋ</text></form></variant>
    <variant><form lang="kqs"><text>hiŋaa</text></form></variant>
    <sense id="hiŋndo_538_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agiter, brandir, remuer ; (hiŋ … hɔlla) tromper, léser</text></gloss>
      <gloss lang="en"><text>shake, brandish, wield; (hiŋ … hɔlla) deceive, wrong</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first GEN.3.24</text></form></note>
    <note><form lang="fr"><text>hiŋ bollen « hocher la tête » (Jr 18,16).</text></form></note>
  </entry>
  <entry id="hiŋnɔnndo_539">
    <lexical-unit><form lang="kqs"><text>hiŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋnun</text></form></variant>
    <variant><form lang="kqs"><text>hiŋnɔn</text></form></variant>
    <sense id="hiŋnɔnndo_539_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>errer, aller çà et là ; s'agiter</text></gloss>
      <gloss lang="en"><text>wander about; be agitated</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be turned or stirred; turn around; become confused, go crazy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.37.15; Childs 2000, p. 127: hìŋnɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiŋndo.</text></form></note>
  </entry>
  <entry id="hiɔlɔnndo_540">
    <lexical-unit><form lang="kqs"><text>hiɔlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlɔn</text></form></variant>
    <variant><form lang="kqs"><text>hiɔlun</text></form></variant>
    <sense id="hiɔlɔnndo_540_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échapper, se sauver</text></gloss>
      <gloss lang="en"><text>escape, get away</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drop by accident, slip and fall; escape, slip away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.43.14; Childs 2000, p. 127: hìɔ̀lɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiɔlɔɔ.</text></form></note>
  </entry>
  <entry id="hiɔlɔɔ_541">
    <lexical-unit><form lang="kqs"><text>hiɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlu</text></form></variant>
    <sense id="hiɔlɔɔ_541_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre possession de, s'emparer de</text></gloss>
      <gloss lang="en"><text>take possession of, seize</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>win from somebody, take away by persuasion, money or force</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.20.18; Childs 2000, p. 128: hìɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lɛŋnden hiɔlɔɔ « prendre possession du pays ».</text></form></note>
  </entry>
