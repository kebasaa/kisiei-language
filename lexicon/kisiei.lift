    <trait name="status" value="attested"/>
    <sense id="canyɛi_388_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amitié ; bonté, alliance</text></gloss>
      <gloss lang="en"><text>friendship; kindness, alliance</text></gloss>
