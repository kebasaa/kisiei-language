    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tɔmnda</text></form></field>
    <sense id="tɔmndo_3513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>singe</text></gloss>
      <gloss lang="en"><text>monkey</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
