    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cum</text></form></variant>
    <sense id="cumndo_187_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attendre ; laisser (faire)</text></gloss>
      <gloss lang="en"><text>wait; let, allow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 91 occurrences, first EXO.5.20; Childs 2000, p. 65: cùmndó</text></form></note>
  </entry>
  <entry id="cumullo_188">
    <lexical-unit><form lang="kqs"><text>cumullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cumul</text></form></variant>
    <sense id="cumullo_188_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller</text></gloss>
      <gloss lang="en"><text>guard, watch over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>watch something secretly, peep, spy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.3.24; Childs 2000, p. 66: cùmùlló</text></form></note>
  </entry>
  <entry id="cun_189">
    <lexical-unit><form lang="kqs"><text>cun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cun_189_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>odeur ; (cun kɛndɛ) parfum</text></gloss>
      <gloss lang="en"><text>smell; (cun kɛndɛ) fragrance</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smelly; smell of, stink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 189 occurrences, first GEN.8.21; Childs 2000, p. 66: cùnéí-</text></form></note>
  </entry>
