      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: páápáá</text></form></note>
  </entry>
  <entry id="pààsìá_2510">
    <lexical-unit><form lang="kqs"><text>pààsìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pààsìá_2510_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écarter les jambes (plur.) ; danser en groupe</text></gloss>
      <gloss lang="en"><text>spread one's legs (plural); dance in a group</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààsìá</text></form></note>
  </entry>
  <entry id="pààtìóŋ_2511">
    <lexical-unit><form lang="kqs"><text>pààtìóŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pààtìóŋ_2511_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz</text></gloss>
      <gloss lang="en"><text>a rice variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààtìóŋ</text></form></note>
  </entry>
  <entry id="pààtòó_2512">
    <lexical-unit><form lang="kqs"><text>pààtòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pààtòléŋ</text></form></field>
    <sense id="pààtòó_2512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe difficile à arracher (mauvaise herbe des rizières)</text></gloss>
      <gloss lang="en"><text>grass that is hard to weed (rice-field weed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààtòó</text></form></note>
  </entry>
  <entry id="pààwàá_2513">
    <lexical-unit><form lang="kqs"><text>pààwàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pààwàá_2513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paiement, frais, taxe ; (verbe) payer</text></gloss>
      <gloss lang="en"><text>payment, fee, tax; (verb) pay</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pààwàá</text></form></note>
  </entry>
  <entry id="pákù_2514">
    <lexical-unit><form lang="kqs"><text>pákù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pákù_2514_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout, entièrement, complètement</text></gloss>
      <gloss lang="en"><text>all, completely, thoroughly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 287: pákù</text></form></note>
  </entry>
  <entry id="pál-pál_2515">
    <lexical-unit><form lang="kqs"><text>pál-pál</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pál-pál_2515_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>goutte à goutte (eau qui fuit)</text></gloss>
      <gloss lang="en"><text>drop by drop (water leaking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 288: pál-pál</text></form></note>
  </entry>
  <entry id="pala_2516">
    <lexical-unit><form lang="kqs"><text>pala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>palan</text></form></variant>
    <variant><form lang="kqs"><text>palanin</text></form></variant>
    <sense id="pala_2516_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>nuire à, maltraiter, tourmenter ; tromper ; déranger ; (palan) se nuire, se tromper soi-même</text></gloss>
      <gloss lang="en"><text>harm, wrong, torment; deceive; bother; (palan) harm or deceive oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bother, tease, harass, hinder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.3.13; Childs 2000, p. 287: pàlàá</text></form></note>
    <note><form lang="fr"><text>Pala ya le! « ne m'importune pas ! » (LUK.11.7) ; La pala miallo le « n'opprimez pas l'étranger » (JER.22.3) ; Kɛwvo pálá ya « le serpent m'a trompée » (GEN.3.13) ; ɲɔɔ pala nda taw « ils furent furieux » (ACT.7.54) ; paangei palanin nɔm icɔl te « la lune ne te frappera pas la nuit » (PSA.121.6).</text></form></note>
  </entry>
  <entry id="palaa_2517">
    <lexical-unit><form lang="kqs"><text>palaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>palaala</text></form></variant>
    <variant><form lang="kqs"><text>palaalan</text></form></variant>
    <variant><form lang="kqs"><text>palaalen</text></form></variant>
    <sense id="palaa_2517_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mauvais ; (dɛnɛ palaa) malheur, mal</text></gloss>
      <gloss lang="en"><text>bad, evil; (dɛnɛ palaa) misfortune, woe</text></gloss>
