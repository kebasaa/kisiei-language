      <gloss lang="fr"><text>tapioca</text></gloss>
      <gloss lang="en"><text>tapioca</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: koloo</text></form></note>
    <note><form lang="fr"><text>Cf. kòlòó (kissi du Sud) « farine de riz ».</text></form></note>
