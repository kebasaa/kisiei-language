  <entry id="kɔ́pɔ́-kɔ́pɔ́_2871">
    <lexical-unit><form lang="kqs"><text>kɔ́pɔ́-kɔ́pɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ́pɔ́-kɔ́pɔ́_2871_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement, comme il faut</text></gloss>
      <gloss lang="en"><text>completely, properly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 189: kɔ́pɔ́-kɔ́pɔ́</text></form></note>
  </entry>
  <entry id="kɔ̀sàá_2872">
    <lexical-unit><form lang="kqs"><text>kɔ̀sàá</text></form></lexical-unit>
