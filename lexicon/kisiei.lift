    <sense id="kongillo_1689_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coq</text></gloss>
      <gloss lang="en"><text>rooster, cock</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.6 Poultry raising"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first JOB.38.36; Lexique kissi–français, p. 25: kongillo; Childs 2000, p. 176: kòŋgìlló</text></form></note>
  </entry>
  <entry id="kongio_1690">
    <lexical-unit><form lang="kqs"><text>kongio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kongio_1690_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>érosion</text></gloss>
      <gloss lang="en"><text>erosion</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: kongio</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence biblique (REV.14.20), où le sens « écoulement » paraît possible ; à confirmer.</text></form></note>
  </entry>
  <entry id="kongosalɛu_1691">
    <lexical-unit><form lang="kqs"><text>kongosalɛu</text></form></lexical-unit>
