    <trait name="status" value="southern"/>
    <sense id="mâ_2561_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(réduire) tout petit</text></gloss>
      <gloss lang="en"><text>(reduce) to smallness</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 237: mâ</text></form></note>
  </entry>
  <entry id="maa_2562">
    <lexical-unit><form lang="kqs"><text>maa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="maa_2562_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>que (complétive)</text></gloss>
      <gloss lang="en"><text>that (complementizer)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'as'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5511 occurrences, first GEN.1.4; Lexique kissi–français, p. 33: maa; Childs 2000, p. 238: màà</text></form></note>
  </entry>
  <entry id="màá_2563">
    <lexical-unit><form lang="kqs"><text>màá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>màáláŋ</text></form></field>
    <sense id="màá_2563_s1">
      <grammatical-info value="Noun"/>
