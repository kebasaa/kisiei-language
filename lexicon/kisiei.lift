    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>solin</text></form></variant>
    <variant><form lang="kqs"><text>solinin</text></form></variant>
    <sense id="solinndo_3062_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ôter, retirer (de soi) ; sortir</text></gloss>
      <gloss lang="en"><text>take off, remove; come out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first LEV.17.11</text></form></note>
    <note><form lang="fr"><text>Moyen de solio « faire sortir ».</text></form></note>
  </entry>
  <entry id="solio_3063">
    <lexical-unit><form lang="kqs"><text>solio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>soli</text></form></variant>
    <variant><form lang="kqs"><text>solinin</text></form></variant>
    <sense id="solio_3063_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire sortir ; offrir (un sacrifice)</text></gloss>
      <gloss lang="en"><text>bring out; offer (a sacrifice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take something out</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 418 occurrences, first GEN.12.20; Keita 1979, p. 113: Solio; Childs 2000, p. 338: sòlìó</text></form></note>
    <note><form lang="fr"><text>Causatif de fulaa. Bénéfactif solul « offrir à ».</text></form></note>
  </entry>
  <entry id="sòlíŋndé_3064">
