    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ̀ŋgìóó</text></form></note>
  </entry>
  <entry id="bɔ̀ŋgìɲó_363">
    <lexical-unit><form lang="kqs"><text>bɔ̀ŋgìɲó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ŋgìɲó_363_s1">
