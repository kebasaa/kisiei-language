    <trait name="status" value="southern"/>
    <sense id="nàmbàwɛ́íyó_2391_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de banane</text></gloss>
      <gloss lang="en"><text>kind of banana</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 258: nàmbàwɛ́íyó</text></form></note>
  </entry>
  <entry id="namtalen_2392">
    <lexical-unit><form lang="kqs"><text>namtalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="namtalen_2392_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut physique, infirmité ; paralysie</text></gloss>
      <gloss lang="en"><text>physical defect, infirmity; paralysis</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.22.25; Keita 1979, p. 162: Namtalen; Childs 2000, p. 258: nâmtàá</text></form></note>
    <note><form lang="fr"><text>Keita : « paralysie » ; dans la Bible, « défaut » d'un animal (Dt 15,21).</text></form></note>
  </entry>
  <entry id="namtanɔɔ_2393">
    <lexical-unit><form lang="kqs"><text>namtanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>namtaa</text></form></field>
    <sense id="namtanɔɔ_2393_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>infirme, estropié ; personne ou animal ayant un défaut physique</text></gloss>
      <gloss lang="en"><text>cripple, lame person; person or animal with a physical defect</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.21.17; Childs 2000, p. 258: nâmtàá</text></form></note>
    <note><form lang="fr"><text>vanaa sumɛiya a namtaa « les aveugles et les boiteux » (2SA.5.6). Cf. namtalen « défaut, infirmité ».</text></form></note>
  </entry>
  <entry id="nánde_2394">
    <lexical-unit><form lang="kqs"><text>nánde</text></form></lexical-unit>
