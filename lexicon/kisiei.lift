    <sense id="vayia_4360_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fouler, presser (le raisin) ; tasser (la terre)</text></gloss>
      <gloss lang="en"><text>tread, press (grapes); tread down (soil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wring, squeeze (e.g. cloth)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.40.11; Childs 2000, p. 381: wàyìá</text></form></note>
    <note><form lang="fr"><text>vana vayia rɛsɛnndon o doola nin « celui qui foule le raisin dans la cuve » (LAM.1.15).</text></form></note>
  </entry>
  <entry id="vaŋ_4361">
    <lexical-unit><form lang="kqs"><text>vaŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaŋ_4361_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) tout à fait ; d'un rouge vif (lasiaŋa vaŋ, diw vaŋ)</text></gloss>
      <gloss lang="en"><text>(ideophone) completely; bright red (lasiaŋa vaŋ, diw vaŋ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.11.1</text></form></note>
  </entry>
  <entry id="veeliaa_4362">
    <lexical-unit><form lang="kqs"><text>veeliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veeliaanin</text></form></variant>
    <sense id="veeliaa_4362_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dessécher, tarir (les eaux, les fleuves)</text></gloss>
      <gloss lang="en"><text>dry up (waters, rivers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dry up (plural of wèlàá 'become dry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first PSA.66.6; Childs 2000, p. 382: wèèlìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de velaa « tarir ». I veeliaa peelan Esipte kpow « j'ai tari tous les fleuves d'Égypte » (ISA.37.25).</text></form></note>
  </entry>
  <entry id="veeloo_4363">
    <lexical-unit><form lang="kqs"><text>veeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veelu</text></form></variant>
    <variant><form lang="kqs"><text>veelunin</text></form></variant>
    <sense id="veeloo_4363_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>appeler ; invoquer</text></gloss>
      <gloss lang="en"><text>call ; call; call upon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>call, name</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 127 occurrences, first GEN.4.26; Keita 1979, p. 114: Veeluo; Lexique kissi–français, p. 60: veeluo/ veelu; Childs 2000, p. 382: wèèlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit veeluo ; la Bible écrit veeloo (GEN 4,26). Lexique kissi–français, p. 60-61 : veeluo/ veelu « appeler » et veluo/ velu « appeler, inviter ».</text></form></note>
  </entry>
  <entry id="veeluanndo_4364">
    <lexical-unit><form lang="kqs"><text>veeluanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="veeluanndo_4364_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'interpeller</text></gloss>
      <gloss lang="en"><text>call one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Veeluanndo; Lexique kissi–français, p. 60: veeluanndo/ veeluan</text></form></note>
    <note><form lang="fr"><text>Réciproque de veeloo.</text></form></note>
  </entry>
  <entry id="veelul_4365">
    <lexical-unit><form lang="kqs"><text>veelul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veelul_4365_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>appeler (qqn) pour (qqn), faire venir</text></gloss>
      <gloss lang="en"><text>call (someone) for (someone), summon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.22.5; Childs 2000, p. 382: wèèlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de veeloo « appeler ». mà kɔ veelul ndu ndu « qu'ils aillent le lui appeler » (NUM.22.5).</text></form></note>
  </entry>
  <entry id="veelɔnndo_4366">
    <lexical-unit><form lang="kqs"><text>veelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veelɔnndo_4366_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être appelé, s'appeler</text></gloss>
      <gloss lang="en"><text>be called, be named</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>call oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first JER.7.10; Childs 2000, p. 382: wèèlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de veeloo.</text></form></note>
  </entry>
  <entry id="veesiaa_4367">
    <lexical-unit><form lang="kqs"><text>veesiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veesiaa_4367_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire sécher, dessécher</text></gloss>
      <gloss lang="en"><text>make dry, wither</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.41.6; Keita 1979, p. 114: Veesiaa; Lexique kissi–français, p. 60: veesiaa/ veesia</text></form></note>
    <note><form lang="fr"><text>Causatif de vesaa (GEN 41,6). Le Lexique kissi–français (p. 61) écrit aussi vesiaa/ vesia.</text></form></note>
  </entry>
  <entry id="veinɔnndo_4368">
    <lexical-unit><form lang="kqs"><text>veinɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>veinun</text></form></variant>
    <sense id="veinɔnndo_4368_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>menacer, effrayer</text></gloss>
      <gloss lang="en"><text>threaten, frighten</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 60: veinɔnndo/ veinun</text></form></note>
  </entry>
  <entry id="velaa_4369">
    <lexical-unit><form lang="kqs"><text>velaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vela</text></form></variant>
    <variant><form lang="kqs"><text>velanin</text></form></variant>
    <sense id="velaa_4369_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tarir, baisser (eaux)</text></gloss>
      <gloss lang="en"><text>dry up, recede (water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>become dry (of water)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.8.1; Keita 1979, p. 114: Velaa; Lexique kissi–français, p. 60: velaa/ vela; Childs 2000, p. 382: wèlàá</text></form></note>
  </entry>
  <entry id="velan_4370">
    <lexical-unit><form lang="kqs"><text>velan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="velan_4370_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>image, ressemblance</text></gloss>
      <gloss lang="en"><text>image, likeness</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>resemblances (from wèlǎŋndó 'resemble')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.1.26; Lexique kissi–français, p. 61: vɛlanndo/ vɛlan; Childs 2000, p. 383: wèlâŋndáŋ</text></form></note>
    <note><form lang="fr"><text>Verbe apparenté vel « ressembler à » (Gn 1,26). Le Lexique kissi–français (p. 61) écrit vɛlanndo/ vɛlan « la ressemblance ».</text></form></note>
  </entry>
  <entry id="velanndo_4371">
    <lexical-unit><form lang="kqs"><text>velanndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="velanndo_4371_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tarir (Keita) ; ressemblance, sens (Bible)</text></gloss>
      <gloss lang="en"><text>dry up (Keita); likeness, meaning (Bible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>resemble</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Velanndo; Lexique kissi–français, p. 60: velanndo/ velan; Childs 2000, p. 383: wèlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, velanndo est « sens (d'un nom), ressemblance » (GEN 29,34), de vel « ressembler » ; le sens « se tarir » de Keita n'y est pas. Le Lexique kissi–français (p. 60) confirme velanndo/ velan « se tarir ».</text></form></note>
  </entry>
  <entry id="vellaa-velle_4372">
    <lexical-unit><form lang="kqs"><text>vellaa-velle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vellaa-velle_4372_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>l'un l'autre, les uns les autres (réciproque)</text></gloss>
      <gloss lang="en"><text>one another, each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adverb) together</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 145 occurrences, first GEN.11.3; Childs 2000, p. 383: wéllàá-wèllè</text></form></note>
    <note><form lang="fr"><text>Má dimulan vellaa-velle « ils se dirent l'un à l'autre » (GEN.11.3).</text></form></note>
  </entry>
  <entry id="velu_4373">
    <lexical-unit><form lang="kqs"><text>velu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="velu_4373_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>engendrer (père)</text></gloss>
      <gloss lang="en"><text>beget, father</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bear, give birth, be born; resemble (the stem wélù is used of a father siring)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 289 occurrences, first GEN.5.4; Childs 2000, p. 386: wìòlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="velun_4374">
    <lexical-unit><form lang="kqs"><text>velun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="velun_4374_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>naître</text></gloss>
      <gloss lang="en"><text>be born</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 87 occurrences, first GEN.11.28; Childs 2000, p. 386: wìòlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de velu.</text></form></note>
  </entry>
  <entry id="vemalen_4375">
    <lexical-unit><form lang="kqs"><text>vemalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="vemalen_4375_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorcellerie</text></gloss>
      <gloss lang="en"><text>sorcery, witchcraft</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: vemalen</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « les œuvres du sorcier », corrigé en « sorcellerie ».</text></form></note>
  </entry>
  <entry id="vemanɔɔ_4376">
    <lexical-unit><form lang="kqs"><text>vemanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vemanɔɔ_4376_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorcier qui fait des prodiges</text></gloss>
      <gloss lang="en"><text>sorcerer who works wonders</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: vemanaɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit vemanaɔɔ, sans doute pour vemanɔɔ (suffixe -nɔɔ) ; à vérifier.</text></form></note>
  </entry>
  <entry id="vennun_4377">
    <lexical-unit><form lang="kqs"><text>vennun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vennun_4377_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réfugier, s'échapper, se mettre à l'abri ; échapper (à l'attention de)</text></gloss>
      <gloss lang="en"><text>take refuge, escape, flee to safety; escape (the notice of)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hide oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.31.20; Childs 2000, p. 384: wɛ̀nɔ̌ŋndɔ́</text></form></note>
  </entry>
  <entry id="venɔnndo_4378">
    <lexical-unit><form lang="kqs"><text>venɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>venun</text></form></variant>
    <sense id="venɔnndo_4378_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'habiller ; porter (un vêtement)</text></gloss>
      <gloss lang="en"><text>dress; wear</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: venɔnndo/ venun</text></form></note>
  </entry>
  <entry id="vesaa_4379">
    <lexical-unit><form lang="kqs"><text>vesaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vesa</text></form></variant>
    <variant><form lang="kqs"><text>vesanin</text></form></variant>
    <sense id="vesaa_4379_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sécher, être sec</text></gloss>
      <gloss lang="en"><text>dry, be dry</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.18.16; Keita 1979, p. 114: Vesaa; Lexique kissi–français, p. 61: vesaa/ vesa; Childs 2000, p. 383: wèsàá</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 62) donne aussi vosaa/ vosa « sécher ».</text></form></note>
  </entry>
  <entry id="veselɛilen_4380">
    <lexical-unit><form lang="kqs"><text>veselɛilen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veselɛile</text></form></variant>
    <variant><form lang="kqs"><text>veselɛiyo</text></form></variant>
    <sense id="veselɛilen_4380_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aride, désertique (lɛŋnde veselɛilen « désert ») ; sec</text></gloss>
      <gloss lang="en"><text>arid, desert (lɛŋnde veselɛilen 'desert, wilderness'); dry</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 288 occurrences, first GEN.12.9; Lexique kissi–français, p. 61: veselɛiyo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 61 : veselɛiyo « sec » ; lɛŋnde veselɛiyo (DEU.32.10).</text></form></note>
  </entry>
  <entry id="vesul_4381">
    <lexical-unit><form lang="kqs"><text>vesul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vesul_4381_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger</text></gloss>
      <gloss lang="en"><text>sprinkle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>splash</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.4.6; Childs 2000, p. 384: wèsùlló</text></form></note>
  </entry>
  <entry id="vesɛiyo_4382">
    <lexical-unit><form lang="kqs"><text>vesɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vesɛi</text></form></variant>
    <variant><form lang="kqs"><text>vesɛiya</text></form></variant>
    <variant><form lang="kqs"><text>vesɛilan</text></form></variant>
    <variant><form lang="kqs"><text>vesɛilen</text></form></variant>
    <sense id="vesɛiyo_4382_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sec ; dur ; terre ferme</text></gloss>
      <gloss lang="en"><text>dry; hard; dry land</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first GEN.1.9; Childs 2000, p. 383: wèsɛ́í</text></form></note>
  </entry>
  <entry id="vewvo_4383">
    <lexical-unit><form lang="kqs"><text>vewvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vew</text></form></variant>
    <sense id="vewvo_4383_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre dedans</text></gloss>
      <gloss lang="en"><text>put in</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: vewvo</text></form></note>
  </entry>
  <entry id="viamaa_4384">
    <lexical-unit><form lang="kqs"><text>viamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viam</text></form></variant>
    <variant><form lang="kqs"><text>vim</text></form></variant>
    <variant><form lang="kqs"><text>viamnin</text></form></variant>
    <sense id="viamaa_4384_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>envoyer (qqn)</text></gloss>
      <gloss lang="en"><text>send (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.41.8; Childs 2000, p. 387: wìòmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>vanaa viamaa yavaa « les magiciens » (Gn 41,8).</text></form></note>
  </entry>
  <entry id="viannan_4385">
    <lexical-unit><form lang="kqs"><text>viannan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viannanndo</text></form></variant>
    <variant><form lang="kqs"><text>viannannda</text></form></variant>
    <variant><form lang="kqs"><text>viannanndon</text></form></variant>
    <sense id="viannan_4385_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>caché, secret ; de refuge</text></gloss>
      <gloss lang="en"><text>hidden, secret; of refuge</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first DEU.4.43</text></form></note>
    <note><form lang="fr"><text>Kobi viannan « ville de refuge ».</text></form></note>
  </entry>
  <entry id="vii_4386">
    <lexical-unit><form lang="kqs"><text>vii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vii_4386_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lapider (vii … a powtan)</text></gloss>
      <gloss lang="en"><text>stone (vii … a powtan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.17.4</text></form></note>
  </entry>
  <entry id="viiku_4387">
    <lexical-unit><form lang="kqs"><text>viiku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vííkù</text></form></variant>
    <sense id="viiku_4387_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avorter, mettre bas avant terme ; (nom) avorton</text></gloss>
      <gloss lang="en"><text>miscarry, cast young; (noun) untimely birth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>miscarry, abort; also lose a spouse through death</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.31.38; Childs 2000, p. 385: wììkùùwó</text></form></note>
    <note><form lang="fr"><text>saa nɔmnda a cuinaa nɔmnda ve viiku le « tes brebis et tes chèvres n'ont pas avorté » (GEN.31.38) ; cɛlɛkpɛ nda viiku-o « l'enfant mort-né » (PSA.58.9).</text></form></note>
  </entry>
  <entry id="vííyo_4388">
    <lexical-unit><form lang="kqs"><text>vííyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vííya</text></form></field>
    <sense id="vííyo_4388_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orphelin</text></gloss>
      <gloss lang="en"><text>orphan</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first EXO.19.13; Keita 1979, p. 134: Viiyo; Lexique kissi–français, p. 61: viiyo; Childs 2000, p. 385: wììyó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit vííyo avec tons ; viiyo sans ton y signifie « lapidation » (Lv 20,2).</text></form></note>
  </entry>
  <entry id="vilio_4389">
    <lexical-unit><form lang="kqs"><text>vilio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vili</text></form></variant>
    <sense id="vilio_4389_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter (des charges), transporter ; mener, conduire</text></gloss>
      <gloss lang="en"><text>carry (loads), transport; lead, conduct</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>carry loads, haul, draw (plural of 'bear, carry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first NUM.4.24; Lexique kissi–français, p. 61: [v]irio/ viri; Childs 2000, p. 386: wìlìó</text></form></note>
    <note><form lang="fr"><text>nɔm vili ndi niko Yerusalɛm « tu les mèneras à Jérusalem » (2CH.2.15). Le Lexique kissi–français (p. 61) écrit virio/ viri « porter une charge ».</text></form></note>
  </entry>
  <entry id="vilul_4390">
    <lexical-unit><form lang="kqs"><text>vilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vilul_4390_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enfanter (un enfant) à qqn</text></gloss>
      <gloss lang="en"><text>bear (a child) to someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deliver (a child) for someone, as a midwife</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.4.21; Childs 2000, p. 386: wìlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de violɔɔ « enfanter ».</text></form></note>
  </entry>
  <entry id="vilɛi_4391">
    <lexical-unit><form lang="kqs"><text>vilɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vilɛiye</text></form></variant>
    <variant><form lang="kqs"><text>vilɛilan</text></form></variant>
    <sense id="vilɛi_4391_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>long, haut, élevé ; géant (objets)</text></gloss>
      <gloss lang="en"><text>long, high, tall; giant, huge (of things)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>long, tall, sharp</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first GEN.6.4; Lexique kissi–français, p. 61: vilɛiyo; Childs 2000, p. 385: wìlɛ̀-</text></form></note>
    <note><form lang="fr"><text>pembii vilɛiye « une haute montagne » (MAT.17.1) ; yiiŋii vilɛiye « longue chevelure » (1CO.11.15) ; cɛila coocoola vilɛilan « les hautes tours » (ISA.2.15). Écrit sans accents, à la différence de vílɛ́iyo « mort ». Lexique kissi–français, p. 61 : vilɛiyo « grand, haut, géant pour les objets inanimés ».</text></form></note>
  </entry>
  <entry id="vilɛi-vilɛi_4392">
    <lexical-unit><form lang="kqs"><text>vilɛi-vilɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vilɛi-vilɛiya</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiye</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiyo</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiyon</text></form></variant>
    <sense id="vilɛi-vilɛi_4392_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>très grand, de haute taille ; (vanaa vilɛi-vilɛiya) géants</text></gloss>
      <gloss lang="en"><text>very tall, huge; (vanaa vilɛi-vilɛiya) giants</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2SA.23.21; Childs 2000, p. 385: wìlɛ̀-</text></form></note>
    <note><form lang="fr"><text>Redoublement de vilɛi. Esiptenɔ vilɛi-vilɛi « un Égyptien de haute taille » (2SA.23.21) ; kpɛŋɛ lemasa vilɛi-vilɛiyo « un trône très élevé » (ISA.6.1).</text></form></note>
  </entry>
  <entry id="vílɛ́iyo_4393">
    <lexical-unit><form lang="kqs"><text>vílɛ́iyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vílɛ́iya</text></form></field>
    <variant><form lang="kqs"><text>vílɛ́i</text></form></variant>
    <variant><form lang="kqs"><text>vilɔɔ</text></form></variant>
    <sense id="vílɛ́iyo_4393_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mort, cadavre</text></gloss>
      <gloss lang="en"><text>dead person, corpse</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) dead, deceased</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.23.3; Lexique kissi–français, p. 61: vilɛi; Childs 2000, p. 385: wìlɛ́í-</text></form></note>
    <note><form lang="fr"><text>vanvilɛiya « les morts » (Mc 6,14) ; langbanɔ falun vilɛi « l'homme paralysé » (Mt 9,6). Lexique kissi–français, p. 61 : vilɛi et vilɔɔ « mort » ; vana vilɔɔ « un mort » (LUK.7.12).</text></form></note>
  </entry>
  <entry id="violɔɔ_4394">
    <lexical-unit><form lang="kqs"><text>violɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vialu</text></form></variant>
    <variant><form lang="kqs"><text>vialunin</text></form></variant>
    <sense id="violɔɔ_4394_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accoucher, enfanter</text></gloss>
      <gloss lang="en"><text>give birth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bear (a child)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 62 occurrences, first GEN.6.1; Keita 1979, p. 115: Violöö; Lexique kissi–français, p. 61: violɔɔ/ violu, violu, vialu; Childs 2000, p. 386: wìòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 61-62) écrit aussi viorɔɔ, et vorɔɔ/ varu, vɛru (r pour l).</text></form></note>
  </entry>
  <entry id="vionnɔnndo_4395">
    <lexical-unit><form lang="kqs"><text>vionnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vionnun</text></form></variant>
    <variant><form lang="kqs"><text>viannun</text></form></variant>
    <sense id="vionnɔnndo_4395_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se cacher ; refuge</text></gloss>
      <gloss lang="en"><text>hide oneself; refuge</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first EXO.2.3; Lexique kissi–français, p. 62: vonnɔnndo/ vannun; Childs 2000, p. 387: wìònɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de vionɔɔ. Le Lexique kissi–français (p. 60, 62) écrit vonnɔnndo/ vannun « se cacher ».</text></form></note>
  </entry>
  <entry id="vionɔɔ_4396">
    <lexical-unit><form lang="kqs"><text>vionɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vian</text></form></variant>
    <variant><form lang="kqs"><text>vin</text></form></variant>
    <variant><form lang="kqs"><text>vonɔɔ</text></form></variant>
    <sense id="vionɔɔ_4396_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cacher</text></gloss>
      <gloss lang="en"><text>hide (something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.2.2; Lexique kissi–français, p. 62: vonɔɔ/ van; Childs 2000, p. 387: wìòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 59, 62) écrit vonɔɔ/ van « faire cacher » ; la Bible a aussi vonɔɔ (JOB.9.7, PRO.10.18).</text></form></note>
  </entry>
  <entry id="viovɔɔ_4397">
    <lexical-unit><form lang="kqs"><text>viovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viow</text></form></variant>
    <variant><form lang="kqs"><text>viaw</text></form></variant>
    <variant><form lang="kqs"><text>viawnin</text></form></variant>
    <sense id="viovɔɔ_4397_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, jeter, lancer</text></gloss>
      <gloss lang="en"><text>put, throw, cast</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stay in one place for a long time; (benefactive) throw away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.32.1; Childs 2000, p. 387: wìòùwó</text></form></note>
    <note><form lang="fr"><text>viow kponyoo « pousser des cris de joie » (Ps 33,1) ; viaw … taw « séjourner longtemps » (Gn 21,34).</text></form></note>
  </entry>
  <entry id="visiei_4398">
    <lexical-unit><form lang="kqs"><text>visiei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="visiei_4398_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chair, viande</text></gloss>
      <gloss lang="en"><text>flesh, meat</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.2.21; Keita 1979, p. 133: Visiei; Lexique kissi–français, p. 61: visiɛi; Childs 2000, p. 387: wìsìé</text></form></note>
    <note><form lang="fr"><text>Le Lexique : visie « un morceau de viande », visiɛi « la chair », vision « les viandes ». La Bible a visiei (GEN.2.21), vision (GEN.9.4) et visin (GEN.15.11).</text></form></note>
  </entry>
  <entry id="visin kɔɔn_4399">
    <lexical-unit><form lang="kqs"><text>visin kɔɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="visin kɔɔn_4399_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>reins, muscles du dos</text></gloss>
      <gloss lang="en"><text>loins, back muscles</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: visin kɔɔn</text></form></note>
  </entry>
  <entry id="visio_4400">
    <lexical-unit><form lang="kqs"><text>visio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>visia</text></form></field>
    <sense id="visio_4400_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animal ; animal sauvage</text></gloss>
      <gloss lang="en"><text>animal; wild animal</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6 Animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.27.20; Keita 1979, p. 137: Visio; Lexique kissi–français, p. 61: visio; Childs 2000, p. 387: wìsìó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 61 : « un animal sauvage ».</text></form></note>
  </entry>
  <entry id="viw_4401">
    <lexical-unit><form lang="kqs"><text>viw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viwnin</text></form></variant>
    <variant><form lang="kqs"><text>viwanin</text></form></variant>
    <sense id="viw_4401_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>durer, tarder, rester longtemps</text></gloss>
      <gloss lang="en"><text>last long, linger, delay</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.8.7</text></form></note>
    <note><form lang="fr"><text>o viw le « il ne dure pas » (JOB.14.2) ; la viwnin le « vous ne prolongerez pas vos jours » (DEU.30.18).</text></form></note>
  </entry>
  <entry id="viya_4402">
    <lexical-unit><form lang="kqs"><text>viya</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="viya_4402_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>travailler le cuir</text></gloss>
      <gloss lang="en"><text>work leather</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: viya</text></form></note>
    <note><form lang="fr"><text>Le Lexique hésite : « préparer le cuir ? », corrigé en « travailler le cuir ? ».</text></form></note>
  </entry>
  <entry id="viɔw_4403">
    <lexical-unit><form lang="kqs"><text>viɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viɔ</text></form></variant>
    <variant><form lang="kqs"><text>via</text></form></variant>
    <sense id="viɔw_4403_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cogner, heurter ; tirer (flèche)</text></gloss>
      <gloss lang="en"><text>knock, strike; shoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.35.22; Keita 1979, p. 116: Viöw; Lexique kissi–français, p. 61: viɔu/ viɔ, vɛ, via, ve</text></form></note>
    <note><form lang="fr"><text>via « atteindre (d'une flèche) » (2CH 35,23). Lexique kissi–français, p. 61 : radicaux viɔ, vɛ, via, ve.</text></form></note>
  </entry>
  <entry id="vo_4404">
    <lexical-unit><form lang="kqs"><text>vo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vo_4404_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>craindre, respecter ; avoir peur</text></gloss>
      <gloss lang="en"><text>fear, revere; be afraid</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 754 occurrences, first GEN.9.15; Lexique kissi–français, p. 61: vo; Childs 2000, p. 389: wɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 61 : « avoir peur ; craindre ».</text></form></note>
  </entry>
  <entry id="vola_4405">
    <lexical-unit><form lang="kqs"><text>vola</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vola_4405_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>il y a longtemps</text></gloss>
      <gloss lang="en"><text>long ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: vola</text></form></note>
  </entry>
  <entry id="volimɔlen_4406">
    <lexical-unit><form lang="kqs"><text>volimɔlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="volimɔlen_4406_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorcellerie</text></gloss>
      <gloss lang="en"><text>sorcery, witchcraft</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: volimɔlen</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « les œuvres du sorcier », corrigé en « sorcellerie ».</text></form></note>
  </entry>
  <entry id="volimɔɔ_4407">
    <lexical-unit><form lang="kqs"><text>volimɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="volimɔɔ_4407_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorcier</text></gloss>
      <gloss lang="en"><text>sorcerer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: volimɔɔ</text></form></note>
  </entry>
  <entry id="volio_4408">
    <lexical-unit><form lang="kqs"><text>volio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>voli</text></form></variant>
    <variant><form lang="kqs"><text>volinin</text></form></variant>
    <sense id="volio_4408_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briller, étinceler ; (éclair) jaillir (piɔɔ voli « l'éclair brille »)</text></gloss>
      <gloss lang="en"><text>shine, flash; (of lightning) flash</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) lightning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first EXO.19.16; Childs 2000, p. 388: wòlìwòlìóó</text></form></note>
    <note><form lang="fr"><text>piɔɔ-volia « les éclairs » (JOB.37.11).</text></form></note>
  </entry>
  <entry id="volio_4409">
    <lexical-unit><form lang="kqs"><text>volio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>voli</text></form></variant>
    <sense id="volio_4409_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aiguiser ; tailler</text></gloss>
      <gloss lang="en"><text>sharpen; whittle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: volio/ voli</text></form></note>
    <note><form lang="fr"><text>Homographe de volio « briller, étinceler ».</text></form></note>
  </entry>
  <entry id="volion_4410">
    <lexical-unit><form lang="kqs"><text>volion</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>volin</text></form></variant>
    <variant><form lang="kqs"><text>volii</text></form></variant>
    <variant><form lang="kqs"><text>voliei</text></form></variant>
    <sense id="volion_4410_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argent (métal, monnaie)</text></gloss>
      <gloss lang="en"><text>silver, money</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 187 occurrences, first GEN.13.2; Keita 1979, p. 149: Volion; Lexique kissi–français, p. 61: volion</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 62) écrit aussi vorion.</text></form></note>
  </entry>
  <entry id="vólotótoo_4411">
    <lexical-unit><form lang="kqs"><text>vólotótoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vólotótolan</text></form></field>
    <sense id="vólotótoo_4411_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>écarlate, rouge vif</text></gloss>
      <gloss lang="en"><text>scarlet</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.26.1</text></form></note>
    <note><form lang="fr"><text>Le pourpre est sɔɔtɔtɔɔ (Mc 15,17) ; vólotótoo est l'écarlate (Ap 17,4).</text></form></note>
  </entry>
  <entry id="volɔɔ_4412">
    <lexical-unit><form lang="kqs"><text>volɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>volɔɔlan</text></form></field>
    <variant><form lang="kqs"><text>volɔɔla</text></form></variant>
    <variant><form lang="kqs"><text>volola</text></form></variant>
    <sense id="volɔɔ_4412_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charge, fardeau ; vêtement, habit (volɔɔ cuɛinan « vêtement »)</text></gloss>
      <gloss lang="en"><text>load, burden; garment, clothing (volɔɔ cuɛinan 'garment')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tool, implement; (pl.) loads</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first LEV.11.32; Lexique kissi–français, p. 61: vololaa; Childs 2000, p. 388: wòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>volɔɔla « charges » (GEN.24.32) et « vêtements » (LEV.19.19) ; volɔɔ lusulaa « joug pesant » (1KI.12.14). Lexique kissi–français, p. 61-62 : vololaa « les habits » (la Bible a volola, JOB.27.16) ; vorɔɔ « la charge ».</text></form></note>
  </entry>
  <entry id="volɔɔ_4413">
    <lexical-unit><form lang="kqs"><text>volɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>val</text></form></variant>
    <sense id="volɔɔ_4413_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être concerné ; ressembler à</text></gloss>
      <gloss lang="en"><text>be concerned; resemble</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 61: volɔɔ/ val</text></form></note>
    <note><form lang="fr"><text>Homographe de volɔɔ « charge, vêtement ». Le Lexique donne aussi le radical val (p. 59). Sens non confirmé dans la Bible ; à vérifier.</text></form></note>
  </entry>
  <entry id="vomullo_4414">
    <lexical-unit><form lang="kqs"><text>vomullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vomul</text></form></variant>
    <variant><form lang="kqs"><text>vomulaa</text></form></variant>
    <sense id="vomullo_4414_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>filer (le coton, la laine) ; (vomulaa) fileuse, quenouille</text></gloss>
      <gloss lang="en"><text>spin (thread); (vomulaa) spinner, spindle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spin cotton, weave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.35.25; Childs 2000, p. 388: wòmùlló</text></form></note>
    <note><form lang="fr"><text>vanlaandua caa vomullo-a « les femmes habiles à filer » (EXO.35.25) ; bala ndɔlan la sanga a vomullo « ses mains tiennent la quenouille » (PRO.31.19) ; vanaa vomulaa (2SA.3.29).</text></form></note>
  </entry>
  <entry id="vomɔɔ_4415">
    <lexical-unit><form lang="kqs"><text>vomɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viomɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>viomnun</text></form></variant>
    <sense id="vomɔɔ_4415_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>envoyer (qqn), dépêcher ; charger, ordonner</text></gloss>
      <gloss lang="en"><text>send (someone), dispatch; charge, command</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.18.19; Lexique kissi–français, p. 62: vomɔɔ/ vam; Childs 2000, p. 387: wìòmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>i co nɔm vomɔɔ « je vais t'envoyer » (GEN.37.13) ; Mɛlɛka co nɔm mɛlɛkanɔ ndɔɔ vomɔɔ laci « le Seigneur enverra son ange devant toi » (GEN.24.7). Variante viomɔɔ (EXO.4.13). Cf. viamaa « envoyer ». Lexique kissi–français, p. 59 et 62 : radical vam.</text></form></note>
  </entry>
  <entry id="vongɔɔ_4416">
    <lexical-unit><form lang="kqs"><text>vongɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vongɔɔ_4416_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arrêt de la pluie, éclaircie</text></gloss>
      <gloss lang="en"><text>break in the rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vongɔɔ</text></form></note>
  </entry>
  <entry id="vonndo_4417">
    <lexical-unit><form lang="kqs"><text>vonndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vonndo_4417_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou dans un arbre</text></gloss>
      <gloss lang="en"><text>hollow in a tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vonndo</text></form></note>
  </entry>
  <entry id="vonɔnndo_4418">
    <lexical-unit><form lang="kqs"><text>vonɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vonun</text></form></variant>
    <sense id="vonɔnndo_4418_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter (sur soi)</text></gloss>
      <gloss lang="en"><text>carry, wear</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vonɔnndo/ vonun</text></form></note>
  </entry>
  <entry id="vóólun-vóólunndo_4419">
    <lexical-unit><form lang="kqs"><text>vóólun-vóólunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vóólun-vóólun</text></form></variant>
    <variant><form lang="kqs"><text>vóólun-vóólunn</text></form></variant>
    <sense id="vóólun-vóólunndo_4419_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, clameur</text></gloss>
      <gloss lang="en"><text>tumult, uproar, clamour</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(base verb) start from fright, tremble with fear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EZK.12.18; Childs 2000, p. 389: wòòlòó</text></form></note>
    <note><form lang="fr"><text>Cf. vooluo « tressaillir ».</text></form></note>
  </entry>
  <entry id="vooluo_4420">
    <lexical-unit><form lang="kqs"><text>vooluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>voolu</text></form></variant>
    <variant><form lang="kqs"><text>voolunin</text></form></variant>
    <sense id="vooluo_4420_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tressaillir ; surprendre, fondre sur ; être pris au dépourvu, avoir peur de qqch</text></gloss>
      <gloss lang="en"><text>startle; take by surprise, fall upon; be caught off guard, be afraid of something</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Vooluo; Lexique kissi–français, p. 62: vooluo/ voolu</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, voolu signifie « fondre sur, attaquer par surprise » (JOS 10,9). Confirmé au Nord par le Lexique kissi–français, p. 62 (« tressaillir ; surprendre, être pris au dépourvu »).</text></form></note>
  </entry>
  <entry id="voosanndo_4421">
    <lexical-unit><form lang="kqs"><text>voosanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="voosanndo_4421_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entorse</text></gloss>
      <gloss lang="en"><text>sprain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: Voosanndo; Lexique kissi–français, p. 62: voosanndo</text></form></note>
  </entry>
  <entry id="voosu_4422">
    <lexical-unit><form lang="kqs"><text>voosu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>voosun</text></form></variant>
    <sense id="voosu_4422_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figue</text></gloss>
      <gloss lang="en"><text>fig</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fig tree; also a fern-like plant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first NUM.20.5; Childs 2000, p. 389: wòòsóó</text></form></note>
    <note><form lang="fr"><text>voosu tumndo « figuier ».</text></form></note>
  </entry>
  <entry id="vosu_4423">
    <lexical-unit><form lang="kqs"><text>vosu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vosu_4423_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figue ; (vosu tumndo) figuier</text></gloss>
      <gloss lang="en"><text>fig; (vosu tumndo) fig tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JER.8.13; Lexique kissi–français, p. 62: vosuo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit vosuo « le figuier » ; la Bible a vosu tumndo « figuier » (JER.8.13, NAM.3.12).</text></form></note>
  </entry>
  <entry id="vosɛ_4424">
    <lexical-unit><form lang="kqs"><text>vosɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vosɛ_4424_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>salut (adressé à plusieurs) : la vosɛ !</text></gloss>
      <gloss lang="en"><text>greetings (to several people): la vosɛ!</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 21: lavosè; Childs 2000, p. 389: wósè</text></form></note>
    <note><form lang="fr"><text>Keita : isɛ s'adresse à une seule personne, lavosè à deux ou plusieurs. Pluriel de isɛ.</text></form></note>
  </entry>
  <entry id="votanaa_4425">
    <lexical-unit><form lang="kqs"><text>votanaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="votanaa_4425_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à écorce lisse</text></gloss>
      <gloss lang="en"><text>smooth-barked tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: votanaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « un arbre avec l'écorce lisse (où les singes ne montent pas) ».</text></form></note>
  </entry>
  <entry id="vovaa_4426">
    <lexical-unit><form lang="kqs"><text>vovaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vovaa_4426_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>biche, antilope</text></gloss>
      <gloss lang="en"><text>doe, antelope</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first NUM.4.7; Lexique kissi–français, p. 62: vovaa</text></form></note>
    <note><form lang="fr"><text>Dans la liste des animaux purs (DEU.14.5) ; ailleurs vovaa est un homographe (NUM.4.7).</text></form></note>
  </entry>
  <entry id="vovɔɔ_4427">
    <lexical-unit><form lang="kqs"><text>vovɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vaw</text></form></variant>
    <sense id="vovɔɔ_4427_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rester, durer ; retarder</text></gloss>
      <gloss lang="en"><text>stay, last; delay</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vovɔɔ/ vaw</text></form></note>
    <note><form lang="fr"><text>Radical vaw (Lexique, p. 60), homographe de vaw « palmier » (JDG.4.5).</text></form></note>
  </entry>
  <entry id="vowlul_4428">
    <lexical-unit><form lang="kqs"><text>vowlul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vowlulnin</text></form></variant>
    <variant><form lang="kqs"><text>vowlu</text></form></variant>
    <sense id="vowlul_4428_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre (dans), remplir pour (qqn) ; jeter à ; (vowlul X sondo) répondre à X</text></gloss>
      <gloss lang="en"><text>put (into), fill for (someone); throw to; (vowlul X sondo) answer X</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dress someone, put (clothes) on someone; put in for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.44.1; Childs 2000, p. 389: wòùlùlló</text></form></note>
    <note><form lang="fr"><text>Vowlul vannda ha ɲɛdiaa o bɔlɔla ndalan nin « remplis de vivres les sacs de ces hommes » (GEN.44.1) ; Mɛlɛka vowlulnin niaa sondo le « le Seigneur ne vous répondra pas » (1SA.8.18) ; vowlu tunaa cuawva « le jeter aux petits chiens » (MAT.15.26).</text></form></note>
  </entry>
  <entry id="vownun_4429">
    <lexical-unit><form lang="kqs"><text>vownun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vownun_4429_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, revêtir (vêtement, sandales)</text></gloss>
      <gloss lang="en"><text>put on (clothes, sandals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 93 occurrences, first EXO.12.11; Childs 2000, p. 390: wòùwó</text></form></note>
    <note><form lang="fr"><text>Moyen de vowvo.</text></form></note>
  </entry>
  <entry id="vowvo_4430">
    <lexical-unit><form lang="kqs"><text>vowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vow</text></form></variant>
    <variant><form lang="kqs"><text>vownin</text></form></variant>
    <sense id="vowvo_4430_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre dans, verser dans</text></gloss>
      <gloss lang="en"><text>put into, pour into</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put on, wear, fasten</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.42.25; Childs 2000, p. 390: wòùwó</text></form></note>
  </entry>
  <entry id="vowvo_4431">
    <lexical-unit><form lang="kqs"><text>vowvo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>vow</text></form></variant>
    <sense id="vowvo_4431_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'évanouir</text></gloss>
      <gloss lang="en"><text>faint</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vowvo/ vow</text></form></note>
    <note><form lang="fr"><text>Homographe de vowvo « mettre dans » ; le sens « s'évanouir » n'est pas confirmé dans la Bible.</text></form></note>
  </entry>
  <entry id="vueinɔnndo_4432">
    <lexical-unit><form lang="kqs"><text>vueinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vueinun</text></form></variant>
    <variant><form lang="kqs"><text>vueinunnin</text></form></variant>
    <variant><form lang="kqs"><text>vueinɔn</text></form></variant>
    <sense id="vueinɔnndo_4432_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>effrayer, inspirer la terreur ; être redoutable</text></gloss>
      <gloss lang="en"><text>frighten, terrify; be fearsome</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be afraid (middle of 'fear'); variant wèènɔ̌ŋndó, also 'frighten people'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1CH.12.9; Childs 2000, p. 389: wɔ̀ɔ́nɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Cf. vo « craindre ». mɛ̀ɛ́-mɛ̀ɛ́ ya vueinun « ne me crains pas » (JOB.33.7).</text></form></note>
  </entry>
  <entry id="vuilen_4433">
    <lexical-unit><form lang="kqs"><text>vuilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vuilen_4433_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vol, larcin</text></gloss>
      <gloss lang="en"><text>theft, stealing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.30.33; Lexique kissi–français, p. 62: vuilen; Childs 2000, p. 385: wììléŋ</text></form></note>
    <note><form lang="fr"><text>De vuiyo « voleur ». bulio le luɛyɔɔ vuilen « en train d'entrer par effraction pour voler » (EXO.22.1) ; mɛɛ vuilen ya tosa ni « ce serait un vol de ma part » (GEN.30.33) ; o kɔɛ vuilen « il va voler » (JOB.24.14).</text></form></note>
  </entry>
  <entry id="vuiyo_4434">
    <lexical-unit><form lang="kqs"><text>vuiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vuiya</text></form></field>
    <sense id="vuiyo_4434_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voleur</text></gloss>
      <gloss lang="en"><text>thief</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.22.1; Keita 1979, p. 149: Vuiyo; Lexique kissi–français, p. 63: vuiyo; Childs 2000, p. 385: wììnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vukɔɔ_4435">
    <lexical-unit><form lang="kqs"><text>vukɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vukɔɔ_4435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu où se règlent les affaires du village</text></gloss>
      <gloss lang="en"><text>village meeting place for settling disputes</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Vuköö; Lexique kissi–français, p. 63: vukɔɔ</text></form></note>
  </entry>
  <entry id="vulan_4436">
    <lexical-unit><form lang="kqs"><text>vulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vulan_4436_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genoux</text></gloss>
      <gloss lang="en"><text>knees</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>knee (singular, le class)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.17.3; Lexique kissi–français, p. 63: vuran; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>baŋ vulan « s'agenouiller, se prosterner » (Gn 17,3). Le Lexique kissi–français (p. 63) écrit vuran « les genoux » et vuran baŋɔɔ « s'agenouiller, louer, prier ».</text></form></note>
  </entry>
  <entry id="vulen_4437">
    <lexical-unit><form lang="kqs"><text>vulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>vulan</text></form></field>
    <sense id="vulen_4437_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genou</text></gloss>
      <gloss lang="en"><text>knee</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Vulen; Lexique kissi–français, p. 63: vulen; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel vulan attesté : baŋ vulan « s'agenouiller » (Gn 17,3).</text></form></note>
  </entry>
  <entry id="vulɔɔ_4438">
    <lexical-unit><form lang="kqs"><text>vulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vul</text></form></variant>
    <variant><form lang="kqs"><text>vulnin</text></form></variant>
    <sense id="vulɔɔ_4438_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, germer</text></gloss>
      <gloss lang="en"><text>grow, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: thread a needle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.3.18; Lexique kissi–français, p. 63: vulɔɔ/ vul; Childs 2000, p. 392: wùlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vum_4439">
    <lexical-unit><form lang="kqs"><text>vum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vum_4439_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) d'un coup, brusquement (cœur qui bat, feu qui jaillit)</text></gloss>
      <gloss lang="en"><text>(ideophone) suddenly, with a start (pounding heart, fire flaring up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sound of slow regular beating (heartbeat), of a fire being lit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.27.33; Childs 2000, p. 392: wúm</text></form></note>
  </entry>
  <entry id="vundaa_4440">
    <lexical-unit><form lang="kqs"><text>vundaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vundaa_4440_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pleuvoir sans arrêt</text></gloss>
      <gloss lang="en"><text>rain continuously</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: vundaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « (la manière de) pleuvoir constamment ».</text></form></note>
  </entry>
  <entry id="vunduan_4441">
    <lexical-unit><form lang="kqs"><text>vunduan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vunduma</text></form></variant>
    <sense id="vunduan_4441_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre, ombrage (pluriel de vundulen)</text></gloss>
      <gloss lang="en"><text>shade, shadows (plural of vundulen)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural (ma) of 'shade, shadow'; also the soul, an umbrella, an illustration</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOB.7.2; Childs 2000, p. 393: wùndúléŋ</text></form></note>
  </entry>
  <entry id="vundulen_4442">
    <lexical-unit><form lang="kqs"><text>vundulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vundulen_4442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre ; vision ; parapluie ; image ; esprit</text></gloss>
      <gloss lang="en"><text>shadow, shade; vision; umbrella; image; spirit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shade, shadow; the soul of a person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first GEN.15.1; Keita 1979, p. 155: Vundulen; Lexique kissi–français, p. 63: vundulen; Childs 2000, p. 393: wùndúléŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 63 : « l'ombre ; un parapluie ; l'image ; l'esprit ».</text></form></note>
  </entry>
  <entry id="vunɔnndo_4443">
    <lexical-unit><form lang="kqs"><text>vunɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vunun</text></form></variant>
    <sense id="vunɔnndo_4443_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se défendre ; nier, réfuter</text></gloss>
      <gloss lang="en"><text>defend oneself; deny, refute</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: vunɔnndo/ vunun</text></form></note>
  </entry>
  <entry id="vuo_4444">
    <lexical-unit><form lang="kqs"><text>vuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vu</text></form></variant>
    <variant><form lang="kqs"><text>vunin</text></form></variant>
    <variant><form lang="kqs"><text>vi</text></form></variant>
    <variant><form lang="kqs"><text>vinin</text></form></variant>
    <sense id="vuo_4444_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mourir</text></gloss>
      <gloss lang="en"><text>die</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.43.8; Keita 1979, p. 115: Vuo; Lexique kissi–français, p. 63: vuo/ vu, vi; Childs 2000, p. 393: wùó</text></form></note>
    <note><form lang="fr"><text>vi, vinin : radical négatif (EXO 9,4).</text></form></note>
  </entry>
  <entry id="vusuŋaa_4445">
    <lexical-unit><form lang="kqs"><text>vusuŋaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>vusuŋa</text></form></variant>
    <sense id="vusuŋaa_4445_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éroder</text></gloss>
      <gloss lang="en"><text>erode</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: vusuŋaa/ vusuŋa</text></form></note>
    <note><form lang="fr"><text>Le Lexique hésite sur le sens (« éroder ? »).</text></form></note>
  </entry>
  <entry id="vuulu_4446">
    <lexical-unit><form lang="kqs"><text>vuulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vuulu_4446_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter (qqch.) à (qqn)</text></gloss>
      <gloss lang="en"><text>throw (something) to (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw to someone; shoot, thatch for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2SA.20.21; Childs 2000, p. 393: wùùlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de vuuo « jeter ». bolle ndɔlen vuulu o kpakio kɔɔli « on te jettera sa tête par-dessus la muraille » (2SA.20.21) ; la vuulu pewva « ne jetez pas (vos perles) aux porcs » (MAT.7.6).</text></form></note>
  </entry>
  <entry id="vuuo_4447">
    <lexical-unit><form lang="kqs"><text>vuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuu</text></form></variant>
    <sense id="vuuo_4447_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter, lancer ; botter</text></gloss>
      <gloss lang="en"><text>throw, cast; kick</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw (e.g. with a sling); thatch a roof; shoot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.21.20; Lexique kissi–français, p. 63: vuvɔɔ/ vuw; Childs 2000, p. 393: wùùwó</text></form></note>
    <note><form lang="fr"><text>vana caa kpaasiaa vuuo « archer » (Gn 21,20). Le Lexique kissi–français (p. 63) écrit vuvɔɔ/ vuw « jeter, lancer ; botter » et donne vuuo/ vuu au sens de « ramper ».</text></form></note>
  </entry>
  <entry id="vuuo_4448">
    <lexical-unit><form lang="kqs"><text>vuuo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>vuu</text></form></variant>
    <sense id="vuuo_4448_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramper</text></gloss>
      <gloss lang="en"><text>crawl</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: vuuo/ vuu</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, vuuo signifie « jeter, lancer, tirer (flèche) » ; le sens « ramper » donné par le Lexique est à vérifier.</text></form></note>
  </entry>
  <entry id="vuyan-vuyan_4449">
    <lexical-unit><form lang="kqs"><text>vuyan-vuyan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vuyan-vuyan_4449_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en désordre</text></gloss>
      <gloss lang="en"><text>in disorder</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: vuyan-vuyan</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « désordonner ».</text></form></note>
  </entry>
  <entry id="vuɛɛndo_4450">
    <lexical-unit><form lang="kqs"><text>vuɛɛndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuɛɛn</text></form></variant>
    <sense id="vuɛɛndo_4450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme (adulte) ; (vocatif) femme !</text></gloss>
      <gloss lang="en"><text>woman; (vocative) woman!</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first RUT.3.16</text></form></note>
    <note><form lang="fr"><text>vuɛɛn bala fondo pɔnɔɔ vi-o « une pauvre veuve » (MRK.12.42).</text></form></note>
  </entry>
  <entry id="vɔ_4451">
    <lexical-unit><form lang="kqs"><text>vɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ_4451_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>pas encore (vɔ … le)</text></gloss>
      <gloss lang="en"><text>not yet (vɔ … le)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'still, already'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 977 occurrences, first GEN.2.5; Childs 2000, p. 390: wɔ̀</text></form></note>
  </entry>
  <entry id="vɔ le_4452">
    <lexical-unit><form lang="kqs"><text>vɔ le</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ le_4452_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>pas encore</text></gloss>
      <gloss lang="en"><text>not yet</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vɔ re</text></form></note>
    <note><form lang="fr"><text>Ndáà hini vɔ le « ils ne s'étaient pas encore couchés » (GEN.19.4).</text></form></note>
  </entry>
  <entry id="vɔkɔ-vɔkɔɔ_4453">
    <lexical-unit><form lang="kqs"><text>vɔkɔ-vɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔ</text></form></variant>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔlan</text></form></variant>
    <sense id="vɔkɔ-vɔkɔɔ_4453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, agitation</text></gloss>
      <gloss lang="en"><text>uproar, commotion, din</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first PSA.2.1; Lexique kissi–français, p. 62: vɔkɔ-vɔkɔ</text></form></note>
    <note><form lang="fr"><text>Ko vɔkɔ-vɔkɔ bɛndu yɛɛ nɛ co yɛ hoo ? « Pourquoi ce grand tumulte ? » (1KI.1.41). Lexique kissi–français, p. 62 : vɔkɔ-vɔkɔ « (qqch de) desserré qui s'entrechoque ».</text></form></note>
  </entry>
  <entry id="vɔlɔtɔɔ_4454">
    <lexical-unit><form lang="kqs"><text>vɔlɔtɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vɔlɔtɔlan</text></form></field>
    <variant><form lang="kqs"><text>vɔlɔtɔ</text></form></variant>
    <sense id="vɔlɔtɔɔ_4454_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faucille</text></gloss>
      <gloss lang="en"><text>sickle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.8 Agricultural tool"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.23.26; Lexique kissi–français, p. 62: vɔrɔtɔɔ</text></form></note>
  </entry>
  <entry id="vɔlɔɔ_4455">
    <lexical-unit><form lang="kqs"><text>vɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="vɔlɔɔ_4455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perdrix ; volaille de brousse</text></gloss>
      <gloss lang="en"><text>partridge; wild fowl</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bush chicken</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1SA.26.20; Keita 1979, p. 137: Völöö; Lexique kissi–français, p. 62: vɔlɔɔ; Childs 2000, p. 390: wɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 62 : « la volaille de brousse ; la perdrix ».</text></form></note>
  </entry>
  <entry id="vɔ̀lɛ́lan_4456">
    <lexical-unit><form lang="kqs"><text>vɔ̀lɛ́lan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔ̀lɛ́la</text></form></variant>
    <sense id="vɔ̀lɛ́lan_4456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, parcs (à bétail)</text></gloss>
      <gloss lang="en"><text>folds, pens (for livestock)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.32.16</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="vɔmbaa_4457">
    <lexical-unit><form lang="kqs"><text>vɔmbaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vɔmba</text></form></variant>
    <sense id="vɔmbaa_4457_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>coucher les hautes herbes pour dégager le chemin</text></gloss>
      <gloss lang="en"><text>flatten tall grass to clear a path</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vɔnbaa/ vɔnba</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb.</text></form></note>
  </entry>
  <entry id="vɔmbɔɔ_4458">
    <lexical-unit><form lang="kqs"><text>vɔmbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vɔmbɔɔ_4458_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>selle (de cheval)</text></gloss>
      <gloss lang="en"><text>saddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vɔnbɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb.</text></form></note>
  </entry>
  <entry id="vɔmndo_4459">
    <lexical-unit><form lang="kqs"><text>vɔmndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔm</text></form></variant>
    <sense id="vɔmndo_4459_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire la battue, traquer</text></gloss>
      <gloss lang="en"><text>beat (for game), hunt down</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HOS.5.8; Keita 1979, p. 114: Vömndo; Lexique kissi–français, p. 62: vɔmndo/ vɔm</text></form></note>
    <note><form lang="fr"><text>vɔm « chasser, traquer » (JER 16,16).</text></form></note>
  </entry>
  <entry id="vɔngoo_4460">
    <lexical-unit><form lang="kqs"><text>vɔngoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔngu</text></form></variant>
    <sense id="vɔngoo_4460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix, paiement ; achat</text></gloss>
      <gloss lang="en"><text>price, payment; purchase</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.23.15; Lexique kissi–français, p. 62: vɔnguo; Childs 2000, p. 390: wɔ̀ŋgɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 62 : vɔnguo « le prix ; l'achat » ; vɔngo « la prise ».</text></form></note>
  </entry>
  <entry id="vɔ̀ngɔ̀_4461">
    <lexical-unit><form lang="kqs"><text>vɔ̀ngɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ̀ngɔ̀_4461_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>récompense, salaire</text></gloss>
      <gloss lang="en"><text>reward, wages</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.15.1</text></form></note>
  </entry>
  <entry id="vɔsio_4462">
    <lexical-unit><form lang="kqs"><text>vɔsio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vɔsilan</text></form></field>
    <sense id="vɔsio_4462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>année</text></gloss>
      <gloss lang="en"><text>year</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.1.14; Keita 1979, p. 152: Vösio; Lexique kissi–français, p. 62: vɔsio; Childs 2000, p. 391: wɔ̀sìɛ́í</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 62) donne aussi vɔsie « l'an ».</text></form></note>
  </entry>
  <entry id="vɔsuo_4463">
    <lexical-unit><form lang="kqs"><text>vɔsuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vɔsu</text></form></variant>
    <sense id="vɔsuo_4463_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essuyer, effacer</text></gloss>
      <gloss lang="en"><text>wipe, erase</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vɔsuo/ vɔsu</text></form></note>
  </entry>
  <entry id="vɔsɔkɔɔ_4464">
    <lexical-unit><form lang="kqs"><text>vɔsɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔsɔkɔɔ_4464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sol pierreux, terrain rocailleux</text></gloss>
      <gloss lang="en"><text>stony ground, rocky soil</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gravel; gravelly upland soils</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MRK.4.5; Childs 2000, p. 391: wɔ̀sɔ̀kɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Mí n tiŋ deli o vɔsɔkɔɔ nin « d'autres tombèrent sur le sol pierreux » (MRK.4.5).</text></form></note>
  </entry>
  <entry id="vɔw_4465">
    <lexical-unit><form lang="kqs"><text>vɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔwnin</text></form></variant>
    <sense id="vɔw_4465_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être mauvais, être laid ; être terrible, grave</text></gloss>
      <gloss lang="en"><text>be bad, be ugly; be severe</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first EXO.9.24; Childs 2000, p. 391: wɔ̀ùwó</text></form></note>
    <note><form lang="fr"><text>Cf. vɔɔndo « mauvais ».</text></form></note>
  </entry>
  <entry id="vɔwlen_4466">
    <lexical-unit><form lang="kqs"><text>vɔwlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔwle</text></form></variant>
    <sense id="vɔwlen_4466_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>laideur, mauvaise qualité ; pire ; méchanceté, danger</text></gloss>
      <gloss lang="en"><text>ugliness, badness; worse; wickedness, danger</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.41.19; Lexique kissi–français, p. 62: vɔwlen</text></form></note>
    <note><form lang="fr"><text>De vɔw. Lexique kissi–français, p. 62 : vɔwlen « méchanceté, danger » ; vɔwvo « être méchant, dangereux ».</text></form></note>
  </entry>
  <entry id="vɔyɔn_4467">
    <lexical-unit><form lang="kqs"><text>vɔyɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔyɔn_4467_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(s'asseoir par terre) tout abattu, prostré</text></gloss>
      <gloss lang="en"><text>(sit on the ground) dejectedly, slumped</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1.2 Sit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>describes relaxing or sitting</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.3.26; Childs 2000, p. 392: wɔ́yɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Toujours après cal lɛŋ « s'asseoir par terre » : La cal lɛŋ vɔyɔn « assieds-toi par terre » (ISA.47.1 ; aussi ISA.3.26, EZK.26.16).</text></form></note>
  </entry>
  <entry id="vɔ́yɔ́ɔ́_4468">
    <lexical-unit><form lang="kqs"><text>vɔ́yɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ́yɔ́ɔ́_4468_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>restes (de nourriture), reste</text></gloss>
      <gloss lang="en"><text>leftovers, remainder (of food)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.2.14; Childs 2000, p. 392: wɔ́yɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>mó dia, mó pum, mó mɛi vɔ́yɔ́ɔ́ « elle mangea, se rassasia et en garda un reste » (RUT.2.14).</text></form></note>
  </entry>
  <entry id="vɔɔ_4469">
    <lexical-unit><form lang="kqs"><text>vɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>va</text></form></variant>
    <sense id="vɔɔ_4469_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper avec une pierre</text></gloss>
      <gloss lang="en"><text>strike with a stone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 62: vɔɔ/ va</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi le radical va seul (p. 59).</text></form></note>
  </entry>
  <entry id="vɔɔca_4470">
    <lexical-unit><form lang="kqs"><text>vɔɔca</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔcan</text></form></variant>
    <sense id="vɔɔca_4470_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pétrir, mélanger (farine et huile) ; (vɔɔcan) pétri, mêlé</text></gloss>
      <gloss lang="en"><text>knead, mix (flour with oil); (vɔɔcan) mixed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.29.2</text></form></note>
    <note><form lang="fr"><text>kpeyan vɔɔcan a cuɛiyan « farine pétrie à l'huile » (LEV.9.4).</text></form></note>
  </entry>
  <entry id="vɔɔciaa_4471">
    <lexical-unit><form lang="kqs"><text>vɔɔciaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔciaanin</text></form></variant>
    <sense id="vɔɔciaa_4471_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écraser, broyer, mettre en pièces</text></gloss>
      <gloss lang="en"><text>crush, dash to pieces</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze; arrange</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first 2SA.22.39; Childs 2000, p. 391: wɔ̀ɔ̀cìá</text></form></note>
  </entry>
  <entry id="vɔɔlen_4472">
    <lexical-unit><form lang="kqs"><text>vɔɔlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vɔɔlen_4472_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>saison sèche</text></gloss>
      <gloss lang="en"><text>dry season</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.8.22; Keita 1979, p. 154: Vöölen; Lexique kissi–français, p. 62: vɔɔlen; Childs 2000, p. 391: wɔ̀ɔ̀léŋ</text></form></note>
  </entry>
  <entry id="vɔɔndo_4473">
    <lexical-unit><form lang="kqs"><text>vɔɔndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔn</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnda</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnnda</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnndan</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnndon</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnde</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔnnden</text></form></variant>
    <sense id="vɔɔndo_4473_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mauvais, méchant ; dangereux, malfaisant ; laid</text></gloss>
      <gloss lang="en"><text>bad, evil, wicked; dangerous, harmful; ugly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bad, evil; also ugly (wɔ̀ùwó 'be bad or ugly')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 547 occurrences, first GEN.2.9; Lexique kissi–français, p. 62: vɔndo; Childs 2000, p. 391: wɔ̀ɔ́ŋ</text></form></note>
    <note><form lang="fr"><text>Homonyme de vɔɔndo « aisselle ». dɛnɛ vɔɔndo « le mal ». Lexique kissi–français, p. 62 : vɔndo « mauvais, malfaisant, dangereux, laid » ; vɔnndo « qqch qui est mauvais ».</text></form></note>
  </entry>
  <entry id="vɔɔndo_4474">
    <lexical-unit><form lang="kqs"><text>vɔɔndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="vɔɔndo_4474_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aisselle</text></gloss>
      <gloss lang="en"><text>armpit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>armpit; bosom</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 547 occurrences, first GEN.2.9; Keita 1979, p. 133: Vööndo; Lexique kissi–français, p. 62: vɔɔndo; Childs 2000, p. 391: wɔ̀ɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs. Dans la Bible, vɔɔndo est surtout un homographe, « mauvais, mal » ; « sous les aisselles » s'y dit o lavɔɔn (Jr 38,12). Le Lexique kissi–français (p. 62) écrit aussi vɔɔnndo.</text></form></note>
  </entry>
  <entry id="vɔɔsuuo_4475">
    <lexical-unit><form lang="kqs"><text>vɔɔsuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɔsuu</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsuunin</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsu</text></form></variant>
    <variant><form lang="kqs"><text>vɔɔsun</text></form></variant>
    <sense id="vɔɔsuuo_4475_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essuyer, effacer ; pardonner (les péchés) ; moucher (les lampes)</text></gloss>
      <gloss lang="en"><text>wipe, wipe away, blot out; forgive (sins); trim (lamps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wipe off, clean, erase; brush off, rub</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.30.7; Childs 2000, p. 391: wɔ̀ɔ̀sùùwó</text></form></note>
    <note><form lang="fr"><text>vɔɔsun (moyen) « être effacé, disparaître ; effleurer » (NUM.5.23, ISA.24.11, JOS.19.26) ; Hala vɔɔsuunin nda mɛmɛan kpow « Dieu essuiera toutes leurs larmes » (REV.7.17).</text></form></note>
  </entry>
  <entry id="vɔɛiyo_4476">
    <lexical-unit><form lang="kqs"><text>vɔɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɛi</text></form></variant>
    <variant><form lang="kqs"><text>vɔɛinin</text></form></variant>
    <sense id="vɔɛiyo_4476_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>téter, sucer ; baiser (les pieds) ; (nom) nourrisson</text></gloss>
      <gloss lang="en"><text>suck (at the breast); kiss; (noun) suckling</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nurse (a baby), suck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first DEU.32.25; Childs 2000, p. 384: wɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>mó va mun vɔɛiyo « elle les baisait » (LUK.7.38) ; vɔɛi « téter » (ISA.66.11).</text></form></note>
  </entry>
  <entry id="vɔɛsio_4477">
    <lexical-unit><form lang="kqs"><text>vɔɛsio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔɛsi</text></form></variant>
    <variant><form lang="kqs"><text>vɔɛsil</text></form></variant>
    <sense id="vɔɛsio_4477_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allaiter, nourrir au sein</text></gloss>
      <gloss lang="en"><text>breastfeed, nurse</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.2.9; Childs 2000, p. 384: wɛ̀sìɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>Causatif de vɔɛiyo. vɔɛsil (bénéfactif) « allaiter pour qqn » (EXO.2.7).</text></form></note>
  </entry>
  <entry id="vɛ_4478">
    <lexical-unit><form lang="kqs"><text>vɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
