    <trait name="status" value="respelled"/>
    <sense id="telele_5160_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abstrait (nom), abstraction</text></gloss>
      <gloss lang="en"><text>abstract noun, abstraction</text></gloss>
