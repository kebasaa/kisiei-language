    <variant><form lang="kqs"><text>cuungiaanin</text></form></variant>
    <sense id="cuungiaa_191_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, réunir</text></gloss>
      <gloss lang="en"><text>gather, assemble</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, collect; also contribute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 175 occurrences, first GEN.9.14; Childs 2000, p. 68: cùùŋgìá</text></form></note>
  </entry>
