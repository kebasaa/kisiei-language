    <trait name="status" value="respelled"/>
    <sense id="beluo_201_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ourlet ; première couche de paille d'une case</text></gloss>
      <gloss lang="en"><text>hem; first layer of thatch on a hut</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: beluo</text></form></note>
