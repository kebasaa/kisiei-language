  <entry id="ŋàlàŋàfòó_4056">
    <lexical-unit><form lang="kqs"><text>ŋàlàŋàfòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ŋàlàŋàfùá</text></form></field>
    <variant><form lang="kqs"><text>ŋàlàŋàfóó</text></form></variant>
    <sense id="ŋàlàŋàfòó_4056_s1">
