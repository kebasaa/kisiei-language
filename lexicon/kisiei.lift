      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 100 occurrences, first GEN.36.7; Childs 2000, p. 226: lèèyɔ́</text></form></note>
  </entry>
