    <note type="source"><form lang="en"><text>BKG: 38 occurrences, first GEN.38.9</text></form></note>
    <note><form lang="fr"><text>tosa kpelemɔɔsaa « avoir des rapports ».</text></form></note>
  </entry>
  <entry id="kpélén_1857">
    <lexical-unit><form lang="kqs"><text>kpélén</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpélén_1857_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>fort (crier, pleurer)</text></gloss>
      <gloss lang="en"><text>loudly (cry, weep)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>loudly, clearly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 68 occurrences, first GEN.27.38; Childs 2000, p. 209: kpéléŋ</text></form></note>
  </entry>
  <entry id="kpelenkpelennde_1858">
