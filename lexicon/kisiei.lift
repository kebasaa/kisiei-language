    </sense>
    <note type="source"><form lang="en"><text>BKG: 104 occurrences, first GEN.22.8</text></form></note>
    <note><form lang="fr"><text>saa téndóó « agneau » ; sofɛlɛ téndóó « ânon ».</text></form></note>
  </entry>
  <entry id="tendu_1646">
    <lexical-unit><form lang="kqs"><text>tendu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tendu_1646_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réveiller ; se lever</text></gloss>
      <gloss lang="en"><text>wake up; rise</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wake oneself; come back to life</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first GEN.28.16; Childs 2000, p. 360: tìndìŋndó</text></form></note>
  </entry>
  <entry id="tendul_1647">
    <lexical-unit><form lang="kqs"><text>tendul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
