      <gloss lang="en"><text>bur, sticky seed</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: dààdɔ́kpùɛ́í</text></form></note>
  </entry>
  <entry id="dáàkpàkpà_619">
    <lexical-unit><form lang="kqs"><text>dáàkpàkpà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dáàkpàkpà_619_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>épais, visqueux, collant</text></gloss>
      <gloss lang="en"><text>thick, viscous, sticky</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: dáàkpàkpà</text></form></note>
  </entry>
  <entry id="daama_620">
    <lexical-unit><form lang="kqs"><text>daama</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="daama_620_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>seulement</text></gloss>
      <gloss lang="en"><text>only</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 232 occurrences, first GEN.23.15; Childs 2000, p. 69: dààmà</text></form></note>
  </entry>
  <entry id="dáfìfìdáá_621">
    <lexical-unit><form lang="kqs"><text>dáfìfìdáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dáfìfìdáá_621_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>farine de riz frit puis pilé (« pain du pays »)</text></gloss>
      <gloss lang="en"><text>flour of fried then pounded rice ("country bread")</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dáfìfìdáá</text></form></note>
  </entry>
  <entry id="dàkàlàkàɲàá_622">
    <lexical-unit><form lang="kqs"><text>dàkàlàkàɲàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dàkàlàkàɲàá_622_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'oiseau</text></gloss>
      <gloss lang="en"><text>species of bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dàkàlàkàɲàá</text></form></note>
  </entry>
  <entry id="dákpéŋndó_623">
    <lexical-unit><form lang="kqs"><text>dákpéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dákpéŋndó_623_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>linteau, cadre de porte</text></gloss>
      <gloss lang="en"><text>lintel, door frame</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dákpéŋndó</text></form></note>
  </entry>
  <entry id="dalaa_624">
    <lexical-unit><form lang="kqs"><text>dalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dalalan</text></form></field>
    <sense id="dalaa_624_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étang, mare, lac</text></gloss>
      <gloss lang="en"><text>pond, pool, lake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first JOS.11.2; Keita 1979, p. 155: Dalaa</text></form></note>
  </entry>
  <entry id="dáléŋndó_625">
    <lexical-unit><form lang="kqs"><text>dáléŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dáléŋndó_625_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fenêtre</text></gloss>
      <gloss lang="en"><text>window</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dáléŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible dit dio-pɔmbɔɔ « petite porte » pour « fenêtre » (JOS.2.15, ACT.20.9).</text></form></note>
  </entry>
  <entry id="dâlíí_626">
    <lexical-unit><form lang="kqs"><text>dâlíí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dâlíí_626_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très collant (souligne le caractère collant)</text></gloss>
      <gloss lang="en"><text>very sticky</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dâlíí</text></form></note>
  </entry>
  <entry id="dámbélé_627">
    <lexical-unit><form lang="kqs"><text>dámbélé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dámbélé_627_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>brusquement, soudain</text></gloss>
      <gloss lang="en"><text>abruptly, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dámbélé</text></form></note>
  </entry>
  <entry id="dandaa_628">
    <lexical-unit><form lang="kqs"><text>dandaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>danda</text></form></variant>
    <sense id="dandaa_628_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soin, remède, guérison</text></gloss>
      <gloss lang="en"><text>treatment, remedy, healing</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.147.3; Childs 2000, p. 70: dándàá</text></form></note>
    <note><form lang="fr"><text>nɔ danda le « incurable » (Jr 30,12) ; danda dɔwnɔn « être guéri » (Jr 15,18).</text></form></note>
  </entry>
  <entry id="dangaa_629">
