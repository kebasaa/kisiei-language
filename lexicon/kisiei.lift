    <trait name="status" value="attested"/>
    <sense id="siaa_4508_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pleuvoir</text></gloss>
      <gloss lang="en"><text>rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.7.4; Keita 1979, p. 115: Siaa; Paulme 1964, p. 92: sia, siya; Lexique kissi–français, p. 49: siaa/ sia, se</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : sia, se. piɔɔ siaa « la pluie tombe » (GEN 7,4). Paulme 1964, p. 92 : Hala sia « la pluie tombe » ; Hala sialni « la tornade tombera ».</text></form></note>
  </entry>
  <entry id="sìááŋàá_4509">
    <lexical-unit><form lang="kqs"><text>sìááŋàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìááŋàá_4509_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu des affaires secrètes (société initiatique)</text></gloss>
      <gloss lang="en"><text>place where secret affairs are conducted</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 329: sìááŋàá</text></form></note>
  </entry>
  <entry id="síábú-síábú_4510">
    <lexical-unit><form lang="kqs"><text>síábú-síábú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="síábú-síábú_4510_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bien droit, tendu (ce qui était plié)</text></gloss>
      <gloss lang="en"><text>straightened out (of something bent)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 329: síábú-síábú</text></form></note>
  </entry>
  <entry id="siaiye_4511">
    <lexical-unit><form lang="kqs"><text>siaiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>siaiyon</text></form></field>
    <variant><form lang="kqs"><text>siayii</text></form></variant>
    <sense id="siaiye_4511_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>barbe ; moustache</text></gloss>
      <gloss lang="en"><text>beard; moustache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1SA.21.14; Paulme 1964, p. 90: saye; Lexique kissi–français, p. 45: saiye; Childs 2000, p. 331: sìɛ̀íyé</text></form></note>
    <note><form lang="fr"><text>siayii (Lv 13,45 ; Nb 6,5) en est une variante. Lexique kissi–français, p. 45 écrit saiye « la barbe ». Paulme 1964, p. 90 : « barbe, moustache ».</text></form></note>
  </entry>
  <entry id="siaiye leco_4512">
    <lexical-unit><form lang="kqs"><text>siaiye leco</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siaiye leco_4512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustache</text></gloss>
      <gloss lang="en"><text>moustache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: saiye leco</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit saiye leco ; siaiye « barbe » selon la Bible.</text></form></note>
  </entry>
  <entry id="sialaa_4513">
    <lexical-unit><form lang="kqs"><text>sialaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sial</text></form></variant>
    <sense id="sialaa_4513_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tailler, graver (la pierre) ; scier</text></gloss>
      <gloss lang="en"><text>cut, engrave (stone); saw</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first 2SA.5.11; Lexique kissi–français, p. 46: sal</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : sal (rad) « scier » (sans le i après s).</text></form></note>
  </entry>
  <entry id="sialten_4514">
    <lexical-unit><form lang="kqs"><text>sialten</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sallɛn</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>siaale</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="sialten_4514_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>saison des pluies</text></gloss>
      <gloss lang="en"><text>rainy season</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.8.22; Keita 1979, p. 154: Sialten; Paulme 1964, p. 87 (G/K): sallɛ̃ /K./, syāle /G./; Lexique kissi–français, p. 46: sallen; Childs 2000, p. 329: sìàlléŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 écrit sallen « la saison de pluie ». Aussi Lexique kissi–français, p. 49 : « sialten ». Paulme : sallɛ̃ /K./, syāle /G./ (p. 87).</text></form></note>
  </entry>
  <entry id="siama_4515">
    <lexical-unit><form lang="kqs"><text>siama</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siama_4515_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>nombreux, beaucoup de</text></gloss>
      <gloss lang="en"><text>many, numerous</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a lot, many</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LUK.4.41; Lexique kissi–français, p. 49: siama; Childs 2000, p. 329: síáámá-</text></form></note>
    <note><form lang="fr"><text>Un seul emploi : ɲinaa vɔɔnda bɛɛ va fulaa vanaa siama nin « des démons sortaient aussi de beaucoup de gens » (LUK.4.41).</text></form></note>
  </entry>
  <entry id="sìámbùíyó_4516">
    <lexical-unit><form lang="kqs"><text>sìámbùíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìámbùíyó_4516_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure standard (pour le riz)</text></gloss>
      <gloss lang="en"><text>standard unit of measure (rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: sìámbùíyó</text></form></note>
  </entry>
  <entry id="siamndo_4517">
    <lexical-unit><form lang="kqs"><text>siamndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="siamndo_4517_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pintade</text></gloss>
      <gloss lang="en"><text>guinea fowl</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.6 Poultry raising"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Siamndo; Paulme 1964, p. 88: samudo, pl. samuda; Lexique kissi–français, p. 49: siamndo; Childs 2000, p. 330: sìámndó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 88 : samudo, pl. samuda « pintade » ; samudo tyã « la pintade crie ».</text></form></note>
  </entry>
  <entry id="sìàmsíámndó_4518">
    <lexical-unit><form lang="kqs"><text>sìàmsíámndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìàmsíámndó_4518_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>minuscule sauterelle verte comestible</text></gloss>
      <gloss lang="en"><text>tiny edible green grasshopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: sìàmsíámndó</text></form></note>
  </entry>
  <entry id="siandaa_4519">
    <lexical-unit><form lang="kqs"><text>siandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siandaa_4519_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petites écrevisses</text></gloss>
      <gloss lang="en"><text>small crayfish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: siandaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne « les petits écrevisses » (pluriel ?). Comparer le kissi du Sud sìàndàléŋ « écrevisse ».</text></form></note>
  </entry>
  <entry id="sìàndàléŋ_4520">
    <lexical-unit><form lang="kqs"><text>sìàndàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sìàndàléŋ_4520_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écrevisse</text></gloss>
      <gloss lang="en"><text>crayfish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: sìàndàléŋ</text></form></note>
  </entry>
  <entry id="siangu_4521">
    <lexical-unit><form lang="kqs"><text>siangu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siangu_4521_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir, se rétablir ; se soigner</text></gloss>
      <gloss lang="en"><text>get well, recover; treat oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first JOS.5.8; Lexique kissi–français, p. 46: sangu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : écrit sangu (radical).</text></form></note>
  </entry>
  <entry id="sianio_4522">
    <lexical-unit><form lang="kqs"><text>sianio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sianio_4522_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouteille, flacon</text></gloss>
      <gloss lang="en"><text>bottle, flask</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first NUM.4.11; Keita 1979, p. 159: Sianio; Lexique kissi–français, p. 49: sianio; Childs 2000, p. 320: sàɲìó</text></form></note>
  </entry>
  <entry id="sianion_4523">
    <lexical-unit><form lang="kqs"><text>sianion</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sianin</text></form></variant>
    <variant><form lang="kqs"><text>saɲi</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="sianion_4523_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>or</text></gloss>
      <gloss lang="en"><text>gold</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 264 occurrences, first GEN.2.11; Paulme 1964, p. 88: sanye, sanyi, pl. sanyo; Lexique kissi–français, p. 46: sanie; Childs 2000, p. 320: sánìèí</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : écrit sanie (suivi de sanion, sans définition). Paulme 1964, p. 88 : kɛlɛ sanyi « bague en or » ; yɔwɛ sanyo « bijou de cou en or » ; p. 92 : sianye /G./, sanyi /K./. Paulme : sianye /G./, sanyi /K./ (p. 92).</text></form></note>
  </entry>
  <entry id="siasoa_4524">
    <lexical-unit><form lang="kqs"><text>siasoa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siasoa_4524_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cailles</text></gloss>
      <gloss lang="en"><text>quails</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a chicken-like bird with red feet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.16; Childs 2000, p. 330: sìàsòó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="siawlen_4525">
    <lexical-unit><form lang="kqs"><text>siawlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sawele</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="siawlen_4525_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orange</text></gloss>
      <gloss lang="en"><text>orange</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Siawlen; Paulme 1964, p. 92 (G/K): siaole /G./; Lexique kissi–français, p. 49: siawlen; Childs 2000, p. 330: síáùwáŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 47 : aussi saulen. Paulme 1964, p. 92 : siaole /G./, sawele /K./, pl. sawa « orange » ; siaotumdo, sautundo, sawo « oranger ». Paulme : siaole /G./ ; sawele /K./, pl. sawa (p. 92).</text></form></note>
  </entry>
  <entry id="síáŋ_4526">
    <lexical-unit><form lang="kqs"><text>síáŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="síáŋ_4526_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>fixement (regarder sans cligner)</text></gloss>
      <gloss lang="en"><text>staring intently, unblinkingly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: síáŋ</text></form></note>
  </entry>
  <entry id="siaŋaa_4527">
    <lexical-unit><form lang="kqs"><text>siaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siaŋa</text></form></variant>
    <variant><form lang="kqs"><text>siaŋala</text></form></variant>
    <sense id="siaŋaa_4527_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rouge ; écarlate</text></gloss>
      <gloss lang="en"><text>red; scarlet</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>red, yellow; ripe; light-skinned</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first GEN.25.30; Paulme 1964, p. 88: saŋa, saŋi; Lexique kissi–français, p. 46: saŋaa; Terminologie (arts), n° 251: Sianha (van); Childs 2000, p. 330: sìàŋà-</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : écrit saŋaa. Paulme 1964, p. 88 : kɔlo saŋa « kola rouge » ; kowã saŋya « le sang est rouge ». Académie des langues (terminologie, arts n° 251) : « rouge ».</text></form></note>
  </entry>
  <entry id="sìàŋndéŋ_4528">
    <lexical-unit><form lang="kqs"><text>sìàŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sìàŋndéŋ_4528_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante médicinale (signe d'interdit à la limite du bois sacré)</text></gloss>
      <gloss lang="en"><text>medicinal plant (used as a warning sign at a secret-society boundary)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: sìàŋndéŋ</text></form></note>
  </entry>
  <entry id="siaŋndo_4529">
    <lexical-unit><form lang="kqs"><text>siaŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="siaŋndo_4529_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourmi magnan (fourmi légionnaire)</text></gloss>
      <gloss lang="en"><text>army ant, driver ant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sanndo; Childs 2000, p. 330: sìàŋndó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 46 : sanndo, pl. sannda « fourmis magnan » ; graphie siaŋndo d'après siaŋaa, sianion, siangu, que le Lexique écrit aussi sa-.</text></form></note>
  </entry>
  <entry id="síàŋndó_4530">
    <lexical-unit><form lang="kqs"><text>síàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="síàŋndó_4530_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épervier (rapace qui prend les poulets)</text></gloss>
      <gloss lang="en"><text>chicken hawk</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 330: síàŋndó</text></form></note>
  </entry>
  <entry id="sieesiɛi luɛyɔɔ_4531">
    <lexical-unit><form lang="kqs"><text>sieesiɛi luɛyɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sieesiɛi luɛyɔɔ_4531_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>révolte</text></gloss>
      <gloss lang="en"><text>revolt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 553: Sieesièi luèyöö, työnönndo isisi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi cɔnɔnndo isisi (cf. piaasiaa « insurrection »).</text></form></note>
  </entry>
  <entry id="sifflo_4532">
    <lexical-unit><form lang="kqs"><text>sifflo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sifflo_4532_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>siffler</text></gloss>
      <gloss lang="en"><text>whistle</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: sifflo</text></form></note>
    <note><form lang="fr"><text>Emprunt (français siffler).</text></form></note>
  </entry>
  <entry id="sigalɛtio_4533">
    <lexical-unit><form lang="kqs"><text>sigalɛtio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sigarɛtio</text></form></variant>
    <sense id="sigalɛtio_4533_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cigarette</text></gloss>
      <gloss lang="en"><text>cigarette</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: sigarɛtio</text></form></note>
    <note><form lang="fr"><text>Emprunt (français cigarette). Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="sii_4534">
    <lexical-unit><form lang="kqs"><text>sii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sii_4534_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>seulement, rien que ; (haliko sii) pourvu que</text></gloss>
      <gloss lang="en"><text>only, just, merely; (haliko sii) provided that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>only, just</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first JOS.22.24; Childs 2000, p. 332: síí</text></form></note>
    <note><form lang="fr"><text>Tueyɔɔ sii ndáà tuei ni « ils entendaient seulement dire » (GAL.1.23) ; Loonun maa hoeiye sii yoomu nuu co ni « souviens-toi que ma vie n'est qu'un souffle » (JOB.7.7) ; haliko sii sɔɛi Krista-e i co diminndo « pourvu que le Christ soit annoncé » (PHP.1.18).</text></form></note>
  </entry>
  <entry id="sìì_4535">
    <lexical-unit><form lang="kqs"><text>sìì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sìì_4535_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un peu (temps, distance)</text></gloss>
      <gloss lang="en"><text>a little (time, distance)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 332: sìì</text></form></note>
  </entry>
  <entry id="sììfáá_4536">
    <lexical-unit><form lang="kqs"><text>sììfáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sììfáá_4536_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat de Gambie (rongeur qui mange les poulets)</text></gloss>
      <gloss lang="en"><text>giant pouched rat (rodent that eats chickens)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 332: sììfáá</text></form></note>
    <note><form lang="fr"><text>Cricetomys gambianus.</text></form></note>
  </entry>
  <entry id="siilian_4537">
    <lexical-unit><form lang="kqs"><text>siilian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siilianndo</text></form></variant>
    <sense id="siilian_4537_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'exhorter, s'avertir (mutuellement)</text></gloss>
      <gloss lang="en"><text>admonish, exhort (one another)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>advise (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first COL.3.16; Childs 2000, p. 332: sììlìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de silaa « conseiller ». La pɛɛkuan mì la siilian vellaa-velle « instruisez-vous et exhortez-vous les uns les autres » (COL.3.16) ; siilianndo vellaa-velle (ROM.15.14, HEB.10.25).</text></form></note>
  </entry>
  <entry id="siilu_4538">
    <lexical-unit><form lang="kqs"><text>siilu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siilu_4538_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>charger (un fardeau sur qqn), aider à charger</text></gloss>
      <gloss lang="en"><text>load (a burden onto someone), help to load</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1KI.12.11; Lexique kissi–français, p. 49: siiluo/ siilu</text></form></note>
    <note><form lang="fr"><text>Forme longue siiluo (Lexique), non relevée dans la Bible.</text></form></note>
  </entry>
  <entry id="siiluu_4539">
    <lexical-unit><form lang="kqs"><text>siiluu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siilun</text></form></variant>
    <sense id="siiluu_4539_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>charger (sur quelqu'un) ; (siilun) porter (sur soi)</text></gloss>
      <gloss lang="en"><text>load (onto someone); (siilun) carry, take up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>help with a head load, lift a load onto someone's head</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.22.6; Childs 2000, p. 332: sììlùùwɔ́</text></form></note>
  </entry>
  <entry id="siiman_4540">
    <lexical-unit><form lang="kqs"><text>siiman</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siimanndo</text></form></variant>
    <sense id="siiman_4540_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>égaler, être comparable à ; juste, exact</text></gloss>
      <gloss lang="en"><text>be equal to, be comparable to; exact, right</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.9.14; Paulme 1964, p. 92: simã; Childs 2000, p. 332: sììmăŋndó</text></form></note>
    <note><form lang="fr"><text>vana-vana siiman a Hala le « nul n'est semblable à Dieu » (Dt 33,26). Paulme 1964, p. 92 : ɔ simã « c'est juste » ; ɔ simã binybiny « c'est juste (les plateaux de la balance sont égaux) ».</text></form></note>
  </entry>
  <entry id="siimiaa_4541">
    <lexical-unit><form lang="kqs"><text>siimiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>siimia</text></form></variant>
    <sense id="siimiaa_4541_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre égal, considérer comme égal</text></gloss>
      <gloss lang="en"><text>make equal, consider equal</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: siimiaa/ siimia</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation au radical.</text></form></note>
  </entry>
  <entry id="siimian_4542">
    <lexical-unit><form lang="kqs"><text>siimian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siimian_4542_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aplanir, rendre droit (un chemin)</text></gloss>
      <gloss lang="en"><text>level, make straight (a road)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of 'be equal': be all the same</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.40.3; Childs 2000, p. 333: sììmìáŋndó</text></form></note>
    <note><form lang="fr"><text>Sans doute causatif de siiman « égaler ».</text></form></note>
  </entry>
  <entry id="siimianndo_4543">
    <lexical-unit><form lang="kqs"><text>siimianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siimianndo_4543_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>régler</text></gloss>
      <gloss lang="en"><text>adjust, tune</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 221: Siimianndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="siinguuo_4544">
    <lexical-unit><form lang="kqs"><text>siinguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siinguu</text></form></variant>
    <variant><form lang="kqs"><text>siinguunin</text></form></variant>
    <sense id="siinguuo_4544_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire de, rendre, établir (comme) ; consacrer</text></gloss>
      <gloss lang="en"><text>make (into), appoint, set apart</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.20.2; Terminologie (histoire), n° 82: Siinguuo maa… sinnönndo</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 82) : siinguuo maa… sinnönndo « assimilation » (litt. « rendre semblable à… »).</text></form></note>
  </entry>
  <entry id="siinguuo ɲɛ lelɛn_4545">
    <lexical-unit><form lang="kqs"><text>siinguuo ɲɛ lelɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siinguuo ɲɛ lelɛn_4545_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nationalisation</text></gloss>
      <gloss lang="en"><text>nationalization</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 446: Siinguuo nyè lelèn</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « faire devenir chose nationale » (siinguuo « faire de »).</text></form></note>
  </entry>
  <entry id="siinian_4546">
    <lexical-unit><form lang="kqs"><text>siinian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siinian_4546_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>connaître (des gens) ; (vanaa … siinian) connaissances, relations</text></gloss>
      <gloss lang="en"><text>know (people); (vanaa … siinian) acquaintances</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>know (many things), benefactive plural of 'know'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2KI.12.6; Childs 2000, p. 333: sììnìáŋndó</text></form></note>
    <note><form lang="fr"><text>Pluriel de sinaa « savoir, connaître ». vanaa ndáà siinian-nda kpede « tous ceux qui le connaissaient » (JOB.42.11) ; vanaa nda siinian-nda (2KI.12.6).</text></form></note>
  </entry>
  <entry id="siiyon yiiyo_4547">
    <lexical-unit><form lang="kqs"><text>siiyon yiiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siiyon yiiyo_4547_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeu de toupies</text></gloss>
      <gloss lang="en"><text>spinning-top game</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spinning top; also a gambling game played with tops</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Siiyon yiiyo; Lexique kissi–français, p. 49: siiyon yiiyo; Childs 2000, p. 333: sîyé</text></form></note>
    <note><form lang="fr"><text>siiyon serait le pluriel de siiye « toupie » (Childs sîyé, pl. sîyɔ́ŋ). Dans la Bible, siiyo signifie « scie » (1 R 7,9). Confirmé au Nord par le Lexique kissi–français, p. 49.</text></form></note>
  </entry>
  <entry id="sikaa_4548">
    <lexical-unit><form lang="kqs"><text>sikaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sika</text></form></variant>
    <sense id="sikaa_4548_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>douter, hésiter ; doute ; incertitude</text></gloss>
      <gloss lang="en"><text>doubt, hesitate; doubt; uncertainty</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.15.23; Lexique kissi–français, p. 49: sikaa</text></form></note>
    <note><form lang="fr"><text>pɛngi sikaa mà laalan « cesse de douter et crois » (Jn 20,27).</text></form></note>
  </entry>
  <entry id="siki_4549">
    <lexical-unit><form lang="kqs"><text>siki</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siki_4549_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>santé, protection du consultant (divination par les cailloux)</text></gloss>
      <gloss lang="en"><text>health, protection of the client (pebble divination)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: siki</text></form></note>
  </entry>
  <entry id="sikio_4550">
    <lexical-unit><form lang="kqs"><text>sikio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sikio_4550_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ce qui protège ; nom du premier devin</text></gloss>
      <gloss lang="en"><text>what protects; name of the first diviner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: sikio</text></form></note>
  </entry>
  <entry id="síkítéíyó_4551">
    <lexical-unit><form lang="kqs"><text>síkítéíyó</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="síkítéíyó_4551_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passoire, tamis</text></gloss>
      <gloss lang="en"><text>strainer</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 333: síkítéíyó</text></form></note>
  </entry>
  <entry id="síkɔ́ɔ́_4552">
    <lexical-unit><form lang="kqs"><text>síkɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="síkɔ́ɔ́_4552_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorcellerie</text></gloss>
      <gloss lang="en"><text>witchcraft</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 333: síkɔ́ɔ́</text></form></note>
  </entry>
  <entry id="silaa_4553">
    <lexical-unit><form lang="kqs"><text>silaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sila</text></form></variant>
    <variant><form lang="kqs"><text>silanin</text></form></variant>
    <sense id="silaa_4553_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>conseiller, ordonner ; éduquer ; éducation</text></gloss>
      <gloss lang="en"><text>advise, instruct; advice; educate; education</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>advise or warn</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.26.26; Keita 1979, p. 113: Silaa; Lexique kissi–français, p. 49: silaa/ sila; Terminologie (idéologie), n° 254: Silaa, ~~mandaa, heeloo, työnönndo~~; Childs 2000, p. 333: sìlàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 49 : silaa aussi nom, « le conseil » ; p. 50 : siraa « les conseils ». Académie des langues (terminologie, idéologie n° 254, 255) : « éducation, éduquer » (aussi mandaa).</text></form></note>
  </entry>
  <entry id="silaa_4554">
    <lexical-unit><form lang="kqs"><text>silaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>siraa</text></form></variant>
    <sense id="silaa_4554_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: siraa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Homographe de silaa « conseiller ».</text></form></note>
  </entry>
  <entry id="silalalnɔɔ_4555">
    <lexical-unit><form lang="kqs"><text>silalalnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="silalalnɔɔ_4555_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>général</text></gloss>
      <gloss lang="en"><text>general</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 361: Silalalnöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="silalan_4556">
    <lexical-unit><form lang="kqs"><text>silalan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>silala</text></form></variant>
    <sense id="silalan_4556_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>préceptes, ordonnances, conseils</text></gloss>
      <gloss lang="en"><text>statutes, precepts, counsel</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.49.33</text></form></note>
    <note><form lang="fr"><text>Cf. silaa « conseiller ».</text></form></note>
  </entry>
  <entry id="silamanndo_4557">
    <lexical-unit><form lang="kqs"><text>silamanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="silamanndo_4557_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>harpe, guitare traditionnelle</text></gloss>
      <gloss lang="en"><text>harp, traditional guitar</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: silamando, silamandu, pl. silamanta; Lexique kissi–français, p. 49: silamanndo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 92 : « harpe arquée à 6 cordes ; harpe-luth à 6 cordes ».</text></form></note>
  </entry>
  <entry id="silanndo_4558">
    <lexical-unit><form lang="kqs"><text>silanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="silanndo_4558_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>morale</text></gloss>
      <gloss lang="en"><text>morals, moral teaching</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 434: Silanndo, bèèlen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. silaa « conseiller » ; la liste donne aussi bɛɛlen.</text></form></note>
  </entry>
  <entry id="silanɔɔ_4559">
    <lexical-unit><form lang="kqs"><text>silanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="silanɔɔ_4559_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éducateur</text></gloss>
      <gloss lang="en"><text>educator</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Silanöö; Lexique kissi–français, p. 49: silanɔɔ; Terminologie (idéologie), n° 256: Silanöö</text></form></note>
  </entry>
  <entry id="sílèí_4560">
    <lexical-unit><form lang="kqs"><text>sílèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sílɔ̌ŋ</text></form></field>
    <sense id="sílèí_4560_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haricot sauvage (de l'arbre sílɔ̀ɔ́)</text></gloss>
      <gloss lang="en"><text>wild bean (from the sílɔ̀ɔ́ tree)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 333: sílèí</text></form></note>
  </entry>
  <entry id="sílɔ̀ɔ́_4561">
    <lexical-unit><form lang="kqs"><text>sílɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sílùéí</text></form></field>
    <sense id="sílɔ̀ɔ́_4561_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à grosses graines oléagineuses ; sa graine</text></gloss>
      <gloss lang="en"><text>tree bearing large oil beans; the bean itself</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 333: sílɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sim_4562">
    <lexical-unit><form lang="kqs"><text>sim</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>simnin</text></form></variant>
    <sense id="sim_4562_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'arrêter, se poser ; se tenir (debout), rester</text></gloss>
      <gloss lang="en"><text>stop, come to rest; stand, stay</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be standing; (causative sìmìó) stand something up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 461 occurrences, first GEN.8.4; Childs 2000, p. 334: sìmndáŋ</text></form></note>
    <note><form lang="fr"><text>Forme longue non attestée dans la Bible.</text></form></note>
  </entry>
  <entry id="simande_4563">
    <lexical-unit><form lang="kqs"><text>simande</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simande_4563_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>plat ; de même taille</text></gloss>
      <gloss lang="en"><text>flat; of the same size</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 92: simande</text></form></note>
    <note><form lang="fr"><text>Paulme : tabale simando ni « la table est plate » ; vana simanda « hommes de même taille » (jumeaux). Cf. siiman « égaler ».</text></form></note>
  </entry>
  <entry id="simba_4564">
    <lexical-unit><form lang="kqs"><text>simba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simba_4564_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éléphant</text></gloss>
      <gloss lang="en"><text>elephant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: simba</text></form></note>
    <note><form lang="fr"><text>Cf. kamaa « éléphant » dans la Bible.</text></form></note>
  </entry>
  <entry id="símbàá_4565">
    <lexical-unit><form lang="kqs"><text>símbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="símbàá_4565_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tas d'herbes (au défrichage)</text></gloss>
      <gloss lang="en"><text>heap of grass (from clearing a field)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 334: símbàá</text></form></note>
  </entry>
  <entry id="simbaŋo_4566">
    <lexical-unit><form lang="kqs"><text>simbaŋo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simbaŋo_4566_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune femme (après son premier accouchement)</text></gloss>
      <gloss lang="en"><text>young woman (after her first childbirth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: simbaŋo</text></form></note>
    <note><form lang="fr"><text>Paulme : vanala simbaŋo, pl. simba ; jusqu'à 4 ou 5 (enfants ?).</text></form></note>
  </entry>
  <entry id="simbul_4567">
    <lexical-unit><form lang="kqs"><text>simbul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>simbulaa</text></form></variant>
    <variant><form lang="kqs"><text>simbulun</text></form></variant>
    <sense id="simbul_4567_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enrouler, envelopper ; (sɛbɛ simbulaa) rouleau</text></gloss>
      <gloss lang="en"><text>roll up, wrap; (sɛbɛ simbulaa) scroll</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wrap (up), package; roll up; fold</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first NUM.4.10; Childs 2000, p. 334: sìmbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="simbɔ_4568">
    <lexical-unit><form lang="kqs"><text>simbɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simbɔ_4568_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure d'excisée</text></gloss>
      <gloss lang="en"><text>hairstyle of an initiated girl</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: simbɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : Moussama, Kossilan.</text></form></note>
  </entry>
  <entry id="simco_4569">
    <lexical-unit><form lang="kqs"><text>simco</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simco_4569_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>samedi</text></gloss>
      <gloss lang="en"><text>Saturday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: simtyo</text></form></note>
    <note><form lang="fr"><text>Paulme : mauvais jour pour mourir (le mort subira un jugement au pays des morts), le vendredi étant un bon jour. Cf. halɛiyo « samedi » (Keita).</text></form></note>
  </entry>
  <entry id="simio_4570">
    <lexical-unit><form lang="kqs"><text>simio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>simi</text></form></variant>
    <variant><form lang="kqs"><text>siminin</text></form></variant>
    <sense id="simio_4570_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser, faire tenir debout ; planter (tente) ; construire ; arrêter</text></gloss>
      <gloss lang="en"><text>set up, make stand; pitch (a tent); build; stop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first NUM.4.32; Keita 1979, p. 113: Simio; Lexique kissi–français, p. 49: simio/ simi</text></form></note>
  </entry>
  <entry id="simisimio_4571">
    <lexical-unit><form lang="kqs"><text>simisimio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>simisimi</text></form></variant>
    <sense id="simisimio_4571_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>superposer, dresser (plusieurs)</text></gloss>
      <gloss lang="en"><text>set up, stack (many)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Simisimio; Lexique kissi–français, p. 49: simisimio/ simisimi</text></form></note>
    <note><form lang="fr"><text>Redoublement de simio.</text></form></note>
  </entry>
  <entry id="simisio_4572">
    <lexical-unit><form lang="kqs"><text>simisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="simisio_4572_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chemise</text></gloss>
      <gloss lang="en"><text>shirt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: simisio</text></form></note>
    <note><form lang="fr"><text>Emprunt (français chemise).</text></form></note>
  </entry>
  <entry id="simlacilen_4573">
    <lexical-unit><form lang="kqs"><text>simlacilen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="simlacilen_4573_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fonction de chef, direction ; responsabilité</text></gloss>
      <gloss lang="en"><text>leadership, office of judge or chief; responsibility</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first JDG.16.31; Terminologie (idéologie), n° 569: Simlatyilen</text></form></note>
    <note><form lang="fr"><text>Cf. simlacinɔɔ « chef, responsable ». Académie des langues (terminologie, idéologie n° 569) : « responsabilité ».</text></form></note>
  </entry>
  <entry id="simlacinɔɔ_4574">
    <lexical-unit><form lang="kqs"><text>simlacinɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>simlacia</text></form></field>
    <variant><form lang="kqs"><text>simlacinɔ</text></form></variant>
    <sense id="simlacinɔɔ_4574_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chef, responsable, dirigeant</text></gloss>
      <gloss lang="en"><text>chief, leader, ruler</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.45.8; Terminologie (idéologie), n° 565: Simlatyinöö</text></form></note>
  </entry>
  <entry id="simndan_4575">
    <lexical-unit><form lang="kqs"><text>simndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="simndan_4575_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hauteur ; rang</text></gloss>
      <gloss lang="en"><text>height; rank, row</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 127 occurrences, first GEN.6.15; Lexique kissi–français, p. 49: simndan; Terminologie (arts), n° 196: Simndan, haa</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 49 : « rang ». Académie des langues (terminologie, arts n° 196) : simndan (aussi haa) « pause ».</text></form></note>
  </entry>
  <entry id="simndan laci_4576">
    <lexical-unit><form lang="kqs"><text>simndan laci</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="simndan laci_4576_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être à la tête de, avoir la charge de ; diriger</text></gloss>
      <gloss lang="en"><text>be in charge of, be at the head of; lead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 248: Simndan latyi</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 248) : « diriger ».</text></form></note>
  </entry>
  <entry id="simnde_4577">
    <lexical-unit><form lang="kqs"><text>simnde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simnde_4577_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être debout, s'arrêter</text></gloss>
      <gloss lang="en"><text>stand, stop</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: simnde</text></form></note>
    <note><form lang="fr"><text>Voir simio « dresser » et [s]im (radical) « être debout, arrêter » dans le Lexique.</text></form></note>
  </entry>
  <entry id="simndo_4578">
    <lexical-unit><form lang="kqs"><text>simndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simndo_4578_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point (ponctuation)</text></gloss>
      <gloss lang="en"><text>full stop</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 318: Simndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. simnde « s'arrêter ».</text></form></note>
  </entry>
  <entry id="simnun_4579">
    <lexical-unit><form lang="kqs"><text>simnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="simnun_4579_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rester (immobile, tranquille), se tenir ; rester en arrière</text></gloss>
      <gloss lang="en"><text>stay (still), stand; stay behind</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stand by itself; change, turn into (middle of 'stand')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.14.14; Childs 2000, p. 334: sìmnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de sim « s'arrêter, se tenir ». niaa la simnun yili « vous, restez tranquilles » (EXO.14.14) ; vanaa … kɔɔli-a nda simnun « ceux qui restèrent en arrière » (1SA.30.9) ; mà kɔ simnun o kɔngɔ « ils se tiendront sur le rivage » (EZK.27.29).</text></form></note>
  </entry>
  <entry id="simulanndo_4580">
    <lexical-unit><form lang="kqs"><text>simulanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="simulanndo_4580_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>opposition</text></gloss>
      <gloss lang="en"><text>opposition, contrast</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 291: Simulanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="simullo_4581">
    <lexical-unit><form lang="kqs"><text>simullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>simul</text></form></variant>
    <variant><form lang="kqs"><text>simulnin</text></form></variant>
    <sense id="simullo_4581_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se dresser contre, se révolter ; s'opposer ; opposition</text></gloss>
      <gloss lang="en"><text>rise against, rebel; oppose; opposition</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 97 occurrences, first GEN.14.8; Keita 1979, p. 113: Simullo; Lexique kissi–français, p. 49: simullo/ simul; Terminologie (idéologie), n° 472: Simullo, simioo o ibun</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de simio. Académie des langues (terminologie, idéologie n° 472, 474) : « opposer, opposition » (aussi simioo o ibun).</text></form></note>
  </entry>
  <entry id="sin gom_4582">
    <lexical-unit><form lang="kqs"><text>sin gom</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sin gom_4582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chewing-gum</text></gloss>
      <gloss lang="en"><text>chewing gum</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 49: sin gom</text></form></note>
    <note><form lang="fr"><text>Emprunt (anglais/français chewing-gum).</text></form></note>
  </entry>
  <entry id="sinaa_4583">
    <lexical-unit><form lang="kqs"><text>sinaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sina</text></form></variant>
    <variant><form lang="kqs"><text>sinanin</text></form></variant>
    <sense id="sinaa_4583_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>connaître, savoir ; reconnaître</text></gloss>
      <gloss lang="en"><text>know; recognize</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>know, understand</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 337 occurrences, first GEN.3.6; Keita 1979, p. 113: Sinaa; Paulme 1964, p. 93: sina; Lexique kissi–français, p. 49: sinaa/ sina; Terminologie (langue), n° 83: Sinaa; Childs 2000, p. 334: sìnàá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 93 : ɔ sina ya tau « il me connaît bien ». Académie des langues (terminologie, langue n° 83) : « connaître ».</text></form></note>
  </entry>
  <entry id="sinamannden_4584">
    <lexical-unit><form lang="kqs"><text>sinamannden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="sinamannden_4584_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arc musical à une corde</text></gloss>
      <gloss lang="en"><text>one-stringed musical bow</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Sinamannden; Lexique kissi–français, p. 49: sinamannden</text></form></note>
  </entry>
  <entry id="sinapɛngoo_4585">
    <lexical-unit><form lang="kqs"><text>sinapɛngoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sinapɛngu</text></form></variant>
    <sense id="sinapɛngoo_4585_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>intelligence, discernement</text></gloss>
      <gloss lang="en"><text>understanding, discernment</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first 1KI.3.12</text></form></note>
  </entry>
  <entry id="sindio_4586">
    <lexical-unit><form lang="kqs"><text>sindio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sindio_4586_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce dont l'écorce sert à polir les poteries)</text></gloss>
      <gloss lang="en"><text>kind of tree (bark used to polish pots)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: sindyo</text></form></note>
    <note><form lang="fr"><text>Paulme : on en fait aussi des cure-dents.</text></form></note>
  </entry>
  <entry id="sìndɔ́ɔ́_4587">
    <lexical-unit><form lang="kqs"><text>sìndɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìndɔ́ɔ́_4587_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>treillage de bâtons (pour plantes grimpantes)</text></gloss>
      <gloss lang="en"><text>frame of sticks (for climbing plants)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 335: sìndɔ́ɔ́</text></form></note>
  </entry>
  <entry id="sindɔɔ_4588">
    <lexical-unit><form lang="kqs"><text>sindɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="sindɔɔ_4588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passé (temps) ; antiquité</text></gloss>
      <gloss lang="en"><text>past (tense); antiquity</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 304: Sindöö, tyièiyo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Il rend aussi « antiquité » (histoire n° 58). Aussi ciɛiyo, qui rend seul « temps passé » (langue n° 396). Cf. Bɛndu Yuu Masindɛ-Sindɔɔ « l'Ancien des jours » (DAN.7.9). Aussi Académie des langues (terminologie, histoire n° 457) : « passé (le) » (aussi paandoo cieiyo).</text></form></note>
  </entry>
  <entry id="sindɛ_4589">
    <lexical-unit><form lang="kqs"><text>sindɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sindɛ_4589_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>auparavant, jadis</text></gloss>
      <gloss lang="en"><text>before, formerly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a long time ago; (adj.) of an earlier time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 112 occurrences, first GEN.50.15; Childs 2000, p. 335: sìndè</text></form></note>
  </entry>
  <entry id="sindɛ bɛndoo_4590">
    <lexical-unit><form lang="kqs"><text>sindɛ bɛndoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sindɛ bɛndoo_4590_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Moyen Âge</text></gloss>
      <gloss lang="en"><text>Middle Ages</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 431: Sindè bèndoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Mots attestés séparément dans la Bible, pas l'expression.</text></form></note>
  </entry>
  <entry id="singaa_4591">
    <lexical-unit><form lang="kqs"><text>singaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>singa</text></form></variant>
    <sense id="singaa_4591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échanger</text></gloss>
      <gloss lang="en"><text>exchange</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.27.10; Keita 1979, p. 113: Singaa; Lexique kissi–français, p. 49: singaa/ singa; Terminologie (histoire), n° 307: Yönganndo, singaa</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 307) : « échange » (aussi yɔnganndo).</text></form></note>
  </entry>
  <entry id="singafilanndo_4592">
    <lexical-unit><form lang="kqs"><text>singafilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="singafilanndo_4592_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>alternance</text></gloss>
      <gloss lang="en"><text>alternation</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 22: Singafilanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Formé sur singaa « échanger » (cf. singafilaa dans la Bible).</text></form></note>
  </entry>
  <entry id="singilaa_4593">
    <lexical-unit><form lang="kqs"><text>singilaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>singila</text></form></variant>
    <sense id="singilaa_4593_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échanger avec qqn</text></gloss>
      <gloss lang="en"><text>exchange with someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: singilaa/ singila; Terminologie (idéologie), n° 564: Singilaa</text></form></note>
    <note><form lang="fr"><text>Dérivé de singaa « échanger ». Académie des langues (terminologie, idéologie n° 564 ; histoire n° 582) : « remaniement ; succéder ».</text></form></note>
  </entry>
  <entry id="singio_4594">
    <lexical-unit><form lang="kqs"><text>singio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>singi</text></form></variant>
    <sense id="singio_4594_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir ; soigner</text></gloss>
      <gloss lang="en"><text>heal; treat (an illness)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first 2KI.5.7; Lexique kissi–français, p. 50: singio/ singi; Childs 2000, p. 335: sìŋìó</text></form></note>
  </entry>
  <entry id="singuo_4595">
    <lexical-unit><form lang="kqs"><text>singuo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>singu</text></form></variant>
    <sense id="singuo_4595_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer (de comportement, de culture, de qualité)</text></gloss>
      <gloss lang="en"><text>change (behaviour, culture, quality)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1 General words"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: singuo/ singu</text></form></note>
    <note><form lang="fr"><text>Définition corrigée à la main dans le Lexique (d'abord « faire devenir qqn comme qqch »). Homographe : dans la Bible singu signifie « guérir » (voir siongɔɔ).</text></form></note>
  </entry>
  <entry id="sinianndo_4596">
    <lexical-unit><form lang="kqs"><text>sinianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sinian</text></form></variant>
    <sense id="sinianndo_4596_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se connaître (l'un l'autre)</text></gloss>
      <gloss lang="en"><text>know each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: sinianndo/ sinian</text></form></note>
    <note><form lang="fr"><text>Réciproque de sinaa « connaître ».</text></form></note>
  </entry>
  <entry id="sininkɔile_4597">
    <lexical-unit><form lang="kqs"><text>sininkɔile</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sininkɔiye</text></form></field>
    <sense id="sininkɔile_4597_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite banane</text></gloss>
      <gloss lang="en"><text>small banana</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: sininkɔye /pl./ sininkɔile /sing./</text></form></note>
  </entry>
  <entry id="sinnɔnndo_4598">
    <lexical-unit><form lang="kqs"><text>sinnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sinnun</text></form></variant>
    <sense id="sinnɔnndo_4598_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir, devenir autre</text></gloss>
      <gloss lang="en"><text>become, become different</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: sinnɔnndo/ sinnun</text></form></note>
    <note><form lang="fr"><text>Le Lexique met un point d'interrogation à la définition.</text></form></note>
  </entry>
  <entry id="sintalo_4599">
    <lexical-unit><form lang="kqs"><text>sintalo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sintɔlɔlɛn</text></form></field>
    <sense id="sintalo_4599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>turban</text></gloss>
      <gloss lang="en"><text>turban</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: sintalo, pl. sintɔlɔlɛ̃</text></form></note>
  </entry>
  <entry id="sio_4600">
    <lexical-unit><form lang="kqs"><text>sio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sio_4600_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vie</text></gloss>
      <gloss lang="en"><text>life</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6 Life"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: sio</text></form></note>
    <note><form lang="fr"><text>La Bible dit cindaa « vie ».</text></form></note>
  </entry>
  <entry id="sio_4601">
    <lexical-unit><form lang="kqs"><text>sio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>silan</text></form></field>
    <sense id="sio_4601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>scie</text></gloss>
      <gloss lang="en"><text>saw</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: sio, pl. sirã</text></form></note>
    <note><form lang="fr"><text>Paulme : pas de verbe sio ; pour scier, raboter on dit yɔmdo sɔlo (cf. sɔlɔɔ). Homographe de sio « vie » (Lexique).</text></form></note>
  </entry>
  <entry id="siolo_4602">
    <lexical-unit><form lang="kqs"><text>siolo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siolo_4602_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (Erythrina)</text></gloss>
      <gloss lang="en"><text>coral tree (Erythrina)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 94: siolo</text></form></note>
    <note><form lang="fr"><text>Erythrina senegalensis (Légumineuses).</text></form></note>
  </entry>
  <entry id="siondoolen_4603">
    <lexical-unit><form lang="kqs"><text>siondoolen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siondoole</text></form></variant>
    <variant><form lang="kqs"><text>siondoei</text></form></variant>
    <sense id="siondoolen_4603_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sort (tiré au sort) ; bâton, verge</text></gloss>
      <gloss lang="en"><text>lot (cast); stick, rod</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stick, twig, small whip, match</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.16.9; Childs 2000, p. 335: sìòndòòléŋ</text></form></note>
    <note><form lang="fr"><text>Variante de sionnden. cuin toovi siondoolen le bii le Mɛlɛka-o « le bouc sur lequel le sort est tombé pour le Seigneur » (LEV.16.9) ; Siondoolen le nɔla … « le bâton peut-il … » (ISA.10.15) ; malnin siondoei « il a jeté le sort » (ISA.34.17).</text></form></note>
  </entry>
  <entry id="siongɔɔ_4604">
    <lexical-unit><form lang="kqs"><text>siongɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siongu</text></form></variant>
    <variant><form lang="kqs"><text>sengu</text></form></variant>
    <variant><form lang="kqs"><text>siangu</text></form></variant>
    <variant><form lang="kqs"><text>singu</text></form></variant>
    <variant><form lang="kqs"><text>siangunin</text></form></variant>
    <variant><form lang="kqs"><text>singunin</text></form></variant>
    <sense id="siongɔɔ_4604_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>guérir ; se soigner</text></gloss>
      <gloss lang="en"><text>heal; treat oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heal, cure</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first EXO.15.26; Keita 1979, p. 116: Siongöö; Paulme 1964, p. 91: seŋu, siŋu; Lexique kissi–français, p. 50: siongɔɔ/ siongu, sengu, siangu, singu; Childs 2000, p. 335: sìŋìó</text></form></note>
    <note><form lang="fr"><text>singu, singunin : radical négatif (JER 10,19 ; 2KI 20,1). Lexique kissi–français, p. 51 : aussi songɔɔ/ sangu « guérir, se soigner ». Paulme 1964, p. 91 : ɔ seŋu re « il ne guérit pas » ; ɔ tyu suŋo « il est guéri ».</text></form></note>
  </entry>
  <entry id="sionnden_4605">
    <lexical-unit><form lang="kqs"><text>sionnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="sionnden_4605_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâton, verge ; sort (tiré au sort)</text></gloss>
      <gloss lang="en"><text>stick, rod; lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first DEU.21.18; Keita 1979, p. 159: Sionnden; Lexique kissi–français, p. 50: sionnden</text></form></note>
  </entry>
  <entry id="siòònde_4606">
    <lexical-unit><form lang="kqs"><text>siòònde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="siòònde_4606_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peur, crainte, frayeur</text></gloss>
      <gloss lang="en"><text>fear, fright, terror</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 342 occurrences, first GEN.3.10; Paulme 1964, p. 97: suinde, sɔyɛnde; Lexique kissi–français, p. 50: sionde; Childs 2000, p. 336: sìɔ̀ŋndé</text></form></note>
    <note><form lang="fr"><text>siòònde bii ya « j'ai eu peur » (litt. « la peur m'a saisi », Gn 3,10) ; vana nɔ siòònde-o « celui qui a peur » (Dt 20,8). Même racine que siòòŋii « crainte ». Paulme 1964, p. 97 : ɔ nɔ sɔyɛnde « il est peureux ».</text></form></note>
  </entry>
  <entry id="sióónndon_4607">
    <lexical-unit><form lang="kqs"><text>sióónndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sionde</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <variant><form lang="kqs"><text>suoŋdo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="sióónndon_4607_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sable</text></gloss>
      <gloss lang="en"><text>sand</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.22.17; Keita 1979, p. 155: Sioonde; Paulme 1964, p. 99 (G/K): syonde /G./, suoŋdo /K./; Lexique kissi–français, p. 52: suendon; Childs 2000, p. 335: sìòŋndé</text></form></note>
    <note><form lang="fr"><text>Keita écrit Sioonde ; la Bible emploie sióónndon (GEN.22.17, MAT.7.26). siòònde y signifie « peur ». Lexique kissi–français, p. 50 : aussi sioonde « le sable ». Paulme 1964, p. 99 : syonde /G./, suoŋdo /K./. Paulme : syonde /G./, suoŋdo /K./ (p. 99).</text></form></note>
  </entry>
  <entry id="siòòŋii_4608">
    <lexical-unit><form lang="kqs"><text>siòòŋii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siòòŋii_4608_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crainte, peur ; terreur</text></gloss>
      <gloss lang="en"><text>fear; terror</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 291 occurrences, first GEN.9.2; Terminologie (histoire), n° 601: Kpèiyo, sioonhii bènduei; Childs 2000, p. 336: sìɔ̀ŋndé</text></form></note>
    <note><form lang="fr"><text>siòòŋii Mɛlɛka-e « la crainte du Seigneur ». Académie des langues (terminologie, histoire n° 601, 602) : siooŋii bɛnduei « terreur » (aussi kpɛiyo) ; sioonde lueiyo « terroriser ».</text></form></note>
  </entry>
  <entry id="siowvo_4609">
    <lexical-unit><form lang="kqs"><text>siowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siow</text></form></variant>
    <sense id="siowvo_4609_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>achever, passer (un temps) ; finir, terminer</text></gloss>
      <gloss lang="en"><text>complete, spend (a period of time); finish</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 1SA.14.13; Lexique kissi–français, p. 48: sewvo/ sew; Terminologie (histoire), n° 9: Siowvo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 48 : sewvo/ sew « finir, accomplir, terminer ». Académie des langues (terminologie, histoire n° 9) : « achèvement ».</text></form></note>
  </entry>
  <entry id="sìpòó_4610">
    <lexical-unit><form lang="kqs"><text>sìpòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìpòó_4610_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lime (outil de forgeron)</text></gloss>
      <gloss lang="en"><text>file (blacksmith's tool)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìpòó</text></form></note>
  </entry>
  <entry id="siprɛs_4611">
    <lexical-unit><form lang="kqs"><text>siprɛs</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siprɛsiei</text></form></variant>
    <variant><form lang="kqs"><text>siprɛsii</text></form></variant>
    <sense id="siprɛs_4611_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cyprès</text></gloss>
      <gloss lang="en"><text>cypress</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.6.14</text></form></note>
    <note><form lang="fr"><text>Emprunt ; pɛngɛn yɔm siprɛs « bois de cyprès » (Gn 6,14), yɔmii siprɛsiei « cyprès » (1 R 5,22).</text></form></note>
  </entry>
  <entry id="sisa_4612">
    <lexical-unit><form lang="kqs"><text>sisa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sisa_4612_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>maintenant, alors (lelan sisa « maintenant donc ») ; tout de suite ; (sisa sisa) vite</text></gloss>
      <gloss lang="en"><text>now, now then (lelan sisa); right away; (sisa sisa) quickly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 126 occurrences, first GEN.24.49; Paulme 1964, p. 94: sisa; Lexique kissi–français, p. 50: sisa</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 53 : aussi susa « maintenant ». Paulme 1964, p. 94 : nkwa ni sisa « nous partons tout de suite ».</text></form></note>
  </entry>
  <entry id="sisinndo_4613">
    <lexical-unit><form lang="kqs"><text>sisinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sisinnda</text></form></field>
    <sense id="sisinndo_4613_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourmi ; petite fourmi rouge ou noire</text></gloss>
      <gloss lang="en"><text>ant; small red or black ant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.6.6; Keita 1979, p. 137: Sisinndo; Paulme 1964, p. 94: sisindo, pl. sisinda; Lexique kissi–français, p. 50: sisinndo; Childs 2000, p. 337: sìsìŋndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 50 : pl. sisinnda « les petites fourmis rouges ou noires ». Paulme 1964, p. 94 : sisindo, pl. sisinda « petite fourmi ».</text></form></note>
  </entry>
  <entry id="sisoo_4614">
