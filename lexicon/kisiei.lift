      <gloss lang="fr"><text>soufre</text></gloss>
      <gloss lang="en"><text>sulphur, brimstone</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gunpowder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.19.24; Childs 2000, p. 113: fúŋgóó</text></form></note>
  </entry>
