    <variant><form lang="kqs"><text>yambu</text></form></variant>
    <variant><form lang="kqs"><text>yambun</text></form></variant>
    <variant><form lang="kqs"><text>yambunin</text></form></variant>
    <variant><form lang="kqs"><text>yambaa</text></form></variant>
    <sense id="yambɔɔ_3804_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>coucher, étendre, déposer (qqn) ; (yambaa) être couché</text></gloss>
      <gloss lang="en"><text>lay down, put to bed, lay; (yambaa) lie</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>set, lay down; also lay (a road), operate on someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.28.11; Childs 2000, p. 397: yàmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>nɛɛ yambaa lebol « où reposer la tête » (MAT.8.20).</text></form></note>
  </entry>
  <entry id="yambɛi_3805">
