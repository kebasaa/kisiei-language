    <sense id="tàŋgbàŋ_5136_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en se relevant lourdement (comme une vache)</text></gloss>
      <gloss lang="en"><text>getting up heavily (like a cow)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 349: tàŋgbàŋ</text></form></note>
  </entry>
  <entry id="taŋnden_5137">
