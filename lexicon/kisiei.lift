    <lexical-unit><form lang="kqs"><text>kasoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kasoo_1978_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil</text></gloss>
      <gloss lang="en"><text>squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: kasoo</text></form></note>
  </entry>
  <entry id="kátáá_1979">
    <lexical-unit><form lang="kqs"><text>kátáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kátáá_1979_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos du chef, cour intérieure</text></gloss>
      <gloss lang="en"><text>chief's enclosure, inner compound</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 150: kátáá</text></form></note>
  </entry>
  <entry id="katta salasiiya_1980">
    <lexical-unit><form lang="kqs"><text>katta salasiiya</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="katta salasiiya_1980_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>garnison</text></gloss>
      <gloss lang="en"><text>garrison</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 359: Katta salasiiya</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « fort des soldats ».</text></form></note>
  </entry>
  <entry id="kattaa_1981">
    <lexical-unit><form lang="kqs"><text>kattaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>katta pɔmbɔɔ</text></form></variant>
    <sense id="kattaa_1981_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>forteresse ; (katta pɔmbɔɔ) fortin</text></gloss>
      <gloss lang="en"><text>fortress; (katta pɔmbɔɔ) small fort</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 348: Kattaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi katta pɔmbɔɔ « fortin » (histoire n° 349). Cf. kátáá « enclos du chef » (Childs, kissi du Sud).</text></form></note>
  </entry>
  <entry id="katu_1982">
    <lexical-unit><form lang="kqs"><text>katu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="katu_1982_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>parce que</text></gloss>
      <gloss lang="en"><text>because</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: katu; Sandara Kisia, fable 1: katu</text></form></note>
    <note><form lang="fr"><text>Sandara Kissia : très fréquent (34 occurrences), « parce que ».</text></form></note>
  </entry>
  <entry id="katundo_1983">
    <lexical-unit><form lang="kqs"><text>katundo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="katundo_1983_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serpent couleur de terre, inoffensif</text></gloss>
      <gloss lang="en"><text>harmless earth-coloured snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 39: katundo, kakumno</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 39 : très luisant, aux extrémités arrondies ; ne sort qu'en cas de grande sécheresse, sa vue est un mauvais présage. Variantes kakumno, kakundo ; pl. donné kakunda.</text></form></note>
  </entry>
  <entry id="kau_1984">
    <lexical-unit><form lang="kqs"><text>kau</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kau_1984_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(emporter, enlever) d'un coup</text></gloss>
      <gloss lang="en"><text>(take, snatch away) all at once</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>suddenness of taking, as an eagle snatching; used with 'take'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.57.13; Childs 2000, p. 150: káù</text></form></note>
    <note><form lang="fr"><text>Hoeiye kɔandunin nda kpow, i cuanin nda kau « le vent les emportera tous, un souffle les enlèvera » (ISA.57.13) ; comme chez Childs, avec cua « prendre ».</text></form></note>
  </entry>
  <entry id="kaulen_1985">
    <lexical-unit><form lang="kqs"><text>kaulen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kaulen_1985_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soufflet (de forge)</text></gloss>
      <gloss lang="en"><text>bellows</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: kaulen</text></form></note>
  </entry>
  <entry id="kauve_1986">
    <lexical-unit><form lang="kqs"><text>kauve</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="kauve_1986_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pipe (à tabac)</text></gloss>
      <gloss lang="en"><text>(tobacco) pipe</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: kauve; Childs 2000, p. 150: kàùwé</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 22 (kauve « le tuyau, la pipe » ; kawvɛ « la pipe »).</text></form></note>
  </entry>
  <entry id="kàùwé_1987">
    <lexical-unit><form lang="kqs"><text>kàùwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="kàùwé_1987_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potion qui protège une maison des mauvais esprits ou le riz des voleurs</text></gloss>
      <gloss lang="en"><text>potion keeping evil spirits from a house or thieves from rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 150: kàùwé</text></form></note>
  </entry>
  <entry id="kava kava_1988">
    <lexical-unit><form lang="kqs"><text>kava kava</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kava kava_1988_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médicament à base de graisse humaine (pour la puissance et la santé)</text></gloss>
      <gloss lang="en"><text>medicine made with human fat (for power and health)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 42: kawa kawa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 42 : on s'en frotte pour obtenir puissance et santé ; cf. kalabala.</text></form></note>
  </entry>
  <entry id="kàváá_1989">
    <lexical-unit><form lang="kqs"><text>kàváá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kava</text></form></variant>
    <sense id="kàváá_1989_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tache brillante (sur la peau)</text></gloss>
      <gloss lang="en"><text>bright spot (on the skin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first LEV.13.19</text></form></note>
  </entry>
  <entry id="kavandio_1990">
    <lexical-unit><form lang="kqs"><text>kavandio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kavandi</text></form></variant>
    <sense id="kavandio_1990_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prêcher</text></gloss>
      <gloss lang="en"><text>preach</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 22: kavandio/ kavandi</text></form></note>
  </entry>
  <entry id="kave_1991">
    <lexical-unit><form lang="kqs"><text>kave</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kave_1991_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>autel de chasseurs (poterie renversée)</text></gloss>
      <gloss lang="en"><text>hunters' altar (upturned pot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 41: kave</text></form></note>
    <note><form lang="fr"><text>Homographe de kave « médicament liquide » (Paulme, même page).</text></form></note>
  </entry>
  <entry id="kave_1992">
    <lexical-unit><form lang="kqs"><text>kave</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kavon</text></form></field>
    <sense id="kave_1992_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médicament liquide, infusion ; protection contre le sorcier</text></gloss>
      <gloss lang="en"><text>liquid medicine, infusion; protection against witches</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 41: kave, kavɛ, kawɛ, pl. kawõ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 41 : « protection du wulumo contre le sorcier, kuino ; tous médicaments liquides (dans les poteries), infusions ». Variantes kavɛ, kawɛ.</text></form></note>
  </entry>
  <entry id="kavo_1993">
    <lexical-unit><form lang="kqs"><text>kavo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kava</text></form></field>
    <sense id="kavo_1993_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros singe (chimpanzé ?)</text></gloss>
      <gloss lang="en"><text>large ape (chimpanzee?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 42: kawo, pl. kawa</text></form></note>
    <note><form lang="fr"><text>Le pluriel kava est homographe de kava « tache brillante » (Bible).</text></form></note>
  </entry>
