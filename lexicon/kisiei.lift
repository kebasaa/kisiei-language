    <variant><form lang="kqs"><text>kpelemɔsaa</text></form></variant>
    <sense id="kpelemɔɔsaa_1856_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rapports sexuels</text></gloss>
