  <entry id="sáwúléŋ_4448">
    <lexical-unit><form lang="kqs"><text>sáwúléŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sáwúléŋ_4448_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>d'un pas posé, délibérément</text></gloss>
      <gloss lang="en"><text>going deliberately</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 323: sáwúléŋ</text></form></note>
  </entry>
  <entry id="sayaa_4449">
    <lexical-unit><form lang="kqs"><text>sayaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sayaa_4449_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>savane ; grande herbe de savane</text></gloss>
      <gloss lang="en"><text>savanna; tall savanna grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>savanna grass; grassy savanna, upland</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Sayaa; Lexique kissi–français, p. 47: sayaa; Childs 2000, p. 323: sáyáá</text></form></note>
  </entry>
  <entry id="sayalen_4450">
    <lexical-unit><form lang="kqs"><text>sayalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="sayalen_4450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe de savane</text></gloss>
      <gloss lang="en"><text>savanna grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>savanna grass; grassy savanna, upland</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Sayalen; Lexique kissi–français, p. 47: sayalen; Childs 2000, p. 323: sáyáá</text></form></note>
  </entry>
  <entry id="sayonndo_4451">
    <lexical-unit><form lang="kqs"><text>sayonndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sayonndo_4451_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lézard (espèce)</text></gloss>
      <gloss lang="en"><text>kind of lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: sayonndo</text></form></note>
    <note><form lang="fr"><text>Comparer le kissi du Sud sàyɛ́ŋndó « varan ».</text></form></note>
  </entry>
  <entry id="sayɛiyo_4452">
    <lexical-unit><form lang="kqs"><text>sayɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sayɛiyo_4452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi</text></gloss>
      <gloss lang="en"><text>Monday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Sayèiyo; Lexique kissi–français, p. 46: salɛiyo; Terminologie (langue), n° 451: Innovation à discuter : (de Saa) Sayèiyo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 écrit salɛiyo « lundi ». Aussi Lexique kissi–français, p. 47 : « sayɛiyo ». Académie des langues (terminologie, langue n° 451-457) : les noms des jours sont présentés comme « innovation à discuter », chacun formé sur un nom (Saa → sayèiyo « lundi »).</text></form></note>
  </entry>
  <entry id="sàyɛ́ŋndó_4453">
    <lexical-unit><form lang="kqs"><text>sàyɛ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàyɛ́ŋndó_4453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>varan (grand lézard comestible)</text></gloss>
      <gloss lang="en"><text>monitor lizard (large edible lizard)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 323: sàyɛ́ŋndó</text></form></note>
    <note><form lang="fr"><text>Varanus niloticus.</text></form></note>
  </entry>
  <entry id="saŋa_4454">
    <lexical-unit><form lang="kqs"><text>saŋa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saŋa_4454_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brancard mortuaire</text></gloss>
      <gloss lang="en"><text>funeral litter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 89: saŋa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 89 : pɔm'saŋala « pɔmdo sur le brancard (qui devine) » ; saŋa wana ũilɛyo, saŋa pɔmdo.</text></form></note>
  </entry>
  <entry id="sáŋàɲáá_4455">
    <lexical-unit><form lang="kqs"><text>sáŋàɲáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sáŋàɲáá_4455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>héron, grue (grand échassier)</text></gloss>
      <gloss lang="en"><text>heron or crane (large wading bird)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sáŋàɲáá</text></form></note>
  </entry>
  <entry id="saŋbɛo_4456">
    <lexical-unit><form lang="kqs"><text>saŋbɛo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>saɲbɛo</text></form></variant>
    <sense id="saŋbɛo_4456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>objet magique (figurant un fusil, donne richesse et santé)</text></gloss>
      <gloss lang="en"><text>magic object (representing a gun, gives wealth and health)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 89: saŋbɛo, sanybɛo</text></form></note>
    <note><form lang="fr"><text>Paulme : frotté d'huile de palme.</text></form></note>
  </entry>
  <entry id="sáŋgáá_4457">
    <lexical-unit><form lang="kqs"><text>sáŋgáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sáŋgáláŋ</text></form></field>
    <sense id="sáŋgáá_4457_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hamac de portage, civière funéraire ; coiffe faite de restes du défunt</text></gloss>
      <gloss lang="en"><text>carrying hammock, funeral litter; headpiece made from remains of the dead</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sáŋgáá</text></form></note>
  </entry>
  <entry id="sàŋgámɛ̀íyó_4458">
    <lexical-unit><form lang="kqs"><text>sàŋgámɛ̀íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàŋgámɛ̀íyó_4458_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>échelle à deux montants</text></gloss>
      <gloss lang="en"><text>two-pole ladder</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sàŋgámɛ̀íyó</text></form></note>
  </entry>
  <entry id="sáŋgàɲáá_4459">
    <lexical-unit><form lang="kqs"><text>sáŋgàɲáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sáŋgàɲáá_4459_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'oiseau (mangeur de petits oiseaux)</text></gloss>
      <gloss lang="en"><text>a bird species (eats small birds)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 321: sáŋgàɲáá</text></form></note>
  </entry>
  <entry id="sàŋgbìó_4460">
    <lexical-unit><form lang="kqs"><text>sàŋgbìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sàŋgbèláŋ</text></form></field>
    <sense id="sàŋgbìó_4460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potion pour améliorer ses performances ou sa popularité</text></gloss>
      <gloss lang="en"><text>potion to improve one's performance or popularity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sàŋgbìó</text></form></note>
  </entry>
  <entry id="saŋiyo_4461">
    <lexical-unit><form lang="kqs"><text>saŋiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>saŋia</text></form></field>
    <sense id="saŋiyo_4461_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson (espèce allongée à queue rouge)</text></gloss>
      <gloss lang="en"><text>kind of fish (slender, red-tailed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 89: saŋiyo, pl. saŋya</text></form></note>
    <note><form lang="fr"><text>Paulme : comestible ; peut-être de saŋa « rouge ».</text></form></note>
  </entry>
  <entry id="saŋndo_4462">
    <lexical-unit><form lang="kqs"><text>saŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="saŋndo_4462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lièvre ; lapin</text></gloss>
      <gloss lang="en"><text>hare; rabbit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a small or pygmy antelope, hero of folk tales</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.11.6; Keita 1979, p. 137: Sanndo; Paulme 1964, p. 88: sando, sando, pl. sanda; Lexique kissi–français, p. 46: sanndo; Childs 2000, p. 322: sáŋndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : sanndo « un lapin, le lièvre ». Paulme 1964, p. 88 : sando kindu kɔllo « le lièvre est très malin ».</text></form></note>
  </entry>
  <entry id="saŋnɔnndo_4463">
    <lexical-unit><form lang="kqs"><text>saŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saŋnɔn</text></form></variant>
    <sense id="saŋnɔnndo_4463_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se répandre, être dispersé, éparpillé ; (nom) semailles</text></gloss>
      <gloss lang="en"><text>be scattered, spread, poured out; (noun) sowing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>middle of 'sow'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.8.22; Childs 2000, p. 322: sàŋnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de saŋɔɔ « semer ; disperser ». má cuu saŋnɔn faw « elles se sont dispersées » (EZK.34.5) ; i co saŋnɔnndo maa mamɛn « je suis répandu comme de l'eau » (PSA.22.15) ; saŋnɔnndo a kownɔnndo « les semailles et la moisson » (GEN.8.22).</text></form></note>
  </entry>
  <entry id="sǎŋsèèŋgíàŋndó_4464">
    <lexical-unit><form lang="kqs"><text>sǎŋsèèŋgíàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sǎŋsèèŋgíàŋndó_4464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat arboricole</text></gloss>
      <gloss lang="en"><text>tree-dwelling rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 322: sǎŋsèèŋgíàŋndó</text></form></note>
  </entry>
  <entry id="saŋɔɔ_4465">
    <lexical-unit><form lang="kqs"><text>saŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saŋ</text></form></variant>
    <variant><form lang="kqs"><text>saŋnin</text></form></variant>
    <variant><form lang="kqs"><text>seŋ</text></form></variant>
    <variant><form lang="kqs"><text>seŋnin</text></form></variant>
    <sense id="saŋɔɔ_4465_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>semer ; disperser ; semer à la volée</text></gloss>
      <gloss lang="en"><text>sow; scatter; broadcast (seed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sow (grain)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.47.19; Keita 1979, p. 115: Sanhöö; Paulme 1964, p. 89: sā; Lexique kissi–français, p. 46: saŋɔɔ/ saŋ, seŋ; Childs 2000, p. 322: sàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>seŋ, seŋnin : radical négatif (MAT 6,26 ; LEV 25,20). saŋ « disperser » (EXO 9,8). Paulme 1964, p. 89 : i san malo « je sème le riz » ; saŋo « semer, semailles (riz et fonio) ».</text></form></note>
  </entry>
  <entry id="saɛndu_4466">
    <lexical-unit><form lang="kqs"><text>saɛndu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>sainda</text></form></field>
    <variant><form lang="kqs"><text>saiɛndu</text></form></variant>
    <sense id="saɛndu_4466_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>varan</text></gloss>
      <gloss lang="en"><text>monitor lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 87: saɛndu, sayɛndu, pl. sainda</text></form></note>
    <note><form lang="fr"><text>Paulme : totem des Kundua Tuŋia.</text></form></note>
  </entry>
  <entry id="séélìíyó_4467">
    <lexical-unit><form lang="kqs"><text>séélìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="séélìíyó_4467_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheminée</text></gloss>
      <gloss lang="en"><text>chimney</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="5.5.7 Fireplace"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 323: séélìíyó</text></form></note>
  </entry>
  <entry id="seemaa_4468">
    <lexical-unit><form lang="kqs"><text>seemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>seema</text></form></variant>
    <sense id="seemaa_4468_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise ; (seema) être fou, devenir fou</text></gloss>
      <gloss lang="en"><text>madness, folly; (seema) be mad, go mad</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>to act crazy (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.17.12; Keita 1979, p. 162: Seemaa; Lexique kissi–français, p. 47: seemaa; Childs 2000, p. 323: sèèmàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 47 : seema « fou, devenir fou » (cf. JHN.10.20).</text></form></note>
  </entry>
  <entry id="seemiaa_4469">
    <lexical-unit><form lang="kqs"><text>seemiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>seemiaanin</text></form></variant>
    <sense id="seemiaa_4469_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire errer, égarer ; affoler</text></gloss>
      <gloss lang="en"><text>make wander, lead astray; strike with panic</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>act crazy (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2SA.15.20; Childs 2000, p. 323: sèèmìá</text></form></note>
    <note><form lang="fr"><text>i seemiaanin soa « je frapperai d'affolement les chevaux » (ZEC.12.4) ; mì kɔɛ vɛlɛ hau seemiaa a nɔm? « te ferais-je errer avec nous ? » (2SA.15.20) ; naa malɔɔ seemiaamì (ISA.63.17).</text></form></note>
  </entry>
  <entry id="seemɛi_4470">
    <lexical-unit><form lang="kqs"><text>seemɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>seemɛiya</text></form></variant>
    <variant><form lang="kqs"><text>seemɛiyo</text></form></variant>
    <variant><form lang="kqs"><text>seemɛilan</text></form></variant>
    <sense id="seemɛi_4470_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fou, insensé ; (vana seemɛi) un fou</text></gloss>
      <gloss lang="en"><text>mad, insane, foolish; (vana seemɛi) madman</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crazy, insane</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.21.14; Paulme 1964, p. 93: simɛyo, semɛyo; Lexique kissi–français, p. 47: semiyɛiyo; Childs 2000, p. 323: sèèméí-</text></form></note>
    <note><form lang="fr"><text>De seemaa « folie ». maa vana seemɛi « comme un fou » (1SA.21.14, 2KI.9.20) ; vanaa seemɛiya (1SA.21.16) ; vana seemɛiyo (ECC.10.14) ; nààla seemɛilan « la folie » (DEU.28.28) ; O seema « il est fou » (JHN.10.20). Paulme 1964, p. 93 : ɔ tyɔ semɛyo, pl. semɛya « fou, simple d'esprit ».</text></form></note>
  </entry>
  <entry id="seenguuvo_4471">
