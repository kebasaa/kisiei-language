    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « loi de tête » ?</text></form></note>
  </entry>
  <entry id="sàwàá_4447">
    <lexical-unit><form lang="kqs"><text>sàwàá</text></form></lexical-unit>
