    <variant><form lang="kqs"><text>yei</text></form></variant>
    <sense id="yeiyo_3851_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insulter, injurier, défier ; blasphémer</text></gloss>
