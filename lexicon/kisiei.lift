      <gloss lang="fr"><text>la journée, le jour</text></gloss>
      <gloss lang="en"><text>in the daytime</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>afternoon</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first GEN.1.5; Keita 1979, p. 152: Ipala; Lexique kissi–français, p. 20: ipala; Childs 2000, p. 139: ìpàlàá</text></form></note>
  </entry>
  <entry id="ipalaa_1353">
    <lexical-unit><form lang="kqs"><text>ipalaa</text></form></lexical-unit>
