      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 217 occurrences, first GEN.1.1; Paulme 1964, p. 102: taso; Lexique kissi–français, p. 40: o tasoo; Childs 2000, p. 350: tàsé-</text></form></note>
  </entry>
