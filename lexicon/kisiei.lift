    <lexical-unit><form lang="kqs"><text>leeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="leeloo_993_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>de l'autre côté de, au-delà de</text></gloss>
      <gloss lang="en"><text>on the other side of, beyond</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>across, on the other side; in Liberia also a name for Guinea</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 110 occurrences, first GEN.50.10; Childs 2000, p. 225: lèèlò</text></form></note>
  </entry>
  <entry id="leendo_994">
    <lexical-unit><form lang="kqs"><text>leendo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>leenda</text></form></field>
    <sense id="leendo_994_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>margouillat</text></gloss>
      <gloss lang="en"><text>agama lizard</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gecko, a black lizard</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Leendo; Childs 2000, p. 226: lééŋndó</text></form></note>
    <note><form lang="fr"><text>Le pluriel leenda « lézards » est dans la Bible (LEV.11.29, PRO.30.28).</text></form></note>
  </entry>
  <entry id="lefoo_995">
    <lexical-unit><form lang="kqs"><text>lefoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefoo_995_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beau-père ; (lefu … laandoo) belle-mère</text></gloss>
      <gloss lang="en"><text>father-in-law; (lefu … laandoo) mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.18.1</text></form></note>
  </entry>
  <entry id="lefuo_996">
    <lexical-unit><form lang="kqs"><text>lefuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lefua</text></form></field>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefuo_996_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent par alliance : gendre, bru, beau-père, belle-mère</text></gloss>
      <gloss lang="en"><text>in-law: son-in-law, daughter-in-law, father-in-law, mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in-law</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Lefuo; Childs 2000, p. 226: lèfòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale lefu attestée (Jéthro, beau-père de Moïse, Ex 3,1) ; pluriel lefua « gendres » (Gn 19,14). Keita donne aussi Nde lefu « la belle-mère ».</text></form></note>
  </entry>
  <entry id="lekáá_997">
    <lexical-unit><form lang="kqs"><text>lekáá</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="lekáá_997_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éloignement, exil (o lekáá « au loin, banni, perdu »)</text></gloss>
      <gloss lang="en"><text>absence, exile (o lekáá 'away, banished, lost')</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note><form lang="fr"><text>Simeɔn bɛɛ lo o lekáá « Siméon aussi n'est plus » (Gn 42,36) ; po nɔm co o lekáá-o « ton fils banni » (2 S 14,13).</text></form></note>
  </entry>
  <entry id="lekaando_998">
