  <entry id="kosɛbɛ_2270">
    <lexical-unit><form lang="kqs"><text>kosɛbɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kosɛbɛ_2270_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup</text></gloss>
      <gloss lang="en"><text>a lot, much</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: kosɛbɛ</text></form></note>
  </entry>
  <entry id="kotaa_2271">
    <lexical-unit><form lang="kqs"><text>kotaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>kota</text></form></variant>
    <sense id="kotaa_2271_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mépriser</text></gloss>
      <gloss lang="en"><text>despise</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: kotaa/ kota</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, kotaa (JER.30.16) semble signifier « piller » ; le sens « mépriser » est à confirmer.</text></form></note>
  </entry>
  <entry id="kòtòkpàkpéɛ́yó_2272">
    <lexical-unit><form lang="kqs"><text>kòtòkpàkpéɛ́yó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kòtòkpàkpéɛ́yó_2272_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie vénérienne (enflure de l'aine)</text></gloss>
      <gloss lang="en"><text>venereal disease (swelling in the groin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 180: kòtòkpàkpéɛ́yó</text></form></note>
  </entry>
