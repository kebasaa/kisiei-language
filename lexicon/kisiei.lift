      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'enfoncer, se planter (dans) ; s'accrocher, rester pris</text></gloss>
      <gloss lang="en"><text>sink into, stick into; get caught</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.36.22</text></form></note>
    <note><form lang="fr"><text>mó sɔɔŋa ndu o itendu « (la pierre) s'enfonça dans son front » (1 S 17,49).</text></form></note>
  </entry>
  <entry id="sɔɛi_1578">
