    <variant><form lang="kqs"><text>kɔndɔfili</text></form></variant>
    <variant><form lang="kqs"><text>kɔndɔfilta</text></form></variant>
    <sense id="kɔndɔfillo_908_s1">
      <grammatical-info value="Noun"/>
