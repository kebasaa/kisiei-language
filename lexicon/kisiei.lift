    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 102: tasa, pl. tasarã; Lexique kissi–français, p. 54: tasaa</text></form></note>
    <note><form lang="fr"><text>Homographe de tasaa « chauve-souris ».</text></form></note>
  </entry>
  <entry id="tasaa_5127">
    <lexical-unit><form lang="kqs"><text>tasaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>tasalan</text></form></field>
