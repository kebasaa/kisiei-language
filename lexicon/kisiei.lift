  <entry id="kpàsàá_1817">
    <lexical-unit><form lang="kqs"><text>kpàsàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpàsàláŋ</text></form></field>
