      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>défunt, feu (personne décédée)</text></gloss>
      <gloss lang="en"><text>late, deceased</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deceased person, the late; a corpse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.4.5; Childs 2000, p. 109: fɔ̀nɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lanɔɔ fɔ̀nɔ̀ Nabal « la veuve de Nabal » (1 S 27,3).</text></form></note>
  </entry>
