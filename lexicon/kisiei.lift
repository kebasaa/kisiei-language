    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suili</text></form></variant>
    <variant><form lang="kqs"><text>suilinin</text></form></variant>
    <sense id="suilio_3098_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir, atteindre (un âge) ; faire devenir, établir (roi)</text></gloss>
      <gloss lang="en"><text>become, reach (an age); make (someone) become, appoint (king)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first EXO.5.11</text></form></note>
    <note><form lang="fr"><text>Vɔsi Abram suili vɔsilan … « lorsqu'Abram eut 99 ans » (Gn 17,1) ; David suilio masaa « faire David roi » (1 Ch 12,32).</text></form></note>
  </entry>
