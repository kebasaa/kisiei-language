    <sense id="taw_5133_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>très, beaucoup</text></gloss>
      <gloss lang="en"><text>very, a lot</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'everywhere, plentifully'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1837 occurrences, first GEN.1.20; Paulme 1964, p. 103: tau; Lexique kissi–français, p. 54: tau; Childs 2000, p. 350: táù</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 102-103 : tao, tau « grand ; beaucoup, trop nombreux ».</text></form></note>
