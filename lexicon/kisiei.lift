      <gloss lang="fr"><text>colonne vertébrale</text></gloss>
      <gloss lang="en"><text>spine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Kèmbèi Köi; Lexique kissi–français, p. 23: kɛnbei kɔi</text></form></note>
  </entry>
  <entry id="kɛmbɛi laboloei_2277">
