  <entry id="kiɔndɔɔ_1632">
    <lexical-unit><form lang="kqs"><text>kiɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiɔndu</text></form></variant>
    <variant><form lang="kqs"><text>kiandu</text></form></variant>
    <variant><form lang="kqs"><text>kiandunin</text></form></variant>
    <variant><form lang="kqs"><text>kendu</text></form></variant>
