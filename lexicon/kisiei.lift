      <gloss lang="en"><text>no! (strong disagreement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkó</text></form></note>
