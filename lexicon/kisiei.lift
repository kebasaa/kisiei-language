      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: seelen sorio</text></form></note>
    <note><form lang="fr"><text>Littéralement « faire sortir le témoignage » (Lexique). Voir aussi seilen tɛndaa.</text></form></note>
