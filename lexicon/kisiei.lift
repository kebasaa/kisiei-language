      <gloss lang="en"><text>undershirt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 86: dòmà-lé-bɛ́ŋgóó</text></form></note>
  </entry>
  <entry id="domaa_709">
    <lexical-unit><form lang="kqs"><text>domaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>domalan</text></form></field>
    <variant><form lang="kqs"><text>doma</text></form></variant>
    <variant><form lang="kqs"><text>domala</text></form></variant>
    <sense id="domaa_709_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chemise, vêtement ; vêtement, habit, manteau</text></gloss>
      <gloss lang="en"><text>shirt, garment ; garment, clothing, cloak</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shirt, gown, robe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.39.12; Keita 1979, p. 144: Domaa; Childs 2000, p. 86: dòmàá</text></form></note>
  </entry>
  <entry id="dombio_710">
    <lexical-unit><form lang="kqs"><text>dombio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dombi</text></form></variant>
    <variant><form lang="kqs"><text>dombinin</text></form></variant>
    <sense id="dombio_710_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>goûter</text></gloss>
      <gloss lang="en"><text>taste</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.10.10; Childs 2000, p. 71: dèmbìó</text></form></note>
    <note><form lang="fr"><text>Childs : dèmbìó, dont dèèmbùùwó (cf. deembuuo) est le pluriel. a dombinin mɛnndan a lediɛɛmu « ceux qui laperont l'eau avec la langue » (Jg 7,5).</text></form></note>
  </entry>
  <entry id="dòndópólòó_711">
