      <gloss lang="fr"><text>liane dont le fruit sert d'éponge pour le bain</text></gloss>
      <gloss lang="en"><text>vine whose fruit is used as a bath sponge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 71: dàpàléŋ</text></form></note>
  </entry>
  <entry id="dasa_988">
