  <entry id="màákèétìyó_2565">
    <lexical-unit><form lang="kqs"><text>màákèétìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="màákèétìyó_2565_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vaccination</text></gloss>
      <gloss lang="en"><text>vaccination</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 238: màákèétìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt probable selon Childs.</text></form></note>
  </entry>
  <entry id="mààla_2566">
    <lexical-unit><form lang="kqs"><text>mààla</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mààlan</text></form></variant>
    <sense id="mààla_2566_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abomination, acte infâme, transgression d'un interdit (tosa mààla « commettre une infamie »)</text></gloss>
      <gloss lang="en"><text>abomination, disgraceful act, breach of a taboo (tosa mààla, commit an outrage)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>taboo, behavioural restriction (e.g. incest), whose breach brings illness; obligation, debt</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.19.7; Childs 2000, p. 238: mǎá</text></form></note>
    <note><form lang="fr"><text>la tosà mààla vaa lende le « ne commettez pas un tel crime » (GEN.19.7) ; mààla bɛndu-bɛndulan « une grave abomination » (LEV.20.13). Childs : pluriel mààláŋ.</text></form></note>
  </entry>
  <entry id="maalianndo_2567">
    <lexical-unit><form lang="kqs"><text>maalianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>maalian</text></form></variant>
    <sense id="maalianndo_2567_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entraider</text></gloss>
      <gloss lang="en"><text>help one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.41.6; Keita 1979, p. 110: Maalianndo; Lexique kissi–français, p. 33: maalianndo/ maalian</text></form></note>
    <note><form lang="fr"><text>Réciproque de malaa.</text></form></note>
  </entry>
  <entry id="maalon_2568">
    <lexical-unit><form lang="kqs"><text>maalon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="maalon_2568_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz ; blé</text></gloss>
      <gloss lang="en"><text>rice; wheat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 76 occurrences, first GEN.30.14; Keita 1979, p. 139: Maalon; Lexique kissi–français, p. 33: maalon</text></form></note>
    <note><form lang="fr"><text>La Bible l'emploie aussi pour le blé (GEN.30.14).</text></form></note>
  </entry>
  <entry id="mààmàdúnɔ́_2569">
    <lexical-unit><form lang="kqs"><text>mààmàdúnɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>mààmàdúá</text></form></field>
    <sense id="mààmàdúnɔ́_2569_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre du lignage à qui le babouin est interdit (totem)</text></gloss>
      <gloss lang="en"><text>member of the lineage for whom eating baboon is taboo</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 239: mààmàdúnɔ́</text></form></note>
  </entry>
  <entry id="máámúúléŋ_2570">
    <lexical-unit><form lang="kqs"><text>máámúúléŋ</text></form></lexical-unit>
