    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>foeeŋii</text></form></variant>
    <variant><form lang="kqs"><text>foeŋii</text></form></variant>
    <sense id="foeende_872_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paille ; balle (du grain)</text></gloss>
