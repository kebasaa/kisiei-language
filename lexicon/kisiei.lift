    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.16.4</text></form></note>
  </entry>
  <entry id="tɛɛndiaa_1761">
    <lexical-unit><form lang="kqs"><text>tɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛndiaanin</text></form></variant>
    <variant><form lang="kqs"><text>tɛɛndian</text></form></variant>
    <sense id="tɛɛndiaa_1761_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, faire éclater ; se fendre, s'ouvrir (terre)</text></gloss>
      <gloss lang="en"><text>split, burst open; split apart (earth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>split; divide, distribute; show one by one</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.7.11; Childs 2000, p. 353: tɛ̀ɛ̀ndìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛndaa « fendre ».</text></form></note>
  </entry>
  <entry id="tɛ̀ɛ̀ndo_1762">
    <lexical-unit><form lang="kqs"><text>tɛ̀ɛ̀ndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tɛ̀ɛ̀ndo_1762_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>teigne</text></gloss>
      <gloss lang="en"><text>scalp ringworm, scall</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ringworm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.11.4; Keita 1979, p. 162: Tèèndo; Childs 2000, p. 355: tɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit tɛ̀ɛ̀ndo dans ce sens ; tɛɛndo sans ton y signifie « du milieu » (Ex 26,28).</text></form></note>
  </entry>
  <entry id="tɛɛngaa_1763">
    <lexical-unit><form lang="kqs"><text>tɛɛngaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛngaa_1763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, transporter ; transmettre (un message)</text></gloss>
      <gloss lang="en"><text>convey, carry across; deliver (a message)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 619 occurrences, first GEN.20.7</text></form></note>
    <note><form lang="fr"><text>vana-tɛɛngaa-diom-Hala « prophète » ; vanaa tɛɛngaa « les marins » (Jon 1,5).</text></form></note>
  </entry>
  <entry id="tɛɛngei_1764">
    <lexical-unit><form lang="kqs"><text>tɛɛngei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>tɛɛngon</text></form></field>
    <sense id="tɛɛngei_1764_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trou, brèche, creux</text></gloss>
      <gloss lang="en"><text>hole, breach, hollow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hole; burrow (of a rat or squirrel)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first JDG.15.19; Childs 2000, p. 354: tèèŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tɛɛngullo_1765">
    <lexical-unit><form lang="kqs"><text>tɛɛngullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛngul</text></form></variant>
    <sense id="tɛɛngullo_1765_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>annoncer, rapporter (à qqn), dire à</text></gloss>
      <gloss lang="en"><text>tell, report (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take (someone) across for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first EXO.4.16; Childs 2000, p. 355: tèèŋùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛngaa.</text></form></note>
  </entry>
  <entry id="tɛɛnguuo_1766">
    <lexical-unit><form lang="kqs"><text>tɛɛnguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛɛnguu</text></form></variant>
    <sense id="tɛɛnguuo_1766_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire traverser, faire passer (plusieurs)</text></gloss>
      <gloss lang="en"><text>take across, make (many) cross</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cross with or carry across (a river); plural of tàŋɔ̀ɔ́ 'cross'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first NUM.11.27; Childs 2000, p. 355: tèèŋùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de tɛɛngaa.</text></form></note>
  </entry>
  <entry id="tɛɛnɔn_1767">
    <lexical-unit><form lang="kqs"><text>tɛɛnɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="tɛɛnɔn_1767_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gravier</text></gloss>
      <gloss lang="en"><text>gravel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: Tèènön</text></form></note>
  </entry>
  <entry id="tɛɛsiaa_1768">
    <lexical-unit><form lang="kqs"><text>tɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsiaa_1768_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer</text></gloss>
      <gloss lang="en"><text>interpret, explain</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.40</text></form></note>
  </entry>
  <entry id="tɛɛsial_1769">
    <lexical-unit><form lang="kqs"><text>tɛɛsial</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tɛɛsial_1769_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>interpréter, expliquer (à qqn)</text></gloss>
      <gloss lang="en"><text>interpret, explain (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.4 Understand"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.41.12</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de tɛɛsiaa.</text></form></note>
  </entry>
  <entry id="va_1770">
    <lexical-unit><form lang="kqs"><text>va</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ve</text></form></variant>
    <variant><form lang="kqs"><text>vanin</text></form></variant>
    <sense id="va_1770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être (passé) ; auxiliaire du progressif passé</text></gloss>
      <gloss lang="en"><text>be (past); past progressive auxiliary</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11781 occurrences, first GEN.1.2</text></form></note>
  </entry>
  <entry id="vaa_1771">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vàálan</text></form></field>
    <sense id="vaa_1771_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>mille</text></gloss>
      <gloss lang="en"><text>thousand</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Childs 2000, p. 377: wàá</text></form></note>
  </entry>
  <entry id="vaa_1772">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>vee</text></form></variant>
    <variant><form lang="kqs"><text>veenin</text></form></variant>
    <sense id="vaa_1772_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cultiver, labourer</text></gloss>
      <gloss lang="en"><text>farm, plough</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Vaa</text></form></note>
    <note><form lang="fr"><text>le vàá « labourer » (DEU 22,10) ; vee, veenin : radical négatif (PRO 20,4 ; GEN 45,6). Homonyme de vaa « être ».</text></form></note>
  </entry>
  <entry id="vaa_1773">
    <lexical-unit><form lang="kqs"><text>vaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>co</text></form></variant>
    <variant><form lang="kqs"><text>va</text></form></variant>
    <sense id="vaa_1773_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être</text></gloss>
      <gloss lang="en"><text>be</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 666 occurrences, first GEN.1.16; Keita 1979, p. 115: Vaw</text></form></note>
    <note><form lang="fr"><text>Keita écrit vaw (radicaux tyo, vo, va) ; la Bible a le vaa « être » (GEN 3,12) ; vaw y désigne le palmier (JDG 4,5).</text></form></note>
  </entry>
  <entry id="vaaliaa_1774">
    <lexical-unit><form lang="kqs"><text>vaaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaaliaa_1774_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir aigre ; (dents) être agacées ; (âme) être amère</text></gloss>
      <gloss lang="en"><text>turn sour; (of teeth) be set on edge; be bitter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.7.11; Childs 2000, p. 377: wààlàá</text></form></note>
  </entry>
  <entry id="vaalio_1775">
    <lexical-unit><form lang="kqs"><text>vaalio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalio_1775_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>maintenant, de nos jours ; actuel (vanndacieea vaalio ho « cette génération »)</text></gloss>
      <gloss lang="en"><text>now, nowadays; present (vanndacieea vaalio ho 'this generation')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.5.14; Childs 2000, p. 377: wáálíò</text></form></note>
  </entry>
  <entry id="vaalɛiyan_1776">
    <lexical-unit><form lang="kqs"><text>vaalɛiyan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaalɛiyan_1776_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aigre (mɔima vaalɛiyan « vinaigre »)</text></gloss>
      <gloss lang="en"><text>sour (mɔima vaalɛiyan 'vinegar')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.6.3; Childs 2000, p. 377: wààlɛ́í</text></form></note>
    <note><form lang="fr"><text>De vaaliaa.</text></form></note>
  </entry>
  <entry id="vaan-vaan_1777">
    <lexical-unit><form lang="kqs"><text>vaan-vaan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="vaan-vaan_1777_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fin, léger (tissu) : kola vaan-vaan « voile »</text></gloss>
      <gloss lang="en"><text>fine, thin (cloth): kola vaan-vaan 'veil'</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note><form lang="fr"><text>Toujours dans kola vaan-vaan « voile » (GEN.38.19, SNG.4.1, 2CO.3.14) ; le sens propre de vaan-vaan est à confirmer.</text></form></note>
  </entry>
  <entry id="vaasan_1778">
    <lexical-unit><form lang="kqs"><text>vaasan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaasan_1778_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>incisions, entailles (sur le corps, en signe de deuil)</text></gloss>
      <gloss lang="en"><text>cuts, gashes (on the body, in mourning)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="5.4.6 Ritual scar"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first LEV.19.28</text></form></note>
    <note><form lang="fr"><text>keŋnun / kiáŋnun vaasan lekɔɔ « se faire des incisions » (LEV.21.5, LEV.19.28).</text></form></note>
  </entry>
  <entry id="vakpa_1779">
    <lexical-unit><form lang="kqs"><text>vakpa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vakpa_1779_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, ouvertement, à découvert</text></gloss>
      <gloss lang="en"><text>clearly, openly, in plain view</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.30.37</text></form></note>
    <note><form lang="fr"><text>o fula vannda o hɔl vakpa le « il ne monta pas ouvertement » (JHN.7.10).</text></form></note>
  </entry>
  <entry id="vallo_1780">
    <lexical-unit><form lang="kqs"><text>vallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>valtan</text></form></field>
    <variant><form lang="kqs"><text>vali</text></form></variant>
    <variant><form lang="kqs"><text>valta</text></form></variant>
    <variant><form lang="kqs"><text>vallon</text></form></variant>
    <sense id="vallo_1780_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage</text></gloss>
      <gloss lang="en"><text>work, labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 137 occurrences, first GEN.2.2; Childs 2000, p. 379: wàlló</text></form></note>
    <note><form lang="fr"><text>ɲɛm vallon « ustensiles » (Ex 31,8).</text></form></note>
  </entry>
  <entry id="vana_1781">
    <lexical-unit><form lang="kqs"><text>vana</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vanaa</text></form></field>
    <sense id="vana_1781_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui qui, quelqu'un (tête de relative) ; personne</text></gloss>
      <gloss lang="en"><text>the one who, someone (head of a relative clause); person</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="2 Person"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9813 occurrences, first GEN.1.26; Childs 2000, p. 379: wànà-</text></form></note>
    <note><form lang="fr"><text>Pluriel vanaa « ceux qui, les gens » : vanaa mandaa n'cɔlua « ceux qui gardent les troupeaux » (Gn 4,20).</text></form></note>
  </entry>
  <entry id="vana lacòòva_1782">
    <lexical-unit><form lang="kqs"><text>vana lacòòva</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vana lacòòva_1782_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>menteur</text></gloss>
      <gloss lang="en"><text>liar</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lie, falsehood</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Vana latyoova; Childs 2000, p. 53: cɔ̀ɔ̀láŋ</text></form></note>
    <note><form lang="fr"><text>Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="vana tambɛiyo_1783">
    <lexical-unit><form lang="kqs"><text>vana tambɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="vana tambɛiyo_1783_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>infirme, estropié</text></gloss>
      <gloss lang="en"><text>disabled person, cripple</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>poverty</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Vana tambèiyo; Childs 2000, p. 348: tàmbɛ̀í</text></form></note>
    <note><form lang="fr"><text>Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="vana-vana_1784">
    <lexical-unit><form lang="kqs"><text>vana-vana</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vana-vana_1784_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>quelqu'un ; (nég.) personne</text></gloss>
      <gloss lang="en"><text>anyone; (neg.) no one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1209 occurrences, first GEN.2.25</text></form></note>
  </entry>
  <entry id="vanabolofaa_1785">
    <lexical-unit><form lang="kqs"><text>vanabolofaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vanabolofaa_1785_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riche</text></gloss>
      <gloss lang="en"><text>rich person</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Vanabolofaa</text></form></note>
    <note><form lang="fr"><text>bolofaa « richesse » est attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="vanabɛnduyɛi_1786">
    <lexical-unit><form lang="kqs"><text>vanabɛnduyɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vanabɛnduyɛi_1786_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grandeur, majesté, gloire ; rang de chef</text></gloss>
      <gloss lang="en"><text>greatness, majesty, glory; leadership</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first DEU.28.13</text></form></note>
    <note><form lang="fr"><text>De vana bɛndu « grand personnage » et -yɛi. O kenin niaa vanabɛnduyɛi « il fera de vous la tête » (DEU.28.13).</text></form></note>
  </entry>
  <entry id="vanacamndo_1787">
    <lexical-unit><form lang="kqs"><text>vanacamndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vanacamndo_1787_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>magicien</text></gloss>
      <gloss lang="en"><text>magician</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Vanatyamndo</text></form></note>
