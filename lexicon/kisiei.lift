      <gloss lang="en"><text>big strong enduring dog (for hunting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 100: féláwûlló</text></form></note>
