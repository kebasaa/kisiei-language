  <entry id="heelanndo_1019">
    <lexical-unit><form lang="kqs"><text>heelanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelanndo_1019_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orgueil, fierté ; ce dont on se glorifie</text></gloss>
      <gloss lang="en"><text>pride, haughtiness; one's glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.17.6</text></form></note>
    <note><form lang="fr"><text>Dérivé de heeloo « lever ». tofa heelanndo « regard hautain » (Pr 21,4).</text></form></note>
  </entry>
  <entry id="heeloo_1020">
    <lexical-unit><form lang="kqs"><text>heeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <variant><form lang="kqs"><text>heelunin</text></form></variant>
    <variant><form lang="kqs"><text>heelaa</text></form></variant>
    <sense id="heeloo_1020_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever</text></gloss>
      <gloss lang="en"><text>lift up, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>raise; praise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first 2SA.22.42; Childs 2000, p. 120: hèèlòó</text></form></note>
  </entry>
  <entry id="heeluo_1021">
    <lexical-unit><form lang="kqs"><text>heeluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="heeluo_1021_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever, faire monter</text></gloss>
      <gloss lang="en"><text>lift, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put up, raise, lift, erect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Heeluo; Childs 2000, p. 119: hèèlòó</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : heelu (lever les yeux, la main), heelunin, heelun (GEN 5,24).</text></form></note>
  </entry>
  <entry id="heelɔnndo_1022">
    <lexical-unit><form lang="kqs"><text>heelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelɔnndo_1022_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'élever, s'enorgueillir ; (sondoo heelɔnndo) parler avec arrogance</text></gloss>
      <gloss lang="en"><text>exalt oneself, be proud; (sondoo heelɔnndo) speak arrogantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.73.9</text></form></note>
    <note><form lang="fr"><text>Moyen de heeloo « lever ».</text></form></note>
  </entry>
  <entry id="héèyó_1023">
