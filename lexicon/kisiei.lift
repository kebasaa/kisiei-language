    <trait name="status" value="southern"/>
    <sense id="múúyɔ̀ŋ_2300_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>farine de riz à grains durs et fins</text></gloss>
      <gloss lang="en"><text>rice flour of tiny hard grains</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 256: múúyɔ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Emprunt probable au mendé ; au Liberia kèŋèmùkíóó.</text></form></note>
  </entry>
  <entry id="mùúŋndɔ̀ɔ́_2301">
    <lexical-unit><form lang="kqs"><text>mùúŋndɔ̀ɔ́</text></form></lexical-unit>
