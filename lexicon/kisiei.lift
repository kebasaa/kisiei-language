    <note><form lang="fr"><text>Lexique kissi–français, p. 38 : aussi ɲahalama.</text></form></note>
  </entry>
  <entry id="ɲaiyo_6480">
    <lexical-unit><form lang="kqs"><text>ɲaiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="ɲaiyo_6480_s1">
