  </entry>
  <entry id="siɔlɔɔ_3592">
    <lexical-unit><form lang="kqs"><text>siɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɔl</text></form></variant>
    <sense id="siɔlɔɔ_3592_s1">
      <grammatical-info value="Verb"/>
