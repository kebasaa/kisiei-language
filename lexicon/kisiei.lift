      <gloss lang="en"><text>spy out, explore; examine, search</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first NUM.13.2</text></form></note>
