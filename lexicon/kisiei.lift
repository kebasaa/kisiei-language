    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.13.20</text></form></note>
  </entry>
  <entry id="cɛɛŋɔnndo_616">
    <lexical-unit><form lang="kqs"><text>cɛɛŋɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɛɛŋun</text></form></variant>
    <variant><form lang="kqs"><text>cɛɛŋɔnnda</text></form></variant>
    <sense id="cɛɛŋɔnndo_616_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supplier, implorer ; supplication</text></gloss>
      <gloss lang="en"><text>plead, beseech; supplication</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.41.55</text></form></note>
  </entry>
  <entry id="daadaa_617">
    <lexical-unit><form lang="kqs"><text>daadaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="daadaa_617_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>menton</text></gloss>
      <gloss lang="en"><text>chin</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Daadaa; Childs 2000, p. 69: dáádáá</text></form></note>
  </entry>
  <entry id="dààdɔ́kpùɛ́í_618">
    <lexical-unit><form lang="kqs"><text>dààdɔ́kpùɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dààdɔ́kpɔ̌ŋ</text></form></field>
    <sense id="dààdɔ́kpùɛ́í_618_s1">
      <grammatical-info value="Noun"/>
