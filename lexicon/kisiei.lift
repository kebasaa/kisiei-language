      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first LEV.16.21</text></form></note>
    <note><form lang="fr"><text>De tɛɛmbuuo « détruire ; transgresser ».</text></form></note>
