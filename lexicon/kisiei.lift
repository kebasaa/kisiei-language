    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. bɔɔŋian taasila laandoo « diphtongue ».</text></form></note>
  </entry>
  <entry id="bɔŋanndo_483">
    <lexical-unit><form lang="kqs"><text>bɔŋanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
