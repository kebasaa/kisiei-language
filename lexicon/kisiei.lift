      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 89 occurrences, first GEN.20.16</text></form></note>
  </entry>
  <entry id="latulu_3066">
    <lexical-unit><form lang="kqs"><text>latulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="latulu_3066_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ensemble, en même temps</text></gloss>
      <gloss lang="en"><text>together, at the same time</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 428 occurrences, first GEN.3.6; Childs 2000, p. 224: làtùlú</text></form></note>
  </entry>
  <entry id="latɔŋndo_3067">
    <lexical-unit><form lang="kqs"><text>latɔŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>latɔŋnda</text></form></field>
    <sense id="latɔŋndo_3067_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>loi (de Moïse)</text></gloss>
      <gloss lang="en"><text>law (of Moses)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EZR.7.6</text></form></note>
    <note><form lang="fr"><text>vanaa pɛɛkaa latɔŋnda « les maîtres de la loi ».</text></form></note>
