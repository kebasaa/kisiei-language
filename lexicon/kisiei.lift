      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paix, tranquillité ; (pl.) sacrifices de paix</text></gloss>
      <gloss lang="en"><text>peace ; peace, rest; (pl.) peace offerings</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 297 occurrences, first GEN.5.29; Keita 1979, p. 148: kölnyuluo; Lexique kissi–français, p. 27: kɔlɲuluo</text></form></note>
    <note><form lang="fr"><text>Keita écrit kölnyuluo ; la Bible a kɔlɲuloo.</text></form></note>
  </entry>
  <entry id="kɔ̀màá_2204">
    <lexical-unit><form lang="kqs"><text>kɔ̀màá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀màá_2204_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand masque (« diable ») rapide qui porte des planches</text></gloss>
      <gloss lang="en"><text>large fast-moving masked 'devil' that carries planks</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 183: kɔ̀màá</text></form></note>
  </entry>
  <entry id="kɔmanndo_2205">
    <lexical-unit><form lang="kqs"><text>kɔmanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔman</text></form></variant>
    <sense id="kɔmanndo_2205_s1">
