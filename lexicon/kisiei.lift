    <trait name="status" value="southern"/>
    <sense id="hébè_1018_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en filant à toute allure (passer)</text></gloss>
      <gloss lang="en"><text>zooming by (pass)</text></gloss>
