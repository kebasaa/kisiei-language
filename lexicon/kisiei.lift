      <gloss lang="en"><text>group organized for joint labour, cooperative</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 238: màá</text></form></note>
  </entry>
  <entry id="máàcàcà_2564">
    <lexical-unit><form lang="kqs"><text>máàcàcà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="máàcàcà_2564_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>collant, poisseux</text></gloss>
      <gloss lang="en"><text>sticky</text></gloss>
