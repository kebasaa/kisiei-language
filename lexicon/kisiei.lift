  <entry id="doosulen_714">
    <lexical-unit><form lang="kqs"><text>doosulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doosule</text></form></variant>
    <sense id="doosulen_714_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse</text></gloss>
      <gloss lang="en"><text>hunting, the hunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.25.29; Childs 2000, p. 87: dòòsùléŋ</text></form></note>
    <note><form lang="fr"><text>kɔɛ doosulen « aller à la chasse ». Cf. doosunɔɔ « chasseur ».</text></form></note>
  </entry>
  <entry id="doosunɔɔ_715">
    <lexical-unit><form lang="kqs"><text>doosunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="doosunɔɔ_715_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur, oiseleur</text></gloss>
      <gloss lang="en"><text>hunter, fowler</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.1.17; Keita 1979, p. 145: Doosunöö; Childs 2000, p. 87: dòòsùnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="dovin_716">
    <lexical-unit><form lang="kqs"><text>dovin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dovin_716_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se parer, s'équiper</text></gloss>
      <gloss lang="en"><text>adorn oneself, equip oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.40.10</text></form></note>
    <note><form lang="fr"><text>Moyen de dovio. ɲɛm kɛndɛn n'dovin-ndon « tes belles parures » (Ez 16,39).</text></form></note>
  </entry>
  <entry id="dovio_717">
    <lexical-unit><form lang="kqs"><text>dovio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dovi</text></form></variant>
    <sense id="dovio_717_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>charger (une bête) ; atteler, équiper ; revêtir (d'une armure)</text></gloss>
      <gloss lang="en"><text>load (an animal); harness, equip; clothe (in armour)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2KI.9.21</text></form></note>
  </entry>
  <entry id="downun_718">
    <lexical-unit><form lang="kqs"><text>downun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>downunnin</text></form></variant>
    <variant><form lang="kqs"><text>downɔnndo</text></form></variant>
    <sense id="downun_718_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>informer, donner des nouvelles (downun X kona « raconter à X »)</text></gloss>
      <gloss lang="en"><text>inform, report (downun X kona 'tell X the news')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first GEN.24.66</text></form></note>
  </entry>
  <entry id="doŋ_719">
    <lexical-unit><form lang="kqs"><text>doŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doŋ-doŋ</text></form></variant>
    <sense id="doŋ_719_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>silencieusement, dans un calme complet (ɲɔɔ mei doŋ « tout se tut »)</text></gloss>
      <gloss lang="en"><text>silently, in complete calm (ɲɔɔ mei doŋ 'all was still')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>quietly, silently, gently</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.64.9; Childs 2000, p. 87: dóŋ</text></form></note>
    <note><form lang="fr"><text>doŋ-doŋ (ISA.64.9, REV.8.1).</text></form></note>
  </entry>
  <entry id="dóŋdóŋndó_720">
    <lexical-unit><form lang="kqs"><text>dóŋdóŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dóŋdóŋndó_720_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>février (mois calme)</text></gloss>
      <gloss lang="en"><text>February (the quiet month)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 87: dóŋdóŋndó</text></form></note>
    <note><form lang="fr"><text>Lié à dóŋ « silencieusement ».</text></form></note>
  </entry>
  <entry id="dóŋó-dóŋó_721">
    <lexical-unit><form lang="kqs"><text>dóŋó-dóŋó</text></form></lexical-unit>
