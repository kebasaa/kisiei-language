  </entry>
  <entry id="kpekpeo_1851">
    <lexical-unit><form lang="kqs"><text>kpekpeo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kpekpeo_1851_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cafard, blatte</text></gloss>
      <gloss lang="en"><text>cockroach</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpekpeo; Childs 2000, p. 209: kpèkpòó kpèkpìá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 28 (« le cafard »). Pluriel en kissi du Sud (Childs 2000) : kpèkpìá.</text></form></note>
  </entry>
  <entry id="kpekpeyangaa_1852">
