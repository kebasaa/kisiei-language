    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kòlòó</text></form></note>
  </entry>
  <entry id="kòlòsɔ̀yɔ̀ɔ́_2203">
    <lexical-unit><form lang="kqs"><text>kòlòsɔ̀yɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
