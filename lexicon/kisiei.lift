    <trait name="status" value="attested"/>
    <sense id="icali_1793_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>séjour, résidence ; (va icali) habiter ; (être) assis</text></gloss>
      <gloss lang="en"><text>residence; (va icali) live, dwell; seated, sitting</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stay, live (cited as a form of càllé 'sit')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 670 occurrences, first GEN.4.12; Lexique kissi–français, p. 20: icali; Childs 2000, p. 37: càllé</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 20 : icali « être assis ».</text></form></note>
  </entry>
