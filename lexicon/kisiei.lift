    <sense id="saa kóndóó_2814_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bélier</text></gloss>
      <gloss lang="en"><text>ram</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Saa kondoo</text></form></note>
  </entry>
  <entry id="saa laandoo_2815">
    <lexical-unit><form lang="kqs"><text>saa laandoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saa laandoo_2815_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brebis</text></gloss>
      <gloss lang="en"><text>ewe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Saa laanduo</text></form></note>
    <note><form lang="fr"><text>Keita écrit laanduo ; la Bible écrit laandoo « femelle ».</text></form></note>
  </entry>
  <entry id="sààbándìínɔ̀ɔ́_2816">
    <lexical-unit><form lang="kqs"><text>sààbándìínɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sààbándìíyá</text></form></field>
    <sense id="sààbándìínɔ̀ɔ́_2816_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porteur du sac du chef</text></gloss>
      <gloss lang="en"><text>chief's bag-carrier</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààbándìínɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sààbèíyó_2817">
    <lexical-unit><form lang="kqs"><text>sààbèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààbèíyó_2817_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bandage ; mèche (de lampe)</text></gloss>
      <gloss lang="en"><text>bandage; lamp wick</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààbèíyó</text></form></note>
  </entry>
  <entry id="saabelanɔɔ_2818">
    <lexical-unit><form lang="kqs"><text>saabelanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="saabelanɔɔ_2818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>architecte</text></gloss>
      <gloss lang="en"><text>architect</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Saabelanöö</text></form></note>
  </entry>
  <entry id="sààlàá_2819">
    <lexical-unit><form lang="kqs"><text>sààlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sààlàá_2819_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attraper (un objet lancé), saisir ; se mêler (à une dispute)</text></gloss>
      <gloss lang="en"><text>catch (something thrown), grab; join in (an argument)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààlàá</text></form></note>
  </entry>
  <entry id="saalan_2820">
    <lexical-unit><form lang="kqs"><text>saalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saalan_2820_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire attention à, se soucier de, tenir compte de ; (… le) négliger</text></gloss>
      <gloss lang="en"><text>pay attention to, heed, care about; (… le) neglect</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pay attention, do what someone says (middle of 'catch')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.21.29; Childs 2000, p. 316: sààlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Kɛ a saalan sɔɛi ken te « mais ils n'en tinrent pas compte » (MAT.22.5) ; o co saalan te? « cela ne te fait rien ? » (LUK.10.40) ; vanlaandua saalan haa isɔɔ le-a « femmes insouciantes » (ISA.32.11). À distinguer de saalanin, futur de « attraper » (LUK.4.11).</text></form></note>
  </entry>
  <entry id="saalɔnndo_2821">
    <lexical-unit><form lang="kqs"><text>saalɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saalun</text></form></variant>
    <variant><form lang="kqs"><text>saalunnin</text></form></variant>
    <sense id="saalɔnndo_2821_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trouver</text></gloss>
      <gloss lang="en"><text>find</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.2 Find"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.19.11</text></form></note>
  </entry>
  <entry id="sáálɛ́ŋ_2822">
    <lexical-unit><form lang="kqs"><text>sáálɛ́ŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sáálɛ́ŋ_2822_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeton (au jeu)</text></gloss>
      <gloss lang="en"><text>token (used in games)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sáálɛ́ŋ</text></form></note>
  </entry>
  <entry id="sáàmbáŋ_2823">
    <lexical-unit><form lang="kqs"><text>sáàmbáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="sáàmbáŋ_2823_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz blanc à grains longs</text></gloss>
      <gloss lang="en"><text>long-grained white rice variety</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sáàmbáŋ</text></form></note>
  </entry>
  <entry id="sààmɛ̀íyó_2824">
    <lexical-unit><form lang="kqs"><text>sààmɛ̀íyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààmɛ̀íyó_2824_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure (tasse) standard pour le riz</text></gloss>
      <gloss lang="en"><text>standard rice-measuring cup</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sààmɛ̀íyó</text></form></note>
  </entry>
  <entry id="saan_2825">
    <lexical-unit><form lang="kqs"><text>saan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saan_2825_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se mettre à, commencer à (faire)</text></gloss>
      <gloss lang="en"><text>begin, set about (doing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be held, hold oneself; start again (middle of 'hold')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.13.7; Childs 2000, p. 317: sàànɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Mí nda ŋiɔn kpow a saan caŋndo « et tous deux se mirent à pleurer » (GEN.33.4) ; a saan sɛɛngianndo « ils se mirent à se quereller » (GEN.13.7).</text></form></note>
  </entry>
  <entry id="saanaa_2826">
    <lexical-unit><form lang="kqs"><text>saanaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saana</text></form></variant>
    <sense id="saanaa_2826_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>nager</text></gloss>
      <gloss lang="en"><text>swim</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swim, float; overflow (river)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.25.11; Childs 2000, p. 316: sàànàá</text></form></note>
    <note><form lang="fr"><text>mɛnndan … vanáà del nin a saanaa « une eau où il fallait nager » (EZK.47.5) ; vana siɛndi balan le saanaa « le nageur étend les mains pour nager » (ISA.25.11) ; saana (ACT.27.42).</text></form></note>
  </entry>
  <entry id="sààndìá_2827">
    <lexical-unit><form lang="kqs"><text>sààndìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sààndìá_2827_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rejeter ; étirer, redresser ; peigner</text></gloss>
      <gloss lang="en"><text>throw out; stretch out straight; comb</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 316: sààndìá</text></form></note>
  </entry>
  <entry id="sáándííyó_2828">
    <lexical-unit><form lang="kqs"><text>sáándííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sáándííyó_2828_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clôture de concession</text></gloss>
      <gloss lang="en"><text>compound fence</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 317: sáándííyó</text></form></note>
  </entry>
  <entry id="saangiaa_2829">
    <lexical-unit><form lang="kqs"><text>saangiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saangiaa_2829_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>maltraiter, opprimer, faire souffrir</text></gloss>
      <gloss lang="en"><text>mistreat, oppress, afflict</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>labour, work hard all the time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.16.6; Childs 2000, p. 317: sààŋgìáá</text></form></note>
  </entry>
  <entry id="saangian_2830">
    <lexical-unit><form lang="kqs"><text>saangian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>saangianndo</text></form></variant>
    <sense id="saangian_2830_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peiner, se donner du mal, se fatiguer (à)</text></gloss>
      <gloss lang="en"><text>toil, labour, weary oneself (at)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural middle of 'tire'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.9.29; Childs 2000, p. 317: sààŋìàŋndó</text></form></note>
    <note><form lang="fr"><text>Saangian kiltan bolofaa kɔɔli le « ne te fatigue pas pour t'enrichir » (PRO.23.4) ; le yɛɛ niko mì kɔɛ saangian fondoo? « pourquoi me donner de la peine en vain ? » (JOB.9.29). De sangaa « être fatigué, peiner ».</text></form></note>
  </entry>
  <entry id="saani_2831">
    <lexical-unit><form lang="kqs"><text>saani</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saani_2831_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>planter, repiquer (un plant)</text></gloss>
      <gloss lang="en"><text>plant, set out (a seedling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plant in a nursery; look beautiful; sign</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.17.5; Childs 2000, p. 317: sààn̂ìó</text></form></note>
    <note><form lang="fr"><text>Forme courte ; la forme longue n'est pas dans la Bible. mó cua tɛyii yɔmndo pum …, mó kɔ saani ndi « il prit un plant … et alla le planter » (EZK.17.5).</text></form></note>
  </entry>
  <entry id="saasa_2832">
    <lexical-unit><form lang="kqs"><text>saasa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saasa_2832_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cage</text></gloss>
      <gloss lang="en"><text>cage</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>basket for holding chickens, chicken coop</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.19.9; Childs 2000, p. 317: sáásáá</text></form></note>
    <note><form lang="fr"><text>má vow ndu o saasa n'cilinndo nin « ils le mirent dans une cage de fer » (EZK.19.9).</text></form></note>
  </entry>
  <entry id="saasalan_2833">
    <lexical-unit><form lang="kqs"><text>saasalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="saasalan_2833_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>retranchements, ouvrages de siège (pl.)</text></gloss>
      <gloss lang="en"><text>siege works, ramparts (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>barricade, fortified fence; an early women's dance</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.29.3; Childs 2000, p. 317: sààsàá</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. i baŋnin kungala saasalan « je dresserai contre toi des retranchements » (ISA.29.3, EZK.21.27) ; saasaala (ISA.29.7).</text></form></note>
  </entry>
