    <variant><form lang="kqs"><text>deembuu</text></form></variant>
    <variant><form lang="kqs"><text>deembuunin</text></form></variant>
    <sense id="deembuuo_736_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>goûter ; sucer, lécher ; (a lasondo) baiser</text></gloss>
      <gloss lang="en"><text>taste; suck, lick; (a lasondo) kiss</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.32.13; Childs 2000, p. 71: dèèmbùùwó</text></form></note>
  </entry>
  <entry id="delaa_737">
    <lexical-unit><form lang="kqs"><text>delaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>del</text></form></variant>
    <variant><form lang="kqs"><text>deli</text></form></variant>
    <variant><form lang="kqs"><text>delnin</text></form></variant>
    <variant><form lang="kqs"><text>delinin</text></form></variant>
    <sense id="delaa_737_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber ; (del … coo) se jeter sur, attaquer</text></gloss>
      <gloss lang="en"><text>fall; (del … coo) fall upon, attack</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first EXO.23.5; Childs 2000, p. 72: dèlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="delalɔɔcoo_738">
    <lexical-unit><form lang="kqs"><text>delalɔɔcoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="delalɔɔcoo_738_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agression</text></gloss>
      <gloss lang="en"><text>assault, attack</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Delalöötyoo; Lexique kissi–français, p. 13: delalɔɔcoo</text></form></note>
  </entry>
  <entry id="delcoonɔɔ_739">
    <lexical-unit><form lang="kqs"><text>delcoonɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="delcoonɔɔ_739_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>agresseur</text></gloss>
      <gloss lang="en"><text>aggressor</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Deltyoonöö</text></form></note>
  </entry>
  <entry id="delian_740">
    <lexical-unit><form lang="kqs"><text>delian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="delian_740_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire tomber (grêle)</text></gloss>
      <gloss lang="en"><text>make fall, rain down (hail)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.9</text></form></note>
    <note><form lang="fr"><text>Dérivé de delaa « tomber ».</text></form></note>
  </entry>
  <entry id="delio_741">
    <lexical-unit><form lang="kqs"><text>delio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deli</text></form></variant>
    <variant><form lang="kqs"><text>delinin</text></form></variant>
    <sense id="delio_741_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber çà et là, tomber en nombre</text></gloss>
      <gloss lang="en"><text>fall here and there, fall in numbers</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.9.18; Keita 1979, p. 110: Delio; Lexique kissi–français, p. 13: delio/ deli</text></form></note>
    <note><form lang="fr"><text>Pluriel de delɔɔ (grêle qui tombe, EXO 9,18).</text></form></note>
  </entry>
  <entry id="delɔɔ_742">
    <lexical-unit><form lang="kqs"><text>delɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>del</text></form></variant>
    <variant><form lang="kqs"><text>delnin</text></form></variant>
    <sense id="delɔɔ_742_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber</text></gloss>
      <gloss lang="en"><text>fall</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fall, drop</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 206 occurrences, first GEN.15.12; Keita 1979, p. 110: Delöö; Lexique kissi–français, p. 13: delɔɔ/ del; Childs 2000, p. 72: dèlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="delɔɔ a nàà_743">
    <lexical-unit><form lang="kqs"><text>delɔɔ a nàà</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>del a nàà</text></form></variant>
    <sense id="delɔɔ a nàà_743_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tomber malade</text></gloss>
      <gloss lang="en"><text>fall ill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.1 Sick"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: delɔɔ a naa</text></form></note>
    <note><form lang="fr"><text>Littéralement « tomber dans la maladie » ; nàà « maladie ».</text></form></note>
  </entry>
  <entry id="delɔɔcoo_744">
    <lexical-unit><form lang="kqs"><text>delɔɔcoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="delɔɔcoo_744_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>violence, oppression, agression</text></gloss>
      <gloss lang="en"><text>violence, oppression, aggression</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first DEU.25.16; Keita 1979, p. 148: Delöötyoo; Lexique kissi–français, p. 13: delɔɔcoo</text></form></note>
  </entry>
  <entry id="dèmàá_745">
    <lexical-unit><form lang="kqs"><text>dèmàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dèmàá_745_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ne pas arriver à finir, échouer</text></gloss>
      <gloss lang="en"><text>fail to finish, be unable to complete</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 72: dèmàá</text></form></note>
  </entry>
  <entry id="dèmbé-sálámáá_746">
    <lexical-unit><form lang="kqs"><text>dèmbé-sálámáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dèmbé-sálámáá_746_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte forestier brun clair semblable au cafard</text></gloss>
      <gloss lang="en"><text>light-brown forest insect resembling a cockroach</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 72: dèmbé-sálámáá</text></form></note>
  </entry>
  <entry id="démbékɔ́lɔ́ɔ́_747">
    <lexical-unit><form lang="kqs"><text>démbékɔ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>démbékɔ́lúá</text></form></field>
    <sense id="démbékɔ́lɔ́ɔ́_747_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau à longue queue (vu à la récolte)</text></gloss>
      <gloss lang="en"><text>long-tailed bird (seen at harvest time)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 72: démbékɔ́lɔ́ɔ́</text></form></note>
  </entry>
  <entry id="démbídáláá_748">
    <lexical-unit><form lang="kqs"><text>démbídáláá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="démbídáláá_748_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>feuille de nénuphar</text></gloss>
      <gloss lang="en"><text>lily pad</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 72: démbídáláá</text></form></note>
  </entry>
  <entry id="demboo_749">
    <lexical-unit><form lang="kqs"><text>demboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dembe</text></form></variant>
    <sense id="demboo_749_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ventre, estomac ; sein (maternel)</text></gloss>
      <gloss lang="en"><text>belly, stomach ; belly; womb</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first LEV.11.42; Keita 1979, p. 131: Demboo; Lexique kissi–français, p. 13: denboo; Childs 2000, p. 73: dèmbòó</text></form></note>
  </entry>
  <entry id="demullo_750">
    <lexical-unit><form lang="kqs"><text>demullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>demul</text></form></variant>
    <sense id="demullo_750_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller à la rencontre de ; en face de</text></gloss>
      <gloss lang="en"><text>go to meet; facing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>embrace</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.18.2; Childs 2000, p. 73: dèmùlló</text></form></note>
  </entry>
  <entry id="démúlúŋkéŋndó_751">
    <lexical-unit><form lang="kqs"><text>démúlúŋkéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="démúlúŋkéŋndó_751_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit serpent vert inoffensif</text></gloss>
      <gloss lang="en"><text>small harmless green snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 73: démúlúŋkéŋndó</text></form></note>
  </entry>
  <entry id="dèndèŋkùéíyó_752">
    <lexical-unit><form lang="kqs"><text>dèndèŋkùéíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dèndèŋkùéíyó_752_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit crapaud rougeâtre à peau lisse (appât pour le silure)</text></gloss>
      <gloss lang="en"><text>small reddish smooth-skinned toad (catfish bait)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 73: dèndèŋkùéíyó</text></form></note>
  </entry>
  <entry id="dendu_753">
    <lexical-unit><form lang="kqs"><text>dendu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dendu_753_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pur, net ; éclatant</text></gloss>
      <gloss lang="en"><text>pure, clean; bright</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first GEN.7.8</text></form></note>
    <note><form lang="fr"><text>Lv 11,47 oppose ɲɛ dendu et ɲɛ dindu ; la répartition des sens « pur / impur » reste à vérifier.</text></form></note>
  </entry>
  <entry id="dengadengiaa_754">
    <lexical-unit><form lang="kqs"><text>dengadengiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dengadengiaa_754_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>superposer</text></gloss>
      <gloss lang="en"><text>stack, pile up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Denga dengiaa</text></form></note>
    <note><form lang="fr"><text>Keita écrit en deux mots.</text></form></note>
  </entry>
  <entry id="dengelaa_755">
    <lexical-unit><form lang="kqs"><text>dengelaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dengela</text></form></variant>
    <variant><form lang="kqs"><text>dengelan</text></form></variant>
    <variant><form lang="kqs"><text>dengelanndo</text></form></variant>
    <variant><form lang="kqs"><text>dengeliaa</text></form></variant>
    <sense id="dengelaa_755_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entasser, amonceler ; (dengelanndo) s'amonceler, s'attrouper</text></gloss>
      <gloss lang="en"><text>heap up, pile up; (dengelanndo) pile up, crowd together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stack, pile up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.25.22; Lexique kissi–français, p. 13: dengelaa/ dengela; Childs 2000, p. 73: dèŋgèlàá</text></form></note>
    <note><form lang="fr"><text>dɛngultan … n co ndu dengelaa o lebol « tu amasses des charbons sur sa tête » (PRO.25.22) ; sɛ́lɛ́ bɛndoo dengelanndo « une foule qui accourait » (MRK.9.25).</text></form></note>
  </entry>
  <entry id="déŋ_756">
    <lexical-unit><form lang="kqs"><text>déŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="déŋ_756_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>au beau milieu, en plein (tɛɛn déŋ ; pala déŋ « en plein midi »)</text></gloss>
      <gloss lang="en"><text>right (in the middle), exactly (tɛɛn déŋ 'in the very middle'; pala déŋ 'at noon')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.2.9</text></form></note>
  </entry>
  <entry id="déŋgédéŋgóó_757">
    <lexical-unit><form lang="kqs"><text>déŋgédéŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="déŋgédéŋgóó_757_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'insecte (sur le riz)</text></gloss>
      <gloss lang="en"><text>kind of insect (found on rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 73: déŋgédéŋgóó</text></form></note>
  </entry>
  <entry id="dèŋgòó_758">
    <lexical-unit><form lang="kqs"><text>dèŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dèŋgòó_758_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brèche, ébréchure (d'une lame)</text></gloss>
      <gloss lang="en"><text>notch, chip (in a blade)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 74: dèŋgòó</text></form></note>
  </entry>
  <entry id="deŋio_759">
    <lexical-unit><form lang="kqs"><text>deŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deŋi</text></form></variant>
    <variant><form lang="kqs"><text>deŋinin</text></form></variant>
    <sense id="deŋio_759_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier, s'écrier ; gronder (tonnerre)</text></gloss>
      <gloss lang="en"><text>cry out, shout; thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>yell, shout, scream</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first EXO.9.29; Keita 1979, p. 110: Denhio; Childs 2000, p. 74: dèŋìó</text></form></note>
  </entry>
  <entry id="deŋullo_760">
    <lexical-unit><form lang="kqs"><text>deŋullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deŋul</text></form></variant>
    <sense id="deŋullo_760_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier à, apostropher ; menacer, réprimander</text></gloss>
      <gloss lang="en"><text>shout at, call out to; rebuke, threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>yell at someone, shout for or after someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MRK.1.27; Childs 2000, p. 74: dèŋùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de deŋio « crier ». Mó deŋul mɛmma ihɛlma makpɛ̀ndɛ̀an « il menaça la mer Rouge » (PSA.106.9).</text></form></note>
  </entry>
  <entry id="di di_761">
    <lexical-unit><form lang="kqs"><text>di di</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="di di_761_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>chaque matin</text></gloss>
      <gloss lang="en"><text>every morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: di di</text></form></note>
    <note><form lang="fr"><text>Orthographe à confirmer (cf. diilɛn « le matin »).</text></form></note>
  </entry>
  <entry id="dialii_762">
    <lexical-unit><form lang="kqs"><text>dialii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>diallon</text></form></field>
    <variant><form lang="kqs"><text>dialun</text></form></variant>
    <sense id="dialii_762_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre, partie du corps ; chair ; (pl.) le corps</text></gloss>
      <gloss lang="en"><text>limb, part of the body; flesh; (pl.) the body</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>body; also health, condition, skin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.2.23; Childs 2000, p. 76: ɗìàllé</text></form></note>
  </entry>
  <entry id="diam_763">
    <lexical-unit><form lang="kqs"><text>diam</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dem</text></form></variant>
    <sense id="diam_763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rejoindre ; suivre, poursuivre ; (diam fuɲaa … ciee-piɔ́m) rejoindre ses pères (mourir)</text></gloss>
      <gloss lang="en"><text>join; follow, pursue; (diam fuɲaa … ciee-piɔ́m) be gathered to one's fathers (die)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.5 Accompany"/>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.14.14</text></form></note>
    <note><form lang="fr"><text>dem : te i dem pɛ fuɲaa niaa « quand je reposerai avec mes pères » (Gn 47,30).</text></form></note>
  </entry>
  <entry id="diandaa_764">
    <lexical-unit><form lang="kqs"><text>diandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandan</text></form></variant>
    <variant><form lang="kqs"><text>diandɛi</text></form></variant>
    <variant><form lang="kqs"><text>diandaalan</text></form></variant>
    <sense id="diandaa_764_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>saint, consacré ; pur</text></gloss>
      <gloss lang="en"><text>holy, consecrated; pure</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 972 occurrences, first GEN.6.9; Childs 2000, p. 77: ɗìàndà-</text></form></note>
  </entry>
  <entry id="dii_765">
    <lexical-unit><form lang="kqs"><text>dii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diinin</text></form></variant>
    <sense id="dii_765_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 567 occurrences, first GEN.4.8; Childs 2000, p. 78: ɗìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diikɔnndo_766">
    <lexical-unit><form lang="kqs"><text>diikɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diikɔnndo_766_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir, être au service de (qqn)</text></gloss>
      <gloss lang="en"><text>serve, wait on (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>show loyalty, be obedient or submissive</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1KI.1.4; Childs 2000, p. 78: dìkɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : a ndu diikɔnndo « elle le servait » (1KI.1.4).</text></form></note>
  </entry>
  <entry id="diilɛn_767">
    <lexical-unit><form lang="kqs"><text>diilɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diilɛn_767_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le matin, ce matin, de bon matin</text></gloss>
      <gloss lang="en"><text>in the morning, this morning, early</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.2.7; Childs 2000, p. 78: dìílɛ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Diilɛn púŋ « de grand matin » (LUK.24.22) ; kabi diilɛn « depuis ce matin » (RUT.2.7).</text></form></note>
  </entry>
  <entry id="diimandɔɔ_768">
    <lexical-unit><form lang="kqs"><text>diimandɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diimandɔ</text></form></variant>
    <sense id="diimandɔɔ_768_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le lendemain</text></gloss>
      <gloss lang="en"><text>the next day</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the coming day, tomorrow morning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 119 occurrences, first GEN.19.34; Childs 2000, p. 78: dìímàndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diinndɔɔ_769">
    <lexical-unit><form lang="kqs"><text>diinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinndɔɔ_769_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>deuxième</text></gloss>
      <gloss lang="en"><text>second</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>two; second</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.4.19; Childs 2000, p. 79: dìíŋ</text></form></note>
  </entry>
  <entry id="diinɔnndo_770">
    <lexical-unit><form lang="kqs"><text>diinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinɔnndo_770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tuer</text></gloss>
      <gloss lang="en"><text>kill oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ZEC.11.4; Keita 1979, p. 110: Diinönndo; Lexique kissi–français, p. 13: diinɔnndo/ diinun; Childs 2000, p. 78: dììnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de diyɔɔ (ACT 16,27). Ne pas confondre avec diinun « se rassembler » (GEN 1,9).</text></form></note>
  </entry>
  <entry id="dikpisiie_771">
    <lexical-unit><form lang="kqs"><text>dikpisiie</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dikpisiie_771_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>épais, très sombre (nuage)</text></gloss>
      <gloss lang="en"><text>thick, very dark (cloud)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>looming, dark like a thundercloud</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2SA.22.10; Childs 2000, p. 79: díkpìsìì</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : kumii tiŋii dikpisiie « une nuée noire et épaisse » (2SA.22.10).</text></form></note>
  </entry>
  <entry id="dillo_772">
    <lexical-unit><form lang="kqs"><text>dillo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dillo_772_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger pour quelqu'un</text></gloss>
      <gloss lang="en"><text>eat for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Dillo; Lexique kissi–français, p. 13: dillo/ dil</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de dioo.</text></form></note>
  </entry>
  <entry id="dímàá_773">
    <lexical-unit><form lang="kqs"><text>dímàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dímàá_773_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lime (à aiguiser)</text></gloss>
      <gloss lang="en"><text>file (for sharpening)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 80: dímàá</text></form></note>
  </entry>
  <entry id="dimi_774">
    <lexical-unit><form lang="kqs"><text>dimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimin</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimi_774_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire</text></gloss>
      <gloss lang="en"><text>say</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2652 occurrences, first GEN.1.3; Childs 2000, p. 80: ɗìmìó</text></form></note>
    <note><form lang="fr"><text>Forme longue dimio (« kon co dimio ni aa » « ce qui veut dire »).</text></form></note>
  </entry>
  <entry id="dimio_775">
    <lexical-unit><form lang="kqs"><text>dimio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimi</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimio_775_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire</text></gloss>
      <gloss lang="en"><text>say</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>say, tell, speak</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 890 occurrences, first GEN.3.20; Keita 1979, p. 110: Dimio; Lexique kissi–français, p. 13: dimio/ dimi; Childs 2000, p. 80: dìmìó</text></form></note>
    <note><form lang="fr"><text>Bénéfactif dimul « dire à ».</text></form></note>
  </entry>
  <entry id="dimulan_776">
    <lexical-unit><form lang="kqs"><text>dimulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dimulan_776_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se dire, se parler (l'un à l'autre)</text></gloss>
      <gloss lang="en"><text>say to one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.11.3</text></form></note>
    <note><form lang="fr"><text>Réciproque de dimullo « dire à ».</text></form></note>
  </entry>
  <entry id="dimullo_777">
    <lexical-unit><form lang="kqs"><text>dimullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimul</text></form></variant>
    <variant><form lang="kqs"><text>dimulnin</text></form></variant>
    <sense id="dimullo_777_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire à, parler à</text></gloss>
      <gloss lang="en"><text>say to, tell</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 338 occurrences, first GEN.17.3; Lexique kissi–français, p. 13: dimullo/ dimul; Childs 2000, p. 81: ɗìmùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de dimi « dire ».</text></form></note>
  </entry>
  <entry id="dinaa_778">
    <lexical-unit><form lang="kqs"><text>dinaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="dinaa_778_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>religion</text></gloss>
      <gloss lang="en"><text>religion</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ACT.17.22; Keita 1979, p. 150: Dinaa; Lexique kissi–français, p. 13: dinaa</text></form></note>
    <note><form lang="fr"><text>Keita : « la religion musulmane ». Lexique kissi–français, p. 13 : « la religion musulmane ».</text></form></note>
  </entry>
  <entry id="dindiannde_779">
    <lexical-unit><form lang="kqs"><text>dindiannde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindianndan</text></form></variant>
    <sense id="dindiannde_779_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>de purification (faleŋii dindiannde « sacrifice pour le péché »)</text></gloss>
      <gloss lang="en"><text>of purification (faleŋii dindiannde 'sin offering')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be cleaned (causative middle of dìòndɔ̀ɔ́ 'be clean')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first EXO.29.27; Childs 2000, p. 81: dìndíŋndó</text></form></note>
    <note><form lang="fr"><text>Forme d'accord de classe i ; classe an : mɛmma dindianndan « eau de purification » (Nb 8,7). Dérivé causatif de diondɔɔ.</text></form></note>
  </entry>
  <entry id="dindin_780">
    <lexical-unit><form lang="kqs"><text>dindin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindinndo</text></form></variant>
    <variant><form lang="kqs"><text>dindinin</text></form></variant>
    <sense id="dindin_780_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se purifier, se sanctifier ; rendre propre</text></gloss>
      <gloss lang="en"><text>purify oneself, consecrate oneself; make clean</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.35.2; Lexique kissi–français, p. 13: dindinndo/ dindin</text></form></note>
    <note><form lang="fr"><text>Moyen de dindio « purifier ».</text></form></note>
  </entry>
  <entry id="dindio_781">
    <lexical-unit><form lang="kqs"><text>dindio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dindi</text></form></variant>
    <variant><form lang="kqs"><text>dindinin</text></form></variant>
    <sense id="dindio_781_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre propre, purifier ; purifier, sanctifier</text></gloss>
      <gloss lang="en"><text>make clean, purify ; purify, sanctify</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>make clean (causative of 'be clean')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.29.36; Keita 1979, p. 110: Dindindio; Childs 2000, p. 81: dìndìó</text></form></note>
    <note><form lang="fr"><text>Keita écrit dindindio (radical dindin) ; la Bible a dindio, dindi « purifier », et le moyen dindin, dindinndo « se purifier, se laver ».</text></form></note>
  </entry>
  <entry id="dindu_782">
    <lexical-unit><form lang="kqs"><text>dindu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dindu_782_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pur (rituellement) ; clair</text></gloss>
      <gloss lang="en"><text>clean (ritually); clear</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.7.2; Childs 2000, p. 81: ɗìòndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="dio_783">
    <lexical-unit><form lang="kqs"><text>dio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dio_783_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte</text></gloss>
      <gloss lang="en"><text>door</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dio</text></form></note>
    <note><form lang="fr"><text>Homographe de dio (forme de dioo « manger ») ; la Bible dit koŋndo « porte ».</text></form></note>
  </entry>
  <entry id="dio_784">
    <lexical-unit><form lang="kqs"><text>dio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dio_784_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fait d'avoir raison, bon droit</text></gloss>
      <gloss lang="en"><text>being in the right</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dio; Childs 2000, p. 82: díó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 13 (« la raison ») ; homographe de dio (forme de dioo « manger »). Pluriel en kissi du Sud (Childs 2000) : díláŋ.</text></form></note>
  </entry>
  <entry id="diolan_785">
    <lexical-unit><form lang="kqs"><text>diolan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diola</text></form></variant>
    <sense id="diolan_785_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nom ; renom</text></gloss>
      <gloss lang="en"><text>name; renown</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 601 occurrences, first GEN.1.5; Childs 2000, p. 82: ɗìòláŋ</text></form></note>
  </entry>
  <entry id="diomndo_786">
    <lexical-unit><form lang="kqs"><text>diomndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>diomndan</text></form></field>
    <variant><form lang="kqs"><text>diom</text></form></variant>
    <variant><form lang="kqs"><text>diomnda</text></form></variant>
    <sense id="diomndo_786_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voix, son ; parole ; langue</text></gloss>
      <gloss lang="en"><text>voice, sound; word; language</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>voice, word; also advice, answer, promise; abuse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 121 occurrences, first GEN.27.22; Childs 2000, p. 82: ɗìòmndó</text></form></note>
  </entry>
  <entry id="diondɔɔ_787">
    <lexical-unit><form lang="kqs"><text>diondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandu</text></form></variant>
    <variant><form lang="kqs"><text>diandunin</text></form></variant>
    <variant><form lang="kqs"><text>diondu</text></form></variant>
    <sense id="diondɔɔ_787_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être pur, devenir propre ; briller, être blanc ; (nom) éclat, blancheur, gloire</text></gloss>
      <gloss lang="en"><text>be clean, become pure; shine, be white; (noun) brightness, whiteness, glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be clean, shine, be white; fade (Childs lists dendu, diandu, dindu as forms)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.1.16; Childs 2000, p. 83: dìòndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Nom verbal : sina diondɔɔ ndɔɔ « connaître sa gloire » (Lv 10,3) ; hiow diondɔɔ « plus blanc » (Gn 49,12). diandu « se purifier » (Esd 6,20). Cf. diandaa « saint, pur ».</text></form></note>
  </entry>
  <entry id="dioo_788">
    <lexical-unit><form lang="kqs"><text>dioo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dio</text></form></variant>
    <variant><form lang="kqs"><text>de</text></form></variant>
    <variant><form lang="kqs"><text>dia</text></form></variant>
    <variant><form lang="kqs"><text>di</text></form></variant>
    <variant><form lang="kqs"><text>dianin</text></form></variant>
    <variant><form lang="kqs"><text>dinin</text></form></variant>
    <sense id="dioo_788_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger</text></gloss>
      <gloss lang="en"><text>eat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>eat, consume, use up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 452 occurrences, first GEN.2.9; Keita 1979, p. 116: Dioo; Lexique kissi–français, p. 13: dioo/ dio, de, dia, di; Childs 2000, p. 82: dìó</text></form></note>
    <note><form lang="fr"><text>di, dinin : radical négatif. Lexique kissi–français, p. 13 : radicaux dio, de, dia, di, da.</text></form></note>
  </entry>
  <entry id="diuvaa_789">
    <lexical-unit><form lang="kqs"><text>diuvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diuvaa_789_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer, massacrer (vanaa diuvaa n'vannda « les meurtriers »)</text></gloss>
      <gloss lang="en"><text>kill, slaughter (vanaa diuvaa n'vannda 'murderers')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first PSA.5.7</text></form></note>
    <note><form lang="fr"><text>Sans doute dérivé (pluriel) de dii « tuer ».</text></form></note>
  </entry>
  <entry id="diuvan_790">
    <lexical-unit><form lang="kqs"><text>diuvan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diuvanndo</text></form></variant>
    <sense id="diuvan_790_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entretuer</text></gloss>
      <gloss lang="en"><text>kill one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JDG.7.22</text></form></note>
    <note><form lang="fr"><text>Réciproque de diuvaa.</text></form></note>
  </entry>
  <entry id="diuvɛi_791">
    <lexical-unit><form lang="kqs"><text>diuvɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diuvɛi_791_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mûr (fruit)</text></gloss>
      <gloss lang="en"><text>ripe (fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be red (yellow), be ripe; also temper iron, be drunk</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first AMO.8.1; Lexique kissi–français, p. 13: divɔɔ/ diw; Childs 2000, p. 85: dìùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>yɔmii koamɛi diuvɛi « des fruits mûrs » (AMO.8.1-2). Le Lexique kissi–français, p. 13, donne le verbe divɔɔ/ diw « mûr ; mûrir ».</text></form></note>
  </entry>
  <entry id="diwvo_792">
    <lexical-unit><form lang="kqs"><text>diwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diw</text></form></variant>
    <variant><form lang="kqs"><text>diwnin</text></form></variant>
    <sense id="diwvo_792_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer (en nombre), massacrer</text></gloss>
      <gloss lang="en"><text>kill (many), slaughter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first EXO.5.21</text></form></note>
    <note><form lang="fr"><text>diw s'emploie surtout pour plusieurs victimes ; voir dii « tuer ».</text></form></note>
  </entry>
  <entry id="diyɔɔ_793">
    <lexical-unit><form lang="kqs"><text>diyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dii</text></form></variant>
    <sense id="diyɔɔ_793_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.25.32; Keita 1979, p. 110: Diyöö; Lexique kissi–français, p. 13: diyɔɔ/ dii; Childs 2000, p. 85: dìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diyɔɔ koya_794">
    <lexical-unit><form lang="kqs"><text>diyɔɔ koya</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="diyɔɔ koya_794_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Diyöö koya; Lexique kissi–français, p. 13: diyɔɔ koya</text></form></note>
    <note><form lang="fr"><text>diyɔɔ « fait de tuer » est attesté ; koya n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="diyɔɔkoyaa_795">
    <lexical-unit><form lang="kqs"><text>diyɔɔkoyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diyɔɔkoyaa_795_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Diyöökoyaa; Lexique kissi–français, p. 13: diyɔɔkoyaa</text></form></note>
    <note><form lang="fr"><text>Contient diyɔɔ « tuer », attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="díŋndó_796">
    <lexical-unit><form lang="kqs"><text>díŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="díŋndó_796_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pierre d'appui du fuseau (filage) ; pierre que le masque fait siffler</text></gloss>
      <gloss lang="en"><text>stone on which a spindle rests; stone blown by the masked spirit</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 81: díŋndó</text></form></note>
  </entry>
  <entry id="diɔmnde_797">
    <lexical-unit><form lang="kqs"><text>diɔmnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diɔmnde_797_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise, stupidité</text></gloss>
      <gloss lang="en"><text>folly, foolishness, stupidity</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first JOB.15.2; Childs 2000, p. 83: dìɔ̀mndé</text></form></note>
    <note><form lang="fr"><text>Voir diɔmndo « sot ». La mal diɔmnde « abandonnez la sottise » (PRO.9.6).</text></form></note>
  </entry>
  <entry id="diɔmndo_798">
    <lexical-unit><form lang="kqs"><text>diɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diɔm</text></form></variant>
    <variant><form lang="kqs"><text>diɔmaa</text></form></variant>
    <sense id="diɔmndo_798_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise ; (pl.) les sots</text></gloss>
      <gloss lang="en"><text>folly; (pl.) fools</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fool, foolish person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first 1SA.21.14; Childs 2000, p. 83: ɗìɔ̀mndó</text></form></note>
  </entry>
