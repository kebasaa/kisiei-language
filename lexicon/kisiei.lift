    <trait name="status" value="respelled"/>
    <sense id="paw pulen_2993_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ulcère</text></gloss>
      <gloss lang="en"><text>ulcer</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: Paw Pulen; Lexique kissi–français, p. 41: paw pulen</text></form></note>
  </entry>
  <entry id="pawvo_2994">
    <lexical-unit><form lang="kqs"><text>pawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>paw</text></form></variant>
    <variant><form lang="kqs"><text>pawve</text></form></variant>
    <sense id="pawvo_2994_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plaie</text></gloss>
      <gloss lang="en"><text>sore, wound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sore, abrasion, cut, wound</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first LEV.13.3; Keita 1979, p. 162: Pawvo; Lexique kissi–français, p. 41: pawvo; Childs 2000, p. 290: pàùwó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 41 : aussi pauvo et pawve « la plaie ».</text></form></note>
  </entry>
  <entry id="pawvo_2995">
    <lexical-unit><form lang="kqs"><text>pawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="pawvo_2995_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manche (de houe, de hache)</text></gloss>
      <gloss lang="en"><text>handle (of a hoe, an axe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.2.8 Agricultural tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: pawvo</text></form></note>
    <note><form lang="fr"><text>Homographe de pawvo « plaie ».</text></form></note>
