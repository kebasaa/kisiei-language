    <lexical-unit><form lang="kqs"><text>iyongban-yongbannde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="iyongban-yongbannde_1361_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>(eaux) agitées, houleuses</text></gloss>
      <gloss lang="en"><text>(waters) surging, raging</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.42.8</text></form></note>
