    <sense id="malaa_2204_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aider</text></gloss>
      <gloss lang="en"><text>help</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 255 occurrences, first GEN.2.18; Keita 1979, p. 110: Malaa; Childs 2000, p. 240: màlàá</text></form></note>
  </entry>
  <entry id="málàá_2205">
    <lexical-unit><form lang="kqs"><text>málàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>málàá</text></form></field>
    <variant><form lang="kqs"><text>mâllá</text></form></variant>
    <sense id="málàá_2205_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>appât de pêche (petits vers)</text></gloss>
      <gloss lang="en"><text>fish bait (small worms)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 240: málàá</text></form></note>
  </entry>
  <entry id="malalɛi_2206">
    <lexical-unit><form lang="kqs"><text>malalɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="check"/>
    <sense id="malalɛi_2206_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pancréas (Keita)</text></gloss>
      <gloss lang="en"><text>pancreas (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Malalèi</text></form></note>
    <note><form lang="fr"><text>Organe exact à confirmer par un locuteur.</text></form></note>
  </entry>
  <entry id="malan_2207">
    <lexical-unit><form lang="kqs"><text>malan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="malan_2207_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>avant que ; et ensuite seulement, puis</text></gloss>
      <gloss lang="en"><text>before; and only then, then</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>before, earlier; soon</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.3.16; Childs 2000, p. 240: màlǎŋ</text></form></note>
    <note><form lang="fr"><text>vɔsilan … malan o vu « (il vécut) … ans, puis il mourut » (GEN.5.5) ; o bɛnda fɔlɔn mò pulun malan o vownun ndan « il se lavera d'abord, puis les revêtira » (LEV.16.4).</text></form></note>
  </entry>
  <entry id="máláŋndó_2208">
    <lexical-unit><form lang="kqs"><text>máláŋndó</text></form></lexical-unit>
