  <entry id="siŋndo_4626">
    <lexical-unit><form lang="kqs"><text>siŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>siŋnda</text></form></field>
    <sense id="siŋndo_4626_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pou</text></gloss>
      <gloss lang="en"><text>louse</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: sindo, pl. sinda; Lexique kissi–français, p. 50: sinndo; Childs 2000, p. 335: sìŋndó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 50 : sinndo, pl. sinnda ; graphie avec ŋ d'après Childs et saŋndo « lièvre », que le Lexique écrit aussi sanndo. Paulme 1964, p. 93 : sindo, pl. sinda « pou de tête » ; ɔ nɔ sinda « il a des poux ».</text></form></note>
  </entry>
  <entry id="siŋnɔnndo_4627">
    <lexical-unit><form lang="kqs"><text>siŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siŋnun</text></form></variant>
    <variant><form lang="kqs"><text>siŋnunnin</text></form></variant>
    <variant><form lang="kqs"><text>siŋnɔn</text></form></variant>
    <sense id="siŋnɔnndo_4627_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir</text></gloss>
      <gloss lang="en"><text>become</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first GEN.24.14</text></form></note>
  </entry>
  <entry id="siɔdii_4628">
    <lexical-unit><form lang="kqs"><text>siɔdii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="siɔdii_4628_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>demain</text></gloss>
      <gloss lang="en"><text>tomorrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 149 occurrences, first GEN.19.2; Paulme 1964, p. 94: sɔ, sɔdi, siɔdi; Lexique kissi–français, p. 50: siɔdii; Childs 2000, p. 336: sìɔ̀dí</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 94 : sɔ, sɔdi, siɔdi « demain » ; p. 96 : sodi.</text></form></note>
  </entry>
  <entry id="siɔlɔɔ_4629">
    <lexical-unit><form lang="kqs"><text>siɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɔl</text></form></variant>
    <sense id="siɔlɔɔ_4629_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>construire, façonner ; tailler</text></gloss>
      <gloss lang="en"><text>build, make; hew, shape</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.6.15</text></form></note>
  </entry>
  <entry id="sìɔ̀lɔ̀ɔ́_4630">
    <lexical-unit><form lang="kqs"><text>sìɔ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀lɔ̀ɔ́_4630_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (forêt haute)</text></gloss>
      <gloss lang="en"><text>a tree species (high forest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 336: sìɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="sìɔ̀lɔ̀ɔ́_4631">
    <lexical-unit><form lang="kqs"><text>sìɔ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀lɔ̀ɔ́_4631_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>longue nasse en lianes</text></gloss>
      <gloss lang="en"><text>long fish trap made of vines</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 336: sìɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="siɔlɔɔ piɔmndo_4632">
    <lexical-unit><form lang="kqs"><text>siɔlɔɔ piɔmndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>ɲɛ sialaa</text></form></variant>
    <sense id="siɔlɔɔ piɔmndo_4632_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sculpture</text></gloss>
      <gloss lang="en"><text>sculpture</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 565: Siölöö piömndo, nyè sialaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi ɲɛ sialaa.</text></form></note>
  </entry>
  <entry id="siɔn_4633">
    <lexical-unit><form lang="kqs"><text>siɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɔn_4633_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>toton en noix palmiste (jeu d'adultes)</text></gloss>
      <gloss lang="en"><text>spinning top made from a palm kernel (adults' game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 93: siɔ̃</text></form></note>
    <note><form lang="fr"><text>Paulme : noix palmiste = kɛnkɔ̃. Dans la Bible, Siɔn est le nom de Sion.</text></form></note>
  </entry>
  <entry id="siɔu_4634">
    <lexical-unit><form lang="kqs"><text>siɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛ</text></form></variant>
    <sense id="siɔu_4634_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>poindre (le jour), se lever (soleil) ; aurore</text></gloss>
      <gloss lang="en"><text>dawn, break (of day), rise (sun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dawn; also (of the sun) come out, shine; (of rain) come down</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first JDG.19.26; Lexique kissi–français, p. 45: sa; Childs 2000, p. 336: sìɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>paalen siɔu « le jour parut » (Jg 21,4) ; paalen le sɛ « le jour se lève » (Gn 32,27). sɛ est un autre radical du même verbe : Childs donne sɛ̀l- comme bénéfactif de sìɔ̀ɔ́ « poindre » (p. 324). Lexique kissi–français, p. 45 : sa (rad) « se lever (le soleil) ». Aussi Lexique kissi–français, p. 51 : « sɔ ». Lexique kissi–français, p. 51 : sɔ « se lever (le soleil), l'aurore ».</text></form></note>
  </entry>
  <entry id="sìɔ̀ùléŋ_4635">
    <lexical-unit><form lang="kqs"><text>sìɔ̀ùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀ùléŋ_4635_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (commun autour des villages)</text></gloss>
      <gloss lang="en"><text>a tree species (common around towns)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìɔ̀ùléŋ</text></form></note>
  </entry>
  <entry id="sìɔ̀ùwé_4636">
    <lexical-unit><form lang="kqs"><text>sìɔ̀ùwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀ùwé_4636_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à fleurs parfumées</text></gloss>
      <gloss lang="en"><text>tree with fragrant flowers</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìɔ̀ùwé</text></form></note>
  </entry>
  <entry id="siɔw_4637">
    <lexical-unit><form lang="kqs"><text>siɔw</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɔw_4637_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pourrir</text></gloss>
      <gloss lang="en"><text>rot</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 116: Siöw; Paulme 1964, p. 90: sɛ; Lexique kissi–français, p. 45: [s]a</text></form></note>
    <note><form lang="fr"><text>La Bible a siɔu, siɔ « (le jour) se lever » (JDG 19,26), sens différent. Lexique kissi–français, p. 45 : [s]a (rad) « pourrir » (lecture incertaine). Aussi Lexique kissi–français, p. 50 : « siɔu/ siɔ, sɛ, sia, si ». Lexique kissi–français, p. 50 : siɔu/ siɔ, sɛ, sia, si « pourrir ». Homographe de siɔu « poindre (le jour) ». Paulme 1964, p. 90 : sɛ « pourri » ; dɛmbe nɔndo sɛ « ton ventre est pourri » ; nyɛy sayɛye « chose pourrie ». Aussi Paulme 1964, p. 99 : « suve, suwo, sɔwu ». Paulme 1964, p. 99 : nyɛy'suve « chose pourrie », yɔm'suwo « arbre pourri ».</text></form></note>
  </entry>
  <entry id="siɔŋio_4638">
    <lexical-unit><form lang="kqs"><text>siɔŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɔŋ</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋi</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋnin</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋinin</text></form></variant>
    <variant><form lang="kqs"><text>siɔŋnun</text></form></variant>
    <sense id="siɔŋio_4638_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'user, s'abîmer ; user, ronger</text></gloss>
      <gloss lang="en"><text>wear out, waste away; wear down, consume</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>age, get old</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.16.9; Childs 2000, p. 336: sìɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>volɔɔla niaa la siɔŋ te « vos vêtements ne se sont pas usés » (Dt 8,4) ; siɔŋi « user, ronger » (Ps 39,12).</text></form></note>
  </entry>
  <entry id="siɔ́ŋndo_4639">
    <lexical-unit><form lang="kqs"><text>siɔ́ŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sɛŋ</text></form></variant>
    <sense id="siɔ́ŋndo_4639_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépecer, découper (une bête abattue) ; écorcher</text></gloss>
      <gloss lang="en"><text>butcher, cut up (a slaughtered animal); flay</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>butcher, slaughter</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2CH.35.11; Childs 2000, p. 336: sìɔ́ŋndó</text></form></note>
    <note><form lang="fr"><text>leviia nda va cɔlua sálàá siɔ́ŋndo « les lévites dépeçaient les bêtes » (2CH.35.11) ; a sɛŋ saa kóndó kon, a diw ndu kundalan « tu découperas le bélier en morceaux » (EXO.29.17) ; mà sɛŋ ndu (1KI.18.23).</text></form></note>
  </entry>
  <entry id="siɔ̀ɔ́_4640">
    <lexical-unit><form lang="kqs"><text>siɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>siɔ̀ɔ́lan</text></form></field>
    <variant><form lang="kqs"><text>siɔ̀ɔ́la</text></form></variant>
    <sense id="siɔ̀ɔ́_4640_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier</text></gloss>
      <gloss lang="en"><text>palm tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first LEV.11.14</text></form></note>
    <note><form lang="fr"><text>siɔ̀ɔ́la vawlan « palmes, branches de palmier » (Lv 23,40).</text></form></note>
  </entry>
  <entry id="siɔɔ_4641">
    <lexical-unit><form lang="kqs"><text>siɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siɔɔ_4641_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>désherber autour des plantes (sans tout couper) ; nettoyer le chemin</text></gloss>
      <gloss lang="en"><text>weed, clear the brush around plants; clear a path</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: siɔɔ; Childs 2000, p. 336: sìɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 50 : siɔɔ « nettoyer le chemin ».</text></form></note>
  </entry>
  <entry id="sìɔ́ɔ́_4642">
    <lexical-unit><form lang="kqs"><text>sìɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ́ɔ́_4642_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>calebasse à graines, hochet (sasa, joué par les femmes)</text></gloss>
      <gloss lang="en"><text>gourd rattle with seeds (sasa, played by women)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 336: sìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="síɔ́ɔ́_4643">
    <lexical-unit><form lang="kqs"><text>síɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
