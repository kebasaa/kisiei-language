  <entry id="masindɛ_2231">
    <lexical-unit><form lang="kqs"><text>masindɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masindɛa</text></form></variant>
    <variant><form lang="kqs"><text>masindɛlan</text></form></variant>
    <variant><form lang="kqs"><text>masindɛla</text></form></variant>
    <variant><form lang="kqs"><text>masindɛi</text></form></variant>
    <variant><form lang="kqs"><text>masindɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>masindɔn</text></form></variant>
    <variant><form lang="kqs"><text>masindɛ-sindɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>masindɛ-sindɔn</text></form></variant>
    <sense id="masindɛ_2231_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>ancien, d'autrefois ; (kabi masindɛ) depuis toujours ; (Bɛndu Yuu Masindɛ-Sindɔɔ) l'Ancien des jours</text></gloss>
      <gloss lang="en"><text>ancient, of old; (kabi masindɛ) from of old; (Bɛndu Yuu Masindɛ-Sindɔɔ) the Ancient of Days</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adj.) of an earlier time; sìndɔ̀ɔ́ 'old days'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first 1KI.14.30; Childs 2000, p. 335: sìndè</text></form></note>
    <note><form lang="fr"><text>De sindɛ « autrefois ». Kabi masindɛ (1KI.14.30, PSA.74.12) ; dɛnnda viannannda masindɛlan « les mystères des temps anciens » (PSA.78.2) ; pembun masindɔn « les collines antiques » (GEN.49.26) ; tale masindɔɔ « un proverbe ancien » (1SA.24.14) ; Masindɛ-Sindɔɔ (DAN.7.9).</text></form></note>
  </entry>
