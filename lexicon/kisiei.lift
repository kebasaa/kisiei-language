    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>faŋa</text></form></variant>
    <variant><form lang="kqs"><text>faŋanin</text></form></variant>
    <variant><form lang="kqs"><text>faŋal</text></form></variant>
    <sense id="faŋaa_422_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever, retirer, séparer</text></gloss>
      <gloss lang="en"><text>remove, take away, separate</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>move or remove, take</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.41.34; Keita 1979, p. 110: Fanhaa; Childs 2000, p. 97: fàŋàá</text></form></note>
    <note><form lang="fr"><text>Moyen faŋan « s'éloigner, partir ».</text></form></note>
  </entry>
  <entry id="faŋanndo_423">
    <lexical-unit><form lang="kqs"><text>faŋanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>faŋan</text></form></variant>
    <variant><form lang="kqs"><text>faŋannin</text></form></variant>
    <variant><form lang="kqs"><text>faŋanin</text></form></variant>
    <variant><form lang="kqs"><text>feŋan</text></form></variant>
    <variant><form lang="kqs"><text>feŋannin</text></form></variant>
    <sense id="faŋanndo_423_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>quitter, s'en aller de</text></gloss>
      <gloss lang="en"><text>leave, depart from</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first GEN.12; Childs 2000, p. 98: fàŋăŋndó</text></form></note>
