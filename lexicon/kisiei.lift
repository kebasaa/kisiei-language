    <trait name="status" value="southern"/>
    <sense id="fûŋ_929_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(puer) fortement</text></gloss>
      <gloss lang="en"><text>(stink) strongly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fûŋ</text></form></note>
  </entry>
  <entry id="fùŋgbàá_930">
    <lexical-unit><form lang="kqs"><text>fùŋgbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
