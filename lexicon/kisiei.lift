      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>argile blanche ou grise ; craie ; poudre ; poudre à fusil</text></gloss>
      <gloss lang="en"><text>white or grey clay; chalk; powder; gunpowder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀úwó</text></form></note>
  </entry>
  <entry id="pɔ́úwó_2754">
    <lexical-unit><form lang="kqs"><text>pɔ́úwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ́úwó_2754_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste des marais aux feuilles servant d'emballage (kola)</text></gloss>
      <gloss lang="en"><text>swamp shrub whose leaves are used to wrap parcels (kola)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ́úwó</text></form></note>
    <note><form lang="fr"><text>Piper umbellatum.</text></form></note>
  </entry>
  <entry id="pɔw_2755">
    <lexical-unit><form lang="kqs"><text>pɔw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔw_2755_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'égarer, se tromper ; être en faute</text></gloss>
      <gloss lang="en"><text>go astray, err; be at fault</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="7.6.3 Lose, misplace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.14.3</text></form></note>
    <note><form lang="fr"><text>Israɛlla pɔw nɛiyo « les Israélites errent (ont perdu leur chemin) » (Ex 14,3) ; Ya pɔw ni « c'est moi la fautive » (1 S 25,24). Voir pɔwlan « faute ».</text></form></note>
  </entry>
  <entry id="pɔwlan_2756">
    <lexical-unit><form lang="kqs"><text>pɔwlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔwla</text></form></variant>
    <sense id="pɔwlan_2756_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égarement, faute, péché</text></gloss>
      <gloss lang="en"><text>error, wrongdoing, sin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first DEU.11.16</text></form></note>
    <note><form lang="fr"><text>luɛi o pɔwlan nin « s'égarer, tomber dans l'erreur » (Dt 11,16) ; pɔwla Yeroboam « les péchés de Jéroboam » (2 R 10,31). Voir pɔw « s'égarer ».</text></form></note>
  </entry>
  <entry id="pɔ̀yàŋndó_2757">
    <lexical-unit><form lang="kqs"><text>pɔ̀yàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɔ̀yàŋndó_2757_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre à racine amère (dont on tire le rotin)</text></gloss>
      <gloss lang="en"><text>large tree with a bitter root (source of rattan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀yàŋndó</text></form></note>
  </entry>
  <entry id="pɔ́ŋgɔ́sɔ̀ɔ́_2758">
    <lexical-unit><form lang="kqs"><text>pɔ́ŋgɔ́sɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɔ́ŋgɔ́sɔ̀ɔ́_2758_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>tout petit</text></gloss>
      <gloss lang="en"><text>very small</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ́ŋgɔ́sɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɔɔ_2759">
    <lexical-unit><form lang="kqs"><text>pɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔɔ_2759_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>d'abord, un moment, en attendant</text></gloss>
      <gloss lang="en"><text>first, for a while, meanwhile</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.27.44</text></form></note>
    <note><form lang="fr"><text>Kɔ mà kɔ va pɔɔ lon « va et reste là-bas quelque temps » (Gn 27,44) ; hiow ya pɔɔ laci « passe devant moi » (Gn 33,14) ; yɔngu ya pɔɔ landei pum « donne-moi d'abord un gage » (Gn 38,17).</text></form></note>
  </entry>
  <entry id="pɔ̀ɔ́_2760">
    <lexical-unit><form lang="kqs"><text>pɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɔ̀láŋ</text></form></field>
    <sense id="pɔ̀ɔ́_2760_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chou palmiste (mangé en période de disette)</text></gloss>
      <gloss lang="en"><text>palm cabbage (eaten when rice is scarce)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 310: pɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="pɔɔli_2761">
    <lexical-unit><form lang="kqs"><text>pɔɔli</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɔɔli_2761_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de loin, à distance, là-bas</text></gloss>
      <gloss lang="en"><text>from afar, at a distance, over there</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JDG.4.11</text></form></note>
    <note><form lang="fr"><text>a lo levil pɔɔli « de loin tu perçois » (Ps 139,2) ; N lo coocoo pɔɔli « du haut du ciel » (Jg 5,20).</text></form></note>
  </entry>
  <entry id="pɔɔliaa_2762">
    <lexical-unit><form lang="kqs"><text>pɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔɔliaanin</text></form></variant>
    <variant><form lang="kqs"><text>pɔɔla</text></form></variant>
    <variant><form lang="kqs"><text>pɔɔlaa</text></form></variant>
    <sense id="pɔɔliaa_2762_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arroser, irriguer ; (pɔɔla) mouiller, tremper</text></gloss>
      <gloss lang="en"><text>water, irrigate; (pɔɔla) wet, soak</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>soak, immerse in water, drench, water a plant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.2.6; Childs 2000, p. 310: pɔ̀ɔ̀làá</text></form></note>
    <note><form lang="fr"><text>mɛmma va … lɛŋnden pɔɔliaa « l'eau arrosait toute la surface du sol » (Gn 2,6) ; o pɔɔla ɲɛm mun … o kooma « il les trempera dans le sang » (Lv 14,6).</text></form></note>
  </entry>
  <entry id="pɔɛɛnndo_2763">
    <lexical-unit><form lang="kqs"><text>pɔɛɛnndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>pɔɛɛn</text></form></variant>
    <sense id="pɔɛɛnndo_2763_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>oublier</text></gloss>
      <gloss lang="en"><text>forget</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.6 Remember"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forget</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Pöènndo; Childs 2000, p. 310: pùɛ̀ɛ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit pöènndo ; la Bible a le radical pɔɛɛn « oublier » (JER 30,14). La forme longue pɔɛɛnndo n'y est pas attestée.</text></form></note>
  </entry>
  <entry id="pɔɛɛnɔnndo_2764">
    <lexical-unit><form lang="kqs"><text>pɔɛɛnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔɛɛnun</text></form></variant>
    <variant><form lang="kqs"><text>pɔɛɛnunnin</text></form></variant>
    <sense id="pɔɛɛnɔnndo_2764_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>oublier ; oubli ; s'oublier (Keita)</text></gloss>
      <gloss lang="en"><text>forget; oversight; forget oneself (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.6 Remember"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>forget; ignore, have nothing to do with</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first GEN.43.12; Keita 1979, p. 113: Pöènnönndo; Childs 2000, p. 310: pùèèŋndɔ́</text></form></note>
    <note><form lang="fr"><text>Moyen de pɔɛɛnndo. Keita écrit pöènnönndo ; la Bible écrit pɔɛɛnɔnndo (GEN 43,12) et pɔɛɛnun « oublier » (très courant).</text></form></note>
  </entry>
  <entry id="pɛ́_2765">
    <lexical-unit><form lang="kqs"><text>pɛ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ́_2765_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement, tout à fait (disparaître, s'effondrer)</text></gloss>
      <gloss lang="en"><text>completely, entirely (vanish, collapse)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>all, completely, at all</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3807 occurrences, first GEN.1.22; Childs 2000, p. 294: pɛ́</text></form></note>
    <note><form lang="fr"><text>Accentué ; à distinguer de pɛ « si ». cɛila … vanaa vɔɔnda la lo pɛ́ « les tentes des méchants disparaîtront » (JOB.8.22) ; o lonnun pɛ́ « (la richesse) disparaît » (PRO.23.5) ; Ninivea vi n'diallon pɛ́ « Ninive s'effondre » (NAM.2.11).</text></form></note>
  </entry>
  <entry id="pɛ_2766">
    <lexical-unit><form lang="kqs"><text>pɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛ_2766_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule de condition (te … pɛ)</text></gloss>
      <gloss lang="en"><text>conditional particle (te … pɛ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3807 occurrences, first GEN.1.22; Childs 2000, p. 350: tè … pɛ́</text></form></note>
  </entry>
  <entry id="pɛ̀-pɛ̀_2767">
    <lexical-unit><form lang="kqs"><text>pɛ̀-pɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀-pɛ̀_2767_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du gombo qu'on écrase</text></gloss>
      <gloss lang="en"><text>sound of okra being mashed</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pɛ̀-pɛ̀</text></form></note>
  </entry>
  <entry id="pɛi_2768">
    <lexical-unit><form lang="kqs"><text>pɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛi_2768_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avant-hier ; auparavant</text></gloss>
      <gloss lang="en"><text>the day before yesterday; formerly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.42.35; Keita 1979, p. 152: Pèi</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, « auparavant, autrefois » (2TI.3.14, ACT.21.38).</text></form></note>
  </entry>
  <entry id="pɛiyo_2769">
    <lexical-unit><form lang="kqs"><text>pɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛiyo_2769_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apprendre, étudier</text></gloss>
      <gloss lang="en"><text>learn, study</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.2 Learn"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>learn, study, remember, memorize</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZR.7.10; Childs 2000, p. 295: pɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>tɔŋ Mɛlɛka-o pɛiyo « étudier la loi du Seigneur » (EZR.7.10) ; condii kalɛi pɛiyo « apprendre le cantique » (REV.14.3).</text></form></note>
  </entry>
  <entry id="pɛ̀ìyó_2770">
    <lexical-unit><form lang="kqs"><text>pɛ̀ìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀ìyó_2770_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir (le riz), puiser ; vider ; tourner brusquement</text></gloss>
      <gloss lang="en"><text>dish out (rice), scoop; empty; turn sharply</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀ìyó</text></form></note>
  </entry>
  <entry id="pɛ̀làá_2771">
    <lexical-unit><form lang="kqs"><text>pɛ̀làá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀làá_2771_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>roter, grogner, haleter, renâcler</text></gloss>
      <gloss lang="en"><text>belch, grunt, pant, snort</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀làá</text></form></note>
  </entry>
  <entry id="pɛltan_2772">
    <lexical-unit><form lang="kqs"><text>pɛltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pɛltan_2772_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parts, portions (de terrain) (pl.)</text></gloss>
      <gloss lang="en"><text>portions, parts (of land) (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6 Parts of things"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>division, part, portion (of a field to be worked)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.60.8; Childs 2000, p. 296: pɛ̌lló</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. mì tuu bóllo Sukɔt a pɛltan « je mesurerai (la vallée de) Soukkoth en parts » (PSA.60.8, PSA.108.8).</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀í_2773">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lɔ̀ɔ́ŋ</text></form></field>
    <sense id="pɛ̀lɛ̀í_2773_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fond de la bouche, mâchoire inférieure</text></gloss>
      <gloss lang="en"><text>back of the mouth, lower jaw</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 295: pɛ̀lɛ̀í</text></form></note>
  </entry>
  <entry id="pɛlɛlen_2774">
    <lexical-unit><form lang="kqs"><text>pɛlɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="pɛlɛlen_2774_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse, proie</text></gloss>
      <gloss lang="en"><text>hunt, prey</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hunting with dogs; chasing after something</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.49.9; Childs 2000, p. 296: pɛ̀lɛ̀lɛ́ŋ</text></form></note>
    <note><form lang="fr"><text>a fula pɛlɛlen « tu es revenu de la chasse (de la proie) » (GEN.49.9), dit de Juda, jeune lion.</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀mbàá_2775">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀mbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀lɛ̀mbàláŋ</text></form></field>
    <sense id="pɛ̀lɛ̀mbàá_2775_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe, slip (porté sous le pagne) ; pièce de tissu</text></gloss>
      <gloss lang="en"><text>loincloth, brief-like underclothing; cloth patch</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀mbàá</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀mbàá_2776">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀mbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pɛ̀lɛ̀mbàá_2776_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ruisseau qui alimente ou draine un bas-fond (rizière)</text></gloss>
      <gloss lang="en"><text>stream that fills or drains a swamp (rice field)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 296: pɛ̀lɛ̀mbàá</text></form></note>
  </entry>
  <entry id="pɛ̀lɛ̀nɔ̀ɔ́_2777">
    <lexical-unit><form lang="kqs"><text>pɛ̀lɛ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
