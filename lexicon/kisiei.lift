      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine haute (ancienne)</text></gloss>
      <gloss lang="en"><text>(old-time) high-piled female hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: héŋgóó</text></form></note>
  </entry>
