      <gloss lang="fr"><text>mardi (jour de marché)</text></gloss>
      <gloss lang="en"><text>Tuesday (market day)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 226: lèkpààdóó</text></form></note>
