  </entry>
  <entry id="fɛ́ɛ́mbɛ́_1540">
    <lexical-unit><form lang="kqs"><text>fɛ́ɛ́mbɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fɛ́ɛ́mbɛ́_1540_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>jamais</text></gloss>
      <gloss lang="en"><text>never</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 101: fɛ́ɛ́mbɛ́</text></form></note>
    <note><form lang="fr"><text>Composé de fɛ́ɛ́ŋ « toujours » et bɛ́ « pas » ; cf. few … le dans la Bible.</text></form></note>
  </entry>
  <entry id="fɛ̀ɛ̀mbɛ̂ìyó_1541">
