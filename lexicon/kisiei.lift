  <entry id="yemaa_3856">
    <lexical-unit><form lang="kqs"><text>yemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yema</text></form></variant>
    <sense id="yemaa_3856_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sœur (d'un homme), frère (d'une femme)</text></gloss>
      <gloss lang="en"><text>opposite-sex sibling: a man's sister, a woman's brother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sister; brother in some dialects</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.24.55; Keita 1979, p. 134: Yemaa; Childs 2000, p. 402: yèmàá</text></form></note>
    <note><form lang="fr"><text>Keita : « la sœur ». Dans la Bible, Laban est aussi le yemaa de Rébecca (Gn 24,55 ; 28,5).</text></form></note>
  </entry>
