      <gloss lang="en"><text>sound of knocking or hitting</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ́cù</text></form></note>
  </entry>
  <entry id="dɔ́fɔ́ŋndéŋ_856">
    <lexical-unit><form lang="kqs"><text>dɔ́fɔ́ŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="dɔ́fɔ́ŋndéŋ_856_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe ressemblant au riz ou au blé</text></gloss>
      <gloss lang="en"><text>grass resembling rice or wheat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ́fɔ́ŋndéŋ</text></form></note>
  </entry>
  <entry id="dɔkuuvo_857">
    <lexical-unit><form lang="kqs"><text>dɔkuuvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dɔkuuvo_857_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canard</text></gloss>
      <gloss lang="en"><text>duck</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.6 Poultry raising"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Dökuuvo; Lexique kissi–français, p. 14: dɔkuwvo; Childs 2000, p. 89: dɔ̀ɔ̀kúùwɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 14 : dɔkuwvo, dɔkuo « canard ».</text></form></note>
  </entry>
  <entry id="dɔ́lɔ́ɔ́_858">
    <lexical-unit><form lang="kqs"><text>dɔ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dɔ́lúéí</text></form></field>
    <sense id="dɔ́lɔ́ɔ́_858_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'arbre</text></gloss>
      <gloss lang="en"><text>kind of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ́lɔ́ɔ́</text></form></note>
  </entry>
  <entry id="dɔndaa_859">
    <lexical-unit><form lang="kqs"><text>dɔndaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔnda</text></form></variant>
    <variant><form lang="kqs"><text>dɔndanin</text></form></variant>
    <sense id="dɔndaa_859_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prêter</text></gloss>
      <gloss lang="en"><text>lend</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lend; borrow, take on credit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.28.44; Childs 2000, p. 88: dɔ̀ndàá</text></form></note>
  </entry>
  <entry id="dɔndan_860">
    <lexical-unit><form lang="kqs"><text>dɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɔndan_860_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>emprunter</text></gloss>
      <gloss lang="en"><text>borrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.37.21; Childs 2000, p. 88: dɔ̀ndǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de dɔndaa « prêter ». Vana kɔlvesɛiyo dɔndan pɛ ɲɔɔ, o mingi le « le méchant emprunte et ne rend pas » (PSA.37.21).</text></form></note>
  </entry>
  <entry id="dɔ̀ndɔ̀kpééyó_861">
    <lexical-unit><form lang="kqs"><text>dɔ̀ndɔ̀kpééyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɔ̀ndɔ̀kpééyó_861_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>guêpe forestière à piqûre douloureuse</text></gloss>
      <gloss lang="en"><text>forest wasp with a painful sting</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ̀ndɔ̀kpééyó</text></form></note>
  </entry>
  <entry id="dɔ́ndɔ̀ŋ_862">
    <lexical-unit><form lang="kqs"><text>dɔ́ndɔ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɔ́ndɔ̀ŋ_862_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en enflant (grossesse, plaie qui s'infecte)</text></gloss>
      <gloss lang="en"><text>swelling up (pregnancy, infected sore)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ́ndɔ̀ŋ</text></form></note>
  </entry>
  <entry id="dɔndɔɔ_863">
    <lexical-unit><form lang="kqs"><text>dɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔndɔ</text></form></variant>
    <sense id="dɔndɔɔ_863_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prêt, emprunt, dette</text></gloss>
      <gloss lang="en"><text>loan, debt</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>loan, credit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.23; Lexique kissi–français, p. 14: dɔndɔɔ; Childs 2000, p. 88: dɔ́ndɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>niaa cuenin dɔndɔ le « vous n'emprunterez pas » (DEU.28.12) ; Mɛlɛka salanin dɔndɔ kon « le Seigneur rendra ce prêt » (PRO.19.17).</text></form></note>
  </entry>
  <entry id="dɔtɔlɔnɔɔ_864">
    <lexical-unit><form lang="kqs"><text>dɔtɔlɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɔtɔlɔa</text></form></field>
    <sense id="dɔtɔlɔnɔɔ_864_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>docteur, médecin</text></gloss>
      <gloss lang="en"><text>doctor</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LUK.5.31; Keita 1979, p. 145: Dötölönöö; Lexique kissi–français, p. 58: tɔtɔlɔnɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 58) écrit tɔtɔlɔnɔɔ.</text></form></note>
  </entry>
  <entry id="dɔvɔɔ_865">
    <lexical-unit><form lang="kqs"><text>dɔvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔw</text></form></variant>
    <variant><form lang="kqs"><text>dɔaw</text></form></variant>
    <variant><form lang="kqs"><text>dɔawnin</text></form></variant>
    <sense id="dɔvɔɔ_865_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bénir (… duaa) ; mettre dans, mettre sur, verser, remplir ; pondre (des œufs)</text></gloss>
      <gloss lang="en"><text>bless (… duaa); put in, put on, pour, fill; lay (eggs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 104 occurrences, first GEN.17.16; Lexique kissi–français, p. 14: dɔvɔɔ/ dɔw</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 14 : dɔvɔɔ/dɔw « mettre dedans ; mettre sur ; verser ; remplir », « pondre les œufs » (aussi dɔwvo). Cf. dɔw … danga « mettre une malédiction sur » (GEN.3.17).</text></form></note>
  </entry>
  <entry id="dɔwnun_866">
    <lexical-unit><form lang="kqs"><text>dɔwnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔwnɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>dɔwnɔn</text></form></variant>
    <variant><form lang="kqs"><text>dɔawnun</text></form></variant>
    <variant><form lang="kqs"><text>dɔawnunnin</text></form></variant>
    <sense id="dɔwnun_866_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>recevoir, obtenir ; (dɔwnun balo) se nourrir de ; (dɔwnun ɲaale) se réjouir ; être rempli (de) ; (dɔwnun kɔndɔfili) être stupéfait</text></gloss>
      <gloss lang="en"><text>receive, obtain; (dɔwnun balo) feed on; (dɔwnun ɲaale) rejoice; be filled (with); (dɔwnun kɔndɔfili) be amazed</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.2 Receive"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 183 occurrences, first GEN.1.30; Lexique kissi–français, p. 14: dɔnɔnndo/ dɔunun</text></form></note>
    <note><form lang="fr"><text>Moyen de dɔvɔɔ (dɔw, dɔaw). baalala niaalan la dɔawnunnin vɔ̀ngɔ̀ « votre travail sera récompensé » (2 Ch 15,7). Lexique kissi–français, p. 14 : dɔnɔnndo/dɔunun « rempli avec qqch » ; dɔunun kɔndɔfili « stupéfait, l'étonnement ».</text></form></note>
  </entry>
  <entry id="dɔ́ŋgú-dɔ́ŋgú_867">
    <lexical-unit><form lang="kqs"><text>dɔ́ŋgú-dɔ́ŋgú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɔ́ŋgú-dɔ́ŋgú_867_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>longtemps, de façon prolongée ou répétée</text></gloss>
      <gloss lang="en"><text>for a long time, on and on</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 88: dɔ́ŋgú-dɔ́ŋgú</text></form></note>
  </entry>
  <entry id="dɔ́ɔ́_868">
    <lexical-unit><form lang="kqs"><text>dɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɔ́ɔ́_868_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>alors, dès lors (moment atteint) ; (te … dɔ́ɔ́ pɛ) dès que, aussitôt que</text></gloss>
      <gloss lang="en"><text>then, by then (point reached); (te … dɔ́ɔ́ pɛ) as soon as, once</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>as soon as; marks a moment that is now relevant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 349 occurrences, first GEN.3.5; Childs 2000, p. 88: dɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>te la de dɔ́ɔ́ pɛ … « le jour où vous en mangerez … » (GEN.3.5) ; mí Noe sina dɔ́ɔ́ maa … « Noé sut alors que … » (GEN.8.11).</text></form></note>
  </entry>
  <entry id="dɔɔnanndo_869">
    <lexical-unit><form lang="kqs"><text>dɔɔnanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔɔnan</text></form></variant>
    <variant><form lang="kqs"><text>dɔɔnannin</text></form></variant>
    <sense id="dɔɔnanndo_869_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être peu nombreux, être petit ; être le moindre</text></gloss>
      <gloss lang="en"><text>be few, be small; be the least</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first NUM.36.4; Lexique kissi–français, p. 14: dɔnanndo</text></form></note>
    <note><form lang="fr"><text>o hiow dɔɔnanndo-o « le plus petit » (Mt 5,18). Lexique kissi–français, p. 14 : dɔnanndo « petit ».</text></form></note>
  </entry>
  <entry id="dɔɔngɔ le salavusuo_870">
    <lexical-unit><form lang="kqs"><text>dɔɔngɔ le salavusuo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dɔɔngɔ le salavusuo_870_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>base militaire</text></gloss>
      <gloss lang="en"><text>military base</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: dɔɔngɔ le salavusuo</text></form></note>
    <note><form lang="fr"><text>dɔ́ɔ́ngɔ́ɔ̀ « camp » est dans la Bible ; salavusuo n'est pas identifié. Forme et sens à confirmer.</text></form></note>
  </entry>
  <entry id="dɔ́ɔ́ngɔ́ɔ̀_871">
    <lexical-unit><form lang="kqs"><text>dɔ́ɔ́ngɔ́ɔ̀</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔ́ɔ́ngɔ́</text></form></variant>
    <sense id="dɔ́ɔ́ngɔ́ɔ̀_871_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>camp, campement</text></gloss>
      <gloss lang="en"><text>camp</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 146 occurrences, first GEN.11.2</text></form></note>
  </entry>
  <entry id="dɔɔniaa_872">
    <lexical-unit><form lang="kqs"><text>dɔɔniaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔɔniaanin</text></form></variant>
    <variant><form lang="kqs"><text>dɔɔnial</text></form></variant>
    <sense id="dɔɔniaa_872_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>diminuer, réduire, alléger</text></gloss>
      <gloss lang="en"><text>reduce, diminish, lighten</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.27.18</text></form></note>
    <note><form lang="fr"><text>Causatif de dɔɔnanndo ; dɔɔnial « alléger pour » (1 R 12,4).</text></form></note>
  </entry>
  <entry id="dɔ́ɔ̀ŋndó_873">
    <lexical-unit><form lang="kqs"><text>dɔ́ɔ̀ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɔ́ɔ̀ŋndó_873_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affût (du chasseur)</text></gloss>
      <gloss lang="en"><text>(hunter's) blind, hide</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dɔ́ɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="dɛ_874">
    <lexical-unit><form lang="kqs"><text>dɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɛ_874_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule d'insistance (après un ordre ou une défense)</text></gloss>
      <gloss lang="en"><text>emphatic particle (after a command)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 148 occurrences, first GEN.19.17</text></form></note>
  </entry>
  <entry id="dɛ́_875">
    <lexical-unit><form lang="kqs"><text>dɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɛ́_875_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souligne une action faite exprès, avec effort</text></gloss>
      <gloss lang="en"><text>stresses a deliberate, intense action</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 74: dɛ́</text></form></note>
  </entry>
  <entry id="dɛ̀lù-bɔ̀ndɔ́ɔ́_876">
    <lexical-unit><form lang="kqs"><text>dɛ̀lù-bɔ̀ndɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɛ̀lù-bɔ̀ndɔ́ɔ́_876_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de ver (à grosse tête)</text></gloss>
      <gloss lang="en"><text>kind of worm (with a big head)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ̀lù-bɔ̀ndɔ́ɔ́</text></form></note>
  </entry>
  <entry id="dɛ̀lù-ìyììŋndó_877">
    <lexical-unit><form lang="kqs"><text>dɛ̀lù-ìyììŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɛ̀lù-ìyììŋndó_877_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chenille</text></gloss>
      <gloss lang="en"><text>caterpillar</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ̀lù-ìyììŋndó</text></form></note>
  </entry>
  <entry id="dɛluo_878">
    <lexical-unit><form lang="kqs"><text>dɛluo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>dɛlua</text></form></field>
    <variant><form lang="kqs"><text>dɛlu</text></form></variant>
    <sense id="dɛluo_878_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ver</text></gloss>
      <gloss lang="en"><text>worm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chigger; any small insect such as a caterpillar or worm</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Dèluo; Lexique kissi–français, p. 13: dɛluo; Childs 2000, p. 75: dɛ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La Bible a le pluriel dɛlua (JOB.24.20) et dɛloo « un ver » (JON.4.7).</text></form></note>
  </entry>
  <entry id="dɛ̀mdɛ̀m-_879">
    <lexical-unit><form lang="kqs"><text>dɛ̀mdɛ̀m-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɛ̀mdɛ̀m-_879_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>plat, lisse (nourriture, terrain)</text></gloss>
      <gloss lang="en"><text>flat, smooth (food, ground)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ̀mdɛ̀m-</text></form></note>
  </entry>
  <entry id="dɛ̀mdɛ̀mndó_880">
    <lexical-unit><form lang="kqs"><text>dɛ̀mdɛ̀mndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɛ̀mdɛ̀mndó_880_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pain de riz pilé en farine fine</text></gloss>
      <gloss lang="en"><text>bread of rice pounded into fine flour</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ̀mdɛ̀mndó</text></form></note>
  </entry>
  <entry id="dɛ́mɔ́ɔ́_881">
    <lexical-unit><form lang="kqs"><text>dɛ́mɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dɛ́mɛ́láŋ</text></form></field>
    <sense id="dɛ́mɔ́ɔ́_881_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fait de chasser une toupie hors de l'aire de jeu</text></gloss>
      <gloss lang="en"><text>knocking a spinning top out of the playing area</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ́mɔ́ɔ́</text></form></note>
  </entry>
  <entry id="dɛ̀ndɔ̀ɔ́_882">
    <lexical-unit><form lang="kqs"><text>dɛ̀ndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɛ̀ndɛ̀lan</text></form></field>
    <variant><form lang="kqs"><text>dɛ̀ndɛ̀</text></form></variant>
    <sense id="dɛ̀ndɔ̀ɔ́_882_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pirogue, bateau ; arche</text></gloss>
      <gloss lang="en"><text>canoe, boat; ark</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>canoe, boat; also an airplane</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 138 occurrences, first GEN.6.18; Keita 1979, p. 159: Dèndöö; Lexique kissi–français, p. 13: dɛndɔɔ; Childs 2000, p. 75: dèndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="dɛndɔɔ_883">
    <lexical-unit><form lang="kqs"><text>dɛndɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <field type="plural"><form lang="kqs"><text>dɛndɛlan</text></form></field>
    <sense id="dɛndɔɔ_883_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>houe</text></gloss>
      <gloss lang="en"><text>hoe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.8 Agricultural tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Dèndöö; Lexique kissi–français, p. 13: dɛndɔɔ; Childs 2000, p. 75: déndɔ̀ɔ̀</text></form></note>
    <note><form lang="fr"><text>Homonyme de dɛ̀ndɔ̀ɔ́ « pirogue », avec un autre ton chez Childs. 1 S 13,20 a dɛndɛla (sans tons) « houes ». Le Lexique kissi–français, p. 13, glose dɛndɔɔ « la houe, la pirogue ».</text></form></note>
  </entry>
  <entry id="dɛngbɔɔ_884">
    <lexical-unit><form lang="kqs"><text>dɛngbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɛngbɛlan</text></form></field>
    <variant><form lang="kqs"><text>dɛngbɛ</text></form></variant>
    <variant><form lang="kqs"><text>dɛngbɛla</text></form></variant>
    <sense id="dɛngbɔɔ_884_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plaine, vallée ; (pl.) bas pays</text></gloss>
      <gloss lang="en"><text>plain, valley; (pl.) lowlands</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first JOS.4.13; Childs 2000, p. 76: déŋgbɔ́ɔ́</text></form></note>
  </entry>
  <entry id="dɛngulten_885">
    <lexical-unit><form lang="kqs"><text>dɛngulten</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɛngultan</text></form></field>
    <variant><form lang="kqs"><text>dɛngulta</text></form></variant>
    <variant><form lang="kqs"><text>dɛngulte</text></form></variant>
    <sense id="dɛngulten_885_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>braise, charbon ardent</text></gloss>
      <gloss lang="en"><text>glowing coal, ember</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.6.6; Childs 2000, p. 76: dèŋgùltéŋ</text></form></note>
  </entry>
  <entry id="dɛnkpɔɔ_886">
    <lexical-unit><form lang="kqs"><text>dɛnkpɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dɛnkpɔɔ_886_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>plat</text></gloss>
      <gloss lang="en"><text>flat (or: dish)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dɛnkpɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique glose « plat » sans préciser s'il s'agit de l'adjectif ou du récipient.</text></form></note>
  </entry>
  <entry id="dɛnɔɔ_887">
    <lexical-unit><form lang="kqs"><text>dɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɛnndan</text></form></field>
    <variant><form lang="kqs"><text>dɛnɛ</text></form></variant>
    <variant><form lang="kqs"><text>dɛnnda</text></form></variant>
    <sense id="dɛnɔɔ_887_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose, affaire, fait</text></gloss>
      <gloss lang="en"><text>thing, matter, deed</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first GEN.20.5; Lexique kissi–français, p. 13: dɛnɔɔ</text></form></note>
  </entry>
  <entry id="dɛnɛ kɛndɔɔ_888">
    <lexical-unit><form lang="kqs"><text>dɛnɛ kɛndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɛnɛ kɛndɔɔ_888_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bien, bonne chose ; bonheur</text></gloss>
      <gloss lang="en"><text>good thing; happiness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Dènèkèndöö-Yelelaa; Lexique kissi–français, p. 13: dɛnɛkɛndɔɔ</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi yelelaa comme synonyme.</text></form></note>
  </entry>
  <entry id="dɛnɛ palaa_889">
    <lexical-unit><form lang="kqs"><text>dɛnɛ palaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɛnɛ palaa_889_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>malheur</text></gloss>
      <gloss lang="en"><text>misfortune, woe</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Dènèpalaa; Lexique kissi–français, p. 13: dɛnɛpalaa</text></form></note>
  </entry>
  <entry id="dɛ́wɔ́ɔ́_890">
    <lexical-unit><form lang="kqs"><text>dɛ́wɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dɛ́wɛ́láŋ</text></form></field>
    <sense id="dɛ́wɔ́ɔ́_890_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bassin, hanche</text></gloss>
      <gloss lang="en"><text>pelvis, hip</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 76: dɛ́wɔ́ɔ́</text></form></note>
  </entry>
  <entry id="dɛŋio_891">
    <lexical-unit><form lang="kqs"><text>dɛŋio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>dɛŋi</text></form></variant>
    <sense id="dɛŋio_891_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier</text></gloss>
      <gloss lang="en"><text>shout, cry out</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dɛŋio/ dɛŋi</text></form></note>
  </entry>
  <entry id="dɛɔɔ_892">
    <lexical-unit><form lang="kqs"><text>dɛɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dɛɔɔ_892_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pâte (de riz, de farine…)</text></gloss>
      <gloss lang="en"><text>dough, paste (of rice, flour…)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dɛɔɔ</text></form></note>
  </entry>
  <entry id="dɛɛlaa_893">
    <lexical-unit><form lang="kqs"><text>dɛɛlaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dɛɛlalan</text></form></field>
    <variant><form lang="kqs"><text>dɛɛla</text></form></variant>
    <variant><form lang="kqs"><text>dɛɛlala</text></form></variant>
    <sense id="dɛɛlaa_893_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vallée, plaine</text></gloss>
      <gloss lang="en"><text>valley, plain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dry swamp suitable for rice growing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.13.10; Childs 2000, p. 74: dèèlàá</text></form></note>
  </entry>
  <entry id="dɛɛluo_894">
    <lexical-unit><form lang="kqs"><text>dɛɛluo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dɛɛluo_894_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ver (intestinal)</text></gloss>
      <gloss lang="en"><text>(intestinal) worm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Dèèluo; Lexique kissi–français, p. 13: dɛɛluo</text></form></note>
  </entry>
  <entry id="dɛ̀ɛ̀nàá_895">
    <lexical-unit><form lang="kqs"><text>dɛ̀ɛ̀nàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɛ̀ɛ̀nàá_895_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre son temps, traîner, ralentir</text></gloss>
      <gloss lang="en"><text>take one's time, dawdle, slow down</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 74: dɛ̀ɛ̀nàá</text></form></note>
  </entry>
  <entry id="dɛɛniaa_896">
    <lexical-unit><form lang="kqs"><text>dɛɛniaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɛɛniaanin</text></form></variant>
    <sense id="dɛɛniaa_896_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>persuader, presser, supplier ; amadouer</text></gloss>
      <gloss lang="en"><text>persuade, urge, coax</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>console, comfort (a crying person); persuade, coax</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first JDG.16.5; Childs 2000, p. 75: dèènìáá</text></form></note>
  </entry>
  <entry id="dɛ́ɛ̀ù_897">
    <lexical-unit><form lang="kqs"><text>dɛ́ɛ̀ù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɛ́ɛ̀ù_897_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une inspiration brusque, rot rentré</text></gloss>
      <gloss lang="en"><text>sound of a sharp intake of breath, an inward belch</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 75: dɛ́ɛ̀ù</text></form></note>
  </entry>
  <entry id="dɛ́ɛ̀ɛ̀_898">
    <lexical-unit><form lang="kqs"><text>dɛ́ɛ̀ɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dɛ́ɛ̀ɛ̀_898_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lentement</text></gloss>
      <gloss lang="en"><text>slowly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 74: dɛ́ɛ̀ɛ̀</text></form></note>
  </entry>
  <entry id="éé_899">
    <lexical-unit><form lang="kqs"><text>éé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="éé_899_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ô ! (vocatif, en s'adressant à qqn)</text></gloss>
      <gloss lang="en"><text>O! (vocative, addressing someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>vocative particle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 280 occurrences, first GEN.19.18; Childs 2000, p. 92: ê</text></form></note>
    <note><form lang="fr"><text>Éé Mɛlɛka ! « Ô Seigneur ! » (GEN.49.18) ; Éé Pua « Ô mon père » (GEN.27.34).</text></form></note>
  </entry>
  <entry id="èèè_900">
    <lexical-unit><form lang="kqs"><text>èèè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="èèè_900_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>oh ! (déception)</text></gloss>
      <gloss lang="en"><text>oh! (disappointment)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 92: èèè</text></form></note>
  </entry>
  <entry id="emerɔd_901">
    <lexical-unit><form lang="kqs"><text>emerɔd</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="emerɔd_901_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>émeraude</text></gloss>
      <gloss lang="en"><text>emerald</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.28.17</text></form></note>
  </entry>
  <entry id="fà_902">
    <lexical-unit><form lang="kqs"><text>fà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fà_902_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aîné, aînée (terme d'adresse)</text></gloss>
      <gloss lang="en"><text>elder brother or sister (term of address)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fà</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="fá-fà-fà_903">
    <lexical-unit><form lang="kqs"><text>fá-fà-fà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fá-fà-fà_903_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de la machette qui fauche l'herbe, coup après coup</text></gloss>
      <gloss lang="en"><text>swish of a cutlass slashing grass, stroke after stroke</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 95: fá-fà-fà ..</text></form></note>
  </entry>
  <entry id="fáá_904">
    <lexical-unit><form lang="kqs"><text>fáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fáá_904_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souligne l'action de se moucher, de déféquer, de péter ; fort (souffler)</text></gloss>
      <gloss lang="en"><text>stresses blowing one's nose, defecating, breaking wind; hard (blowing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fáá</text></form></note>
  </entry>
  <entry id="fáá_905">
    <lexical-unit><form lang="kqs"><text>fáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fááláŋ</text></form></field>
    <sense id="fáá_905_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre sauvage à gousses (qui éclatent en saison sèche)</text></gloss>
      <gloss lang="en"><text>wild tree bearing bean pods (that burst in the dry season)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fáá</text></form></note>
  </entry>
  <entry id="faaboo_906">
    <lexical-unit><form lang="kqs"><text>faaboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="faaboo_906_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perroquet</text></gloss>
      <gloss lang="en"><text>parrot</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a bird, perhaps a small green parrot; also a figure of the initiation society</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Faaboo; Lexique kissi–français, p. 14: faaboo; Childs 2000, p. 93: fàábɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="fááfáá_907">
    <lexical-unit><form lang="kqs"><text>fááfáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fááfááláŋ</text></form></field>
    <sense id="fááfáá_907_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tuteurs pour les haricots grimpants</text></gloss>
      <gloss lang="en"><text>climbing sticks for bean vines</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fááfáá</text></form></note>
  </entry>
  <entry id="fáàndaa_908">
    <lexical-unit><form lang="kqs"><text>fáàndaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fáàndaa_908_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fronde</text></gloss>
      <gloss lang="en"><text>sling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sling, slingshot, also used to chase birds</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.20.16; Keita 1979, p. 156: Faandaa; Lexique kissi–français, p. 14: faandaa; Childs 2000, p. 93: fáàndáá</text></form></note>
  </entry>
  <entry id="fààndàá_909">
    <lexical-unit><form lang="kqs"><text>fààndàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fààndàá_909_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter loin ; errer sans but</text></gloss>
      <gloss lang="en"><text>throw far; wander aimlessly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fààndàá</text></form></note>
    <note><form lang="fr"><text>La Bible n'a que le nom fáàndaa « fronde ».</text></form></note>
  </entry>
  <entry id="fààndɛ̀í_910">
    <lexical-unit><form lang="kqs"><text>fààndɛ̀í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fààndǎŋ</text></form></field>
    <sense id="fààndɛ̀í_910_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haricot sauvage brun foncé (teinture, potasse ; peut-être toxique)</text></gloss>
      <gloss lang="en"><text>dark brown wild bean (dye, soda; possibly poisonous)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 93: fààndɛ̀í</text></form></note>
  </entry>
  <entry id="fààsàá_911">
    <lexical-unit><form lang="kqs"><text>fààsàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fààsàá_911_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter à terre et briser ; éclater ; éclore</text></gloss>
      <gloss lang="en"><text>smash down, shatter; split open; hatch</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 94: fààsàá</text></form></note>
  </entry>
  <entry id="faaŋiaa_912">
    <lexical-unit><form lang="kqs"><text>faaŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="faaŋiaa_912_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retirer, enlever (la graisse, les cendres)</text></gloss>
      <gloss lang="en"><text>take off, remove (fat, ashes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away or remove (things or people); plural of fàŋàá</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first LEV.4.19; Childs 2000, p. 94: fààŋìá</text></form></note>
  </entry>
  <entry id="fácííyó_913">
    <lexical-unit><form lang="kqs"><text>fácííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fácííláŋ</text></form></field>
    <sense id="fácííyó_913_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau</text></gloss>
      <gloss lang="en"><text>bucket, pail</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 95: fácííyó</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="fafaláà_914">
    <lexical-unit><form lang="kqs"><text>fafaláà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fafala</text></form></variant>
    <sense id="fafaláà_914_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peiner, se donner du mal ; se soucier de</text></gloss>
      <gloss lang="en"><text>toil, labour; worry about</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>struggle, suffer</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.8.10; Childs 2000, p. 95: fàfàlàá</text></form></note>
    <note><form lang="fr"><text>La fafala le ɲɛ niaa dianin-ndo « ne vous souciez pas de ce que vous mangerez » (Lc 12,29).</text></form></note>
  </entry>
  <entry id="fáká-fáká_915">
    <lexical-unit><form lang="kqs"><text>fáká-fáká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fáká-fáká_915_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très vite, soudainement</text></gloss>
      <gloss lang="en"><text>very fast, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fáká-fáká</text></form></note>
  </entry>
  <entry id="fakpa_916">
    <lexical-unit><form lang="kqs"><text>fakpa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fakpa_916_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper de la main (?)</text></gloss>
      <gloss lang="en"><text>strike with the hand (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: fakpa</text></form></note>
    <note><form lang="fr"><text>Lexique : « frapper à la main (passé et inf) ? » ; le point d'interrogation est dans la source.</text></form></note>
  </entry>
  <entry id="fakpaa_917">
    <lexical-unit><form lang="kqs"><text>fakpaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fakpaa_917_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couteau, coupe-coupe</text></gloss>
      <gloss lang="en"><text>knife, machete</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: fakpaa</text></form></note>
  </entry>
  <entry id="fálábóó_918">
    <lexical-unit><form lang="kqs"><text>fálábóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fálábúéí</text></form></field>
    <sense id="fálábóó_918_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre épineux à bois clair, facile à fendre</text></gloss>
      <gloss lang="en"><text>thorny tree with light, easily split wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fálábóó</text></form></note>
  </entry>
  <entry id="falei_919">
    <lexical-unit><form lang="kqs"><text>falei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>falon</text></form></field>
    <variant><form lang="kqs"><text>falun</text></form></variant>
    <variant><form lang="kqs"><text>falii</text></form></variant>
    <sense id="falei_919_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre, partie du corps ; chair ; (pl.) le corps ; pièce, morceau</text></gloss>
      <gloss lang="en"><text>limb, part of the body; flesh; (pl.) the body; piece</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first LEV.21.18; Lexique kissi–français, p. 14: falei</text></form></note>
    <note><form lang="fr"><text>Se fléchit comme dialii : Mí Sɔɛi siŋnun falon « le Verbe s'est fait chair » (Jn 1,14) ; falii kiyɛiye « chair vive » (Lv 13,10) ; ifalu oo ifalu « chaque membre » (Rm 12,4). Lexique kissi–français, p. 14 : falei « pièce » ; p. 15 : farie « le corps ; la chair ; membre ».</text></form></note>
  </entry>
  <entry id="faleŋii_920">
    <lexical-unit><form lang="kqs"><text>faleŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>faleŋun</text></form></field>
    <variant><form lang="kqs"><text>falennde</text></form></variant>
    <variant><form lang="kqs"><text>falenndon</text></form></variant>
    <sense id="faleŋii_920_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rite, cérémonie (religieuse)</text></gloss>
      <gloss lang="en"><text>rite, ceremony</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first EXO.29.24</text></form></note>
    <note><form lang="fr"><text>tosa faleŋii dindiannde « accomplir le rite de purification » (Lv 12,7). Variante falennde, pluriel falenndon (Lv 9,7 ; Lv 14,2).</text></form></note>
  </entry>
  <entry id="falle_921">
    <lexical-unit><form lang="kqs"><text>falle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="falle_921_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>place publique, espace dégagé</text></gloss>
      <gloss lang="en"><text>public square, open space</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
      <trait name="semantic-domain-ddp4" value="4.2 Social activity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.26.22; Lexique kissi–français, p. 14: falle</text></form></note>
    <note><form lang="fr"><text>Lexique : « un endroit public dans le village ». Dans la Bible aussi falle fɛkɛi « un espace large » (GEN.26.22).</text></form></note>
  </entry>
  <entry id="fàllé_922">
    <lexical-unit><form lang="kqs"><text>fàllé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="fàllé_922_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terrier, nid souterrain du rat</text></gloss>
      <gloss lang="en"><text>rat's burrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 96: fàllé</text></form></note>
  </entry>
  <entry id="fàlléŋ_923">
