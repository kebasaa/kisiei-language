      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hanche</text></gloss>
      <gloss lang="en"><text>hip</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 233: lòŋùèí</text></form></note>
