  <entry id="fɛɛyaa_1546">
    <lexical-unit><form lang="kqs"><text>fɛɛyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>fɛɛya</text></form></variant>
    <sense id="fɛɛyaa_1546_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher</text></gloss>
      <gloss lang="en"><text>clear (land)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear away low bushes</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyaa; Lexique kissi–français, p. 15: fɛɛyaa/ fɛɛya; Sandara Kisia, fable 2: fɛya; Childs 2000, p. 102: fèèyàá</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : fɛɛya (JOS 17,15). La Bible a la forme fɛɛya « défricher » (JOS.17.15).</text></form></note>
  </entry>
  <entry id="fɛɛyallo_1547">
    <lexical-unit><form lang="kqs"><text>fɛɛyallo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyallo_1547_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher pour quelqu'un</text></gloss>
      <gloss lang="en"><text>clear land for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyallo; Lexique kissi–français, p. 15: fɛɛyallo/ fɛɛyal</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de fɛɛyaa.</text></form></note>
  </entry>
  <entry id="fɛɛyiaa_1548">
    <lexical-unit><form lang="kqs"><text>fɛɛyiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɛɛyiaa_1548_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher en plusieurs endroits</text></gloss>
      <gloss lang="en"><text>clear land in several places</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fèèyiaa; Lexique kissi–français, p. 15: fɛɛyiaa/ fɛɛyia</text></form></note>
    <note><form lang="fr"><text>Pluriel de fɛɛyaa.</text></form></note>
  </entry>
  <entry id="gbó-gbó_1549">
    <lexical-unit><form lang="kqs"><text>gbó-gbó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbó-gbó_1549_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit des pas de quelqu'un qui marche</text></gloss>
      <gloss lang="en"><text>sound of footsteps</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbó-gbó ...</text></form></note>
  </entry>
  <entry id="gbólúŋ-gbólúŋ_1550">
    <lexical-unit><form lang="kqs"><text>gbólúŋ-gbólúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbólúŋ-gbólúŋ_1550_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de va-et-vient (navette du tisserand, clochettes)</text></gloss>
      <gloss lang="en"><text>rattling back and forth (weaver's shuttle, bells)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbólúŋ-gbólúŋ</text></form></note>
  </entry>
  <entry id="gbú-û-ù_1551">
    <lexical-unit><form lang="kqs"><text>gbú-û-ù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbú-û-ù_1551_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de fibre arrachée ; tonnerre lointain</text></gloss>
      <gloss lang="en"><text>sound of fibre being stripped; distant thunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbú-û-ù</text></form></note>
  </entry>
  <entry id="gbúŋ-gbúŋ_1552">
    <lexical-unit><form lang="kqs"><text>gbúŋ-gbúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="gbúŋ-gbúŋ_1552_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit sourd et régulier (pilon, hache, coup sur la tête)</text></gloss>
      <gloss lang="en"><text>steady thumping (pestle, axe, blow on the head)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: gbúŋ-gbúŋ</text></form></note>
  </entry>
  <entry id="gbɛɛnɛi_1553">
    <lexical-unit><form lang="kqs"><text>gbɛɛnɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="gbɛɛnɛi_1553_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marmite</text></gloss>
      <gloss lang="en"><text>cooking pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Gbèènèi</text></form></note>
  </entry>
  <entry id="giduno_1554">
