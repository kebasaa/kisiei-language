    <variant><form lang="kqs"><text>heelaa</text></form></variant>
    <sense id="heeloo_360_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever</text></gloss>
      <gloss lang="en"><text>lift up, raise</text></gloss>
