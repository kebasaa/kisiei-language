    <sense id="mɔsɔŋiaa_822_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regrouper, rassembler (plusieurs)</text></gloss>
      <gloss lang="en"><text>gather (many)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Mösönhiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de mɔsɔŋaa. Forme attestée dans la Bible : mɔsɔŋian « se coaliser » (JOS 10,6).</text></form></note>
  </entry>
  <entry id="mɔɔsiaa_823">
    <lexical-unit><form lang="kqs"><text>mɔɔsiaa</text></form></lexical-unit>
