      <gloss lang="fr"><text>deuxièmement</text></gloss>
      <gloss lang="en"><text>secondly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 255: mùúŋndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mùɛ̀-fàŋndé_2302">
    <lexical-unit><form lang="kqs"><text>mùɛ̀-fàŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
