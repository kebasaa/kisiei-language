    <variant><form lang="kqs"><text>kalulan</text></form></variant>
    <sense id="kaloo_1237_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dur ; difficile ; (nila kalua) têtus</text></gloss>
      <gloss lang="en"><text>hard; difficult; (nila kalua) stubborn</text></gloss>
