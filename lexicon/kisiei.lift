  <entry id="fúlùkpàtà_1446">
    <lexical-unit><form lang="kqs"><text>fúlùkpàtà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fúlùkpàtà_1446_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en glissant et en tombant</text></gloss>
      <gloss lang="en"><text>slipping and falling over</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 112: fúlùkpàtà</text></form></note>
  </entry>
  <entry id="fùlùlàá_1447">
    <lexical-unit><form lang="kqs"><text>fùlùlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fùlùlàá_1447_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étuver, cuire à la vapeur (riz)</text></gloss>
      <gloss lang="en"><text>parboil, steam (rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 112: fùlùlàá</text></form></note>
  </entry>
  <entry id="fuluŋo_1448">
    <lexical-unit><form lang="kqs"><text>fuluŋo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuluŋo_1448_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune homme, jeune fille (après l'initiation)</text></gloss>
      <gloss lang="en"><text>young man, young woman (after initiation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 28: fuluŋo</text></form></note>
  </entry>
  <entry id="fùlɔ̀ɔ́_1449">
    <lexical-unit><form lang="kqs"><text>fùlɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fùlɔ̀ɔ́_1449_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler très fin, réduire en purée (feuilles de manioc)</text></gloss>
      <gloss lang="en"><text>mash, pound very fine (cassava leaves)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 112: fùlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="funda_1450">
    <lexical-unit><form lang="kqs"><text>funda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>fundala</text></form></field>
    <sense id="funda_1450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (écorce battue pour faire des collets)</text></gloss>
      <gloss lang="en"><text>tree (bark beaten to make snares)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 28: funda, pl. fundara</text></form></note>
  </entry>
  <entry id="fùndàá_1451">
    <lexical-unit><form lang="kqs"><text>fùndàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùndɛ̀í</text></form></field>
    <sense id="fùndàá_1451_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre lianescent à croissance rapide (haies de défense ; écorce jadis vêtement)</text></gloss>
      <gloss lang="en"><text>fast-growing vine-like tree (town fortifications; bark once used for clothing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fùndàá</text></form></note>
  </entry>
  <entry id="fungbula_1452">
    <lexical-unit><form lang="kqs"><text>fungbula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fungbulan</text></form></variant>
    <sense id="fungbula_1452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>meurtrissures, plaies, blessures (des coups)</text></gloss>
      <gloss lang="en"><text>bruises, welts, wounds (from blows)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>welt, swelling from a blow or insect bite</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.16.8; Childs 2000, p. 113: fùŋgbòó</text></form></note>
    <note><form lang="fr"><text>Pluriel. le fungbula ndɔlan naa n sengu ni « c'est par ses meurtrissures que nous sommes guéris » (ISA.53.5).</text></form></note>
  </entry>
  <entry id="fungoo_1453">
    <lexical-unit><form lang="kqs"><text>fungoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="fungoo_1453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soufre ; poudre à canon</text></gloss>
      <gloss lang="en"><text>sulphur, brimstone; gunpowder</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gunpowder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.19.24; Terminologie (histoire), n° 491: Fungoo; Childs 2000, p. 113: fúŋgóó</text></form></note>
  </entry>
  <entry id="fungoo lomɔɔ_1454">
    <lexical-unit><form lang="kqs"><text>fungoo lomɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fungoo lomɔɔ_1454_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fusillade</text></gloss>
      <gloss lang="en"><text>gunfire, shooting</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 342: Fungoo lomöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Mots attestés séparément dans la Bible, pas l'expression.</text></form></note>
  </entry>
  <entry id="funguo_1455">
    <lexical-unit><form lang="kqs"><text>funguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="funguo_1455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poudre à canon</text></gloss>
      <gloss lang="en"><text>gunpowder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: funguo</text></form></note>
    <note><form lang="fr"><text>La Bible a fungu « soufre » (REV.9.18, REV.14.10).</text></form></note>
  </entry>
  <entry id="funkpuo_1456">
    <lexical-unit><form lang="kqs"><text>funkpuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="funkpuo_1456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trace d'un coup de fouet</text></gloss>
      <gloss lang="en"><text>whip mark, weal</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: funkpuo</text></form></note>
  </entry>
  <entry id="funnden_1457">
    <lexical-unit><form lang="kqs"><text>funnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="funnden_1457_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coton ; lin</text></gloss>
      <gloss lang="en"><text>cotton; flax</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cotton; cotton thread, cotton cloth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.9.31; Keita 1979, p. 139: Funnden; Paulme 1964, p. 28: funde; Lexique kissi–français, p. 16: funnden; Childs 2000, p. 113: fùŋndéŋ</text></form></note>
    <note><form lang="fr"><text>La Bible l'emploie pour le lin (EXO.9.31). Paulme 1964, p. 28 : funde « coton » ; yɔmule fundo « cotonnier ».</text></form></note>
  </entry>
  <entry id="fuo_1458">
    <lexical-unit><form lang="kqs"><text>fuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="fuo_1458_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>éponge</text></gloss>
      <gloss lang="en"><text>sponge</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Fuo; Lexique kissi–français, p. 16: fuo</text></form></note>
  </entry>
  <entry id="fuo_1459">
    <lexical-unit><form lang="kqs"><text>fuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuo_1459_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mars</text></gloss>
      <gloss lang="en"><text>March</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>month around February or March, end of the dry season</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Fuo; Lexique kissi–français, p. 16: fuo; Terminologie (langue), n° 439: Fuo ✎ 7; Childs 2000, p. 113: fúóò</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 439) : « mars », numéroté à la main 7.</text></form></note>
  </entry>
  <entry id="fuo_1460">
    <lexical-unit><form lang="kqs"><text>fuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuo_1460_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fleur</text></gloss>
      <gloss lang="en"><text>flower</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fuo</text></form></note>
    <note><form lang="fr"><text>Homographe de fuo « éponge » et fuo « mars » (même page du Lexique).</text></form></note>
  </entry>
  <entry id="fuo_1461">
    <lexical-unit><form lang="kqs"><text>fuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuo_1461_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>douzième mois (de l'année)</text></gloss>
      <gloss lang="en"><text>twelfth month (of the year)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 28: fuo</text></form></note>
    <note><form lang="fr"><text>Paulme marque ce mot /S./ (Sud).</text></form></note>
  </entry>
  <entry id="fúó_1462">
    <lexical-unit><form lang="kqs"><text>fúó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fúá</text></form></field>
    <sense id="fúó_1462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau des rizières</text></gloss>
      <gloss lang="en"><text>rice bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fúó</text></form></note>
  </entry>
  <entry id="fusa_1463">
    <lexical-unit><form lang="kqs"><text>fusa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fusa_1463_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purification par aspersion</text></gloss>
      <gloss lang="en"><text>purification by sprinkling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 28: fusa</text></form></note>
    <note><form lang="fr"><text>Paulme : sarino tyɛ o fusa.</text></form></note>
  </entry>
  <entry id="fúú_1464">
    <lexical-unit><form lang="kqs"><text>fúú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fúú_1464_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement (fondo fúú « tout nu, entièrement vide »)</text></gloss>
      <gloss lang="en"><text>completely (fondo fúú 'stark naked, utterly empty')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 183 occurrences, first GEN.9.22</text></form></note>
  </entry>
  <entry id="fuulaa_1465">
    <lexical-unit><form lang="kqs"><text>fuulaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fuulaa_1465_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souffler (le feu, avec un soufflet)</text></gloss>
      <gloss lang="en"><text>blow (a fire, with bellows)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.54.16; Childs 2000, p. 114: fùùlàá</text></form></note>
    <note><form lang="fr"><text>o co yinnden fuulaa « il souffle sur le feu » (ISA.54.16) ; kùùlan la co fuulaa tuŋ « le soufflet souffle avec force » (JER.6.29).</text></form></note>
  </entry>
  <entry id="fuulian nvancieeo_1466">
    <lexical-unit><form lang="kqs"><text>fuulian nvancieeo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuulian nvancieeo_1466_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>progrès social</text></gloss>
      <gloss lang="en"><text>social progress</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 524: Fuulian nvantyieeo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="fùùlóó_1467">
    <lexical-unit><form lang="kqs"><text>fùùlóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùùlúláŋ</text></form></field>
    <sense id="fùùlóó_1467_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vessie ; ballon en vessie de chèvre (jeu d'enfants)</text></gloss>
      <gloss lang="en"><text>bladder; ball made from a goat's bladder (children's game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 114: fùùlóó</text></form></note>
  </entry>
  <entry id="fùùndàá_1468">
    <lexical-unit><form lang="kqs"><text>fùùndàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fùùndàá_1468_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>inhaler, priser ; couper le riz (à la faucille, par grosses poignées)</text></gloss>
      <gloss lang="en"><text>inhale, snort (snuff); cut rice (with a sickle, in large clumps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùndàá</text></form></note>
  </entry>
  <entry id="fuusaa_1469">
    <lexical-unit><form lang="kqs"><text>fuusaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>fuusa</text></form></variant>
    <variant><form lang="kqs"><text>fuusɛi</text></form></variant>
    <variant><form lang="kqs"><text>fuusan</text></form></variant>
    <sense id="fuusaa_1469_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire brûler (l'encens), encenser</text></gloss>
      <gloss lang="en"><text>burn (incense)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note><form lang="fr"><text>bonyii fuusɛi, pluriel bonyun fuusan « encensoir(s) » (Lv 10,1 ; Nb 16,17).</text></form></note>
  </entry>
  <entry id="fúùù_1470">
    <lexical-unit><form lang="kqs"><text>fúùù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fúùù_1470_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une allumette qui s'enflamme, d'un souffle, d'une chute</text></gloss>
      <gloss lang="en"><text>sound of a match flaring, of blowing, of a fall</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fúùù</text></form></note>
  </entry>
  <entry id="fùùyìá_1471">
    <lexical-unit><form lang="kqs"><text>fùùyìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fùùyìá_1471_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>défricher grossièrement, incomplètement</text></gloss>
      <gloss lang="en"><text>clear a field roughly, incompletely</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùyìá</text></form></note>
  </entry>
  <entry id="fùùyɔ́ɔ́_1472">
    <lexical-unit><form lang="kqs"><text>fùùyɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùùyéláŋ</text></form></field>
    <sense id="fùùyɔ́ɔ́_1472_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine haute ; coiffe des initiées</text></gloss>
      <gloss lang="en"><text>high female hairstyle; headpiece of female initiates</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùyɔ́ɔ́</text></form></note>
  </entry>
  <entry id="fúwáléŋ_1473">
    <lexical-unit><form lang="kqs"><text>fúwáléŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fúwáléŋ_1473_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>savane arbustive, forêt claire</text></gloss>
      <gloss lang="en"><text>bushy savanna, open forest</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fúwáléŋ</text></form></note>
  </entry>
  <entry id="fûŋ_1474">
    <lexical-unit><form lang="kqs"><text>fûŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fûŋ_1474_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(puer) fortement</text></gloss>
      <gloss lang="en"><text>(stink) strongly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fûŋ</text></form></note>
  </entry>
  <entry id="fùŋgbàá_1475">
    <lexical-unit><form lang="kqs"><text>fùŋgbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fùŋgbàá_1475_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe, pagne de dessous</text></gloss>
      <gloss lang="en"><text>loincloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fùŋgbàá</text></form></note>
  </entry>
  <entry id="fúŋndó_1476">
    <lexical-unit><form lang="kqs"><text>fúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="fúŋndó_1476_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe de marais (séchée pour les matelas)</text></gloss>
      <gloss lang="en"><text>swamp grass (dried for mattresses)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fúŋndó</text></form></note>
  </entry>
  <entry id="fùɛ̀ìfùɛ̀ìyó_1477">
    <lexical-unit><form lang="kqs"><text>fùɛ̀ìfùɛ̀ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fùɛ̀ìfùɛ̀ìyó_1477_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cotisation spéciale (en cas d'urgence)</text></gloss>
      <gloss lang="en"><text>special contribution (for an emergency)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
      <trait name="semantic-domain-ddp4" value="4.2 Social activity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 110: fùɛ̀ìfùɛ̀ìyó</text></form></note>
    <note><form lang="fr"><text>Childs note que le mot est inconnu au nord.</text></form></note>
  </entry>
  <entry id="fúɛ̂ìyó_1478">
    <lexical-unit><form lang="kqs"><text>fúɛ̂ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fúɛ̂ìyó_1478_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>élection, vote</text></gloss>
      <gloss lang="en"><text>election, vote</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 110: fúɛ̂ìyó</text></form></note>
  </entry>
  <entry id="fùɛ̀ìyó_1479">
    <lexical-unit><form lang="kqs"><text>fùɛ̀ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fùɛ̀ìyó_1479_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>odeur de poisson cru ou de sueur</text></gloss>
      <gloss lang="en"><text>smell of raw fish or of sweat</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 110: fùɛ̀ìyó</text></form></note>
  </entry>
  <entry id="fuɲa-mamaa_1480">
    <lexical-unit><form lang="kqs"><text>fuɲa-mamaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>fuɲaa-mamaa</text></form></field>
    <sense id="fuɲa-mamaa_1480_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ancêtre, aïeul ; fondateur (d'une lignée, d'un peuple)</text></gloss>
      <gloss lang="en"><text>ancestor, forefather; founder (of a line, a people)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.17.4</text></form></note>
    <note><form lang="fr"><text>Composé de fuɲaa « père » et mamaa « grand-parent ».</text></form></note>
  </entry>
  <entry id="fuɲaa_1481">
    <lexical-unit><form lang="kqs"><text>fuɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fuɲa</text></form></variant>
    <sense id="fuɲaa_1481_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>père ; (pl.) ancêtres</text></gloss>
      <gloss lang="en"><text>father ; father; (pl.) forefathers</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>father; term of respect for a man</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 606 occurrences, first GEN.4.18; Keita 1979, p. 134: Finyaa; Paulme 1964, p. 26: fiŋa /descriptif/; Lexique kissi–français, p. 15: fiŋaa; Childs 2000, p. 106: fíɲàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Finyaa ; la Bible a toujours fuɲaa. Le Lexique kissi–français, p. 15, écrit deux fois fiŋaa « le père » (sans doute pour fuɲaa). Paulme 1964, p. 26 : fiŋa « père (véritable) » (fiŋa nɔm dolan « le nom de ton père » ; fiŋa Musa n se « père de Musa », vocatif). Rattachement à confirmer.</text></form></note>
  </entry>
  <entry id="fuɲanu_1482">
    <lexical-unit><form lang="kqs"><text>fuɲanu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fuɲanu_1482_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant</text></gloss>
      <gloss lang="en"><text>child</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 28: funyanu</text></form></note>
  </entry>
  <entry id="fɔ_1483">
    <lexical-unit><form lang="kqs"><text>fɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɔ_1483_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>il faut que, nécessairement ; (fɔ mì) jusqu'à ce que ; sauf</text></gloss>
      <gloss lang="en"><text>must, necessarily; (fɔ mì) until; except</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 376 occurrences, first GEN.2.6; Lexique kissi–français, p. 16: fɔ</text></form></note>
    <note><form lang="fr"><text>fɔ mì Po vanacieo sɔla heeloo « il faut que le Fils de l'homme soit élevé » (Jn 3,14) ; háá fɔ mì « jusqu'à ce que » (Ne 7,65). Sens confirmé par le Lexique kissi–français, p. 16 (fɔ « il faut que » ; fɔ ho « sauf »).</text></form></note>
  </entry>
  <entry id="fɔ́_1484">
    <lexical-unit><form lang="kqs"><text>fɔ́</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fɔ́_1484_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule finale exclamative (souhaits, plaintes)</text></gloss>
      <gloss lang="en"><text>sentence-final exclamative particle (wishes, complaints)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note><form lang="fr"><text>Màá Mɛlɛka cɔɔlu ya hɔ́ɔ́ piaandu celen fɔ́ ! « Que le Seigneur m'ajoute un autre fils ! »</text></form></note>
  </entry>
  <entry id="fɔ_1485">
    <lexical-unit><form lang="kqs"><text>fɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="fɔ_1485_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>d'abord</text></gloss>
      <gloss lang="en"><text>first, beforehand</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔ</text></form></note>
    <note><form lang="fr"><text>Paulme : fɔ « d'abord » ; fɔlɔ « premier » ; fɔlɔnde « jadis ». La Bible a souvent fɔ, dont le sens (« jusqu'à ce que » ?, GEN.3.19) est à comparer.</text></form></note>
  </entry>
  <entry id="fɔfɔ_1486">
    <lexical-unit><form lang="kqs"><text>fɔfɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔfɔ_1486_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>immédiatement, tout de suite</text></gloss>
      <gloss lang="en"><text>immediately, at once</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fɔfɔ; Sandara Kisia, fable 1: Fɔfɔ</text></form></note>
  </entry>
  <entry id="fɔfɔɔ_1487">
    <lexical-unit><form lang="kqs"><text>fɔfɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔfɔɔ_1487_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écorce (d'une orange) pressée</text></gloss>
      <gloss lang="en"><text>squeezed (orange) peel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fɔfɔɔ</text></form></note>
  </entry>
  <entry id="fɔ̀fɔ́ɔ́wó_1488">
    <lexical-unit><form lang="kqs"><text>fɔ̀fɔ́ɔ́wó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="fɔ̀fɔ́ɔ́wó_1488_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coque, enveloppe d'un fruit ; pulpe</text></gloss>
      <gloss lang="en"><text>hull or husk of a fruit; pulp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 109: fɔ̀fɔ́ɔ́wó</text></form></note>
  </entry>
  <entry id="fɔfɛ_1489">
    <lexical-unit><form lang="kqs"><text>fɔfɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>fɔfen</text></form></variant>
    <sense id="fɔfɛ_1489_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avouer, demander pardon (formule rituelle)</text></gloss>
      <gloss lang="en"><text>confess, ask forgiveness (ritual formula)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔfɛ, fɔfẽ</text></form></note>
    <note><form lang="fr"><text>Paulme : a fɔfẽ « il avoue, il demande pardon » ; se dit du parjure, du coupable s'adressant au kɔsɔa ; paroles dites par un tiers pendant que le sacrifiant officie.</text></form></note>
  </entry>
  <entry id="fɔ̀kpɔ́ɔ́_1490">
    <lexical-unit><form lang="kqs"><text>fɔ̀kpɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fɔ̀kpùá</text></form></field>
    <sense id="fɔ̀kpɔ́ɔ́_1490_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson blanc sans écailles à petite bouche</text></gloss>
      <gloss lang="en"><text>white scaleless fish with a small mouth</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 109: fɔ̀kpɔ́ɔ́</text></form></note>
  </entry>
  <entry id="fɔlae_1491">
    <lexical-unit><form lang="kqs"><text>fɔlae</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔlae_1491_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>(yambɛ n fɔlae) variété de manioc</text></gloss>
      <gloss lang="en"><text>(yambɛ n fɔlae) variety of cassava</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔlae</text></form></note>
  </entry>
  <entry id="fɔlanda_1492">
    <lexical-unit><form lang="kqs"><text>fɔlanda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔlanda_1492_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>ancien, de jadis</text></gloss>
      <gloss lang="en"><text>old, of former times</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔlanda</text></form></note>
    <note><form lang="fr"><text>Paulme : bimba fɔlanda « les vieux de jadis, les ancêtres ».</text></form></note>
  </entry>
  <entry id="fɔlɔn_1493">
    <lexical-unit><form lang="kqs"><text>fɔlɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fɔlɔn_1493_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>d'abord, auparavant ; au début, autrefois</text></gloss>
      <gloss lang="en"><text>first, beforehand; at the beginning, formerly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>first</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 133 occurrences, first GEN.24.33; Lexique kissi–français, p. 16: fɔlɔnndo; Childs 2000, p. 109: fɔ́lɔ́ŋndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 16 : fɔlɔnndo « premier ; d'abord, au début ; autrefois ».</text></form></note>
  </entry>
  <entry id="fɔlɔnndo_1494">
    <lexical-unit><form lang="kqs"><text>fɔlɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔlɔnndo_1494_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>(o fɔlɔnndo) premier, primitif</text></gloss>
      <gloss lang="en"><text>(o fɔlɔnndo) first, original</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔlɔ; Lexique kissi–français, p. 40: o fɔlɔnndo</text></form></note>
    <note><form lang="fr"><text>Comparer fɔlɔn « d'abord » (Bible). Paulme 1964, p. 27 : fɔlɔ « premier » (du fɔlɔ ntiya a nɔm ni « il est arrivé avant toi ») ; fɔlɔnde « jadis ».</text></form></note>
  </entry>
  <entry id="fɔlɔɔ_1495">
    <lexical-unit><form lang="kqs"><text>fɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔlɔɔ_1495_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de mouche</text></gloss>
      <gloss lang="en"><text>kind of fly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fɔlɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit aussi fɔrɔɔ.</text></form></note>
  </entry>
  <entry id="fɔmo_1496">
    <lexical-unit><form lang="kqs"><text>fɔmo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔmo_1496_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste ressemblant au taro</text></gloss>
      <gloss lang="en"><text>shrub resembling taro</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔmo</text></form></note>
    <note><form lang="fr"><text>Paulme : c'est sur des feuilles de fɔmo (pyi fɔmoy) que le kuino nettoie son sambiyo à l'huile de palme.</text></form></note>
  </entry>
  <entry id="fɔn_1497">
    <lexical-unit><form lang="kqs"><text>fɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔn_1497_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>bien</text></gloss>
      <gloss lang="en"><text>well</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fɔn</text></form></note>
  </entry>
  <entry id="fɔndo_1498">
    <lexical-unit><form lang="kqs"><text>fɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔndo_1498_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poumons</text></gloss>
      <gloss lang="en"><text>lungs</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔndo</text></form></note>
    <note><form lang="fr"><text>Paulme : fɔnde « morceau de poumon », donné aux charognards lors des sacrifices. Cf. fɔyɔnnde « poumon » (Keita 1979).</text></form></note>
  </entry>
  <entry id="fɔngɔfɔngɔɔ_1499">
    <lexical-unit><form lang="kqs"><text>fɔngɔfɔngɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔngɔfɔngɔɔ_1499_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau à corne (calao ?)</text></gloss>
      <gloss lang="en"><text>horned bird (hornbill?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: fɔngɔfɔngɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique : « un oiseau avec une corne ».</text></form></note>
  </entry>
  <entry id="fɔ̀nɔ̀ɔ́_1500">
    <lexical-unit><form lang="kqs"><text>fɔ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɔ̀nɔ̀</text></form></variant>
    <sense id="fɔ̀nɔ̀ɔ́_1500_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>défunt, feu (personne décédée)</text></gloss>
      <gloss lang="en"><text>late, deceased</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deceased person, the late; a corpse</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.4.5; Paulme 1964, p. 28: fuino, pl. fɔya; Childs 2000, p. 109: fɔ̀nɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lanɔɔ fɔ̀nɔ̀ Nabal « la veuve de Nabal » (1 S 27,3). Paulme 1964, p. 28 : fuino, pl. fɔya « mort (qui est au tye pɔm) ». Rattachement à confirmer.</text></form></note>
  </entry>
  <entry id="fɔsɔnden_1501">
    <lexical-unit><form lang="kqs"><text>fɔsɔnden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fɔsɔnden_1501_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cordes (d'instrument de musique, en peau d'antilope)</text></gloss>
      <gloss lang="en"><text>strings (of a musical instrument, of antelope hide)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 27: fɔsɔndẽ, fɔsɔnde /toujours au pluriel/</text></form></note>
    <note><form lang="fr"><text>Paulme : toujours au pluriel ; cordes du bolindo et de tout instrument (tambour, tɔa…).</text></form></note>
  </entry>
  <entry id="fɔyɔnnde_1502">
    <lexical-unit><form lang="kqs"><text>fɔyɔnnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="fɔyɔnnde_1502_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poumon</text></gloss>
      <gloss lang="en"><text>lung</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Föyönnde; Lexique kissi–français, p. 16: fɔyɔnnde</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 16 : aussi fɔɔnde « le poumon », pl. fɔɔndon.</text></form></note>
  </entry>
  <entry id="fɔ́yɔ́ŋndó_1503">
    <lexical-unit><form lang="kqs"><text>fɔ́yɔ́ŋndó</text></form></lexical-unit>
