    <sense id="ciŋun kamaa_223_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ivoire</text></gloss>
      <gloss lang="en"><text>ivory</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyinhii kamaa</text></form></note>
    <note><form lang="fr"><text>Litt. « dents d'éléphant ». Keita a le singulier (ciŋii kamaa) ; la Bible le pluriel ciŋun kamaa.</text></form></note>
  </entry>
  <entry id="ciɛi_224">
    <lexical-unit><form lang="kqs"><text>ciɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ciɛɔn</text></form></field>
    <sense id="ciɛi_224_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champ, terre cultivée</text></gloss>
      <gloss lang="en"><text>field, farmland</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>farm, orchard, rice paddy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.4.3; Childs 2000, p. 43: cìèí</text></form></note>
  </entry>
  <entry id="ciɛi_225">
    <lexical-unit><form lang="kqs"><text>ciɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciɛi_225_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>hier</text></gloss>
      <gloss lang="en"><text>yesterday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.4.3; Keita 1979, p. 152: Tyièi; Childs 2000, p. 43: cíɛ́í</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi ciɛi dii « hier matin » et ciɛi cɔl « hier soir ». Homonyme de ciɛi « champ ».</text></form></note>
  </entry>
  <entry id="co_226">
    <lexical-unit><form lang="kqs"><text>co</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="co_226_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être ; auxiliaire du progressif</text></gloss>
      <gloss lang="en"><text>be; progressive auxiliary</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also future auxiliary</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18903 occurrences, first GEN.1.7; Childs 2000, p. 50: cò</text></form></note>
  </entry>
  <entry id="cobe_227">
    <lexical-unit><form lang="kqs"><text>cobe</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cobe_227_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(o lo cɔɔlu cobe) presque, peu s'en faut ; sur le point de</text></gloss>
      <gloss lang="en"><text>(o lo cɔɔlu cobe) almost, nearly; about to</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.26.10</text></form></note>
  </entry>
  <entry id="cokaacoo_228">
    <lexical-unit><form lang="kqs"><text>cokaacoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cokaacoo_228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crapaud</text></gloss>
      <gloss lang="en"><text>toad</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>toad, frog</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyokaatyoo; Childs 2000, p. 51: còkáácòó</text></form></note>
  </entry>
  <entry id="condei_229">
    <lexical-unit><form lang="kqs"><text>condei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>condon</text></form></field>
    <variant><form lang="kqs"><text>condii</text></form></variant>
    <variant><form lang="kqs"><text>condun</text></form></variant>
    <sense id="condei_229_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chant, cantique</text></gloss>
      <gloss lang="en"><text>song</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first EXO.15; Childs 2000, p. 51: còndúŋ</text></form></note>
  </entry>
  <entry id="congoo_230">
    <lexical-unit><form lang="kqs"><text>congoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>congulan</text></form></field>
    <variant><form lang="kqs"><text>congú</text></form></variant>
    <sense id="congoo_230_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épaule</text></gloss>
      <gloss lang="en"><text>shoulder</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shoulder, upper arm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.49.15; Keita 1979, p. 132: Tyonguo; Childs 2000, p. 52: còŋgóó</text></form></note>
    <note><form lang="fr"><text>o congú « sur l'épaule » (Gn 21,14).</text></form></note>
  </entry>
  <entry id="congɔnndo_231">
    <lexical-unit><form lang="kqs"><text>congɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congɔnndo_231_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre congé (de), dire adieu ; envoyer un message</text></gloss>
      <gloss lang="en"><text>take leave (of), bid farewell; send a message</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, backbite; send a message; bid farewell, wave goodbye; bet, gamble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.28.6; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>le X congɔnndo « pour prendre congé de X » ; David yɔngu congɔnndo « David envoya un message » (2 S 11,6). Réciproque congan « se dire adieu » (Ac 21,6), « médire les uns des autres » (Jc 4,11).</text></form></note>
  </entry>
  <entry id="connun_232">
    <lexical-unit><form lang="kqs"><text>connun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="connun_232_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se porter bien ; être en repos</text></gloss>
      <gloss lang="en"><text>be well; be at rest</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.43.28</text></form></note>
  </entry>
  <entry id="coo_233">
    <lexical-unit><form lang="kqs"><text>coo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coo_233_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sur (o … coo)</text></gloss>
      <gloss lang="en"><text>on (o … coo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7185 occurrences, first GEN.1.2; Childs 2000, p. 53: còó</text></form></note>
  </entry>
  <entry id="coocoo_234">
    <lexical-unit><form lang="kqs"><text>coocoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coocoo_234_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en haut, au-dessus, dans les airs</text></gloss>
      <gloss lang="en"><text>up, above, in the air</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>far up; also loudly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 313 occurrences, first GEN.1.20; Childs 2000, p. 53: cóó-cóó</text></form></note>
  </entry>
  <entry id="còòlan_235">
    <lexical-unit><form lang="kqs"><text>còòlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="còòlan_235_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mensonge(s)</text></gloss>
      <gloss lang="en"><text>lies, falsehood</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 108 occurrences, first GEN.42.12; Childs 2000, p. 53: còòláŋ</text></form></note>
  </entry>
  <entry id="cowvo_236">
    <lexical-unit><form lang="kqs"><text>cowvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cowvo_236_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat palmiste</text></gloss>
      <gloss lang="en"><text>ground squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large rat; opossum (Liberian English)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyowvo; Childs 2000, p. 54: còúwó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, cowvo est un homonyme sans rapport (1SA.8.12, EXO.20.25).</text></form></note>
  </entry>
  <entry id="coŋ_237">
    <lexical-unit><form lang="kqs"><text>coŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>coŋnin</text></form></variant>
    <sense id="coŋ_237_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se répandre, envahir, couvrir ; déborder</text></gloss>
      <gloss lang="en"><text>spread over, swarm, cover; overflow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, overflow; throw away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.8.2; Childs 2000, p. 52: còŋndó</text></form></note>
  </entry>
  <entry id="cua_238">
    <lexical-unit><form lang="kqs"><text>cua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuaa</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <sense id="cua_238_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre ; (cua haki) commettre (un péché)</text></gloss>
      <gloss lang="en"><text>take; (cua haki) commit (a sin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take; also carry, lift; take in marriage</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1496 occurrences, first GEN.2.15; Childs 2000, p. 60: cùàá</text></form></note>
  </entry>
  <entry id="cua mamaa_239">
    <lexical-unit><form lang="kqs"><text>cua mamaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cua mamaa_239_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit-fils, petite-fille</text></gloss>
      <gloss lang="en"><text>grandchild</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Tyua mamaa; Childs 2000, p. 60: cùàà-màmàá</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs (cùàà-màmàá). Dans la Bible, mamaa désigne l'aïeul (Gn 28,13) et cuavaa-imamaa « les descendants ». Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="cuaa_240">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuavaa</text></form></field>
    <variant><form lang="kqs"><text>cuawva</text></form></variant>
    <sense id="cuaa_240_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant ; la femme (dont on parle) ; (pl.) enfants, descendants</text></gloss>
      <gloss lang="en"><text>child; the woman (in question); (pl.) children, descendants</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl, daughter, young woman, woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 270 occurrences, first GEN.3.13; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>Au singulier, la Bible emploie cuaa surtout pour « la femme » dont il est question (Gn 3,13 ; 1 S 1,26 ; 2 R 8,6) ; le pluriel cuavaa / cuawva signifie « enfants, descendants ». À vérifier auprès de locuteurs.</text></form></note>
  </entry>
  <entry id="cuaa_241">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cua</text></form></variant>
    <variant><form lang="kqs"><text>cue</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <variant><form lang="kqs"><text>cuenin</text></form></variant>
    <sense id="cuaa_241_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre</text></gloss>
      <gloss lang="en"><text>take</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take, carry or lift</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Tyuaa; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>cua est très courant (GEN 2,15) ; cue, cuenin : radical négatif. La forme longue cuaa de la Bible a surtout d'autres sens (« femme », GEN 3,13).</text></form></note>
  </entry>
  <entry id="cuaambɔyɛi_242">
    <lexical-unit><form lang="kqs"><text>cuaambɔyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="cuaambɔyɛi_242_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunesse</text></gloss>
      <gloss lang="en"><text>youth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.46.34</text></form></note>
  </entry>
  <entry id="cuaambɔɔ_243">
    <lexical-unit><form lang="kqs"><text>cuaambɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuaambɔa</text></form></field>
    <variant><form lang="kqs"><text>cuaambɔ</text></form></variant>
    <sense id="cuaambɔɔ_243_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune fille, fille ; jeune (personne) ; jeune (garçon ou fille), jeune fille</text></gloss>
      <gloss lang="en"><text>girl, young woman; young person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.16.5; Keita 1979, p. 148: Tyuaamböö; Childs 2000, p. 61: cùààmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « l'enfant » ; dans la Bible, surtout « jeune fille » (Rébecca, Gn 24,18), opposé à kaasonɔɔ « adulte ».</text></form></note>
  </entry>
  <entry id="cucɔɔ_244">
    <lexical-unit><form lang="kqs"><text>cucɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cucu</text></form></variant>
    <variant><form lang="kqs"><text>cucunin</text></form></variant>
    <sense id="cucɔɔ_244_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répandre, faire tomber (en pluie, en rosée) ; saupoudrer (l'encens)</text></gloss>
      <gloss lang="en"><text>pour down, drop (like rain, dew); sprinkle (incense)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.7.27</text></form></note>
  </entry>
  <entry id="cuei_245">
    <lexical-unit><form lang="kqs"><text>cuei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cueon</text></form></field>
    <sense id="cuei_245_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hache</text></gloss>
      <gloss lang="en"><text>axe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first DEU.19.5; Keita 1979, p. 160: Tyuei; Childs 2000, p. 61: cùèí</text></form></note>
  </entry>
  <entry id="cuello_246">
    <lexical-unit><form lang="kqs"><text>cuello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuel</text></form></variant>
    <sense id="cuello_246_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre pour quelqu'un</text></gloss>
      <gloss lang="en"><text>take for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1SA.14.6; Keita 1979, p. 114: Tyuello</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de cuaa (radical cue) : cuel lanɔɔ « prendre une femme pour » (GEN 24,4).</text></form></note>
  </entry>
  <entry id="cuinndo_247">
    <lexical-unit><form lang="kqs"><text>cuinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuinnda</text></form></field>
    <variant><form lang="kqs"><text>cuin</text></form></variant>
    <variant><form lang="kqs"><text>cuinaa</text></form></variant>
    <sense id="cuinndo_247_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chèvre</text></gloss>
      <gloss lang="en"><text>goat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.21.14; Keita 1979, p. 137: Tyuinndo; Childs 2000, p. 63: cùìŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible a aussi le pluriel cuinaa.</text></form></note>
  </entry>
  <entry id="cuinun_248">
    <lexical-unit><form lang="kqs"><text>cuinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuinun_248_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se briser, voler en éclats</text></gloss>
      <gloss lang="en"><text>break, shatter (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.32.19</text></form></note>
  </entry>
  <entry id="cuiŋi_249">
    <lexical-unit><form lang="kqs"><text>cuiŋi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuiŋi_249_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (un liquide)</text></gloss>
      <gloss lang="en"><text>pour out (a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, pour away; waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.35.14; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cukanioo_250">
    <lexical-unit><form lang="kqs"><text>cukanioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cukani</text></form></variant>
    <sense id="cukanioo_250_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuillère</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Tyukanioo</text></form></note>
    <note><form lang="fr"><text>La Bible a cukanila n'ciŋndan « fourchettes » (Ex 27,3), avec la forme radicale du pluriel.</text></form></note>
  </entry>
  <entry id="cukɔnndo_251">
    <lexical-unit><form lang="kqs"><text>cukɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cukɔnndo_251_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se piquer</text></gloss>
      <gloss lang="en"><text>prick oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Tyukönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de cukɔɔ.</text></form></note>
  </entry>
  <entry id="cukɔɔ_252">
    <lexical-unit><form lang="kqs"><text>cukɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuku</text></form></variant>
    <sense id="cukɔɔ_252_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer, transpercer</text></gloss>
      <gloss lang="en"><text>prick, pierce</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>prick (as a thorn)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.19.10; Keita 1979, p. 114: Tyuköö; Childs 2000, p. 63: cùkàá</text></form></note>
  </entry>
  <entry id="cumndo_253">
    <lexical-unit><form lang="kqs"><text>cumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cum</text></form></variant>
    <sense id="cumndo_253_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attendre ; laisser (faire)</text></gloss>
      <gloss lang="en"><text>wait; let, allow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 91 occurrences, first EXO.5.20; Childs 2000, p. 65: cùmndó</text></form></note>
  </entry>
  <entry id="cumullo_254">
    <lexical-unit><form lang="kqs"><text>cumullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cumul</text></form></variant>
    <sense id="cumullo_254_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller</text></gloss>
      <gloss lang="en"><text>guard, watch over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>watch something secretly, peep, spy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.3.24; Childs 2000, p. 66: cùmùlló</text></form></note>
  </entry>
  <entry id="cun_255">
    <lexical-unit><form lang="kqs"><text>cun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cun_255_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>odeur ; (cun kɛndɛ) parfum</text></gloss>
      <gloss lang="en"><text>smell; (cun kɛndɛ) fragrance</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smelly; smell of, stink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 189 occurrences, first GEN.8.21; Childs 2000, p. 66: cùnéí-</text></form></note>
  </entry>
  <entry id="cundoo_256">
    <lexical-unit><form lang="kqs"><text>cundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cundu</text></form></variant>
    <sense id="cundoo_256_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poussière</text></gloss>
      <gloss lang="en"><text>dust</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first GEN.3.14; Keita 1979, p. 155: Tyunduo; Childs 2000, p. 66: cúndóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tyunduo ; la Bible cundoo.</text></form></note>
  </entry>
  <entry id="cúo_257">
    <lexical-unit><form lang="kqs"><text>cúo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cu</text></form></variant>
    <sense id="cúo_257_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler, moudre (au mortier)</text></gloss>
      <gloss lang="en"><text>pound, grind (in a mortar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.24.41</text></form></note>
  </entry>
  <entry id="cuuloo_258">
    <lexical-unit><form lang="kqs"><text>cuuloo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cuulu</text></form></variant>
    <variant><form lang="kqs"><text>cuulunin</text></form></variant>
    <sense id="cuuloo_258_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter en épi, pousser ; être consumé, dépérir</text></gloss>
      <gloss lang="en"><text>come into ear, sprout; be consumed, waste away</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tiller, produce grain (rice); also be slimy, slippery</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùùlòó</text></form></note>
    <note><form lang="fr"><text>Deux emplois : épis (Gn 41,5-6 ; Ex 9,31) et « consumer » (yinnden … cuulu mungén, Ps 106,18 ; paalan la cuulu ya « mes os se consument », Ps 31,11).</text></form></note>
  </entry>
  <entry id="cuungiaa_259">
    <lexical-unit><form lang="kqs"><text>cuungiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuungiaanin</text></form></variant>
    <sense id="cuungiaa_259_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, réunir</text></gloss>
      <gloss lang="en"><text>gather, assemble</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, collect; also contribute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 175 occurrences, first GEN.9.14; Childs 2000, p. 68: cùùŋgìá</text></form></note>
  </entry>
  <entry id="cuungian_260">
    <lexical-unit><form lang="kqs"><text>cuungian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuungian_260_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rassembler, se réunir</text></gloss>
      <gloss lang="en"><text>gather, come together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 147 occurrences, first GEN.14.8</text></form></note>
    <note><form lang="fr"><text>Moyen de cuungiaa « rassembler ».</text></form></note>
  </entry>
  <entry id="cuuo_261">
    <lexical-unit><form lang="kqs"><text>cuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuu</text></form></variant>
    <variant><form lang="kqs"><text>cuunin</text></form></variant>
    <sense id="cuuo_261_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, amener</text></gloss>
      <gloss lang="en"><text>bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring; give someone a present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.27.5; Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cuuŋuuo_262">
    <lexical-unit><form lang="kqs"><text>cuuŋuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuuŋuu</text></form></variant>
    <variant><form lang="kqs"><text>cuuŋuunin</text></form></variant>
    <sense id="cuuŋuuo_262_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (sang, eau)</text></gloss>
      <gloss lang="en"><text>pour out (blood, water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, throw (a liquid) away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2KI.3.11; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cuvɔɔ_263">
    <lexical-unit><form lang="kqs"><text>cuvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuvɔɔ_263_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, s'achever ; fin ; (X cuvɔɔ) après X</text></gloss>
      <gloss lang="en"><text>finish, come to an end; end; (X cuvɔɔ) after X</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.6.7 End, point"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be finished, used up; auxiliary of completion</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.22.19; Childs 2000, p. 69: cùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Biisi Yosue-o cuvɔɔ « après la mort de Josué » (Jg 1,1) ; niaa co cuvɔɔ vu « vous finirez par mourir » (Nb 14,32).</text></form></note>
  </entry>
  <entry id="cuɛi-cuɛi_264">
    <lexical-unit><form lang="kqs"><text>cuɛi-cuɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuɛi-cuɛi_264_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>souvent, régulièrement</text></gloss>
      <gloss lang="en"><text>often, regularly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.3.1</text></form></note>
  </entry>
  <entry id="cuɛinanndo_265">
    <lexical-unit><form lang="kqs"><text>cuɛinanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuɛinanndan</text></form></field>
    <variant><form lang="kqs"><text>cuɛinan</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinannda</text></form></variant>
    <sense id="cuɛinanndo_265_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vêtement (ɲɛ cuɛinanndo) ; (volɔɔla cuɛinanndan) habits</text></gloss>
      <gloss lang="en"><text>clothing, garment (ɲɛ cuɛinanndo); (volɔɔla cuɛinanndan) clothes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.28.20</text></form></note>
    <note><form lang="fr"><text>De cuɛinun « se vêtir » ; souvent en apposition : volɔɔ cuɛinanndo « vêtement », ɲɛ cuɛinan « vêtement ».</text></form></note>
  </entry>
  <entry id="cuɛinɔnndo_266">
    <lexical-unit><form lang="kqs"><text>cuɛinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛinun</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinɔn</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinunnin</text></form></variant>
    <sense id="cuɛinɔnndo_266_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'habiller, se vêtir, mettre (un vêtement)</text></gloss>
      <gloss lang="en"><text>dress, put on (clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.8.4; Childs 2000, p. 62: cùènɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="cuɛiyan_267">
    <lexical-unit><form lang="kqs"><text>cuɛiyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛima</text></form></variant>
    <sense id="cuɛiyan_267_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>graisse ; huile ; pommade ; graisse, beurre</text></gloss>
      <gloss lang="en"><text>fat; oil ; oil; ointment ; oil; fat, butter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>oil, palm oil, ointment</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 132 occurrences, first GEN.28.18; Keita 1979, p. 133: Tyuèyan; Childs 2000, p. 62: cùɛ̀ìyáŋ</text></form></note>
  </entry>
  <entry id="cɔcɔn_268">
    <lexical-unit><form lang="kqs"><text>cɔcɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔcɔn_268_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèvres ; bord</text></gloss>
      <gloss lang="en"><text>lips; rim, edge</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 55 occurrences, first EXO.25.11</text></form></note>
  </entry>
  <entry id="cɔcɔɛi_269">
    <lexical-unit><form lang="kqs"><text>cɔcɔɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɔcɔn</text></form></field>
    <sense id="cɔcɔɛi_269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèvre ; bord, ourlet ; bec</text></gloss>
      <gloss lang="en"><text>lip; edge, hem ; beak; edge, hem</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lip; beak, bill (also of a cap)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.28.33; Keita 1979, p. 132: Työtyöèi; Childs 2000, p. 55: cɔ̀cùɛ̀í</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, aussi le bord ou l'ourlet d'un vêtement (EXO.28.33).</text></form></note>
  </entry>
  <entry id="cɔloo_270">
    <lexical-unit><form lang="kqs"><text>cɔloo</text></form></lexical-unit>
