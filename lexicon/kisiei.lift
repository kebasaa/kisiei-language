  <entry id="hunɔɔ_557">
    <lexical-unit><form lang="kqs"><text>hunɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hun</text></form></variant>
    <variant><form lang="kqs"><text>hunnin</text></form></variant>
    <variant><form lang="kqs"><text>hin</text></form></variant>
    <variant><form lang="kqs"><text>hinnin</text></form></variant>
    <sense id="hunɔɔ_557_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir ; (hun a) apporter, amener</text></gloss>
      <gloss lang="en"><text>come ; come; (hun a) bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>come, arrive</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 768 occurrences, first GEN.6.17; Keita 1979, p. 114: Hunöö; Childs 2000, p. 136: hùnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>hin, hinnin : radical négatif. co hunɔɔ + verbe : « être sur le point de ».</text></form></note>
  </entry>
  <entry id="huuluo_558">
    <lexical-unit><form lang="kqs"><text>huuluo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>huulu</text></form></variant>
    <variant><form lang="kqs"><text>huulunin</text></form></variant>
    <sense id="huuluo_558_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sauter, bondir</text></gloss>
      <gloss lang="en"><text>jump, leap</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>jump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.68.4; Keita 1979, p. 110: Huuluö; Childs 2000, p. 137: hùùlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit huuluö ; la Bible écrit huuluo. Pluriel huuluu « sauter, franchir, transgresser » (PSA 114,4 ; NUM 22,18).</text></form></note>
  </entry>
  <entry id="huŋndo_559">
    <lexical-unit><form lang="kqs"><text>huŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>huŋndan</text></form></field>
    <sense id="huŋndo_559_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-fond, marécage</text></gloss>
      <gloss lang="en"><text>lowland, swamp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swamp where swamp rice is grown</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Hunndo; Childs 2000, p. 137: hùŋndó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Hunndo ; le pluriel huŋndan (Jb 40,21) et Childs ont ŋ.</text></form></note>
  </entry>
  <entry id="hɔlaa_560">
    <lexical-unit><form lang="kqs"><text>hɔlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hɔl</text></form></variant>
    <sense id="hɔlaa_560_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>visage, face ; (o … hɔl) devant, en présence de</text></gloss>
      <gloss lang="en"><text>face; (o … hɔl) before, in the presence of</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="8.6.1 Front"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>face; also sky</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 130 occurrences, first GEN.32.31; Childs 2000, p. 132: hɔ̀llá</text></form></note>
  </entry>
  <entry id="hɔlaa piɔ́mndo_561">
    <lexical-unit><form lang="kqs"><text>hɔlaa piɔ́mndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hɔlaa piɔ́mndo_561_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque</text></gloss>
      <gloss lang="en"><text>mask</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Hölaa Piömndo</text></form></note>
    <note><form lang="fr"><text>Composé non attesté tel quel : hɔlaa « visage », piɔ́mndo « image, idole ». Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
