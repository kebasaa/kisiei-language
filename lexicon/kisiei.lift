      <gloss lang="en"><text>immediately, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spot, place; on the spot, right away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 139 occurrences, first JOS.6.20; Childs 2000, p. 108: fòòfóó</text></form></note>
  </entry>
  <entry id="fɛfɛlaa_470">
    <lexical-unit><form lang="kqs"><text>fɛfɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fɛfɛla</text></form></variant>
    <sense id="fɛfɛlaa_470_s1">
      <grammatical-info value="Verb"/>
