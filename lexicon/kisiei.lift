    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>fulan</text></form></field>
    <variant><form lang="kqs"><text>fuo</text></form></variant>
    <sense id="fulen_1438_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fleur</text></gloss>
      <gloss lang="en"><text>flower</text></gloss>
