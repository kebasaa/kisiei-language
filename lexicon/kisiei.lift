  <entry id="koŋndo_2294">
    <lexical-unit><form lang="kqs"><text>koŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>koŋndan</text></form></field>
    <variant><form lang="kqs"><text>koŋnda</text></form></variant>
    <variant><form lang="kqs"><text>koŋ</text></form></variant>
    <sense id="koŋndo_2294_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte, battant de porte</text></gloss>
      <gloss lang="en"><text>door, door leaf</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.12.22; Paulme 1964, p. 52: kundo, kɔndo; Lexique kissi–français, p. 26: konndo; Childs 2000, p. 177: kôŋndó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 52 : kundo, kɔndo « porte » ; puri kundo « serrure ».</text></form></note>
  </entry>
  <entry id="koŋullo_2295">
    <lexical-unit><form lang="kqs"><text>koŋullo</text></form></lexical-unit>
