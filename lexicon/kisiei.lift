      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 328: sɛ̀sɛ́ŋgòlló</text></form></note>
  </entry>
  <entry id="sɛtio_3836">
    <lexical-unit><form lang="kqs"><text>sɛtio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="sɛtio_3836_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assiette, plat</text></gloss>
      <gloss lang="en"><text>plate, dish</text></gloss>
