    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.3.3; Childs 2000, p. 300: pìlăŋndó</text></form></note>
  </entry>
  <entry id="pìlàpílâ_2602">
    <lexical-unit><form lang="kqs"><text>pìlàpílâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìlàpílâ_2602_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout de suite, immédiatement</text></gloss>
      <gloss lang="en"><text>right away, at once</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 300: pìlàpílâ</text></form></note>
  </entry>
  <entry id="pìlàŋndéŋ_2603">
    <lexical-unit><form lang="kqs"><text>pìlàŋndéŋ</text></form></lexical-unit>
