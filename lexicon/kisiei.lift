      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>farm kitchen, thatched hut at the farm (also for sleeping); the rice farm itself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.1.8; Childs 2000, p. 289: pàŋáá</text></form></note>
