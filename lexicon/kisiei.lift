      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper, tailler (herbe, cheveux), raser</text></gloss>
      <gloss lang="en"><text>cut, trim (grass, hair), shave</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 159: kèlàá</text></form></note>
  </entry>
  <entry id="kelacaa_2035">
