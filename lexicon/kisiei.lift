    <trait name="status" value="attested"/>
    <sense id="seo_4498_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moyens, ressources ; moyen</text></gloss>
      <gloss lang="en"><text>means, resources; means</text></gloss>
