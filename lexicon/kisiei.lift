  <entry id="kialaa_1571">
    <lexical-unit><form lang="kqs"><text>kialaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kialu</text></form></variant>
    <variant><form lang="kqs"><text>kialunin</text></form></variant>
    <sense id="kialaa_1571_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>juger ; (kialu yamɛi) rendre la justice</text></gloss>
      <gloss lang="en"><text>judge; (kialu yamɛi) give judgement</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 180 occurrences, first GEN.49.16</text></form></note>
  </entry>
  <entry id="kiallo_1572">
    <lexical-unit><form lang="kqs"><text>kiallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kialla</text></form></field>
    <variant><form lang="kqs"><text>kial</text></form></variant>
    <sense id="kiallo_1572_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gazelle, biche ; (kial piaandoo) cerf</text></gloss>
      <gloss lang="en"><text>gazelle, hind; (kial piaandoo) deer, hart</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bushbuck, harnessed antelope</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.14.5; Lexique kissi–français, p. 8: callo; Childs 2000, p. 162: kìálló</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit callo « le cerf ; biche » (p. 8) (cf. Paulme tyɛyo / kyɛyo « maison »).</text></form></note>
  </entry>
  <entry id="kibaro_1573">
    <lexical-unit><form lang="kqs"><text>kibaro</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kibaro_1573_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nouvelle</text></gloss>
      <gloss lang="en"><text>news</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 24: kibaro</text></form></note>
    <note><form lang="fr"><text>Emprunt (malinké kibaro).</text></form></note>
  </entry>
  <entry id="kííbɔ̀ŋíìyó_1574">
    <lexical-unit><form lang="kqs"><text>kííbɔ̀ŋíìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kííbɔ̀ŋíìyó_1574_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tomate</text></gloss>
      <gloss lang="en"><text>tomato</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 163: kííbɔ̀ŋíìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au mandé (bandi, mendé).</text></form></note>
  </entry>
  <entry id="kiila Hala_1575">
    <lexical-unit><form lang="kqs"><text>kiila Hala</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kiila Hala_1575_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prophète</text></gloss>
      <gloss lang="en"><text>prophet</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 24: kiila Hala</text></form></note>
    <note><form lang="fr"><text>Lexique : kiila Hala « le Prophète » (littéralement « envoyé de Dieu »).</text></form></note>
  </entry>
  <entry id="kiilanɔ_1576">
    <lexical-unit><form lang="kqs"><text>kiilanɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kiilaa</text></form></field>
    <variant><form lang="kqs"><text>kiila</text></form></variant>
    <sense id="kiilanɔ_1576_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>messager, envoyé ; apôtre</text></gloss>
      <gloss lang="en"><text>messenger, envoy; apostle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first 2SA.11.22; Lexique kissi–français, p. 24: kiilaa</text></form></note>
  </entry>
  <entry id="kiilanɔɔ_1577">
    <lexical-unit><form lang="kqs"><text>kiilanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiilanɔ</text></form></variant>
    <sense id="kiilanɔɔ_1577_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>messager</text></gloss>
      <gloss lang="en"><text>messenger</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.50.16; Keita 1979, p. 148: Kiilanöö</text></form></note>
  </entry>
  <entry id="kiindiaa_1578">
    <lexical-unit><form lang="kqs"><text>kiindiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiindian</text></form></variant>
    <sense id="kiindiaa_1578_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer (plusieurs portes) ; (kiindian) s'enfermer</text></gloss>
      <gloss lang="en"><text>shut, close (several doors); (kiindian) shut oneself in</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>close (plural action of 'close')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.3.23; Childs 2000, p. 163: kììndíá</text></form></note>
    <note><form lang="fr"><text>Mí Ehud kiindiaa diolan kpow « Ehud ferma toutes les portes » (JDG.3.23) ; Má kiindian diolan kɔɔli « ils fermèrent les portes derrière eux » (JDG.9.51). Pluriel verbal de kinda « fermer ».</text></form></note>
  </entry>
  <entry id="kiinkiindo_1579">
    <lexical-unit><form lang="kqs"><text>kiinkiindo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kiinkiindo_1579_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouche maçonne ; guêpe</text></gloss>
      <gloss lang="en"><text>mason wasp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Kiinkiindo; Lexique kissi–français, p. 24: kiinkiindo; Childs 2000, p. 163: kìŋkííŋndó</text></form></note>
  </entry>
  <entry id="kiisanndo_1580">
    <lexical-unit><form lang="kqs"><text>kiisanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiisan</text></form></variant>
    <sense id="kiisanndo_1580_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>hésiter, tarder, se retenir</text></gloss>
      <gloss lang="en"><text>hesitate, hold back</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.19.16</text></form></note>
  </entry>
  <entry id="kiisuu_1581">
    <lexical-unit><form lang="kqs"><text>kiisuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kiisuu_1581_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allumer (le feu) ; allumer (une lampe)</text></gloss>
      <gloss lang="en"><text>kindle (a fire); light (a lamp)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>kindle, start a fire; restart an argument</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.20.26; Lexique kissi–français, p. 24: kiisɔɔ/ kiisu; Childs 2000, p. 164: kììsùùwó</text></form></note>
    <note><form lang="fr"><text>la kue lɛnin yinnden kiisuu o fonda-loamaa-lasálà nuu coo fondo fúú le « vous n'allumerez plus en vain le feu sur mon autel » (MAL.1.10) ; yinnde vana kíísúú le len « un feu qu'on n'a pas allumé » (JOB.20.26). Lexique kissi–français, p. 24 : kiisɔɔ/kiisu « allumer le feu ou une lampe ».</text></form></note>
  </entry>
  <entry id="kiiye_1582">
    <lexical-unit><form lang="kqs"><text>kiiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kii</text></form></variant>
    <sense id="kiiye_1582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clef</text></gloss>
      <gloss lang="en"><text>key</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Kiiye; Lexique kissi–français, p. 24: kiiye; Childs 2000, p. 164: kîyé</text></form></note>
    <note><form lang="fr"><text>Forme radicale kii dans la Bible (Jg 3,25 ; Is 22,22). Emprunt à l'anglais key selon Childs.</text></form></note>
  </entry>
  <entry id="kììyo_1583">
    <lexical-unit><form lang="kqs"><text>kììyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kììyo_1583_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lie (du vin)</text></gloss>
      <gloss lang="en"><text>dregs, lees</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dregs of palm wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.75.9; Childs 2000, p. 164: kììyó</text></form></note>
    <note><form lang="fr"><text>kol man a kììyo kpede « en boire jusqu'à la lie » (PSA.75.9) ; maa mɔiyan ma cal o kììyo coo « comme le vin reposant sur sa lie » (JER.48.11).</text></form></note>
  </entry>
  <entry id="kíkííyá_1584">
    <lexical-unit><form lang="kqs"><text>kíkííyá</text></form></lexical-unit>
    <trait name="noun-class" value="a"/>
    <trait name="status" value="southern"/>
    <sense id="kíkííyá_1584_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paludisme</text></gloss>
      <gloss lang="en"><text>malaria</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 163: kíkííyá</text></form></note>
  </entry>
  <entry id="kikil_1585">
    <lexical-unit><form lang="kqs"><text>kikil</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kikil_1585_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cercle, voûte</text></gloss>
      <gloss lang="en"><text>circle, vault</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>traditional round house with a cone-shaped roof; cone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.40.22; Childs 2000, p. 164: kíkílló</text></form></note>
    <note><form lang="fr"><text>Ndu co icali o kikil lelɛŋndo bollen ni « il siège au-dessus du cercle de la terre » (ISA.40.22). Une seule occurrence.</text></form></note>
  </entry>
  <entry id="kikiɲaa_1586">
    <lexical-unit><form lang="kqs"><text>kikiɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kikiɲaa_1586_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épilepsie</text></gloss>
      <gloss lang="en"><text>epilepsy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>malaria</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.4.24; Keita 1979, p. 161: Kikinyaa; Lexique kissi–français, p. 24: kikiŋaa; Childs 2000, p. 163: kííkííyá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 24 : kikiŋaa « l'épilepsie ».</text></form></note>
  </entry>
  <entry id="kila_1587">
    <lexical-unit><form lang="kqs"><text>kila</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilaa</text></form></variant>
    <sense id="kila_1587_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'installer ; (kila dɔ́ɔ́ngɔ́ɔ̀) camper ; établir</text></gloss>
      <gloss lang="en"><text>settle; (kila dɔ́ɔ́ngɔ́ɔ̀) pitch camp; establish</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 114 occurrences, first GEN.11.2</text></form></note>
  </entry>
  <entry id="kila hala_1588">
    <lexical-unit><form lang="kqs"><text>kila hala</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kila hala_1588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prophète (Keita)</text></gloss>
      <gloss lang="en"><text>prophet (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kila hala</text></form></note>
    <note><form lang="fr"><text>Forme douteuse ; la Bible dit vana-tɛɛngaa-diom Hala « prophète » (2R 4,40).</text></form></note>
  </entry>
  <entry id="kìlàmáŋndéŋ_1589">
    <lexical-unit><form lang="kqs"><text>kìlàmáŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="kìlàmáŋndéŋ_1589_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>instrument à cordes (sorte de harpe à caisse de résonance, ou monocorde joué à l'archet) accompagnant les contes</text></gloss>
      <gloss lang="en"><text>stringed instrument (harp-like with a resonator, or one-stringed bowed lute) played with storytelling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 165: kìlàmáŋndéŋ</text></form></note>
  </entry>
  <entry id="kilasio_1590">
    <lexical-unit><form lang="kqs"><text>kilasio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kilasio_1590_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouteille</text></gloss>
      <gloss lang="en"><text>bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 24: kilasio</text></form></note>
  </entry>
  <entry id="kili_1591">
    <lexical-unit><form lang="kqs"><text>kili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilio</text></form></variant>
    <sense id="kili_1591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper, trancher</text></gloss>
      <gloss lang="en"><text>cut, cut off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cut many things, cut into small pieces</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.49.6; Lexique kissi–français, p. 24: kilio; Childs 2000, p. 166: kìlìó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 24 : kilio « découpé ». Dans la Bible, kilio se dit aussi de la tonte des moutons (GEN.31.19).</text></form></note>
  </entry>
  <entry id="kílì-kílì_1592">
    <lexical-unit><form lang="kqs"><text>kílì-kílì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kílì-kílì_1592_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>petits pas rapides (de petits animaux la nuit)</text></gloss>
      <gloss lang="en"><text>pitter-patter of small animals' footsteps at night</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 165: kílì-kílì</text></form></note>
  </entry>
  <entry id="kiliiyɔmnɔɔ_1593">
    <lexical-unit><form lang="kqs"><text>kiliiyɔmnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kiliiyɔmnɔɔ_1593_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bûcheron</text></gloss>
      <gloss lang="en"><text>woodcutter</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Kiliiyömnöö; Lexique kissi–français, p. 24: kiliiyɔmnɔɔ</text></form></note>
  </entry>
  <entry id="kilikilio_1594">
    <lexical-unit><form lang="kqs"><text>kilikilio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilikili</text></form></variant>
    <sense id="kilikilio_1594_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper en morceaux ; découper en petits morceaux</text></gloss>
      <gloss lang="en"><text>cut into pieces; cut into small pieces</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1SA.11.7; Keita 1979, p. 110: Kilikilio; Lexique kissi–français, p. 24: kilikilio/ kilikili</text></form></note>
    <note><form lang="fr"><text>Redoublement (1SA 11,7 ; LEV 8,20). Aussi Lexique kissi–français, p. 24 : « kirikirio/ kirikiri ». Lexique kissi–français, p. 24 : écrit kirikirio (l/r non distingués).</text></form></note>
  </entry>
  <entry id="kìlìó_1595">
    <lexical-unit><form lang="kqs"><text>kìlìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kìlìó_1595_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeu de toupies</text></gloss>
      <gloss lang="en"><text>game of spinning tops</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 165: kìlìó</text></form></note>
  </entry>
  <entry id="kilio_1596">
    <lexical-unit><form lang="kqs"><text>kilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kilio_1596_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tison (gardé pour rallumer le feu le lendemain) ; bois en partie brûlé</text></gloss>
      <gloss lang="en"><text>fire stick, ember (kept to start the fire the next morning); partly burnt wood</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: kirio; Childs 2000, p. 165: kìlìó kìlìóŋ</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 25 (kirio « le bois en partie brûlé »). Homographe de kilio « tondre » (GEN.31.19). Pluriel en kissi du Sud (Childs 2000) : kìlìóŋ.</text></form></note>
  </entry>
  <entry id="kilitilen_1597">
    <lexical-unit><form lang="kqs"><text>kilitilen</text></form></lexical-unit>
