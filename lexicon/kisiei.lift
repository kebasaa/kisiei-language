  <entry id="kopiw kɛnde_2260">
    <lexical-unit><form lang="kqs"><text>kopiw kɛnde</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kopiw kɛnde_2260_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>achevez bien la journée (salutation)</text></gloss>
      <gloss lang="en"><text>have a good rest of the day (greeting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 49: kopyu</text></form></note>
    <note><form lang="fr"><text>Paulme : kopyu kɛnde « achevez bien la journée ». Orthographe de kopyu à vérifier.</text></form></note>
  </entry>
  <entry id="kosa_2261">
    <lexical-unit><form lang="kqs"><text>kosa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kosa_2261_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>équarrir (le bois)</text></gloss>
      <gloss lang="en"><text>square (timber)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: kosa</text></form></note>
    <note><form lang="fr"><text>Forme radicale seule ; le Lexique ajoute « pas connu ».</text></form></note>
  </entry>
  <entry id="kosaa_2262">
