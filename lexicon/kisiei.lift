    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>deŋul</text></form></variant>
    <sense id="deŋullo_1027_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier à, apostropher ; menacer, réprimander</text></gloss>
      <gloss lang="en"><text>shout at, call out to; rebuke, threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>yell at someone, shout for or after someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MRK.1.27; Childs 2000, p. 74: dèŋùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de deŋio « crier ». Mó deŋul mɛmma ihɛlma makpɛ̀ndɛ̀an « il menaça la mer Rouge » (PSA.106.9).</text></form></note>
  </entry>
  <entry id="di di_1028">
    <lexical-unit><form lang="kqs"><text>di di</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="di di_1028_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>chaque matin</text></gloss>
      <gloss lang="en"><text>every morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: di di</text></form></note>
    <note><form lang="fr"><text>Orthographe à confirmer (cf. diilɛn « le matin »).</text></form></note>
  </entry>
  <entry id="dialii_1029">
    <lexical-unit><form lang="kqs"><text>dialii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>diallon</text></form></field>
    <variant><form lang="kqs"><text>dialun</text></form></variant>
    <sense id="dialii_1029_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>membre, partie du corps ; chair ; (pl.) le corps</text></gloss>
      <gloss lang="en"><text>limb, part of the body; flesh; (pl.) the body</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>body; also health, condition, skin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first GEN.2.23; Childs 2000, p. 76: ɗìàllé</text></form></note>
  </entry>
  <entry id="diam_1030">
    <lexical-unit><form lang="kqs"><text>diam</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dem</text></form></variant>
    <sense id="diam_1030_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rejoindre ; suivre, poursuivre ; (diam fuɲaa … ciee-piɔ́m) rejoindre ses pères (mourir)</text></gloss>
      <gloss lang="en"><text>join; follow, pursue; (diam fuɲaa … ciee-piɔ́m) be gathered to one's fathers (die)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.5 Accompany"/>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.14.14</text></form></note>
    <note><form lang="fr"><text>dem : te i dem pɛ fuɲaa niaa « quand je reposerai avec mes pères » (Gn 47,30).</text></form></note>
  </entry>
  <entry id="diandaa_1031">
    <lexical-unit><form lang="kqs"><text>diandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandan</text></form></variant>
    <variant><form lang="kqs"><text>diandɛi</text></form></variant>
    <variant><form lang="kqs"><text>diandaalan</text></form></variant>
    <sense id="diandaa_1031_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>saint, consacré ; pur</text></gloss>
      <gloss lang="en"><text>holy, consecrated; pure</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 972 occurrences, first GEN.6.9; Childs 2000, p. 77: ɗìàndà-</text></form></note>
  </entry>
  <entry id="diaŋo_1032">
    <lexical-unit><form lang="kqs"><text>diaŋo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>diaŋɔla</text></form></field>
    <sense id="diaŋo_1032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (écorce entrant dans le kowã)</text></gloss>
      <gloss lang="en"><text>plant (bark used in the kowã)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 23: dyaŋo, pl. dyaŋɔra</text></form></note>
    <note><form lang="fr"><text>Paulme : élément du tɛmbo qui protège les excisées ; Fangamadou.</text></form></note>
  </entry>
  <entry id="diebada_1033">
    <lexical-unit><form lang="kqs"><text>diebada</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diebada_1033_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hochet à filet</text></gloss>
      <gloss lang="en"><text>net rattle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 23: dyebada</text></form></note>
  </entry>
  <entry id="dii_1034">
    <lexical-unit><form lang="kqs"><text>dii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diinin</text></form></variant>
    <sense id="dii_1034_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 567 occurrences, first GEN.4.8; Paulme 1964, p. 18 (G): dī; Childs 2000, p. 78: ɗìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 18 : dī « tuer, meurtre » (la di « vous avez tué » /G./ ; o di ndu « il l'a tué »).</text></form></note>
  </entry>
  <entry id="diikunnɔɔ_1035">
    <lexical-unit><form lang="kqs"><text>diikunnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>vana mel… too</text></form></variant>
    <sense id="diikunnɔɔ_1035_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fidèle</text></gloss>
      <gloss lang="en"><text>faithful (person), follower</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 304: Diikunnöö, vana mel… too</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. diikɔnndo « servir ; fidélité ».</text></form></note>
  </entry>
  <entry id="diikɔnndo_1036">
    <lexical-unit><form lang="kqs"><text>diikɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diikɔnndo_1036_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir, être au service de (qqn) ; fidélité</text></gloss>
      <gloss lang="en"><text>serve, wait on (someone); faithfulness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>show loyalty, be obedient or submissive</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1KI.1.4; Terminologie (idéologie), n° 309: Diikönndo; Childs 2000, p. 78: dìkɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : a ndu diikɔnndo « elle le servait » (1KI.1.4).</text></form></note>
  </entry>
  <entry id="diilɛn_1037">
    <lexical-unit><form lang="kqs"><text>diilɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diilɛn_1037_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le matin, ce matin, de bon matin</text></gloss>
      <gloss lang="en"><text>in the morning, this morning, early</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first RUT.2.7; Childs 2000, p. 78: dìílɛ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Diilɛn púŋ « de grand matin » (LUK.24.22) ; kabi diilɛn « depuis ce matin » (RUT.2.7).</text></form></note>
  </entry>
  <entry id="diimandɔɔ_1038">
    <lexical-unit><form lang="kqs"><text>diimandɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diimandɔ</text></form></variant>
    <sense id="diimandɔɔ_1038_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le lendemain</text></gloss>
      <gloss lang="en"><text>the next day</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the coming day, tomorrow morning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 119 occurrences, first GEN.19.34; Childs 2000, p. 78: dìímàndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diinndɔɔ_1039">
    <lexical-unit><form lang="kqs"><text>diinndɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinndɔɔ_1039_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>deuxième</text></gloss>
      <gloss lang="en"><text>second</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>two; second</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.4.19; Childs 2000, p. 79: dìíŋ</text></form></note>
  </entry>
  <entry id="diinɔnndo_1040">
    <lexical-unit><form lang="kqs"><text>diinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diinɔnndo_1040_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tuer ; suicide</text></gloss>
      <gloss lang="en"><text>kill oneself; suicide</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ZEC.11.4; Keita 1979, p. 110: Diinönndo; Lexique kissi–français, p. 13: diinɔnndo/ diinun; Terminologie (histoire), n° 585: Diyönndo, diinönndo; Childs 2000, p. 78: dììnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de diyɔɔ (ACT 16,27). Ne pas confondre avec diinun « se rassembler » (GEN 1,9). Académie des langues (terminologie, histoire n° 585) : « suicide » (aussi diyɔnndo).</text></form></note>
  </entry>
  <entry id="diisiinndo_1041">
    <lexical-unit><form lang="kqs"><text>diisiinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diisiinndo_1041_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concept</text></gloss>
      <gloss lang="en"><text>concept</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 77: Diisiinndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="dikpanon_1042">
    <lexical-unit><form lang="kqs"><text>dikpanon</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dikpanon_1042_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dignitaire du bundo (seconde l'exciseuse)</text></gloss>
      <gloss lang="en"><text>official of the bundo (assists the excisor)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: digpanõ</text></form></note>
  </entry>
  <entry id="dikpisiie_1043">
    <lexical-unit><form lang="kqs"><text>dikpisiie</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dikpisiie_1043_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>épais, très sombre (nuage)</text></gloss>
      <gloss lang="en"><text>thick, very dark (cloud)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>looming, dark like a thundercloud</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2SA.22.10; Childs 2000, p. 79: díkpìsìì</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : kumii tiŋii dikpisiie « une nuée noire et épaisse » (2SA.22.10).</text></form></note>
  </entry>
  <entry id="dila yɛndo_1044">
    <lexical-unit><form lang="kqs"><text>dila yɛndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dila yɛndo_1044_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>minuit, heure la plus noire de la nuit</text></gloss>
      <gloss lang="en"><text>midnight, darkest hour of the night</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: dira yɛndo</text></form></note>
    <note><form lang="fr"><text>Paulme : kuino fura dirayɛndo « le sorcier est sorti à minuit ».</text></form></note>
  </entry>
  <entry id="dilen_1045">
    <lexical-unit><form lang="kqs"><text>dilen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dilen_1045_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>matin ; aujourd'hui</text></gloss>
      <gloss lang="en"><text>morning; today</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: dilẽ</text></form></note>
    <note><form lang="fr"><text>Paulme : hadi « ce matin ». Cf. idiiyo « le matin » (Bible).</text></form></note>
  </entry>
  <entry id="dillo_1046">
    <lexical-unit><form lang="kqs"><text>dillo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dillo_1046_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger pour quelqu'un</text></gloss>
      <gloss lang="en"><text>eat for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Dillo; Lexique kissi–français, p. 13: dillo/ dil</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de dioo.</text></form></note>
  </entry>
  <entry id="dímàá_1047">
    <lexical-unit><form lang="kqs"><text>dímàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dímàá_1047_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lime (à aiguiser)</text></gloss>
      <gloss lang="en"><text>file (for sharpening)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 80: dímàá</text></form></note>
  </entry>
  <entry id="dimando_1048">
    <lexical-unit><form lang="kqs"><text>dimando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dimando_1048_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le surlendemain</text></gloss>
      <gloss lang="en"><text>two days later</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: dimando</text></form></note>
  </entry>
  <entry id="dimi_1049">
    <lexical-unit><form lang="kqs"><text>dimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimin</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimi_1049_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire ; ordonner</text></gloss>
      <gloss lang="en"><text>say; order, command</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2652 occurrences, first GEN.1.3; Paulme 1964, p. 19: dimi; Childs 2000, p. 80: ɗìmìó</text></form></note>
    <note><form lang="fr"><text>Forme longue dimio (« kon co dimio ni aa » « ce qui veut dire »). Paulme 1964, p. 19 : ɔ dimi « il a dit, il a ordonné » ; dimi masa « l'ordre du chef ».</text></form></note>
  </entry>
  <entry id="dimi loonanndo_1050">
    <lexical-unit><form lang="kqs"><text>dimi loonanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dimi loonanndo_1050_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>récitation</text></gloss>
      <gloss lang="en"><text>recitation</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.6.2 School"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 349: Dimi loonanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="dimindole_1051">
    <lexical-unit><form lang="kqs"><text>dimindole</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dimindole_1051_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entremetteur, avocat ; calomniateur</text></gloss>
      <gloss lang="en"><text>go-between, advocate; slanderer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: dimindore</text></form></note>
    <note><form lang="fr"><text>Paulme : aussi nom de chien. Cf. dimi « dire ».</text></form></note>
  </entry>
  <entry id="dimio_1052">
    <lexical-unit><form lang="kqs"><text>dimio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dimi</text></form></variant>
    <variant><form lang="kqs"><text>diminin</text></form></variant>
    <sense id="dimio_1052_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dire</text></gloss>
      <gloss lang="en"><text>say</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>say, tell, speak</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 890 occurrences, first GEN.3.20; Keita 1979, p. 110: Dimio; Lexique kissi–français, p. 13: dimio/ dimi; Terminologie (langue), n° 15: Dimioo; Childs 2000, p. 80: dìmìó</text></form></note>
    <note><form lang="fr"><text>Bénéfactif dimul « dire à ». Académie des langues (terminologie, langue n° 15) : dimioo « affirmation ». Académie des langues (terminologie, langue n° 125) : dimioo « diction ». Académie des langues (terminologie, langue n° 174) : dimioo « exprimer ».</text></form></note>
  </entry>
  <entry id="dimioo a sondo_1053">
    <lexical-unit><form lang="kqs"><text>dimioo a sondo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dimioo a sondo_1053_s1">
