    <note><form lang="fr"><text>Voir aussi sɔlɔɔ « grenouille » (Keita).</text></form></note>
  </entry>
  <entry id="soninkɔnɔɔ_4710">
    <lexical-unit><form lang="kqs"><text>soninkɔnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="soninkɔnɔɔ_4710_s1">
      <grammatical-info value="Noun"/>
