  </entry>
  <entry id="koboo_1639">
    <lexical-unit><form lang="kqs"><text>koboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="koboo_1639_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boîte</text></gloss>
      <gloss lang="en"><text>box, tin</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tin can</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Koboo; Lexique kissi–français, p. 25: koboo; Childs 2000, p. 172: kóbóó</text></form></note>
  </entry>
  <entry id="koei_1640">
    <lexical-unit><form lang="kqs"><text>koei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>koon</text></form></field>
    <sense id="koei_1640_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cauri</text></gloss>
      <gloss lang="en"><text>cowry</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cowry shell; also a palm-wine gourd</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Koei; Lexique kissi–français, p. 25: koei; Childs 2000, p. 190: kùèí</text></form></note>
    <note><form lang="fr"><text>La Bible a koon « corail, perles » (Jb 28,18 ; Ez 27,16), sans doute le pluriel. Lexique kissi–français, p. 26 : aussi kouve « le caurie ? » (douteux).</text></form></note>
  </entry>
  <entry id="koei_1641">
    <lexical-unit><form lang="kqs"><text>koei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="koei_1641_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vin de palme extrait de la fleur</text></gloss>
      <gloss lang="en"><text>palm wine tapped from the flower</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Koei; Lexique kissi–français, p. 25: koei</text></form></note>
  </entry>
  <entry id="koelen_1642">
    <lexical-unit><form lang="kqs"><text>koelen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="koelen_1642_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fruit dont l'huile est amère</text></gloss>
      <gloss lang="en"><text>fruit with a bitter oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: koelen</text></form></note>
  </entry>
  <entry id="koesio_1643">
    <lexical-unit><form lang="kqs"><text>koesio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>koesi</text></form></variant>
    <sense id="koesio_1643_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abreuver, donner à boire</text></gloss>
      <gloss lang="en"><text>give to drink, water (animals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.24.44</text></form></note>
    <note><form lang="fr"><text>Cf. kolɔɔ « boire ».</text></form></note>
  </entry>
  <entry id="koeyo_1644">
    <lexical-unit><form lang="kqs"><text>koeyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="koeyo_1644_s1">
