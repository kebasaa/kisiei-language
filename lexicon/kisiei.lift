    <sense id="dâlíí_981_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très collant (souligne le caractère collant)</text></gloss>
      <gloss lang="en"><text>very sticky</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dâlíí</text></form></note>
  </entry>
  <entry id="dámbélé_982">
    <lexical-unit><form lang="kqs"><text>dámbélé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dámbélé_982_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>brusquement, soudain</text></gloss>
      <gloss lang="en"><text>abruptly, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 70: dámbélé</text></form></note>
  </entry>
  <entry id="dandaa_983">
    <lexical-unit><form lang="kqs"><text>dandaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>danda</text></form></variant>
    <sense id="dandaa_983_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soin, remède, guérison</text></gloss>
      <gloss lang="en"><text>treatment, remedy, healing</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.147.3; Paulme 1964, p. 17: danda; Childs 2000, p. 70: dándàá</text></form></note>
    <note><form lang="fr"><text>nɔ danda le « incurable » (Jr 30,12) ; danda dɔwnɔn « être guéri » (Jr 15,18). Paulme 1964, p. 17 : danda « malade, patient ; soigner » (lé danda du dɔwo « comment le soigner, lui, malade »).</text></form></note>
  </entry>
  <entry id="dandaa dɔwɔɔ_984">
    <lexical-unit><form lang="kqs"><text>dandaa dɔwɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dandaa dɔwɔɔ_984_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>soigner</text></gloss>
      <gloss lang="en"><text>treat, nurse (a sick person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dandaa dɔwɔɔ</text></form></note>
    <note><form lang="fr"><text>Radical dau danda (p. 13).</text></form></note>
  </entry>
  <entry id="dangaa_985">
    <lexical-unit><form lang="kqs"><text>dangaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>danga</text></form></variant>
    <variant><form lang="kqs"><text>dangala</text></form></variant>
    <variant><form lang="kqs"><text>dangalaa</text></form></variant>
    <sense id="dangaa_985_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>malédiction</text></gloss>
      <gloss lang="en"><text>curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rudeness, disrespect, insulting someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 80 occurrences, first GEN.3.14; Paulme 1964, p. 17: daŋa, pl. daŋara; Childs 2000, p. 70: dáŋgáá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 17 : daŋa, pl. daŋara « malédiction » ; daŋa dɔɔ « verser la malédiction », i do daŋa « maudire » ; se prononce parfois dauna.</text></form></note>
  </entry>
  <entry id="dangalaa_986">
    <lexical-unit><form lang="kqs"><text>dangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dangaltan</text></form></field>
    <sense id="dangalaa_986_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bord, lisière, côté ; (pl.) bords (d'un champ)</text></gloss>
      <gloss lang="en"><text>edge, border, side; (pl.) edges (of a field)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boundary, edge; the area just outside a cleared field</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.23.9; Childs 2000, p. 71: dáŋgáláá</text></form></note>
    <note><form lang="fr"><text>o mɛmma ihɛllan dangalaa « au bord de la mer Rouge » (EXO.14.2) ; háá o dangaltan « jusqu'aux bords (du champ) » (LEV.23.22).</text></form></note>
  </entry>
  <entry id="dàpàléŋ_987">
    <lexical-unit><form lang="kqs"><text>dàpàléŋ</text></form></lexical-unit>
