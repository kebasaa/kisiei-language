    <trait name="status" value="attested"/>
    <sense id="cobe_460_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(o lo cɔɔlu cobe) presque, peu s'en faut ; sur le point de</text></gloss>
      <gloss lang="en"><text>(o lo cɔɔlu cobe) almost, nearly; about to</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.26.10</text></form></note>
