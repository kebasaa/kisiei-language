  <entry id="kola_1646">
    <lexical-unit><form lang="kqs"><text>kola</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kolalan</text></form></field>
    <variant><form lang="kqs"><text>kolala</text></form></variant>
    <sense id="kola_1646_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tissu, étoffe ; voile</text></gloss>
