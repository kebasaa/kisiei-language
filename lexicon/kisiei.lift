    <variant><form lang="kqs"><text>máánndan</text></form></variant>
    <sense id="máándo_3333_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sanctuaire, lieu de culte</text></gloss>
      <gloss lang="en"><text>shrine, place of worship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>place of worship; secret meeting place of the men in the forest</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JDG.17.5; Keita 1979, p. 142: Maando; Lexique kissi–français, p. 36: naando; Childs 2000, p. 239: máàŋndó</text></form></note>
    <note><form lang="fr"><text>Bible : cɛi máándo « maison des idoles, sanctuaire ». Lexique kissi–français, p. 36 écrit naando « le sanctuaire » (pour maando ?).</text></form></note>
  </entry>
