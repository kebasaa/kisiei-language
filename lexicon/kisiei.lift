  <entry id="fee_425">
    <lexical-unit><form lang="kqs"><text>fee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fee_425_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, tout autour ; complètement</text></gloss>
      <gloss lang="en"><text>everywhere, all around; completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>very hard, intensively, by all means</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 66 occurrences, first DEU.22.27; Childs 2000, p. 99: féé</text></form></note>
    <note><form lang="fr"><text>ba-ba fee « de tous côtés » ; ɲɛ-ɲɛ fee « toutes choses ».</text></form></note>
  </entry>
  <entry id="feke-feke_426">
    <lexical-unit><form lang="kqs"><text>feke-feke</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>feke-fekela</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekelan</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekea</text></form></variant>
    <variant><form lang="kqs"><text>feke-fekeo</text></form></variant>
    <sense id="feke-feke_426_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>escarpé, abrupt, rocheux</text></gloss>
      <gloss lang="en"><text>steep, rugged, rocky</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note><form lang="fr"><text>fondala feke-fekela co o pembon coo « les lieux escarpés des montagnes » (1 S 23,14).</text></form></note>
  </entry>
  <entry id="felenfelenndo_427">
    <lexical-unit><form lang="kqs"><text>felenfelenndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>felenfelennde</text></form></variant>
    <variant><form lang="kqs"><text>felenfelen</text></form></variant>
    <sense id="felenfelenndo_427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tourbillon, ouragan</text></gloss>
      <gloss lang="en"><text>whirlwind</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
