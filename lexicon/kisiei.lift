    <trait name="status" value="southern"/>
    <sense id="cìèì-kíkílló_487_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>case ronde traditionnelle, case à palabres</text></gloss>
      <gloss lang="en"><text>traditional round house, palaver hut</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 44: cìèì-kíkílló</text></form></note>
  </entry>
  <entry id="cìèì-kpààfáá_488">
    <lexical-unit><form lang="kqs"><text>cìèì-kpààfáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cìèì-kpààfáá_488_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maison faite seulement de bâtons, sans torchis</text></gloss>
      <gloss lang="en"><text>house of sticks only, without wattle or mud</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 44: cìèì-kpààfáá</text></form></note>
  </entry>
  <entry id="cìèì-kɔ̀ɔ̀ɲó_489">
    <lexical-unit><form lang="kqs"><text>cìèì-kɔ̀ɔ̀ɲó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cìèì-kɔ̀ɔ̀ɲó_489_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arrière-cour (litt. « derrière la maison ») ; euphémisme pour « uriner »</text></gloss>
      <gloss lang="en"><text>backyard (lit. behind the house); euphemism for urinating</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="2.2.7 Urinate, urine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 44: cìèì-kɔ̀ɔ̀ɲó</text></form></note>
  </entry>
  <entry id="cìèì-màkòŋgóó_490">
    <lexical-unit><form lang="kqs"><text>cìèì-màkòŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cìèì-màkòŋgóó_490_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dispensaire, hôpital</text></gloss>
      <gloss lang="en"><text>clinic, hospital</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 44: cìèì-màkòŋgóó</text></form></note>
  </entry>
  <entry id="cìèìcìèìyó_491">
    <lexical-unit><form lang="kqs"><text>cìèìcìèìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cìèìcìèìyó_491_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essayer</text></gloss>
      <gloss lang="en"><text>try</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 43: cìèìcìèìyó</text></form></note>
  </entry>
  <entry id="cieiyo_492">
    <lexical-unit><form lang="kqs"><text>cieiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cieiyo_492_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lutte, combat</text></gloss>
      <gloss lang="en"><text>fight, struggle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fight (both verb and noun)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Tyieiyo; Lexique kissi–français, p. 9: cieiyo; Childs 2000, p. 43: cìèìyó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi ceiyo « la bataille » (p. 9).</text></form></note>
  </entry>
  <entry id="cieo_493">
    <lexical-unit><form lang="kqs"><text>cieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cieon</text></form></field>
    <variant><form lang="kqs"><text>ciee</text></form></variant>
    <sense id="cieo_493_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>village, ville</text></gloss>
      <gloss lang="en"><text>village, town</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.15.7; Keita 1979, p. 142: Tyieo; Lexique kissi–français, p. 10: cieo; Childs 2000, p. 49: cíóó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi ce « le village » et ceo « la ville, le village » (p. 9).</text></form></note>
  </entry>
  <entry id="cii_494">
    <lexical-unit><form lang="kqs"><text>cii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cii_494_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, achever</text></gloss>
      <gloss lang="en"><text>finish</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1008 occurrences, first GEN.2.2; Lexique kissi–français, p. 10: ciyo/ cii, cuu; Childs 2000, p. 47: cììyó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 10 : ciyo/ cii, cuu « accomplir, finir, terminer ».</text></form></note>
  </entry>
  <entry id="cììcìàláŋ_495">
    <lexical-unit><form lang="kqs"><text>cììcìàláŋ</text></form></lexical-unit>
    <trait name="noun-class" value="la"/>
    <trait name="status" value="southern"/>
    <sense id="cììcìàláŋ_495_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nids-de-poule, inégalités de la route</text></gloss>
      <gloss lang="en"><text>potholes, uneven patches of road</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 44: cììcìàláŋ</text></form></note>
  </entry>
  <entry id="ciikan_496">
    <lexical-unit><form lang="kqs"><text>ciikan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ciikanndo</text></form></variant>
    <sense id="ciikan_496_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rencontrer, se voir</text></gloss>
      <gloss lang="en"><text>meet, see each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>meet, confront; also combat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.29; Lexique kissi–français, p. 10: ciikanndo/ ciikan; Childs 2000, p. 45: cììkăŋndó</text></form></note>
  </entry>
  <entry id="ciiku_497">
    <lexical-unit><form lang="kqs"><text>ciiku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciiku_497_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>découvrir, s'apercevoir de ; soupçonner</text></gloss>
      <gloss lang="en"><text>find out, notice; suspect</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.5; Childs 2000, p. 45: cììkùùwó</text></form></note>
    <note><form lang="fr"><text>mò ciiku laa ndɔ « s'il soupçonne sa femme » (Nb 5,14).</text></form></note>
  </entry>
  <entry id="cììmàá_498">
    <lexical-unit><form lang="kqs"><text>cììmàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cììmàá_498_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frotter avec les mains, presser, tordre (le linge)</text></gloss>
      <gloss lang="en"><text>rub with the hands, press, squeeze, wring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.5 Rub"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 45: cììmàá</text></form></note>
    <note><form lang="fr"><text>Comparer ciimiaa « écraser, piétiner » (Bible), qui a la forme du pluriel verbal.</text></form></note>
  </entry>
  <entry id="ciimbuu_499">
    <lexical-unit><form lang="kqs"><text>ciimbuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciimbuu_499_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>voler, dérober</text></gloss>
      <gloss lang="en"><text>steal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.31.19; Lexique kissi–français, p. 24: kiinbuo/ kiinbu</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français, p. 24, écrit kiinbuo/kiinbu « voler ».</text></form></note>
  </entry>
  <entry id="ciimiaa_500">
    <lexical-unit><form lang="kqs"><text>ciimiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciimiaa_500_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écraser, piétiner ; réduire en poudre ; frotter (le linge entre les mains)</text></gloss>
      <gloss lang="en"><text>crush, trample; pound to powder; rub (clothes between the hands)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rub with the hands, press, squeeze (plural of cììmàá)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first 2KI.8.12; Lexique kissi–français, p. 10: ciimiaa; Childs 2000, p. 46: cììmìá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 10 : « piler en poudre, pilonner ; frotter comme avec les vêtements entre les mains ».</text></form></note>
  </entry>
  <entry id="ciindiaa_501">
    <lexical-unit><form lang="kqs"><text>ciindiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ciindiaanin</text></form></variant>
    <sense id="ciindiaa_501_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sauver, secourir</text></gloss>
      <gloss lang="en"><text>save, rescue</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wean (a child); survive, make survive, rescue</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 238 occurrences, first GEN.6.18; Lexique kissi–français, p. 10: cindiaa/ cindia; Childs 2000, p. 48: cìndàá</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit cindiaa/ cindia « faire sauver, faire délivrer » (p. 10).</text></form></note>
  </entry>
  <entry id="ciindian_502">
    <lexical-unit><form lang="kqs"><text>ciindian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciindian_502_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se sauver soi-même ; (pila ciindian) se sauver</text></gloss>
      <gloss lang="en"><text>save oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first MAT.27.40; Childs 2000, p. 46: cììndìáŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de ciindiaa « sauver ». nɔm pila ciindian « sauve-toi toi-même » (MAT.27.40, MAT.27.42).</text></form></note>
  </entry>
  <entry id="ciinun_503">
    <lexical-unit><form lang="kqs"><text>ciinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciinun_503_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dévoiler, révéler (son cœur) ; anéantir ; (pila ciinun labɛɛ) se déshonorer</text></gloss>
      <gloss lang="en"><text>open up, reveal (one's heart); wipe out; (pila ciinun labɛɛ) dishonour oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be finished, come to an end; lose all self-respect</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first LEV.18.10; Childs 2000, p. 46: cììnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Samsɔn ciinun kɔl ya o ba « Samson m'a ouvert tout son cœur » (JDG.16.18) ; nɔm pila ciinun labɛɛ « tu te déshonores » (EZK.22.16, LEV.18.10) ; n kɔ ciinun vanaa-mangalaa-isɔɔa ha « anéantissons ces nations » (PSA.83.5). Moyen de cii « finir ».</text></form></note>
  </entry>
  <entry id="cììpùùwó_504">
    <lexical-unit><form lang="kqs"><text>cììpùùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cììpùùwó_504_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>goûter cru, non cuit</text></gloss>
      <gloss lang="en"><text>taste raw, uncooked</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 47: cììpùùwó</text></form></note>
  </entry>
  <entry id="ciiye_505">
    <lexical-unit><form lang="kqs"><text>ciiye</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciiye_505_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>souche (d'arbre) ; pieu</text></gloss>
      <gloss lang="en"><text>tree stump; stake, post</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tree stump; foundation of a house</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DAN.4.12; Lexique kissi–français, p. 10: ciye; Childs 2000, p. 47: cììyé</text></form></note>
    <note><form lang="fr"><text>mì la mɛi ciiye a puundon yondoo nin « mais laissez la souche avec ses racines dans la terre » (DAN.4.12, 4.20, 4.23). Lexique kissi–français, p. 10 : ciye « les pieux ; la souche d'un arbre ».</text></form></note>
  </entry>
  <entry id="cìíyo_506">
    <lexical-unit><form lang="kqs"><text>cìíyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cìíyo_506_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>buffle ; bœuf sauvage</text></gloss>
      <gloss lang="en"><text>buffalo, wild ox</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 161 occurrences, first GEN.5.12; Lexique kissi–français, p. 10: ciyo; Childs 2000, p. 47: cìíyó</text></form></note>
    <note><form lang="fr"><text>maa cìíyo « comme le buffle » (NUM.23.22) ; JOB.39.9. À distinguer de ciiyo « vivre ». Le Lexique kissi–français écrit ciyo « une vache sauvage, le buffle » (p. 10).</text></form></note>
  </entry>
  <entry id="ciiŋiaa_507">
    <lexical-unit><form lang="kqs"><text>ciiŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciiŋiaa_507_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>assembler, joindre ; sertir (des pierres) ; disposer</text></gloss>
      <gloss lang="en"><text>join together; set (stones); arrange</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>join the edges of, push together (benefactive plural of cìŋàá)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.26.9; Childs 2000, p. 47: cììŋìàlló</text></form></note>
    <note><form lang="fr"><text>Pluriel (verbal) de ciŋaa.</text></form></note>
  </entry>
  <entry id="cìkpàá_508">
    <lexical-unit><form lang="kqs"><text>cìkpàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cìkpàá_508_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chèvre de brousse (céphalophe)</text></gloss>
      <gloss lang="en"><text>bush goat (duiker)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 47: cìkpàá</text></form></note>
  </entry>
  <entry id="cìkpàléŋ_509">
    <lexical-unit><form lang="kqs"><text>cìkpàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cìkpèí</text></form></field>
    <sense id="cìkpàléŋ_509_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre</text></gloss>
      <gloss lang="en"><text>species of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 47: cìkpàléŋ</text></form></note>
  </entry>
  <entry id="cilinnde_510">
    <lexical-unit><form lang="kqs"><text>cilinnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cilinndon</text></form></field>
    <sense id="cilinnde_510_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer, métal ; balle, cartouche</text></gloss>
      <gloss lang="en"><text>iron, metal; bullet, cartridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, iron; twisted iron strips formerly used as money</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.34.17; Keita 1979, p. 156: Tyilinnde; Lexique kissi–français, p. 10: cilinnde; Childs 2000, p. 48: cìlíŋndé</text></form></note>
    <note><form lang="fr"><text>La Bible n'a que le sens « fer, métal » ; « balle, cartouche » vient de Keita. Le Lexique kissi–français donne aussi ciinde et ciiŋi (devant un adjectif) « le fer » (p. 10).</text></form></note>
  </entry>
  <entry id="cilinndon_511">
    <lexical-unit><form lang="kqs"><text>cilinndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cilinndon_511_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer</text></gloss>
      <gloss lang="en"><text>iron</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, iron; iron strips once used as money</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.4.22; Childs 2000, p. 48: cìlíŋndé</text></form></note>
  </entry>
  <entry id="ciliŋii_512">
    <lexical-unit><form lang="kqs"><text>ciliŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="check"/>
    <field type="plural"><form lang="kqs"><text>ciliŋun</text></form></field>
    <sense id="ciliŋii_512_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>métal ; outil ou objet de métal ; (ciliŋun teengian) métal fondu</text></gloss>
      <gloss lang="en"><text>metal; metal tool or object; (ciliŋun teengian) molten metal</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, pieces of iron, esp. twisted iron strips used as (Kisi) money</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 48: cìlíŋndé</text></form></note>
    <note><form lang="fr"><text>maa ciliŋii dingɛn « comme du plomb » (Ex 15,10) ; piɔmndo a ciliŋun teengian « idole de métal fondu » (Dt 9,12).</text></form></note>
  </entry>
  <entry id="cimbullon_513">
    <lexical-unit><form lang="kqs"><text>cimbullon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cimbulun</text></form></variant>
    <sense id="cimbullon_513_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épines, ronces</text></gloss>
      <gloss lang="en"><text>thorns, briers</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.5.6; Childs 2000, p. 48: cìmbùllé</text></form></note>
    <note><form lang="fr"><text>Pluriel. cimbulun co o lɛŋnde veselɛilen nin-ndon a siɛmbullon « les épines du désert et les ronces » (JDG.8.7, JDG.8.16) ; ISA.5.6.</text></form></note>
  </entry>
  <entry id="cimbɔɔ_514">
    <lexical-unit><form lang="kqs"><text>cimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cimbɔɔ_514_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'enfuir, se sauver (de chez son maître)</text></gloss>
      <gloss lang="en"><text>run away, flee (from one's master)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flee, run away; steal</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1SA.25.10; Lexique kissi–français, p. 24: kinbɔɔ/ kinbu; Childs 2000, p. 48: cìmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cɛa ... cimbɔɔ o ba mà kɔannun « des esclaves qui s'enfuient de chez leurs maîtres » (1SA.25.10). Seule occurrence. Voir ciimbuu « voler ». Le Lexique kissi–français, p. 24, écrit kinbɔɔ/kinbu « s'enfuir ».</text></form></note>
  </entry>
  <entry id="cìmèìyó_515">
    <lexical-unit><form lang="kqs"><text>cìmèìyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cìmèìyó_515_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vendredi (jour du marché sierra-léonais)</text></gloss>
      <gloss lang="en"><text>Friday (Sierra Leone market day)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 48: cìmèìyó</text></form></note>
  </entry>
  <entry id="cindaa_516">
    <lexical-unit><form lang="kqs"><text>cindaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cinda</text></form></variant>
    <sense id="cindaa_516_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vie ; salut</text></gloss>
      <gloss lang="en"><text>life; salvation</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6 Life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) wean; remain alive, survive; rescue</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 172 occurrences, first GEN.2.9; Lexique kissi–français, p. 10: cindaa; Childs 2000, p. 48: cìndàá</text></form></note>
  </entry>
  <entry id="cinnun_517">
    <lexical-unit><form lang="kqs"><text>cinnun</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="cinnun_517_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rare</text></gloss>
      <gloss lang="en"><text>rare, scarce</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: cinnun</text></form></note>
    <note><form lang="fr"><text>La Bible a cinnun (DEU.22.20), apparemment « se trouver » à la forme négative ; à confirmer.</text></form></note>
  </entry>
  <entry id="ciŋ_518">
    <lexical-unit><form lang="kqs"><text>ciŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciŋ_518_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>clairement, de ses propres yeux (cɔu ciŋ, a lehɔl ciŋ)</text></gloss>
      <gloss lang="en"><text>clearly, with one's own eyes (cɔu ciŋ, a lehɔl ciŋ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.45.12</text></form></note>
  </entry>
  <entry id="cíŋ_519">
    <lexical-unit><form lang="kqs"><text>cíŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cíŋ_519_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>fixement, attentivement (regarder)</text></gloss>
      <gloss lang="en"><text>intently, keenly (looking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 49: cíŋ</text></form></note>
  </entry>
  <entry id="ciŋaa_520">
    <lexical-unit><form lang="kqs"><text>ciŋaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>ciŋa</text></form></variant>
    <sense id="ciŋaa_520_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>disposer, arranger (le bois) ; attiser (le feu) ; atteindre (un total)</text></gloss>
      <gloss lang="en"><text>lay, arrange (wood); stoke (a fire); reach (a total)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>join the edges of, push together; put one's mouth to a cup, drink; stoke a fire; argue in court; add money to a partial payment</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 49: cìŋàá</text></form></note>
    <note><form lang="fr"><text>yinnden ciŋaa « faire du feu » (Es 40,16) ; vɔsila lan la ciŋa kɛmɛ lehiɔɔlu a beleyaa « au bout de 430 ans » (Ex 12,41). ciŋan : má ciŋan le kolɔɔ « ils se penchèrent pour boire » (Jg 7,6).</text></form></note>
  </entry>
  <entry id="ciŋan_521">
    <lexical-unit><form lang="kqs"><text>ciŋan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ciŋanin</text></form></variant>
    <sense id="ciŋan_521_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>toucher, joindre ; boire en approchant la bouche (de l'eau) ; (yinnde ciŋanin) cuire sur le feu</text></gloss>
      <gloss lang="en"><text>touch, join; drink by putting the mouth to (water); (fire) be stoked</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>join edges; put the mouth to (water), drink; plead not guilty</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.25.26; Childs 2000, p. 49: cìŋǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de ciŋaa. má ciŋan le kolɔɔ « ils s'agenouillèrent pour boire » (JDG.7.6) ; kumban ... ciŋan a cìì cɛi « l'aile touchait le mur » (2CH.3.11) ; yinnde n ciŋanin a poola « un feu alimenté d'excréments » (EZK.4.12).</text></form></note>
  </entry>
  <entry id="ciŋiipianduei_522">
    <lexical-unit><form lang="kqs"><text>ciŋiipianduei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="ciŋiipianduei_522_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canine</text></gloss>
      <gloss lang="en"><text>canine tooth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Tyinhiipianduei; Lexique kissi–français, p. 10: ciŋiipianduei</text></form></note>
  </entry>
  <entry id="ciŋiitaaye_523">
    <lexical-unit><form lang="kqs"><text>ciŋiitaaye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="ciŋiitaaye_523_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>molaire</text></gloss>
      <gloss lang="en"><text>molar tooth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Tyinhiitaaye; Lexique kissi–français, p. 10: ciŋiitaaye</text></form></note>
  </entry>
  <entry id="ciŋikiolɛi_524">
    <lexical-unit><form lang="kqs"><text>ciŋikiolɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="ciŋikiolɛi_524_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>incisive</text></gloss>
      <gloss lang="en"><text>incisor</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Tyinhikiolèi; Lexique kissi–français, p. 10: ciŋikiolɛi</text></form></note>
  </entry>
  <entry id="ciŋilanndo_525">
    <lexical-unit><form lang="kqs"><text>ciŋilanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ciŋilan</text></form></variant>
    <sense id="ciŋilanndo_525_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lutter, se battre (corps à corps)</text></gloss>
      <gloss lang="en"><text>wrestle, struggle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.30.8</text></form></note>
  </entry>
  <entry id="ciŋnde_526">
    <lexical-unit><form lang="kqs"><text>ciŋnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ciŋndon</text></form></field>
    <sense id="ciŋnde_526_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dent</text></gloss>
      <gloss lang="en"><text>tooth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tooth, tusk</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first EXO.21.24; Keita 1979, p. 132: Tyinnde; Lexique kissi–français, p. 10: cinnde; Childs 2000, p. 49: cìŋndé</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit cinnde et ciŋi (devant un adjectif) « la dent » (p. 10).</text></form></note>
  </entry>
  <entry id="ciŋun kamaa_527">
    <lexical-unit><form lang="kqs"><text>ciŋun kamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciŋun kamaa_527_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ivoire</text></gloss>
      <gloss lang="en"><text>ivory</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyinhii kamaa; Lexique kissi–français, p. 10: ciŋii kamaa</text></form></note>
    <note><form lang="fr"><text>Litt. « dents d'éléphant ». Keita a le singulier (ciŋii kamaa) ; la Bible le pluriel ciŋun kamaa.</text></form></note>
  </entry>
  <entry id="cìŋɔ́léŋ_528">
    <lexical-unit><form lang="kqs"><text>cìŋɔ́léŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cìŋúáŋ</text></form></field>
    <sense id="cìŋɔ́léŋ_528_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flèche à un seul barbillon ; mèche (de foret)</text></gloss>
      <gloss lang="en"><text>single-barbed arrow; drill bit</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 49: cìŋɔ́léŋ</text></form></note>
  </entry>
  <entry id="ciɛi_529">
    <lexical-unit><form lang="kqs"><text>ciɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ciɛɔn</text></form></field>
    <sense id="ciɛi_529_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champ, terre cultivée</text></gloss>
      <gloss lang="en"><text>field, farmland</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>farm, orchard, rice paddy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.4.3; Lexique kissi–français, p. 9: cɛɛi; Childs 2000, p. 43: cìèí</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit cɛɛi « le champ » (p. 9).</text></form></note>
  </entry>
  <entry id="ciɛi_530">
    <lexical-unit><form lang="kqs"><text>ciɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciɛi_530_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>hier</text></gloss>
      <gloss lang="en"><text>yesterday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.4.3; Keita 1979, p. 152: Tyièi; Lexique kissi–français, p. 10: ciɛi; Childs 2000, p. 43: cíɛ́í</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi ciɛi dii « hier matin » et ciɛi cɔl « hier soir ». Homonyme de ciɛi « champ ». Le Lexique kissi–français donne aussi cɛi « hier » (p. 9).</text></form></note>
  </entry>
  <entry id="ciɛi cɔl_531">
    <lexical-unit><form lang="kqs"><text>ciɛi cɔl</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ciɛi cɔl_531_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>hier soir</text></gloss>
      <gloss lang="en"><text>last night, yesterday evening</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 9: ciei cɔl</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit ciei ; ciɛi « hier » dans la Bible.</text></form></note>
  </entry>
  <entry id="ciɛi dii_532">
    <lexical-unit><form lang="kqs"><text>ciɛi dii</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ciɛi dii_532_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>hier matin</text></gloss>
      <gloss lang="en"><text>yesterday morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 9: ciei dii</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit ciei ; ciɛi « hier » dans la Bible.</text></form></note>
  </entry>
  <entry id="co_533">
    <lexical-unit><form lang="kqs"><text>co</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="co_533_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être ; auxiliaire du progressif</text></gloss>
      <gloss lang="en"><text>be; progressive auxiliary</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also future auxiliary</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18903 occurrences, first GEN.1.7; Lexique kissi–français, p. 10: co; Childs 2000, p. 50: cò</text></form></note>
  </entry>
  <entry id="cobe_534">
    <lexical-unit><form lang="kqs"><text>cobe</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cobe_534_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(o lo cɔɔlu cobe) presque, peu s'en faut ; sur le point de ; un petit peu</text></gloss>
      <gloss lang="en"><text>(o lo cɔɔlu cobe) almost, nearly; about to; a little bit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.26.10; Lexique kissi–français, p. 10: cobe</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 10 : « un petit peu ».</text></form></note>
  </entry>
  <entry id="cóé-ꜜcóé_535">
    <lexical-unit><form lang="kqs"><text>cóé-ꜜcóé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cóé-ꜜcóé_535_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, à petits pas rapides</text></gloss>
      <gloss lang="en"><text>quickly, with quick small steps</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 50: cóé-ꜜcóé</text></form></note>
  </entry>
  <entry id="cokaacoo_536">
    <lexical-unit><form lang="kqs"><text>cokaacoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cokaacoo_536_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crapaud</text></gloss>
      <gloss lang="en"><text>toad</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>toad, frog</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyokaatyoo; Lexique kissi–français, p. 10: cokacoo; Childs 2000, p. 51: còkáácòó</text></form></note>
  </entry>
  <entry id="cólló_537">
    <lexical-unit><form lang="kqs"><text>cólló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cóltáŋ</text></form></field>
    <sense id="cólló_537_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-ventre ; (pl.) estomacs</text></gloss>
      <gloss lang="en"><text>lower stomach; (pl.) stomachs</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: cólló</text></form></note>
  </entry>
  <entry id="colɔɔ_538">
    <lexical-unit><form lang="kqs"><text>colɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cal</text></form></variant>
    <sense id="colɔɔ_538_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mordre</text></gloss>
      <gloss lang="en"><text>bite</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: colɔɔ</text></form></note>
    <note><form lang="fr"><text>Radical cal (p. 8). La Bible dit lɔwviaa « mordre ». Homographe de colɔɔ « couper ».</text></form></note>
  </entry>
  <entry id="colɔɔ_539">
    <lexical-unit><form lang="kqs"><text>colɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>colu</text></form></variant>
    <variant><form lang="kqs"><text>calu</text></form></variant>
    <sense id="colɔɔ_539_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper ; (colu) se couper</text></gloss>
      <gloss lang="en"><text>cut; (colu) cut oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: corɔɔ/ coru</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r (corɔɔ/ coru, caru p. 8) ; la Bible écrit toujours l. Homographe de colɔɔ « mordre ».</text></form></note>
  </entry>
  <entry id="còmbèí_540">
    <lexical-unit><form lang="kqs"><text>còmbèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còmbǎŋ</text></form></field>
    <sense id="còmbèí_540_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>organes génitaux féminins (mot évité en présence d'hommes)</text></gloss>
      <gloss lang="en"><text>female genitals (word avoided in mixed company)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: còmbèí</text></form></note>
  </entry>
  <entry id="condei_541">
    <lexical-unit><form lang="kqs"><text>condei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>condon</text></form></field>
    <variant><form lang="kqs"><text>condii</text></form></variant>
    <variant><form lang="kqs"><text>condun</text></form></variant>
    <sense id="condei_541_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chant, cantique</text></gloss>
      <gloss lang="en"><text>song</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first EXO.15; Lexique kissi–français, p. 10: condei; Childs 2000, p. 51: còndúŋ</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français glose condei « chanter » et condie « la chanson ; la ballade » (p. 10).</text></form></note>
  </entry>
  <entry id="condu_542">
    <lexical-unit><form lang="kqs"><text>condu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="condu_542_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chanter</text></gloss>
      <gloss lang="en"><text>sing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first DEU.31; Lexique kissi–français, p. 10: condu; Childs 2000, p. 51: còndèí</text></form></note>
    <note><form lang="fr"><text>La solul Hala condon, la condu ! « chantez à Dieu, chantez ! » (PSA.47.7) ; voir condei « chant ».</text></form></note>
  </entry>
  <entry id="condɔ_543">
    <lexical-unit><form lang="kqs"><text>condɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="condɔ_543_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>dur, difficile</text></gloss>
      <gloss lang="en"><text>hard, difficult</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: condɔ</text></form></note>
  </entry>
  <entry id="congòó_544">
    <lexical-unit><form lang="kqs"><text>congòó</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>congu</text></form></variant>
    <variant><form lang="kqs"><text>cóngù</text></form></variant>
    <sense id="congòó_544_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>médire de, calomnier, dénigrer ; critiquer</text></gloss>
      <gloss lang="en"><text>slander, speak ill of, backbite; criticize</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, backbite; send a message; bid farewell; bet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.49.15; Lexique kissi–français, p. 10: congɔɔ; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>la cal puapilɛa niaa congòó « tu dénigres tes frères » (PSA.50.20) ; La cóngù vanaa niaa ... le « ne calomnie pas » (LEV.19.16) ; la congan vellaa-velle le « ne médisez pas les uns des autres » (JAS.4.11). Voir congɔnndo « prendre congé ». Lexique kissi–français, p. 10 : congɔɔ/ congu « calomnier, diffamer ; critiquer ».</text></form></note>
  </entry>
  <entry id="congoo_545">
    <lexical-unit><form lang="kqs"><text>congoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>congulan</text></form></field>
    <variant><form lang="kqs"><text>congú</text></form></variant>
    <sense id="congoo_545_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épaule ; bras</text></gloss>
      <gloss lang="en"><text>shoulder; arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shoulder, upper arm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.49.15; Keita 1979, p. 132: Tyonguo; Lexique kissi–français, p. 10: conguo; Childs 2000, p. 52: còŋgóó</text></form></note>
    <note><form lang="fr"><text>o congú « sur l'épaule » (Gn 21,14). Le Lexique kissi–français écrit conguo « le bras, l'épaule » et congu tumndo « l'épaule » (p. 10).</text></form></note>
  </entry>
  <entry id="congulan_546">
    <lexical-unit><form lang="kqs"><text>congulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congulan_546_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médisances, calomnies</text></gloss>
      <gloss lang="en"><text>slander, malicious gossip</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.28.7; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>Pluriel de congòó. À distinguer de congúlan « épaules ».</text></form></note>
  </entry>
  <entry id="congɔnndo_547">
    <lexical-unit><form lang="kqs"><text>congɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congɔnndo_547_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre congé (de), dire adieu ; envoyer un message</text></gloss>
      <gloss lang="en"><text>take leave (of), bid farewell; send a message</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, backbite; send a message; bid farewell, wave goodbye; bet, gamble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.28.6; Lexique kissi–français, p. 10: congɔnndo/ congun; Childs 2000, p. 52: còŋgòó</text></form></note>
    <note><form lang="fr"><text>le X congɔnndo « pour prendre congé de X » ; David yɔngu congɔnndo « David envoya un message » (2 S 11,6). Réciproque congan « se dire adieu » (Ac 21,6), « médire les uns des autres » (Jc 4,11). Lexique kissi–français, p. 10 : « faire ses commissions (recommandations) avant le départ ».</text></form></note>
  </entry>
  <entry id="congɔɔ_548">
    <lexical-unit><form lang="kqs"><text>congɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="congɔɔ_548_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder (un animal confié)</text></gloss>
      <gloss lang="en"><text>keep (livestock entrusted to one), look after</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>keep or raise livestock for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EXO.22.9; Childs 2000, p. 52: còŋgɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cɔlu súú-súù congɔɔ « tout animal confié à garder » (EXO.22.9). Seule occurrence.</text></form></note>
  </entry>
  <entry id="connun_549">
    <lexical-unit><form lang="kqs"><text>connun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="connun_549_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se porter bien ; être en repos</text></gloss>
      <gloss lang="en"><text>be well; be at rest</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
      <trait name="semantic-domain-ddp4" value="2.4.5 Rest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.43.28</text></form></note>
  </entry>
  <entry id="coo_550">
    <lexical-unit><form lang="kqs"><text>coo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coo_550_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sur (o … coo)</text></gloss>
      <gloss lang="en"><text>on (o … coo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7185 occurrences, first GEN.1.2; Lexique kissi–français, p. 10: coo; Childs 2000, p. 53: còó</text></form></note>
  </entry>
  <entry id="coo_551">
    <lexical-unit><form lang="kqs"><text>coo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="coo_551_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat</text></gloss>
      <gloss lang="en"><text>rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: coo</text></form></note>
    <note><form lang="fr"><text>Homographe de coo « sur » ; peut-être forme courte de cowvo « rat palmiste ». À confirmer.</text></form></note>
  </entry>
  <entry id="còó_552">
    <lexical-unit><form lang="kqs"><text>còó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còó_552_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel, temps (météo) ; art de grimper aux palmiers</text></gloss>
      <gloss lang="en"><text>sky, weather; the art of climbing palm trees</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còó</text></form></note>
  </entry>
  <entry id="coocoo_553">
    <lexical-unit><form lang="kqs"><text>coocoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="coocoo_553_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en haut, au-dessus, dans les airs</text></gloss>
      <gloss lang="en"><text>up, above, in the air</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>far up; also loudly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 313 occurrences, first GEN.1.20; Lexique kissi–français, p. 10: coo-coo; Childs 2000, p. 53: cóó-cóó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit coo-coo (p. 10).</text></form></note>
  </entry>
  <entry id="còòlan_554">
    <lexical-unit><form lang="kqs"><text>còòlan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="còòlan_554_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mensonge(s)</text></gloss>
      <gloss lang="en"><text>lies, falsehood</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 108 occurrences, first GEN.42.12; Lexique kissi–français, p. 10: coolan; Childs 2000, p. 53: còòláŋ</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi cowva « mensonge » (p. 10).</text></form></note>
  </entry>
  <entry id="còòlúŋndó_555">
    <lexical-unit><form lang="kqs"><text>còòlúŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còòlúŋndó_555_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre très inflammable (écorce contre la toux et pour des remèdes)</text></gloss>
      <gloss lang="en"><text>highly flammable tree (bark used against cough and in potions)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còòlúŋndó</text></form></note>
  </entry>
  <entry id="còòmáánɔ̀ɔ́_556">
    <lexical-unit><form lang="kqs"><text>còòmáánɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="còòmáánɔ̀ɔ́_556_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur de sorciers</text></gloss>
      <gloss lang="en"><text>witch hunter, one who kills witches</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: còòmáánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="còòwàá_557">
    <lexical-unit><form lang="kqs"><text>còòwàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="còòwàá_557_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vanter, fanfaronner</text></gloss>
      <gloss lang="en"><text>boast, brag, show off</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còòwàá</text></form></note>
  </entry>
  <entry id="còòwó_558">
    <lexical-unit><form lang="kqs"><text>còòwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còòwáŋ</text></form></field>
    <sense id="còòwó_558_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à baies rouges comestibles (tiges pour filets de pêche)</text></gloss>
      <gloss lang="en"><text>plant with edible red berries (stems used for fishing nets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còòwó</text></form></note>
  </entry>
  <entry id="copio_559">
    <lexical-unit><form lang="kqs"><text>copio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="copio_559_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil (arboricole)</text></gloss>
      <gloss lang="en"><text>tree squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 10: copio; Childs 2000, p. 54: còpìó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 10 (« un genre d'écureuil »). Pluriel en kissi du Sud (Childs 2000) : còpìá.</text></form></note>
  </entry>
  <entry id="còúléŋ_560">
    <lexical-unit><form lang="kqs"><text>còúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còúwé</text></form></field>
    <sense id="còúléŋ_560_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre-liane à baies non comestibles (fibres pour filets)</text></gloss>
      <gloss lang="en"><text>vine-like tree with inedible berries (fibre used for nets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còúléŋ</text></form></note>
  </entry>
  <entry id="còúwó_561">
    <lexical-unit><form lang="kqs"><text>còúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còúwá</text></form></field>
    <sense id="còúwó_561_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tique</text></gloss>
      <gloss lang="en"><text>tick</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: còúwó</text></form></note>
  </entry>
  <entry id="cowvo_562">
    <lexical-unit><form lang="kqs"><text>cowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cow</text></form></variant>
    <sense id="cowvo_562_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>construire, bâtir (un autel) ; fabriquer (une idole, des armes) ; créer</text></gloss>
      <gloss lang="en"><text>build (an altar); make (an idol, weapons); create</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.20.25</text></form></note>
    <note><form lang="fr"><text>Cow ya fondala-loamaa-lasálàlan tan ŋɔmmɛw « bâtis-moi sept autels » (Nb 23,1) ; ɲɛm cɔwvon cowvo « fabriquer des armes » (1 S 8,12) ; halaa cow halataala a lɛŋnden te « les dieux qui n'ont pas fait le ciel et la terre » (Jr 10,11). Homonyme de cowvo « rat palmiste » (Keita).</text></form></note>
  </entry>
  <entry id="cowvo_563">
    <lexical-unit><form lang="kqs"><text>cowvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cowvo_563_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat palmiste</text></gloss>
      <gloss lang="en"><text>ground squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a large rat; opossum (Liberian English)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tyowvo; Lexique kissi–français, p. 11: cowvo; Childs 2000, p. 54: còúwó</text></form></note>
    <note><form lang="fr"><text>Homonyme du verbe cowvo « construire, fabriquer » de la Bible (Ex 20,25 ; 1 S 8,12).</text></form></note>
  </entry>
  <entry id="coyaa_564">
    <lexical-unit><form lang="kqs"><text>coyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>coya</text></form></variant>
    <sense id="coyaa_564_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, ramasser (des fruits)</text></gloss>
      <gloss lang="en"><text>gather, pick up (fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: coyaa/ coya</text></form></note>
  </entry>
  <entry id="coŋ_565">
    <lexical-unit><form lang="kqs"><text>coŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>coŋnin</text></form></variant>
    <sense id="coŋ_565_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se répandre, envahir, couvrir ; déborder</text></gloss>
      <gloss lang="en"><text>spread over, swarm, cover; overflow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, overflow; throw away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.8.2; Childs 2000, p. 52: còŋndó</text></form></note>
  </entry>
  <entry id="cóŋ-cóŋ_566">
    <lexical-unit><form lang="kqs"><text>cóŋ-cóŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cóŋ-cóŋ_566_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, en hâte</text></gloss>
      <gloss lang="en"><text>quickly, hurriedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: cóŋ-cóŋ</text></form></note>
  </entry>
  <entry id="còŋgáŋcòó_567">
    <lexical-unit><form lang="kqs"><text>còŋgáŋcòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>còŋgáŋcòláŋ</text></form></field>
    <sense id="còŋgáŋcòó_567_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeu ou acrobatie à cloche-pied</text></gloss>
      <gloss lang="en"><text>game or stunt of hopping on one leg</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 51: còŋgáŋcòó</text></form></note>
  </entry>
  <entry id="cóŋgúéíyó_568">
    <lexical-unit><form lang="kqs"><text>cóŋgúéíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cóŋgúéíyó_568_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau émaillé (pour l'eau, le latex)</text></gloss>
      <gloss lang="en"><text>enamel bucket (for water, latex)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 52: cóŋgúéíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt au mende sonɡoi (?).</text></form></note>
  </entry>
  <entry id="cóŋŋáŋ-_569">
    <lexical-unit><form lang="kqs"><text>cóŋŋáŋ-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cóŋŋáŋ-_569_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grand, haut, énorme (d'un animal)</text></gloss>
      <gloss lang="en"><text>tall, big, huge (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 53: cóŋŋáŋ-</text></form></note>
  </entry>
  <entry id="cû_570">
    <lexical-unit><form lang="kqs"><text>cû</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cû_570_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lourdement, durement (en tombant)</text></gloss>
      <gloss lang="en"><text>hard, heavily (of falling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cû</text></form></note>
  </entry>
  <entry id="cua_571">
    <lexical-unit><form lang="kqs"><text>cua</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuaa</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <sense id="cua_571_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre ; (cua haki) commettre (un péché)</text></gloss>
      <gloss lang="en"><text>take; (cua haki) commit (a sin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take; also carry, lift; take in marriage</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1496 occurrences, first GEN.2.15; Childs 2000, p. 60: cùàá</text></form></note>
  </entry>
  <entry id="cua mamaa_572">
    <lexical-unit><form lang="kqs"><text>cua mamaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cua mamaa_572_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit-fils, petite-fille</text></gloss>
      <gloss lang="en"><text>grandchild</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Tyua mamaa; Lexique kissi–français, p. 11: cua mamaa; Childs 2000, p. 60: cùàà-màmàá</text></form></note>
    <note><form lang="fr"><text>Sens confirmé par Childs (cùàà-màmàá). Dans la Bible, mamaa désigne l'aïeul (Gn 28,13) et cuavaa-imamaa « les descendants ». Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="cua mandaa_573">
    <lexical-unit><form lang="kqs"><text>cua mandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cua mandaa_573_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>adopter (un enfant)</text></gloss>
      <gloss lang="en"><text>adopt (a child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cua mandaa</text></form></note>
  </entry>
  <entry id="cúà-cúà_574">
    <lexical-unit><form lang="kqs"><text>cúà-cúà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúà-cúà_574_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du débroussaillage à la machette ; de pierres lancées une à une</text></gloss>
      <gloss lang="en"><text>sound of clearing brush with machetes; of stones thrown one by one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cúà-cúà</text></form></note>
  </entry>
  <entry id="cuaa_575">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuavaa</text></form></field>
    <variant><form lang="kqs"><text>cuawva</text></form></variant>
    <sense id="cuaa_575_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enfant ; la femme (dont on parle) ; (pl.) enfants, descendants</text></gloss>
      <gloss lang="en"><text>child; the woman (in question); (pl.) children, descendants</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl, daughter, young woman, woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 270 occurrences, first GEN.3.13; Lexique kissi–français, p. 11: cua; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>Au singulier, la Bible emploie cuaa surtout pour « la femme » dont il est question (Gn 3,13 ; 1 S 1,26 ; 2 R 8,6) ; le pluriel cuavaa / cuawva signifie « enfants, descendants ». À vérifier auprès de locuteurs.</text></form></note>
  </entry>
  <entry id="cuaa_576">
    <lexical-unit><form lang="kqs"><text>cuaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cua</text></form></variant>
    <variant><form lang="kqs"><text>cue</text></form></variant>
    <variant><form lang="kqs"><text>cuanin</text></form></variant>
    <variant><form lang="kqs"><text>cuenin</text></form></variant>
    <sense id="cuaa_576_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre</text></gloss>
      <gloss lang="en"><text>take</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take, carry or lift</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Tyuaa; Lexique kissi–français, p. 11: cuaa/ cua, cue; Childs 2000, p. 60: cùàá</text></form></note>
    <note><form lang="fr"><text>cua est très courant (GEN 2,15) ; cue, cuenin : radical négatif. La forme longue cuaa de la Bible a surtout d'autres sens (« femme », GEN 3,13). Le Lexique kissi–français, p. 11, glose cuaa/ cua, cue « tenir ; apporter ; porter, prendre ».</text></form></note>
  </entry>
  <entry id="cùààmàwùèìyó_577">
    <lexical-unit><form lang="kqs"><text>cùààmàwùèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùààmàwùèìyó_577_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à bois dur (bois de chauffe, construction)</text></gloss>
      <gloss lang="en"><text>hardwood tree (firewood, building)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmàwùèìyó</text></form></note>
  </entry>
  <entry id="cùààmbɔ́-féléŋɔ́ɔ́_578">
    <lexical-unit><form lang="kqs"><text>cùààmbɔ́-féléŋɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùààmbɔ́-féléŋɔ́ɔ́_578_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme jeune ou d'âge mûr</text></gloss>
      <gloss lang="en"><text>young to middle-aged woman</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmbɔ́-féléŋɔ́ɔ́</text></form></note>
  </entry>
  <entry id="cuaambɔyɛi_579">
    <lexical-unit><form lang="kqs"><text>cuaambɔyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="cuaambɔyɛi_579_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunesse</text></gloss>
      <gloss lang="en"><text>youth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.46.34</text></form></note>
  </entry>
  <entry id="cùààmbɔ̀yɛ́í-_580">
    <lexical-unit><form lang="kqs"><text>cùààmbɔ̀yɛ́í-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùààmbɔ̀yɛ́í-_580_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>puéril, enfantin (d'un adulte)</text></gloss>
      <gloss lang="en"><text>childish (of an adult)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 60: cùààmbɔ̀yɛ́í-</text></form></note>
  </entry>
  <entry id="cuaambɔɔ_581">
    <lexical-unit><form lang="kqs"><text>cuaambɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuaambɔa</text></form></field>
    <variant><form lang="kqs"><text>cuaambɔ</text></form></variant>
    <sense id="cuaambɔɔ_581_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune fille, fille ; jeune (personne) ; jeune (garçon ou fille), jeune fille ; enfant</text></gloss>
      <gloss lang="en"><text>girl, young woman; young person; child</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.16.5; Keita 1979, p. 148: Tyuaamböö; Lexique kissi–français, p. 11: cuaanbɔɔ; Childs 2000, p. 61: cùààmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « l'enfant » ; dans la Bible, surtout « jeune fille » (Rébecca, Gn 24,18), opposé à kaasonɔɔ « adulte ». Le Lexique kissi–français écrit cuaanbɔɔ « (le) enfant » (p. 11) et cuanbɔa « les enfants » (p. 12).</text></form></note>
  </entry>
  <entry id="cualen_582">
    <lexical-unit><form lang="kqs"><text>cualen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="cualen_582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit (d'un animal), nouveau-né ; fillette</text></gloss>
      <gloss lang="en"><text>young (of an animal), newborn; little girl</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fetus; small (female) child</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.22.27; Keita 1979, p. 35: Tyualen; Childs 2000, p. 61: cùàléŋ</text></form></note>
    <note><form lang="fr"><text>cualen le bɛnda mì le lo kala ndɔ ikɛi « le petit restera avec sa mère » (LEV.22.27) ; un lionceau (EZK.19.5). Keita : Tyualen = Tyuaa + len « fillette ».</text></form></note>
  </entry>
  <entry id="cuan bɛngulen_583">
    <lexical-unit><form lang="kqs"><text>cuan bɛngulen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cuan bɛngulen_583_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piège</text></gloss>
      <gloss lang="en"><text>trap</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuan bɛngulen</text></form></note>
  </entry>
  <entry id="cuanndo_584">
    <lexical-unit><form lang="kqs"><text>cuanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuanndo_584_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ma fille (en s'adressant à une jeune femme)</text></gloss>
      <gloss lang="en"><text>daughter, my daughter (in address)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>girl, daughter</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JDG.11.35; Childs 2000, p. 61: cùàŋndó</text></form></note>
    <note><form lang="fr"><text>Toujours en apostrophe : Noémi et Boaz à Ruth (RUT.2.2, RUT.3.10), Jephté à sa fille (JDG.11.35).</text></form></note>
  </entry>
  <entry id="cùcúŋkàá_585">
    <lexical-unit><form lang="kqs"><text>cùcúŋkàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùcúŋkèí</text></form></field>
    <sense id="cùcúŋkàá_585_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de petit arbre</text></gloss>
      <gloss lang="en"><text>species of small tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 61: cùcúŋkàá</text></form></note>
  </entry>
  <entry id="cucɔɔ_586">
    <lexical-unit><form lang="kqs"><text>cucɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cucu</text></form></variant>
    <variant><form lang="kqs"><text>cucunin</text></form></variant>
    <sense id="cucɔɔ_586_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répandre, faire tomber (en pluie, en rosée) ; saupoudrer (l'encens)</text></gloss>
      <gloss lang="en"><text>pour down, drop (like rain, dew); sprinkle (incense)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first EXO.7.27; Lexique kissi–français, p. 12: cucɔɔ/ cucu</text></form></note>
  </entry>
  <entry id="cùè-mà-kìálláŋ_587">
    <lexical-unit><form lang="kqs"><text>cùè-mà-kìálláŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-mà-kìálláŋ_587_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« herbe du cerf », herbe des marécages</text></gloss>
      <gloss lang="en"><text>"deer grass", a swamp grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-mà-kìálláŋ</text></form></note>
  </entry>
  <entry id="cùè-mà-pèúwáŋ_588">
    <lexical-unit><form lang="kqs"><text>cùè-mà-pèúwáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-mà-pèúwáŋ_588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'herbe des marécages</text></gloss>
      <gloss lang="en"><text>species of swamp grass</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-mà-pèúwáŋ</text></form></note>
  </entry>
  <entry id="cùè-pèèyé_589">
    <lexical-unit><form lang="kqs"><text>cùè-pèèyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="cùè-pèèyé_589_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante médicinale des bords de ruisseau (feuilles pour envelopper un nouveau-né mort) ; cet enfant mort</text></gloss>
      <gloss lang="en"><text>medicinal streamside plant (leaves wrap a dead newborn); such a dead baby</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 62: cùè-pèèyé</text></form></note>
  </entry>
  <entry id="cuei_590">
    <lexical-unit><form lang="kqs"><text>cuei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cueon</text></form></field>
    <sense id="cuei_590_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hache</text></gloss>
      <gloss lang="en"><text>axe</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first DEU.19.5; Keita 1979, p. 160: Tyuei; Lexique kissi–français, p. 12: cuei; Childs 2000, p. 61: cùèí</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi coe « la hache » (p. 10).</text></form></note>
  </entry>
  <entry id="cuello_591">
    <lexical-unit><form lang="kqs"><text>cuello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuel</text></form></variant>
    <sense id="cuello_591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre pour quelqu'un</text></gloss>
      <gloss lang="en"><text>take for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1SA.14.6; Keita 1979, p. 114: Tyuello; Lexique kissi–français, p. 12: cuello/ cuel</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de cuaa (radical cue) : cuel lanɔɔ « prendre une femme pour » (GEN 24,4).</text></form></note>
  </entry>
  <entry id="cùìlló_592">
    <lexical-unit><form lang="kqs"><text>cùìlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cùìlló_592_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porc-épic (espèce à queue touffue)</text></gloss>
      <gloss lang="en"><text>brush-tailed porcupine</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 63: cùìlló</text></form></note>
  </entry>
  <entry id="cuindin_593">
    <lexical-unit><form lang="kqs"><text>cuindin</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cuindin_593_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un petit peu</text></gloss>
      <gloss lang="en"><text>a little bit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuindin</text></form></note>
  </entry>
  <entry id="cuinndo_594">
    <lexical-unit><form lang="kqs"><text>cuinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuinnda</text></form></field>
    <variant><form lang="kqs"><text>cuin</text></form></variant>
    <variant><form lang="kqs"><text>cuinaa</text></form></variant>
    <sense id="cuinndo_594_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chèvre</text></gloss>
      <gloss lang="en"><text>goat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.21.14; Keita 1979, p. 137: Tyuinndo; Lexique kissi–français, p. 12: cuinndo; Childs 2000, p. 63: cùìŋndó</text></form></note>
    <note><form lang="fr"><text>La Bible a aussi le pluriel cuinaa. Le Lexique kissi–français donne aussi cuilinndo « la chèvre » (p. 12).</text></form></note>
  </entry>
  <entry id="cuinun_595">
    <lexical-unit><form lang="kqs"><text>cuinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuinun_595_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se briser, voler en éclats</text></gloss>
      <gloss lang="en"><text>break, shatter (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.32.19</text></form></note>
  </entry>
  <entry id="cuiyo_596">
    <lexical-unit><form lang="kqs"><text>cuiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuiyo_596_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>broyer, écraser, réduire en poussière</text></gloss>
      <gloss lang="en"><text>crush, grind to powder</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 2SA.22.43; Lexique kissi–français, p. 12: cuiyo/ cui; Childs 2000, p. 63: cùìyó</text></form></note>
    <note><form lang="fr"><text>O va dioo a cuiyo « elle dévorait et broyait » (DAN.7.7, DAN.7.19) ; I co nda cuiyo ... maa cundu « je les broie comme la poussière » (2SA.22.43). Moyen : cuinun « se briser ».</text></form></note>
  </entry>
  <entry id="cuiŋi_597">
    <lexical-unit><form lang="kqs"><text>cuiŋi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuiŋi_597_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (un liquide)</text></gloss>
      <gloss lang="en"><text>pour out (a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, pour away; waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.35.14; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cukanioo_598">
    <lexical-unit><form lang="kqs"><text>cukanioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cukani</text></form></variant>
    <sense id="cukanioo_598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuillère</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Tyukanioo; Lexique kissi–français, p. 12: cukanio</text></form></note>
    <note><form lang="fr"><text>La Bible a cukanila n'ciŋndan « fourchettes » (Ex 27,3), avec la forme radicale du pluriel.</text></form></note>
  </entry>
  <entry id="cúkè_599">
    <lexical-unit><form lang="kqs"><text>cúkè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúkè_599_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un petit moment, brièvement</text></gloss>
      <gloss lang="en"><text>for a short while, briefly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúkè</text></form></note>
  </entry>
  <entry id="cúkù-cùkù_600">
    <lexical-unit><form lang="kqs"><text>cúkù-cùkù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúkù-cùkù_600_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un petit poisson qui saute dans l'eau, d'une chose plongée dans l'eau ; de petits trous percés à l'alêne</text></gloss>
      <gloss lang="en"><text>sound of a small fish jumping in water, of something dipped in water; of an awl making small holes</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúkù-cùkù</text></form></note>
  </entry>
  <entry id="cukullo_601">
    <lexical-unit><form lang="kqs"><text>cukullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cukul</text></form></variant>
    <sense id="cukullo_601_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chatouiller ; taquiner, faire rire ; éperonner (un cheval)</text></gloss>
      <gloss lang="en"><text>tickle; tease, make laugh; spur (a horse)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.5 Sense of touch"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cukullo/ cukul; Childs 2000, p. 64: cùkúlló</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 12 (« chatouiller ; éperonner le cheval »).</text></form></note>
  </entry>
  <entry id="cukɔnndo_602">
    <lexical-unit><form lang="kqs"><text>cukɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cukun</text></form></variant>
    <sense id="cukɔnndo_602_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se piquer</text></gloss>
      <gloss lang="en"><text>prick oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Tyukönndo; Lexique kissi–français, p. 12: cukɔnndo/ cukun</text></form></note>
    <note><form lang="fr"><text>Moyen de cukɔɔ.</text></form></note>
  </entry>
  <entry id="cukɔɔ_603">
    <lexical-unit><form lang="kqs"><text>cukɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuku</text></form></variant>
    <sense id="cukɔɔ_603_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer, transpercer</text></gloss>
      <gloss lang="en"><text>prick, pierce</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="7.8.5 Make hole, opening"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>prick (as a thorn)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1SA.19.10; Keita 1979, p. 114: Tyuköö; Lexique kissi–français, p. 12: cukɔɔ/ cuku; Childs 2000, p. 63: cùkàá</text></form></note>
  </entry>
  <entry id="cúlú_604">
    <lexical-unit><form lang="kqs"><text>cúlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cúlú_604_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en glissant facilement (entrer, sortir, plonger)</text></gloss>
      <gloss lang="en"><text>slipping in or out easily, smoothly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 64: cúlú</text></form></note>
  </entry>
  <entry id="cùlùkàá_605">
    <lexical-unit><form lang="kqs"><text>cùlùkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùlùkàá_605_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être glissant, gluant ; rendre glissant</text></gloss>
      <gloss lang="en"><text>be slippery, slimy; make slippery</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 65: cùlùkàá</text></form></note>
  </entry>
  <entry id="cumndo_606">
    <lexical-unit><form lang="kqs"><text>cumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cum</text></form></variant>
    <sense id="cumndo_606_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attendre ; laisser (faire)</text></gloss>
      <gloss lang="en"><text>wait; let, allow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 91 occurrences, first EXO.5.20; Lexique kissi–français, p. 12: cumɔɔ/ cum; Childs 2000, p. 65: cùmndó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi : cumɔɔ.</text></form></note>
  </entry>
  <entry id="cumullo_607">
    <lexical-unit><form lang="kqs"><text>cumullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cumul</text></form></variant>
    <sense id="cumullo_607_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller</text></gloss>
      <gloss lang="en"><text>guard, watch over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>watch something secretly, peep, spy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.3.24; Lexique kissi–français, p. 12: cumullo/ cumul; Childs 2000, p. 66: cùmùlló</text></form></note>
  </entry>
  <entry id="cun_608">
    <lexical-unit><form lang="kqs"><text>cun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cun_608_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>odeur ; (cun kɛndɛ) parfum</text></gloss>
      <gloss lang="en"><text>smell; (cun kɛndɛ) fragrance</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smelly; smell of, stink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 189 occurrences, first GEN.8.21; Lexique kissi–français, p. 12: cunndo; Childs 2000, p. 66: cùnéí-</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit cunndo « (la) odeur » (p. 12).</text></form></note>
  </entry>
  <entry id="cundoo_609">
    <lexical-unit><form lang="kqs"><text>cundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cundu</text></form></variant>
    <sense id="cundoo_609_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poussière</text></gloss>
      <gloss lang="en"><text>dust</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 53 occurrences, first GEN.3.14; Keita 1979, p. 155: Tyunduo; Lexique kissi–français, p. 12: cundoo; Childs 2000, p. 66: cúndóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Tyunduo ; la Bible cundoo. Le Lexique kissi–français donne aussi cunduo « la poussière » (p. 12).</text></form></note>
  </entry>
  <entry id="cùndòó_610">
    <lexical-unit><form lang="kqs"><text>cùndòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùndùá</text></form></field>
    <sense id="cùndòó_610_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand oiseau noir, roux et blanc qui mange les serpents et chante à l'aube</text></gloss>
      <gloss lang="en"><text>large black, russet and white bird that eats snakes and calls at dawn</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 66: cùndòó</text></form></note>
    <note><form lang="fr"><text>Appelé « time bird » en anglais du Libéria.</text></form></note>
  </entry>
  <entry id="cunndo_611">
    <lexical-unit><form lang="kqs"><text>cunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cunndo_611_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sentir, dégager une odeur ; puer</text></gloss>
      <gloss lang="en"><text>smell, give off a smell; stink</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.4 Smell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.27.27; Childs 2000, p. 66: cùŋndo</text></form></note>
    <note><form lang="fr"><text>O co nin cunndo fulaa « il sent déjà » (JHN.11.39) ; i co cunndo kuí-kuí « je pue » (PSA.38.6) ; aussi en bonne part : Po nuu co cunndo ... « l'odeur de mon fils » (GEN.27.27). Voir cun « odeur ».</text></form></note>
  </entry>
  <entry id="cúo_612">
    <lexical-unit><form lang="kqs"><text>cúo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cu</text></form></variant>
    <sense id="cúo_612_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piler, moudre (au mortier)</text></gloss>
      <gloss lang="en"><text>pound, grind (in a mortar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="7.7.6 Grind"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.24.41; Lexique kissi–français, p. 12: cuo/ cu</text></form></note>
  </entry>
  <entry id="cùó_613">
    <lexical-unit><form lang="kqs"><text>cùó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cùléŋ</text></form></field>
    <sense id="cùó_613_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cuillère, louche</text></gloss>
      <gloss lang="en"><text>spoon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùó</text></form></note>
  </entry>
  <entry id="cùùlán_614">
    <lexical-unit><form lang="kqs"><text>cùùlán</text></form></lexical-unit>
    <trait name="noun-class" value="la"/>
    <trait name="status" value="southern"/>
    <sense id="cùùlán_614_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadeaux</text></gloss>
      <gloss lang="en"><text>presents, gifts</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 67: cùùlán</text></form></note>
  </entry>
  <entry id="cuuloo_615">
    <lexical-unit><form lang="kqs"><text>cuuloo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>cuulu</text></form></variant>
    <variant><form lang="kqs"><text>cuulunin</text></form></variant>
    <sense id="cuuloo_615_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter en épi, pousser ; être consumé, dépérir ; être glissant</text></gloss>
      <gloss lang="en"><text>come into ear, sprout; be consumed, waste away; be slippery</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tiller, produce grain (rice); also be slimy, slippery</text></form></field>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuuluo/ cuulu; Childs 2000, p. 67: cùùlòó</text></form></note>
    <note><form lang="fr"><text>Deux emplois : épis (Gn 41,5-6 ; Ex 9,31) et « consumer » (yinnden … cuulu mungén, Ps 106,18 ; paalan la cuulu ya « mes os se consument », Ps 31,11). Lexique kissi–français, p. 12 : cuuluo/ cuulu « être glissant » (Childs donne aussi ce sens).</text></form></note>
  </entry>
  <entry id="cùùmɔ̀ɔ́_616">
    <lexical-unit><form lang="kqs"><text>cùùmɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùmɔ̀ɔ́_616_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sonner, tinter (clochette)</text></gloss>
      <gloss lang="en"><text>ring (of a bell)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 68: cùùmɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cuungiaa_617">
    <lexical-unit><form lang="kqs"><text>cuungiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuungiaanin</text></form></variant>
    <sense id="cuungiaa_617_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, réunir ; accumuler</text></gloss>
      <gloss lang="en"><text>gather, assemble; accumulate</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gather, collect; also contribute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 175 occurrences, first GEN.9.14; Lexique kissi–français, p. 12: cuungiaa/ cuungia; Childs 2000, p. 68: cùùŋgìá</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi cungia « assembler, rassembler » (p. 12).</text></form></note>
  </entry>
  <entry id="cuungian_618">
    <lexical-unit><form lang="kqs"><text>cuungian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuungian_618_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rassembler, se réunir ; s'accumuler</text></gloss>
      <gloss lang="en"><text>gather, come together; accumulate (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 147 occurrences, first GEN.14.8; Lexique kissi–français, p. 12: cuungianndo/ cuungian</text></form></note>
    <note><form lang="fr"><text>Moyen de cuungiaa « rassembler ». Le Lexique kissi–français donne aussi cungianndo/ cungian « se rassembler ; assemblée » (p. 12).</text></form></note>
  </entry>
  <entry id="cuunɔnndo_619">
    <lexical-unit><form lang="kqs"><text>cuunɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuunun</text></form></variant>
    <sense id="cuunɔnndo_619_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'écouler, passer, prendre fin (des jours, de la vie)</text></gloss>
      <gloss lang="en"><text>pass away, run out, come to an end (of days, life)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be used up, be finishing</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.7.16; Childs 2000, p. 68: cùùnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de cuu « finir ». Palɛi nii ... keleŋaa cuunɔnndo « mes jours passent vite » (JOB.9.25) ; Palɛi nii cuunun « mes jours sont finis » (JOB.17.11).</text></form></note>
  </entry>
  <entry id="cuuo_620">
    <lexical-unit><form lang="kqs"><text>cuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuu</text></form></variant>
    <variant><form lang="kqs"><text>cuunin</text></form></variant>
    <sense id="cuuo_620_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, amener</text></gloss>
      <gloss lang="en"><text>bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring; give someone a present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.27.5; Lexique kissi–français, p. 12: cuɔ/ cuu; Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cùùwó_621">
    <lexical-unit><form lang="kqs"><text>cùùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùwó_621_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>offrir, apporter un cadeau à qqn</text></gloss>
      <gloss lang="en"><text>give a present, bring as a gift</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cùùwó_622">
    <lexical-unit><form lang="kqs"><text>cùùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùùwó_622_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>émousser</text></gloss>
      <gloss lang="en"><text>make dull, blunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
  <entry id="cuuŋuuo_623">
    <lexical-unit><form lang="kqs"><text>cuuŋuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuuŋuu</text></form></variant>
    <variant><form lang="kqs"><text>cuuŋuunin</text></form></variant>
    <sense id="cuuŋuuo_623_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>verser, répandre (sang, eau)</text></gloss>
      <gloss lang="en"><text>pour out (blood, water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spill, throw (a liquid) away, waste</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2KI.3.11; Childs 2000, p. 63: cùìŋìó</text></form></note>
  </entry>
  <entry id="cuvɔɔ_624">
    <lexical-unit><form lang="kqs"><text>cuvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuvɔɔ_624_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>finir, s'achever ; fin ; (X cuvɔɔ) après X</text></gloss>
      <gloss lang="en"><text>finish, come to an end; end; (X cuvɔɔ) after X</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="8.6.7 End, point"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be finished, used up; auxiliary of completion</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.22.19; Childs 2000, p. 69: cùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Biisi Yosue-o cuvɔɔ « après la mort de Josué » (Jg 1,1) ; niaa co cuvɔɔ vu « vous finirez par mourir » (Nb 14,32).</text></form></note>
  </entry>
  <entry id="cùwɔ̀ɔ́_625">
    <lexical-unit><form lang="kqs"><text>cùwɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cùwɔ̀ɔ́_625_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter à terre, renverser</text></gloss>
      <gloss lang="en"><text>throw down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 69: cùwɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cuŋinndo_626">
    <lexical-unit><form lang="kqs"><text>cuŋinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cuŋin</text></form></variant>
    <sense id="cuŋinndo_626_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se répandre, s'écouler (comme de l'eau)</text></gloss>
      <gloss lang="en"><text>pour out, flow (like water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuŋinndo/ cuŋin</text></form></note>
    <note><form lang="fr"><text>Moyen de cuŋio.</text></form></note>
  </entry>
  <entry id="cuŋio_627">
    <lexical-unit><form lang="kqs"><text>cuŋio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cuŋ</text></form></variant>
    <sense id="cuŋio_627_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter (de l'eau, des restes), vider, verser</text></gloss>
      <gloss lang="en"><text>throw out (water, leftovers), empty, pour</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuŋio/ cuŋ</text></form></note>
    <note><form lang="fr"><text>Comparer cuiŋi « verser, répandre » (Bible).</text></form></note>
  </entry>
  <entry id="cuɛi-cuɛi_628">
    <lexical-unit><form lang="kqs"><text>cuɛi-cuɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cuɛi-cuɛi_628_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>souvent, régulièrement</text></gloss>
      <gloss lang="en"><text>often, regularly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4 Time"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.3.1; Lexique kissi–français, p. 12: cuɛi-cuɛi</text></form></note>
  </entry>
  <entry id="cuɛima siaŋan_629">
    <lexical-unit><form lang="kqs"><text>cuɛima siaŋan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cuɛima siaŋan_629_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>huile de palme rouge</text></gloss>
      <gloss lang="en"><text>red palm oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 12: cuɛima saŋan</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit saŋan ; la Bible écrit siaŋan « rouge » (mɔima siaŋan « vin rouge », GEN.49.12).</text></form></note>
  </entry>
  <entry id="cuɛinanndo_630">
    <lexical-unit><form lang="kqs"><text>cuɛinanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cuɛinanndan</text></form></field>
    <variant><form lang="kqs"><text>cuɛinan</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinannda</text></form></variant>
    <sense id="cuɛinanndo_630_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vêtement (ɲɛ cuɛinanndo) ; (volɔɔla cuɛinanndan) habits</text></gloss>
      <gloss lang="en"><text>clothing, garment (ɲɛ cuɛinanndo); (volɔɔla cuɛinanndan) clothes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.28.20</text></form></note>
    <note><form lang="fr"><text>De cuɛinun « se vêtir » ; souvent en apposition : volɔɔ cuɛinanndo « vêtement », ɲɛ cuɛinan « vêtement ».</text></form></note>
  </entry>
  <entry id="cuɛinɔnndo_631">
    <lexical-unit><form lang="kqs"><text>cuɛinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛinun</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinɔn</text></form></variant>
    <variant><form lang="kqs"><text>cuɛinunnin</text></form></variant>
    <sense id="cuɛinɔnndo_631_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'habiller, se vêtir, mettre (un vêtement) ; se déguiser</text></gloss>
      <gloss lang="en"><text>dress, put on (clothes); disguise oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.8.4; Lexique kissi–français, p. 12: cuɛinɔnndo/ cuɛinɔn; Childs 2000, p. 62: cùènɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 12 : « s'habiller, se déguiser ».</text></form></note>
  </entry>
  <entry id="cuɛiyan_632">
    <lexical-unit><form lang="kqs"><text>cuɛiyan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cuɛima</text></form></variant>
    <sense id="cuɛiyan_632_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>graisse ; huile ; pommade ; graisse, beurre</text></gloss>
      <gloss lang="en"><text>fat; oil ; oil; ointment ; oil; fat, butter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="5.4.2 Cosmetics"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>oil, palm oil, ointment</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 132 occurrences, first GEN.28.18; Keita 1979, p. 133: Tyuèyan; Lexique kissi–français, p. 12: cuɛiyan; Childs 2000, p. 62: cùɛ̀ìyáŋ</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi cuɛyan « la graisse » (p. 12).</text></form></note>
  </entry>
  <entry id="cɔ_633">
    <lexical-unit><form lang="kqs"><text>cɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="cɔ_633_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être épais, large</text></gloss>
      <gloss lang="en"><text>be thick, wide</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔ</text></form></note>
    <note><form lang="fr"><text>Homographe de cɔ « voir » ; sens à confirmer.</text></form></note>
  </entry>
  <entry id="cɔ̂_634">
    <lexical-unit><form lang="kqs"><text>cɔ̂</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̂_634_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un coup de coupe-coupe ou d'une morsure</text></gloss>
      <gloss lang="en"><text>sound of chopping or biting</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: cɔ̂</text></form></note>
  </entry>
  <entry id="cɔ́-cɔ́_635">
    <lexical-unit><form lang="kqs"><text>cɔ́-cɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔ́-cɔ́_635_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, rapidement, sans tarder</text></gloss>
      <gloss lang="en"><text>quickly, at once, hurriedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 93 occurrences, first GEN.18.6; Lexique kissi–français, p. 11: cɔ-cɔ; Childs 2000, p. 55: cɔ́(-cɔ́)</text></form></note>
    <note><form lang="fr"><text>Abraham luɛi cɔ́-cɔ́ o cɛi-kola-toandaa ndɔɔ nin « Abraham se hâta d'entrer dans sa tente » (GEN.18.6).</text></form></note>
  </entry>
  <entry id="cɔ́cɔ̀l_636">
    <lexical-unit><form lang="kqs"><text>cɔ́cɔ̀l</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ́cɔ̀l_636_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>la nuit dernière</text></gloss>
      <gloss lang="en"><text>last night</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 54: cɔ́cɔ̀l</text></form></note>
  </entry>
  <entry id="cɔcɔn_637">
    <lexical-unit><form lang="kqs"><text>cɔcɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔcɔn_637_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèvres ; bord</text></gloss>
      <gloss lang="en"><text>lips; rim, edge</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 55 occurrences, first EXO.25.11</text></form></note>
  </entry>
  <entry id="cɔcɔɛi_638">
    <lexical-unit><form lang="kqs"><text>cɔcɔɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɔcɔn</text></form></field>
    <sense id="cɔcɔɛi_638_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lèvre ; bord, ourlet ; bec</text></gloss>
      <gloss lang="en"><text>lip; edge, hem ; beak; edge, hem</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lip; beak, bill (also of a cap)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.28.33; Keita 1979, p. 132: Työtyöèi; Lexique kissi–français, p. 11: cɔcɔɛi; Childs 2000, p. 55: cɔ̀cùɛ̀í</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, aussi le bord ou l'ourlet d'un vêtement (EXO.28.33).</text></form></note>
  </entry>
  <entry id="cɔ́fùù_639">
    <lexical-unit><form lang="kqs"><text>cɔ́fùù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ́fùù_639_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>enflé, gonflé (souligne l'enflure)</text></gloss>
      <gloss lang="en"><text>swollen (emphasizes swelling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 55: cɔ́fùù</text></form></note>
  </entry>
  <entry id="cɔ̂kí_640">
    <lexical-unit><form lang="kqs"><text>cɔ̂kí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ̂kí_640_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une coupure, d'une piqûre</text></gloss>
      <gloss lang="en"><text>sound of cutting or stinging</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 55: cɔ̂kí</text></form></note>
  </entry>
  <entry id="cɔloo_641">
    <lexical-unit><form lang="kqs"><text>cɔloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>cɔlua</text></form></field>
    <variant><form lang="kqs"><text>cɔlu</text></form></variant>
    <sense id="cɔloo_641_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animal, bête ; bétail ; animal domestique</text></gloss>
      <gloss lang="en"><text>animal, beast; livestock; domestic animal</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6 Animal"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 56 occurrences, first GEN.4.2; Lexique kissi–français, p. 11: cɔruo</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit cɔruo « (le) animal domestique » (p. 11).</text></form></note>
  </entry>
  <entry id="cɔlɔbaa_642">
    <lexical-unit><form lang="kqs"><text>cɔlɔbaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔlɔba</text></form></variant>
    <variant><form lang="kqs"><text>cɔlɔbanin</text></form></variant>
    <sense id="cɔlɔbaa_642_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>combattre, lutter</text></gloss>
      <gloss lang="en"><text>fight, struggle</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 138 occurrences, first GEN.30.8; Lexique kissi–français, p. 11: cɔlɔba</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français donne aussi cɔrɔba (p. 11).</text></form></note>
  </entry>
  <entry id="cɔ́lɔ̀ɔ̀-cɔ́lɔ̀ɔ̀_643">
    <lexical-unit><form lang="kqs"><text>cɔ́lɔ̀ɔ̀-cɔ́lɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="cɔ́lɔ̀ɔ̀-cɔ́lɔ̀ɔ̀_643_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de pluie battante, d'eau versée à flots</text></gloss>
      <gloss lang="en"><text>sound of heavy rain or water pouring</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 55: cɔ́lɔ̀ɔ̀-cɔ́lɔ̀ɔ̀</text></form></note>
  </entry>
  <entry id="cɔmndo_644">
    <lexical-unit><form lang="kqs"><text>cɔmndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔm</text></form></variant>
    <variant><form lang="kqs"><text>cɔmnin</text></form></variant>
    <sense id="cɔmndo_644_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>compter, dénombrer ; indiquer, montrer ; raconter</text></gloss>
      <gloss lang="en"><text>count, number; indicate, show; tell, narrate</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.2 Count"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>show, point out; also reveal, explain; count</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.13.16; Lexique kissi–français, p. 11: cɔmndo/ cɔm; Childs 2000, p. 56: cɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 11 : cɔmndo/ cɔm « raconter » ; cɔmɔɔ/ cɔm « compter ». Le Lexique kissi–français donne aussi : cɔmɔɔ.</text></form></note>
  </entry>
  <entry id="cɔmndo_645">
    <lexical-unit><form lang="kqs"><text>cɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔmndo_645_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>escargot (grand escargot terrestre comestible)</text></gloss>
      <gloss lang="en"><text>large edible land snail</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔmndo; Childs 2000, p. 56: cɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 11 (« l'escargot ») ; homographe de cɔmndo « compter ». Pluriel en kissi du Sud (Childs 2000) : cɔ̀mndá.</text></form></note>
  </entry>
  <entry id="cɔmnun_646">
    <lexical-unit><form lang="kqs"><text>cɔmnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔmnɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>cɔmnunnin</text></form></variant>
    <sense id="cɔmnun_646_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apparaître, se montrer</text></gloss>
      <gloss lang="en"><text>appear, show oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 199 occurrences, first GEN.12.7</text></form></note>
    <note><form lang="fr"><text>Moyen de cɔm « montrer ».</text></form></note>
  </entry>
  <entry id="cɔ̀múéí_647">
    <lexical-unit><form lang="kqs"><text>cɔ̀múéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cɔ̀mɔ́ŋ</text></form></field>
    <sense id="cɔ̀múéí_647_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clochette (de chien de chasse) ; dard ; nid de guêpes</text></gloss>
      <gloss lang="en"><text>bell (on hunting dogs); stinger; wasp nest</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 56: cɔ̀múéí</text></form></note>
  </entry>
  <entry id="cɔn_648">
    <lexical-unit><form lang="kqs"><text>cɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔnɔn</text></form></variant>
    <sense id="cɔn_648_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lever ; (cɔn … nin) depuis</text></gloss>
      <gloss lang="en"><text>get up, rise; (cɔn … nin) since</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 182 occurrences, first GEN.8.21</text></form></note>
  </entry>
  <entry id="cɔndɔɔ_649">
    <lexical-unit><form lang="kqs"><text>cɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>candu</text></form></variant>
    <sense id="cɔndɔɔ_649_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramasser, récolter, cueillir (des fruits)</text></gloss>
      <gloss lang="en"><text>gather, harvest, pick (fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔndɔɔ/ candu</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi condɔɔ « cueillir » (p. 10). candu existe dans la Bible au sens de « louer » ; comparer kɔndɔɔ « puiser, ramasser ».</text></form></note>
  </entry>
  <entry id="cɔngɔi_650">
    <lexical-unit><form lang="kqs"><text>cɔngɔi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔngɔi_650_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe devenu costume de danse</text></gloss>
      <gloss lang="en"><text>loincloth turned dance costume</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Työngöi; Lexique kissi–français, p. 11: cɔngɔi</text></form></note>
  </entry>
  <entry id="cɔngɔɔ_651">
    <lexical-unit><form lang="kqs"><text>cɔngɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cangu</text></form></variant>
    <sense id="cɔngɔɔ_651_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir, distribuer (le riz de la marmite dans les bols)</text></gloss>
      <gloss lang="en"><text>dish up, serve out (rice from the pot into bowls)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔngɔɔ/ cangu</text></form></note>
  </entry>
  <entry id="cɔnnden_652">
    <lexical-unit><form lang="kqs"><text>cɔnnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔnnden_652_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunes pousses du cœur du palmier</text></gloss>
      <gloss lang="en"><text>new shoots from the heart of the palm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔnnden</text></form></note>
  </entry>
  <entry id="cɔnndo_653">
    <lexical-unit><form lang="kqs"><text>cɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔnndo_653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>régime (de bananes, de noix de palme)</text></gloss>
      <gloss lang="en"><text>bunch (of bananas, palm nuts)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bunch or stalk of bananas</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 16: TYönndo; Childs 2000, p. 57: cɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Keita le distingue de työnndon « mil » (voir cɔnndon).</text></form></note>
  </entry>
  <entry id="cɔnndon_654">
    <lexical-unit><form lang="kqs"><text>cɔnndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔnndon_654_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros mil, sorgho</text></gloss>
      <gloss lang="en"><text>sorghum</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.4.9; Keita 1979, p. 140: Työnndon; Lexique kissi–français, p. 11: cɔnndon; Childs 2000, p. 58: cɔ̀ɔ́ŋndé</text></form></note>
  </entry>
  <entry id="cɔnɔnndo_655">
    <lexical-unit><form lang="kqs"><text>cɔnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔn</text></form></variant>
    <variant><form lang="kqs"><text>can</text></form></variant>
    <variant><form lang="kqs"><text>cen</text></form></variant>
    <variant><form lang="kqs"><text>cɔnnun</text></form></variant>
    <sense id="cɔnɔnndo_655_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lever, partir ; se lever contre ; lever (du soleil)</text></gloss>
      <gloss lang="en"><text>get up, set out; rise against; rising (of the sun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>get up, arise; grow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 200 occurrences, first GEN.5; Keita 1979, p. 116: Työnönndo; Lexique kissi–français, p. 11: cɔnɔnndo/ cɔn, cɛn, can, cen; Childs 2000, p. 57: cɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cen : radical négatif (GEN 31,35). Lexique kissi–français, p. 11 : « se lever ; se lever pour aller quelque part ; se lever contre » ; « le lever (du soleil) ».</text></form></note>
  </entry>
  <entry id="cɔ̀nɔ̌ŋmàkɔ̀ɔ́_656">
    <lexical-unit><form lang="kqs"><text>cɔ̀nɔ̌ŋmàkɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀nɔ̌ŋmàkɔ̀ɔ́_656_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse avec sauts et culbutes en arrière</text></gloss>
      <gloss lang="en"><text>dance with backward jumps and flips</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 56: cɔ̀nɔ̌ŋmàkɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔnɔɔ_657">
    <lexical-unit><form lang="kqs"><text>cɔnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>can</text></form></variant>
    <sense id="cɔnɔɔ_657_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>hacher (les feuilles d'épinards)</text></gloss>
      <gloss lang="en"><text>chop (spinach leaves)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔnɔɔ/ can</text></form></note>
    <note><form lang="fr"><text>Homographe de can « se lever » et de can « pleurer ».</text></form></note>
  </entry>
  <entry id="cɔu_658">
    <lexical-unit><form lang="kqs"><text>cɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ca</text></form></variant>
    <variant><form lang="kqs"><text>ce</text></form></variant>
    <variant><form lang="kqs"><text>ci</text></form></variant>
    <variant><form lang="kqs"><text>cɔ</text></form></variant>
    <variant><form lang="kqs"><text>canin</text></form></variant>
    <sense id="cɔu_658_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>voir</text></gloss>
      <gloss lang="en"><text>see</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>see, perceive, think</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 382 occurrences, first GEN.2.19; Keita 1979, p. 116: Työw; Lexique kissi–français, p. 11: cɔu/ cɔ, ce, ca, ci; Childs 2000, p. 58: cɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit työw ; la Bible écrit cɔu (GEN 2,19 ; 13,15) ; cɔw y signifie « créer ». ci : radical négatif (GEN 31,33). Verbe à alternance : ca, ce (accompli), cɔ, ci (négatif), canin (futur).</text></form></note>
  </entry>
  <entry id="cɔunkpɛɛŋɔɔ_659">
    <lexical-unit><form lang="kqs"><text>cɔunkpɛɛŋɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔunkpɛɛŋɔɔ_659_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potier</text></gloss>
      <gloss lang="en"><text>potter</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔunkpɛɛŋɔɔ</text></form></note>
  </entry>
  <entry id="cɔvɔɔ_660">
    <lexical-unit><form lang="kqs"><text>cɔvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔw</text></form></variant>
    <variant><form lang="kqs"><text>cɔaw</text></form></variant>
    <sense id="cɔvɔɔ_660_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, fabriquer ; créer ; mouler</text></gloss>
      <gloss lang="en"><text>make; create; mould</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="1 Universe, creation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 66 occurrences, first GEN.2.1; Lexique kissi–français, p. 11: cɔvɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 11 : « faire, créer, fabriquer, mouler comme un forgeron » ; aussi cɔwva/ cɔw et le radical caw (p. 9).</text></form></note>
  </entry>
  <entry id="cɔwlaban_661">
    <lexical-unit><form lang="kqs"><text>cɔwlaban</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔwlaban_661_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>combat</text></gloss>
      <gloss lang="en"><text>combat</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Työwlaban; Lexique kissi–français, p. 11: cɔwlaban</text></form></note>
  </entry>
  <entry id="cɔwlatukpaa_662">
    <lexical-unit><form lang="kqs"><text>cɔwlatukpaa</text></form></lexical-unit>
