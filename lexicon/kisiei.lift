      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>battement accéléré du cœur, élancement (de la tête)</text></gloss>
      <gloss lang="en"><text>racing heartbeat, throbbing (of the head)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dù-dù ...</text></form></note>
  </entry>
  <entry id="duaa_723">
    <lexical-unit><form lang="kqs"><text>duaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="duaa_723_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bénédiction ; bonheur</text></gloss>
      <gloss lang="en"><text>blessing; happiness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 384 occurrences, first GEN.1.22</text></form></note>
  </entry>
  <entry id="dúcɔ́_724">
