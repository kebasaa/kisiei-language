    <sense id="èèè_785_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>oh ! (déception)</text></gloss>
      <gloss lang="en"><text>oh! (disappointment)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 92: èèè</text></form></note>
