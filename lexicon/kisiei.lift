      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>instable, indécis</text></gloss>
      <gloss lang="en"><text>unsteady, undecided</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: taka-taka</text></form></note>
  </entry>
  <entry id="takalaa_3896">
    <lexical-unit><form lang="kqs"><text>takalaa</text></form></lexical-unit>
