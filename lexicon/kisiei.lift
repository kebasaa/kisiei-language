    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kelacaa lɛŋnde tɛɛn</text></form></variant>
    <sense id="kelacaa_2035_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>diplomatie</text></gloss>
      <gloss lang="en"><text>diplomacy</text></gloss>
