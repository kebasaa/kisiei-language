      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 341: sɔ̀ɔ̀yòó</text></form></note>
  </entry>
  <entry id="sɔ̀ɔ́yúùwó_3800">
    <lexical-unit><form lang="kqs"><text>sɔ̀ɔ́yúùwó</text></form></lexical-unit>
