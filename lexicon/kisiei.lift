    <trait name="status" value="attested"/>
    <sense id="nda_2404_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>et (entre personnes)</text></gloss>
      <gloss lang="en"><text>and (between persons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'with'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15820 occurrences, first GEN.1.21; Childs 2000, p. 266: ndá</text></form></note>
  </entry>
  <entry id="ndá_2405">
    <lexical-unit><form lang="kqs"><text>ndá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="ndá_2405_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>là, là-bas</text></gloss>
      <gloss lang="en"><text>there</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 266: ndá</text></form></note>
  </entry>
  <entry id="ndáà_2406">
