    <trait name="status" value="attested"/>
    <sense id="saŋndo_3456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lièvre ; lapin</text></gloss>
      <gloss lang="en"><text>hare; rabbit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a small or pygmy antelope, hero of folk tales</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.11.6; Keita 1979, p. 137: Sanndo; Lexique kissi–français, p. 46: sanndo; Childs 2000, p. 322: sáŋndó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 46 : sanndo « un lapin, le lièvre ».</text></form></note>
