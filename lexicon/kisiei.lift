    <variant><form lang="kqs"><text>kpúlúnkùmala</text></form></variant>
    <sense id="kpúlúnkùmaa_1973_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>redoutable, terrible</text></gloss>
      <gloss lang="en"><text>awesome, terrible</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first DEU.7.21</text></form></note>
  </entry>
  <entry id="kpulunndo_1974">
    <lexical-unit><form lang="kqs"><text>kpulunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kpulunndo_1974_s1">
