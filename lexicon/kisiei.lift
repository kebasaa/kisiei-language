    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 230: lèùŋndó</text></form></note>
  </entry>
  <entry id="levil_2423">
    <lexical-unit><form lang="kqs"><text>levil</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="levil_2423_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>loin, au loin ; (lɔ́ɔ́ levil) il y a longtemps</text></gloss>
      <gloss lang="en"><text>far, far away; (lɔ́ɔ́ levil) long ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 208 occurrences, first GEN.4.14</text></form></note>
  </entry>
  <entry id="levundu_2424">
    <lexical-unit><form lang="kqs"><text>levundu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="levundu_2424_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre ; (o levundu nin) en énigmes</text></gloss>
      <gloss lang="en"><text>shadow; (o levundu nin) in riddles</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first NUM.12.8</text></form></note>
  </entry>
  <entry id="lèwɔ́ɔ́_2425">
    <lexical-unit><form lang="kqs"><text>lèwɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lèwɔ́ɔ́_2425_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauce à la pulpe de noix de palme</text></gloss>
      <gloss lang="en"><text>palm butter (palm-nut sauce)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 230: lèwɔ́ɔ́</text></form></note>
  </entry>
  <entry id="leyáá_2426">
    <lexical-unit><form lang="kqs"><text>leyáá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>leyàá</text></form></variant>
    <sense id="leyáá_2426_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>trois fois ; (kɛmɛ leyáá) trois cents</text></gloss>
      <gloss lang="en"><text>three times; (kɛmɛ leyáá) three hundred</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>three times</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.5.22; Childs 2000, p. 228: léyàà</text></form></note>
    <note><form lang="fr"><text>kɛmɛ leyáá « trois cents » (GEN.5.22) ; helɔɔ leyàá « (à) trois étages » (GEN.6.16). De le- et yáá « trois ».</text></form></note>
  </entry>
  <entry id="leyinndo_2427">
    <lexical-unit><form lang="kqs"><text>leyinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>leyin</text></form></variant>
    <variant><form lang="kqs"><text>leyinndan</text></form></variant>
    <sense id="leyinndo_2427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flamme, feu ardent ; fournaise</text></gloss>
      <gloss lang="en"><text>flame, blazing fire; furnace</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.9.8</text></form></note>
  </entry>
  <entry id="léŋé-léŋé_2428">
    <lexical-unit><form lang="kqs"><text>léŋé-léŋé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="léŋé-léŋé_2428_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(amincir) encore plus, tout fin</text></gloss>
      <gloss lang="en"><text>(slim down) even more, very thin</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 227: léŋé-léŋé</text></form></note>
  </entry>
  <entry id="lèŋèlàá_2429">
    <lexical-unit><form lang="kqs"><text>lèŋèlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lèŋèlàá_2429_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>réduire, amincir (en taillant ou en serrant)</text></gloss>
      <gloss lang="en"><text>reduce, slim down (by trimming or tying)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 227: lèŋèlàá</text></form></note>
  </entry>
  <entry id="lèŋndó_2430">
    <lexical-unit><form lang="kqs"><text>lèŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lèŋndó_2430_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte ressemblant au pou ; ver des ordures</text></gloss>
      <gloss lang="en"><text>louse-like insect; worm found in refuse</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
