    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Seenguuvo; Lexique kissi–français, p. 47: seenguuvo; Childs 2000, p. 323: sèèŋúúwó</text></form></note>
  </entry>
  <entry id="seesiɛi_4472">
    <lexical-unit><form lang="kqs"><text>seesiɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="seesiɛi_4472_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rébellion, révolte</text></gloss>
      <gloss lang="en"><text>rebellion, revolt</text></gloss>
