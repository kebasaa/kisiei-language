      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir</text></gloss>
      <gloss lang="en"><text>open</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>open; cover</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.7; Childs 2000, p. 198: kùmbìó</text></form></note>
  </entry>
  <entry id="kùmbùèí_1784">
    <lexical-unit><form lang="kqs"><text>kùmbùèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kùmbɔ̃ŋ</text></form></field>
    <sense id="kùmbùèí_1784_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté (d'une route, d'un mur)</text></gloss>
