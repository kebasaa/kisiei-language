    <trait name="status" value="southern"/>
    <sense id="kásáá_1481_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>souris ou petit rat roux des marais (comestible)</text></gloss>
      <gloss lang="en"><text>small reddish swamp mouse (edible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 149: kásáá</text></form></note>
  </entry>
  <entry id="kasio_1482">
    <lexical-unit><form lang="kqs"><text>kasio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kasi</text></form></variant>
    <variant><form lang="kqs"><text>kasila</text></form></variant>
    <sense id="kasio_1482_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faute, offense ; (del kasi) offenser, pécher contre</text></gloss>
      <gloss lang="en"><text>offence, fault; (del kasi) offend, sin against</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rules of a (secret) society; the offence of breaking them</text></form></field>
