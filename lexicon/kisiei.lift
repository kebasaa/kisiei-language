      <gloss lang="fr"><text>christianisme</text></gloss>
      <gloss lang="en"><text>Christianity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kilitilen; Lexique kissi–français, p. 24: kilitilen</text></form></note>
  </entry>
  <entry id="kilitinɔɔ_1598">
    <lexical-unit><form lang="kqs"><text>kilitinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
