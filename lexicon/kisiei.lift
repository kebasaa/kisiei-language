      <gloss lang="en"><text>four years ago</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 53: takan tala</text></form></note>
