    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>afternoon</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.1.5; Childs 2000, p. 139: ìpàláà</text></form></note>
