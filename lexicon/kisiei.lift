      <gloss lang="fr"><text>lune</text></gloss>
      <gloss lang="en"><text>moon</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moon, month; menstrual period</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first GEN.1.16; Keita 1979, p. 154: Paangei; Childs 2000, p. 289: pàŋɛ́í</text></form></note>
  </entry>
  <entry id="paangii_2508">
    <lexical-unit><form lang="kqs"><text>paangii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>paangon</text></form></field>
    <sense id="paangii_2508_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mois</text></gloss>
      <gloss lang="en"><text>month</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>moon, month; menstrual period</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 211 occurrences, first GEN.7.11; Keita 1979, p. 152: Paangiei; Childs 2000, p. 289: pàŋɛ́í</text></form></note>
    <note><form lang="fr"><text>Keita écrit Paangiei ; la Bible écrit paangii (pluriel paangon), distinct de paangei « lune ».</text></form></note>
  </entry>
  <entry id="páápáá_2509">
    <lexical-unit><form lang="kqs"><text>páápáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
