    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first LEV.27.28</text></form></note>
  </entry>
  <entry id="fáú-fáú_820">
    <lexical-unit><form lang="kqs"><text>fáú-fáú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fáú-fáú_820_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en désordre, éparpillé (cheveux défaits, gestes de colère)</text></gloss>
      <gloss lang="en"><text>spread about, loose (hair let down, angry waving)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 99: fáú-fáú</text></form></note>
  </entry>
  <entry id="faw_821">
