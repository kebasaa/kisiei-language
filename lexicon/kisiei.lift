  <entry id="kɛndia_1933">
    <lexical-unit><form lang="kqs"><text>kɛndia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɛndia_1933_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>santé, bien-être ; paix, sécurité ; (muungu kɛndia) revenir sain et sauf</text></gloss>
      <gloss lang="en"><text>health, well-being; peace, safety; (muungu kɛndia) come back safe and sound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5 Healthy"/>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>health, general well-being, being at peace with the ancestors</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.28.21; Childs 2000, p. 161: kéndíá</text></form></note>
    <note><form lang="fr"><text>mì muungu kɛndia fuɲa nuu o ibuŋ « si je reviens en paix chez mon père » (GEN.28.21) ; O co kɛndia le « il n'est pas bien » (1SA.19.14). Cf. kɛndɔɔ « bon ».</text></form></note>
  </entry>
