    <trait name="status" value="southern"/>
    <sense id="nìŋgíáá_2450_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de poisson électrique</text></gloss>
      <gloss lang="en"><text>kind of electric fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 263: nìŋgíáá</text></form></note>
  </entry>
  <entry id="nìŋgúáá_2451">
    <lexical-unit><form lang="kqs"><text>nìŋgúáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="nìŋgúáá_2451_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce de ver parasite des animaux</text></gloss>
      <gloss lang="en"><text>kind of worm living in animals (parasite)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 263: nìŋgúáá</text></form></note>
  </entry>
  <entry id="nuaa_2452">
    <lexical-unit><form lang="kqs"><text>nuaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>nua</text></form></variant>
    <sense id="nuaa_2452_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>regarder</text></gloss>
      <gloss lang="en"><text>look</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>look at, observe</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Nuaa; Childs 2000, p. 265: nùàá</text></form></note>
    <note><form lang="fr"><text>nua « regarde ! » (GEN 37,32). Mais nuaa est surtout dans la Bible « ainsi, la manière » (GEN 2,1).</text></form></note>
  </entry>
  <entry id="nuannɔnndo_2453">
    <lexical-unit><form lang="kqs"><text>nuannɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="nuannɔnndo_2453_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se regarder</text></gloss>
      <gloss lang="en"><text>look at oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Nuannönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de nuaa.</text></form></note>
  </entry>
  <entry id="númbɔ̀_2454">
    <lexical-unit><form lang="kqs"><text>númbɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="númbɔ̀_2454_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>n'est-ce pas ? (particule de confirmation)</text></gloss>
      <gloss lang="en"><text>isn't it?, right? (tag particle)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 265: númbɔ̀</text></form></note>
  </entry>
  <entry id="nuu_2455">
    <lexical-unit><form lang="kqs"><text>nuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nuu_2455_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>mon, ma</text></gloss>
      <gloss lang="en"><text>my</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1533 occurrences, first GEN.4.9; Childs 2000, p. 265: nù-</text></form></note>
