      <gloss lang="fr"><text>aujourd'hui, maintenant</text></gloss>
      <gloss lang="en"><text>today, now</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 436 occurrences, first GEN.4.11; Childs 2000, p. 118: háù</text></form></note>
