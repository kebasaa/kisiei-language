    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkàlàpíóó</text></form></note>
  </entry>
  <entry id="sàkàndàá_3367">
    <lexical-unit><form lang="kqs"><text>sàkàndàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sàkàndàláŋ</text></form></field>
    <sense id="sàkàndàá_3367_s1">
