<?xml version="1.0" encoding="UTF-8"?>
<lift version="0.13" producer="Kisie tools/build_lexicon.py">
  <entry id="-àlè_1">
    <lexical-unit><form lang="kqs"><text>-àlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-àlè_1_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>particule emphatique (après un ordre, une salutation)</text></gloss>
      <gloss lang="en"><text>emphatic tag (after commands, greetings)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: -àlè</text></form></note>
  </entry>
  <entry id="-náá_2">
    <lexical-unit><form lang="kqs"><text>-náá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="-náá_2_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>tout petit, très peu (suffixe, seulement pour des choses petites ou courtes)</text></gloss>
      <gloss lang="en"><text>very (small) (suffix, only with small or short things)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.9 Affixes"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 257: -náá</text></form></note>
  </entry>
  <entry id="a_3">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_3_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>tu ; ils, elles (sujet)</text></gloss>
      <gloss lang="en"><text>you (sg.); they (subject)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1</text></form></note>
  </entry>
  <entry id="a_4">
    <lexical-unit><form lang="kqs"><text>a</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a_4_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>avec ; et</text></gloss>
      <gloss lang="en"><text>with; and</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35305 occurrences, first GEN.1</text></form></note>
  </entry>
  <entry id="a yandi_5">
    <lexical-unit><form lang="kqs"><text>a yandi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="a yandi_5_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>s'il te plaît, je t'en prie</text></gloss>
      <gloss lang="en"><text>please</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yándíí</text></form></note>
  </entry>
  <entry id="aa_6">
    <lexical-unit><form lang="kqs"><text>aa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="aa_6_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>introduit les paroles rapportées</text></gloss>
      <gloss lang="en"><text>quotative particle</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'like, as' (comparison)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8249 occurrences, first GEN.1.3; Childs 2000, p. 2: àà</text></form></note>
  </entry>
  <entry id="akasia_7">
    <lexical-unit><form lang="kqs"><text>akasia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="akasia_7_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acacia (pɛngɛn akasia « bois d'acacia »)</text></gloss>
      <gloss lang="en"><text>acacia (pɛngɛn akasia 'acacia wood')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first EXO.25.5</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="amanndiee_8">
    <lexical-unit><form lang="kqs"><text>amanndiee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="amanndiee_8_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amande, amandier (yɔm amanndiee)</text></gloss>
      <gloss lang="en"><text>almond, almond tree (yɔm amanndiee)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.30.37</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="ansan_9">
    <lexical-unit><form lang="kqs"><text>ansan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ansan_9_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>encens</text></gloss>
      <gloss lang="en"><text>incense</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 94 occurrences, first EXO.25.6</text></form></note>
  </entry>
  <entry id="ba_10">
    <lexical-unit><form lang="kqs"><text>ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ba_10_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>côté ; (o … ba) chez, auprès de, aux mains de ; (a ba …) du côté de</text></gloss>
      <gloss lang="en"><text>side; (o … ba) with, at, in the hands of; (a ba …) towards</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3579 occurrences, first GEN.2.8</text></form></note>
    <note><form lang="fr"><text>a ba paalen le can-ndo « à l'est » ; o ba bɛngu « sous l'autorité de ».</text></form></note>
  </entry>
  <entry id="bâ_11">
    <lexical-unit><form lang="kqs"><text>bâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bâ_11_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'une goutte qui tombe sur une surface lisse</text></gloss>
      <gloss lang="en"><text>sound of a drop falling on a smooth surface</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 2: bâ</text></form></note>
  </entry>
  <entry id="bà-ó-bà_12">
    <lexical-unit><form lang="kqs"><text>bà-ó-bà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bà-ó-bà_12_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, où que ce soit</text></gloss>
      <gloss lang="en"><text>everywhere, wherever</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 8: bà-ó-bà</text></form></note>
  </entry>
  <entry id="bàà_13">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bàà_13_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>est-ce que (en tête de question) ; ou bien</text></gloss>
      <gloss lang="en"><text>question marker (sentence-initial); or</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>or, whether</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Childs 2000, p. 2: bàà</text></form></note>
    <note><form lang="fr"><text>Bàà nuaa Hala dimul niaa ni ... ? « Dieu a-t-il vraiment dit ... ? » (GEN.3.1) ; Bàà mì vin Abraham ... ? « Cacherai-je à Abraham ... ? » (GEN.18.17). Ne pas confondre avec baa « main ».</text></form></note>
  </entry>
  <entry id="báà_14">
    <lexical-unit><form lang="kqs"><text>báà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="báà_14_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prix, valeur</text></gloss>
      <gloss lang="en"><text>price, value</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 17: Baa (T H D); Childs 2000, p. 3: báá</text></form></note>
    <note><form lang="fr"><text>Keita oppose Baa (ton haut) « le prix » à Baa (ton bas) « la main » ; Fallo vèè kolaa hoo nö yè baa « Monsieur, quel est le prix de ce pagne ? » (p. 59). La Bible écrit báà : mɛɛ cɔlu kon nɔ báà yɛ « selon le prix de l'animal » (Ex 21,34) ; powta báà kàlàla « pierres de grand prix, pierres précieuses » (Ex 25,7) ; ɲɛm báà kalan « objets de valeur » (2 R 20,13).</text></form></note>
  </entry>
  <entry id="baa_15">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>balan</text></form></field>
    <variant><form lang="kqs"><text>ba</text></form></variant>
    <sense id="baa_15_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>main, bras</text></gloss>
      <gloss lang="en"><text>hand, arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hand, arm; also way, fork in a road</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 555 occurrences, first GEN.1.9; Keita 1979, p. 131: Baa; Childs 2000, p. 2: bàá</text></form></note>
  </entry>
  <entry id="baa_16">
    <lexical-unit><form lang="kqs"><text>baa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baa_16_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, accrocher</text></gloss>
      <gloss lang="en"><text>tie, hang</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baa</text></form></note>
    <note><form lang="fr"><text>Radicaux de Keita : ba, bee. baa est très courant dans la Bible mais avec d'autres sens ; le moyen baanun « attacher » y est attesté (EXO 28,28).</text></form></note>
  </entry>
  <entry id="bàà_17">
    <lexical-unit><form lang="kqs"><text>bàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bàà_17_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lundi (jour de marché à Bàà)</text></gloss>
      <gloss lang="en"><text>Monday (market day at Bàà)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bàà</text></form></note>
  </entry>
  <entry id="baala folobaa_18">
    <lexical-unit><form lang="kqs"><text>baala folobaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="baala folobaa_18_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>investissement humain (travail collectif)</text></gloss>
      <gloss lang="en"><text>communal labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Baala folobaa</text></form></note>
    <note><form lang="fr"><text>baala « travail » est attesté ; folobaa n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="baalaa_19">
    <lexical-unit><form lang="kqs"><text>baalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>baalalan</text></form></field>
    <variant><form lang="kqs"><text>baala</text></form></variant>
    <variant><form lang="kqs"><text>baalala</text></form></variant>
    <sense id="baalaa_19_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>travail, ouvrage ; service</text></gloss>
      <gloss lang="en"><text>work; service</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 809 occurrences, first GEN.2.5</text></form></note>
  </entry>
  <entry id="bààlòó_20">
    <lexical-unit><form lang="kqs"><text>bààlòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààlòlàŋ</text></form></field>
    <sense id="bààlòó_20_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabouret, siège à trois pieds</text></gloss>
      <gloss lang="en"><text>stool, three-legged seat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààlòó</text></form></note>
  </entry>
  <entry id="bààmbàá_21">
    <lexical-unit><form lang="kqs"><text>bààmbàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bààmbàá_21_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, envelopper ; accrocher ; démarrer (en courant)</text></gloss>
      <gloss lang="en"><text>tie up, wrap; hook up; start off (esp. running)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààmbàá</text></form></note>
  </entry>
  <entry id="bààníŋndó_22">
    <lexical-unit><form lang="kqs"><text>bààníŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bààníŋndó_22_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de culte des ancêtres (coin de la maison où l'on dépose offrandes et libations)</text></gloss>
      <gloss lang="en"><text>place of ancestor worship (corner where offerings are placed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 3: bààníŋndó</text></form></note>
  </entry>
  <entry id="baanɔnndo_23">
    <lexical-unit><form lang="kqs"><text>baanɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baanɔnndo_23_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'accrocher, s'attacher</text></gloss>
      <gloss lang="en"><text>hang on, be attached</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hang, be suspended</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Baanönndo; Childs 2000, p. 4: bàànɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de baa. Forme attestée dans la Bible : baanun « attacher » (EXO 28,28 ; JDG 3,16).</text></form></note>
  </entry>
  <entry id="báásìà_24">
    <lexical-unit><form lang="kqs"><text>báásìà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="báásìà_24_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>essayer, faire effort</text></gloss>
      <gloss lang="en"><text>try, strive, make an effort</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásìà</text></form></note>
  </entry>
  <entry id="báásíó_25">
    <lexical-unit><form lang="kqs"><text>báásíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>báásíláŋ</text></form></field>
    <sense id="báásíó_25_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit flacon (tabac à priser, médicament)</text></gloss>
      <gloss lang="en"><text>small container (snuff, medicine)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: báásíó</text></form></note>
  </entry>
  <entry id="baavaa_26">
    <lexical-unit><form lang="kqs"><text>baavaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baava</text></form></variant>
    <sense id="baavaa_26_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau ; bath (mesure de liquides)</text></gloss>
      <gloss lang="en"><text>bucket, pail; bath (liquid measure)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EZK.45.11; Childs 2000, p. 4: báávàá</text></form></note>
    <note><form lang="fr"><text>mɛmma ... o baava « une goutte d'un seau » (ISA.40.15) ; mesure de liquides en EZK.45.11.</text></form></note>
  </entry>
  <entry id="bààyàléŋ_27">
    <lexical-unit><form lang="kqs"><text>bààyàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bààyààŋ</text></form></field>
    <sense id="bààyàléŋ_27_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rang de perles porté au bras ou à la taille</text></gloss>
      <gloss lang="en"><text>string of beads worn on the arm or waist</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bààyàléŋ</text></form></note>
  </entry>
  <entry id="bááŋtɔ́kpùá_28">
    <lexical-unit><form lang="kqs"><text>bááŋtɔ́kpùá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bááŋtɔ́kpùá_28_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'aubergine amère (mangée par les babouins)</text></gloss>
      <gloss lang="en"><text>species of bitter eggplant (eaten by baboons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bááŋtɔ́kpùá</text></form></note>
  </entry>
  <entry id="bácù_29">
    <lexical-unit><form lang="kqs"><text>bácù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bácù_29_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>démarrage brusque (en projetant du gravier) ; crachat bruyant</text></gloss>
      <gloss lang="en"><text>rapid acceleration (throwing back gravel); noisy spitting</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bácù</text></form></note>
  </entry>
  <entry id="bádò_30">
    <lexical-unit><form lang="kqs"><text>bádò</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bádò_30_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>souligne l'adhérence (rester collé)</text></gloss>
      <gloss lang="en"><text>stuck fast</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bádò</text></form></note>
  </entry>
  <entry id="bàfèíyó_31">
