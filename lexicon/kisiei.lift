      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>d'un regard somnolent</text></gloss>
      <gloss lang="en"><text>with a drowsy gaze</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 347: táfùlàà</text></form></note>
  </entry>
  <entry id="tahɔl_3894">
