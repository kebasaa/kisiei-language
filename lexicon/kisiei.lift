    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>dɛlua</text></form></field>
    <variant><form lang="kqs"><text>dɛlu</text></form></variant>
    <sense id="dɛluo_391_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ver</text></gloss>
      <gloss lang="en"><text>worm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chigger; any small insect such as a caterpillar or worm</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Dèluo; Childs 2000, p. 75: dɛ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>La Bible a le pluriel dɛlua (JOB.24.20) et dɛloo « un ver » (JON.4.7).</text></form></note>
  </entry>
