    <variant><form lang="kqs"><text>beŋi</text></form></variant>
    <sense id="beŋio_165_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piquer plusieurs fois ; enlever le manche d'un outil</text></gloss>
