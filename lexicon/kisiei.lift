  <entry id="kiyɛiyo_2151">
    <lexical-unit><form lang="kqs"><text>kiyɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiyɛi</text></form></variant>
    <variant><form lang="kqs"><text>kiyɛiya</text></form></variant>
    <variant><form lang="kqs"><text>kiɛi</text></form></variant>
    <sense id="kiyɛiyo_2151_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vivant ; vert, frais</text></gloss>
      <gloss lang="en"><text>living, alive; green, fresh</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6 Life"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>uncooked, fresh</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.1.12; Paulme 1964, p. 53: kyɛyo; Lexique kissi–français, p. 25: kiyɛiyo; Childs 2000, p. 171: kìyɛ́í-</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 53 : kyɛyo « vert » (bil kyɛyo « herbe verte ») ; cf. bil kiɛi « herbe verte » (JER.14.6).</text></form></note>
  </entry>
  <entry id="kíŋ-kìŋ_2152">
    <lexical-unit><form lang="kqs"><text>kíŋ-kìŋ</text></form></lexical-unit>
