    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bèŋgóŋ</text></form></field>
    <sense id="bèŋgéí_164_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>brisures de riz pilé ; particules dans la lie du vin de palme</text></gloss>
      <gloss lang="en"><text>broken kernels of pounded rice; particles in palm-wine dregs</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 10: bèŋgéí</text></form></note>
