    <trait name="status" value="attested"/>
    <sense id="bana-banaa_56_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gros, grands (bétail, animaux, navires)</text></gloss>
      <gloss lang="en"><text>big, large (livestock, animals, ships)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 2CH.31.6</text></form></note>
    <note><form lang="fr"><text>visia bana-banaa a á pɔmbɔa « animaux grands et petits » (Ps 104,25).</text></form></note>
  </entry>
  <entry id="bánásìíyó_57">
    <lexical-unit><form lang="kqs"><text>bánásìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bándásìíláŋ</text></form></field>
    <sense id="bánásìíyó_57_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>intérêt (sur un prêt)</text></gloss>
      <gloss lang="en"><text>interest (on money)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 6: bánásìíyó</text></form></note>
