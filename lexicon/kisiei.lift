  <entry id="pɛ̀ŋgìó_3308">
    <lexical-unit><form lang="kqs"><text>pɛ̀ŋgìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pɛ̀ŋgìláŋ</text></form></field>
    <sense id="pɛ̀ŋgìó_3308_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ligne de démarcation ; point (ponctuation)</text></gloss>
      <gloss lang="en"><text>boundary line; full stop (punctuation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 297: pɛ̀ŋgìó</text></form></note>
