    <trait name="status" value="southern"/>
    <sense id="kàá_1185_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se racler la gorge, graillonner</text></gloss>
      <gloss lang="en"><text>clear one's throat, hawk</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 140: kàá</text></form></note>
  </entry>
  <entry id="káádɛ̂ìyó_1186">
    <lexical-unit><form lang="kqs"><text>káádɛ̂ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="káádɛ̂ìyó_1186_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>carde (pour le coton)</text></gloss>
      <gloss lang="en"><text>card (comb for carding cotton)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 140: káádɛ̂ìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="kààfàá_1187">
    <lexical-unit><form lang="kqs"><text>kààfàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kààfàá_1187_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher lâchement ; grimacer, montrer les dents ; rentrer les lèvres</text></gloss>
      <gloss lang="en"><text>tie loosely; grimace, bare one's teeth; suck in one's lips</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 140: kààfàá</text></form></note>
  </entry>
  <entry id="kaalaa_1188">
    <lexical-unit><form lang="kqs"><text>kaalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kaalaa_1188_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aimer, chérir</text></gloss>
      <gloss lang="en"><text>love, cherish</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.3 Love"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>love, be in love with</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kaalaa; Childs 2000, p. 140: kààlàá</text></form></note>
    <note><form lang="fr"><text>kaala, kaalan dans la Bible sont des noms (« pratiques », COL 3,9), pas ce verbe.</text></form></note>
  </entry>
  <entry id="káálàá_1189">
    <lexical-unit><form lang="kqs"><text>káálàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>káálàláŋ</text></form></field>
    <sense id="káálàá_1189_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gobelet, tasse</text></gloss>
      <gloss lang="en"><text>drinking cup</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 140: káálàá</text></form></note>
    <note><form lang="fr"><text>Childs le donne pour le kissi de Guinée ; la Bible a kólaa « coupe ».</text></form></note>
  </entry>
  <entry id="káálen_1190">
    <lexical-unit><form lang="kqs"><text>káálen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="káálen_1190_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pays (étranger), terre d'exil</text></gloss>
      <gloss lang="en"><text>(foreign) land, land of exile</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>area, land, place; foreign area; also taboo, totem, clan</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.26.34; Childs 2000, p. 141: kááléŋ</text></form></note>
    <note><form lang="fr"><text>O vɔsila niaa ciinin o káálen nin o yaamɔaa lo « pendant les années où vous serez au pays de vos ennemis » (LEV.26.34). Une seule occurrence.</text></form></note>
  </entry>
  <entry id="kaamaa_1191">
    <lexical-unit><form lang="kqs"><text>kaamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kaamaalan</text></form></field>
    <variant><form lang="kqs"><text>kaamaala</text></form></variant>
    <sense id="kaamaa_1191_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose redoutable, prodige ; redoutable</text></gloss>
      <gloss lang="en"><text>awesome thing, miracle; awesome</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>amazing, incredible, wonderful</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.28.17; Childs 2000, p. 141: káámá-</text></form></note>
  </entry>
  <entry id="kaan_1192">
    <lexical-unit><form lang="kqs"><text>kaan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kaan_1192_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>indigo ; bleu</text></gloss>
      <gloss lang="en"><text>indigo; blue</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>indigo tree and the dark blue dye from its bark</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first EXO.25.4; Keita 1979, p. 139: Kaan; Childs 2000, p. 142: kááŋ</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, la laine teinte en bleu (EXO.25.4).</text></form></note>
  </entry>
  <entry id="káándáá_1193">
    <lexical-unit><form lang="kqs"><text>káándáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="káándáá_1193_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de sacrifice, pierre à sacrifices</text></gloss>
      <gloss lang="en"><text>place of sacrifice, sacrifice rock</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 141: káándáá</text></form></note>
  </entry>
  <entry id="kaanden_1194">
    <lexical-unit><form lang="kqs"><text>kaanden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="kaanden_1194_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assemblée de culte, prière ; (Keita) école, prière</text></gloss>
      <gloss lang="en"><text>worship assembly, prayer; (Keita) school, prayer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.6.2 School"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>foreign land; school, church (GK)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.12.16; Keita 1979, p. 135: kaanden; Childs 2000, p. 149: kàŋndéŋ</text></form></note>
    <note><form lang="fr"><text>La bɛnda mì la cuungian le kaanden tosaa « vous vous réunirez pour le culte » (EXO.12.16). Keita (p. 135) : A co o kaanden « il est à l'école / à la prière ». Cf. kaandennɔɔ « élève, disciple ».</text></form></note>
  </entry>
  <entry id="kaandennɔ_1195">
    <lexical-unit><form lang="kqs"><text>kaandennɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kaandennda</text></form></field>
    <variant><form lang="kqs"><text>kaandeŋaa</text></form></variant>
    <sense id="kaandennɔ_1195_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>disciple</text></gloss>
      <gloss lang="en"><text>disciple</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6 Teach"/>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first MAT.10.37</text></form></note>
  </entry>
  <entry id="kaandennɔɔ_1196">
    <lexical-unit><form lang="kqs"><text>kaandennɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kaandennda</text></form></field>
    <variant><form lang="kqs"><text>kaandennɔ</text></form></variant>
    <sense id="kaandennɔɔ_1196_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>élève, disciple</text></gloss>
      <gloss lang="en"><text>pupil, disciple</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.6.2 School"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first ISA.50.4; Keita 1979, p. 145: Lakolinöö-Kaandennöö</text></form></note>
    <note><form lang="fr"><text>Keita donne lakolinɔɔ « élève (de l'école) » et kaandennɔɔ ; seul kaandennɔɔ est dans la Bible.</text></form></note>
  </entry>
  <entry id="kààndìá_1197">
    <lexical-unit><form lang="kqs"><text>kààndìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kààndìá_1197_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>barrer (un cours d'eau) ; fouetter à plusieurs reprises</text></gloss>
      <gloss lang="en"><text>dam (a stream); whip several times</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 142: kààndìá</text></form></note>
  </entry>
  <entry id="kaandian_1198">
    <lexical-unit><form lang="kqs"><text>kaandian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kaandian_1198_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se déguiser</text></gloss>
      <gloss lang="en"><text>disguise oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 1KI.14.2</text></form></note>
    <note><form lang="fr"><text>Cf. kaandiaa « fermer, munir de barreaux » (Éz 41,16).</text></form></note>
  </entry>
  <entry id="káángoo_1199">
    <lexical-unit><form lang="kqs"><text>káángoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="káángoo_1199_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marteau</text></gloss>
      <gloss lang="en"><text>hammer</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first NUM.17.3; Childs 2000, p. 149: káŋgóó káŋgóláŋ</text></form></note>
    <note><form lang="fr"><text>a cua káángoo a baŋ ndu a pɔɔndɔn « on le fixe au marteau et aux clous » (JER.10.4) ; ma lɔɔ mun a káángoo « qu'on les martèle » (NUM.17.3). Homonyme de kaangoo « termite ».</text></form></note>
  </entry>
  <entry id="kaangoo_1200">
    <lexical-unit><form lang="kqs"><text>kaangoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <field type="plural"><form lang="kqs"><text>kaangoa</text></form></field>
    <sense id="kaangoo_1200_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termite ; mite</text></gloss>
      <gloss lang="en"><text>termite; moth</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Kaangoo; Childs 2000, p. 142: kààŋgɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, le pluriel kaangoa désigne les mites qui rongent les vêtements (JOB.13.28, JAS.5.2) ; le singulier káángoo y est un homonyme « marteau » (JER.10.4).</text></form></note>
  </entry>
