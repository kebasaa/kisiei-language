  <entry id="ihɛllan_1345">
    <lexical-unit><form lang="kqs"><text>ihɛllan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ihɛlma</text></form></variant>
    <variant><form lang="kqs"><text>ihɛl</text></form></variant>
    <sense id="ihɛllan_1345_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mer (mɛmma ihɛllan)</text></gloss>
      <gloss lang="en"><text>sea (mɛmma ihɛllan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 251 occurrences, first GEN.1.10</text></form></note>
  </entry>
  <entry id="ii_1346">
    <lexical-unit><form lang="kqs"><text>ii</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ii_1346_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>je (plus-que-parfait)</text></gloss>
      <gloss lang="en"><text>I (pluperfect)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 20: ii</text></form></note>
    <note><form lang="fr"><text>Lexique : « J'étais… (je avant les verbes au plus-que-parfait) ». Forme et tons à confirmer.</text></form></note>
  </entry>
  <entry id="ikɔɔ_1347">
    <lexical-unit><form lang="kqs"><text>ikɔɔ</text></form></lexical-unit>
