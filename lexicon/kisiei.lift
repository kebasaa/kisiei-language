    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kpɛɛnɛn</text></form></field>
    <sense id="kpɛɛnɛi_2625_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marmite, pot ; bassin ; canari</text></gloss>
      <gloss lang="en"><text>cooking pot; basin; clay pot</text></gloss>
