    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kpelenkpelenndon</text></form></field>
    <sense id="kpelenkpelennde_1858_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheville</text></gloss>
      <gloss lang="en"><text>ankle</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Kpelenkpelennde; Lexique kissi–français, p. 28: kpelenkpelennde</text></form></note>
    <note><form lang="fr"><text>Pluriel kpelenkpelenndon attesté (Ez 47,3). À distinguer de kpélénkpélénndo « lance ». Lexique kissi–français, p. 28 : aussi kpelenkpelende « la cheville ».</text></form></note>
  </entry>
  <entry id="kpéléŋndó_1859">
    <lexical-unit><form lang="kqs"><text>kpéléŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kpéléŋndó_1859_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>limite, frontière</text></gloss>
      <gloss lang="en"><text>boundary</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 209: kpéléŋndó</text></form></note>
  </entry>
  <entry id="kpelo_1860">
    <lexical-unit><form lang="kqs"><text>kpelo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kpelo_1860_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couchette surélevée dans la case</text></gloss>
      <gloss lang="en"><text>raised sleeping place in a hut</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpero</text></form></note>
  </entry>
  <entry id="kpeloo_1861">
    <lexical-unit><form lang="kqs"><text>kpeloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kpelelan</text></form></field>
    <variant><form lang="kqs"><text>kpele</text></form></variant>
    <variant><form lang="kqs"><text>kpelela</text></form></variant>
    <sense id="kpeloo_1861_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lit, couche ; (kpele lɔaa n'mallo) aire de battage</text></gloss>
      <gloss lang="en"><text>bed, couch; (kpele lɔaa n'mallo) threshing floor</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bed; also a part of a rice field flattened by harvest or rain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 1SA.19.13; Childs 2000, p. 209: kpèlòó</text></form></note>
    <note><form lang="fr"><text>o kpelela lɔaa n'maltan coo « sur les aires » (1 S 23,1).</text></form></note>
  </entry>
  <entry id="kpélóó_1862">
    <lexical-unit><form lang="kqs"><text>kpélóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpéléláŋ</text></form></field>
    <sense id="kpélóó_1862_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jardin, potager</text></gloss>
      <gloss lang="en"><text>garden</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 210: kpélóó kpéléláŋ</text></form></note>
  </entry>
  <entry id="kpemaa_1863">
    <lexical-unit><form lang="kqs"><text>kpemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kpema</text></form></variant>
    <variant><form lang="kqs"><text>kpemala</text></form></variant>
    <sense id="kpemaa_1863_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pacte, alliance</text></gloss>
      <gloss lang="en"><text>pact, covenant ; covenant, agreement</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pact, covenant; also a vow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 298 occurrences, first GEN.6.18; Keita 1979, p. 156: Kpemaa; Lexique kissi–français, p. 28: kpemaa; Childs 2000, p. 210: kpémáá</text></form></note>
  </entry>
  <entry id="kpen_1864">
    <lexical-unit><form lang="kqs"><text>kpen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpen_1864_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>comme, semblable à (kpen a)</text></gloss>
      <gloss lang="en"><text>like, similar to (kpen a)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 83 occurrences, first GEN.33.10</text></form></note>
  </entry>
  <entry id="kpen_1865">
    <lexical-unit><form lang="kqs"><text>kpen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kpen_1865_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup ; (fixer) avec force</text></gloss>
      <gloss lang="en"><text>a lot; (fix) firmly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpen</text></form></note>
    <note><form lang="fr"><text>Homographe de kpen « comme » (Bible).</text></form></note>
