    <sense id="bɛllon_112_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmiste, noix de palme</text></gloss>
      <gloss lang="en"><text>palm nuts</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèllon; Childs 2000, p. 13: bɛ̌llé</text></form></note>
  </entry>
  <entry id="bɛ̀lɛ̀nnden_113">
    <lexical-unit><form lang="kqs"><text>bɛ̀lɛ̀nnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="bɛ̀lɛ̀nnden_113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flèche, javelot</text></gloss>
      <gloss lang="en"><text>arrow, javelin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.41.18; Keita 1979, p. 156: Bèlènden</text></form></note>
    <note><form lang="fr"><text>La Bible appelle aussi la flèche kɔɛi, pl. kɔɔn (Gn 27,3).</text></form></note>
  </entry>
  <entry id="bɛmbɛ_114">
    <lexical-unit><form lang="kqs"><text>bɛmbɛ</text></form></lexical-unit>
