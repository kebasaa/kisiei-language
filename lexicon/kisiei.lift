  <entry id="yiaan_3869">
    <lexical-unit><form lang="kqs"><text>yiaan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yima</text></form></variant>
    <sense id="yiaan_3869_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faim ; famine</text></gloss>
      <gloss lang="en"><text>hunger; famine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.25.30; Childs 2000, p. 406: yìáŋ</text></form></note>
    <note><form lang="fr"><text>yima fofolan « famine » (Gn 12,10).</text></form></note>
  </entry>
  <entry id="yifa_3870">
    <lexical-unit><form lang="kqs"><text>yifa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yifa_3870_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer (les paupières)</text></gloss>
      <gloss lang="en"><text>close (the eyelids)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>partially close, close without locking; hide</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.132.4; Childs 2000, p. 406: yìfàá</text></form></note>
    <note><form lang="fr"><text>i yifa lɛnin hɔlta koongula nilan « je ne fermerai pas les paupières » (PSA.132.4).</text></form></note>
  </entry>
  <entry id="yìfàá_3871">
    <lexical-unit><form lang="kqs"><text>yìfàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yìfàá_3871_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marque au front des musulmans (à effacer à leur mort)</text></gloss>
      <gloss lang="en"><text>mark Muslims wear on the forehead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yìfàá</text></form></note>
  </entry>
  <entry id="yifanndo_3872">
    <lexical-unit><form lang="kqs"><text>yifanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifan</text></form></variant>
    <sense id="yifanndo_3872_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'abriter, se réfugier ; se retirer, se tenir à l'écart</text></gloss>
      <gloss lang="en"><text>take shelter, take refuge; withdraw, keep apart</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>escape something, take precautions</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.30.2; Childs 2000, p. 406: yìfǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yifa. le kɔlan yifanndo o vunduma Esipte « pour s'abriter à l'ombre de l'Égypte » (ISA.30.2) ; mó yifan « il se tint à l'écart » (GAL.2.12).</text></form></note>
  </entry>
  <entry id="yifidii_3873">
    <lexical-unit><form lang="kqs"><text>yifidii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifidiio</text></form></variant>
    <variant><form lang="kqs"><text>yifidiia</text></form></variant>
    <variant><form lang="kqs"><text>yifidiila</text></form></variant>
    <sense id="yifidii_3873_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>obscurité, ténèbres ; (yɔŋnun yifidii) s'assombrir, se troubler (yeux, visage)</text></gloss>
      <gloss lang="en"><text>darkness, gloom; (yɔŋnun yifidii) grow dark, grow dim</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.28.65</text></form></note>
  </entry>
  <entry id="yifɔɔ_3874">
    <lexical-unit><form lang="kqs"><text>yifɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yifɔlan</text></form></field>
    <variant><form lang="kqs"><text>yifɔ</text></form></variant>
    <sense id="yifɔɔ_3874_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poche</text></gloss>
      <gloss lang="en"><text>pocket</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Yiföö; Childs 2000, p. 406: yífɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale yifɔ dans la Bible : « sein, pli du vêtement » (Pr 6,27), « ceinture » où l'on met l'argent (Mc 6,8).</text></form></note>
  </entry>
  <entry id="yíì_3875">
    <lexical-unit><form lang="kqs"><text>yíì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíì_3875_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>(cri d'enfant qui montre une chose laide ou effrayante)</text></gloss>
      <gloss lang="en"><text>(children's exclamation when showing something ugly or scary)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíì</text></form></note>
  </entry>
  <entry id="yíìì_3876">
    <lexical-unit><form lang="kqs"><text>yíìì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíìì_3876_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(très grand, énorme)</text></gloss>
      <gloss lang="en"><text>(underscores bigness)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíìì</text></form></note>
  </entry>
  <entry id="yiilu_3877">
    <lexical-unit><form lang="kqs"><text>yiilu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiilu_3877_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>conclure (une alliance) avec, promettre à</text></gloss>
      <gloss lang="en"><text>make (a covenant) with, promise to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 139 occurrences, first GEN.9</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de yiiyo.</text></form></note>
  </entry>
  <entry id="yiinanndo_3878">
    <lexical-unit><form lang="kqs"><text>yiinanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiinan</text></form></variant>
    <variant><form lang="kqs"><text>yiinannda</text></form></variant>
    <variant><form lang="kqs"><text>yiinannin</text></form></variant>
    <sense id="yiinanndo_3878_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'unir, se joindre, être lié (à) ; se liguer</text></gloss>
      <gloss lang="en"><text>join together, unite, be bound (to); league together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.30.12</text></form></note>
    <note><form lang="fr"><text>Réciproque de yiiyo « lier, établir ». laa … yiinan a pɔnɔ ndɔ « la femme est liée à son mari » (1CO.7.39).</text></form></note>
  </entry>
  <entry id="yiinde_3879">
    <lexical-unit><form lang="kqs"><text>yiinde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiiŋii</text></form></variant>
    <sense id="yiinde_3879_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheveux, poils ; laine</text></gloss>
      <gloss lang="en"><text>hair; wool</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.25.25; Keita 1979, p. 133: Yiinde; Childs 2000, p. 406: yììŋndé</text></form></note>
  </entry>
  <entry id="yiinɔnndo_3880">
    <lexical-unit><form lang="kqs"><text>yiinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiinɔnndo_3880_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se ceindre, s'attacher ; s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>gird oneself, tie on; attach oneself to, join</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie (a cloth) around oneself, wrap, wear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.15.12; Childs 2000, p. 406: yììnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yiiyo. yáwlen yiinɔnndo « ceindre la ceinture » (1KI.20.11).</text></form></note>
  </entry>
  <entry id="yiiyo_3881">
    <lexical-unit><form lang="kqs"><text>yiiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yii</text></form></variant>
    <sense id="yiiyo_3881_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>établir, conclure (alliance) ; poser, mettre ; ourdir (complot)</text></gloss>
      <gloss lang="en"><text>establish, make (covenant); set, put; hatch (a plot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie up, wrap; make a charm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first GEN.26.28; Childs 2000, p. 407: yììyó</text></form></note>
  </entry>
