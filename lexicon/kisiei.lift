      <gloss lang="fr"><text>repasser (le linge)</text></gloss>
      <gloss lang="en"><text>iron (clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: hàyàá</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
