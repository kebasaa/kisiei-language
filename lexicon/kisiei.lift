      <gloss lang="en"><text>fish hook</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.40.25; Keita 1979, p. 156: Dolinnde; Lexique kissi–français, p. 13: dolinnde</text></form></note>
    <note><form lang="fr"><text>Aussi Lexique kissi–français, p. 14 : « donnde ». Lexique kissi–français, p. 14 : donnde « hameçon ».</text></form></note>
  </entry>
  <entry id="dolio_1136">
    <lexical-unit><form lang="kqs"><text>dolio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
