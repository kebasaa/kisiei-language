    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bandaa_58_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fromager</text></gloss>
      <gloss lang="en"><text>kapok tree, silk-cotton tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bandaa</text></form></note>
    <note><form lang="fr"><text>Ceiba pentandra.</text></form></note>
  </entry>
  <entry id="bàndàléŋ_59">
