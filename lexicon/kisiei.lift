    <lexical-unit><form lang="kqs"><text>bóóŋìèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bóóŋìóŋ</text></form></field>
