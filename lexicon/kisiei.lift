    <trait name="status" value="respelled"/>
    <sense id="basi taando_26_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabatière</text></gloss>
      <gloss lang="en"><text>snuffbox</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tobacco, snuff</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: basi taando; Childs 2000, p. 347: tàáŋndó</text></form></note>
    <note><form lang="fr"><text>Le second élément correspond à tàáŋndó « tabac » chez Childs.</text></form></note>
  </entry>
  <entry id="basɔɔ_27">
    <lexical-unit><form lang="kqs"><text>basɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>basu</text></form></variant>
