    <trait name="status" value="attested"/>
    <sense id="fúú_920_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>complètement (fondo fúú « tout nu, entièrement vide »)</text></gloss>
      <gloss lang="en"><text>completely (fondo fúú 'stark naked, utterly empty')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 183 occurrences, first GEN.9.22</text></form></note>
