      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>punir, châtier ; réprimander</text></gloss>
      <gloss lang="en"><text>punish, chastise; rebuke</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.20.5</text></form></note>
  </entry>
