  <entry id="yɛiyo_6335">
    <lexical-unit><form lang="kqs"><text>yɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yɛiyon</text></form></field>
    <variant><form lang="kqs"><text>yɛiye</text></form></variant>
    <variant><form lang="kqs"><text>yɛiyun</text></form></variant>
    <variant><form lang="kqs"><text>yɛyii</text></form></variant>
    <sense id="yɛiyo_6335_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>semence, graine à semer ; (yɛyii) descendance</text></gloss>
      <gloss lang="en"><text>seed (for sowing); (yɛyii) offspring</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.3 Plant a field"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>seed, seedling</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.126.6; Lexique kissi–français, p. 65: yɛiyo; Childs 2000, p. 404: yèíyé</text></form></note>
    <note><form lang="fr"><text>yɛyii nda bɛnda le saŋɔɔ « semence à semer » (LEV.11.37) ; yɛyii ndɔɛi « sa descendance » (ISA.14.22).</text></form></note>
  </entry>
  <entry id="yɛ́íyó_6336">
    <lexical-unit><form lang="kqs"><text>yɛ́íyó</text></form></lexical-unit>
