    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Lalumèö; Lexique kissi–français, p. 31: lalumɛɔ; Terminologie (histoire), n° 69: Lalumèö</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 69) : « armée ».</text></form></note>
  </entry>
  <entry id="lámbáá_3030">
    <lexical-unit><form lang="kqs"><text>lámbáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lámbáá_3030_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (amer)</text></gloss>
      <gloss lang="en"><text>kind of tree (bitter)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: lámbáá</text></form></note>
  </entry>
  <entry id="lambanndo_3031">
    <lexical-unit><form lang="kqs"><text>lambanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lamban</text></form></variant>
    <variant><form lang="kqs"><text>lambaa</text></form></variant>
    <variant><form lang="kqs"><text>lambannin</text></form></variant>
    <sense id="lambanndo_3031_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insister, persister ; répéter ; (lamban … kɔɔli) presser qqn</text></gloss>
      <gloss lang="en"><text>insist, persist; repeat; (lamban … kɔɔli) press someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>continue, repeat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PRO.17.9; Childs 2000, p. 222: làmbǎŋndó</text></form></note>
    <note><form lang="fr"><text>lambanndo sondo « répéter une affaire » (PRO.17.9) ; I co lambanndo ɲunaa « je demande sans cesse » (ROM.1.10) ; lamban piɛiyo « pria avec insistance » (JAS.5.17).</text></form></note>
  </entry>
  <entry id="lambi_3032">
    <lexical-unit><form lang="kqs"><text>lambi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lambilan</text></form></field>
    <variant><form lang="kqs"><text>lambio</text></form></variant>
    <sense id="lambi_3032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>génération ; fois ; promotion (circoncis ou excisées d'une même classe)</text></gloss>
      <gloss lang="en"><text>generation; time (occasion); age set (those circumcised or excised together)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.50.23; Paulme 1964, p. 55: lambyo; Terminologie (histoire), n° 363: Lambiaa</text></form></note>
    <note><form lang="fr"><text>lambilan a lambilan « de génération en génération » ; lambi diinndɔ « une seconde fois » (Jos 5,2). Paulme 1964, p. 55 : lambyo « association des circoncis, ou excisées, d'une même promotion ». Académie des langues (terminologie, histoire n° 363, 208) : lambiaa « génération » ; lambioo « contemporain » (aussi viilan pilɔɔ).</text></form></note>
  </entry>
  <entry id="lambo lambo_3033">
    <lexical-unit><form lang="kqs"><text>lambo lambo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lambo lambo_3033_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste des rizières (contre les rhumatismes et les plaies)</text></gloss>
      <gloss lang="en"><text>rice-field shrub (for rheumatism and wounds)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 55: lambo lambo</text></form></note>
  </entry>
  <entry id="lámbùíyó_3034">
    <lexical-unit><form lang="kqs"><text>lámbùíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lámbùíyó_3034_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lanterne</text></gloss>
      <gloss lang="en"><text>lantern</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: lámbùíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais lamp.</text></form></note>
  </entry>
  <entry id="làmbùlàmbóó_3035">
    <lexical-unit><form lang="kqs"><text>làmbùlàmbóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>làmbùlàmbúéí</text></form></field>
    <variant><form lang="kqs"><text>làmbòlàmbóó</text></form></variant>
    <sense id="làmbùlàmbóó_3035_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre à longs fruits pendants</text></gloss>
      <gloss lang="en"><text>kind of tree with long hanging fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: làmbùlàmbóó</text></form></note>
  </entry>
  <entry id="lamndo_3036">
    <lexical-unit><form lang="kqs"><text>lamndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lamnda</text></form></field>
    <sense id="lamndo_3036_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauce ; (pl.) légumes</text></gloss>
      <gloss lang="en"><text>sauce, relish; (pl.) vegetables, greens</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sauce or soup poured over rice; soup greens</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.11.10; Paulme 1964, p. 55: lam, lamudo; Childs 2000, p. 222: làmndó</text></form></note>
    <note><form lang="fr"><text>Kiolu ɲɛdiaa mà vow lamndo « trempe ton pain dans la sauce » (RUT.2.14) ; nakɔ lamndo « potager » (DEU.11.10) ; lamnda lapeelan « des légumes » (ROM.14.2). Keita : Lamndo « sauce ». Paulme 1964, p. 55 : lam, lamudo « sauce, condiment » ; mumu lamdo « riz en sauce ».</text></form></note>
  </entry>
  <entry id="lan_3037">
    <lexical-unit><form lang="kqs"><text>lan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lan_3037_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces (classe lan)</text></gloss>
      <gloss lang="en"><text>these, those (lan class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3295 occurrences, first GEN.2.19; Childs 2000, p. 223: láŋ</text></form></note>
  </entry>
  <entry id="làndàá_3038">
    <lexical-unit><form lang="kqs"><text>làndàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làndàá_3038_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque (« diable ») au long museau</text></gloss>
      <gloss lang="en"><text>mask ('devil') with a long snout</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: làndàá</text></form></note>
    <note><form lang="fr"><text>Emprunt au bandi ou au loma ; même masque que ŋúɲàá.</text></form></note>
  </entry>
  <entry id="lándán_3039">
    <lexical-unit><form lang="kqs"><text>lándán</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lándán_3039_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>au loin, plus loin (levil lándán « bien loin »)</text></gloss>
      <gloss lang="en"><text>far off, further on (levil lándán 'far away')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.4.14</text></form></note>
  </entry>
  <entry id="landei_3040">
    <lexical-unit><form lang="kqs"><text>landei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>landii</text></form></variant>
    <sense id="landei_3040_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gage, nantissement</text></gloss>
      <gloss lang="en"><text>pledge, pawn, security</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pawn, guarantee; also a person indentured for a debt</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first GEN.38.17; Childs 2000, p. 223: làndéí</text></form></note>
    <note><form lang="fr"><text>o landei nin « en gage » (EXO.22.25) ; landii ndɔɛi « son gage » (DEU.24.12).</text></form></note>
  </entry>
  <entry id="làndìáŋ_3041">
    <lexical-unit><form lang="kqs"><text>làndìáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>làndìléŋ</text></form></field>
    <sense id="làndìáŋ_3041_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>suie</text></gloss>
      <gloss lang="en"><text>soot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 223: làndìáŋ</text></form></note>
