    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sámbìóó_4388_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sortilège, ensorcellement (« dragon humain »)</text></gloss>
      <gloss lang="en"><text>evil medicine, bewitching</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 320: sámbìóó</text></form></note>
  </entry>
  <entry id="sambiyo_4389">
    <lexical-unit><form lang="kqs"><text>sambiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="sambiyo_4389_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médicament du sorcier (kuino), parfois mortel</text></gloss>
      <gloss lang="en"><text>sorcerer's (kuino) medicine, sometimes deadly</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 88: sambiyo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 88 : il éclaire les nuits sans lune ; on le frotte de sang humain ; vana sambiyo « possesseur de sambiyo ».</text></form></note>
  </entry>
  <entry id="sambɛiyo_4390">
    <lexical-unit><form lang="kqs"><text>sambɛiyo</text></form></lexical-unit>
