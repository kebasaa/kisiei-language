  <entry id="ɲia_4169">
    <lexical-unit><form lang="kqs"><text>ɲia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲia_4169_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faveur (ca … ɲia « regarder avec faveur »)</text></gloss>
      <gloss lang="en"><text>favour (ca … ɲia 'look on with favour')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.6.8</text></form></note>
  </entry>
  <entry id="ɲìàá_4170">
    <lexical-unit><form lang="kqs"><text>ɲìàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="ɲìàá_4170_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aimer, chérir</text></gloss>
      <gloss lang="en"><text>like, love</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.3 Love"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 279: ɲìàá</text></form></note>
    <note><form lang="fr"><text>Cf. peut-être ɲia « faveur » (Bible).</text></form></note>
  </entry>
