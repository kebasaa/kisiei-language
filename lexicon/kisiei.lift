    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="càlè-kɔ̀ŋgúlúmàléŋ_443_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>papaye</text></gloss>
      <gloss lang="en"><text>papaya, pawpaw</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 37: càlè-kɔ̀ŋgúlúmàléŋ</text></form></note>
  </entry>
  <entry id="càlè-sèìléŋ_444">
    <lexical-unit><form lang="kqs"><text>càlè-sèìléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cèì-sèìyá</text></form></field>
    <sense id="càlè-sèìléŋ_444_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à bois tendre et fruit amer semblable à la papaye (aimé des porcs-épics)</text></gloss>
      <gloss lang="en"><text>soft-wooded tree with a bitter papaya-like fruit (liked by porcupines)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 37: càlè-sèìléŋ</text></form></note>
  </entry>
  <entry id="caleholen_445">
    <lexical-unit><form lang="kqs"><text>caleholen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="caleholen_445_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>melon</text></gloss>
      <gloss lang="en"><text>melon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 8: caleholen</text></form></note>
  </entry>
  <entry id="calen_446">
    <lexical-unit><form lang="kqs"><text>calen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="calen_446_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>papaye</text></gloss>
      <gloss lang="en"><text>papaya</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>papaya; pumpkin; anything gourd-shaped</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Tyalen; Lexique kissi–français, p. 8: calen; Childs 2000, p. 37: càléŋ</text></form></note>
  </entry>
  <entry id="calnun_447">
    <lexical-unit><form lang="kqs"><text>calnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="calnun_447_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'établir, se fixer</text></gloss>
      <gloss lang="en"><text>settle down</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first GEN.4.16</text></form></note>
    <note><form lang="fr"><text>Moyen de calaa « habiter ».</text></form></note>
