    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="banɛiyo_92_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grande machette</text></gloss>
      <gloss lang="en"><text>large machete</text></gloss>
