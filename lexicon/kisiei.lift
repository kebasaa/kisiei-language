  <entry id="kamalindoŋnden_1926">
    <lexical-unit><form lang="kqs"><text>kamalindoŋnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="kamalindoŋnden_1926_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balançoire</text></gloss>
      <gloss lang="en"><text>swing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>swing, usually made of vines</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Kamalindonden; Childs 2000, p. 146: kàmálíndóŋndó</text></form></note>
    <note><form lang="fr"><text>ŋ d'après Childs.</text></form></note>
  </entry>
  <entry id="kamanda_1927">
    <lexical-unit><form lang="kqs"><text>kamanda</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kamanda_1927_s1">
