      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure (de capacité), bath</text></gloss>
      <gloss lang="en"><text>measure (of capacity), bath</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>small measuring cup</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EZK.45.11; Childs 2000, p. 267: ndéwèìyó</text></form></note>
    <note><form lang="fr"><text>panila … a ndeveila « des épha et des bath » (LEV.19.36, EZK.45.10). Correspondance w ~ v.</text></form></note>
  </entry>
