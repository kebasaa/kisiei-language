    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.18.6</text></form></note>
  </entry>
  <entry id="kiltan_1601">
    <lexical-unit><form lang="kqs"><text>kiltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilta</text></form></variant>
    <sense id="kiltan_1601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>course ; (a kiltan) en courant</text></gloss>
