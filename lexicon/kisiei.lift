      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre de forêt à petits fruits comestibles (genre prune)</text></gloss>
      <gloss lang="en"><text>large forest tree with small plum-like edible fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 142: kààŋgòó kààŋgùéí</text></form></note>
  </entry>
