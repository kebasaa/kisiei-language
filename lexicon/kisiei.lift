      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>littérature</text></gloss>
      <gloss lang="en"><text>literature</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 235: Nyètyaa, söön sèvaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi ɲɛcaa (cf. kissi du Sud ɲɛ̀càá « savoir-faire », Childs 2000).</text></form></note>
  </entry>
