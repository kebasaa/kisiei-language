    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 29: kpulun</text></form></note>
    <note><form lang="fr"><text>Une occurrence biblique (ISA.30.31), sens non vérifié. Cf. kpilin.</text></form></note>
