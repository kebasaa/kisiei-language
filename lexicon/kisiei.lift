      <gloss lang="en"><text>sudden movement</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 9: bàú</text></form></note>
  </entry>
  <entry id="bàùwé_103">
    <lexical-unit><form lang="kqs"><text>bàùwé</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bàùwé_103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couteau à sculpter le bois</text></gloss>
      <gloss lang="en"><text>wood-carving knife</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 9: bàùwé</text></form></note>
  </entry>
  <entry id="bawlan_104">
    <lexical-unit><form lang="kqs"><text>bawlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bawla</text></form></variant>
    <sense id="bawlan_104_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crochets, agrafes</text></gloss>
      <gloss lang="en"><text>hooks, clasps</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.26.6</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="bawve_105">
    <lexical-unit><form lang="kqs"><text>bawve</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bawve_105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>outil pour tailler les manches de houe ou de hache</text></gloss>
      <gloss lang="en"><text>tool for carving hoe or axe handles</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: bawve</text></form></note>
  </entry>
  <entry id="bawvo_106">
    <lexical-unit><form lang="kqs"><text>bawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bawvo_106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourche, support ; cheville (pour suspendre)</text></gloss>
      <gloss lang="en"><text>forked prop, support; peg (to hang things on)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.40.12; Lexique kissi–français, p. 4: bawvo</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « la fourche qui soutient qqch. ». En EZK.15.3, bawvo est la cheville où l'on suspend des objets.</text></form></note>
  </entry>
  <entry id="bayiaa_107">
    <lexical-unit><form lang="kqs"><text>bayiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bayiaanin</text></form></variant>
    <sense id="bayiaa_107_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, fixer, coudre (sur)</text></gloss>
      <gloss lang="en"><text>fasten, attach, sew on</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.27.16</text></form></note>
  </entry>
  <entry id="bayian_108">
    <lexical-unit><form lang="kqs"><text>bayian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bayian_108_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attacher, se ceindre (de) ; enlacer</text></gloss>
      <gloss lang="en"><text>tie on oneself, gird oneself; entangle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2SA.22.5</text></form></note>
    <note><form lang="fr"><text>Moyen de bayiaa.</text></form></note>
  </entry>
  <entry id="bayullo_109">
    <lexical-unit><form lang="kqs"><text>bayullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bayullo_109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liane servant à faire les ponts de lianes (tallo)</text></gloss>
      <gloss lang="en"><text>liana used to make vine bridges (tallo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 4: bayullo</text></form></note>
  </entry>
  <entry id="baŋa_110">
    <lexical-unit><form lang="kqs"><text>baŋa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="baŋa_110_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sauver, délivrer</text></gloss>
      <gloss lang="en"><text>save, deliver</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>release, free, redeem</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 303 occurrences, first GEN.14; Childs 2000, p. 7: bàŋàá</text></form></note>
  </entry>
  <entry id="bàŋà-kpààŋndó_111">
    <lexical-unit><form lang="kqs"><text>bàŋà-kpààŋndó</text></form></lexical-unit>
