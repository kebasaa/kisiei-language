  <entry id="hinullo_370">
    <lexical-unit><form lang="kqs"><text>hinullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hinul</text></form></variant>
    <variant><form lang="kqs"><text>hinulnin</text></form></variant>
    <sense id="hinullo_370_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir contre, s'avancer vers ; menacer</text></gloss>
      <gloss lang="en"><text>come against, advance on; threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.14.10; Keita 1979, p. 110: Hinullo</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hunɔɔ (radical négatif hin). Dans la Bible : « marcher contre » (EXO 14,10), « tourner sa face contre » (LEV 20,6).</text></form></note>
  </entry>
  <entry id="hiovɔɔ_371">
    <lexical-unit><form lang="kqs"><text>hiovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiow</text></form></variant>
    <variant><form lang="kqs"><text>hiaw</text></form></variant>
    <variant><form lang="kqs"><text>hiw</text></form></variant>
    <variant><form lang="kqs"><text>hiawnin</text></form></variant>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <variant><form lang="kqs"><text>hiownun</text></form></variant>
    <sense id="hiovɔɔ_371_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, dépasser ; dépasser, surpasser</text></gloss>
      <gloss lang="en"><text>pass, surpass ; pass; exceed, surpass</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go by, pass</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.4.3; Keita 1979, p. 115: Hiowvöö; Childs 2000, p. 127: hìòùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit hiowvöö ; la Bible écrit hiovɔɔ. hiw, hiwnin : radical négatif (GEN 6,3 ; MAT 24,34). hiow … vaa « plus que » (comparatif).</text></form></note>
  </entry>
  <entry id="hivi_372">
    <lexical-unit><form lang="kqs"><text>hivi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <sense id="hivi_372_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, livrer, remettre</text></gloss>
      <gloss lang="en"><text>hand over, deliver to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lift over; circumcise; translate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.16.3; Childs 2000, p. 125: hììwìó</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ « passer ».</text></form></note>
  </entry>
