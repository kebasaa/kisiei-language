  <entry id="kpeloo_2418">
    <lexical-unit><form lang="kqs"><text>kpeloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kpelelan</text></form></field>
    <variant><form lang="kqs"><text>kpele</text></form></variant>
    <variant><form lang="kqs"><text>kpelela</text></form></variant>
    <sense id="kpeloo_2418_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lit, couche ; (kpele lɔaa n'mallo) aire de battage</text></gloss>
      <gloss lang="en"><text>bed, couch; (kpele lɔaa n'mallo) threshing floor</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bed; also a part of a rice field flattened by harvest or rain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 1SA.19.13; Paulme 1964, p. 8: bɛro, pl. bɛrɛlã; Childs 2000, p. 209: kpèlòó</text></form></note>
    <note><form lang="fr"><text>o kpelela lɔaa n'maltan coo « sur les aires » (1 S 23,1). Paulme 1964, p. 8 : bɛro, pl. bɛrɛlã « lit (plateforme en terre) ».</text></form></note>
  </entry>
  <entry id="kpélóó_2419">
