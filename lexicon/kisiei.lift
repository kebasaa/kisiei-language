    <trait name="status" value="attested"/>
    <sense id="bau_28_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>car, puisque</text></gloss>
      <gloss lang="en"><text>for, because</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 83 occurrences, first GEN.9.6</text></form></note>
  </entry>
  <entry id="baŋa_29">
    <lexical-unit><form lang="kqs"><text>baŋa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="baŋa_29_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sauver, délivrer</text></gloss>
      <gloss lang="en"><text>save, deliver</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>release, free, redeem</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 303 occurrences, first GEN.14; Childs 2000, p. 7: bàŋàá</text></form></note>
