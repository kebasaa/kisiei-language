    <variant><form lang="kqs"><text>sɔɔlaa</text></form></variant>
    <variant><form lang="kqs"><text>sɔɔlaalan</text></form></variant>
    <sense id="sɔɔluuo_3790_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>broder</text></gloss>
      <gloss lang="en"><text>embroider</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.26.1</text></form></note>
    <note><form lang="fr"><text>vanaa caa sɔɔluuo « les brodeurs habiles » (Ex 26,1) ; doma bɛndu sɔɔlaa « robe brodée » (Ez 16,10).</text></form></note>
  </entry>
  <entry id="sɔɔlɛmaa_3791">
