    <trait name="status" value="southern"/>
    <sense id="bàŋà-kpààŋndó_111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau noir de la haute forêt qui mange le riz mûrissant</text></gloss>
      <gloss lang="en"><text>black bird of the high forest that eats ripening rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 7: bàŋà-kpààŋndó</text></form></note>
  </entry>
  <entry id="baŋaa_112">
    <lexical-unit><form lang="kqs"><text>baŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baŋa</text></form></variant>
    <variant><form lang="kqs"><text>baŋanin</text></form></variant>
    <variant><form lang="kqs"><text>baŋan</text></form></variant>
    <sense id="baŋaa_112_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>délivrer, sauver ; racheter</text></gloss>
      <gloss lang="en"><text>deliver, save, set free; redeem, buy back</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 199 occurrences, first GEN.19.20; Keita 1979, p. 110: Banhaa; Lexique kissi–français, p. 4: baŋaa/ baŋa; Childs 2000, p. 7: bàŋàá</text></form></note>
    <note><form lang="fr"><text>baŋan : moyen « être sauvé, se libérer ». Lexique kissi–français, p. 4 : « racheter ».</text></form></note>
  </entry>
  <entry id="baŋan_113">
    <lexical-unit><form lang="kqs"><text>baŋan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>baŋanin</text></form></variant>
    <variant><form lang="kqs"><text>baŋanndo</text></form></variant>
    <sense id="baŋan_113_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être sauvé, être racheté</text></gloss>
      <gloss lang="en"><text>be saved, be redeemed</text></gloss>
