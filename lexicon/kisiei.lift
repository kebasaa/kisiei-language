      <gloss lang="fr"><text>salaire, paie</text></gloss>
      <gloss lang="en"><text>salary, pay</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkàndàá</text></form></note>
  </entry>
  <entry id="sàkéí_3368">
    <lexical-unit><form lang="kqs"><text>sàkéí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sàkéí_3368_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>courbé, tordu</text></gloss>
      <gloss lang="en"><text>bent, twisted</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkéí</text></form></note>
  </entry>
  <entry id="sákí-sákí_3369">
    <lexical-unit><form lang="kqs"><text>sákí-sákí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sákí-sákí_3369_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>brûlant ; furieux</text></gloss>
      <gloss lang="en"><text>burning hot; furious</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sákí-sákí</text></form></note>
  </entry>
  <entry id="sakiei_3370">
    <lexical-unit><form lang="kqs"><text>sakiei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="sakiei_3370_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épée</text></gloss>
      <gloss lang="en"><text>sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sword, dagger</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Sakiei; Lexique kissi–français, p. 46: sakiei; Childs 2000, p. 318: sákìèí</text></form></note>
    <note><form lang="fr"><text>La Bible dit mɔɛi cɔwve pour « épée ».</text></form></note>
  </entry>
  <entry id="sàkó_3371">
    <lexical-unit><form lang="kqs"><text>sàkó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sàkó_3371_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>non ! (désaccord vif)</text></gloss>
      <gloss lang="en"><text>no! (strong disagreement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkó</text></form></note>
  </entry>
  <entry id="sàkómbɔ̀_3372">
    <lexical-unit><form lang="kqs"><text>sàkómbɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sàkómbɔ̀_3372_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>non ! (désaccord vif)</text></gloss>
      <gloss lang="en"><text>no! (strong disagreement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkómbɔ̀</text></form></note>
  </entry>
  <entry id="sákpàà_3373">
    <lexical-unit><form lang="kqs"><text>sákpàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sákpàà_3373_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très long (souligne la longueur)</text></gloss>
      <gloss lang="en"><text>very long (stresses length)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sákpàà</text></form></note>
  </entry>
  <entry id="sakpoo_3374">
    <lexical-unit><form lang="kqs"><text>sakpoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sakpo</text></form></variant>
    <sense id="sakpoo_3374_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>droit, intègre</text></gloss>
      <gloss lang="en"><text>upright, honest</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) straight ahead, erect; right away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first DEU.32.4; Childs 2000, p. 318: sákpò</text></form></note>
  </entry>
  <entry id="sakpoyɛi_3375">
    <lexical-unit><form lang="kqs"><text>sakpoyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="sakpoyɛi_3375_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>droiture, intégrité, équité</text></gloss>
      <gloss lang="en"><text>uprightness, integrity, equity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first 2SA.2.6</text></form></note>
  </entry>
  <entry id="sálàá_3376">
    <lexical-unit><form lang="kqs"><text>sálàá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sálàlan</text></form></field>
    <variant><form lang="kqs"><text>sálà</text></form></variant>
    <variant><form lang="kqs"><text>sálàla</text></form></variant>
    <sense id="sálàá_3376_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sacrifice, offrande</text></gloss>
      <gloss lang="en"><text>sacrifice, offering</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sacrifice; blessing; charm, talisman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 307 occurrences, first GEN.4.3; Lexique kissi–français, p. 47: saraa; Childs 2000, p. 319: sálàá</text></form></note>
    <note><form lang="fr"><text>vana-solia-lasálàá « prêtre » ; fonda-loamaa-lasálàá « autel ».</text></form></note>
  </entry>
  <entry id="salaa_3377">
    <lexical-unit><form lang="kqs"><text>salaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sala</text></form></variant>
    <sense id="salaa_3377_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>salaire, paie</text></gloss>
      <gloss lang="en"><text>wage, pay</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 307 occurrences, first GEN.4.3; Lexique kissi–français, p. 47: saraa/ sara</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne « payer, le salaire » ; dans la Bible, sala nɔm « payer le salaire » (GEN.30.28). Ne pas confondre avec sálàá « sacrifice ».</text></form></note>
  </entry>
  <entry id="sàlàá_3378">
    <lexical-unit><form lang="kqs"><text>sàlàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>sàlàláŋ</text></form></field>
    <sense id="sàlàá_3378_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte, espèce ; groupe, quantité</text></gloss>
      <gloss lang="en"><text>type, kind; group, quantity</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 319: sàlàá</text></form></note>
  </entry>
  <entry id="sálàbàlàà-sálàbàlàà_3379">
    <lexical-unit><form lang="kqs"><text>sálàbàlàà-sálàbàlàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sálàbàlàà-sálàbàlàà_3379_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très long (objet)</text></gloss>
      <gloss lang="en"><text>very long (object)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 319: sálàbàlàà-sálàbàlàà</text></form></note>
  </entry>
  <entry id="sálábú_3380">
    <lexical-unit><form lang="kqs"><text>sálábú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sálábú_3380_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>étendu de tout son long</text></gloss>
      <gloss lang="en"><text>stretched out straight</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 319: sálábú</text></form></note>
  </entry>
  <entry id="salalan_3381">
    <lexical-unit><form lang="kqs"><text>salalan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="salalan_3381_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>blagues</text></gloss>
      <gloss lang="en"><text>jokes</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: salaran</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit salaran. Homographe de sálàlan « sacrifices » (Bible).</text></form></note>
  </entry>
  <entry id="salamayɛi_3382">
    <lexical-unit><form lang="kqs"><text>salamayɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sálámaa</text></form></variant>
    <sense id="salamayɛi_3382_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>splendeur, gloire, beauté ; (sálámaa) beau, gracieux</text></gloss>
      <gloss lang="en"><text>splendour, glory, beauty; (sálámaa) handsome, graceful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>favourite or cherished child</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.13.19; Childs 2000, p. 319: sálámáá</text></form></note>
    <note><form lang="fr"><text>o cɔm salamayɛi masɛi-yo « la splendeur des royaumes » (ISA.13.19) ; le salamayɛi nii cɔmndo « pour manifester ma gloire » (ISA.60.21) ; sálámaa lekɛ́ndɛi o va ni « il était beau de figure » (GEN.39.6). Le lien avec le sens de Childs (enfant chéri) est incertain.</text></form></note>
  </entry>
  <entry id="salanndo_3383">
    <lexical-unit><form lang="kqs"><text>salanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>salan</text></form></variant>
    <sense id="salanndo_3383_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rattraper</text></gloss>
      <gloss lang="en"><text>catch (again)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: salanndo/ salan</text></form></note>
    <note><form lang="fr"><text>La Bible a sálàn « sacrifices », sens différent.</text></form></note>
  </entry>
  <entry id="salatio_3384">
    <lexical-unit><form lang="kqs"><text>salatio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="salatio_3384_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>autorité, pouvoir</text></gloss>
      <gloss lang="en"><text>authority, power</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 47: saratio</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
