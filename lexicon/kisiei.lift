  <entry id="kookoo_1698">
    <lexical-unit><form lang="kqs"><text>kookoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kookoo_1698_s1">
