      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ressusciter, revivre</text></gloss>
      <gloss lang="en"><text>rise again, revive</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6 Life"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>get up, arise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 80 occurrences, first GEN.45.27; Childs 2000, p. 352: tèndùlló</text></form></note>
    <note><form lang="fr"><text>Dérivé de tendu.</text></form></note>
  </entry>
  <entry id="tengaa_1648">
    <lexical-unit><form lang="kqs"><text>tengaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tenga</text></form></variant>
    <sense id="tengaa_1648_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briller, éclairer, luire</text></gloss>
      <gloss lang="en"><text>shine, give light</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) an illuminated place, as lit up by a torch or lightning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 257 occurrences, first GEN.1.4; Childs 2000, p. 352: tèŋàá</text></form></note>
    <note><form lang="fr"><text>ɲɛ-tengaa « lumière, luminaire » (Gn 1,15).</text></form></note>
  </entry>
  <entry id="terebɛnteo_1649">
    <lexical-unit><form lang="kqs"><text>terebɛnteo</text></form></lexical-unit>
