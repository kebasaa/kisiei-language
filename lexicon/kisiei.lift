    <sense id="pembulen_2564_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>région montagneuse (lɛŋnde n'pembulen « pays de montagnes »)</text></gloss>
      <gloss lang="en"><text>hill country (lɛŋnde n'pembulen 'hill country')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
