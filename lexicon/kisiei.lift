  <entry id="lɛ̀mbɛ̀-làkpáùwó_2538">
    <lexical-unit><form lang="kqs"><text>lɛ̀mbɛ̀-làkpáùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lɛ̀mbɛ̀-làkpáùwó_2538_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagne de ceinture des filles</text></gloss>
