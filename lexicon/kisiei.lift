      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kólóŋkólòŋndó</text></form></note>
  </entry>
  <entry id="kòlòŋtìɔ́_2206">
    <lexical-unit><form lang="kqs"><text>kòlòŋtìɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kòlòŋtèláŋ</text></form></field>
    <sense id="kòlòŋtìɔ́_2206_s1">
      <grammatical-info value="Noun"/>
