      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 271: ŋɔ̀ŋɔ̀làá</text></form></note>
  </entry>
  <entry id="ŋɔ́ɔ́_6422">
