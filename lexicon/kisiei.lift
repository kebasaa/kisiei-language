    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>leelan</text></form></field>
    <variant><form lang="kqs"><text>leela</text></form></variant>
    <sense id="lee_992_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>corne ; trompe (en corne)</text></gloss>
      <gloss lang="en"><text>horn; (horn) trumpet</text></gloss>
