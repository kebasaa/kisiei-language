    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ɲàŋgàfòó</text></form></variant>
    <sense id="ɲàŋàfòó_4161_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie qui provoque des démangeaisons</text></gloss>
      <gloss lang="en"><text>disease causing itching</text></gloss>
