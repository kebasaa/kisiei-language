    <variant><form lang="kqs"><text>tálále</text></form></variant>
    <sense id="táláá_3265_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moitié</text></gloss>
      <gloss lang="en"><text>half</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first EXO.24.6</text></form></note>
    <note><form lang="fr"><text>polale tálále Manase « la demi-tribu de Manassé ».</text></form></note>
  </entry>
  <entry id="tallo_3266">
    <lexical-unit><form lang="kqs"><text>tallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="tallo_3266_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pont</text></gloss>
      <gloss lang="en"><text>bridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bridge, traditionally made of vines</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Tallo; Childs 2000, p. 348: tàlló</text></form></note>
  </entry>
  <entry id="taloo_3267">
    <lexical-unit><form lang="kqs"><text>taloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>talelan</text></form></field>
    <variant><form lang="kqs"><text>tale</text></form></variant>
    <variant><form lang="kqs"><text>talela</text></form></variant>
    <sense id="taloo_3267_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>proverbe, parabole ; énigme</text></gloss>
      <gloss lang="en"><text>proverb, parable; riddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>proverb, moral; story, folk tale</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.10.9; Childs 2000, p. 348: tàlóó</text></form></note>
  </entry>
  <entry id="támái_3268">
    <lexical-unit><form lang="kqs"><text>támái</text></form></lexical-unit>
