    <trait name="status" value="respelled"/>
    <sense id="yuɲennda_6268_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>caste</text></gloss>
      <gloss lang="en"><text>caste</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 142: Yunyennda</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi vanaa yuɲɛnnda « gens de caste » (histoire n° 364, avec è).</text></form></note>
  </entry>
  <entry id="yɔ_6269">
    <lexical-unit><form lang="kqs"><text>yɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔ_6269_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>encore (pas encore)</text></gloss>
      <gloss lang="en"><text>yet, still</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 129 occurrences, first GEN.4.23; Lexique kissi–français, p. 67: yɔ</text></form></note>
    <note><form lang="fr"><text>La bii yɔ bila le « vous ne comprenez pas encore » (MAT.16.9).</text></form></note>
  </entry>
  <entry id="yɔco_6270">
    <lexical-unit><form lang="kqs"><text>yɔco</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yɔco_6270_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau</text></gloss>
      <gloss lang="en"><text>bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 129: yɔtyo</text></form></note>
    <note><form lang="fr"><text>Paulme : yɔtyo ɔ yɔmdɔ tyo « l'oiseau est au sommet de l'arbre ». Le mot courant est yowvo (Paulme yuwa « oiseaux », p. 130) ; lecture à vérifier.</text></form></note>
  </entry>
  <entry id="yɔkpaa_6271">
    <lexical-unit><form lang="kqs"><text>yɔkpaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yɔkpa</text></form></variant>
    <variant><form lang="kqs"><text>yɔkpanin</text></form></variant>
    <sense id="yɔkpaa_6271_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'épuiser, être à bout de forces ; être accablé</text></gloss>
      <gloss lang="en"><text>be exhausted, worn out; be crushed</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.38.7; Childs 2000, p. 413: yɔ̀kpáá</text></form></note>
  </entry>
  <entry id="yɔkpo_6272">
    <lexical-unit><form lang="kqs"><text>yɔkpo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔkpo_6272_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste (espèce) dont l'infusion sert à frotter chasseur, chien et fusil avant la chasse</text></gloss>
      <gloss lang="en"><text>shrub (species) whose infusion is rubbed on hunter, dog and gun before hunting</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128: yɔgbo</text></form></note>
    <note><form lang="fr"><text>Canton de Kossa (Paulme).</text></form></note>
  </entry>
  <entry id="yɔ́kpɔ̀ɔ́_6273">
    <lexical-unit><form lang="kqs"><text>yɔ́kpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yɔ́kpɔ̀léŋ</text></form></field>
    <sense id="yɔ́kpɔ̀ɔ́_6273_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>légume-feuille comestible (genre chou vert)</text></gloss>
      <gloss lang="en"><text>edible leafy green (like collard greens)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 413: yɔ́kpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yɔkɔɔ_6274">
    <lexical-unit><form lang="kqs"><text>yɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔkɔɔ_6274_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone, avec sangaa) épuisé, à bout de forces</text></gloss>
      <gloss lang="en"><text>(ideophone, with sangaa) utterly exhausted</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.25.29</text></form></note>
  </entry>
  <entry id="yɔl_6275">
    <lexical-unit><form lang="kqs"><text>yɔl</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔl_6275_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>terrasser, renverser ; vaincre</text></gloss>
      <gloss lang="en"><text>throw down; overcome, prevail</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first GEN.30.8</text></form></note>
  </entry>
  <entry id="yɔlɔ-yɔlɔ_6276">
    <lexical-unit><form lang="kqs"><text>yɔlɔ-yɔlɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔlɔ-yɔlɔ_6276_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(objet petit) flottant dans un trou trop grand</text></gloss>
      <gloss lang="en"><text>(of a small thing) loose in a hole too big</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yɔlɔ-yɔlɔ</text></form></note>
  </entry>
  <entry id="yɔlɔn_6277">
    <lexical-unit><form lang="kqs"><text>yɔlɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔlɔn_6277_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaîne, cordon</text></gloss>
      <gloss lang="en"><text>chain, cord</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.38.18; Keita 1979, p. 160: Yölön; Lexique kissi–français, p. 67: yɔlɔn; Childs 2000, p. 413: yɔ̀lúɛ́í</text></form></note>
    <note><form lang="fr"><text>Chez Childs, yɔ̀lɔ̌ŋ est le pluriel de yɔ̀lúɛ́í « chaîne » ; la Bible emploie yɔlɔn aussi pour une seule chaîne.</text></form></note>
  </entry>
  <entry id="yɔlɔɔ_6278">
    <lexical-unit><form lang="kqs"><text>yɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yɔlɔɔ_6278_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>taon, mouche tsé-tsé ; mouche qui pique</text></gloss>
      <gloss lang="en"><text>cow fly, tsetse fly; biting fly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 129: yɔrɔ, pl. yɔrɔa; Lexique kissi–français, p. 67: yɔlɔɔ; Childs 2000, p. 413: yɔ́lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 67 (« une mouche qui pique »). Homographe d'un verbe yɔlɔɔ de la Bible (PSA.37.14). Pluriel en kissi du Sud (Childs 2000) : yɔ́lúá.</text></form></note>
  </entry>
  <entry id="yɔmba_6279">
    <lexical-unit><form lang="kqs"><text>yɔmba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔmba_6279_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poisson rayé (espèce) vivant avec les mbona</text></gloss>
      <gloss lang="en"><text>striped fish (species) living with the mbona</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128: yɔmba</text></form></note>
    <note><form lang="fr"><text>Paulme : à Kɔledu. Aussi nom de l'enfant qui naît après des jumeaux.</text></form></note>
  </entry>
  <entry id="yɔmbalen_6280">
    <lexical-unit><form lang="kqs"><text>yɔmbalen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔmbalen_6280_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poésie</text></gloss>
      <gloss lang="en"><text>poetry</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.4 Story"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 312: Yömbalen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Poétique » : a yömbalen o köö, nèi leyömbaa (langue n° 314). Cf. yɔmbanɔ « chanteur ».</text></form></note>
  </entry>
  <entry id="yɔmbalen tosaa_6281">
    <lexical-unit><form lang="kqs"><text>yɔmbalen tosaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔmbalen tosaa_6281_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>récital</text></gloss>
      <gloss lang="en"><text>recital</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 348: Yömbalen tosaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yɔ̀mbáléŋ_6282">
    <lexical-unit><form lang="kqs"><text>yɔ̀mbáléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yɔ̀mbáléŋ_6282_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chant de louange (aux récoltes, au sarclage)</text></gloss>
      <gloss lang="en"><text>praise singing (during harvest or weeding)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 413: yɔ̀mbáléŋ</text></form></note>
  </entry>
  <entry id="yɔmbanɔ_6283">
    <lexical-unit><form lang="kqs"><text>yɔmbanɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔmbanɔ_6283_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chanteur, chanteur de louanges ; poète</text></gloss>
      <gloss lang="en"><text>singer, praise singer; poet</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>praise singer at funerals etc., entertainer</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.33.32; Terminologie (langue), n° 313: Yömbanöö; Childs 2000, p. 413: yɔ̀mbánɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>maa yɔmbanɔ diom kɛndɛ « comme un chanteur à la belle voix » (EZK.33.32). Académie des langues (terminologie, langue n° 313) : yömbanöö « poète ». Académie des langues (terminologie, arts n° 51) : yömbanö laandoo « cantatrice ». Aussi Terminologie, p. 377 : « Yönbanöö ». Académie des langues (terminologie, histoire n° 377) : yɔnbanɔɔ « héraut ».</text></form></note>
  </entry>
  <entry id="yɔ́mbɔ̀ɔ́_6284">
    <lexical-unit><form lang="kqs"><text>yɔ́mbɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yɔ́mbɔ̀ɔ́_6284_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plat très huileux</text></gloss>
      <gloss lang="en"><text>food with a lot of oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 413: yɔ́mbɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yɔmndo_6285">
    <lexical-unit><form lang="kqs"><text>yɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yɔmii</text></form></field>
    <variant><form lang="kqs"><text>yɔm</text></form></variant>
    <sense id="yɔmndo_6285_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre ; bois ; brousse, forêt</text></gloss>
      <gloss lang="en"><text>tree; wood; bush, forest</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.5.3 Building materials"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 75 occurrences, first GEN.2.5; Keita 1979, p. 140: Yömndo; Paulme 1964, p. 128: yɔmdo, pl. yɔmde – yɔmde; Lexique kissi–français, p. 67: yɔmndo; Childs 2000, p. 413: yɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 128 : yɔmdo « arbre, bois » et « brousse, forêt » (ẅisya yɔmdoni « les bêtes sauvages ») ; yɔm'sola « bois sacré ».</text></form></note>
  </entry>
  <entry id="yɔmɔle_6286">
    <lexical-unit><form lang="kqs"><text>yɔmɔle</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔmɔle_6286_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre (espèce) dont l'écorce soigne la rétention d'urine</text></gloss>
      <gloss lang="en"><text>large tree (species) whose bark treats urine retention</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 129: yɔmɔle, pl. yɔmɔle</text></form></note>
  </entry>
  <entry id="yɔna_6287">
    <lexical-unit><form lang="kqs"><text>yɔna</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔna_6287_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>vite, rapidement</text></gloss>
      <gloss lang="en"><text>quickly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 129: yɔna</text></form></note>
    <note><form lang="fr"><text>Paulme : la tyindu yɔna yɔna « achevez rapidement » ; mambilo kwa yɔnɔ « l'auto va vite » ; yɔna = yuna.</text></form></note>
  </entry>
  <entry id="yɔnde_6288">
    <lexical-unit><form lang="kqs"><text>yɔnde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yɔnda</text></form></field>
    <sense id="yɔnde_6288_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fesse</text></gloss>
      <gloss lang="en"><text>buttock</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 129 (G): yɔnde, pl. yɔnda /G./</text></form></note>
    <note><form lang="fr"><text>Voir aussi tumndo.</text></form></note>
  </entry>
  <entry id="yɔ̀ndìèí_6289">
    <lexical-unit><form lang="kqs"><text>yɔ̀ndìèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="yɔ̀ndìèí_6289_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sperme</text></gloss>
      <gloss lang="en"><text>semen</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 414: yɔ̀ndìèí</text></form></note>
  </entry>
  <entry id="yɔngannden_6290">
    <lexical-unit><form lang="kqs"><text>yɔngannden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yɔnganndo</text></form></variant>
    <sense id="yɔngannden_6290_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>après-midi, fin du jour (paale yɔngannden)</text></gloss>
      <gloss lang="en"><text>afternoon, late in the day (paale yɔngannden)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.12.18</text></form></note>
    <note><form lang="fr"><text>o lɛɛlɛ yàándɔɔ a paale yɔngannden « à la neuvième heure de l'après-midi » (LUK.23.44).</text></form></note>
  </entry>
  <entry id="yɔngoo_6291">
    <lexical-unit><form lang="kqs"><text>yɔngoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yɔngu</text></form></variant>
    <variant><form lang="kqs"><text>yɔngunin</text></form></variant>
    <variant><form lang="kqs"><text>yɔngunnin</text></form></variant>
    <sense id="yɔngoo_6291_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner</text></gloss>
      <gloss lang="en"><text>give</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>give, give back</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 304 occurrences, first GEN.1.15; Paulme 1964, p. 129: yɔŋɔ, yɔŋu; Lexique kissi–français, p. 67: yɔngɔɔ/ yɔngu; Childs 2000, p. 415: yɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 67) écrit yɔngɔɔ/ yɔngu. Paulme 1964, p. 129 : i yɔŋu « je donne » ; pɔno yɔŋu vɛn dɔ walo « le mari donne du riz à sa femme ».</text></form></note>
  </entry>
  <entry id="yɔngun_6292">
    <lexical-unit><form lang="kqs"><text>yɔngun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yɔngɔnndo</text></form></variant>
    <sense id="yɔngun_6292_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être donné</text></gloss>
      <gloss lang="en"><text>be given</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 151 occurrences, first GEN.44; Lexique kissi–français, p. 67: yɔngɔnndo/ yɔngun</text></form></note>
    <note><form lang="fr"><text>Moyen de yɔngoo « donner ». Lexique kissi–français, p. 67 : yɔngɔnndo/ yɔngun « donner, se donner ».</text></form></note>
  </entry>
  <entry id="yɔnguo_6293">
    <lexical-unit><form lang="kqs"><text>yɔnguo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yɔnguo_6293_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>produit</text></gloss>
      <gloss lang="en"><text>product, yield</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yɔnguo</text></form></note>
    <note><form lang="fr"><text>La Bible a yɔnguo une fois (EPH.4.3), sens non confirmé ; cf. yɔngoo « donner ».</text></form></note>
  </entry>
  <entry id="yɔnguɔ pɔmbɔ-pɔmbɔ_6294">
    <lexical-unit><form lang="kqs"><text>yɔnguɔ pɔmbɔ-pɔmbɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɔnguɔ pɔmbɔ-pɔmbɔ_6294_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acompte</text></gloss>
      <gloss lang="en"><text>down payment</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yɔnguɔ pɔnbɔ-pɔnbɔ</text></form></note>
    <note><form lang="fr"><text>Litt. « don petit à petit ». Le Lexique écrit nb.</text></form></note>
  </entry>
