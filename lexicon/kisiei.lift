  <entry id="kɔɔfiaa_1905">
    <lexical-unit><form lang="kqs"><text>kɔɔfiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔɔfiaanin</text></form></variant>
    <sense id="kɔɔfiaa_1905_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>embaumer, préparer (un mort) ; fermer les yeux (d'un mourant)</text></gloss>
      <gloss lang="en"><text>embalm, prepare (a dead body); close the eyes (of the dying)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>kill off (a dying person or animal), mercy-kill; prepare a dead body; also rot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.50.2; Childs 2000, p. 186: kɔ̀ɔ̀fìá</text></form></note>
    <note><form lang="fr"><text>le ndu kɔɔfiaa « pour l'embaumer » (GEN.50.2) ; Yosɛf kɔɔfiaanin nɔm ni mò kinda nɔm hɔltan « Joseph te fermera les yeux » (GEN.46.4).</text></form></note>
  </entry>
  <entry id="kɔɔfɛɛ_1906">
    <lexical-unit><form lang="kqs"><text>kɔɔfɛɛ</text></form></lexical-unit>
