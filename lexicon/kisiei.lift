    <trait name="status" value="attested"/>
    <sense id="faŋa_421_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>chasser, expulser</text></gloss>
      <gloss lang="en"><text>drive out, expel</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 290 occurrences, first GEN.4.14</text></form></note>
