  <entry id="imɔnɔɔ_1350">
    <lexical-unit><form lang="kqs"><text>imɔnɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>imɔnɔ</text></form></variant>
    <variant><form lang="kqs"><text>imɔnɔlan</text></form></variant>
    <variant><form lang="kqs"><text>imɔnɔlen</text></form></variant>
    <sense id="imɔnɔɔ_1350_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pénible, amer, de deuil</text></gloss>
      <gloss lang="en"><text>grievous, bitter, of mourning</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.50.11</text></form></note>
    <note><form lang="fr"><text>Apparenté à mɔnɛi « chagrin ». bulu imɔnɔ « pain d'affliction » (Dt 16,3) ; volɔɔla imɔnɔlan « habits de deuil » (Ps 35,13).</text></form></note>
  </entry>
  <entry id="inɛɛ_1351">
    <lexical-unit><form lang="kqs"><text>inɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>inɛɛle</text></form></variant>
    <sense id="inɛɛ_1351_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>quelque part, ailleurs ; (avec négation) nulle part</text></gloss>
      <gloss lang="en"><text>somewhere, elsewhere; (with negation) anywhere</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>somewhere, anywhere (said by older speakers)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EXO.8.21; Childs 2000, p. 139: ìnéé</text></form></note>
    <note><form lang="fr"><text>Samarinɔɔ pum va kɔlan inɛɛ « un Samaritain en voyage » (LUK.10.33) ; la kɔa inɛɛ le « n'allez pas ailleurs » (EXO.8.21) ; inɛɛle (ZEC.7.14).</text></form></note>
  </entry>
  <entry id="ipala_1352">
