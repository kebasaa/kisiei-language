    <variant><form lang="kqs"><text>loonun</text></form></variant>
    <variant><form lang="kqs"><text>loonunnin</text></form></variant>
    <sense id="loonɔnndo_2468_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se souvenir</text></gloss>
      <gloss lang="en"><text>remember</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.6 Remember"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.9.13; Childs 2000, p. 233: lòònɔ̀ŋndɔ́</text></form></note>
  </entry>
  <entry id="loovo_2469">
    <lexical-unit><form lang="kqs"><text>loovo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="loovo_2469_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>possession, héritage</text></gloss>
      <gloss lang="en"><text>possession, inheritance</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>legacy, inheritance</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.11.15; Childs 2000, p. 233: lòòwó</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : lɛŋnden … yɔngun le len loovo « le pays nous a été donné en possession » (EZK.11.15). Correspondance w ~ v.</text></form></note>
  </entry>
  <entry id="losaa_2470">
    <lexical-unit><form lang="kqs"><text>losaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>losa</text></form></variant>
    <sense id="losaa_2470_s1">
