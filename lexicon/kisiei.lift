    <variant><form lang="kqs"><text>sɛvanin</text></form></variant>
    <variant><form lang="kqs"><text>sɛvan</text></form></variant>
    <sense id="sɛvaa_3212_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écrire</text></gloss>
      <gloss lang="en"><text>write</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 321 occurrences, first EXO.24.7; Keita 1979, p. 113: Sèvaa</text></form></note>
