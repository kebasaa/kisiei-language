      <gloss lang="fr"><text>balançoire ; fronde</text></gloss>
      <gloss lang="en"><text>swing; sling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmáfìkóó</text></form></note>
  </entry>
  <entry id="yàmátàndíó_4601">
    <lexical-unit><form lang="kqs"><text>yàmátàndíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàmátàndíó_4601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau (espèce) qui appelle les autres à manger le riz</text></gloss>
      <gloss lang="en"><text>bird species that calls other birds to the rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmátàndíó</text></form></note>
  </entry>
  <entry id="yambaa_4602">
    <lexical-unit><form lang="kqs"><text>yambaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambaa_4602_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabac</text></gloss>
      <gloss lang="en"><text>tobacco</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yanbaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; homographe de yambaa « être couché » (forme de yambɔɔ).</text></form></note>
  </entry>
  <entry id="yàmbàá_4603">
    <lexical-unit><form lang="kqs"><text>yàmbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàmbàá_4603_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jupe de raphia</text></gloss>
      <gloss lang="en"><text>raffia skirt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmbàá</text></form></note>
  </entry>
  <entry id="yambalen_4604">
    <lexical-unit><form lang="kqs"><text>yambalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yambalen_4604_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manioc (tubercule)</text></gloss>
      <gloss lang="en"><text>cassava (tuber)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yanbalen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; il donne aussi yanbale folalen « le manioc ».</text></form></note>
  </entry>
  <entry id="yambele folalen_4605">
    <lexical-unit><form lang="kqs"><text>yambele folalen</text></form></lexical-unit>
