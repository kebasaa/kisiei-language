    <lexical-unit><form lang="kqs"><text>fàngà-kundaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fàngà-kundaa_413_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foule, multitude</text></gloss>
      <gloss lang="en"><text>crowd, multitude</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>crowd, assembly, group of people</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.17.5; Childs 2000, p. 98: fàŋgàá</text></form></note>
  </entry>
