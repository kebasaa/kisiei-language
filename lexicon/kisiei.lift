  <entry id="kela_2032">
    <lexical-unit><form lang="kqs"><text>kela</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kela_2032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit poisson gris</text></gloss>
      <gloss lang="en"><text>small grey fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 42: kela, pl. kela; Childs 2000, p. 153: kélàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par Paulme 1964, p. 42 : kela « poisson tout petit, plat ; on s'en sert pour les sauces ». Homographe de kela « marcher ».</text></form></note>
  </entry>
  <entry id="kelaa_2033">
    <lexical-unit><form lang="kqs"><text>kelaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kela</text></form></variant>
    <variant><form lang="kqs"><text>kelanin</text></form></variant>
    <sense id="kelaa_2033_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>marcher ; se conduire ; voyager ; voyage</text></gloss>
      <gloss lang="en"><text>walk ; walk; behave, live; travel; journey</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>walk around (e.g. to sell)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 282 occurrences, first GEN.1.20; Keita 1979, p. 110: Kelaa; Paulme 1964, p. 43: kɛra; Lexique kissi–français, p. 22: kelaa; Childs 2000, p. 153: kèlàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 23 : aussi keraa/kera « se promener, voyager ; un voyage ». Paulme 1964, p. 43 : wana kɛra « voyageur » ; i kɛrawo « je voyage », kɛra sana ni « le voyage est fatigant ».</text></form></note>
  </entry>
  <entry id="kèlàá_2034">
    <lexical-unit><form lang="kqs"><text>kèlàá</text></form></lexical-unit>
