  <entry id="limnde_3147">
    <lexical-unit><form lang="kqs"><text>limnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>limndon</text></form></field>
    <sense id="limnde_3147_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-fond d'une rivière, trou d'eau ; étang ; (pl.) profondeurs</text></gloss>
      <gloss lang="en"><text>deep part of a river, water hole, pool; (pl.) depths</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2SA.4.12; Paulme 1964, p. 57: limde, pl. limdo</text></form></note>
    <note><form lang="fr"><text>Paulme écrit md, la Bible mnd. La Bible a limnde « étang » (2SA.4.12) et limndon « les profondeurs » (EXO.15.5).</text></form></note>
  </entry>
  <entry id="limndo_3148">
    <lexical-unit><form lang="kqs"><text>limndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="limndo_3148_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dernier-né, le plus jeune fils</text></gloss>
      <gloss lang="en"><text>youngest son, last-born</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 57: limdo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 57 : tua limdo, pl. tua limda « le plus jeune fils, cadet » (uniquement à l'intérieur du yuŋo).</text></form></note>
  </entry>
  <entry id="límsàá_3149">
    <lexical-unit><form lang="kqs"><text>límsàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="límsàá_3149_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'insecte à carapace noire et dure (ravageur du riz)</text></gloss>
      <gloss lang="en"><text>kind of hard black-shelled insect (rice pest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 230: límsàá</text></form></note>
  </entry>
  <entry id="linda_3150">
    <lexical-unit><form lang="kqs"><text>linda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="linda_3150_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pétrir</text></gloss>
      <gloss lang="en"><text>knead</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.18.6</text></form></note>
  </entry>
  <entry id="lisaa_3151">
    <lexical-unit><form lang="kqs"><text>lisaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lisa</text></form></variant>
    <variant><form lang="kqs"><text>lisan</text></form></variant>
    <variant><form lang="kqs"><text>lisanin</text></form></variant>
    <sense id="lisaa_3151_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier ; rendre hommage, remercier</text></gloss>
      <gloss lang="en"><text>praise, glorify; pay homage, thank</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 55 occurrences, first EXO.15.1; Paulme 1964, p. 57: lisa; Lexique kissi–français, p. 32: lisaa/ lisa; Terminologie (idéologie), n° 313: Lisaa, kuundiaa; Childs 2000, p. 231: lìsàá</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 57 : lisa « louange, chanter la louange » ; yamakale lisa wando « le griot fait la louange ».</text></form></note>
  </entry>
  <entry id="litilio_3152">
    <lexical-unit><form lang="kqs"><text>litilio</text></form></lexical-unit>
