    <variant><form lang="kqs"><text>ciikanndo</text></form></variant>
    <sense id="ciikan_425_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rencontrer, se voir</text></gloss>
      <gloss lang="en"><text>meet, see each other</text></gloss>
