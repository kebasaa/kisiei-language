      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 405: yɛ̀ŋgbɛ̀ŋ-yɛ̀ŋgbɛ̂ŋ</text></form></note>
