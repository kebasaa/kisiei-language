    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàfùéíyó_4339_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à excroissances spongieuses (éponge à récurer)</text></gloss>
      <gloss lang="en"><text>plant with sponge-like growths (used for scrubbing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàfùéíyó</text></form></note>
  </entry>
  <entry id="safuna_4340">
    <lexical-unit><form lang="kqs"><text>safuna</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="safuna_4340_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>savon</text></gloss>
      <gloss lang="en"><text>soap</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: safuna; Sandara Kisia, proverbe 79: Safuna</text></form></note>
    <note><form lang="fr"><text>La Bible dit sɛnndan.</text></form></note>
  </entry>
  <entry id="sáká_4341">
    <lexical-unit><form lang="kqs"><text>sáká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sáká_4341_s1">
      <grammatical-info value="Interjection"/>
