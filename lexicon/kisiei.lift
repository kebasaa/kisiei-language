  <entry id="dáŋgíllóŋ_733">
    <lexical-unit><form lang="kqs"><text>dáŋgíllóŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
