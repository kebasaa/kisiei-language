  <entry id="kalaa_445">
    <lexical-unit><form lang="kqs"><text>kalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kala</text></form></variant>
    <sense id="kalaa_445_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mère</text></gloss>
      <gloss lang="en"><text>mother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 512 occurrences, first GEN.2.15; Keita 1979, p. 134: Kalaa; Childs 2000, p. 144: kàlàá</text></form></note>
    <note><form lang="fr"><text>kobi kalaa « la ville mère, la capitale ».</text></form></note>
  </entry>
  <entry id="kalaa_446">
    <lexical-unit><form lang="kqs"><text>kalaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kalaa_446_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déterrer</text></gloss>
      <gloss lang="en"><text>dig up, unearth</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.6 Dig"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dig or pull out</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Kalaa; Childs 2000, p. 144: kàlàá</text></form></note>
    <note><form lang="fr"><text>Le mot kalaa de la Bible a d'autres sens (« tout, entier », « garder ») ; le sens « déterrer » n'y a pas été trouvé.</text></form></note>
  </entry>
  <entry id="kalangɛnɔɔ_447">
