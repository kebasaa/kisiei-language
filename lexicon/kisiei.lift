      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 29: gyɛmba, yɛmba</text></form></note>
    <note><form lang="fr"><text>Paulme : caisse du tambour funéraire tɔndunduo.</text></form></note>
  </entry>
  <entry id="gulumɛ_1556">
    <lexical-unit><form lang="kqs"><text>gulumɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="gulumɛ_1556_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambourinaire</text></gloss>
      <gloss lang="en"><text>drummer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 29: gulumɛ</text></form></note>
    <note><form lang="fr"><text>Paulme : Ouendé.</text></form></note>
  </entry>
  <entry id="gumbo_1557">
    <lexical-unit><form lang="kqs"><text>gumbo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="gumbo_1557_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste (dont on tire une glu)</text></gloss>
      <gloss lang="en"><text>shrub (yielding a birdlime)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 29: gumbo</text></form></note>
  </entry>
  <entry id="ha_1558">
    <lexical-unit><form lang="kqs"><text>ha</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ha_1558_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ces…-ci (personnes)</text></gloss>
      <gloss lang="en"><text>these (persons)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 358 occurrences, first GEN.7.1; Lexique kissi–français, p. 16: ha; Childs 2000, p. 116: háà</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 16 : ha « ces (pour les choses inanimées) ».</text></form></note>
  </entry>
  <entry id="háá_1559">
    <lexical-unit><form lang="kqs"><text>háá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="háá_1559_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à (ce que)</text></gloss>
      <gloss lang="en"><text>until</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>going on for a long time; until</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1778 occurrences, first GEN.3.17; Lexique kissi–français, p. 16: haa; Childs 2000, p. 116: háá</text></form></note>
  </entry>
  <entry id="haa_1560">
    <lexical-unit><form lang="kqs"><text>haa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>ha</text></form></variant>
    <sense id="haa_1560_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler ses forces ; barrer</text></gloss>
      <gloss lang="en"><text>gather one's strength; bar, block</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 16: haa/ ha</text></form></note>
    <note><form lang="fr"><text>Lexique : haa/ha. Homographe de háá « jusqu'à » ; à confirmer.</text></form></note>
  </entry>
  <entry id="hààlàá_1561">
    <lexical-unit><form lang="kqs"><text>hààlàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hààlàá_1561_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dresser des tuteurs (pour les plantes grimpantes) ; élever une barricade</text></gloss>
      <gloss lang="en"><text>set up stick frames (for climbing plants); put up a barricade</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 116: hààlàá</text></form></note>
  </entry>
  <entry id="haalan_1562">
    <lexical-unit><form lang="kqs"><text>haalan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haalan_1562_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pluie</text></gloss>
      <gloss lang="en"><text>rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 155: haalan; Lexique kissi–français, p. 17: haalan</text></form></note>
    <note><form lang="fr"><text>La Bible emploie piɔɔ pour « pluie » (GEN.7.12). Lexique kissi–français, p. 16-17 : aussi haalaa, halaa « la pluie ».</text></form></note>
  </entry>
  <entry id="háámì_1563">
    <lexical-unit><form lang="kqs"><text>háámì</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="háámì_1563_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>jusqu'à ce que</text></gloss>
      <gloss lang="en"><text>until</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.7.15; Lexique kissi–français, p. 17: haami</text></form></note>
  </entry>
  <entry id="hààŋndó_1564">
    <lexical-unit><form lang="kqs"><text>hààŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hààŋndó_1564_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fourmi noire à piqûre douloureuse (sur les agrumes)</text></gloss>
      <gloss lang="en"><text>black ant with a painful bite (on citrus trees)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hààŋndó</text></form></note>
  </entry>
  <entry id="haiyɛɔ_1565">
    <lexical-unit><form lang="kqs"><text>haiyɛɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haiyɛɔ_1565_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bonne chance</text></gloss>
      <gloss lang="en"><text>good luck</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: haiyɛɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi hariyɔɔ « bonne chance » (p. 17).</text></form></note>
  </entry>
  <entry id="hàkátó_1566">
    <lexical-unit><form lang="kqs"><text>hàkátó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàkátó_1566_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>pardon, excusez-moi</text></gloss>
      <gloss lang="en"><text>excuse me</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàkátó</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="hakio_1567">
    <lexical-unit><form lang="kqs"><text>hakio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hakilan</text></form></field>
    <variant><form lang="kqs"><text>haki</text></form></variant>
    <variant><form lang="kqs"><text>hakila</text></form></variant>
    <sense id="hakio_1567_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>péché, faute</text></gloss>
      <gloss lang="en"><text>sin, wrongdoing</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pardon, forgiveness; sin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 365 occurrences, first GEN.4.7; Lexique kissi–français, p. 17: hakio; Childs 2000, p. 117: hákìó</text></form></note>
  </entry>
  <entry id="hàkɛ́ìyó_1568">
    <lexical-unit><form lang="kqs"><text>hàkɛ́ìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hàkɛ́ìyó_1568_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chance, sort ; malchance</text></gloss>
      <gloss lang="en"><text>luck, fortune; misfortune</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàkɛ́ìyó</text></form></note>
  </entry>
  <entry id="hala_1569">
    <lexical-unit><form lang="kqs"><text>hala</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>halaa</text></form></field>
    <sense id="hala_1569_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dieu, divinité</text></gloss>
      <gloss lang="en"><text>god, deity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6548 occurrences, first GEN.1; Childs 2000, p. 117: hálà</text></form></note>
    <note><form lang="fr"><text>Nom commun : halaa celen « d'autres dieux » (Ex 20,3), hala naa « notre dieu ». Avec une majuscule, Hala est le nom de Dieu. Childs : emprunt à l'arabe (Allah), surtout en kissi de Guinée.</text></form></note>
  </entry>
  <entry id="Hala_1570">
    <lexical-unit><form lang="kqs"><text>Hala</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="Hala_1570_s1">
      <grammatical-info value="Proper Noun"/>
      <gloss lang="fr"><text>Dieu</text></gloss>
      <gloss lang="en"><text>God</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6548 occurrences, first GEN.1; Keita 1979, p. 150: Hala; Lexique kissi–français, p. 17: Hala; Childs 2000, p. 117: hálà</text></form></note>
  </entry>
  <entry id="halaa_1571">
    <lexical-unit><form lang="kqs"><text>halaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halaa_1571_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel</text></gloss>
      <gloss lang="en"><text>sky</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cloud, sky, heavens; also the name of a spirit</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 154: Halaa; Paulme 1964, p. 33: hala; Lexique kissi–français, p. 17: halaa; Childs 2000, p. 117: hálàá</text></form></note>
    <note><form lang="fr"><text>La Bible emploie halataala pour « ciel » (GEN.1.8) ; halaa y est le pluriel homonyme de hala « dieu » (1CH.16.26). Paulme 1964, p. 33 : hala « ciel » (hala tala « le ciel infini » ; hala dɛ ni « le tonnerre » ; hala eli « gros nuages noirs » ; hala sia « la pluie tombe ») ; hala, halamɛlɛka « Dieu du ciel ».</text></form></note>
  </entry>
  <entry id="halacucaa_1572">
    <lexical-unit><form lang="kqs"><text>halacucaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halacucaa_1572_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bruine, pluie fine</text></gloss>
      <gloss lang="en"><text>drizzle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halacucaa</text></form></note>
  </entry>
  <entry id="hàlàkàá_1573">
    <lexical-unit><form lang="kqs"><text>hàlàkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàlàkàá_1573_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>construire, réparer grossièrement, à la va-vite</text></gloss>
      <gloss lang="en"><text>build or fix roughly, carelessly</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5 Working with buildings"/>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: hàlàkàá</text></form></note>
  </entry>
  <entry id="halakio_1574">
    <lexical-unit><form lang="kqs"><text>halakio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>halaki</text></form></variant>
    <sense id="halakio_1574_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>périr ; (nom) destruction</text></gloss>
      <gloss lang="en"><text>perish; (noun) destruction</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halakio/ halaki</text></form></note>
  </entry>
  <entry id="halamusa_1575">
    <lexical-unit><form lang="kqs"><text>halamusa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halamusa_1575_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeudi (jour du marché à Yende)</text></gloss>
      <gloss lang="en"><text>Thursday (market day at Yende)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 33: halamusa</text></form></note>
    <note><form lang="fr"><text>Cf. falɛiyo « jeudi » (Keita 1979).</text></form></note>
  </entry>
  <entry id="halataalaa_1576">
    <lexical-unit><form lang="kqs"><text>halataalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>halataala</text></form></variant>
    <sense id="halataalaa_1576_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ciel ; les cieux ; paradis</text></gloss>
      <gloss lang="en"><text>sky; heaven; paradise</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1 Sky"/>
      <trait name="semantic-domain-ddp4" value="4.9.6 Heaven, hell"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 176 occurrences, first GEN.1; Lexique kissi–français, p. 17: halatala</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : halatala « le paradis ».</text></form></note>
  </entry>
  <entry id="háléé_1577">
    <lexical-unit><form lang="kqs"><text>háléé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háléé_1577_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(fouetter) à fond</text></gloss>
      <gloss lang="en"><text>(whip) thoroughly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 117: háléé</text></form></note>
  </entry>
  <entry id="hali_1578">
    <lexical-unit><form lang="kqs"><text>hali</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hali_1578_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>même ; même si</text></gloss>
      <gloss lang="en"><text>even; even if</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'only, just'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 484 occurrences, first GEN.2.5; Lexique kissi–français, p. 17: hali; Childs 2000, p. 118: hálì</text></form></note>
  </entry>
  <entry id="haliko_1579">
    <lexical-unit><form lang="kqs"><text>haliko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haliko_1579_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>afin que</text></gloss>
      <gloss lang="en"><text>so that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 956 occurrences, first GEN.1.29; Lexique kissi–français, p. 17: halako</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : halako « pour que, afin que ».</text></form></note>
  </entry>
  <entry id="halimaa_1580">
    <lexical-unit><form lang="kqs"><text>halimaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="halimaa_1580_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épidémie, peste (nàà halimaa)</text></gloss>
      <gloss lang="en"><text>epidemic, pestilence (nàà halimaa)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first EXO.9; Terminologie (histoire), n° 230: Halimaa</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 230, 231) : « crise sociale » ; halimaa le kaa « crise mondiale ».</text></form></note>
  </entry>
  <entry id="haliyɛnɛ_1581">
    <lexical-unit><form lang="kqs"><text>haliyɛnɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haliyɛnɛ_1581_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paradis</text></gloss>
      <gloss lang="en"><text>paradise</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.6 Heaven, hell"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heaven</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LUK.23.43; Keita 1979, p. 150: Haliyènè; Lexique kissi–français, p. 17: haliyɛnɛ; Childs 2000, p. 121: hècɛ́nɛ̀</text></form></note>
  </entry>
  <entry id="halumɛtio_1582">
    <lexical-unit><form lang="kqs"><text>halumɛtio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halumɛtio_1582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>allumette</text></gloss>
      <gloss lang="en"><text>match (for fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: halumɛtio</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="halɛiyo_1583">
    <lexical-unit><form lang="kqs"><text>halɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="halɛiyo_1583_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>samedi</text></gloss>
      <gloss lang="en"><text>Saturday</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Halèiyo; Lexique kissi–français, p. 17: halɛiyo; Terminologie (langue), n° 456: (de hali) Halèiyo</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 456) : « samedi », formé sur hali.</text></form></note>
  </entry>
  <entry id="hanaŋa_1584">
    <lexical-unit><form lang="kqs"><text>hanaŋa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hanaŋa_1584_s1">
      <grammatical-info value="Preposition"/>
      <gloss lang="fr"><text>jusqu'à (temps)</text></gloss>
      <gloss lang="en"><text>until (time)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 33: hanaŋa</text></form></note>
    <note><form lang="fr"><text>Paulme : hanaŋa sɔ « jusqu'à demain » ; naŋu a sɔdi « jusqu'à demain ». Cf. háá « jusqu'à » (Bible).</text></form></note>
  </entry>
  <entry id="hande_1585">
    <lexical-unit><form lang="kqs"><text>hande</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hande_1585_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>pour que, afin que</text></gloss>
      <gloss lang="en"><text>so that, in order that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hande</text></form></note>
  </entry>
  <entry id="handullo_1586">
    <lexical-unit><form lang="kqs"><text>handullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="handullo_1586_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouclier</text></gloss>
      <gloss lang="en"><text>shield</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Handullo; Lexique kissi–français, p. 17: handullo; Terminologie (histoire), n° 116: Handullo</text></form></note>
    <note><form lang="fr"><text>La Bible dit kɔ̀ɔ̀ cɔwvo pour « bouclier » (1 S 17,7 ; Ep 6,16). Académie des langues (terminologie, histoire n° 116) : « bouclier ».</text></form></note>
  </entry>
  <entry id="handun_1587">
    <lexical-unit><form lang="kqs"><text>handun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>handɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>handɔn</text></form></variant>
    <sense id="handun_1587_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre sur soi ; (se) poser</text></gloss>
      <gloss lang="en"><text>put on oneself; set oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.9.23</text></form></note>
    <note><form lang="fr"><text>Moyen de handɔɔ « mettre ».</text></form></note>
  </entry>
  <entry id="handɔnndocoo_1588">
    <lexical-unit><form lang="kqs"><text>handɔnndocoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="handɔnndocoo_1588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>annexion</text></gloss>
      <gloss lang="en"><text>annexation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 52: Handönndotyoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Annexer » : biyöö o vööndo bèngu (histoire n° 53).</text></form></note>
  </entry>
  <entry id="handɔɔ_1589">
    <lexical-unit><form lang="kqs"><text>handɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>handu</text></form></variant>
    <variant><form lang="kqs"><text>handunin</text></form></variant>
    <sense id="handɔɔ_1589_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, poser ; établir (sur) ; (handu … lecoo) mettre sur, ajouter, accumuler</text></gloss>
      <gloss lang="en"><text>put, lay; set (over); (handu … lecoo) put on top, add, pile up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 185 occurrences, first GEN.11.4; Paulme 1964, p. 33: handɔ; Lexique kissi–français, p. 17: handɔɔ/ handu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 17 : handɔɔ lecoo « mettre sur, placer sur, ajouter, accumuler » (cf. handu lecoo, 2KI.5.23) ; handun leco, handɔnndo leco « s'accumuler » ; handɔɔ aussi « plus ». Paulme 1964, p. 33 : handɔ « poser sur (une pierre, le feu, l'eau) » (mu handu nɛda ɔ nyin « elle a mis la marmite sur le feu »).</text></form></note>
  </entry>
  <entry id="handɔɔ a súúlan_1590">
    <lexical-unit><form lang="kqs"><text>handɔɔ a súúlan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="handɔɔ a súúlan_1590_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>catégorisation</text></gloss>
      <gloss lang="en"><text>categorization</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 56: Handöö a suulan</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « mettre par sortes » (handɔɔ, súúlan).</text></form></note>
  </entry>
  <entry id="handɔɔ ikɛi_1591">
    <lexical-unit><form lang="kqs"><text>handɔɔ ikɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="handɔɔ ikɛi_1591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>juxtaposer ; juxtaposition</text></gloss>
      <gloss lang="en"><text>juxtapose; juxtaposition</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 221: Handöö ikèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Juxtaposition » : handöö ikèiyo (langue n° 222).</text></form></note>
  </entry>
  <entry id="hangullo_1592">
    <lexical-unit><form lang="kqs"><text>hangullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hangul</text></form></variant>
    <variant><form lang="kqs"><text>hangulu</text></form></variant>
    <sense id="hangullo_1592_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaleur</text></gloss>
      <gloss lang="en"><text>heat</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>heat, steam</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.8.22; Paulme 1964, p. 33: haŋulo; Lexique kissi–français, p. 17: hangullo; Childs 2000, p. 118: hàŋgúlló</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 33 : haŋulo « chaleur » (haŋulo bi ya « la chaleur me mord, j'ai chaud »).</text></form></note>
  </entry>
  <entry id="hangɔɔ_1593">
    <lexical-unit><form lang="kqs"><text>hangɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hangu</text></form></variant>
    <sense id="hangɔɔ_1593_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se chauffer</text></gloss>
      <gloss lang="en"><text>warm oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be or become warm; warm oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first ISA.44.15; Lexique kissi–français, p. 17: hangɔɔ; Childs 2000, p. 118: hàŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="hantenge_1594">
    <lexical-unit><form lang="kqs"><text>hantenge</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hantenge_1594_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>pardon, excusez-moi</text></gloss>
      <gloss lang="en"><text>sorry, excuse me</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hantenge</text></form></note>
  </entry>
  <entry id="hau_1595">
    <lexical-unit><form lang="kqs"><text>hau</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hau_1595_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aujourd'hui, maintenant</text></gloss>
      <gloss lang="en"><text>today, now</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 436 occurrences, first GEN.4.11; Paulme 1964, p. 33: hao, hau; Lexique kissi–français, p. 17: hau; Childs 2000, p. 118: háù</text></form></note>
  </entry>
  <entry id="háú-hàù_1596">
    <lexical-unit><form lang="kqs"><text>háú-hàù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háú-hàù_1596_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>sensation de brûlure, de picotement (plaie, alcool sur une coupure)</text></gloss>
      <gloss lang="en"><text>stinging, burning sensation (sore, alcohol on a cut)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: háú-hàù</text></form></note>
    <note><form lang="fr"><text>Distinct de hau-hau « aujourd'hui même » de la Bible.</text></form></note>
  </entry>
  <entry id="hàùdíí_1597">
    <lexical-unit><form lang="kqs"><text>hàùdíí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàùdíí_1597_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ce matin</text></gloss>
      <gloss lang="en"><text>this morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: hàùdíí</text></form></note>
    <note><form lang="fr"><text>Composé de háù « aujourd'hui » et ɗílɛ́ŋ « matin ».</text></form></note>
  </entry>
  <entry id="hauvo_1598">
    <lexical-unit><form lang="kqs"><text>hauvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hauvo_1598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>temps présent</text></gloss>
      <gloss lang="en"><text>present tense</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 395: Hauvo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="haw_1599">
    <lexical-unit><form lang="kqs"><text>haw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="haw_1599_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aujourd'hui</text></gloss>
      <gloss lang="en"><text>today</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>today; now, right away; again</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.33.15; Keita 1979, p. 152: Haw; Childs 2000, p. 118: háù</text></form></note>
  </entry>
  <entry id="haw ba_1600">
    <lexical-unit><form lang="kqs"><text>haw ba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="haw ba_1600_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accabler ; être incapable (à cause des circonstances)</text></gloss>
      <gloss lang="en"><text>overwhelm; be unable (because of circumstances)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: haw ba</text></form></note>
    <note><form lang="fr"><text>De hawvo « bloquer ».</text></form></note>
  </entry>
  <entry id="háwèìyó_1601">
    <lexical-unit><form lang="kqs"><text>háwèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="háwèìyó_1601_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>heure</text></gloss>
      <gloss lang="en"><text>hour</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háwèìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="háwèlè-hàwèlè_1602">
    <lexical-unit><form lang="kqs"><text>háwèlè-hàwèlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="háwèlè-hàwèlè_1602_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>rugueux, bosselé ; brûlant</text></gloss>
      <gloss lang="en"><text>rough, bumpy; burning hot</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háwèlè-hàwèlè</text></form></note>
  </entry>
  <entry id="hawnɔnndo_1603">
    <lexical-unit><form lang="kqs"><text>hawnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hawnun</text></form></variant>
    <sense id="hawnɔnndo_1603_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se bloquer ; se porter garant</text></gloss>
      <gloss lang="en"><text>get stuck; stand surety</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.6; Keita 1979, p. 114: Hawnönndo; Lexique kissi–français, p. 17: hawnɔnndo/ hawnun, hewnun; Childs 2000, p. 119: hàùnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hawvo ; hawnun « se porter caution » (PRO 6,1).</text></form></note>
  </entry>
  <entry id="hawvo_1604">
    <lexical-unit><form lang="kqs"><text>hawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>haw</text></form></variant>
    <variant><form lang="kqs"><text>hawnin</text></form></variant>
    <sense id="hawvo_1604_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bloquer, coincer, presser</text></gloss>
      <gloss lang="en"><text>block, trap, press</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be stuck or trapped</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first EXO.27.3; Keita 1979, p. 114: Hawvo; Lexique kissi–français, p. 17: hawvo/ haw, hew; Terminologie (histoire), n° 126: Hawvo, kindaa; Childs 2000, p. 119: hàùwó</text></form></note>
    <note><form lang="fr"><text>haw : presser (les raisins, GEN 40,11) ; hawnin : être pris (au piège, ISA 24,18). Lexique kissi–français, p. 17 : hawvo/haw, hew « bloquer » (hew au négatif). Académie des langues (terminologie, histoire n° 126) : « blocus » (aussi kindaa).</text></form></note>
  </entry>
  <entry id="hàyàá_1605">
    <lexical-unit><form lang="kqs"><text>hàyàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hàyàá_1605_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>repasser (le linge)</text></gloss>
      <gloss lang="en"><text>iron (clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: hàyàá</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="háyèìyé_1606">
    <lexical-unit><form lang="kqs"><text>háyèìyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="háyèìyé_1606_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer à repasser</text></gloss>
      <gloss lang="en"><text>(clothes) iron</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="5.6.4 Wash clothes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: háyèìyé</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais selon Childs.</text></form></note>
  </entry>
  <entry id="hâŋndí_1607">
    <lexical-unit><form lang="kqs"><text>hâŋndí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hâŋndí_1607_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en arrachant, d'un geste vif (saisir)</text></gloss>
      <gloss lang="en"><text>snatching (take quickly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 118: hâŋndí</text></form></note>
  </entry>
  <entry id="he_1608">
    <lexical-unit><form lang="kqs"><text>he</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="he_1608_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe i)</text></gloss>
      <gloss lang="en"><text>this (i class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 213 occurrences, first GEN.9.17; Lexique kissi–français, p. 17: he; Childs 2000, p. 120: héì</text></form></note>
  </entry>
  <entry id="hébè_1609">
    <lexical-unit><form lang="kqs"><text>hébè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hébè_1609_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en filant à toute allure (passer)</text></gloss>
      <gloss lang="en"><text>zooming by (pass)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: hébè</text></form></note>
  </entry>
  <entry id="heelanndo_1610">
    <lexical-unit><form lang="kqs"><text>heelanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelanndo_1610_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orgueil, fierté ; ce dont on se glorifie</text></gloss>
      <gloss lang="en"><text>pride, haughtiness; one's glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PRO.17.6</text></form></note>
    <note><form lang="fr"><text>Dérivé de heeloo « lever ». tofa heelanndo « regard hautain » (Pr 21,4).</text></form></note>
  </entry>
  <entry id="heeloo_1611">
    <lexical-unit><form lang="kqs"><text>heeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <variant><form lang="kqs"><text>heelunin</text></form></variant>
    <variant><form lang="kqs"><text>heelaa</text></form></variant>
    <sense id="heeloo_1611_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever</text></gloss>
      <gloss lang="en"><text>lift up, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>raise; praise</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first 2SA.22.42; Childs 2000, p. 120: hèèlòó</text></form></note>
  </entry>
  <entry id="heelu tɛɛsiaa kaa_1612">
    <lexical-unit><form lang="kqs"><text>heelu tɛɛsiaa kaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="heelu tɛɛsiaa kaa_1612_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>superlatif</text></gloss>
      <gloss lang="en"><text>superlative</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 386: Heelu tèèsiaa kaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="heeluo_1613">
    <lexical-unit><form lang="kqs"><text>heeluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>heelu</text></form></variant>
    <sense id="heeluo_1613_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lever, élever, faire monter</text></gloss>
      <gloss lang="en"><text>lift, raise</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put up, raise, lift, erect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Heeluo; Lexique kissi–français, p. 17: heeluo/ heelu; Childs 2000, p. 119: hèèlòó</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : heelu (lever les yeux, la main), heelunin, heelun (GEN 5,24). Lexique kissi–français, p. 17 : aussi heluo/helu « soulever, faire monter, se lever ».</text></form></note>
  </entry>
  <entry id="heelupifalnɔɔ_1614">
    <lexical-unit><form lang="kqs"><text>heelupifalnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="heelupifalnɔɔ_1614_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>metteur en scène</text></gloss>
      <gloss lang="en"><text>stage director</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 242: Heelupifalnöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Mise en scène » : heeloo o i fal (arts n° 244).</text></form></note>
  </entry>
  <entry id="heelɔnndo_1615">
    <lexical-unit><form lang="kqs"><text>heelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="heelɔnndo_1615_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'élever, s'enorgueillir ; (sondoo heelɔnndo) parler avec arrogance</text></gloss>
      <gloss lang="en"><text>exalt oneself, be proud; (sondoo heelɔnndo) speak arrogantly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.1.1 Personality"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first PSA.73.9; Lexique kissi–français, p. 17: helɔnndɔ/ helun</text></form></note>
    <note><form lang="fr"><text>Moyen de heeloo « lever ». Lexique kissi–français, p. 17 : helɔnndɔ/helun « fier ».</text></form></note>
  </entry>
  <entry id="heende_1616">
    <lexical-unit><form lang="kqs"><text>heende</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="heende_1616_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbuste (Acacia ataxacantha)</text></gloss>
      <gloss lang="en"><text>shrub (Acacia ataxacantha)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 34: heendé</text></form></note>
  </entry>
  <entry id="héèyó_1617">
    <lexical-unit><form lang="kqs"><text>héèyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="héèyó_1617_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, parc à bêtes</text></gloss>
      <gloss lang="en"><text>animal pen, enclosure</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: héèyó</text></form></note>
  </entry>
  <entry id="hèèŋúúwó_1618">
    <lexical-unit><form lang="kqs"><text>hèèŋúúwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hèèŋúúwó_1618_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>carapace, coquille (d'escargot)</text></gloss>
      <gloss lang="en"><text>carapace, shell (e.g. of a snail)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 119: hèèŋúúwó</text></form></note>
  </entry>
  <entry id="helnɔnndo_1619">
    <lexical-unit><form lang="kqs"><text>helnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>helnɔn</text></form></variant>
    <sense id="helnɔnndo_1619_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter, s'élever (au ciel)</text></gloss>
      <gloss lang="en"><text>go up, ascend, rise (into the sky)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>climb, ascend</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JDG.13.20; Childs 2000, p. 120: hèlnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de helɔɔ « monter ». mɛlɛkanɔ Hala-o helnɔnndo coocoo o yelenyelen kon nin « l'ange de Dieu montait dans la flamme » (JDG.13.20) ; sunsun i co helnɔn « maintenant je m'élève » (ISA.33.10).</text></form></note>
  </entry>
  <entry id="hèlùlló_1620">
    <lexical-unit><form lang="kqs"><text>hèlùlló</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hèlùlló_1620_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gagner, prendre (qqch) à qqn (dans une dispute)</text></gloss>
      <gloss lang="en"><text>win (something) from someone (in a contest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: hèlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hìɔ̀lɔ̀ɔ́ (hiɔlɔɔ dans le lexique).</text></form></note>
  </entry>
  <entry id="helɔɔ_1621">
    <lexical-unit><form lang="kqs"><text>helɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hel</text></form></variant>
    <variant><form lang="kqs"><text>helnin</text></form></variant>
    <sense id="helɔɔ_1621_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>monter ; hauteur</text></gloss>
      <gloss lang="en"><text>go up, climb; height</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>climb, go up, rise; also mount, breed (animals)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.6.16; Paulme 1964, p. 34: hil, hillɔ; Lexique kissi–français, p. 17: helɔɔ/ hel; Childs 2000, p. 120: hèlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 34 : hil, hillɔ « ascension, monter » (ɔ hil tyɔ « il est monté en haut ») ; p. 33 : ɔ hɛlu suɔtiyo « il monte à cheval ».</text></form></note>
  </entry>
  <entry id="hemndo_1622">
    <lexical-unit><form lang="kqs"><text>hemndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hemndan</text></form></field>
    <sense id="hemndo_1622_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gourde, outre</text></gloss>
      <gloss lang="en"><text>gourd, skin bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gourd for keeping oil or wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.6.19; Keita 1979, p. 139: Hemndo; Lexique kissi–français, p. 17: hemndo; Childs 2000, p. 120: hěmndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mɔiyan hemndo « une outre de vin ».</text></form></note>
  </entry>
  <entry id="hendullo_1623">
    <lexical-unit><form lang="kqs"><text>hendullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hendul</text></form></variant>
    <variant><form lang="kqs"><text>hendulun</text></form></variant>
    <sense id="hendullo_1623_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>donner (un ordre) à ; tendre (un piège) à</text></gloss>
      <gloss lang="en"><text>give (an order) to; set (a snare) for</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put or place something for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first 1SA.28.9; Childs 2000, p. 120: hèndùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de handɔɔ « mettre ». hendul … tɔŋndo « ordonner » ; yaŋɔɔlen hendullo « tendre un piège ».</text></form></note>
  </entry>
  <entry id="hengen_1624">
    <lexical-unit><form lang="kqs"><text>hengen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hengen_1624_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup</text></gloss>
      <gloss lang="en"><text>a lot, much</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 17: hengen</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi hem « beaucoup » (p. 17), homographe d'un mot de la Bible de sens différent.</text></form></note>
  </entry>
  <entry id="héú_1625">
    <lexical-unit><form lang="kqs"><text>héú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="héú_1625_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très gros, énorme</text></gloss>
      <gloss lang="en"><text>very big, enormous</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: héú</text></form></note>
  </entry>
  <entry id="héŋbéndéŋ_1626">
    <lexical-unit><form lang="kqs"><text>héŋbéndéŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="héŋbéndéŋ_1626_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en tombant en morceaux, en se démantelant</text></gloss>
      <gloss lang="en"><text>falling apart, collapsing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.9 Break, wear out"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 122: héŋbéndéŋ</text></form></note>
  </entry>
  <entry id="héŋgóó_1627">
    <lexical-unit><form lang="kqs"><text>héŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="héŋgóó_1627_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coiffure féminine haute (ancienne)</text></gloss>
      <gloss lang="en"><text>(old-time) high-piled female hairstyle</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 120: héŋgóó</text></form></note>
  </entry>
  <entry id="hèŋgúúwé_1628">
    <lexical-unit><form lang="kqs"><text>hèŋgúúwé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="hèŋgúúwé_1628_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à graines blanches ou jaunes comestibles (cuisine)</text></gloss>
      <gloss lang="en"><text>plant with edible white or yellow seeds (used in cooking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 121: hèŋgúúwé</text></form></note>
  </entry>
  <entry id="hìà-hìà_1629">
    <lexical-unit><form lang="kqs"><text>hìà-hìà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìà-hìà_1629_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>rire (ha ha)</text></gloss>
      <gloss lang="en"><text>laughing (ha-ha)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 123: hìà-hìà</text></form></note>
  </entry>
  <entry id="hìàánànàá_1630">
    <lexical-unit><form lang="kqs"><text>hìàánànàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hìàánànàá_1630_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>démarche chancelante, titubement</text></gloss>
      <gloss lang="en"><text>unsteadiness, reeling</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 123: hìàánànàá</text></form></note>
  </entry>
  <entry id="hialu_1631">
    <lexical-unit><form lang="kqs"><text>hialu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hialun</text></form></variant>
    <variant><form lang="kqs"><text>hialunin</text></form></variant>
    <sense id="hialu_1631_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dérober, enlever par ruse ; s'échapper, disparaître</text></gloss>
      <gloss lang="en"><text>take by stealth; slip away, disappear</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.27.35</text></form></note>
  </entry>
  <entry id="hianndo_1632">
    <lexical-unit><form lang="kqs"><text>hianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hian</text></form></variant>
    <sense id="hianndo_1632_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>montrer sa préférence</text></gloss>
      <gloss lang="en"><text>show preference</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hianndo/ hian</text></form></note>
    <note><form lang="fr"><text>Le Lexique a aussi le redoublé hiahianndo/hiahian, même sens.</text></form></note>
  </entry>
  <entry id="hiawnanndo_1633">
    <lexical-unit><form lang="kqs"><text>hiawnanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hiawnannda</text></form></field>
    <variant><form lang="kqs"><text>hiavannda</text></form></variant>
    <sense id="hiawnanndo_1633_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passant, voyageur ; étranger de passage</text></gloss>
      <gloss lang="en"><text>passer-by, traveller; sojourner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.39.13; Lexique kissi–français, p. 60: vana havanndo</text></form></note>
    <note><form lang="fr"><text>Dérivé de hiovɔɔ « passer » : vanaa hiawnannda « les passants, les étrangers ». Lexique kissi–français, p. 60 : vana havanndo « un passant ».</text></form></note>
  </entry>
  <entry id="híàŋ-híàŋ_1634">
    <lexical-unit><form lang="kqs"><text>híàŋ-híàŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="híàŋ-híàŋ_1634_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mouvement mou et désarticulé (ivrogne qui titube)</text></gloss>
      <gloss lang="en"><text>floppy, loose-jointed movement (a reeling drunk)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 124: híàŋ-híàŋ</text></form></note>
  </entry>
  <entry id="hiilaa_1635">
    <lexical-unit><form lang="kqs"><text>hiilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiila</text></form></variant>
    <variant><form lang="kqs"><text>hiiliaa</text></form></variant>
    <sense id="hiilaa_1635_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lamenter, pousser des cris ; rugir</text></gloss>
      <gloss lang="en"><text>wail, lament; roar</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hiccup; (plural hììlíá) sob or weep quietly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.21.16; Childs 2000, p. 124: hììlàá</text></form></note>
    <note><form lang="fr"><text>hiiliaa hiko-hiko a caŋndo « sangloter en pleurant » (Rt 1,9).</text></form></note>
  </entry>
  <entry id="hiiloo_1636">
    <lexical-unit><form lang="kqs"><text>hiiloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluu</text></form></variant>
    <variant><form lang="kqs"><text>hiiluunin</text></form></variant>
    <sense id="hiiloo_1636_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>secouer, agiter, ébranler</text></gloss>
      <gloss lang="en"><text>shake, toss, move</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake (transitive)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 2KI.19.21; Childs 2000, p. 124: hììlùùwó</text></form></note>
    <note><form lang="fr"><text>bolle hiiloo « hocher la tête » ; hiiluu (pluriel) « remuer, ébranler » : vana-vana hiiluu suei le (Gn 41,44).</text></form></note>
  </entry>
  <entry id="hiilɔnndo_1637">
    <lexical-unit><form lang="kqs"><text>hiilɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiilun</text></form></variant>
    <variant><form lang="kqs"><text>hiilunnin</text></form></variant>
    <sense id="hiilɔnndo_1637_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trembler, être ébranlé ; être troublé</text></gloss>
      <gloss lang="en"><text>tremble, be shaken; be troubled</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first PSA.46.7; Childs 2000, p. 124: hììlɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiiloo. kɔlta hiilun niaa nin le « ne soyez pas troublés » (Gn 45,5).</text></form></note>
  </entry>
  <entry id="hiilɛi_1638">
    <lexical-unit><form lang="kqs"><text>hiilɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hiilɛi_1638_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fureur, colère violente</text></gloss>
      <gloss lang="en"><text>fury, rage</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first 1SA.2.10</text></form></note>
  </entry>
  <entry id="hììndìndòó_1639">
    <lexical-unit><form lang="kqs"><text>hììndìndòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hììndìndòó_1639_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enfler, gonfler</text></gloss>
      <gloss lang="en"><text>swell up</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 124: hììndìndòó</text></form></note>
  </entry>
  <entry id="hiiyo_1640">
    <lexical-unit><form lang="kqs"><text>hiiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hiiyo_1640_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écume</text></gloss>
      <gloss lang="en"><text>foam</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.49.4; Childs 2000, p. 125: hìíyó</text></form></note>
  </entry>
  <entry id="hììyó_1641">
    <lexical-unit><form lang="kqs"><text>hììyó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hììyó_1641_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire place à qqn, laisser passer</text></gloss>
      <gloss lang="en"><text>make room for someone, let pass</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hììyó</text></form></note>
  </entry>
  <entry id="hiko-hiko_1642">
    <lexical-unit><form lang="kqs"><text>hiko-hiko</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiko-hiko_1642_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(pleurer) en sanglotant</text></gloss>
      <gloss lang="en"><text>(weep) sobbing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.42.24</text></form></note>
  </entry>
  <entry id="hílì-hìlì_1643">
    <lexical-unit><form lang="kqs"><text>hílì-hìlì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hílì-hìlì_1643_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>grumeleux, épais</text></gloss>
      <gloss lang="en"><text>lumpy, thick</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hílì-hìlì</text></form></note>
    <note><form lang="fr"><text>La Bible a hili-hili (PSA.55.22) dans un sens apparemment différent (« doux, onctueux »).</text></form></note>
  </entry>
  <entry id="hilihiliei_1644">
    <lexical-unit><form lang="kqs"><text>hilihiliei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="hilihiliei_1644_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hoquet</text></gloss>
      <gloss lang="en"><text>hiccup</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>to hiccup; to sob</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Hilihiliei; Lexique kissi–français, p. 18: hilihiliei; Childs 2000, p. 124: hììlàá</text></form></note>
  </entry>
  <entry id="hìlló_1645">
    <lexical-unit><form lang="kqs"><text>hìlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hìlló_1645_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière (en champignon)</text></gloss>
      <gloss lang="en"><text>(mushroom-shaped) termite mound</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 125: hìlló</text></form></note>
  </entry>
  <entry id="hiluan_1646">
    <lexical-unit><form lang="kqs"><text>hiluan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiruan</text></form></variant>
    <sense id="hiluan_1646_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>envie, convoitise (de nourriture, de viande), appétit</text></gloss>
      <gloss lang="en"><text>craving (for food, meat), appetite</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greed, excessive appetite (esp. for meat and fish)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.12.20; Lexique kissi–français, p. 18: hiruan; Childs 2000, p. 125: hìlùáŋ</text></form></note>
    <note><form lang="fr"><text>te hiluan ma bii pɛ niaa le vision dioo « si tu as envie de manger de la viande » (DEU.12.20) ; ma soli nda hiluan « assouvir l'appétit (des lionceaux) » (JOB.38.39). Lexique kissi–français, p. 18 : hiruan « le désir de la viande ».</text></form></note>
  </entry>
  <entry id="hilul_1647">
    <lexical-unit><form lang="kqs"><text>hilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hirul</text></form></variant>
    <sense id="hilul_1647_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>haleter, être hors d'haleine ; être bouleversé, trembler</text></gloss>
      <gloss lang="en"><text>pant, be out of breath; be troubled, tremble</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.10.5; Lexique kissi–français, p. 18: hirullo/ hirul</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hirullo/hirul « trembler avec les armes ; haleter, essoufflé ». La forme longue hilullo n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="hiluo_1648">
    <lexical-unit><form lang="kqs"><text>hiluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hilu</text></form></variant>
    <variant><form lang="kqs"><text>hiruo</text></form></variant>
    <variant><form lang="kqs"><text>hiru</text></form></variant>
    <sense id="hiluo_1648_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>secouer, agiter</text></gloss>
      <gloss lang="en"><text>shake, wave</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hiruo/ hiru</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit hiruo/hiru.</text></form></note>
  </entry>
  <entry id="hindo_1649">
    <lexical-unit><form lang="kqs"><text>hindo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hindo_1649_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fièvre</text></gloss>
      <gloss lang="en"><text>fever</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 34: hindo</text></form></note>
    <note><form lang="fr"><text>Paulme : hindo pɔl « la fièvre est tombée » (litt. « a crevé ») ; ɔ nɔ hindo « il a de la fièvre ».</text></form></note>
  </entry>
  <entry id="hindɔɔ_1650">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hindu</text></form></variant>
    <variant><form lang="kqs"><text>hindunin</text></form></variant>
    <sense id="hindɔɔ_1650_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, grandir ; enfler, grossir</text></gloss>
      <gloss lang="en"><text>grow, grow up; swell, grow fat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grow, mature; also swell, bloat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Paulme 1964, p. 34: hindu ; ɔ hindu tou; Lexique kissi–français, p. 18: hindɔɔ/ hindu; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le nom verbal hindɔɔ « croissance » a sa propre entrée. Paulme 1964, p. 34 : ɔ hindu tou « il a trop grandi » (d'un bébé).</text></form></note>
  </entry>
  <entry id="hindɔɔ_1651">
    <lexical-unit><form lang="kqs"><text>hindɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="hindɔɔ_1651_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>furoncle ; croissance, fait de pousser</text></gloss>
      <gloss lang="en"><text>boil; growth, growing</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boil, swelling, lump, sore; growing up, coming to maturity</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.10.5; Keita 1979, p. 161: Hindöö; Lexique kissi–français, p. 18: hinndɔɔ; Childs 2000, p. 126: hìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita : « le furoncle », confirmé par Childs ; dans la Bible, hindɔɔ « pousser, croissance » (Nb 6,5 ; Ex 10,5). Lexique kissi–français, p. 18 : hinndɔɔ « le furoncle, l'éruption, l'enflure ».</text></form></note>
  </entry>
  <entry id="hini_1652">
    <lexical-unit><form lang="kqs"><text>hini</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hini_1652_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être couché, se coucher</text></gloss>
      <gloss lang="en"><text>lie, lie down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lie down, rest, sleep</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 124 occurrences, first GEN.9.16; Paulme 1964, p. 34: hini; Lexique kissi–français, p. 18: hinie/ hini; Childs 2000, p. 126: hìníláŋ</text></form></note>
  </entry>
  <entry id="hinia_1653">
    <lexical-unit><form lang="kqs"><text>hinia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hinilan</text></form></field>
    <sense id="hinia_1653_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lit, couche</text></gloss>
      <gloss lang="en"><text>bed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.24.31</text></form></note>
    <note><form lang="fr"><text>Lié à hini « être couché ».</text></form></note>
  </entry>
  <entry id="hinul_1654">
    <lexical-unit><form lang="kqs"><text>hinul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hinul_1654_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attaquer, faire la guerre à (… a cɔwvo)</text></gloss>
      <gloss lang="en"><text>attack, wage war on (… a cɔwvo)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.31.52</text></form></note>
  </entry>
  <entry id="hinullo_1655">
    <lexical-unit><form lang="kqs"><text>hinullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hinul</text></form></variant>
    <variant><form lang="kqs"><text>hinulnin</text></form></variant>
    <sense id="hinullo_1655_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>venir contre, s'avancer vers ; menacer</text></gloss>
      <gloss lang="en"><text>come against, advance on; threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.14.10; Keita 1979, p. 110: Hinullo; Lexique kissi–français, p. 18: hinullo/ hinul</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de hunɔɔ (radical négatif hin). Dans la Bible : « marcher contre » (EXO 14,10), « tourner sa face contre » (LEV 20,6).</text></form></note>
  </entry>
  <entry id="hio_1656">
    <lexical-unit><form lang="kqs"><text>hio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hio_1656_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>buffle</text></gloss>
      <gloss lang="en"><text>buffalo, bush cow</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 34: hio, pl. hia; Childs 2000, p. 125: hìíyó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par Paulme 1964, p. 34 (hio, pl. hia « buffle »).</text></form></note>
  </entry>
  <entry id="hiovɔɔ_1657">
    <lexical-unit><form lang="kqs"><text>hiovɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiow</text></form></variant>
    <variant><form lang="kqs"><text>hiaw</text></form></variant>
    <variant><form lang="kqs"><text>hiw</text></form></variant>
    <variant><form lang="kqs"><text>hiawnin</text></form></variant>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <variant><form lang="kqs"><text>hiownun</text></form></variant>
    <sense id="hiovɔɔ_1657_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, dépasser ; dépasser, surpasser ; dominer</text></gloss>
      <gloss lang="en"><text>pass, surpass ; pass; exceed, surpass; dominate</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go by, pass</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 374 occurrences, first GEN.4.3; Keita 1979, p. 115: Hiowvöö; Lexique kissi–français, p. 18: hiovɔɔ/ hiow, hiw, hiaw; Terminologie (arts), n° 258: Hiovöö; Childs 2000, p. 127: hìòùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit hiowvöö ; la Bible écrit hiovɔɔ. hiw, hiwnin : radical négatif (GEN 6,3 ; MAT 24,34). hiow … vaa « plus que » (comparatif). Lexique kissi–français, p. 18-19 : aussi hiɔw « plus » ; hovɔɔ « passer, dépasser ». Académie des langues (terminologie, langue n° 58 ; arts n° 257 et 258) : hiovöö « chapitre, scène, séquence ». Aussi Terminologie, p. 260 : « Hiovöö ». Académie des langues (terminologie, histoire n° 260, 261, 296) : « dominer, domination » ; hiovɔɔ laci « évolution ». Académie des langues (terminologie, histoire n° 502) : hiovɔɔ laci « progrès ». Académie des langues (terminologie, idéologie n° 513, 523) : « prééminence » (aussi kuumbɔnndo) ; hiowɔɔ lacioo « progrès ». Académie des langues (terminologie, idéologie n° 603) : « suprématie » (aussi kuumbɔnndo kpu).</text></form></note>
  </entry>
  <entry id="hiovɔɔ laci_1658">
    <lexical-unit><form lang="kqs"><text>hiovɔɔ laci</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hiovɔɔ laci_1658_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avance</text></gloss>
      <gloss lang="en"><text>advance</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 95: Hiovöö latyi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="hiownɔnndo_1659">
    <lexical-unit><form lang="kqs"><text>hiownɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiownɔn</text></form></variant>
    <sense id="hiownɔnndo_1659_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer, s'écouler (temps) ; passer (en chemin)</text></gloss>
      <gloss lang="en"><text>pass, go by (time); pass by</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pass (middle)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JOB.11.10; Childs 2000, p. 127: hìòùnɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiovɔɔ « passer ». Palɛi nii co hiownɔnndo maa vundule icɔl « mes jours passent comme l'ombre du soir » (PSA.102.12) ; o hiownɔn nin « en passant » (1CO.16.7).</text></form></note>
  </entry>
  <entry id="hisɔp_1660">
    <lexical-unit><form lang="kqs"><text>hisɔp</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hisɔp_1660_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hysope</text></gloss>
      <gloss lang="en"><text>hyssop</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first EXO.12.22</text></form></note>
  </entry>
  <entry id="hiuo_1661">
    <lexical-unit><form lang="kqs"><text>hiuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hiu</text></form></variant>
    <sense id="hiuo_1661_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer ; interpréter</text></gloss>
      <gloss lang="en"><text>pass; interpret</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 18: hiuo/ hiu</text></form></note>
    <note><form lang="fr"><text>Sans doute apparenté à hiovɔɔ « passer, dépasser ».</text></form></note>
  </entry>
  <entry id="hivi_1662">
    <lexical-unit><form lang="kqs"><text>hivi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <sense id="hivi_1662_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer, livrer, remettre</text></gloss>
      <gloss lang="en"><text>hand over, deliver to</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lift over; circumcise; translate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.16.3; Childs 2000, p. 125: hììwìó</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ « passer ».</text></form></note>
  </entry>
  <entry id="hivihivio_1663">
    <lexical-unit><form lang="kqs"><text>hivihivio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hivihivio_1663_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer plusieurs fois</text></gloss>
      <gloss lang="en"><text>make pass repeatedly</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Hivihivio; Lexique kissi–français, p. 18: hivihivio/ hivihivi</text></form></note>
    <note><form lang="fr"><text>Redoublement de hivio.</text></form></note>
  </entry>
  <entry id="hivilacinɔɔ_1664">
    <lexical-unit><form lang="kqs"><text>hivilacinɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hivilacinɔɔ_1664_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>progressiste</text></gloss>
      <gloss lang="en"><text>progressive (person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 525: Hivilatyinöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. hiovɔɔ laci « progrès ».</text></form></note>
  </entry>
  <entry id="hivio_1665">
    <lexical-unit><form lang="kqs"><text>hivio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hivi</text></form></variant>
    <variant><form lang="kqs"><text>hivia</text></form></variant>
    <variant><form lang="kqs"><text>hivin</text></form></variant>
    <sense id="hivio_1665_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire passer</text></gloss>
      <gloss lang="en"><text>make pass, send ahead</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first JOB.18.19; Keita 1979, p. 110: Hivio; Lexique kissi–français, p. 18: hivio/ hivi; Terminologie (langue), n° 403: Hivioo</text></form></note>
    <note><form lang="fr"><text>Causatif de hiovɔɔ ; vana hivia isɔɔ « interprète » (GEN 42,23). Académie des langues (terminologie, langue n° 403 et 422) : hivioo « thème (de version), version » (traduction).</text></form></note>
  </entry>
  <entry id="hiw_1666">
    <lexical-unit><form lang="kqs"><text>hiw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiwnin</text></form></variant>
    <sense id="hiw_1666_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépasser (une limite) ; surpasser, être plus grand que ; être de trop</text></gloss>
      <gloss lang="en"><text>exceed, go beyond; surpass, be bigger than; be too much</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 105 occurrences, first GEN.6.3; Paulme 1964, p. 33: hɛu</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 33 : hɛu « dépasser » (ɔ hɛu Musa « il est plus grand que Musa » ; lamdo hɛlle e hɛu « il y a trop de sel dans la sauce » ; sɛmburã ta hɛu pɔmdo « la honte vaut mieux que la mort »).</text></form></note>
  </entry>
  <entry id="hiw ba_1667">
    <lexical-unit><form lang="kqs"><text>hiw ba</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiwba</text></form></variant>
    <sense id="hiw ba_1667_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dépasser la mesure, abuser ; accabler ; être pressé</text></gloss>
      <gloss lang="en"><text>go too far, overdo, abuse; overwhelm; be in a hurry</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 19: hiw ba</text></form></note>
    <note><form lang="fr"><text>De hiovɔɔ « dépasser ». Lexique p. 17-19 : hiw ba, hiwvo ba « abuser » ; hew ba, heaw ba « préférer, faire plus que ; être pressé, se dépêcher, dépasser » ; hiu ba « être pressé, dépasser une limite ».</text></form></note>
  </entry>
  <entry id="hiyahiyanndo_1668">
    <lexical-unit><form lang="kqs"><text>hiyahiyanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiyahiyanndo_1668_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>l'un après l'autre, en alternance ; hiérarchie</text></gloss>
      <gloss lang="en"><text>one after another, alternately; hierarchy</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.28.34; Terminologie (idéologie), n° 342: Hiyahiyanndo</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, idéologie n° 342, 343) : « hiérarchie » ; … vahiyanndo « hiérarchiser ».</text></form></note>
  </entry>
  <entry id="hiyanndo_1669">
    <lexical-unit><form lang="kqs"><text>hiyanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiyan</text></form></variant>
    <sense id="hiyanndo_1669_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire une différence, distinguer ; faire acception de personnes</text></gloss>
      <gloss lang="en"><text>make a distinction; show partiality</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.11.47; Terminologie (idéologie), n° 365: Hiyanndo, siiman lepènndo</text></form></note>
    <note><form lang="fr"><text>hiyan kɛ́-kɛ̀ co … tɛɛn te « il n'y a aucune différence entre … » (Jos 22,28). Académie des langues (terminologie, idéologie n° 365) : « inégalité » (aussi siiman lepɛnndo).</text></form></note>
  </entry>
  <entry id="hiyinɔɔ_1670">
    <lexical-unit><form lang="kqs"><text>hiyinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyinɔɔ_1670_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerin</text></gloss>
      <gloss lang="en"><text>pilgrim</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyinöö; Lexique kissi–français, p. 19: hiyinɔɔ</text></form></note>
  </entry>
  <entry id="hiyioo_1671">
    <lexical-unit><form lang="kqs"><text>hiyioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hiyioo_1671_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pèlerinage</text></gloss>
      <gloss lang="en"><text>pilgrimage</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Hiyioo; Lexique kissi–français, p. 19: hiyioo</text></form></note>
  </entry>
  <entry id="hiŋndo_1672">
    <lexical-unit><form lang="kqs"><text>hiŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋ</text></form></variant>
    <variant><form lang="kqs"><text>hiŋaa</text></form></variant>
    <sense id="hiŋndo_1672_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agiter, brandir, remuer ; (hiŋ … hɔlla) tromper, léser ; tourner (qqch)</text></gloss>
      <gloss lang="en"><text>shake, brandish, wield; (hiŋ … hɔlla) deceive, wrong; turn (something)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first GEN.3.24; Lexique kissi–français, p. 18: hiŋɔɔ/ hiŋ</text></form></note>
    <note><form lang="fr"><text>hiŋ bollen « hocher la tête » (Jr 18,16). Lexique kissi–français, p. 18 : hiŋɔɔ/hiŋ « tourner qqch ».</text></form></note>
  </entry>
  <entry id="hiŋnɔnndo_1673">
    <lexical-unit><form lang="kqs"><text>hiŋnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiŋnun</text></form></variant>
    <variant><form lang="kqs"><text>hiŋnɔn</text></form></variant>
    <sense id="hiŋnɔnndo_1673_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>errer, aller çà et là ; s'agiter ; être tourné</text></gloss>
      <gloss lang="en"><text>wander about; be agitated; be turned</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be turned or stirred; turn around; become confused, go crazy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.37.15; Lexique kissi–français, p. 18: hinnɔnndo/ hinnun; Childs 2000, p. 127: hìŋnɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiŋndo. Lexique kissi–français, p. 18 : hinnɔnndo/hinnun « être tourné ; aller » (nn pour ŋn).</text></form></note>
  </entry>
  <entry id="hiɔlundɔɔ_1674">
    <lexical-unit><form lang="kqs"><text>hiɔlundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hiɔlundɔɔ_1674_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatrième</text></gloss>
      <gloss lang="en"><text>fourth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.42.16; Lexique kissi–français, p. 18: hiɔlundɔɔ</text></form></note>
  </entry>
  <entry id="hiɔlɔnndo_1675">
    <lexical-unit><form lang="kqs"><text>hiɔlɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlɔn</text></form></variant>
    <variant><form lang="kqs"><text>hiɔlun</text></form></variant>
    <sense id="hiɔlɔnndo_1675_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échapper, se sauver</text></gloss>
      <gloss lang="en"><text>escape, get away</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drop by accident, slip and fall; escape, slip away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.43.14; Childs 2000, p. 127: hìɔ̀lɔ̃ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de hiɔlɔɔ.</text></form></note>
  </entry>
  <entry id="hiɔlɔɔ_1676">
    <lexical-unit><form lang="kqs"><text>hiɔlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔlu</text></form></variant>
    <sense id="hiɔlɔɔ_1676_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre possession de, s'emparer de ; envahir</text></gloss>
      <gloss lang="en"><text>take possession of, seize; invade</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>win from somebody, take away by persuasion, money or force</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.20.18; Terminologie (histoire), n° 10: Hiölöö, poondaa; Childs 2000, p. 128: hìɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lɛŋnden hiɔlɔɔ « prendre possession du pays ». Académie des langues (terminologie, histoire n° 10) : « accaparement » (aussi poondaa). Aussi Terminologie, p. 301 : « Hiölöö ». Académie des langues (terminologie, histoire n° 301, 313) : « envahir ; s'emparer de » (aussi poondaa). Académie des langues (terminologie, histoire n° 517) : « reconquête » (aussi tɔlaa biyɔɔ).</text></form></note>
  </entry>
  <entry id="hìɔ́ɔ́_1677">
    <lexical-unit><form lang="kqs"><text>hìɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɔ́ɔ́_1677_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>flamber (poils, plumes) ; tromper</text></gloss>
      <gloss lang="en"><text>singe (hair, feathers); cheat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="híɔ́ɔ́dɔ́lɔ́ɔ́_1678">
    <lexical-unit><form lang="kqs"><text>híɔ́ɔ́dɔ́lɔ́ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="híɔ́ɔ́dɔ́lɔ́ɔ́_1678_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>ventre creusé (par la faim, rentré)</text></gloss>
      <gloss lang="en"><text>stomach drawn in (from hunger, sucked in)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: híɔ́ɔ́dɔ́lɔ́ɔ́</text></form></note>
  </entry>
  <entry id="hiɔɔlei_1679">
    <lexical-unit><form lang="kqs"><text>hiɔɔlei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hiɔɔlei_1679_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rançon</text></gloss>
      <gloss lang="en"><text>ransom</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 513: Hiöölei</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="hiɔɔlu_1680">
    <lexical-unit><form lang="kqs"><text>hiɔɔlu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>nuɔlu</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>ɲɔlu</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="hiɔɔlu_1680_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatre</text></gloss>
      <gloss lang="en"><text>four</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.10; Paulme 1964, p. 70 (G/K): nuɔlu /K./, nyɔlu /G./; Lexique kissi–français, p. 18: hiɔɔlu; Childs 2000, p. 128: hìɔ́ɔ́lú</text></form></note>
    <note><form lang="fr"><text>Aussi Lexique kissi–français, p. 36 : « n hɔɔlu ». Lexique kissi–français, p. 36 écrit n hɔɔlu « quatre ». Paulme 1964, p. 70 : nuɔlu /K./, nyɔlu /G./ « quatre » (cf. nɔma nwɔlu, nɔma yɔlɔ « neuf »). Paulme : nuɔlu /K./, nyɔlu /G./ (p. 70).</text></form></note>
  </entry>
  <entry id="hiɔɔlundɔɔ_1681">
    <lexical-unit><form lang="kqs"><text>hiɔɔlundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔɔlundɔ</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔlen</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔɛi</text></form></variant>
    <sense id="hiɔɔlundɔɔ_1681_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatrième</text></gloss>
      <gloss lang="en"><text>fourth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.14.5; Childs 2000, p. 128: hìɔ́ɔ́lùndɔ́ɔ́-</text></form></note>
    <note><form lang="fr"><text>De hiɔɔlu « quatre ». paale hiɔɔlundɔlen « le quatrième jour » (Gn 1,19).</text></form></note>
  </entry>
  <entry id="hìɔ̀ɔ̀lɔ́léŋ_1682">
    <lexical-unit><form lang="kqs"><text>hìɔ̀ɔ̀lɔ́léŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="hìɔ̀ɔ̀lɔ́léŋ_1682_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de champignon (mis dans les sauces)</text></gloss>
      <gloss lang="en"><text>kind of mushroom (used in sauces)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ̀ɔ̀lɔ́léŋ</text></form></note>
  </entry>
  <entry id="hìɔ̀ɔ̀nɔ̌ŋndó_1683">
    <lexical-unit><form lang="kqs"><text>hìɔ̀ɔ̀nɔ̌ŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɔ̀ɔ̀nɔ̌ŋndó_1683_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rentrer le ventre ; crâner, bluffer</text></gloss>
      <gloss lang="en"><text>draw in one's stomach; swagger, bluff</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 128: hìɔ̀ɔ̀nɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="hìɲáhíɲâŋndó_1684">
    <lexical-unit><form lang="kqs"><text>hìɲáhíɲâŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hìɲáhíɲâŋndó_1684_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aller et venir, mouvement de va-et-vient ; se démener</text></gloss>
      <gloss lang="en"><text>move back and forth, to and fro</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 127: hìɲáhíɲâŋndó</text></form></note>
  </entry>
  <entry id="hiɲhiɲdo_1685">
    <lexical-unit><form lang="kqs"><text>hiɲhiɲdo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hiɲhiɲdo_1685_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« diable » (jouet musical en rondelles de fruit)</text></gloss>
      <gloss lang="en"><text>"devil" (musical toy made of fruit discs)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 34: hinyhinydo</text></form></note>
  </entry>
  <entry id="ho_1686">
    <lexical-unit><form lang="kqs"><text>ho</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ho_1686_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-ci (classe o)</text></gloss>
      <gloss lang="en"><text>this (o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1059 occurrences, first GEN.2.16; Lexique kissi–français, p. 19: ho; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
  <entry id="hobus_1687">
    <lexical-unit><form lang="kqs"><text>hobus</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="hobus_1687_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>premier travail du cultivateur (couper les herbes des bas-fonds)</text></gloss>
      <gloss lang="en"><text>first farming task (cutting the grass of the lowlands)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 34: hobus, cf. i bu huo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 34 : « premier travail du cultivateur : couper les herbes des bas-fonds qui pourriront, donnant un premier engrais » ; cf. huo « jachère ». Forme (finale -s) douteuse, à vérifier auprès d'un locuteur.</text></form></note>
  </entry>
  <entry id="hoeiye_1688">
    <lexical-unit><form lang="kqs"><text>hoeiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hoeyii</text></form></variant>
    <variant><form lang="kqs"><text>hoiye</text></form></variant>
    <sense id="hoeiye_1688_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>froid ; souffle, vent ; paludisme, grippe ; air, vent</text></gloss>
      <gloss lang="en"><text>cold; breath, wind; malaria, flu ; air, wind; cold; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold, cold wind; cold dry season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 107 occurrences, first GEN.7.22; Keita 1979, p. 161: Hoeiye; Paulme 1964, p. 34: hɔye, hoiye; Lexique kissi–français, p. 19: hoeiye; Childs 2000, p. 134: hùɛ̀ìyé</text></form></note>
    <note><form lang="fr"><text>Keita : « le palu, la grippe ». Dans la Bible : « froid » (Gn 8,22) et « souffle » (Gn 7,22). Lexique kissi–français, p. 19 : aussi hoiye « le vent ; le froid ; l'air » (la Bible a hoiye en PRO.20.4).</text></form></note>
  </entry>
  <entry id="hoeyii_1689">
    <lexical-unit><form lang="kqs"><text>hoeyii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="hoeyii_1689_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vent ; souffle</text></gloss>
      <gloss lang="en"><text>wind; breath</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.2 Air"/>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cold wind, cold season; fever</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.7; Childs 2000, p. 134: hùèìyé</text></form></note>
  </entry>
  <entry id="hókìíyó_1690">
    <lexical-unit><form lang="kqs"><text>hókìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hókìíyó_1690_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>semaine</text></gloss>
      <gloss lang="en"><text>week</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 129: hókìíyó</text></form></note>
    <note><form lang="fr"><text>Emprunt (mendé, de l'anglais week) selon Childs.</text></form></note>
  </entry>
  <entry id="hòl-tìɔ́ɔ́_1691">
    <lexical-unit><form lang="kqs"><text>hòl-tìɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòl-tìɔ́ɔ́_1691_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon de termitière</text></gloss>
      <gloss lang="en"><text>termite mushroom (grows on termite hills)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 130: hòl-tìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="hòl-ŋ̀pèŋgòó_1692">
    <lexical-unit><form lang="kqs"><text>hòl-ŋ̀pèŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòl-ŋ̀pèŋgòó_1692_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon comestible (des termitières de type pùùsɔ́ɔ́)</text></gloss>
      <gloss lang="en"><text>edible mushroom (growing on a type of termite hill)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 130: hòl-ŋ̀pèŋgòó</text></form></note>
  </entry>
  <entry id="hollo_1693">
    <lexical-unit><form lang="kqs"><text>hollo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="hollo_1693_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon</text></gloss>
      <gloss lang="en"><text>mushroom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mushroom; helmet</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Hollo; Paulme 1964, p. 34: hole; Lexique kissi–français, p. 19: hollo; Childs 2000, p. 130: hòlló</text></form></note>
    <note><form lang="fr"><text>Pluriel holle selon Keita (p. 27). Lexique kissi–français, p. 19 : aussi hollen « champignon ». Paulme 1964, p. 34 : hole « champignon ».</text></form></note>
  </entry>
  <entry id="holnun_1694">
    <lexical-unit><form lang="kqs"><text>holnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>holnɔnndo</text></form></variant>
    <sense id="holnun_1694_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>cling to, be joined to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first GEN.2.24; Lexique kissi–français, p. 19: holnɔnndo</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 19 : holnɔnndo « se cramponner à ; se coller à » ; holnanndo « s'attacher ».</text></form></note>
  </entry>
  <entry id="holɔɔ_1695">
    <lexical-unit><form lang="kqs"><text>holɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hol</text></form></variant>
    <variant><form lang="kqs"><text>holnun</text></form></variant>
    <sense id="holɔɔ_1695_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attacher, fixer, coller ; monter (Keita) ; joindre ; renverser, faire tomber</text></gloss>
      <gloss lang="en"><text>fix, attach, stick; climb (Keita); join; knock over</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stick on, lean against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.25.7; Keita 1979, p. 110: Holöö; Lexique kissi–français, p. 19: holɔɔ; Terminologie (arts), n° 61: Holöö; Childs 2000, p. 130: hòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, hol signifie « fixer, sertir, porter la main sur » (EXO 28,11 ; GEN 22,12) et holnun « s'attacher à » (GEN 2,24). Le sens « monter » de Keita correspond plutôt à hel (Bible) et hèlɔ̀ɔ́ (Childs p. 120). Académie des langues (terminologie, arts n° 61) : « coller ».</text></form></note>
  </entry>
  <entry id="honnɔn ikalaa_1696">
    <lexical-unit><form lang="kqs"><text>honnɔn ikalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="honnɔn ikalaa_1696_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>liens matrimoniaux</text></gloss>
      <gloss lang="en"><text>marriage ties</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 415: Honnön ikalaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="hoo_1697">
    <lexical-unit><form lang="kqs"><text>hoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="hoo_1697_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui-ci, ceci</text></gloss>
      <gloss lang="en"><text>this one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 849 occurrences, first GEN.3.3; Childs 2000, p. 130: hóò</text></form></note>
  </entry>
  <entry id="hòólan_1698">
    <lexical-unit><form lang="kqs"><text>hòólan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hòóla</text></form></variant>
    <sense id="hòólan_1698_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champs, pâturages, terres (de culture)</text></gloss>
      <gloss lang="en"><text>fields, pastures, (farm) lands</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>old or abandoned farm, recently cultivated land</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.24.6; Childs 2000, p. 131: hòó</text></form></note>
    <note><form lang="fr"><text>Pluriel. cɔlua niaa vanin kɔlan diólano hòóla bɛndu-bɛndulan nin « tes troupeaux paîtront dans de vastes pâturages » (ISA.30.23) ; niaa saa co o hòóla nilan nin-nda « vous, brebis de mon pâturage » (EZK.34.31).</text></form></note>
  </entry>
  <entry id="hóòlí_1699">
    <lexical-unit><form lang="kqs"><text>hóòlí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="hóòlí_1699_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(déraciné) complètement</text></gloss>
      <gloss lang="en"><text>(uprooted) completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 131: hóòlí</text></form></note>
  </entry>
  <entry id="hoonde_1700">
    <lexical-unit><form lang="kqs"><text>hoonde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="hoonde_1700_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>celui-là, celle-là</text></gloss>
      <gloss lang="en"><text>that one</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 35: hóonde</text></form></note>
    <note><form lang="fr"><text>Paulme renvoie à ɔ, hɔ. Voyelle (o ou ɔ) à vérifier.</text></form></note>
  </entry>
  <entry id="hoondo_1701">
