  <entry id="yɛngɛiyo_6355">
    <lexical-unit><form lang="kqs"><text>yɛngɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɛngɛiyo_6355_s1">
