  <entry id="wàlácàŋndó_3701">
    <lexical-unit><form lang="kqs"><text>wàlácàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="wàlácàŋndó_3701_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>don ou tribut offert lors d'un décès</text></gloss>
      <gloss lang="en"><text>gift or tribute given on someone's death</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
