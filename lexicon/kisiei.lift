  <entry id="siyan_4620">
    <lexical-unit><form lang="kqs"><text>siyan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="siyan_4620_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piquants de porc-épic</text></gloss>
      <gloss lang="en"><text>porcupine quills</text></gloss>
