  <entry id="hòòŋndó_1702">
    <lexical-unit><form lang="kqs"><text>hòòŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="hòòŋndó_1702_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sangsue</text></gloss>
