    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kusuma</text></form></variant>
    <sense id="kusuan_1803_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pus ; écoulement (corporel)</text></gloss>
      <gloss lang="en"><text>pus; (bodily) discharge</text></gloss>
