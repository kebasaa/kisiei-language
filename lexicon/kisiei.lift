      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 242: màŋcáŋ</text></form></note>
  </entry>
  <entry id="máŋgáá_3427">
    <lexical-unit><form lang="kqs"><text>máŋgáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>máŋáá</text></form></variant>
    <sense id="máŋgáá_3427_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>colle traditionnelle sombre faite de sève</text></gloss>
      <gloss lang="en"><text>dark traditional glue made from tree sap</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 242: máŋgáá</text></form></note>
  </entry>
  <entry id="maŋɔlɔ_3428">
    <lexical-unit><form lang="kqs"><text>maŋɔlɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>maŋulua</text></form></field>
    <sense id="maŋɔlɔ_3428_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mangue</text></gloss>
      <gloss lang="en"><text>mango</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 62: maŋɔrɔ, pl. maŋurua</text></form></note>
  </entry>
  <entry id="màɲjàá_3429">
    <lexical-unit><form lang="kqs"><text>màɲjàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>màɲjàláŋ</text></form></field>
    <sense id="màɲjàá_3429_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bas-fond rizicole, surtout celui du chef</text></gloss>
      <gloss lang="en"><text>rice swamp, especially the chief's</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 242: màɲjàá</text></form></note>
  </entry>
  <entry id="mbaa_3430">
    <lexical-unit><form lang="kqs"><text>mbaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mbaa_3430_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>oui ? (réponse à un appel) ; merci (réponse à une salutation)</text></gloss>
      <gloss lang="en"><text>yes? (answer to a call); thanks (reply to a greeting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>response to a greeting</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.27.18; Paulme 1964, p. 3: bã, mbã; Childs 2000, p. 256: mbàà</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 3 : bã, mbã « merci, réponse à une salutation ».</text></form></note>
  </entry>
  <entry id="mbìlíìyó_3431">
    <lexical-unit><form lang="kqs"><text>mbìlíìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>mbìlííyó</text></form></variant>
    <sense id="mbìlíìyó_3431_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand tambour (timbale, grosse caisse)</text></gloss>
      <gloss lang="en"><text>large drum (kettle drum, bass drum)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 256: mbìlíìyó</text></form></note>
  </entry>
  <entry id="mbokponi_3432">
    <lexical-unit><form lang="kqs"><text>mbokponi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mbokponi_3432_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>demoiselle ; mademoiselle</text></gloss>
      <gloss lang="en"><text>young lady; miss</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Mbokponi; Terminologie (langue), n° 462: Mbokponi</text></form></note>
    <note><form lang="fr"><text>Forme inhabituelle, à confirmer. Confirmé par l'Académie des langues (terminologie, langue n° 462) : mbokponi « mademoiselle ».</text></form></note>
  </entry>
  <entry id="mboomaa_3433">
    <lexical-unit><form lang="kqs"><text>mboomaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>mbòòma</text></form></variant>
    <sense id="mboomaa_3433_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hamac ; litière, palanquin</text></gloss>
      <gloss lang="en"><text>hammock; litter, palanquin</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Nboomaa; Paulme 1964, p. 13 (G): mbōma /G./, pl. mbomera; Lexique kissi–français, p. 36: nbooma; Childs 2000, p. 256: mbòmàá</text></form></note>
    <note><form lang="fr"><text>Keita écrit Nboomaa. Forme radicale mbòòma « litière de Salomon » dans la Bible (Ct 3,7.9). Lexique kissi–français, p. 36 écrit nbooma « le hamac ».</text></form></note>
  </entry>
  <entry id="mbooyaa_3434">
    <lexical-unit><form lang="kqs"><text>mbooyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mbooya</text></form></variant>
    <sense id="mbooyaa_3434_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potage, bouillon</text></gloss>
      <gloss lang="en"><text>pottage, stew, broth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thin watery sauce served over rice, residue left after making palm oil</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2KI.4.38; Childs 2000, p. 256: mbòòyàá</text></form></note>
    <note><form lang="fr"><text>mà yowlu naa mbooyaa « fais-nous cuire un potage » (2KI.4.38).</text></form></note>
  </entry>
  <entry id="mbòòyàbèí_3435">
    <lexical-unit><form lang="kqs"><text>mbòòyàbèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="mbòòyàbèí_3435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>goyavier</text></gloss>
      <gloss lang="en"><text>guava tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 256: mbòòyàbèí</text></form></note>
  </entry>
  <entry id="mbɔ̀_3436">
    <lexical-unit><form lang="kqs"><text>mbɔ̀</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mbɔ̀_3436_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ah ! hélas ! (exclamation)</text></gloss>
      <gloss lang="en"><text>ah! alas! (exclamation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first GEN.24.56</text></form></note>
  </entry>
  <entry id="mbɛmbaa_3437">
    <lexical-unit><form lang="kqs"><text>mbɛmbaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mbɛmbaa_3437_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ancêtre ; grand-père</text></gloss>
      <gloss lang="en"><text>ancestor; grandfather</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 36: nbɛnbaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nbɛnbaa ; la Bible n'écrit jamais nb.</text></form></note>
  </entry>
  <entry id="médèíyé_3438">
    <lexical-unit><form lang="kqs"><text>médèíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>méédèíyé</text></form></variant>
    <sense id="médèíyé_3438_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insigne, médaille</text></gloss>
      <gloss lang="en"><text>badge, medal</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 244: médèíyé</text></form></note>
    <note><form lang="fr"><text>Emprunt à l'anglais medal.</text></form></note>
  </entry>
  <entry id="meilul_3439">
    <lexical-unit><form lang="kqs"><text>meilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>meilu</text></form></variant>
    <sense id="meilul_3439_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se taire (pour écouter), faire silence ; laisser (impuni)</text></gloss>
      <gloss lang="en"><text>be quiet (and listen), stop talking; let off, leave (unpunished)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stop, desist (usually from talking) for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.13.13; Childs 2000, p. 246: mɛ̀ìlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de meiyo « se taire ». Meilu vana nanu ! « Arrête ! » (1SA.15.16) ; meilul-la « taisez-vous » (JOB.13.13) ; mì meilul … « laisserais-je impunis … » (MIC.6.11).</text></form></note>
  </entry>
  <entry id="meiyo_3440">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="meiyo_3440_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>silence, calme (o meiyo nin)</text></gloss>
      <gloss lang="en"><text>silence, quiet (o meiyo nin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) keep quiet; set a time</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Terminologie (arts), n° 259: Meiyo, simndan; Childs 2000, p. 243: mèìyɔ́</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, arts n° 259) : « silence » (aussi simndan).</text></form></note>
  </entry>
  <entry id="meiyo_3441">
    <lexical-unit><form lang="kqs"><text>meiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mei</text></form></variant>
    <variant><form lang="kqs"><text>meinin</text></form></variant>
    <sense id="meiyo_3441_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se taire</text></gloss>
      <gloss lang="en"><text>be silent</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>keep quiet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first 2KI.7.9; Keita 1979, p. 110: Maiyo; Lexique kissi–français, p. 33: meiyo/ mei; Childs 2000, p. 243: mèìyó</text></form></note>
    <note><form lang="fr"><text>Keita écrit maiyo ; la Bible écrit meiyo (ECC 3,7). Moyen meinun. Lexique kissi–français, p. 33 : aussi « le silence ».</text></form></note>
  </entry>
  <entry id="méléká_3442">
    <lexical-unit><form lang="kqs"><text>méléká</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="méléká_3442_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>de façon inconvenante, turbulente ; volage</text></gloss>
      <gloss lang="en"><text>in an unseemly or unruly way, frisky; promiscuous</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: méléká</text></form></note>
  </entry>
  <entry id="mello_3443">
    <lexical-unit><form lang="kqs"><text>mello</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mel</text></form></variant>
    <variant><form lang="kqs"><text>melnin</text></form></variant>
    <sense id="mello_3443_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser (partir), permettre ; garder pour (Keita)</text></gloss>
      <gloss lang="en"><text>let go, allow; keep for (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first EXO.4.23; Keita 1979, p. 110: Mello; Lexique kissi–français, p. 34: mello/ mel</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mello signifie « laisser partir » (EXO 4,23) ; mel et melnin sont les formes négatives de mal « laisser » (GEN 28,15).</text></form></note>
  </entry>
  <entry id="mèlló_3444">
    <lexical-unit><form lang="kqs"><text>mèlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mèlló_3444_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nourriture mise de côté pour quelqu'un</text></gloss>
      <gloss lang="en"><text>food kept aside for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: mèlló</text></form></note>
    <note><form lang="fr"><text>Nom dérivé de màlɔ̀ɔ́ « laisser » ; cf. mello « laisser, garder pour » (Bible, Keita).</text></form></note>
  </entry>
  <entry id="meme_3445">
    <lexical-unit><form lang="kqs"><text>meme</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="meme_3445_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de toute façon</text></gloss>
      <gloss lang="en"><text>anyway</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 63: meme</text></form></note>
    <note><form lang="fr"><text>Paulme : tɔsa meme i kɔrani « de toute façon, j'irai ». Sens et découpage à vérifier.</text></form></note>
  </entry>
  <entry id="méŋèlěŋ_3446">
    <lexical-unit><form lang="kqs"><text>méŋèlěŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="méŋèlěŋ_3446_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(s'effondrer) complètement, en morceaux</text></gloss>
      <gloss lang="en"><text>(collapse, break up) completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 244: méŋèlěŋ</text></form></note>
  </entry>
  <entry id="mi_3447">
    <lexical-unit><form lang="kqs"><text>mi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mí</text></form></variant>
    <variant><form lang="kqs"><text>mì</text></form></variant>
    <variant><form lang="kqs"><text>mó</text></form></variant>
    <variant><form lang="kqs"><text>mò</text></form></variant>
    <variant><form lang="kqs"><text>má</text></form></variant>
    <variant><form lang="kqs"><text>mà</text></form></variant>
    <sense id="mi_3447_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>et (alors) ; pour que</text></gloss>
      <gloss lang="en"><text>and (then); so that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'that' (subordinating)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20412 occurrences, first GEN.1.1; Paulme 1964, p. 63: mi; Lexique kissi–français, p. 34: mi; Childs 2000, p. 249: mì</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 33-35 : mi « j'ai », ma « tu as », mo « il a », maa « ils ont », min « nous avons », mila « vous avez » (sujets devant le verbe au passé composé). Paulme 1964, p. 63 : mi « marque de détermination, c'est lui qui… » (mi mallo dimi « l'étranger a dit, c'est l'étranger qui a dit »).</text></form></note>
  </entry>
  <entry id="miallo_3448">
    <lexical-unit><form lang="kqs"><text>miallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mialla</text></form></field>
    <sense id="miallo_3448_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>étranger</text></gloss>
      <gloss lang="en"><text>stranger, foreigner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>guest, visitor, outsider</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.23.4; Keita 1979, p. 148: Miallo; Paulme 1964, p. 61: mallo, pl. malla; Lexique kissi–français, p. 34: miallo; Terminologie (idéologie), n° 282: Miallo; Childs 2000, p. 249: mìàlló</text></form></note>
  </entry>
  <entry id="mììlòó_3449">
    <lexical-unit><form lang="kqs"><text>mììlòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="mììlòó_3449_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rétrécir, raccourcir</text></gloss>
      <gloss lang="en"><text>shrink, shorten</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 249: mììlòó</text></form></note>
  </entry>
  <entry id="miinguuo_3450">
    <lexical-unit><form lang="kqs"><text>miinguuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>miinguu</text></form></variant>
    <variant><form lang="kqs"><text>miinguo</text></form></variant>
    <variant><form lang="kqs"><text>miingul</text></form></variant>
    <variant><form lang="kqs"><text>miingun</text></form></variant>
    <variant><form lang="kqs"><text>miingulnin</text></form></variant>
    <sense id="miinguuo_3450_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>répéter, refaire, redire ; (miinguu yaŋɔɔlen) tendre une embuscade</text></gloss>
      <gloss lang="en"><text>repeat, do again, say again; (miinguu yaŋɔɔlen) lay an ambush</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JDG.5.29; Terminologie (langue), n° 362: Miinguuo</text></form></note>
    <note><form lang="fr"><text>o co lan miinguo lediin-diin, leyàá-yàá « il le fait deux fois, trois fois » (Jb 33,29) ; la miinguu sondo aa « qu'ils redisent » (Ps 118,2) ; miingul … yaŋɔɔlan « dresser une embuscade contre quelqu'un » (Dt 19,11). Académie des langues (terminologie, langue n° 362 et 363) : « réviser, révision ».</text></form></note>
  </entry>
  <entry id="miisuu_3451">
    <lexical-unit><form lang="kqs"><text>miisuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>miisu</text></form></variant>
    <sense id="miisuu_3451_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>précipiter dans l'eau, engloutir, noyer ; se noyer</text></gloss>
      <gloss lang="en"><text>hurl into the water, engulf, drown; be drowned</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>immerse or dunk in water; also put someone into trouble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first EXO.14.27; Childs 2000, p. 250: mììsùùwó</text></form></note>
    <note><form lang="fr"><text>O miisuu soa a vanaa ɲaanun o soa coo-o mɛmma ihɛlma … nin « il a précipité dans la mer cheval et cavalier » (Ex 15,1) ; má miisuu o mɛnndan nin « ils furent noyés » (He 11,29).</text></form></note>
  </entry>
  <entry id="miiyo_3452">
    <lexical-unit><form lang="kqs"><text>miiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="miiyo_3452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>importance, renommée, popularité ; ascendant, influence ; gloire</text></gloss>
      <gloss lang="en"><text>importance, renown, popularity; ascendancy, influence; glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 88: Ba tiuvaa, Miiyo; Childs 2000, p. 250: mîìyó</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par l'Académie des langues (terminologie, histoire n° 88) : miiyo « ascendant » (aussi ba tiuvaa). Aussi Terminologie, p. 315 : « Töö bèndoo, Miiyo ». Confirmé au Nord par l'Académie des langues (terminologie, idéologie n° 315) : miiyo « gloire » (aussi tɔ́ɔ́ bɛndoo) ; vana miiyo « noble, glorieux ». Académie des langues (terminologie, idéologie n° 353) : « influence » (aussi hiovɔɔ, salamayɛi). Pluriel en kissi du Sud (Childs 2000) : mîìláŋ.</text></form></note>
  </entry>
  <entry id="mììŋùùwóŋ_3453">
    <lexical-unit><form lang="kqs"><text>mììŋùùwóŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ŋ"/>
    <trait name="status" value="southern"/>
    <sense id="mììŋùùwóŋ_3453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz récolté au second passage (pas mûr la première fois)</text></gloss>
      <gloss lang="en"><text>rice harvested on a second pass (not ripe the first time)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 250: mììŋùùwóŋ</text></form></note>
  </entry>
  <entry id="mílímáláá_3454">
    <lexical-unit><form lang="kqs"><text>mílímáláá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="mílímáláá_3454_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boue très épaisse</text></gloss>
      <gloss lang="en"><text>very thick mud</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 250: mílímáláá</text></form></note>
  </entry>
  <entry id="milinndo_3455">
    <lexical-unit><form lang="kqs"><text>milinndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>milin</text></form></variant>
    <variant><form lang="kqs"><text>mindo</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="milinndo_3455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nez</text></gloss>
      <gloss lang="en"><text>nose</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.13.45; Keita 1979, p. 132: Milinndo; Paulme 1964, p. 63: milindo, pl. milinda; Lexique kissi–français, p. 34: milinndo; Childs 2000, p. 250: mǐŋndó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 63 : milindo, pl. milinda « nez » ; mindo (G.). Paulme : milindo ; mindo /G./ (p. 63).</text></form></note>
  </entry>
  <entry id="milio_3456">
