      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 130: hòl-tìɔ́ɔ́</text></form></note>
  </entry>
  <entry id="hòl-ŋ̀pèŋgòó_1084">
