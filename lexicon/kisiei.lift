    <trait name="status" value="southern"/>
    <sense id="fùlùlàá_1044_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étuver, cuire à la vapeur (riz)</text></gloss>
      <gloss lang="en"><text>parboil, steam (rice)</text></gloss>
