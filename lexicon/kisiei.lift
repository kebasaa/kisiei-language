      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first GEN.7.23</text></form></note>
  </entry>
  <entry id="selennda_3479">
    <lexical-unit><form lang="kqs"><text>selennda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="selennda_3479_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de sauterelles (pl.)</text></gloss>
      <gloss lang="en"><text>a kind of locusts (pl.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>edible tree-dwelling grasshoppers</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.11.22; Childs 2000, p. 324: séléŋndó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas dans la Bible. Cité avec sóónɔa et paalenda (LEV.11.22, JOL.1.4, JOL.2.25).</text></form></note>
  </entry>
  <entry id="sèmɔ̀ɔ́_3480">
    <lexical-unit><form lang="kqs"><text>sèmɔ̀ɔ́</text></form></lexical-unit>
