    <sense id="sààbándìínɔ̀ɔ́_4309_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porteur du sac du chef</text></gloss>
      <gloss lang="en"><text>chief's bag-carrier</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 315: sààbándìínɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="saabandiinɔɔ_4310">
    <lexical-unit><form lang="kqs"><text>saabandiinɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>saabandiilen</text></form></variant>
    <sense id="saabandiinɔɔ_4310_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>garde ; (saabandiilen) la garde</text></gloss>
      <gloss lang="en"><text>guard; (saabandiilen) the guard</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 357: Saabandiilen, saabandiinöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. sààbándìínɔ̀ɔ́ « porteur du sac du chef » (Childs, kissi du Sud).</text></form></note>
  </entry>
  <entry id="sààbèíyó_4311">
    <lexical-unit><form lang="kqs"><text>sààbèíyó</text></form></lexical-unit>
