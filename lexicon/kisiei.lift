  <entry id="sei_3469">
    <lexical-unit><form lang="kqs"><text>sei</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sei_3469_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>ô ! (particule du vocatif, après le nom)</text></gloss>
      <gloss lang="en"><text>O! (vocative particle, after the name)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 260 occurrences, first GEN.11.3; Childs 2000, p. 324: sɛ́ì</text></form></note>
    <note><form lang="fr"><text>Abraham sei « Abraham ! » (Gn 22,11) ; Vannda sei ! « Allons ! » (Gn 11,3).</text></form></note>
  </entry>
  <entry id="seilen_3470">
