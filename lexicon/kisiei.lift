      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>reason, cause, meaning; also an act of kindness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.20.17; Childs 2000, p. 318: sábòó</text></form></note>
  </entry>
