  <entry id="ka_608">
    <lexical-unit><form lang="kqs"><text>ka</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ka_608_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>(après un indéfini redoublé) quel qu'il soit, de toutes sortes</text></gloss>
      <gloss lang="en"><text>(after a reduplicated indefinite) whatever, of every kind</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note><form lang="fr"><text>súú-súù ka « de toutes sortes » ; nɛɛ-nɛɛ ka « partout » ; ɲɛ-ɲɛ ka co ya o ba « j'ai de tout » (Gn 33,11).</text></form></note>
  </entry>
  <entry id="kàá_609">
    <lexical-unit><form lang="kqs"><text>kàá</text></form></lexical-unit>
