      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 94: siyã</text></form></note>
    <note><form lang="fr"><text>Paulme : souvent élément d'un kowã (charme).</text></form></note>
