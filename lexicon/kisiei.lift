  <entry id="pembulen_2564">
    <lexical-unit><form lang="kqs"><text>pembulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pembule</text></form></variant>
