    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 37: ndiŋin</text></form></note>
  </entry>
  <entry id="ndíɛ́mbɔ̀_3690">
    <lexical-unit><form lang="kqs"><text>ndíɛ́mbɔ̀</text></form></lexical-unit>
