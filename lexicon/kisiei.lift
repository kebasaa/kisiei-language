    <sense id="hiɔɔlu_542_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatre</text></gloss>
      <gloss lang="en"><text>four</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 157 occurrences, first GEN.2.10; Childs 2000, p. 128: hìɔ́ɔ́lú</text></form></note>
