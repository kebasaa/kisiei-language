      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 17: dasa</text></form></note>
    <note><form lang="fr"><text>Paulme : Fangamadou.</text></form></note>
  </entry>
  <entry id="dàtàá_989">
    <lexical-unit><form lang="kqs"><text>dàtàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dàtàá_989_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>critiquer, dénigrer, accuser ; importuner</text></gloss>
