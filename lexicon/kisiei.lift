      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 153: kééwéé-kééwéé</text></form></note>
  </entry>
  <entry id="kèéŋndó_1299">
    <lexical-unit><form lang="kqs"><text>kèéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kèéŋndó_1299_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil terrestre</text></gloss>
      <gloss lang="en"><text>ground squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 158: kèéŋndó</text></form></note>
  </entry>
  <entry id="kefii_1300">
    <lexical-unit><form lang="kqs"><text>kefii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kefon</text></form></field>
    <variant><form lang="kqs"><text>kefun</text></form></variant>
    <sense id="kefii_1300_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dard, aiguillon (d'insecte) ; (kefun) balle (du grain)</text></gloss>
      <gloss lang="en"><text>sting, stinger (of an insect); (kefun) chaff</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rice chaff, husks; stinger of an insect</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1CO.15.55; Childs 2000, p. 153: kèfèí</text></form></note>
    <note><form lang="fr"><text>Òó piɔ́mndo, ɔ́ɔ̀ kefii nɔmnde ? « Ô mort, où est ton aiguillon ? » (1CO.15.55) ; puiye a kefon « des queues et des dards » (REV.9.10) ; maa kefun hoeiye kɔandu « comme la balle que le vent emporte » (HOS.13.3).</text></form></note>
  </entry>
  <entry id="keilan_1301">
    <lexical-unit><form lang="kqs"><text>keilan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="keilan_1301_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>passage, chemin parcouru, démarche</text></gloss>
      <gloss lang="en"><text>passing, way one walks, path</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>passing; way, track (plural of 'pass by')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.4.26; Childs 2000, p. 153: kèíláŋ</text></form></note>
    <note><form lang="fr"><text>Peelu nɛi n co keilan coo-o tɛlɛlɛ « aplanis le chemin où tu marches » (PRO.4.26). Nom dérivé de keiyo « passer ».</text></form></note>
  </entry>
  <entry id="keiyo_1302">
    <lexical-unit><form lang="kqs"><text>keiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kei</text></form></variant>
    <variant><form lang="kqs"><text>keinin</text></form></variant>
    <sense id="keiyo_1302_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>passer (par), traverser ; marcher sur</text></gloss>
      <gloss lang="en"><text>pass through, cross; tread on</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pass by or through; undergo</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 154 occurrences, first GEN.41.34; Childs 2000, p. 153: kèìyó</text></form></note>
    <note><form lang="fr"><text>ɲɛdiaa le keiyo dioo nɛi-tɛɛn « des vivres pour la route » (Gn 42,25).</text></form></note>
  </entry>
  <entry id="kèìyó_1303">
    <lexical-unit><form lang="kqs"><text>kèìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kèìyó_1303_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>portail, porte d'enclos</text></gloss>
      <gloss lang="en"><text>gate</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 153: kèìyó</text></form></note>
  </entry>
  <entry id="kèké_1304">
    <lexical-unit><form lang="kqs"><text>kèké</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kèkíá</text></form></field>
    <sense id="kèké_1304_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>père, oncle paternel ; terme d'adresse pour un supérieur</text></gloss>
      <gloss lang="en"><text>father, paternal uncle; address term for a male superior</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 159: kèké kèkíá</text></form></note>
  </entry>
  <entry id="kékélé_1305">
    <lexical-unit><form lang="kqs"><text>kékélé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kékélé_1305_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(sec) complètement</text></gloss>
      <gloss lang="en"><text>(dry) completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.41.6</text></form></note>
  </entry>
  <entry id="kelaa_1306">
    <lexical-unit><form lang="kqs"><text>kelaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kela</text></form></variant>
    <variant><form lang="kqs"><text>kelanin</text></form></variant>
    <sense id="kelaa_1306_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>marcher ; se conduire</text></gloss>
      <gloss lang="en"><text>walk ; walk; behave, live</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>walk around (e.g. to sell)</text></form></field>
