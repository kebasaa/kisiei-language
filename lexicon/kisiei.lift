    <trait name="status" value="southern"/>
    <sense id="kpéléméíyé_1855_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langage secret des jeunes gens (syllabes inversées)</text></gloss>
      <gloss lang="en"><text>young men's secret language (reversed syllables)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 209: kpéléméíyé</text></form></note>
