    <sense id="fɔlɔn_466_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>d'abord, auparavant</text></gloss>
      <gloss lang="en"><text>first, beforehand</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>first</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 133 occurrences, first GEN.24.33; Childs 2000, p. 109: fɔ́lɔ́ŋndó</text></form></note>
  </entry>
  <entry id="fɔ̀nɔ̀ɔ́_467">
