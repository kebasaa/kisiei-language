      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de battements rapides et forts (tambour, cœur, régimes de noix qui tombent)</text></gloss>
      <gloss lang="en"><text>sound of rapid loud beating (drum, heart, palm-nut bunches falling)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
