    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pembon</text></form></field>
    <sense id="pembei_1270_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>montagne</text></gloss>
      <gloss lang="en"><text>mountain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hill, mountain</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 336 occurrences, first GEN.14.6; Keita 1979, p. 155: Pembei; Childs 2000, p. 292: pèmbèí</text></form></note>
