    <sense id="yáwèlè-yáwèlè_4629_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(nourriture mal cuite ou trop cuite)</text></gloss>
      <gloss lang="en"><text>(food badly cooked, overdone)</text></gloss>
