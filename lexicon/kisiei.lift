    <variant><form lang="kqs"><text>ibunga</text></form></variant>
    <sense id="ibungaa_1335_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gouverneur (masa ibungaa)</text></gloss>
