    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bembaa_60_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand-père</text></gloss>
      <gloss lang="en"><text>grandfather</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grandparent</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bembaa; Childs 2000, p. 18: bìmbàá</text></form></note>
    <note><form lang="fr"><text>La Bible dit fuɲa-mamaa « grand-père, ancêtre ».</text></form></note>
  </entry>
  <entry id="bémbé_61">
    <lexical-unit><form lang="kqs"><text>bémbé</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bémbélan</text></form></field>
    <variant><form lang="kqs"><text>bémbéla</text></form></variant>
    <sense id="bémbé_61_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tas, monceau ; ruines</text></gloss>
      <gloss lang="en"><text>heap, pile; ruins</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first RUT.3.7</text></form></note>
    <note><form lang="fr"><text>siinguu … bémbélan « réduire en ruines ».</text></form></note>
  </entry>
  <entry id="bendallo_62">
    <lexical-unit><form lang="kqs"><text>bendallo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bendal</text></form></variant>
    <variant><form lang="kqs"><text>bendalnin</text></form></variant>
    <sense id="bendallo_62_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>poursuivre</text></gloss>
      <gloss lang="en"><text>pursue</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.14.9</text></form></note>
  </entry>
  <entry id="bendun_63">
    <lexical-unit><form lang="kqs"><text>bendun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bendun_63_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tromper, faillir ; commettre (une faute) par mégarde</text></gloss>
      <gloss lang="en"><text>err, go astray; commit (a fault) unintentionally</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.15.25; Childs 2000, p. 10: bèndɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>nda bendun biondɔn kon « ils ont commis cette faute » (Nb 15,25). Childs : variante de bìòndɔ̀ŋndó « se tromper ».</text></form></note>
  </entry>
  <entry id="bibuloo_64">
    <lexical-unit><form lang="kqs"><text>bibuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bibuloo_64_s1">
