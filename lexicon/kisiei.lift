    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 527: Vananyöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="vanaɲɛcaa_5685">
    <lexical-unit><form lang="kqs"><text>vanaɲɛcaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vanaɲɛcaa_5685_s1">
