    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi tambayiilepɛnndo.</text></form></note>
  </entry>
  <entry id="ilafilafiei_1807">
    <lexical-unit><form lang="kqs"><text>ilafilafiei</text></form></lexical-unit>
