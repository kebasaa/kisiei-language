      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>glissant</text></gloss>
      <gloss lang="en"><text>slippery, slick</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 331: síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀</text></form></note>
  </entry>
  <entry id="siɛɛmbiaa_4663">
    <lexical-unit><form lang="kqs"><text>siɛɛmbiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛmbiɛi</text></form></variant>
    <variant><form lang="kqs"><text>siɛɛmbian</text></form></variant>
    <sense id="siɛɛmbiaa_4663_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pointu, acéré</text></gloss>
      <gloss lang="en"><text>sharp, pointed</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.45.6</text></form></note>
    <note><form lang="fr"><text>yɔmii siɛɛmbiɛi « javelots » (2 S 18,14) ; yɔɔn siɛɛmbiaa « épine acérée » (Ez 28,24).</text></form></note>
  </entry>
  <entry id="siɛɛndo_4664">
    <lexical-unit><form lang="kqs"><text>siɛɛndo</text></form></lexical-unit>
