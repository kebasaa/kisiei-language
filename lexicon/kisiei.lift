      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first 2CH.10.19</text></form></note>
    <note><form lang="fr"><text>tosa seesiɛi a … « se révolter contre … » ; luɛi o seesiɛi « entrer en rébellion ».</text></form></note>
  </entry>
