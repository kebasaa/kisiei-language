      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>échapper, se sauver</text></gloss>
      <gloss lang="en"><text>escape, get away</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>drop by accident, slip and fall; escape, slip away</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first GEN.43.14; Childs 2000, p. 127: hìɔ̀lɔ̃ŋndó</text></form></note>
