  <entry id="kɔsɔnɔɔ_2877">
    <lexical-unit><form lang="kqs"><text>kɔsɔnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kɔsio</text></form></field>
    <sense id="kɔsɔnɔɔ_2877_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme excisée, joueuse de sɛo</text></gloss>
      <gloss lang="en"><text>excised woman who plays the sɛo</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: kɔsɔno, pl. kɔsyo</text></form></note>
    <note><form lang="fr"><text>Paulme marque ce mot /S./ ; -no réécrit -nɔɔ (suffixe d’agent de la Bible).</text></form></note>
  </entry>
  <entry id="kɔsɔɔ_2878">
    <lexical-unit><form lang="kqs"><text>kɔsɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kɔsɔ</text></form></variant>
    <sense id="kɔsɔɔ_2878_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langueur, dépérissement ; (luɛi kɔsɔ) dépérir, se flétrir, être en deuil (terre)</text></gloss>
      <gloss lang="en"><text>languor, wasting; (luɛi kɔsɔ) languish, wither, mourn (of the land)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.1 Sick"/>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sick person; (pl.) sickness, illness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.64.6; Childs 2000, p. 189: kɔ́sɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>lɛŋnden le luɛi kɔsɔ « la terre est en deuil » (JOL.1.10) ; tumnda n'rɛsɛnndan la luɛi kɔsɔ « la vigne languit » (ISA.24.7) ; mì mal naa kɔsɔɔ luɛyɔɔ « nous sommes tous flétris » (ISA.64.6) ; dii ndu kɔsɔ « l'anéantir » (JDG.4.24).</text></form></note>
  </entry>
  <entry id="kɔsɛn_2879">
    <lexical-unit><form lang="kqs"><text>kɔsɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔsɛn_2879_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante à fibres (tressées en vans, nattes)</text></gloss>
      <gloss lang="en"><text>fibre plant (plaited into winnowing trays, mats)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: kɔsɛ̃</text></form></note>
    <note><form lang="fr"><text>Paulme : « les fibres de kɔsɛ̃ sont tressées en van, natte, etc. »</text></form></note>
  </entry>
  <entry id="kɔ̀tɔ́kpàá_2880">
    <lexical-unit><form lang="kqs"><text>kɔ̀tɔ́kpàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀tɔ́kpàá_2880_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>griffe de fer à deux crochets (« ongles du diable »)</text></gloss>
      <gloss lang="en"><text>two-hooked iron claw ('the devil's fingernails')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 189: kɔ̀tɔ́kpàá</text></form></note>
  </entry>
  <entry id="kɔtɔla_2881">
    <lexical-unit><form lang="kqs"><text>kɔtɔla</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔtɔla_2881_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chat sauvage (?)</text></gloss>
      <gloss lang="en"><text>wild cat (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 49: kɔtɔla</text></form></note>
    <note><form lang="fr"><text>Sens donné avec un point d'interrogation par Paulme.</text></form></note>
  </entry>
  <entry id="kɔ̀ùwó_2882">
    <lexical-unit><form lang="kqs"><text>kɔ̀ùwó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ùwó_2882_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être mal cuit, mal fait</text></gloss>
      <gloss lang="en"><text>be undercooked, badly done</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 190: kɔ̀ùwó</text></form></note>
  </entry>
  <entry id="kɔvan_2883">
    <lexical-unit><form lang="kqs"><text>kɔvan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kɔvan_2883_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>relation entre parents (?)</text></gloss>
      <gloss lang="en"><text>relationship between relatives (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 27: kɔvan</text></form></note>
    <note><form lang="fr"><text>Glose douteuse dans le Lexique : « le rapport progressif des parents ? ».</text></form></note>
  </entry>
  <entry id="kɔyo_2884">
    <lexical-unit><form lang="kqs"><text>kɔyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kɔian</text></form></field>
    <sense id="kɔyo_2884_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre kɔbi (bois très dur, écorce en infusion)</text></gloss>
      <gloss lang="en"><text>kɔbi tree (very hard wood, bark used in infusions)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 45: kɔ, kɔwɔ, kɔyo, kuyɔ, pl. kɔyã</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 45 : bois très dur, on s'en sert pour les feux ; écorce utilisée en infusions. Variantes kɔ, kɔvɔ, kuyɔ. Son fruit est le kɔbi.</text></form></note>
  </entry>
  <entry id="kɔyɛiyo_2885">
    <lexical-unit><form lang="kqs"><text>kɔyɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔyɛiyo_2885_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pauvre</text></gloss>
      <gloss lang="en"><text>poor</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8 Finance"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 49: kɔyɛyo</text></form></note>
    <note><form lang="fr"><text>La Bible dit ikɔɔ « pauvre ».</text></form></note>
  </entry>
  <entry id="kɔ́ŋ-kɔ́ŋ_2886">
    <lexical-unit><form lang="kqs"><text>kɔ́ŋ-kɔ́ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ́ŋ-kɔ́ŋ_2886_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>toc-toc (annonce une arrivée)</text></gloss>
      <gloss lang="en"><text>knock-knock (announces one's arrival)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ́ŋ-kɔ́ŋ</text></form></note>
  </entry>
  <entry id="kɔ̀ŋǎŋndó_2887">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋǎŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ŋǎŋndó_2887_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>menacer, faire une démonstration de force (danse du guerrier, du devin)</text></gloss>
      <gloss lang="en"><text>threaten, put on a display of power (warrior or shaman dance)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ̀ŋǎŋndó</text></form></note>
  </entry>
  <entry id="kɔ̀ŋǎŋndó_2888">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋǎŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ŋǎŋndó_2888_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>revendiquer comme sien</text></gloss>
      <gloss lang="en"><text>claim as one's own</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4 Have, be with"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ̀ŋǎŋndó</text></form></note>
  </entry>
  <entry id="kɔ̀ŋgɔ̀ɔ́_2889">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋgɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ŋgɔ̀ɔ́_2889_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>menacer</text></gloss>
      <gloss lang="en"><text>threaten</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 185: kɔ̀ŋgɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="kɔŋndo_2890">
    <lexical-unit><form lang="kqs"><text>kɔŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔŋndo_2890_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros poisson-chat (saison des pluies)</text></gloss>
      <gloss lang="en"><text>large catfish (caught in the rainy season)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 47: kɔndo, pl. kɔnda; Lexique kissi–français, p. 27: kɔnndo; Childs 2000, p. 186: kɔ̀ŋndó kɔ̀ŋndá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 27 (kɔnndo « un gros poisson noir sans écailles »). Pluriel en kissi du Sud (Childs 2000) : kɔ̀ŋndá. Paulme 1964, p. 47 : kɔndo, pl. kɔnda « silures ». Aussi Paulme 1964, p. 49 : « kondo, pl. konda ». Paulme 1964, p. 49 : kondo, pl. konda (aussi kwɔndo) « poissons noirs à muffle grenu, pêchés à l'épervier, silures ? » ; p. 50 : kuɔndo « poisson grisâtre, le plus gros de tous, = kɔnde, silure ». Aussi Paulme 1964, p. 50 : « kuɔndo ».</text></form></note>
  </entry>
  <entry id="kɔŋndo_2891">
    <lexical-unit><form lang="kqs"><text>kɔŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kɔŋndo_2891_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à poison d'épreuve</text></gloss>
      <gloss lang="en"><text>ordeal-poison tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: koŋo, kɔndo; Childs 2000, p. 186: kɔ̀ŋndó kɔ̀ŋndé</text></form></note>
    <note><form lang="fr"><text>Erythrophleum guineensis. Confirmé au Nord par Paulme 1964, p. 48 : koŋo, kɔndo, plante souvent associée à un culte, employée dans le tannage des peaux ; en poudre, avec le fiel de crocodile, poison (bɔta). Pluriel en kissi du Sud (Childs 2000) : kɔ̀ŋndé.</text></form></note>
  </entry>
  <entry id="kɔ̀ŋùèíyó_2892">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋùèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kɔ̀ŋùèíláŋ</text></form></field>
    <sense id="kɔ̀ŋùèíyó_2892_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>seau</text></gloss>
      <gloss lang="en"><text>pail, bucket</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 186: kɔ̀ŋùèíyó kɔ̀ŋùèíláŋ</text></form></note>
  </entry>
  <entry id="kɔŋɔ_2893">
    <lexical-unit><form lang="kqs"><text>kɔŋɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kɔŋɔla</text></form></field>
    <sense id="kɔŋɔ_2893_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poitrine (d'un animal de sacrifice)</text></gloss>
      <gloss lang="en"><text>breast (of a sacrificial animal), brisket</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.29.26</text></form></note>
    <note><form lang="fr"><text>kɔŋɔ saa kóndó « la poitrine du bélier » (Ex 29,26).</text></form></note>
  </entry>
  <entry id="kɔ̀ŋɔ̀fàmèíyó_2894">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋɔ̀fàmèíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ŋɔ̀fàmèíyó_2894_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand coupe-coupe</text></gloss>
      <gloss lang="en"><text>large cutlass</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 186: kɔ̀ŋɔ̀fàmèíyó</text></form></note>
  </entry>
  <entry id="kɔ̀ŋɲàá_2895">
    <lexical-unit><form lang="kqs"><text>kɔ̀ŋɲàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kɔ̀ŋɲàá_2895_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mesure de riz (ce qu'on rassemble avec les mains)</text></gloss>
      <gloss lang="en"><text>measure of rice (what is gathered with both hands)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 186: kɔ̀ŋɲàá</text></form></note>
  </entry>
  <entry id="kɔɔ_2896">
    <lexical-unit><form lang="kqs"><text>kɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kɔɔ_2896_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dos</text></gloss>
      <gloss lang="en"><text>back</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 879 occurrences, first GEN.18.21; Keita 1979, p. 131: Köö; Paulme 1964, p. 46 (G): kɔɔ, pl. kora; Lexique kissi–français, p. 27: kɔɔ; Childs 2000, p. 186: kɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Homographes : kɔ̀ɔ̀ « bouclier » ; o kɔɔ « au lieu, chez ». Paulme 1964, p. 46 : kɔɔ (G.), pl. kora « dos ».</text></form></note>
  </entry>
  <entry id="kɔ́ɔ́_2897">
    <lexical-unit><form lang="kqs"><text>kɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kɔ́ɔ́wá</text></form></field>
    <sense id="kɔ́ɔ́_2897_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit serpent venimeux vert foncé ou noir</text></gloss>
      <gloss lang="en"><text>small poisonous dark-green or black snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 186: kɔ́ɔ́ kɔ́ɔ́wá</text></form></note>
  </entry>
  <entry id="kɔ́ɔ̀-kɔ̀ɔ̀_2898">
