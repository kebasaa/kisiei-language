    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>peltan</text></form></field>
    <variant><form lang="kqs"><text>pelta</text></form></variant>
    <sense id="pelten_2561_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>œuf</text></gloss>
      <gloss lang="en"><text>egg</text></gloss>
