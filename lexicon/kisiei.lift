  <entry id="hala_990">
    <lexical-unit><form lang="kqs"><text>hala</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>halaa</text></form></field>
    <sense id="hala_990_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dieu, divinité</text></gloss>
      <gloss lang="en"><text>god, deity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6548 occurrences, first GEN.1; Childs 2000, p. 117: hálà</text></form></note>
    <note><form lang="fr"><text>Nom commun : halaa celen « d'autres dieux » (Ex 20,3), hala naa « notre dieu ». Avec une majuscule, Hala est le nom de Dieu. Childs : emprunt à l'arabe (Allah), surtout en kissi de Guinée.</text></form></note>
  </entry>
  <entry id="Hala_991">
