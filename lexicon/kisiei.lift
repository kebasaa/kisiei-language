  <entry id="pimbullo_1291">
    <lexical-unit><form lang="kqs"><text>pimbullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pimbul</text></form></variant>
    <variant><form lang="kqs"><text>pimbulu</text></form></variant>
    <variant><form lang="kqs"><text>pimbulaa</text></form></variant>
