  <entry id="làfàá_3011">
    <lexical-unit><form lang="kqs"><text>làfàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="làfàá_3011_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>détaler, s'enfuir (de peur ou d'excitation)</text></gloss>
      <gloss lang="en"><text>run off, dash away (in fright or excitement)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 221: làfàá</text></form></note>
  </entry>
  <entry id="lafi-lafi_3012">
    <lexical-unit><form lang="kqs"><text>lafi-lafi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lafi-lafilan</text></form></variant>
    <sense id="lafi-lafi_3012_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avec insistance, instamment</text></gloss>
      <gloss lang="en"><text>insistently, urgently</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tight(ly)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 1KI.13.18; Childs 2000, p. 221: láfí-láfí</text></form></note>
    <note><form lang="fr"><text>baŋnun ndu lafi-lafi « le pressa avec insistance » (2KI.5.16) ; lo ndu ilafi-lafiei kɔɔli « le pressa sans relâche » (JDG.16.16).</text></form></note>
  </entry>
  <entry id="lafiluo_3013">
    <lexical-unit><form lang="kqs"><text>lafiluo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="lafiluo_3013_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>riz cuit avec piment, sel et soumbara</text></gloss>
      <gloss lang="en"><text>rice cooked with chili, salt and soumbala</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 55: lafiruo</text></form></note>
    <note><form lang="fr"><text>Paulme : mumu lafiryo.</text></form></note>
  </entry>
  <entry id="lafitinaa_3014">
    <lexical-unit><form lang="kqs"><text>lafitinaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lafitina</text></form></variant>
    <sense id="lafitinaa_3014_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lampe, lumière</text></gloss>
      <gloss lang="en"><text>lamp, light</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.25.6</text></form></note>
  </entry>
  <entry id="lafuuo_3015">
    <lexical-unit><form lang="kqs"><text>lafuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lafuuo_3015_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>chaud, qui réchauffe</text></gloss>
      <gloss lang="en"><text>warm, warming</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>warm, lukewarm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JOB.31.20; Childs 2000, p. 221: láfùù</text></form></note>
  </entry>
  <entry id="lahakio_3016">
    <lexical-unit><form lang="kqs"><text>lahakio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>lahakia</text></form></field>
    <sense id="lahakio_3016_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pécheur, coupable</text></gloss>
      <gloss lang="en"><text>sinful, guilty; sinner</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 24 occurrences, first EXO.34.7</text></form></note>
  </entry>
  <entry id="lahɔl_3017">
    <lexical-unit><form lang="kqs"><text>lahɔl</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>rahɔl</text></form></variant>
    <sense id="lahɔl_3017_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réveiller</text></gloss>
      <gloss lang="en"><text>wake up</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 45: rahɔl</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit rahɔl. La Bible a lahɔl dans d'autres emplois (« o lahɔl », GEN.27.1) ; sens à vérifier.</text></form></note>
  </entry>
  <entry id="lakafaa_3018">
    <lexical-unit><form lang="kqs"><text>lakafaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lakafaa_3018_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>injuste, trompeur, faux ; illégal</text></gloss>
      <gloss lang="en"><text>unjust, deceitful, false; illegal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first PSA.43.1; Terminologie (idéologie), n° 352: Vana lakafaa</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, idéologie n° 352, 361) : vana lakafaa « injuste » ; lakafaa « illégal » (aussi sulantoo). Cf. kafalan « injustice ».</text></form></note>
  </entry>
  <entry id="lákàsí_3019">
    <lexical-unit><form lang="kqs"><text>lákàsí</text></form></lexical-unit>
