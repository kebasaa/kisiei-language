      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 3: bakala</text></form></note>
    <note><form lang="fr"><text>Paulme : région de Fangamadou.</text></form></note>
  </entry>
