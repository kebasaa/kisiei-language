  </entry>
  <entry id="sɔlɔlan_3154">
    <lexical-unit><form lang="kqs"><text>sɔlɔlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sɔlɔlan_3154_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>confesser, avouer (ses fautes)</text></gloss>
      <gloss lang="en"><text>confess (one's sins)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first GEN.41.9</text></form></note>
  </entry>
  <entry id="sɔ̀lɔ́ŋndó_3155">
    <lexical-unit><form lang="kqs"><text>sɔ̀lɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sɔ̀lɔ́ŋndó_3155_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe à feuilles coupantes (pour couvrir les toits)</text></gloss>
      <gloss lang="en"><text>sharp-bladed grass used for thatching</text></gloss>
