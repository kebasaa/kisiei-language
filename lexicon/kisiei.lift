    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Kpekpeyangaa; Lexique kissi–français, p. 28: kpekpeyangaa</text></form></note>
  </entry>
  <entry id="kpeku_1853">
    <lexical-unit><form lang="kqs"><text>kpeku</text></form></lexical-unit>
