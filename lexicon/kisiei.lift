  <entry id="ɲàmàá_4149">
    <lexical-unit><form lang="kqs"><text>ɲàmàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ɲàmàláŋ</text></form></field>
    <variant><form lang="kqs"><text>ɲàmáá</text></form></variant>
    <sense id="ɲàmàá_4149_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chance, bonne fortune, charme (surtout d'un homme auprès des femmes)</text></gloss>
      <gloss lang="en"><text>luck, good fortune, appeal (especially of a man to women)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 274: ɲàmàá</text></form></note>
    <note><form lang="fr"><text>Cf. peut-être ɲamaa, ɲamaka (Bible : grandeur, éclat).</text></form></note>
  </entry>
