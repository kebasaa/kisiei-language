      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aider, faire boire (un petit enfant)</text></gloss>
      <gloss lang="en"><text>help, give to drink (esp. a small child)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 180: kòsìó</text></form></note>
  </entry>
  <entry id="kosion_1470">
    <lexical-unit><form lang="kqs"><text>kosion</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kosion_1470_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cubes de bouillon</text></gloss>
      <gloss lang="en"><text>bouillon cubes</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bouillon cube; chicken soup</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 126: kosion; Childs 2000, p. 180: kósíéí kósíóŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel. Keita (p. 126) : bɛlɔɔ cua kosion o bɔlɔɔ nin « le rat a pris les cubes de bouillon dans le sac ».</text></form></note>
  </entry>
  <entry id="kòtòkpàkpéɛ́yó_1471">
