    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 4: bááŋtɔ́kpùá</text></form></note>
  </entry>
  <entry id="baaɲinaa_56">
    <lexical-unit><form lang="kqs"><text>baaɲinaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="baaɲinaa_56_s1">
