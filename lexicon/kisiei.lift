  <entry id="yɛlen_4030">
    <lexical-unit><form lang="kqs"><text>yɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="yɛlen_4030_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haine, animosité (tol X yɛlen « haïr X » ; yɛlen tollo « persécution, être persécuté »)</text></gloss>
      <gloss lang="en"><text>hatred, animosity (tol X yɛlen 'hate X'; yɛlen tollo 'persecution, be persecuted')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hatred, bad feelings; (yɛ̀lɛ̀-tùlààléŋ) persecution</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.26.27; Childs 2000, p. 404: yɛ̀léŋ</text></form></note>
    <note><form lang="fr"><text>O co niaa le tol-la yɛlen « vous me haïssiez » (GEN.26.27) ; vanaa co yɛlen tollo « ceux qui sont persécutés » (MAT.5.10) ; vanaa co ya yɛlen tollo-a « mes persécuteurs » (PSA.7.2).</text></form></note>
  </entry>
