    <sense id="yeela_3837_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>bon, agréable (au goût)</text></gloss>
      <gloss lang="en"><text>good, pleasant (to eat)</text></gloss>
