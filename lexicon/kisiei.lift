    <sense id="fuulaa_921_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>souffler (le feu, avec un soufflet)</text></gloss>
      <gloss lang="en"><text>blow (a fire, with bellows)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.54.16; Childs 2000, p. 114: fùùlàá</text></form></note>
    <note><form lang="fr"><text>o co yinnden fuulaa « il souffle sur le feu » (ISA.54.16) ; kùùlan la co fuulaa tuŋ « le soufflet souffle avec force » (JER.6.29).</text></form></note>
  </entry>
  <entry id="fùùlóó_922">
    <lexical-unit><form lang="kqs"><text>fùùlóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùùlúláŋ</text></form></field>
