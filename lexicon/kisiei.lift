    <variant><form lang="kqs"><text>mayoomulan</text></form></variant>
    <sense id="mayoomoo_1098_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fort, puissant ; fortifié ; (mayoomu) force</text></gloss>
      <gloss lang="en"><text>strong, mighty; fortified; (mayoomu) strength</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first EXO.32.11</text></form></note>
    <note><form lang="fr"><text>fonda mayoomoo « forteresse, refuge » ; kobila mayoomulan « villes fortifiées ».</text></form></note>
