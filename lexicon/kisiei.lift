      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be able, can; overcome (someone)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JDG.16.19; Childs 2000, p. 264: nɔ̀lâá</text></form></note>
  </entry>
