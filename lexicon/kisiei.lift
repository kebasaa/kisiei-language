    <lexical-unit><form lang="kqs"><text>yɛnguo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛngu</text></form></variant>
    <sense id="yɛnguo_4903_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire pencher</text></gloss>
      <gloss lang="en"><text>tilt, make lean</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yɛnguo/ yɛngu</text></form></note>
  </entry>
  <entry id="yɛngɔnndo_4904">
    <lexical-unit><form lang="kqs"><text>yɛngɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛngun</text></form></variant>
    <sense id="yɛngɔnndo_4904_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pencher, se pencher</text></gloss>
      <gloss lang="en"><text>lean, tilt</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: [yɛ]ngɔnndo/ yɛngun</text></form></note>
    <note><form lang="fr"><text>Moyen de yɛnguo « faire pencher ».</text></form></note>
  </entry>
  <entry id="yɛngɛsɛɛ_4905">
    <lexical-unit><form lang="kqs"><text>yɛngɛsɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛngɛsɛɛ_4905_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>entier, complet ; tel quel (palɛi ndii yáá yɛngɛsɛɛ « trois jours entiers ») ; complètement</text></gloss>
      <gloss lang="en"><text>whole, full, entire; just as it was; completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.29.14; Lexique kissi–français, p. 65: yɛngɛsɛ</text></form></note>
    <note><form lang="fr"><text>paangei yɛngɛsɛɛ « un mois entier » (GEN.29.14) ; má mɛi dɔ́ɔ́ngɔ́ɔ̀ lende yɛngɛsɛɛ « ils laissèrent le camp tel quel » (2KI.7.7). Le Lexique kissi–français (p. 65) écrit yɛngɛsɛ « complètement ».</text></form></note>
  </entry>
