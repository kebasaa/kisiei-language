      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tortiller (comme un serpent)</text></gloss>
      <gloss lang="en"><text>wriggle (like a snake), squirm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 224: làùwó</text></form></note>
