      <gloss lang="fr"><text>(s'effondrer) complètement, en morceaux</text></gloss>
      <gloss lang="en"><text>(collapse, break up) completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 244: méŋèlěŋ</text></form></note>
  </entry>
  <entry id="mi_2252">
