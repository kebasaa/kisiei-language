  <entry id="volio_3638">
    <lexical-unit><form lang="kqs"><text>volio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>voli</text></form></variant>
    <variant><form lang="kqs"><text>volinin</text></form></variant>
    <sense id="volio_3638_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briller, étinceler ; (éclair) jaillir (piɔɔ voli « l'éclair brille »)</text></gloss>
      <gloss lang="en"><text>shine, flash; (of lightning) flash</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) lightning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first EXO.19.16; Childs 2000, p. 388: wòlìwòlìóó</text></form></note>
    <note><form lang="fr"><text>piɔɔ-volia « les éclairs » (JOB.37.11).</text></form></note>
  </entry>
  <entry id="volion_3639">
    <lexical-unit><form lang="kqs"><text>volion</text></form></lexical-unit>
