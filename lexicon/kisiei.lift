    <sense id="fúlùkpàtà_1043_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en glissant et en tombant</text></gloss>
      <gloss lang="en"><text>slipping and falling over</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 112: fúlùkpàtà</text></form></note>
