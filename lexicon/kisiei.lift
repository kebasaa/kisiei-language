    <trait name="status" value="southern"/>
    <sense id="fùùndàá_923_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>inhaler, priser ; couper le riz (à la faucille, par grosses poignées)</text></gloss>
      <gloss lang="en"><text>inhale, snort (snuff); cut rice (with a sickle, in large clumps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.1 Breathe, breath"/>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 115: fùùndàá</text></form></note>
