    <note type="source"><form lang="en"><text>Childs 2000, p. 416: yùfúáánɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yufɛ-yufɛ_4807">
    <lexical-unit><form lang="kqs"><text>yufɛ-yufɛ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yufɛ-yufɛ_4807_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>trop sucré, écœurant</text></gloss>
      <gloss lang="en"><text>sickly sweet, nauseating</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: [y]ufɛ-yufɛ</text></form></note>
  </entry>
  <entry id="yúkòó_4808">
    <lexical-unit><form lang="kqs"><text>yúkòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yúkùá</text></form></field>
    <sense id="yúkòó_4808_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>neveu</text></gloss>
      <gloss lang="en"><text>nephew</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 416: yúkòó</text></form></note>
  </entry>
  <entry id="yulalen_4809">
    <lexical-unit><form lang="kqs"><text>yulalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yulale</text></form></variant>
    <sense id="yulalen_4809_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>commerce, négoce (tosa yulalen « faire du commerce »)</text></gloss>
      <gloss lang="en"><text>trade, commerce (tosa yulalen 'trade')</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first GEN.23.16; Lexique kissi–français, p. 67: yulalen</text></form></note>
    <note><form lang="fr"><text>Cf. yulanɔɔ « commerçant ».</text></form></note>
  </entry>
  <entry id="yulan-yulanndo_4810">
    <lexical-unit><form lang="kqs"><text>yulan-yulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yulan-yulan</text></form></variant>
    <variant><form lang="kqs"><text>yulan-yulanndan</text></form></variant>
    <sense id="yulan-yulanndo_4810_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tremblement, épouvante, trouble</text></gloss>
      <gloss lang="en"><text>trembling, terror, confusion</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.26.16</text></form></note>
    <note><form lang="fr"><text>yɔŋnun yulan-yulan « être saisi de tremblement » (EXO.15.15).</text></form></note>
  </entry>
  <entry id="yulanɔɔ_4811">
    <lexical-unit><form lang="kqs"><text>yulanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="yulanɔɔ_4811_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>commerçant, marchand</text></gloss>
      <gloss lang="en"><text>trader, merchant</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.9.4 Commerce"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.24.2; Keita 1979, p. 145: Yulanöö; Lexique kissi–français, p. 67: yulanɔɔ</text></form></note>
  </entry>
  <entry id="yùléŋ_4812">
    <lexical-unit><form lang="kqs"><text>yùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yùléŋ_4812_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce) à sève rouge (sert à affaiblir les boas)</text></gloss>
      <gloss lang="en"><text>tree species with red sap (used to weaken boas)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 416: yùléŋ</text></form></note>
  </entry>
  <entry id="yuliaa_4813">
    <lexical-unit><form lang="kqs"><text>yuliaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yulia</text></form></variant>
    <sense id="yuliaa_4813_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éparpiller (la braise pour l'éteindre)</text></gloss>
      <gloss lang="en"><text>scatter (embers to damp the fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 68: yuriaa/ yuria</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yulianndo_4814">
    <lexical-unit><form lang="kqs"><text>yulianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yulian</text></form></variant>
    <sense id="yulianndo_4814_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rouler par terre</text></gloss>
      <gloss lang="en"><text>roll on the ground</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 68: yuriannndo/ yurian</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit yuriannndo (avec trois n) et r.</text></form></note>
  </entry>
  <entry id="yulu_4815">
    <lexical-unit><form lang="kqs"><text>yulu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yulu_4815_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre (la main, le bâton)</text></gloss>
      <gloss lang="en"><text>stretch out (the hand, a staff)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smoke out; point at; be patient; stretch</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.7.19; Childs 2000, p. 416: yùlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yulul_4816">
    <lexical-unit><form lang="kqs"><text>yulul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yulul_4816_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, bander (l'arc) vers ; viser</text></gloss>
      <gloss lang="en"><text>draw, aim (a bow) at</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smoke out, point (at) for someone; be patient</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.7.13; Childs 2000, p. 416: yùlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de yulu. o yulul ndu kpaasiaa « il bande son arc contre lui » (PSA.7.13).</text></form></note>
  </entry>
  <entry id="yulullo_4817">
    <lexical-unit><form lang="kqs"><text>yulullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yulul</text></form></variant>
    <sense id="yulullo_4817_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>indiquer, pointer (du bras, du doigt)</text></gloss>
      <gloss lang="en"><text>point (with the arm, finger)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 68: yurullo/ yurul</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r. La Bible a yulul une fois, en parlant de bander l'arc (PSA.7.13) ; à comparer.</text></form></note>
  </entry>
  <entry id="yúlúlló_4818">
    <lexical-unit><form lang="kqs"><text>yúlúlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yúlúlló_4818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>champignon comestible (espèce) à longue racine</text></gloss>
      <gloss lang="en"><text>edible mushroom species with a long root</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 416: yúlúlló</text></form></note>
  </entry>
  <entry id="yulunnde_4819">
    <lexical-unit><form lang="kqs"><text>yulunnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yulunnde_4819_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheveux blancs ; vieillesse</text></gloss>
      <gloss lang="en"><text>grey hair; old age</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.15.10; Lexique kissi–français, p. 67: yulunnde; Childs 2000, p. 416: yùlúŋndé</text></form></note>
  </entry>
  <entry id="yulɔɔ_4820">
    <lexical-unit><form lang="kqs"><text>yulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yulɔɔ_4820_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supporter, endurer ; être patient ; patience</text></gloss>
      <gloss lang="en"><text>bear, endure; be patient; patience</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4 Body condition"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>smoke out; point at; be patient, withstand pain; stretch</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 1TH.3.1; Lexique kissi–français, p. 68: yurɔɔ/ yuru; Childs 2000, p. 416: yùlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Toujours négatif : n tiw lɛ ba cum kon yulɔɔ le « ne pouvant plus supporter (l'attente) » (1TH.3.1, 1TH.3.5). Cf. yulu « tendre ». Lexique kissi–français, p. 67-68 : yurɔɔ/ yuru « supporter, être patient » ; yulɔɔ et yuuloo « la patience ».</text></form></note>
  </entry>
  <entry id="yulɔɔ_4821">
    <lexical-unit><form lang="kqs"><text>yulɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>yul</text></form></variant>
    <sense id="yulɔɔ_4821_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>moisir, s'étendre (moisissure)</text></gloss>
      <gloss lang="en"><text>go mouldy, spread (of mildew)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yulɔɔ/ yul</text></form></note>
    <note><form lang="fr"><text>Le Lexique hésite : « devenir moisi ? ». La Bible a yul à propos de la moisissure d'un vêtement ou d'une maison (LEV.13.55, LEV.14.44). Homographe de yulɔɔ « supporter ».</text></form></note>
  </entry>
  <entry id="yumbuyumboo_4822">
    <lexical-unit><form lang="kqs"><text>yumbuyumboo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yumbuyumbu</text></form></variant>
    <sense id="yumbuyumboo_4822_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nuage, nuages ; nuage, nuée</text></gloss>
      <gloss lang="en"><text>cloud, clouds</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fog</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 61 occurrences, first GEN.9.14; Keita 1979, p. 154: Yumyumbuo; Lexique kissi–français, p. 67: yumyunbuo; Childs 2000, p. 417: yúmbúyúmbóó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Yumyumbuo ; la Bible yumbuyumboo.</text></form></note>
  </entry>
  <entry id="yungaa_4823">
    <lexical-unit><form lang="kqs"><text>yungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yunga</text></form></variant>
    <variant><form lang="kqs"><text>yunganin</text></form></variant>
    <sense id="yungaa_4823_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piller, dépouiller ; plumer</text></gloss>
      <gloss lang="en"><text>plunder, despoil, strip; pluck (a bird)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ZEC.2.12; Lexique kissi–français, p. 67: yungaa/ yunga</text></form></note>
    <note><form lang="fr"><text>má yunga ndu « ils le dépouillèrent » (GEN.37.23). Lexique kissi–français, p. 67 : yungaa/ yunga « plumer ».</text></form></note>
  </entry>
  <entry id="yungoo_4824">
    <lexical-unit><form lang="kqs"><text>yungoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yungulan</text></form></field>
    <variant><form lang="kqs"><text>yungu</text></form></variant>
    <variant><form lang="kqs"><text>yungula</text></form></variant>
    <sense id="yungoo_4824_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>famille, maisonnée ; gens (d'un lieu) ; peuple</text></gloss>
      <gloss lang="en"><text>family, household; people (of a place) ; family, household; people, nation</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>family, household; also a cooking tripod, hearth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first GEN.13.13; Keita 1979, p. 134: Yunguo; Lexique kissi–français, p. 67: yunguo; Childs 2000, p. 417: yúŋɔ́ɔ́</text></form></note>
    <note><form lang="fr"><text>yungoo Madian « les Madianites » (Nb 31,2). Le Lexique kissi–français (p. 67) écrit yunguo « la famille ; la tribu ».</text></form></note>
  </entry>
  <entry id="yungullen_4825">
    <lexical-unit><form lang="kqs"><text>yungullen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yungullen_4825_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tête rasée</text></gloss>
      <gloss lang="en"><text>shaved head</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yungullen</text></form></note>
  </entry>
  <entry id="yunguo_4826">
    <lexical-unit><form lang="kqs"><text>yunguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yunguo_4826_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>blanc d'œuf ; pomme de terre, patate</text></gloss>
      <gloss lang="en"><text>egg white; potato, sweet potato</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yunguo</text></form></note>
    <note><form lang="fr"><text>Sens hétérogènes dans le Lexique ; à vérifier. Homographe de yunguo « famille » (yungoo).</text></form></note>
  </entry>
  <entry id="yungɔɔ_4827">
    <lexical-unit><form lang="kqs"><text>yungɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yungɔɔ_4827_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nasse (piège pour souris ou poisson)</text></gloss>
      <gloss lang="en"><text>trap for mice or fish</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 67: yungɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique : piège « dans lequel une souris ou un poisson peut entrer mais ne peut pas sortir ».</text></form></note>
  </entry>
  <entry id="yúnɛ̀ɛ̀_4828">
    <lexical-unit><form lang="kqs"><text>yúnɛ̀ɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yúnɛ̀ɛ̀_4828_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(son entendu de très loin)</text></gloss>
      <gloss lang="en"><text>(sound heard from far away)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 417: yúnɛ̀ɛ̀</text></form></note>
  </entry>
  <entry id="yusuŋaa_4829">
    <lexical-unit><form lang="kqs"><text>yusuŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yusuŋa</text></form></variant>
    <sense id="yusuŋaa_4829_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'agiter ; reculer ; ruer (dans l'agonie)</text></gloss>
      <gloss lang="en"><text>thrash about; recoil; kick (when dying)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 68: yusuŋaa/ yusuŋa</text></form></note>
  </entry>
  <entry id="yuuloo_4830">
    <lexical-unit><form lang="kqs"><text>yuuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="yuuloo_4830_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chiffon ; sac (de deuil)</text></gloss>
      <gloss lang="en"><text>rag; sackcloth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.6.26; Lexique kissi–français, p. 68: yuuloo</text></form></note>
    <note><form lang="fr"><text>yiinun yala yuuloo « ceins-toi d'un sac » (JER.6.26). Le Lexique donne aussi yuruo « un chiffon ; en lambeaux » (p. 68) et yuuloo « la patience » (cf. yulɔɔ « supporter »).</text></form></note>
  </entry>
  <entry id="yuuluo_4831">
    <lexical-unit><form lang="kqs"><text>yuuluo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yuululan</text></form></field>
    <sense id="yuuluo_4831_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chiffon, haillon</text></gloss>
      <gloss lang="en"><text>rag</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Yuuluo; Childs 2000, p. 417: yùùlóó</text></form></note>
    <note><form lang="fr"><text>Pluriel attesté : volɔɔla yuululan « vêtements usés, haillons » (Jos 9,5 ; 2 S 3,31).</text></form></note>
  </entry>
  <entry id="yùùlútààmɔ̀ɔ́_4832">
    <lexical-unit><form lang="kqs"><text>yùùlútààmɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yùùlútààmɔ̀ɔ́_4832_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>linge des femmes pendant les règles</text></gloss>
      <gloss lang="en"><text>cloth worn by women during menstruation</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 418: yùùlútààmɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yuunda_4833">
    <lexical-unit><form lang="kqs"><text>yuunda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yuunda_4833_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retirer, enlever (les vêtements à qqn), dépouiller</text></gloss>
      <gloss lang="en"><text>take away, strip off (someone's clothes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>remove or strip, scrape clean</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first HOS.2.11; Childs 2000, p. 418: yùùndàá</text></form></note>
    <note><form lang="fr"><text>kola ni ... va ndu siɛmbulan kumbɔɔ-o yuunda « je lui reprendrai ma laine et mon lin qui couvraient sa nudité » (HOS.2.11). Une seule attestation.</text></form></note>
  </entry>
