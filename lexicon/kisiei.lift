      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand-mère ; aïeule</text></gloss>
      <gloss lang="en"><text>grandmother; ancestress</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grandmother, old woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.24.60; Keita 1979, p. 134: Kalamamaa; Childs 2000, p. 241: màmá</text></form></note>
