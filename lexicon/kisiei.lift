      <gloss lang="fr"><text>coton ; lin</text></gloss>
      <gloss lang="en"><text>cotton; flax</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cotton; cotton thread, cotton cloth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.9.31; Keita 1979, p. 139: Funnden; Childs 2000, p. 113: fùŋndéŋ</text></form></note>
    <note><form lang="fr"><text>La Bible l'emploie pour le lin (EXO.9.31).</text></form></note>
