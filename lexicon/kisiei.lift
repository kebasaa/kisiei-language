    <note><form lang="fr"><text>Le pourpre est sɔɔtɔtɔɔ (Mc 15,17) ; vólotótoo est l'écarlate (Ap 17,4).</text></form></note>
  </entry>
  <entry id="volɔɔ_1841">
    <lexical-unit><form lang="kqs"><text>volɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>volɔɔlan</text></form></field>
    <variant><form lang="kqs"><text>volɔɔla</text></form></variant>
    <sense id="volɔɔ_1841_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charge, fardeau ; vêtement, habit (volɔɔ cuɛinan « vêtement »)</text></gloss>
      <gloss lang="en"><text>load, burden; garment, clothing (volɔɔ cuɛinan 'garment')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tool, implement; (pl.) loads</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first LEV.11.32; Childs 2000, p. 388: wòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>volɔɔla « charges » (GEN.24.32) et « vêtements » (LEV.19.19) ; volɔɔ lusulaa « joug pesant » (1KI.12.14).</text></form></note>
  </entry>
  <entry id="vóólun-vóólunndo_1842">
    <lexical-unit><form lang="kqs"><text>vóólun-vóólunndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vóólun-vóólun</text></form></variant>
    <variant><form lang="kqs"><text>vóólun-vóólunn</text></form></variant>
    <sense id="vóólun-vóólunndo_1842_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, clameur</text></gloss>
      <gloss lang="en"><text>tumult, uproar, clamour</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(base verb) start from fright, tremble with fear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first EZK.12.18; Childs 2000, p. 389: wòòlòó</text></form></note>
    <note><form lang="fr"><text>Cf. vooluo « tressaillir ».</text></form></note>
  </entry>
  <entry id="vooluo_1843">
    <lexical-unit><form lang="kqs"><text>vooluo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>voolu</text></form></variant>
    <variant><form lang="kqs"><text>voolunin</text></form></variant>
    <sense id="vooluo_1843_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tressaillir ; surprendre, fondre sur</text></gloss>
      <gloss lang="en"><text>startle; take by surprise, fall upon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Vooluo</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, voolu signifie « fondre sur, attaquer par surprise » (JOS 10,9).</text></form></note>
  </entry>
  <entry id="voosanndo_1844">
    <lexical-unit><form lang="kqs"><text>voosanndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="voosanndo_1844_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entorse</text></gloss>
      <gloss lang="en"><text>sprain</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: Voosanndo</text></form></note>
  </entry>
  <entry id="voosu_1845">
    <lexical-unit><form lang="kqs"><text>voosu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>voosun</text></form></variant>
    <sense id="voosu_1845_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>figue</text></gloss>
      <gloss lang="en"><text>fig</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fig tree; also a fern-like plant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first NUM.20.5; Childs 2000, p. 389: wòòsóó</text></form></note>
    <note><form lang="fr"><text>voosu tumndo « figuier ».</text></form></note>
  </entry>
  <entry id="vownun_1846">
    <lexical-unit><form lang="kqs"><text>vownun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vownun_1846_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre, revêtir (vêtement, sandales)</text></gloss>
      <gloss lang="en"><text>put on (clothes, sandals)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 93 occurrences, first EXO.12.11; Childs 2000, p. 390: wòùwó</text></form></note>
    <note><form lang="fr"><text>Moyen de vowvo.</text></form></note>
  </entry>
  <entry id="vowvo_1847">
    <lexical-unit><form lang="kqs"><text>vowvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vow</text></form></variant>
    <variant><form lang="kqs"><text>vownin</text></form></variant>
    <sense id="vowvo_1847_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre dans, verser dans</text></gloss>
      <gloss lang="en"><text>put into, pour into</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>put on, wear, fasten</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first GEN.42.25; Childs 2000, p. 390: wòùwó</text></form></note>
  </entry>
  <entry id="vueinɔnndo_1848">
    <lexical-unit><form lang="kqs"><text>vueinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vueinun</text></form></variant>
    <variant><form lang="kqs"><text>vueinunnin</text></form></variant>
    <variant><form lang="kqs"><text>vueinɔn</text></form></variant>
    <sense id="vueinɔnndo_1848_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>effrayer, inspirer la terreur ; être redoutable</text></gloss>
      <gloss lang="en"><text>frighten, terrify; be fearsome</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be afraid (middle of 'fear'); variant wèènɔ̌ŋndó, also 'frighten people'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1CH.12.9; Childs 2000, p. 389: wɔ̀ɔ́nɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Cf. vo « craindre ». mɛ̀ɛ́-mɛ̀ɛ́ ya vueinun « ne me crains pas » (JOB.33.7).</text></form></note>
  </entry>
  <entry id="vuiyo_1849">
    <lexical-unit><form lang="kqs"><text>vuiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vuiya</text></form></field>
    <sense id="vuiyo_1849_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voleur</text></gloss>
      <gloss lang="en"><text>thief</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.22.1; Keita 1979, p. 149: Vuiyo; Childs 2000, p. 385: wììnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vukɔɔ_1850">
    <lexical-unit><form lang="kqs"><text>vukɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="vukɔɔ_1850_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu où se règlent les affaires du village</text></gloss>
      <gloss lang="en"><text>village meeting place for settling disputes</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Vuköö</text></form></note>
  </entry>
  <entry id="vulan_1851">
    <lexical-unit><form lang="kqs"><text>vulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vulan_1851_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genoux</text></gloss>
      <gloss lang="en"><text>knees</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>knee (singular, le class)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.17.3; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>baŋ vulan « s'agenouiller, se prosterner » (Gn 17,3).</text></form></note>
  </entry>
  <entry id="vulen_1852">
    <lexical-unit><form lang="kqs"><text>vulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>vulan</text></form></field>
    <sense id="vulen_1852_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>genou</text></gloss>
      <gloss lang="en"><text>knee</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Vulen; Childs 2000, p. 392: wùléŋ</text></form></note>
    <note><form lang="fr"><text>Pluriel vulan attesté : baŋ vulan « s'agenouiller » (Gn 17,3).</text></form></note>
  </entry>
  <entry id="vulɔɔ_1853">
    <lexical-unit><form lang="kqs"><text>vulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vul</text></form></variant>
    <variant><form lang="kqs"><text>vulnin</text></form></variant>
    <sense id="vulɔɔ_1853_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, germer</text></gloss>
      <gloss lang="en"><text>grow, sprout</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: thread a needle</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first GEN.3.18; Childs 2000, p. 392: wùlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vum_1854">
    <lexical-unit><form lang="kqs"><text>vum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vum_1854_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) d'un coup, brusquement (cœur qui bat, feu qui jaillit)</text></gloss>
      <gloss lang="en"><text>(ideophone) suddenly, with a start (pounding heart, fire flaring up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sound of slow regular beating (heartbeat), of a fire being lit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.27.33; Childs 2000, p. 392: wúm</text></form></note>
  </entry>
  <entry id="vunduan_1855">
    <lexical-unit><form lang="kqs"><text>vunduan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vunduma</text></form></variant>
    <sense id="vunduan_1855_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre, ombrage (pluriel de vundulen)</text></gloss>
      <gloss lang="en"><text>shade, shadows (plural of vundulen)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural (ma) of 'shade, shadow'; also the soul, an umbrella, an illustration</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first JOB.7.2; Childs 2000, p. 393: wùndúléŋ</text></form></note>
  </entry>
  <entry id="vundulen_1856">
    <lexical-unit><form lang="kqs"><text>vundulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="vundulen_1856_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ombre ; vision</text></gloss>
      <gloss lang="en"><text>shadow, shade; vision</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shade, shadow; the soul of a person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 46 occurrences, first GEN.15.1; Keita 1979, p. 155: Vundulen; Childs 2000, p. 393: wùndúléŋ</text></form></note>
  </entry>
  <entry id="vuo_1857">
    <lexical-unit><form lang="kqs"><text>vuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vu</text></form></variant>
    <variant><form lang="kqs"><text>vunin</text></form></variant>
    <variant><form lang="kqs"><text>vi</text></form></variant>
    <variant><form lang="kqs"><text>vinin</text></form></variant>
    <sense id="vuo_1857_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mourir</text></gloss>
      <gloss lang="en"><text>die</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 92 occurrences, first GEN.43.8; Keita 1979, p. 115: Vuo; Childs 2000, p. 393: wùó</text></form></note>
    <note><form lang="fr"><text>vi, vinin : radical négatif (EXO 9,4).</text></form></note>
  </entry>
  <entry id="vuuo_1858">
    <lexical-unit><form lang="kqs"><text>vuuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuu</text></form></variant>
    <sense id="vuuo_1858_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>jeter, lancer</text></gloss>
      <gloss lang="en"><text>throw, cast</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>throw (e.g. with a sling); thatch a roof; shoot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first GEN.21.20; Childs 2000, p. 393: wùùwó</text></form></note>
    <note><form lang="fr"><text>vana caa kpaasiaa vuuo « archer » (Gn 21,20).</text></form></note>
  </entry>
  <entry id="vuɛɛndo_1859">
    <lexical-unit><form lang="kqs"><text>vuɛɛndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vuɛɛn</text></form></variant>
    <sense id="vuɛɛndo_1859_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme (adulte) ; (vocatif) femme !</text></gloss>
      <gloss lang="en"><text>woman; (vocative) woman!</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 20 occurrences, first RUT.3.16</text></form></note>
    <note><form lang="fr"><text>vuɛɛn bala fondo pɔnɔɔ vi-o « une pauvre veuve » (MRK.12.42).</text></form></note>
  </entry>
  <entry id="vɔ_1860">
    <lexical-unit><form lang="kqs"><text>vɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vɔ_1860_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>pas encore (vɔ … le)</text></gloss>
      <gloss lang="en"><text>not yet (vɔ … le)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'still, already'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 977 occurrences, first GEN.2.5; Childs 2000, p. 390: wɔ̀</text></form></note>
  </entry>
  <entry id="vɔkɔ-vɔkɔɔ_1861">
    <lexical-unit><form lang="kqs"><text>vɔkɔ-vɔkɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔ</text></form></variant>
    <variant><form lang="kqs"><text>vɔkɔ-vɔkɔlan</text></form></variant>
    <sense id="vɔkɔ-vɔkɔɔ_1861_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tumulte, vacarme, agitation</text></gloss>
      <gloss lang="en"><text>uproar, commotion, din</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first PSA.2.1</text></form></note>
    <note><form lang="fr"><text>Ko vɔkɔ-vɔkɔ bɛndu yɛɛ nɛ co yɛ hoo ? « Pourquoi ce grand tumulte ? » (1KI.1.41).</text></form></note>
  </entry>
  <entry id="vɔlɔtɔɔ_1862">
    <lexical-unit><form lang="kqs"><text>vɔlɔtɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vɔlɔtɔlan</text></form></field>
    <variant><form lang="kqs"><text>vɔlɔtɔ</text></form></variant>
    <sense id="vɔlɔtɔɔ_1862_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faucille</text></gloss>
      <gloss lang="en"><text>sickle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.8 Agricultural tool"/>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.23.26</text></form></note>
  </entry>
  <entry id="vɔlɔɔ_1863">
    <lexical-unit><form lang="kqs"><text>vɔlɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="vɔlɔɔ_1863_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>perdrix</text></gloss>
      <gloss lang="en"><text>partridge</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bush chicken</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1SA.26.20; Keita 1979, p. 137: Völöö; Childs 2000, p. 390: wɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="vɔ̀lɛ́lan_1864">
    <lexical-unit><form lang="kqs"><text>vɔ̀lɛ́lan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔ̀lɛ́la</text></form></variant>
    <sense id="vɔ̀lɛ́lan_1864_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>enclos, parcs (à bétail)</text></gloss>
      <gloss lang="en"><text>folds, pens (for livestock)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.32.16</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="vɔmndo_1865">
    <lexical-unit><form lang="kqs"><text>vɔmndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vɔm</text></form></variant>
