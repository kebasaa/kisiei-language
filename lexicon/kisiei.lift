  <entry id="bii sɔɛi_173">
    <lexical-unit><form lang="kqs"><text>bii sɔɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bii sɔɛi_173_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>obéir</text></gloss>
      <gloss lang="en"><text>obey</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 6: bii sɔɛi</text></form></note>
    <note><form lang="fr"><text>Littéralement « saisir la parole ».</text></form></note>
  </entry>
  <entry id="biilanndo_174">
    <lexical-unit><form lang="kqs"><text>biilanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biilan</text></form></variant>
    <sense id="biilanndo_174_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>coller, être collant, adhérer</text></gloss>
      <gloss lang="en"><text>stick, be sticky, adhere</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DAN.2.43; Lexique kissi–français, p. 6: biilanndo/ biilan</text></form></note>
  </entry>
  <entry id="biiloo_175">
    <lexical-unit><form lang="kqs"><text>biiloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biilu</text></form></variant>
    <variant><form lang="kqs"><text>biilunin</text></form></variant>
    <sense id="biiloo_175_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier, adorer ; honorer, respecter, bien recevoir (un hôte)</text></gloss>
      <gloss lang="en"><text>praise, glorify, worship; honour, respect, receive (a guest) well</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 316 occurrences, first GEN.9.26; Lexique kissi–français, p. 6: biiloo/ biilu</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 6 : biiloo/ biilu « adorer » ; biiluo/ biilu « honorer, respecter, bien recevoir dans la maison ou le village ».</text></form></note>
  </entry>
  <entry id="biilullo_176">
    <lexical-unit><form lang="kqs"><text>biilullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>biilul</text></form></variant>
    <sense id="biilullo_176_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tenir, garder pour quelqu'un ; attraper pour quelqu'un</text></gloss>
      <gloss lang="en"><text>hold, keep for someone; catch for someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 6: biilullo/ biilul</text></form></note>
    <note><form lang="fr"><text>Applicatif de bii. La Bible a la forme courte biilul (JOB.38.39 « chasser une proie pour (la lionne) »).</text></form></note>
  </entry>
  <entry id="biilɔnndo_177">
    <lexical-unit><form lang="kqs"><text>biilɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="biilɔnndo_177_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être glorifié, être loué</text></gloss>
      <gloss lang="en"><text>be glorified, be praised</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.12.5</text></form></note>
    <note><form lang="fr"><text>Moyen de biiloo « louer ».</text></form></note>
  </entry>
  <entry id="bìíndó_178">
    <lexical-unit><form lang="kqs"><text>bìíndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bìíndó_178_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>groupe de travail réciproque sans repas fourni (en période de soudure)</text></gloss>
      <gloss lang="en"><text>reciprocal work group without food provided (in the lean season)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 16: bìíndó</text></form></note>
  </entry>
  <entry id="biinun_179">
    <lexical-unit><form lang="kqs"><text>biinun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biinɔnndo</text></form></variant>
    <sense id="biinun_179_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rattraper, se saisir de</text></gloss>
      <gloss lang="en"><text>overtake, take hold of</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.6 Pursue"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.15.9; Lexique kissi–français, p. 6: biinɔnndo/ biinun</text></form></note>
    <note><form lang="fr"><text>Moyen de bii « saisir ». Lexique kissi–français, p. 6 : biinɔnndo/ biinun « s'entretenir ».</text></form></note>
  </entry>
  <entry id="biisio_180">
    <lexical-unit><form lang="kqs"><text>biisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>biisilan</text></form></field>
    <variant><form lang="kqs"><text>biisi</text></form></variant>
    <sense id="biisio_180_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>deuil, funérailles</text></gloss>
      <gloss lang="en"><text>mourning, funeral</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>funeral arrangements, wake</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first GEN.50.7; Childs 2000, p. 17: bììsììyó</text></form></note>
  </entry>
  <entry id="bìíyó_181">
    <lexical-unit><form lang="kqs"><text>bìíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bìíláŋ</text></form></field>
    <sense id="bìíyó_181_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tas de déchets de coupe (dans un bas-fond rizicole)</text></gloss>
      <gloss lang="en"><text>mound of cuttings (in a rice swamp)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bìíyó</text></form></note>
  </entry>
  <entry id="bìíŋndéŋ_182">
    <lexical-unit><form lang="kqs"><text>bìíŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="bìíŋndéŋ_182_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse aux grenouilles (de nuit)</text></gloss>
      <gloss lang="en"><text>frog hunting (at night)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bìíŋndéŋ</text></form></note>
  </entry>
  <entry id="biiŋoo_183">
    <lexical-unit><form lang="kqs"><text>biiŋoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biiŋuu</text></form></variant>
    <sense id="biiŋoo_183_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>remuer, agiter, secouer ; soulever (une foule) ; frotter (en se lavant) ; exciter, déranger</text></gloss>
      <gloss lang="en"><text>stir, shake, agitate; stir up (a crowd); rub (when washing); excite, disturb</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3 Move something"/>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stir (food while cooking); stir up (fish)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first 1SA.1.13; Lexique kissi–français, p. 6: biŋuo/ biŋu; Childs 2000, p. 19: bìŋìó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français écrit biŋuo/ biŋu « bouger ; frotter comme en prenant un bain ; remuer, exciter, déranger » (p. 6).</text></form></note>
  </entry>
  <entry id="biiŋun_184">
    <lexical-unit><form lang="kqs"><text>biiŋun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biiŋɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>biiŋɔn</text></form></variant>
    <sense id="biiŋun_184_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être secoué, s'agiter, s'émouvoir</text></gloss>
      <gloss lang="en"><text>be shaken, be stirred, toss</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake, quiver (a form of bìŋìó 'stir')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first RUT.1.19; Lexique kissi–français, p. 6: biŋɔnndo/ biŋun; Childs 2000, p. 18: bìŋìáŋ</text></form></note>
    <note><form lang="fr"><text>Moyen de biiŋoo. Le Lexique kissi–français écrit biŋɔnndo/ biŋun « se remuer, s'agiter » (p. 6).</text></form></note>
  </entry>
