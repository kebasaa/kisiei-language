  <entry id="ikɛi_1805">
    <lexical-unit><form lang="kqs"><text>ikɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ikɛi_1805_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>avec, auprès de ; à côté de, contre ; en face de</text></gloss>
      <gloss lang="en"><text>with, beside; beside, against; opposite</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 998 occurrences, first GEN.5.24; Paulme 1964, p. 37: ikɛy; Lexique kissi–français, p. 20: ikɛi; Childs 2000, p. 139: ìkɛ̀í</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 37 : ikɛy « à côté, contre, près de ; en face ».</text></form></note>
  </entry>
  <entry id="ilaasilaasiei_1806">
