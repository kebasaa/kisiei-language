      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 5: bani, ɔbani</text></form></note>
    <note><form lang="fr"><text>Paulme écrit aussi banni.</text></form></note>
