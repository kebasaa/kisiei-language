    <field type="plural"><form lang="kqs"><text>sokoa-vialaa</text></form></field>
    <sense id="sokonɔ-vialaa_3058_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sage-femme, accoucheuse</text></gloss>
      <gloss lang="en"><text>midwife</text></gloss>
