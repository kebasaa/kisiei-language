    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>garden near town, small private farm</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Sèsiei; Childs 2000, p. 328: sɛ̀sɛ́í</text></form></note>
  </entry>
  <entry id="sɛ̀sɛ́ŋgòlló_3211">
