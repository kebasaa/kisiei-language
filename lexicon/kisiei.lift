    <variant><form lang="kqs"><text>bendu</text></form></variant>
    <variant><form lang="kqs"><text>bandunin</text></form></variant>
    <sense id="bandu_64_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être long, haut ; être loin, durer</text></gloss>
      <gloss lang="en"><text>be long, tall; be far, last long</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.2.6 Distance"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.13.17; Childs 2000, p. 7: bàndèì</text></form></note>
    <note><form lang="fr"><text>Négatif bendu : piɔ́m fuɲa naa bendu lɛ le « la mort de mon père n'est pas loin » (Gn 27,41). Cf. bandei « coudée, mesure ».</text></form></note>
  </entry>
