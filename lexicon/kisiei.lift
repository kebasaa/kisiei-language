  </entry>
  <entry id="nɛ̀ɛ́ŋndó_2935">
    <lexical-unit><form lang="kqs"><text>nɛ̀ɛ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
