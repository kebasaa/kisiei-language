      <gloss lang="en"><text>ostrich</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first LEV.11.16; Lexique kissi–français, p. 51: soninkɔnɔɔ</text></form></note>
  </entry>
  <entry id="sonkpallo_4711">
    <lexical-unit><form lang="kqs"><text>sonkpallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sonkpallo_4711_s1">
      <grammatical-info value="Noun"/>
