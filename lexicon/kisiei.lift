      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 267: ndíɛ́mbɔ̀</text></form></note>
  </entry>
  <entry id="ndòndòŋkùó_3691">
    <lexical-unit><form lang="kqs"><text>ndòndòŋkùó</text></form></lexical-unit>
