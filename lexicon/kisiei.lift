    <trait name="status" value="southern"/>
    <sense id="pàɲàá_3000_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>désherber mal, bâcler le désherbage</text></gloss>
      <gloss lang="en"><text>weed improperly</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pàɲàá</text></form></note>
  </entry>
  <entry id="pe_3001">
    <lexical-unit><form lang="kqs"><text>pe</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pe_3001_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>si (après un nom, avec ti)</text></gloss>
      <gloss lang="en"><text>if (after a noun, with ti)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: pe</text></form></note>
    <note><form lang="fr"><text>La Bible a pe (1SA.21.15, JOB.20.20) ; emploi à vérifier.</text></form></note>
  </entry>
  <entry id="peekolaa_3002">
    <lexical-unit><form lang="kqs"><text>peekolaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="peekolaa_3002_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fontaine, source</text></gloss>
      <gloss lang="en"><text>spring, fountain</text></gloss>
