      <gloss lang="en"><text>fence in, enclose; fence, wall</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fence, erect a fence</text></form></field>
