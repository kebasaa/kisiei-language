    <trait name="status" value="attested"/>
    <sense id="kafalan_442_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>injustice</text></gloss>
      <gloss lang="en"><text>injustice</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cheating, deceit, trickery</text></form></field>
