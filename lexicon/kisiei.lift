    <trait name="status" value="attested"/>
    <sense id="len_2043_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce, cette (classe len)</text></gloss>
      <gloss lang="en"><text>this, that (len class)</text></gloss>
