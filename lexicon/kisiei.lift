    <trait name="status" value="respelled"/>
    <sense id="vana lelɛŋndo_5629_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maître de la Terre</text></gloss>
      <gloss lang="en"><text>master of the Land (earth priest)</text></gloss>
