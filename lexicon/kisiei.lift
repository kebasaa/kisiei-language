      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first LEV.15.2; Childs 2000, p. 197: kùsúáŋ</text></form></note>
  </entry>
  <entry id="kusulan_1804">
    <lexical-unit><form lang="kqs"><text>kusulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kusulan_1804_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dégoûter, lasser jusqu'au dégoût</text></gloss>
      <gloss lang="en"><text>disgust, weary to the point of loathing</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.30.10</text></form></note>
    <note><form lang="fr"><text>ceendo kusulan ya « la vie m'a dégoûté » (Qo 2,17).</text></form></note>
  </entry>
  <entry id="kútù-kùtù_1805">
