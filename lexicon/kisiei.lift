  <entry id="dóndóŋkùó_712">
    <lexical-unit><form lang="kqs"><text>dóndóŋkùó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dóndóŋkùá</text></form></field>
    <sense id="dóndóŋkùó_712_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite grenouille verte à ventre rougeâtre</text></gloss>
      <gloss lang="en"><text>small green frog with a reddish belly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 86: dóndóŋkùó</text></form></note>
  </entry>
  <entry id="doolaa_713">
