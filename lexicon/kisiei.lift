    <trait name="status" value="respelled"/>
    <sense id="kpen_2424_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>beaucoup ; (fixer) avec force</text></gloss>
      <gloss lang="en"><text>a lot; (fix) firmly</text></gloss>
