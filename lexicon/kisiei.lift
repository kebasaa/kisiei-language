    <lexical-unit><form lang="kqs"><text>taŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>taŋ</text></form></variant>
    <sense id="taŋɔɔ_5138_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>traverser (un fleuve) ; traverser (un ruisseau)</text></gloss>
      <gloss lang="en"><text>cross (a river); cross (a stream)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.4 Travel"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first EXO.14.17; Lexique kissi–français, p. 54: taŋɔɔ/ taŋɔɔ; Childs 2000, p. 349: tàŋɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="taɛin_5139">
    <lexical-unit><form lang="kqs"><text>taɛin</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="taɛin_5139_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>au milieu, parmi</text></gloss>
      <gloss lang="en"><text>in the middle, among</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.5 Middle"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 103: taye, tayɛ̃, kay, ɔ kay; Lexique kissi–français, p. 53: taɛin</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 103 : taye, tayɛ̃ « entre, au milieu de » (ɔ nɛyɔ taye « au milieu de la route ») ; aussi kay.</text></form></note>
  </entry>
  <entry id="te_5140">
    <lexical-unit><form lang="kqs"><text>te</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="te_5140_s1">
      <grammatical-info value="Connective"/>
      <gloss lang="fr"><text>si (te … pɛ)</text></gloss>
      <gloss lang="en"><text>if (te … pɛ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.5 Conjunctions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>if, when</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7156 occurrences, first GEN.3.3; Lexique kissi–français, p. 53: ta; Childs 2000, p. 350: tè … pɛ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 53 : ta « si » ; p. 55 : ti, ti … pɛ « si ».</text></form></note>
  </entry>
  <entry id="te_5141">
    <lexical-unit><form lang="kqs"><text>te</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="te_5141_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>ne … pas (négation)</text></gloss>
      <gloss lang="en"><text>not (negation)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 54: te</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « pas (neg) ». Dans la Bible, te est surtout « si » ; la négation finale est le. À confirmer.</text></form></note>
  </entry>
  <entry id="té-é-é_5142">
    <lexical-unit><form lang="kqs"><text>té-é-é</text></form></lexical-unit>
