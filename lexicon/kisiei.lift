    <trait name="status" value="attested"/>
    <sense id="tɛɛmbua_1756_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>destructeur</text></gloss>
      <gloss lang="en"><text>destroying, destroyer</text></gloss>
