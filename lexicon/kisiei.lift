      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être rassasié, avoir assez (bu) ; (pimi) faire boire, rassasier</text></gloss>
      <gloss lang="en"><text>be satisfied, have enough (to drink); (pimi) give to drink, satisfy</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
