    <trait name="status" value="southern"/>
    <sense id="wàdì_3698_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(chute lourde ; en masse, en abondance)</text></gloss>
      <gloss lang="en"><text>(heavy falling; en masse, plentifully)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 378: wàdì</text></form></note>
