  </entry>
  <entry id="yalahiniaa_5962">
    <lexical-unit><form lang="kqs"><text>yalahiniaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yalahiniaa_5962_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hamac</text></gloss>
      <gloss lang="en"><text>hammock</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: yalahiniaa</text></form></note>
  </entry>
  <entry id="yàlàkánáá_5963">
    <lexical-unit><form lang="kqs"><text>yàlàkánáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàlàkánáá_5963_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lion</text></gloss>
      <gloss lang="en"><text>lion</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàlàkánáá</text></form></note>
    <note><form lang="fr"><text>Variante méridionale ; la Bible et Keita ont yàlàá « lion ».</text></form></note>
  </entry>
  <entry id="yalalen_5964">
    <lexical-unit><form lang="kqs"><text>yalalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="yalalen_5964_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tromperie (en paroles), fourberie</text></gloss>
      <gloss lang="en"><text>deceit (in speech), treachery</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gossip, slander</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first AMO.7; Childs 2000, p. 397: yàlàléŋ</text></form></note>
    <note><form lang="fr"><text>a co yalalen a diɛɛmui ndɛi « ils se servent de leur langue pour tromper » (ROM.3.13). Cf. Childs yàlàbàá « tromperie ».</text></form></note>
  </entry>
  <entry id="yalama_5965">
    <lexical-unit><form lang="kqs"><text>yalama</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yalama_5965_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ménagère ; matrone</text></gloss>
      <gloss lang="en"><text>housewife; matron</text></gloss>
      <trait name="semantic-domain-ddp4" value="5 Daily life"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 125: yalama, pl. yalamawa; Lexique kissi–français, p. 63: yalama</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi yalamalen « les travaux ménagers ». Paulme 1964, p. 125 : pɔlã yalama pimbute « l'excrément de la matrone ne roule pas » (proverbe).</text></form></note>
  </entry>
  <entry id="yálánndo_5966">
    <lexical-unit><form lang="kqs"><text>yálánndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yálán</text></form></variant>
    <variant><form lang="kqs"><text>yálánnde</text></form></variant>
    <sense id="yálánndo_5966_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chêne, grand arbre</text></gloss>
      <gloss lang="en"><text>oak, great tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a tree species</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.35.8; Paulme 1964, p. 125: yalando, pl. yalande; Childs 2000, p. 397: yálàŋndó</text></form></note>
    <note><form lang="fr"><text>yálán Morɛ « le chêne de Moré » (GEN.12.6) ; yálánnde Basan « les chênes du Basan » (ISA.2.13). Paulme 1964, p. 125 : grand arbre, Khaya grandifoliola (Méliacée) ; son écorce entre dans l'objet magique barakawo.</text></form></note>
  </entry>
  <entry id="yalantaalaa_5967">
    <lexical-unit><form lang="kqs"><text>yalantaalaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yalantaalaa_5967_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>calebasse</text></gloss>
      <gloss lang="en"><text>calabash cup</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: yalantaalaa; Childs 2000, p. 397: yàlàŋ-tààlàá</text></form></note>
  </entry>
  <entry id="yalanyaalaa_5968">
    <lexical-unit><form lang="kqs"><text>yalanyaalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yalanyaalaa_5968_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>calebasse</text></gloss>
      <gloss lang="en"><text>calabash</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yalanyaalaa</text></form></note>
  </entry>
  <entry id="yǎlbándíláá_5969">
    <lexical-unit><form lang="kqs"><text>yǎlbándíláá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yǎlbándíláá_5969_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maladie qui obstrue l'entrée du vagin</text></gloss>
      <gloss lang="en"><text>illness closing the entrance of the vagina</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yǎlbándíláá</text></form></note>
  </entry>
  <entry id="yallo_5970">
    <lexical-unit><form lang="kqs"><text>yallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yallo_5970_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fétiche ; épouvantail ; culte (yallo)</text></gloss>
      <gloss lang="en"><text>fetish; scarecrow; yallo cult</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Yallo; Paulme 1964, p. 125: yallo; Lexique kissi–français, p. 63: yallo; Terminologie (idéologie), n° 294: Yallo, koovan</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 63 : « un épouvantail (qui garde les champs contre les voleurs), le fétiche ». Paulme 1964, p. 125 : nom d'un culte ; yallo solo « yallo sacré » ; pl. yalta (yalta nara « nos yallo »).</text></form></note>
  </entry>
  <entry id="yalɔɔ_5971">
    <lexical-unit><form lang="kqs"><text>yalɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yalu</text></form></variant>
    <variant><form lang="kqs"><text>yarɔɔ</text></form></variant>
    <variant><form lang="kqs"><text>yaru</text></form></variant>
    <sense id="yalɔɔ_5971_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier, s'exclamer</text></gloss>
      <gloss lang="en"><text>shout, exclaim</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yarɔɔ/ yaru; Sandara Kisia, fable 4: yaru</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Sandara Kissia, fable 4 : mi wanda a yaru ndu « les gens le huèrent ».</text></form></note>
  </entry>
  <entry id="yàmáfìkóó_5972">
    <lexical-unit><form lang="kqs"><text>yàmáfìkóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yàmáfìkóláŋ</text></form></field>
    <sense id="yàmáfìkóó_5972_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balançoire ; fronde</text></gloss>
      <gloss lang="en"><text>swing; sling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmáfìkóó</text></form></note>
  </entry>
  <entry id="yàmátàndíó_5973">
    <lexical-unit><form lang="kqs"><text>yàmátàndíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàmátàndíó_5973_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau (espèce) qui appelle les autres à manger le riz</text></gloss>
      <gloss lang="en"><text>bird species that calls other birds to the rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmátàndíó</text></form></note>
  </entry>
  <entry id="yamba_5974">
    <lexical-unit><form lang="kqs"><text>yamba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yamba_5974_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>talisman (koma) qui arrête la pluie</text></gloss>
      <gloss lang="en"><text>charm (koma) that stops the rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 125: yamba</text></form></note>
    <note><form lang="fr"><text>Paulme : wana yamba « l'homme qui possède le yamba » ; d'origine kouranko.</text></form></note>
  </entry>
  <entry id="yambaa_5975">
    <lexical-unit><form lang="kqs"><text>yambaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambaa_5975_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tabac</text></gloss>
      <gloss lang="en"><text>tobacco</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yanbaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; homographe de yambaa « être couché » (forme de yambɔɔ).</text></form></note>
  </entry>
  <entry id="yàmbàá_5976">
    <lexical-unit><form lang="kqs"><text>yàmbàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàmbàá_5976_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jupe de raphia</text></gloss>
      <gloss lang="en"><text>raffia skirt</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 397: yàmbàá</text></form></note>
  </entry>
  <entry id="yambalekale_5977">
    <lexical-unit><form lang="kqs"><text>yambalekale</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambalekale_5977_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (espèce) dont la racine sert à la teinture indigo</text></gloss>
      <gloss lang="en"><text>plant (species) whose root is used in indigo dyeing</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 125: yambalékalé</text></form></note>
    <note><form lang="fr"><text>Rubiacée, Morinda geminata.</text></form></note>
  </entry>
  <entry id="yambalen_5978">
    <lexical-unit><form lang="kqs"><text>yambalen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yambalen_5978_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manioc (tubercule)</text></gloss>
      <gloss lang="en"><text>cassava (tuber)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yanbalen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; il donne aussi yanbale folalen « le manioc ».</text></form></note>
  </entry>
  <entry id="yambele folalen_5979">
    <lexical-unit><form lang="kqs"><text>yambele folalen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambele folalen_5979_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manioc</text></gloss>
      <gloss lang="en"><text>cassava</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Yambele folalen</text></form></note>
  </entry>
  <entry id="yambullo_5980">
    <lexical-unit><form lang="kqs"><text>yambullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambullo_5980_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>théâtre</text></gloss>
      <gloss lang="en"><text>theatre</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 283: Yambullo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. yambulnɔɔ « acteur » ; « théâtral » : a yambulten o köö (arts n° 282, numéro répété dans l'original).</text></form></note>
  </entry>
  <entry id="yambulnɔɔ_5981">
    <lexical-unit><form lang="kqs"><text>yambulnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambulnɔɔ_5981_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>acteur, actrice</text></gloss>
      <gloss lang="en"><text>actor, actress</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
      <trait name="semantic-domain-ddp4" value="6.6.5 Art"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 2: Yambulnöö (salanöö)</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi salanɔɔ ; « actrice » : yambulnöö laandoo (arts n° 5).</text></form></note>
  </entry>
  <entry id="yambulɛn_5982">
    <lexical-unit><form lang="kqs"><text>yambulɛn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambulɛn_5982_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tiret</text></gloss>
      <gloss lang="en"><text>dash</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.7 Reading and writing"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 404: Yambulèn, tèndalen</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi tɛndalen (cf. tɛndaa « trait »).</text></form></note>
  </entry>
  <entry id="yambɔɔ_5983">
    <lexical-unit><form lang="kqs"><text>yambɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yambu</text></form></variant>
    <variant><form lang="kqs"><text>yambun</text></form></variant>
    <variant><form lang="kqs"><text>yambunin</text></form></variant>
    <variant><form lang="kqs"><text>yambaa</text></form></variant>
    <sense id="yambɔɔ_5983_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>coucher, étendre, déposer (qqn) ; (yambaa) être couché ; hospitaliser (un malade) ; étaler (une natte, un drap)</text></gloss>
      <gloss lang="en"><text>lay down, put to bed, lay; (yambaa) lie; hospitalize (a sick person); spread out (a mat, a sheet)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>set, lay down; also lay (a road), operate on someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.28.11; Lexique kissi–français, p. 63: yanbɔɔ/ yanbu; Childs 2000, p. 397: yàmbɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>nɛɛ yambaa lebol « où reposer la tête » (MAT.8.20). Lexique kissi–français, p. 63 : yanbɔɔ/ yanbu « faire coucher un enfant, (faire) hospitaliser un malade, faire étaler une natte ou un drap de lit ».</text></form></note>
  </entry>
  <entry id="yambɛi_5984">
    <lexical-unit><form lang="kqs"><text>yambɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yambɛi_5984_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tubercules ; manioc</text></gloss>
      <gloss lang="en"><text>tubers; cassava</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tuber (generic): cassava, eddo, yam</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Yambèi; Paulme 1964, p. 125: yambɛ; Sandara Kisia, proverbe 64: yambɛi; Childs 2000, p. 397: yàmbɛ́í</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 125 : yambɛ « manioc » ; yayamba « grand champ de manioc » ; yambɛiyaway « ragoût de racines de manioc » ; yambɛy fulen « bon manioc ».</text></form></note>
  </entry>
  <entry id="yamɛi_5985">
    <lexical-unit><form lang="kqs"><text>yamɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yamɛi_5985_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jugement, justice, procès</text></gloss>
      <gloss lang="en"><text>judgement, justice, case</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 274 occurrences, first GEN.16.5; Keita 1979, p. 148: yamèi; Lexique kissi–français, p. 63: [ya]mɛi; Childs 2000, p. 397: yàmɛ́í</text></form></note>
  </entry>
  <entry id="yanama_5986">
    <lexical-unit><form lang="kqs"><text>yanama</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yanama_5986_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pécheur (catéchisme)</text></gloss>
      <gloss lang="en"><text>sinner (catechism)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 125: yanama</text></form></note>
    <note><form lang="fr"><text>Mot du catéchisme (Paulme). La Bible dit lahakio.</text></form></note>
  </entry>
  <entry id="yàndìá_5987">
    <lexical-unit><form lang="kqs"><text>yàndìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàndìá_5987_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tisser ; dérouler (étoffe, pelote, ficelle)</text></gloss>
      <gloss lang="en"><text>weave; unroll (cloth, ball, string)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàndìá</text></form></note>
  </entry>
  <entry id="yandule_5988">
    <lexical-unit><form lang="kqs"><text>yandule</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yandule_5988_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trophée fait du bras coupé du chef mort (brandi au combat par son successeur)</text></gloss>
      <gloss lang="en"><text>trophy made of a dead chief's severed arm</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yandule</text></form></note>
  </entry>
  <entry id="yandulen_5989">
    <lexical-unit><form lang="kqs"><text>yandulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yandulen_5989_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre épineux à feuilles de palmier (son tronc sert à faire des récipients à riz)</text></gloss>
      <gloss lang="en"><text>spiny palm-like tree (trunk used for rice containers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 63: yandulen</text></form></note>
  </entry>
  <entry id="yàndúléŋ_5990">
    <lexical-unit><form lang="kqs"><text>yàndúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yàndúléŋ_5990_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>détente (d'un fusil)</text></gloss>
      <gloss lang="en"><text>trigger (of a gun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàndúléŋ</text></form></note>
  </entry>
  <entry id="yandɔɔ_5991">
    <lexical-unit><form lang="kqs"><text>yandɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="yandɔɔ_5991_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fleur</text></gloss>
      <gloss lang="en"><text>flower</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) to flower, blossom, bear fruit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.9.31; Keita 1979, p. 140: Yandöö; Lexique kissi–français, p. 63: yandɔɔ; Childs 2000, p. 398: yàndɔ̀ɔ</text></form></note>
  </entry>
  <entry id="yandɔɔ_5992">
    <lexical-unit><form lang="kqs"><text>yandɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yandu</text></form></variant>
    <variant><form lang="kqs"><text>yendu</text></form></variant>
    <variant><form lang="kqs"><text>yandunin</text></form></variant>
    <sense id="yandɔɔ_5992_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fleurir</text></gloss>
      <gloss lang="en"><text>flower, blossom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flower, produce flowers</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.9.31; Keita 1979, p. 115: Yandöö; Lexique kissi–français, p. 63: yandɔɔ/ yandu, yendu; Childs 2000, p. 398: yàndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita glose « pleurer » (erreur) ; la Bible (EXO 9,31 ; GEN 40,10) et Childs donnent « fleurir ». yendu : radical négatif (HAB 3,17).</text></form></note>
  </entry>
  <entry id="yàndɔ̀ɔ́_5993">
    <lexical-unit><form lang="kqs"><text>yàndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yàndɔ̀ɔ̀láŋ</text></form></field>
    <sense id="yàndɔ̀ɔ́_5993_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune fruit, fruit qui vient de nouer</text></gloss>
      <gloss lang="en"><text>young, newly formed fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Nom dérivé du verbe yandɔɔ « fleurir » (Keita).</text></form></note>
  </entry>
  <entry id="yangaa_5994">
    <lexical-unit><form lang="kqs"><text>yangaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yangaa_5994_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tarder, s'attarder ; passer la matinée (a yangaa kɛndɛ : salutation dite entre 9 h et 11 h) ; retarder</text></gloss>
      <gloss lang="en"><text>delay, linger; spend the morning (a yangaa kɛndɛ: greeting used mid-morning, 9-11 a.m.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spend or pass the morning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ECC.5.3; Keita 1979, p. 21: yangaa; Lexique kissi–français, p. 64: yangaa; Childs 2000, p. 395: yààŋàá</text></form></note>
    <note><form lang="fr"><text>Bible : yangaa le, hun cɔ́-cɔ́ « ne tarde pas, viens vite » (ACT.9.38) ; yangaa le len timbio le « ne tarde pas à l'accomplir » (ECC.5.3). Keita : a yangaa kèndè, la yangaa kèndè ; forme abrégée a yangaa, la yangaa. Cf. lɔl kɛndɛ (le matin au réveil), niilu kɛndɛ (11 h-19 h). Lexique kissi–français, p. 64 : yangaa « retarder ».</text></form></note>
  </entry>
  <entry id="yangaa_5995">
    <lexical-unit><form lang="kqs"><text>yangaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yangaa_5995_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crevette, écrevisse</text></gloss>
      <gloss lang="en"><text>shrimp, crayfish</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 27: Yangaa; Childs 2000, p. 398: yàŋàá</text></form></note>
    <note><form lang="fr"><text>Keita cite Yangaa « crevettes » parmi les noms invariables au pluriel (avec Saa et Nyinaa). Homographe de yangaa « tarder », seul attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="yangbaa_5996">
    <lexical-unit><form lang="kqs"><text>yangbaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yangbaa_5996_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concert</text></gloss>
      <gloss lang="en"><text>concert</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 69: Yangbaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yankɔlo_5997">
    <lexical-unit><form lang="kqs"><text>yankɔlo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yankɔlo_5997_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse avant la circoncision</text></gloss>
      <gloss lang="en"><text>dance before circumcision</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yankɔro</text></form></note>
  </entry>
  <entry id="yanlaninɔɔ_5998">
    <lexical-unit><form lang="kqs"><text>yanlaninɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yanlaninɔɔ_5998_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>auditeur</text></gloss>
      <gloss lang="en"><text>listener</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 45: Yanlaninöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yanɔnndo_5999">
    <lexical-unit><form lang="kqs"><text>yanɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yanun</text></form></variant>
    <variant><form lang="kqs"><text>yenun</text></form></variant>
    <sense id="yanɔnndo_5999_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>étendre</text></gloss>
      <gloss lang="en"><text>spread out, stretch out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yanɔnndo/ yanun, yenun</text></form></note>
  </entry>
  <entry id="yasaa_6000">
    <lexical-unit><form lang="kqs"><text>yasaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yasalan</text></form></field>
    <sense id="yasaa_6000_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épi</text></gloss>
      <gloss lang="en"><text>ear of grain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bunch, ear (of maize), stalk, clump</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first MRK.4.8; Keita 1979, p. 140: Yasaa; Lexique kissi–français, p. 64: yasaa; Childs 2000, p. 399: yàsàá</text></form></note>
  </entry>
  <entry id="yasaba baalaa_6001">
    <lexical-unit><form lang="kqs"><text>yasaba baalaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yasaba baalaa_6001_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chantier</text></gloss>
      <gloss lang="en"><text>building site</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 47: Yasaba baalaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yasabaa_6002">
    <lexical-unit><form lang="kqs"><text>yasabaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="yasabaa_6002_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri, campement ; atelier</text></gloss>
      <gloss lang="en"><text>shelter, camp; workshop</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>temporary cooking site on a farm, before the farm kitchen is built</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.28.15; Keita 1979, p. 142: Yasabaa; Lexique kissi–français, p. 64: yasabaa; Terminologie (histoire), n° 129: Yasabaa; Childs 2000, p. 399: yàsàbáá</text></form></note>
    <note><form lang="fr"><text>Keita donne « atelier » (p. 142) et « le camp » (p. 156). Bible : refuge, abri (Is 28,15.17), pâturage (Ez 25,5). Académie des langues (terminologie, histoire n° 129) : « campement ».</text></form></note>
  </entry>
  <entry id="yasabaa diliŋaa_6003">
    <lexical-unit><form lang="kqs"><text>yasabaa diliŋaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yasabaa diliŋaa_6003_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>camp de concentration</text></gloss>
      <gloss lang="en"><text>concentration camp</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 131: Yasabaa dilinhaa… (nvandatyieeo)</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). La suite du terme est coupée (… nvandatyieeo).</text></form></note>
  </entry>
  <entry id="yàsáŋ-bělló_6004">
    <lexical-unit><form lang="kqs"><text>yàsáŋ-bělló</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàsáŋ-bělló_6004_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>régime de noix de palme</text></gloss>
      <gloss lang="en"><text>bunch of palm nuts</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 399: yàsáŋ-bělló</text></form></note>
  </entry>
  <entry id="yasiaa_6005">
    <lexical-unit><form lang="kqs"><text>yasiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yasiaa_6005_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gratter le sol (volaille) ; fouiller, chercher ; taquiner ; danser ; picorer ; tamiser</text></gloss>
      <gloss lang="en"><text>scratch the ground (fowl); rummage, search; tease; dance; peck; sift</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.1 Search"/>
      <trait name="semantic-domain-ddp4" value="1.6.4 Animal actions"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yasiaa/ yasia; Childs 2000, p. 398: yàsàá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 64 (yasiaa/ yasia « gratter, chercher les graines comme les poulets, tamiser »).</text></form></note>
  </entry>
  <entry id="yaspe_6006">
    <lexical-unit><form lang="kqs"><text>yaspe</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yaspe_6006_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jaspe</text></gloss>
      <gloss lang="en"><text>jasper</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.28.20</text></form></note>
    <note><form lang="fr"><text>Emprunt au français jaspe ; pow yaspe « pierre de jaspe » (REV.4.3).</text></form></note>
  </entry>
  <entry id="yati_6007">
    <lexical-unit><form lang="kqs"><text>yati</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yati_6007_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>vraiment</text></gloss>
      <gloss lang="en"><text>really, truly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yati</text></form></note>
  </entry>
  <entry id="yáù_6008">
    <lexical-unit><form lang="kqs"><text>yáù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yáù_6008_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(tirer d'un coup sec)</text></gloss>
      <gloss lang="en"><text>(dragging quickly, yanking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 399: yáù</text></form></note>
  </entry>
  <entry id="yàùwà-_6009">
    <lexical-unit><form lang="kqs"><text>yàùwà-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàùwà-_6009_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>de cuisine, à cuire</text></gloss>
      <gloss lang="en"><text>cooking, used for cooking</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 399: yàùwà-</text></form></note>
  </entry>
  <entry id="yava_6010">
    <lexical-unit><form lang="kqs"><text>yava</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yava_6010_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mauvaise herbe (espèce) des rizières</text></gloss>
      <gloss lang="en"><text>weed (species) of rice fields</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yawa</text></form></note>
    <note><form lang="fr"><text>Homographe de yava (divination ; pluriel de yave « oignon »).</text></form></note>
  </entry>
  <entry id="yavaa_6011">
    <lexical-unit><form lang="kqs"><text>yavaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yavalan</text></form></field>
    <sense id="yavaa_6011_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>divination, consultation des sorts (vanaa viamaa yavaa « devins, magiciens »)</text></gloss>
      <gloss lang="en"><text>divination (vanaa viamaa yavaa 'diviners, magicians')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a potion used to uncover the truth or foretell; a fortune teller's parcel</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.41.8; Paulme 1964, p. 118: vim; Childs 2000, p. 400: yàwàá</text></form></note>
    <note><form lang="fr"><text>yavalan vomɔɔ « pratiquer la divination » (2KI.21.6). Paulme 1964, p. 118 : i vim yawa « j'ai consulté la divination » (vim, passé de wumo) ; p. 119 : pɔm'wamā « pɔmdo qui devine ».</text></form></note>
  </entry>
  <entry id="yave_6012">
    <lexical-unit><form lang="kqs"><text>yave</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yava</text></form></field>
    <sense id="yave_6012_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oignon</text></gloss>
      <gloss lang="en"><text>onion</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yave, pl. yava</text></form></note>
    <note><form lang="fr"><text>yava de la Bible (LEV.19.26) est un autre mot (divination).</text></form></note>
  </entry>
  <entry id="yàwàá_6013">
    <lexical-unit><form lang="kqs"><text>yàwàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàwàá_6013_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever, arracher, prendre de force</text></gloss>
      <gloss lang="en"><text>take away, remove, snatch</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 400: yàwàá</text></form></note>
  </entry>
  <entry id="yàwǎŋndó_6014">
    <lexical-unit><form lang="kqs"><text>yàwǎŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàwǎŋndó_6014_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se détacher en pelant (croûte)</text></gloss>
      <gloss lang="en"><text>peel off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8 Divide into pieces"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 400: yàwǎŋndó</text></form></note>
  </entry>
  <entry id="yáwèlè-yáwèlè_6015">
    <lexical-unit><form lang="kqs"><text>yáwèlè-yáwèlè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yáwèlè-yáwèlè_6015_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(nourriture mal cuite ou trop cuite)</text></gloss>
      <gloss lang="en"><text>(food badly cooked, overdone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 400: yáwèlè-yáwèlè</text></form></note>
  </entry>
  <entry id="yáwlen_6016">
    <lexical-unit><form lang="kqs"><text>yáwlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="yáwlen_6016_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ceinture ; ceinture de perles bleues des fillettes ; amulette faite des premiers cheveux coupés</text></gloss>
      <gloss lang="en"><text>belt, sash; girls' belt of blue beads; amulet made of the first cut hair</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first EXO.12.11; Keita 1979, p. 145: Yawlen; Paulme 1964, p. 126: yaulle, pl. yauve; Lexique kissi–français, p. 64: yawlen; Childs 2000, p. 399: yàúléŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 126 : 1) ceinture des fillettes en perles bleues ; 2) amulette faite des premiers cheveux coupés, appelée aussi sɛve.</text></form></note>
  </entry>
  <entry id="yawnun_6017">
    <lexical-unit><form lang="kqs"><text>yawnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yawnun_6017_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire, être cuit (bouilli)</text></gloss>
      <gloss lang="en"><text>be cooked, be boiled</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be cooked, get hot, cook by itself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.6.21; Childs 2000, p. 399: yàùnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yawvo « cuire ». Te visin mun yawnun pɛ o kpɛɛnɛi « si la viande a cuit dans un pot » (LEV.6.21).</text></form></note>
  </entry>
  <entry id="yáwvo_6018">
    <lexical-unit><form lang="kqs"><text>yáwvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yáw</text></form></variant>
    <sense id="yáwvo_6018_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>peau</text></gloss>
      <gloss lang="en"><text>skin</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.4 Skin"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>skin, hide; paper, book; learning</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.25.29; Keita 1979, p. 133: Yawvo; Paulme 1964, p. 126: yawɔ, pl. yaɔrã; Lexique kissi–français, p. 64: yawvo; Childs 2000, p. 399: yàúwó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit en général yáwvo dans ce sens ; yawvo sans ton y désigne aussi la cuisson, la préparation du repas (Gn 25,29). Paulme 1964, p. 126 : yawokɛwo « peau de serpent ».</text></form></note>
  </entry>
  <entry id="yawvo_6019">
    <lexical-unit><form lang="kqs"><text>yawvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yaw</text></form></variant>
    <sense id="yawvo_6019_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cuire, préparer (la cuisine)</text></gloss>
      <gloss lang="en"><text>cook</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first GEN.25.29; Keita 1979, p. 115: Yawvo; Paulme 1964, p. 126: yawa; Lexique kissi–français, p. 64: yawvo/ yaw, yew; Childs 2000, p. 399: yàùwó</text></form></note>
    <note><form lang="fr"><text>Moyen yawnun « cuire, être cuit » (LEV 6,21). Lexique kissi–français, p. 64 : radicaux yaw, yew. Paulme 1964, p. 126 : mumu yawa « le riz est cuit » ; mumu yawo « le riz est en train de cuire ».</text></form></note>
  </entry>
  <entry id="yawvo divioo_6020">
    <lexical-unit><form lang="kqs"><text>yawvo divioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yawvo divioo_6020_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tanner</text></gloss>
      <gloss lang="en"><text>tan (hides)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.4 Crafts"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 275: Yawvo divioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Tannerie » : yasaba diviaa layawva, ya[w]an divioo (arts n° 276).</text></form></note>
  </entry>
  <entry id="yayan_6021">
    <lexical-unit><form lang="kqs"><text>yayan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yayan_6021_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>anneau de cheville en coton ou en raphia ; grelot de cheville (du turuno de la circoncision)</text></gloss>
      <gloss lang="en"><text>cotton or raffia ankle ring; ankle bell</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.1 Jewelry"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yayã, yaya invariable,</text></form></note>
    <note><form lang="fr"><text>Invariable ; Paulme marque le premier sens « Sud ».</text></form></note>
  </entry>
  <entry id="yáyâŋndó_6022">
    <lexical-unit><form lang="kqs"><text>yáyâŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yáyâŋndó_6022_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre (espèce)</text></gloss>
      <gloss lang="en"><text>tree species</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 400: yáyâŋndó</text></form></note>
  </entry>
  <entry id="yáŋgbàŋ_6023">
    <lexical-unit><form lang="kqs"><text>yáŋgbàŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yáŋgbàŋ_6023_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>grand ouvert, largement</text></gloss>
      <gloss lang="en"><text>wide open, widely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yáŋgbàŋ</text></form></note>
  </entry>
  <entry id="yàŋgbâŋ-_6024">
    <lexical-unit><form lang="kqs"><text>yàŋgbâŋ-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yàŋgbâŋ-_6024_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>large</text></gloss>
      <gloss lang="en"><text>wide</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàŋgbâŋ-</text></form></note>
  </entry>
  <entry id="yàŋìlàá_6025">
    <lexical-unit><form lang="kqs"><text>yàŋìlàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàŋìlàá_6025_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pagne-jupe traditionnel (hommes et femmes)</text></gloss>
      <gloss lang="en"><text>traditional skirt (worn by men and women)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàŋìlàá</text></form></note>
  </entry>
  <entry id="yaŋnun_6026">
    <lexical-unit><form lang="kqs"><text>yaŋnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yaŋnɔnndo</text></form></variant>
    <sense id="yaŋnun_6026_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écouter, obéir à</text></gloss>
      <gloss lang="en"><text>listen to, heed</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first EXO.6.12; Lexique kissi–français, p. 64: yannɔnndo/ yannun</text></form></note>
    <note><form lang="fr"><text>Moyen de yaŋɔɔ. Le Lexique kissi–français (p. 64) écrit yannɔnndo/ yannun « écouter ».</text></form></note>
  </entry>
  <entry id="yaŋɔɔ_6027">
    <lexical-unit><form lang="kqs"><text>yaŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yaŋ</text></form></variant>
    <sense id="yaŋɔɔ_6027_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prêter (l'oreille), écouter (yaŋ nilan) ; tendre (un piège)</text></gloss>
      <gloss lang="en"><text>lend (an ear), listen (yaŋ nilan); set (a trap)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>set a trap; prick up one's ears, listen carefully</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 70 occurrences, first GEN.18.10; Lexique kissi–français, p. 64: yaŋɔɔ/ yaŋ; Childs 2000, p. 398: yàŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 64 : yaŋɔɔ/ yaŋ « tendre le piège pour attraper les animaux ».</text></form></note>
  </entry>
  <entry id="yaŋɔɔlen_6028">
    <lexical-unit><form lang="kqs"><text>yaŋɔɔlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yaŋɔɔlan</text></form></field>
    <variant><form lang="kqs"><text>yaŋɔɔle</text></form></variant>
    <sense id="yaŋɔɔlen_6028_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piège ; nasse ; embuscade</text></gloss>
      <gloss lang="en"><text>trap, snare; fish trap; ambush</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.20.9; Paulme 1964, p. 126: yaɔlɛ̃, pl. yaɔrã – yawɔlɛ̃; Lexique kissi–français, p. 39: ɲaŋɔlen; Terminologie (histoire), n° 333: Yanhöölen; Childs 2000, p. 398: yàŋɔ̀ɔ̀léŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 39 écrit ɲaŋɔlen « le piège pour prendre les animaux ». Aussi Lexique kissi–français, p. 64 : « yaŋɔɔlen ». Lexique kissi–français, p. 64 : « une sorte de piège dans laquelle une souris ou un poisson peut entrer mais ne peut pas sortir » ; aussi yaŋɔlen « piège pour prendre les animaux ». Paulme 1964, p. 126 : yaɔlɛ̃ kilinde « piège en fer (pour le gros gibier) » ; yaɔlɛ̃ bɛllã « piège pour les souris ».</text></form></note>
  </entry>
  <entry id="yàɲáŋndó_6029">
    <lexical-unit><form lang="kqs"><text>yàɲáŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yàɲáŋndó_6029_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marécage broussailleux</text></gloss>
      <gloss lang="en"><text>watery swamp full of brush</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.1 Bodies of water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàɲáŋndó</text></form></note>
  </entry>
  <entry id="yeela_6030">
    <lexical-unit><form lang="kqs"><text>yeela</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yeela_6030_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>bon, agréable (au goût)</text></gloss>
      <gloss lang="en"><text>good, pleasant (to eat)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be enjoyable, tasty, sweet; (of talk) interesting</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.2.9; Childs 2000, p. 401: yèlàá</text></form></note>
  </entry>
  <entry id="yeelan_6031">
    <lexical-unit><form lang="kqs"><text>yeelan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="yeelan_6031_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cris, pleurs, lamentation</text></gloss>
      <gloss lang="en"><text>crying, weeping, wailing</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>weeping, crying</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.11.6; Childs 2000, p. 400: yééláŋ</text></form></note>
    <note><form lang="fr"><text>mɛli yeelan « crier, se lamenter ».</text></form></note>
  </entry>
  <entry id="yeelanndo_6032">
    <lexical-unit><form lang="kqs"><text>yeelanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yeelanndo_6032_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>alliance</text></gloss>
      <gloss lang="en"><text>alliance</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 38: Yeelanndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. yeelannɔɔ « allié ».</text></form></note>
  </entry>
  <entry id="yeelannɔɔ_6033">
    <lexical-unit><form lang="kqs"><text>yeelannɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yeelannɔɔ_6033_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>allié</text></gloss>
      <gloss lang="en"><text>ally</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.1 Friend"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 149: Yeelannöö</text></form></note>
  </entry>
  <entry id="yééléŋ_6034">
    <lexical-unit><form lang="kqs"><text>yééléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yééléŋ_6034_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>venin</text></gloss>
      <gloss lang="en"><text>venom</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yééléŋ</text></form></note>
  </entry>
  <entry id="yeeliaa_6035">
    <lexical-unit><form lang="kqs"><text>yeeliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yeeliaa_6035_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rendre agréable, rendre savoureux ; faire réussir</text></gloss>
      <gloss lang="en"><text>make pleasant or tasty; make prosper</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.24.21</text></form></note>
    <note><form lang="fr"><text>Causatif de yeela. Mɛlɛka yeeliaa kela ndɔɔ « le Seigneur faisait réussir son voyage » (GEN.24.21).</text></form></note>
  </entry>
  <entry id="yeelɛiyo_6036">
    <lexical-unit><form lang="kqs"><text>yeelɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeelɛi</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛiyon</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛilen</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛilan</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛin</text></form></variant>
    <variant><form lang="kqs"><text>yeelɛiya</text></form></variant>
    <sense id="yeelɛiyo_6036_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>savoureux, délicieux, doux ; agréable</text></gloss>
      <gloss lang="en"><text>tasty, delicious, sweet; pleasant</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.27.7</text></form></note>
    <note><form lang="fr"><text>Cf. yeela « bon, agréable ». ɲɛmahilu yeelɛiyo « un mets savoureux » (GEN.27.7).</text></form></note>
  </entry>
  <entry id="yeemaa_6037">
    <lexical-unit><form lang="kqs"><text>yeemaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeema</text></form></variant>
    <variant><form lang="kqs"><text>yeemanin</text></form></variant>
    <sense id="yeemaa_6037_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vouloir, désirer, aimer</text></gloss>
      <gloss lang="en"><text>want, desire, love</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: need</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first NUM.16.10; Lexique kissi–français, p. 64: yeemaa/ yeema; Childs 2000, p. 400: yèèmàá</text></form></note>
  </entry>
  <entry id="yèèmìá_6038">
    <lexical-unit><form lang="kqs"><text>yèèmìá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yèèmìàláŋ</text></form></field>
    <sense id="yèèmìá_6038_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>interdit alimentaire, tabou</text></gloss>
      <gloss lang="en"><text>taboo, forbidden food</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yèèmìá</text></form></note>
    <note><form lang="fr"><text>Nom ; le verbe correspondant yeemiaa « avoir en horreur » est attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="yeemiaa_6039">
    <lexical-unit><form lang="kqs"><text>yeemiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yeemiaa_6039_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avoir en horreur, détester, abhorrer</text></gloss>
      <gloss lang="en"><text>loathe, abhor, detest</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dislike, have as a taboo</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.1.13; Childs 2000, p. 401: yèèmìá</text></form></note>
    <note><form lang="fr"><text>I yeemiaa bɔɔ lasikɔlɔ niaa « votre encens m'est en horreur » (ISA.1.13) ; dɛnnda vɔɔnnda ya yeemiaa lan « ces abominations que je hais » (JER.44.4).</text></form></note>
  </entry>
  <entry id="yeemianndo_6040">
    <lexical-unit><form lang="kqs"><text>yeemianndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yeemian</text></form></variant>
    <sense id="yeemianndo_6040_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'aimer réciproquement</text></gloss>
      <gloss lang="en"><text>love each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.3 Love"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yemianndo/ yemian</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit yemian ; réécrit d'après yeemaa « aimer » (Bible).</text></form></note>
  </entry>
  <entry id="yéémɔ́ɔ́_6041">
    <lexical-unit><form lang="kqs"><text>yéémɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yéémɔ́ɔ́_6041_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat à ventre blanc</text></gloss>
      <gloss lang="en"><text>white-bellied rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yéémɔ́ɔ́</text></form></note>
  </entry>
  <entry id="yeemɛi_6042">
    <lexical-unit><form lang="kqs"><text>yeemɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yeemɛi_6042_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>désir, envie, volonté ; ambition</text></gloss>
      <gloss lang="en"><text>desire, longing, will; ambition</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) wanting, in need of</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 203 occurrences, first GEN.3.6; Lexique kissi–français, p. 64: yemɛi; Childs 2000, p. 400: yèèmɛ̀</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 64) écrit yemɛi « le désir, l'ambition ».</text></form></note>
  </entry>
  <entry id="yééyóó_6043">
    <lexical-unit><form lang="kqs"><text>yééyóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yééyíá</text></form></field>
    <sense id="yééyóó_6043_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mante religieuse</text></gloss>
      <gloss lang="en"><text>praying mantis</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yééyóó</text></form></note>
  </entry>
  <entry id="yèèyɛ́í_6044">
    <lexical-unit><form lang="kqs"><text>yèèyɛ́í</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yèèyɔ́ŋ</text></form></field>
    <sense id="yèèyɛ́í_6044_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mycose des pieds, infection de la peau</text></gloss>
      <gloss lang="en"><text>athlete's foot, skin infection</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yèèyɛ́í</text></form></note>
  </entry>
  <entry id="yèèŋgòó_6045">
    <lexical-unit><form lang="kqs"><text>yèèŋgòó</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yèèŋgòó_6045_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sentier laissé entre deux champs</text></gloss>
      <gloss lang="en"><text>path left between farms</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 401: yèèŋgòó</text></form></note>
  </entry>
  <entry id="yeiyo_6046">
    <lexical-unit><form lang="kqs"><text>yeiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yei</text></form></variant>
    <sense id="yeiyo_6046_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insulter, injurier, défier ; blasphémer</text></gloss>
      <gloss lang="en"><text>insult, revile, defy; blaspheme</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1PE.3.9; Terminologie (langue), n° 301: Yeiyo (maa yei); Childs 2000, p. 401: yèìyó</text></form></note>
    <note><form lang="fr"><text>Vana yei pɛ fuɲa ndɔ « celui qui maudit son père » (MRK.7.10) ; le yei o yei vanaa cɔvaa Hala « parce qu'il a défié l'armée de Dieu » (1SA.17.36). Académie des langues (terminologie, langue n° 301) : yeiyo, maa yei « péjoratif ».</text></form></note>
  </entry>
  <entry id="yékén_6047">
    <lexical-unit><form lang="kqs"><text>yékén</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yékén_6047_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) attentivement (yaŋ nilan yékén « écouter attentivement »)</text></gloss>
      <gloss lang="en"><text>(ideophone) attentively, intently (yaŋ nilan yékén 'listen closely')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.37.14</text></form></note>
  </entry>
  <entry id="yekpandi baa_6048">
    <lexical-unit><form lang="kqs"><text>yekpandi baa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yekpandi baa_6048_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pistolet</text></gloss>
      <gloss lang="en"><text>pistol</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 479: Yekpandi baa (pömböö)</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « fusil de main » ; aussi yekpandi baa pɔmbɔɔ. Cf. yekpandio « fusil ».</text></form></note>
  </entry>
  <entry id="yekpandi tɔɔliaa_6049">
    <lexical-unit><form lang="kqs"><text>yekpandi tɔɔliaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yekpandi tɔɔliaa_6049_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fusil-mitrailleur</text></gloss>
      <gloss lang="en"><text>light machine gun</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 355: Yekpandi tööliaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. yekpandio « fusil ».</text></form></note>
  </entry>
  <entry id="yekpandio_6050">
    <lexical-unit><form lang="kqs"><text>yekpandio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yakpando</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="yekpandio_6050_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fusil</text></gloss>
      <gloss lang="en"><text>gun</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Yekpandio; Paulme 1964, p. 125 (G/K): yagbando /K./, yebandi /G./; Lexique kissi–français, p. 64: yekpandio; Terminologie (histoire), n° 354: Yekpandioo; Childs 2000, p. 401: yèkpándìó</text></form></note>
    <note><form lang="fr"><text>Le Lexique kissi–français (p. 64, 66) écrit aussi yekpando et yokpando. Paulme 1964, p. 125 : yagbando /K./, yebandi /G./, pl. yagbanta. Paulme : yagbando /K./, yebandi /G./ (p. 125).</text></form></note>
  </entry>
  <entry id="yelaa_6051">
    <lexical-unit><form lang="kqs"><text>yelaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yela</text></form></variant>
    <variant><form lang="kqs"><text>yeraa</text></form></variant>
    <variant><form lang="kqs"><text>yera</text></form></variant>
    <sense id="yelaa_6051_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être sucré, être doux ; faire plaisir</text></gloss>
      <gloss lang="en"><text>be sweet; please</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128: yira; Lexique kissi–français, p. 65: yeraa/ yera</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Paulme 1964, p. 128 : yira « doux, bon (à manger) » ; maŋurua ma yira « les mangues sont bonnes » ; ɔ tyɔ ɔ yera.</text></form></note>
  </entry>
  <entry id="yelela_6052">
    <lexical-unit><form lang="kqs"><text>yelela</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>yerela</text></form></variant>
    <sense id="yelela_6052_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>annonce d'un événement ou d'une fête à venir</text></gloss>
      <gloss lang="en"><text>announcement of a coming event or feast</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yerela; Terminologie (arts), n° 10: Yelelaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit yerela ; la Bible a yelela une fois (LAM.4.5) dans un autre sens. Le Lexique donne aussi le verbe yerelaa/ yerela « faire plaisir à qqn » (p. 65). À vérifier. Académie des langues (terminologie, arts n° 10 et 11) : yelelaa « animer, animation ». La Bible a yelelaa pour la fête d'anniversaire de Pharaon (GEN.40.20).</text></form></note>
  </entry>
  <entry id="yelelanɔ_6053">
    <lexical-unit><form lang="kqs"><text>yelelanɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yelelanɔ_6053_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animateur</text></gloss>
      <gloss lang="en"><text>host, animator (of an event)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
      <trait name="semantic-domain-ddp4" value="4.2.6 Entertainment, recreation"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 8: Yelelanö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. yelelaa « animer, animation » (arts n° 10, 11).</text></form></note>
  </entry>
  <entry id="yelen_6054">
    <lexical-unit><form lang="kqs"><text>yelen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="yelen_6054_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>melon</text></gloss>
      <gloss lang="en"><text>melon</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yelen</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « le milon ». Ne pas confondre avec yɛlen « haine ».</text></form></note>
  </entry>
  <entry id="yelenyelenndo_6055">
    <lexical-unit><form lang="kqs"><text>yelenyelenndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yelenyelen</text></form></variant>
    <variant><form lang="kqs"><text>yelenyelennde</text></form></variant>
    <sense id="yelenyelenndo_6055_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flamme</text></gloss>
      <gloss lang="en"><text>flame</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.21.28</text></form></note>
    <note><form lang="fr"><text>yelenyelen leyin « la flamme du feu » (JDG.13.20).</text></form></note>
  </entry>
  <entry id="yèlèŋ-yéléŋndó_6056">
    <lexical-unit><form lang="kqs"><text>yèlèŋ-yéléŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yèlèŋ-yéléŋndó_6056_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grossièreté, conduite folle ou irrespectueuse, crise</text></gloss>
      <gloss lang="en"><text>rudeness, crazy or disrespectful behaviour, fit</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yèlèŋ-yéléŋndó</text></form></note>
  </entry>
  <entry id="yeliaa_6057">
    <lexical-unit><form lang="kqs"><text>yeliaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yelia</text></form></variant>
    <variant><form lang="kqs"><text>yeriaa</text></form></variant>
    <variant><form lang="kqs"><text>yeria</text></form></variant>
    <sense id="yeliaa_6057_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sucrer</text></gloss>
      <gloss lang="en"><text>sweeten</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeriaa/ yeria</text></form></note>
    <note><form lang="fr"><text>Causatif de yelaa « être sucré ». Le Lexique écrit r.</text></form></note>
  </entry>
  <entry id="yelnɔɔ_6058">
    <lexical-unit><form lang="kqs"><text>yelnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yelnɔɔ_6058_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>griot</text></gloss>
      <gloss lang="en"><text>griot (bard)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 136: Yelnöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yem_6059">
    <lexical-unit><form lang="kqs"><text>yem</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yem_6059_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>casser, briser</text></gloss>
      <gloss lang="en"><text>break</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.13.13; Lexique kissi–français, p. 64: yem</text></form></note>
    <note><form lang="fr"><text>la yem ndu kɛsei « tu lui briseras la nuque » (EXO.13.13). Le Lexique : « casser (conjugué) » ; cf. yomɔɔ/ yom, yam, yim « casser, détacher » (p. 63, 66).</text></form></note>
  </entry>
  <entry id="yema_6060">
    <lexical-unit><form lang="kqs"><text>yema</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yemalan</text></form></field>
    <sense id="yema_6060_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bâillement ; bâiller</text></gloss>
      <gloss lang="en"><text>yawn</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2 Body functions"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yema, pl. yemarã</text></form></note>
    <note><form lang="fr"><text>Paulme : i yema « je bâille ». Homographe de yema « sœur ».</text></form></note>
  </entry>
  <entry id="yema nde-a_6061">
    <lexical-unit><form lang="kqs"><text>yema nde-a</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yema nde-a_6061_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sœur de la mère</text></gloss>
      <gloss lang="en"><text>mother's sister</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yema nde-a</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; analyse à vérifier.</text></form></note>
  </entry>
  <entry id="yema pua_6062">
    <lexical-unit><form lang="kqs"><text>yema pua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yema pua_6062_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tante (sœur du père)</text></gloss>
      <gloss lang="en"><text>aunt (father's sister)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yema pua</text></form></note>
  </entry>
  <entry id="yemaa_6063">
    <lexical-unit><form lang="kqs"><text>yemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yema</text></form></variant>
    <sense id="yemaa_6063_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sœur (d'un homme), frère (d'une femme)</text></gloss>
      <gloss lang="en"><text>opposite-sex sibling: a man's sister, a woman's brother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sister; brother in some dialects</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 39 occurrences, first GEN.24.55; Keita 1979, p. 134: Yemaa; Paulme 1964, p. 127: yima; Lexique kissi–français, p. 64: yemaa; Childs 2000, p. 402: yèmàá</text></form></note>
    <note><form lang="fr"><text>Keita : « la sœur ». Dans la Bible, Laban est aussi le yemaa de Rébecca (Gn 24,55 ; 28,5). Paulme 1964, p. 127 : yima nu « ma sœur » ; yima Musa « la sœur de Musa ».</text></form></note>
  </entry>
  <entry id="yemba_6064">
    <lexical-unit><form lang="kqs"><text>yemba</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yemba_6064_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand arbre (espèce) dont on tire la caisse du tambour dunduo</text></gloss>
      <gloss lang="en"><text>large tree (species) used for the body of the dunduo drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 126: yemba</text></form></note>
  </entry>
  <entry id="yémbálló_6065">
    <lexical-unit><form lang="kqs"><text>yémbálló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yémbálló_6065_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu de bain des femmes</text></gloss>
      <gloss lang="en"><text>women's bathhouse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yémbálló</text></form></note>
  </entry>
  <entry id="yémbálnɔ̀ɔ́_6066">
    <lexical-unit><form lang="kqs"><text>yémbálnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yémbálnɔ̀ɔ́_6066_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purificateur, exorciste (qui lave personnes et lieux des souillures)</text></gloss>
      <gloss lang="en"><text>exorcist, ritual cleanser</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yémbálnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yembuo_6067">
    <lexical-unit><form lang="kqs"><text>yembuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yembu</text></form></variant>
    <sense id="yembuo_6067_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>célibataire</text></gloss>
      <gloss lang="en"><text>unmarried person</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>unmarried adult</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Yembuo; Childs 2000, p. 402: yèmbòó</text></form></note>
    <note><form lang="fr"><text>La Bible a yembu « sans être marié » (1Co 7,8).</text></form></note>
  </entry>
  <entry id="yembuo_6068">
    <lexical-unit><form lang="kqs"><text>yembuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yembuo_6068_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>célibataire, veuf</text></gloss>
      <gloss lang="en"><text>bachelor, widower</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenbuo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb.</text></form></note>
  </entry>
  <entry id="yembɛi_6069">
    <lexical-unit><form lang="kqs"><text>yembɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="yembɛi_6069_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ongle</text></gloss>
      <gloss lang="en"><text>nail (finger, toe)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenbɛi</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb ; la Bible écrit toujours mb. Le Lexique écrit aussi yɛnbɛi (p. 65).</text></form></note>
  </entry>
  <entry id="yèméí_6070">
    <lexical-unit><form lang="kqs"><text>yèméí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="yèméí_6070_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fraternité, lien entre frères et sœurs</text></gloss>
      <gloss lang="en"><text>sibling relationship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yèméí</text></form></note>
  </entry>
  <entry id="yemnde_6071">
    <lexical-unit><form lang="kqs"><text>yemnde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yemnde_6071_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>foie</text></gloss>
      <gloss lang="en"><text>liver</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first EXO.29.13; Keita 1979, p. 133: Yemnde; Paulme 1964, p. 127: yɛmde, yimdo, pluriel; Lexique kissi–français, p. 64: yemnde; Childs 2000, p. 402: yěmndé</text></form></note>
  </entry>
  <entry id="yendioo_6072">
    <lexical-unit><form lang="kqs"><text>yendioo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yendioo_6072_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>néré</text></gloss>
      <gloss lang="en"><text>African locust bean tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Yendioo; Lexique kissi–français, p. 64: yendioo</text></form></note>
    <note><form lang="fr"><text>Parkia biglobosa. Le Lexique kissi–français (p. 64) donne aussi yendelen « l'arbre néré, qui donne une farine jaune ».</text></form></note>
  </entry>
  <entry id="yengan_6073">
    <lexical-unit><form lang="kqs"><text>yengan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yengan_6073_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prêt</text></gloss>
      <gloss lang="en"><text>loan</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 517: Yengan</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="yenge-yenge_6074">
    <lexical-unit><form lang="kqs"><text>yenge-yenge</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yenge-yenge_6074_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>instable, fragile, en mauvaise position, dangereux ; raide</text></gloss>
      <gloss lang="en"><text>unstable, fragile, precarious; stiff</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yenge-yenge</text></form></note>
    <note><form lang="fr"><text>vanaa yenge-yengea « des êtres plus fragiles » (1PE.3.7). Le Lexique donne aussi yengeyenge « raide ».</text></form></note>
  </entry>
  <entry id="yengilanndo_6075">
    <lexical-unit><form lang="kqs"><text>yengilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yengilan</text></form></variant>
    <sense id="yengilanndo_6075_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>provoquer</text></gloss>
      <gloss lang="en"><text>provoke</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yengilanndo/ yengilan</text></form></note>
  </entry>
  <entry id="yeo_6076">
    <lexical-unit><form lang="kqs"><text>yeo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>ye</text></form></variant>
    <sense id="yeo_6076_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insulter, jurer (plusieurs fois)</text></gloss>
      <gloss lang="en"><text>insult, swear (repeatedly)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yeo</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne le radical ye « insulter, jurer » et yeo « insulter, jurer plusieurs fois ».</text></form></note>
  </entry>
  <entry id="yeoanndo_6077">
    <lexical-unit><form lang="kqs"><text>yeoanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yeoan</text></form></variant>
    <sense id="yeoanndo_6077_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'insulter (l'un l'autre)</text></gloss>
      <gloss lang="en"><text>insult each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 64: yeoanndo/ yeoan</text></form></note>
  </entry>
  <entry id="yeowlan_6078">
    <lexical-unit><form lang="kqs"><text>yeowlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeow</text></form></variant>
    <variant><form lang="kqs"><text>yeowla</text></form></variant>
    <sense id="yeowlan_6078_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se moquer de, insulter ; maudire</text></gloss>
      <gloss lang="en"><text>mock, insult; curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>abuse repeatedly (plural of yèìyó 'insult, curse')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first JDG.8.15; Childs 2000, p. 409: yìòùwó</text></form></note>
  </entry>
  <entry id="Yesu nduo vilunndɔle_6079">
    <lexical-unit><form lang="kqs"><text>Yesu nduo vilunndɔle</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="Yesu nduo vilunndɔle_6079_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avant Jésus-Christ</text></gloss>
      <gloss lang="en"><text>before Christ (BC)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 101: Yesu nduo vilunndöle</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Après Jésus-Christ » : o volön Yesuo kööli (histoire n° 102).</text></form></note>
  </entry>
  <entry id="yèùwó_6080">
    <lexical-unit><form lang="kqs"><text>yèùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yèùwó_6080_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit animal (plus petit qu'une chèvre) dont la peau sert pour les tambours</text></gloss>
      <gloss lang="en"><text>small animal whose skin is used for drums</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 403: yèùwó</text></form></note>
  </entry>
  <entry id="yewvo_6081">
    <lexical-unit><form lang="kqs"><text>yewvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yewva</text></form></field>
    <sense id="yewvo_6081_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>antilope (espèce)</text></gloss>
      <gloss lang="en"><text>antelope (species)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yewo, pl. yewa</text></form></note>
    <note><form lang="fr"><text>w intervocalique de Paulme rendu par wv (cf. suwo, Bible suwvo).</text></form></note>
  </entry>
  <entry id="yeyio_6082">
    <lexical-unit><form lang="kqs"><text>yeyio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yeyio_6082_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insecte fouisseur (qui s'attaque aux yeux)</text></gloss>
      <gloss lang="en"><text>burrowing insect (said to attack the eyes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yeyio</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « un insecte qui creuse, qui enlève les yeux ».</text></form></note>
  </entry>
  <entry id="yeyo_6083">
    <lexical-unit><form lang="kqs"><text>yeyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yeyo_6083_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>insulte</text></gloss>
      <gloss lang="en"><text>insult</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yeyo, pl. yeorã; Lexique kissi–français, p. 65: yeyo</text></form></note>
    <note><form lang="fr"><text>Cf. yeo « insulter ». Paulme 1964, p. 127 : ɔ yeo ya « il m'insulte » ; la yeo ndu « injuriez-le ».</text></form></note>
  </entry>
  <entry id="yeŋ_6084">
    <lexical-unit><form lang="kqs"><text>yeŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yeŋnun</text></form></variant>
    <variant><form lang="kqs"><text>yeŋnin</text></form></variant>
    <sense id="yeŋ_6084_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>refuser (d'écouter), désobéir (yeŋ … lani)</text></gloss>
      <gloss lang="en"><text>refuse (to listen), disobey (yeŋ … lani)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 44 occurrences, first GEN.42.21</text></form></note>
  </entry>
  <entry id="yéŋé-yéŋé_6085">
    <lexical-unit><form lang="kqs"><text>yéŋé-yéŋé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yéŋé-yéŋé_6085_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en équilibre instable ; aux aguets (oreilles dressées) ; équilibré</text></gloss>
      <gloss lang="en"><text>delicately balanced; alertly (ears pricked); balanced</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yéŋé-yéŋé</text></form></note>
  </entry>
  <entry id="yéŋndó_6086">
    <lexical-unit><form lang="kqs"><text>yéŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yéŋndó_6086_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeune boa</text></gloss>
      <gloss lang="en"><text>young boa constrictor</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 402: yéŋndó</text></form></note>
  </entry>
  <entry id="yí_6087">
    <lexical-unit><form lang="kqs"><text>yí</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yí_6087_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>droit, immobile, tranquillement</text></gloss>
      <gloss lang="en"><text>straight, erect, quietly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yí</text></form></note>
  </entry>
  <entry id="yi sondo_6088">
    <lexical-unit><form lang="kqs"><text>yi sondo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yi sondo_6088_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire la moue</text></gloss>
      <gloss lang="en"><text>pout</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yi sondo</text></form></note>
  </entry>
  <entry id="yia_6089">
    <lexical-unit><form lang="kqs"><text>yia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yia_6089_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>loger, faire loger</text></gloss>
      <gloss lang="en"><text>lodge, put up</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yia</text></form></note>
    <note><form lang="fr"><text>Le Lexique ne donne que le radical.</text></form></note>
  </entry>
  <entry id="yiaan_6090">
    <lexical-unit><form lang="kqs"><text>yiaan</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yima</text></form></variant>
    <sense id="yiaan_6090_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faim ; famine</text></gloss>
      <gloss lang="en"><text>hunger; famine</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.25.30; Paulme 1964, p. 125: ya; Lexique kissi–français, p. 65: yiyan; Childs 2000, p. 406: yìáŋ</text></form></note>
    <note><form lang="fr"><text>yima fofolan « famine » (Gn 12,10). Le Lexique kissi–français (p. 65) écrit yiyan « la faim, la famine », homographe de yiyan « penser ». Paulme 1964, p. 125 : ya ma bi ya « j'ai faim » ; ya ma tyu ne « il a faim ».</text></form></note>
  </entry>
  <entry id="yifa_6091">
    <lexical-unit><form lang="kqs"><text>yifa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yifa_6091_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer (les paupières)</text></gloss>
      <gloss lang="en"><text>close (the eyelids)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>partially close, close without locking; hide</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PSA.132.4; Childs 2000, p. 406: yìfàá</text></form></note>
    <note><form lang="fr"><text>i yifa lɛnin hɔlta koongula nilan « je ne fermerai pas les paupières » (PSA.132.4).</text></form></note>
  </entry>
  <entry id="yìfàá_6092">
    <lexical-unit><form lang="kqs"><text>yìfàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yìfàá_6092_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marque au front des musulmans (à effacer à leur mort)</text></gloss>
      <gloss lang="en"><text>mark Muslims wear on the forehead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yìfàá</text></form></note>
  </entry>
  <entry id="yifanndo_6093">
    <lexical-unit><form lang="kqs"><text>yifanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifan</text></form></variant>
    <sense id="yifanndo_6093_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'abriter, se réfugier ; se retirer, se tenir à l'écart</text></gloss>
      <gloss lang="en"><text>take shelter, take refuge; withdraw, keep apart</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>escape something, take precautions</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.30.2; Childs 2000, p. 406: yìfǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yifa. le kɔlan yifanndo o vunduma Esipte « pour s'abriter à l'ombre de l'Égypte » (ISA.30.2) ; mó yifan « il se tint à l'écart » (GAL.2.12).</text></form></note>
  </entry>
  <entry id="yifidi_6094">
    <lexical-unit><form lang="kqs"><text>yifidi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yifidi_6094_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sombre, obscur</text></gloss>
      <gloss lang="en"><text>dark</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yifidi</text></form></note>
  </entry>
  <entry id="yifidii_6095">
    <lexical-unit><form lang="kqs"><text>yifidii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yifidiio</text></form></variant>
    <variant><form lang="kqs"><text>yifidiia</text></form></variant>
    <variant><form lang="kqs"><text>yifidiila</text></form></variant>
    <sense id="yifidii_6095_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>obscurité, ténèbres ; (yɔŋnun yifidii) s'assombrir, se troubler (yeux, visage)</text></gloss>
      <gloss lang="en"><text>darkness, gloom; (yɔŋnun yifidii) grow dark, grow dim</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.28.65</text></form></note>
  </entry>
  <entry id="yifɔɔ_6096">
    <lexical-unit><form lang="kqs"><text>yifɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yifɔlan</text></form></field>
    <variant><form lang="kqs"><text>yifɔ</text></form></variant>
    <sense id="yifɔɔ_6096_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poche</text></gloss>
      <gloss lang="en"><text>pocket</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.6 Parts of clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Yiföö; Lexique kissi–français, p. 65: yifɔɔ; Childs 2000, p. 406: yífɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale yifɔ dans la Bible : « sein, pli du vêtement » (Pr 6,27), « ceinture » où l'on met l'argent (Mc 6,8).</text></form></note>
  </entry>
  <entry id="yíì_6097">
    <lexical-unit><form lang="kqs"><text>yíì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíì_6097_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>(cri d'enfant qui montre une chose laide ou effrayante)</text></gloss>
      <gloss lang="en"><text>(children's exclamation when showing something ugly or scary)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíì</text></form></note>
  </entry>
  <entry id="yiian_6098">
    <lexical-unit><form lang="kqs"><text>yiian</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <sense id="yiian_6098_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fin</text></gloss>
      <gloss lang="en"><text>end</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiian</text></form></note>
  </entry>
  <entry id="yíìì_6099">
    <lexical-unit><form lang="kqs"><text>yíìì</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíìì_6099_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(très grand, énorme)</text></gloss>
      <gloss lang="en"><text>(underscores bigness)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 406: yíìì</text></form></note>
  </entry>
  <entry id="yiilu_6100">
    <lexical-unit><form lang="kqs"><text>yiilu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiilu_6100_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>conclure (une alliance) avec, promettre à</text></gloss>
      <gloss lang="en"><text>make (a covenant) with, promise to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 139 occurrences, first GEN.9</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de yiiyo.</text></form></note>
  </entry>
  <entry id="yiinanndo_6101">
    <lexical-unit><form lang="kqs"><text>yiinanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiinan</text></form></variant>
    <variant><form lang="kqs"><text>yiinannda</text></form></variant>
    <variant><form lang="kqs"><text>yiinannin</text></form></variant>
    <sense id="yiinanndo_6101_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'unir, se joindre, être lié (à) ; se liguer</text></gloss>
      <gloss lang="en"><text>join together, unite, be bound (to); league together</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.30.12</text></form></note>
    <note><form lang="fr"><text>Réciproque de yiiyo « lier, établir ». laa … yiinan a pɔnɔ ndɔ « la femme est liée à son mari » (1CO.7.39).</text></form></note>
  </entry>
  <entry id="yiinde_6102">
    <lexical-unit><form lang="kqs"><text>yiinde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yiiŋii</text></form></variant>
    <sense id="yiinde_6102_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cheveux, poils ; laine</text></gloss>
      <gloss lang="en"><text>hair; wool</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first GEN.25.25; Keita 1979, p. 133: Yiinde; Paulme 1964, p. 128: yinde, pl. yinde; Lexique kissi–français, p. 65: yiinde; Childs 2000, p. 406: yììŋndé</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 66 : yiŋi, yinŋi « les cheveux (suivi d'un adjectif) » ; la Bible a yiŋii (LUK.12.7).</text></form></note>
  </entry>
  <entry id="yiinde lavɔɔ_6103">
    <lexical-unit><form lang="kqs"><text>yiinde lavɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiinde lavɔɔ_6103_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tresser (les cheveux)</text></gloss>
      <gloss lang="en"><text>braid (hair)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: [yi]inde lavɔɔ</text></form></note>
  </entry>
  <entry id="yiinɔnndo_6104">
    <lexical-unit><form lang="kqs"><text>yiinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yiinɔnndo_6104_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se ceindre, s'attacher ; s'attacher à, se joindre à</text></gloss>
      <gloss lang="en"><text>gird oneself, tie on; attach oneself to, join</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie (a cloth) around oneself, wrap, wear</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.15.12; Lexique kissi–français, p. 65: yiinɔnndo/ yiinun; Childs 2000, p. 406: yììnɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de yiiyo. yáwlen yiinɔnndo « ceindre la ceinture » (1KI.20.11).</text></form></note>
  </entry>
  <entry id="yiiyaa_6105">
    <lexical-unit><form lang="kqs"><text>yiiyaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yiiyaa_6105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>égards pour un étranger</text></gloss>
      <gloss lang="en"><text>consideration for a stranger</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiiyaa</text></form></note>
    <note><form lang="fr"><text>La Bible a yiiyaa une fois (ISA.24.16), sens non confirmé.</text></form></note>
  </entry>
  <entry id="yiiyo_6106">
    <lexical-unit><form lang="kqs"><text>yiiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yii</text></form></variant>
    <sense id="yiiyo_6106_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>établir, conclure (alliance) ; poser, mettre ; ourdir (complot) ; attacher, lier</text></gloss>
      <gloss lang="en"><text>establish, make (covenant); set, put; hatch (a plot); tie, bind</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tie up, wrap; make a charm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first GEN.26.28; Paulme 1964, p. 127: yi /ou tyi/; Lexique kissi–français, p. 65: yiio/ yii; Childs 2000, p. 407: yììyó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 65 : yiio/ yii « attacher » ; cf. maalon yiiyo tumbulan « nous liions des gerbes » (GEN.37.7). Paulme 1964, p. 127 : ɔ yi sambiyo « il attache le sambiyo » ; mi yi tumburã « j'ai attaché les gerbes ».</text></form></note>
  </entry>
  <entry id="yiiyo vando luɛɔ_6107">
    <lexical-unit><form lang="kqs"><text>yiiyo vando luɛɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yiiyo vando luɛɔ_6107_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espérance, confiance en qqn</text></gloss>
      <gloss lang="en"><text>hope, trust in someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yiiyo vando luɛɔ</text></form></note>
    <note><form lang="fr"><text>Expression telle que le Lexique l'écrit ; forme à vérifier.</text></form></note>
  </entry>
  <entry id="yiiŋii_6108">
    <lexical-unit><form lang="kqs"><text>yiiŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="yiiŋii_6108_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poils, pelage</text></gloss>
      <gloss lang="en"><text>body hair, hair</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 78 occurrences, first GEN.25.25</text></form></note>
  </entry>
  <entry id="yiiŋii lakoongoei_6109">
    <lexical-unit><form lang="kqs"><text>yiiŋii lakoongoei</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiiŋii lakoongoei_6109_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cils</text></gloss>
      <gloss lang="en"><text>eyelashes</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yiinhii lakoongoei; Lexique kissi–français, p. 65: yiiŋii lakoongoei</text></form></note>
  </entry>
  <entry id="yiiŋii lamilinde_6110">
    <lexical-unit><form lang="kqs"><text>yiiŋii lamilinde</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yiiŋii lamilinde_6110_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>moustache</text></gloss>
      <gloss lang="en"><text>moustache</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.5 Hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yiinhii lamilinde; Lexique kissi–français, p. 65: yiiŋii lamilinde</text></form></note>
  </entry>
  <entry id="yikilaa_6111">
    <lexical-unit><form lang="kqs"><text>yikilaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yikilaa_6111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouillie qui monte à la surface du riz cuit ; eau de cuisson du riz</text></gloss>
      <gloss lang="en"><text>starchy froth on top of cooked rice; rice-cooking water</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yikila; Lexique kissi–français, p. 65: yikilaa</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 127 : yikila « eau où l'on fait cuire le riz ».</text></form></note>
  </entry>
  <entry id="yikpa_6112">
    <lexical-unit><form lang="kqs"><text>yikpa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yikpa_6112_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enduire, recouvrir (de)</text></gloss>
      <gloss lang="en"><text>coat, overlay (with)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rub, grind, sharpen; apply plaster</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.6.14; Childs 2000, p. 407: yìkpàá</text></form></note>
  </entry>
  <entry id="yìkpáá_6113">
    <lexical-unit><form lang="kqs"><text>yìkpáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yìkpáá_6113_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>algues au fond de l'eau</text></gloss>
      <gloss lang="en"><text>algae at the bottom of water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.4 Moss, fungus, algae"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yìkpáá</text></form></note>
  </entry>
  <entry id="yíkpè-yìkpè_6114">
    <lexical-unit><form lang="kqs"><text>yíkpè-yìkpè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yíkpè-yìkpè_6114_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(secousse, tremblement : boue, herbe)</text></gloss>
      <gloss lang="en"><text>(shaking, quivering)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yíkpè-yìkpè</text></form></note>
  </entry>
  <entry id="yìkpɔ̀ɔ́_6115">
    <lexical-unit><form lang="kqs"><text>yìkpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yìkpɔ̀ɔ́_6115_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dépôt, sédiment (dans l'eau)</text></gloss>
      <gloss lang="en"><text>sediment in water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yìkpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yikɔma_6116">
    <lexical-unit><form lang="kqs"><text>yikɔma</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yikɔma_6116_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>variété de riz (grain rouge, moyen) apportée de Sierra Leone</text></gloss>
      <gloss lang="en"><text>rice variety (red, medium grain) brought from Sierra Leone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yikɔma</text></form></note>
    <note><form lang="fr"><text>Apportée par les Malinké (Paulme).</text></form></note>
  </entry>
  <entry id="yilamalio_6117">
    <lexical-unit><form lang="kqs"><text>yilamalio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yilamalio_6117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hippopotame</text></gloss>
      <gloss lang="en"><text>hippopotamus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127 (G): yilamalyo</text></form></note>
    <note><form lang="fr"><text>Voir aussi yilankamaa, yilankuo.</text></form></note>
  </entry>
  <entry id="yilankamaa_6118">
    <lexical-unit><form lang="kqs"><text>yilankamaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yirankamaa</text></form></variant>
    <sense id="yilankamaa_6118_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hippopotame</text></gloss>
      <gloss lang="en"><text>hippopotamus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128: yirakama, yirakɔma; Lexique kissi–français, p. 66: yirankamaa</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l. Cf. kamaa « éléphant ».</text></form></note>
  </entry>
  <entry id="yilankunndo_6119">
    <lexical-unit><form lang="kqs"><text>yilankunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yirankunndo</text></form></variant>
    <sense id="yilankunndo_6119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>météore, étoile filante</text></gloss>
      <gloss lang="en"><text>meteor, shooting star</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.1 Sun"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yirankunndo</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yilankuo_6120">
    <lexical-unit><form lang="kqs"><text>yilankuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yilankoa</text></form></field>
    <sense id="yilankuo_6120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hippopotame</text></gloss>
      <gloss lang="en"><text>hippopotamus</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128 (G): yirãnkuo, pl. yirankoa</text></form></note>
    <note><form lang="fr"><text>Voir aussi yilankamaa, yilamalio.</text></form></note>
  </entry>
  <entry id="yilanndo_6121">
    <lexical-unit><form lang="kqs"><text>yilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yilanndo_6121_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se saluer</text></gloss>
      <gloss lang="en"><text>greet each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Yilanndo; Lexique kissi–français, p. 65: yilanndo/ yilan</text></form></note>
    <note><form lang="fr"><text>Réciproque de yilɔɔ. Forme attestée dans la Bible : yilan (2KI 10,15). Le radical yilan est dans la Bible : La yilan niaa vana o nɛi le « ne saluez personne en chemin » (LUK.10.4).</text></form></note>
  </entry>
  <entry id="yilili_6122">
    <lexical-unit><form lang="kqs"><text>yilili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yilili_6122_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>désert, solitaire, isolé (lieu)</text></gloss>
      <gloss lang="en"><text>deserted, desolate, lonely (place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleepily, weakly, lackadaisically; by oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.32.10; Childs 2000, p. 407: yílílí</text></form></note>
    <note><form lang="fr"><text>Fondaa ho co bɔɔ yilili « cet endroit est désert » (MAT.14.15) ; o fonda yilili « dans un lieu désolé » (DEU.32.10). Rapprochement avec Childs (« seul, à l'écart ») à confirmer.</text></form></note>
  </entry>
  <entry id="yílímìŋndɛ̀ŋ_6123">
    <lexical-unit><form lang="kqs"><text>yílímìŋndɛ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílímìŋndɛ̀ŋ_6123_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entassés ; indistinct (dans la nuit, la foule)</text></gloss>
      <gloss lang="en"><text>all piled together; unrecognizable (in the dark, a crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílímìŋndɛ̀ŋ</text></form></note>
  </entry>
  <entry id="yilisio_6124">
    <lexical-unit><form lang="kqs"><text>yilisio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yirisio</text></form></variant>
    <sense id="yilisio_6124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>richesse ; s'enrichir</text></gloss>
      <gloss lang="en"><text>wealth; become rich</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yirisio</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yílíŋ_6125">
    <lexical-unit><form lang="kqs"><text>yílíŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílíŋ_6125_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(groupe informe, attroupement)</text></gloss>
      <gloss lang="en"><text>(amorphous group, crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílíŋ</text></form></note>
  </entry>
  <entry id="yilɔɔ_6126">
    <lexical-unit><form lang="kqs"><text>yilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yil</text></form></variant>
    <variant><form lang="kqs"><text>yilnin</text></form></variant>
    <sense id="yilɔɔ_6126_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saluer ; épouser (une femme)</text></gloss>
      <gloss lang="en"><text>greet; marry (a wife)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greet or salute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.24.7; Keita 1979, p. 114: Yilöö; Paulme 1964, p. 127: yil, pl. yilɔlɛ̃; Lexique kissi–français, p. 65: yilɔɔ/ yil; Childs 2000, p. 407: yìlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, yil lanɔɔ « prendre femme » (GEN 4,19 ; 24,7) ; yil « saluer, s'adresser à » (GEN 27,18). Paulme 1964, p. 127 : ɔ yil bɔndua re « il ne salue pas les vieux » ; yilɔ i diyo « salut du matin » ; yilɔ tyɔllɔ « salut de l'après-midi ».</text></form></note>
  </entry>
  <entry id="yilɔɔ kɔl diandaa_6127">
    <lexical-unit><form lang="kqs"><text>yilɔɔ kɔl diandaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yilɔɔ kɔl diandaa_6127_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marche de fidélité</text></gloss>
      <gloss lang="en"><text>loyalty march</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 414: Yilöö köl diandaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Mots attestés séparément dans la Bible, pas l'expression.</text></form></note>
  </entry>
  <entry id="yimballo_6128">
    <lexical-unit><form lang="kqs"><text>yimballo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yimballo_6128_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante (espèce) du rituel du yallo</text></gloss>
      <gloss lang="en"><text>plant (species) used in the yallo ritual</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yimballo</text></form></note>
    <note><form lang="fr"><text>À Tengia (Paulme).</text></form></note>
  </entry>
  <entry id="yimbu_6129">
    <lexical-unit><form lang="kqs"><text>yimbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimbɔɔ</text></form></variant>
    <sense id="yimbu_6129_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser en broussaille, croître sans soin (cheveux) ; (chemins) devenir déserts, envahis</text></gloss>
      <gloss lang="en"><text>grow wild, grow long (hair); (roads) become deserted, overgrown</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) overgrown, bushy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first LEV.26.22; Childs 2000, p. 408: yìmbàà</text></form></note>
    <note><form lang="fr"><text>yiiŋii ndɔɛi yimbu « ses cheveux poussèrent » (DAN.4.30) ; nɛila niaalan la yimbu « vos chemins seront déserts » (LEV.26.22) ; mal bolii ndɛi yimbɔɔ « laisser pousser leurs cheveux » (EZK.44.20).</text></form></note>
  </entry>
  <entry id="yimbɔɔ_6130">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yimbɔɔ_6130_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam (Keita) ; tambour vertical à sonnailles</text></gloss>
      <gloss lang="en"><text>drum (Keita); upright drum with jingles</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Yimböö; Paulme 1964, p. 37: imbo, yimbo, pl. yimbora</text></form></note>
    <note><form lang="fr"><text>La seule occurrence biblique (Ez 44,20) ne signifie pas « tam-tam » : elle se rattache à yimbu « devenir broussailleux, laisser pousser » (Dn 4,30). Sens de Keita à confirmer. Confirmé au Nord par Paulme 1964, p. 37 : imbo, yimbo, pl. yimbora « tambour vertical à sonnailles » ; yura yimbora, nom d'une danse.</text></form></note>
  </entry>
  <entry id="yimbɔɔ_6131">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="yimbɔɔ_6131_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam</text></gloss>
      <gloss lang="en"><text>drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yinbɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit nb. Homographe de yimbɔɔ « hirsute ».</text></form></note>
  </entry>
  <entry id="yimbɔɔ_6132">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yimbɔɔ_6132_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sale, négligé ; (tête) non coiffée, hirsute</text></gloss>
      <gloss lang="en"><text>dirty, unkempt; (hair) uncombed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.44.20; Lexique kissi–français, p. 66: yinbɔɔ</text></form></note>
    <note><form lang="fr"><text>Le Lexique : « sale, étouffé, poussé trop ; une tête non-coiffée ». Sens de EZK.44.20 (cheveux laissés longs) à vérifier.</text></form></note>
  </entry>
  <entry id="yimi_6133">
    <lexical-unit><form lang="kqs"><text>yimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimiyimi</text></form></variant>
    <variant><form lang="kqs"><text>yimio</text></form></variant>
    <sense id="yimi_6133_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser, broyer</text></gloss>
      <gloss lang="en"><text>break, crush</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break into small pieces</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 26 occurrences, first NUM.24.8; Lexique kissi–français, p. 66: yimio/ yimi; Childs 2000, p. 408: yìmìó</text></form></note>
    <note><form lang="fr"><text>yimiyimi « briser en morceaux » (Lv 2,6). Lexique kissi–français, p. 65-66 : yimio/ yimi « casser en morceaux ».</text></form></note>
  </entry>
  <entry id="yimiyimioo_6134">
    <lexical-unit><form lang="kqs"><text>yimiyimioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yimiyimioo_6134_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser</text></gloss>
      <gloss lang="en"><text>smash, break</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 122: Yimiyimioo, pesioo, piölöö vövvö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi pesioo, piɔlɔɔ vɔvvɔ (cf. piɔlɔ vɔvvɔ « anéantir »).</text></form></note>
  </entry>
  <entry id="yimɔɔ_6135">
    <lexical-unit><form lang="kqs"><text>yimɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yimɔɔ_6135_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>gronder (tonnerre) ; se lever avec un grand bruit ; bruit de la pluie</text></gloss>
      <gloss lang="en"><text>rumble (thunder); rise with a great noise; sound of rain</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yimɔɔ/ yim; Childs 2000, p. 408: yìmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 65-66 (yimɔɔ/ yim « se lever avec un grand bruit ; le bruit de la pluie »).</text></form></note>
  </entry>
  <entry id="yímɔ̀ɔ̀_6136">
    <lexical-unit><form lang="kqs"><text>yímɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yímɔ̀ɔ̀_6136_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>silencieusement</text></gloss>
      <gloss lang="en"><text>quietly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 408: yímɔ̀ɔ̀</text></form></note>
  </entry>
  <entry id="yinda_6137">
    <lexical-unit><form lang="kqs"><text>yinda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yinda_6137_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sommeiller</text></gloss>
      <gloss lang="en"><text>slumber, doze</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7 Sleep"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first PSA.121.4; Lexique kissi–français, p. 66: yindaa/ yinda</text></form></note>
    <note><form lang="fr"><text>Forme longue yindaa (Lexique), absente de la Bible. Ne pas confondre avec yìndàá (kissi du Sud).</text></form></note>
  </entry>
  <entry id="yìndàá_6138">
    <lexical-unit><form lang="kqs"><text>yìndàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yìndàá_6138_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vagin, sexe de la femme</text></gloss>
      <gloss lang="en"><text>vagina</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 408: yìndàá</text></form></note>
  </entry>
  <entry id="yindemi_6139">
    <lexical-unit><form lang="kqs"><text>yindemi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yindemi_6139_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>premier mois, début de la saison sèche</text></gloss>
      <gloss lang="en"><text>first month, start of the dry season</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 128: yindemi</text></form></note>
    <note><form lang="fr"><text>Paulme marque le mot « Sud ».</text></form></note>
  </entry>
  <entry id="yindima_6140">
    <lexical-unit><form lang="kqs"><text>yindima</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yindima_6140_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>temps morne et sombre</text></gloss>
      <gloss lang="en"><text>dull, overcast weather</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 66: yindima</text></form></note>
  </entry>
  <entry id="yindimiiyo_6141">
    <lexical-unit><form lang="kqs"><text>yindimiiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yindimiiyo_6141_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>décembre</text></gloss>
      <gloss lang="en"><text>December</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Yindimiiyo; Lexique kissi–français, p. 66: yindimiiyo; Terminologie (langue), n° 448: Yindimiiyo ✎ 4</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, langue n° 448) : « décembre », numéroté à la main 4.</text></form></note>
  </entry>
  <entry id="yindɔɔ_6142">
    <lexical-unit><form lang="kqs"><text>yindɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yindɔlan</text></form></field>
    <variant><form lang="kqs"><text>yindɔ</text></form></variant>
    <variant><form lang="kqs"><text>yindɔla</text></form></variant>
    <sense id="yindɔɔ_6142_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>toit</text></gloss>
      <gloss lang="en"><text>roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.6.16; Lexique kissi–français, p. 66: yindɔɔ; Childs 2000, p. 408: yìndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yinga_6143">
    <lexical-unit><form lang="kqs"><text>yinga</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yinga_6143_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réveiller (en sursaut), s'éveiller ; se lever d'un bond, surgir</text></gloss>
      <gloss lang="en"><text>wake up (with a start), awake; jump up, spring up</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.7.3 Wake up"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.41.4; Lexique kissi–français, p. 66: yingaa/ yinga</text></form></note>
    <note><form lang="fr"><text>mó yinga mɛɛ vana tiandu o lɔan « il s'éveilla comme un dormeur » (PSA.78.65). Lexique kissi–français, p. 66 : yingaa/ yinga « surgir, se lever d'un bond, se lever brusquement ».</text></form></note>
  </entry>
  <entry id="yingilaa_6144">
    <lexical-unit><form lang="kqs"><text>yingilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yingila</text></form></variant>
    <sense id="yingilaa_6144_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>profond ; profondeur</text></gloss>
      <gloss lang="en"><text>deep; depth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be deep (verb)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.37.20; Paulme 1964, p. 128: yiŋila; Lexique kissi–français, p. 66: yingila; Childs 2000, p. 408: yìŋìlàá</text></form></note>
    <note><form lang="fr"><text>soon yingilaa « fosse profonde ». Paulme 1964, p. 128 : kɔlɔndo yiŋila « le puits est profond ».</text></form></note>
  </entry>
  <entry id="yingo-yingo_6145">
    <lexical-unit><form lang="kqs"><text>yingo-yingo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yingo-yingo_6145_s1">
      <grammatical-info value="Ideophone"/>
