    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fùndɛ̀í</text></form></field>
    <sense id="fùndàá_913_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre lianescent à croissance rapide (haies de défense ; écorce jadis vêtement)</text></gloss>
      <gloss lang="en"><text>fast-growing vine-like tree (town fortifications; bark once used for clothing)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 113: fùndàá</text></form></note>
  </entry>
  <entry id="fungbula_914">
    <lexical-unit><form lang="kqs"><text>fungbula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fungbulan</text></form></variant>
    <sense id="fungbula_914_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>meurtrissures, plaies, blessures (des coups)</text></gloss>
      <gloss lang="en"><text>bruises, welts, wounds (from blows)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>welt, swelling from a blow or insect bite</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.16.8; Childs 2000, p. 113: fùŋgbòó</text></form></note>
    <note><form lang="fr"><text>Pluriel. le fungbula ndɔlan naa n sengu ni « c'est par ses meurtrissures que nous sommes guéris » (ISA.53.5).</text></form></note>
  </entry>
  <entry id="fungoo_915">
    <lexical-unit><form lang="kqs"><text>fungoo</text></form></lexical-unit>
