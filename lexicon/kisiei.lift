    <note type="source"><form lang="en"><text>Childs 2000, p. 87: dòndópólòó</text></form></note>
  </entry>
  <entry id="dóndóŋkùó_814">
    <lexical-unit><form lang="kqs"><text>dóndóŋkùó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dóndóŋkùá</text></form></field>
    <sense id="dóndóŋkùó_814_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petite grenouille verte à ventre rougeâtre</text></gloss>
      <gloss lang="en"><text>small green frog with a reddish belly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 86: dóndóŋkùó</text></form></note>
  </entry>
  <entry id="donia tusio_815">
    <lexical-unit><form lang="kqs"><text>donia tusio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="donia tusio_815_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abaisser</text></gloss>
      <gloss lang="en"><text>lower</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: donia tusio</text></form></note>
    <note><form lang="fr"><text>Comparer tuisio « abaisser » (Bible).</text></form></note>
  </entry>
  <entry id="doo_816">
    <lexical-unit><form lang="kqs"><text>doo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="doo_816_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte</text></gloss>
      <gloss lang="en"><text>door</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: doo</text></form></note>
    <note><form lang="fr"><text>La porte se dit koŋndo dans la Bible ; doo est à confirmer.</text></form></note>
  </entry>
  <entry id="doolaa_817">
    <lexical-unit><form lang="kqs"><text>doolaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doola</text></form></variant>
    <variant><form lang="kqs"><text>doolala</text></form></variant>
    <sense id="doolaa_817_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pressoir (à vin)</text></gloss>
      <gloss lang="en"><text>winepress</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JDG.6.11</text></form></note>
  </entry>
  <entry id="doosulen_818">
    <lexical-unit><form lang="kqs"><text>doosulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doosule</text></form></variant>
    <sense id="doosulen_818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasse</text></gloss>
      <gloss lang="en"><text>hunting, the hunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.25.29; Lexique kissi–français, p. 14: dosolen; Childs 2000, p. 87: dòòsùléŋ</text></form></note>
    <note><form lang="fr"><text>kɔɛ doosulen « aller à la chasse ». Cf. doosunɔɔ « chasseur ». Lexique kissi–français, p. 14 : dosolen « la chasse à courre ».</text></form></note>
  </entry>
  <entry id="doosunɔɔ_819">
    <lexical-unit><form lang="kqs"><text>doosunɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="doosunɔɔ_819_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chasseur, oiseleur</text></gloss>
      <gloss lang="en"><text>hunter, fowler</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PRO.1.17; Keita 1979, p. 145: Doosunöö; Lexique kissi–français, p. 14: doosunɔɔ; Childs 2000, p. 87: dòòsùnɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 14 : aussi dosonɔɔ « le chasseur ».</text></form></note>
  </entry>
  <entry id="dovin_820">
    <lexical-unit><form lang="kqs"><text>dovin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dovin_820_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se parer, s'équiper</text></gloss>
      <gloss lang="en"><text>adorn oneself, equip oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.40.10</text></form></note>
    <note><form lang="fr"><text>Moyen de dovio. ɲɛm kɛndɛn n'dovin-ndon « tes belles parures » (Ez 16,39).</text></form></note>
  </entry>
  <entry id="dovio_821">
    <lexical-unit><form lang="kqs"><text>dovio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dovi</text></form></variant>
    <sense id="dovio_821_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>charger (une bête) ; atteler, équiper ; revêtir (d'une armure)</text></gloss>
      <gloss lang="en"><text>load (an animal); harness, equip; clothe (in armour)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2KI.9.21</text></form></note>
  </entry>
  <entry id="downun_822">
    <lexical-unit><form lang="kqs"><text>downun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>downunnin</text></form></variant>
    <variant><form lang="kqs"><text>downɔnndo</text></form></variant>
    <sense id="downun_822_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>informer, donner des nouvelles (downun X kona « raconter à X »)</text></gloss>
      <gloss lang="en"><text>inform, report (downun X kona 'tell X the news')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first GEN.24.66</text></form></note>
  </entry>
  <entry id="doŋ_823">
    <lexical-unit><form lang="kqs"><text>doŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>doŋ-doŋ</text></form></variant>
    <sense id="doŋ_823_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>silencieusement, dans un calme complet (ɲɔɔ mei doŋ « tout se tut »)</text></gloss>
      <gloss lang="en"><text>silently, in complete calm (ɲɔɔ mei doŋ 'all was still')</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>quietly, silently, gently</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.64.9; Childs 2000, p. 87: dóŋ</text></form></note>
    <note><form lang="fr"><text>doŋ-doŋ (ISA.64.9, REV.8.1).</text></form></note>
  </entry>
  <entry id="dóŋdóŋndó_824">
    <lexical-unit><form lang="kqs"><text>dóŋdóŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dóŋdóŋndó_824_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>février (mois calme)</text></gloss>
      <gloss lang="en"><text>February (the quiet month)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 87: dóŋdóŋndó</text></form></note>
    <note><form lang="fr"><text>Lié à dóŋ « silencieusement ».</text></form></note>
  </entry>
  <entry id="dóŋó-dóŋó_825">
    <lexical-unit><form lang="kqs"><text>dóŋó-dóŋó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dóŋó-dóŋó_825_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>en foule serrée, grouillant</text></gloss>
      <gloss lang="en"><text>crowded together, swarming</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 87: dóŋó-dóŋó</text></form></note>
  </entry>
  <entry id="dù-dù_826">
    <lexical-unit><form lang="kqs"><text>dù-dù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dù-dù_826_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>battement accéléré du cœur, élancement (de la tête)</text></gloss>
      <gloss lang="en"><text>racing heartbeat, throbbing (of the head)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dù-dù ...</text></form></note>
  </entry>
  <entry id="dua_827">
    <lexical-unit><form lang="kqs"><text>dua</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dua_827_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>charognard (grand oiseau)</text></gloss>
      <gloss lang="en"><text>vulture</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: dua</text></form></note>
    <note><form lang="fr"><text>Lexique : « un grand oiseau qui s'appelle charognard ». Ne pas confondre avec duaa « bénédiction ».</text></form></note>
  </entry>
  <entry id="duaa_828">
    <lexical-unit><form lang="kqs"><text>duaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="duaa_828_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bénédiction ; bonheur</text></gloss>
      <gloss lang="en"><text>blessing; happiness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 384 occurrences, first GEN.1.22; Lexique kissi–français, p. 14: dua</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 14 écrit dua « la bénédiction ».</text></form></note>
  </entry>
  <entry id="dubalenndo_829">
    <lexical-unit><form lang="kqs"><text>dubalenndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dubalenndo_829_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>miroir</text></gloss>
      <gloss lang="en"><text>mirror</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.4 Adornment"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: dubalenndo</text></form></note>
  </entry>
  <entry id="dúcɔ́_830">
    <lexical-unit><form lang="kqs"><text>dúcɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dúcɔ́_830_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entièrement, en rassemblant tout</text></gloss>
      <gloss lang="en"><text>completely, all gathered together</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dúcɔ́</text></form></note>
  </entry>
  <entry id="dúfìɛ̀_831">
    <lexical-unit><form lang="kqs"><text>dúfìɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="dúfìɛ̀_831_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>mou, moelleux (éponge, lit)</text></gloss>
      <gloss lang="en"><text>soft, squishy (sponge, bed)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dúfìɛ̀</text></form></note>
  </entry>
  <entry id="dùkúdùkú-sèndíó_832">
    <lexical-unit><form lang="kqs"><text>dùkúdùkú-sèndíó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dùkúdùkú-sèndíó_832_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte d'oiseau (des bas-fonds)</text></gloss>
      <gloss lang="en"><text>kind of bird (lives in swamps)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dùkúdùkú-sèndíó</text></form></note>
  </entry>
  <entry id="dúkúdúkùlan_833">
    <lexical-unit><form lang="kqs"><text>dúkúdúkùlan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dúkúdúkùla</text></form></variant>
    <sense id="dúkúdúkùlan_833_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collines, buttes, bosses (du terrain) ; tertre, petite île</text></gloss>
      <gloss lang="en"><text>hills, humps, rounded heights; mound, islet</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(ideophone) stout, stocky, short and round</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.68.16; Lexique kissi–français, p. 14: dukudukuo; Childs 2000, p. 90: dùkúlú</text></form></note>
    <note><form lang="fr"><text>Pluriel. Pembii nɔ dúkúdúkùlan « montagne aux nombreux sommets » (PSA.68.16). Lexique kissi–français, p. 14 : singulier dukudukuo « une petite île ; un tertre sur la route ; un endroit haut dans le champ ».</text></form></note>
  </entry>
  <entry id="dulunndo_834">
    <lexical-unit><form lang="kqs"><text>dulunndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="dulunndo_834_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coude</text></gloss>
      <gloss lang="en"><text>elbow</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="2.1.6 Bone, joint"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 131: Dulunndo; Lexique kissi–français, p. 14: dulunndo; Childs 2000, p. 91: dùŋndó</text></form></note>
  </entry>
  <entry id="dúmbú_835">
    <lexical-unit><form lang="kqs"><text>dúmbú</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dúmbú_835_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trahison ; (yii … dúmbú) trahir, tromper</text></gloss>
      <gloss lang="en"><text>treachery; (yii … dúmbú) betray, deceive</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.21.23</text></form></note>
  </entry>
  <entry id="dumbu kilitia_836">
    <lexical-unit><form lang="kqs"><text>dumbu kilitia</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dumbu kilitia_836_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>religion chrétienne (Keita)</text></gloss>
      <gloss lang="en"><text>Christian religion (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Dumbu kilitia; Lexique kissi–français, p. 14: dunbu kilitia</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, dúmbú signifie « tromperie, ruse » (Gn 27,36) ; forme et sens à confirmer. Confirmé par le Lexique kissi–français, p. 14 (dunbu kilitia « la religion chrétienne »).</text></form></note>
  </entry>
  <entry id="dùmbúéí_837">
    <lexical-unit><form lang="kqs"><text>dùmbúéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dùmbǒŋ</text></form></field>
    <sense id="dùmbúéí_837_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jarre en terre pour conserver viande ou huile</text></gloss>
      <gloss lang="en"><text>clay pot for storing meat or oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 90: dùmbúéí</text></form></note>
  </entry>
  <entry id="dumbulen_838">
    <lexical-unit><form lang="kqs"><text>dumbulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dumbon</text></form></field>
    <variant><form lang="kqs"><text>dumbule</text></form></variant>
    <variant><form lang="kqs"><text>dumbun</text></form></variant>
    <sense id="dumbulen_838_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racine ; souche</text></gloss>
      <gloss lang="en"><text>root; stock</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>buttress or stilt roots, roots standing above the ground</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.14.30; Lexique kissi–français, p. 14: dunbulen; Childs 2000, p. 90: dùmbùéí</text></form></note>
    <note><form lang="fr"><text>dumbule ndɔlen le vesa « leur racine est desséchée » (HOS.9.16) ; mó soli dumbon « elle poussa des racines » (PSA.80.10) ; o dumbun ndɔn « de ses racines » (ISA.11.1). Lexique kissi–français, p. 14 : dunbulen « la racine », pluriel dunbulan, dunburan (le Lexique écrit nb pour mb).</text></form></note>
  </entry>
  <entry id="dumbullen_839">
    <lexical-unit><form lang="kqs"><text>dumbullen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="dumbullen_839_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>citron vert</text></gloss>
      <gloss lang="en"><text>lime (fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 14: dunbullen</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit dunbullen (nb pour mb).</text></form></note>
  </entry>
  <entry id="dundoo_840">
    <lexical-unit><form lang="kqs"><text>dundoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dundulan</text></form></field>
    <sense id="dundoo_840_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour, tambourin</text></gloss>
      <gloss lang="en"><text>drum, tambourine</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>big round drum, bass drum</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first EXO.15.20; Keita 1979, p. 163: Dunduo; Lexique kissi–français, p. 14: dunduo; Childs 2000, p. 91: dùndòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Dunduo ; la Bible écrit dundoo. Lexique kissi–français, p. 14 : dunduo « le tambour ».</text></form></note>
  </entry>
  <entry id="dùndúsɔ̀ɔ́_841">
    <lexical-unit><form lang="kqs"><text>dùndúsɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>dùndúsɔ̀ɔ́wá</text></form></field>
    <sense id="dùndúsɔ̀ɔ́_841_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit crapaud brun à dos rugueux (qui se gonfle)</text></gloss>
      <gloss lang="en"><text>small brown rough-backed toad (puffs up)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 91: dùndúsɔ̀ɔ́</text></form></note>
  </entry>
