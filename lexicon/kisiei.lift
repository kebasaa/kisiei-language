      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>secret militaire</text></gloss>
      <gloss lang="en"><text>military secret</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 591: Kpema salavusoo, työömuule salavusoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi cɔɔmuule salavusoo.</text></form></note>
  </entry>
  <entry id="kpemaa_2422">
    <lexical-unit><form lang="kqs"><text>kpemaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kpema</text></form></variant>
    <variant><form lang="kqs"><text>kpemala</text></form></variant>
    <sense id="kpemaa_2422_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pacte, alliance</text></gloss>
      <gloss lang="en"><text>pact, covenant ; covenant, agreement</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pact, covenant; also a vow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 298 occurrences, first GEN.6.18; Keita 1979, p. 156: Kpemaa; Lexique kissi–français, p. 28: kpemaa; Terminologie (histoire), n° 443: Kpemaa; Childs 2000, p. 210: kpémáá</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 443, 446, 447) : « objectif militaire, pacte » ; kpema delɔɔcoovo « pacte colonial ».</text></form></note>
  </entry>
  <entry id="kpen_2423">
