  <entry id="kiallo_1344">
    <lexical-unit><form lang="kqs"><text>kiallo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kialla</text></form></field>
    <variant><form lang="kqs"><text>kial</text></form></variant>
    <sense id="kiallo_1344_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gazelle, biche ; (kial piaandoo) cerf</text></gloss>
      <gloss lang="en"><text>gazelle, hind; (kial piaandoo) deer, hart</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bushbuck, harnessed antelope</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.14.5; Childs 2000, p. 162: kìálló</text></form></note>
  </entry>
  <entry id="kííbɔ̀ŋíìyó_1345">
    <lexical-unit><form lang="kqs"><text>kííbɔ̀ŋíìyó</text></form></lexical-unit>
