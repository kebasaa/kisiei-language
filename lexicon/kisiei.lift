      <gloss lang="en"><text>Bible</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Bibuloo</text></form></note>
  </entry>
  <entry id="bidiin_65">
    <lexical-unit><form lang="kqs"><text>bidiin</text></form></lexical-unit>
