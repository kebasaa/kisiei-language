    <sense id="koni_1692_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>aussi, de même (lende koni « de même »)</text></gloss>
      <gloss lang="en"><text>also, likewise (lende koni 'likewise')</text></gloss>
