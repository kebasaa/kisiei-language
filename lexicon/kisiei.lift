    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kòlìyòmbòó kòlìyòmbùéí</text></form></note>
  </entry>
  <entry id="kollo_2194">
    <lexical-unit><form lang="kqs"><text>kollo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kollo_2194_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>noix de cola</text></gloss>
      <gloss lang="en"><text>kola nut</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>kola nut, kola tree (Cola nitida); Adam's apple</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Kollo; Paulme 1964, p. 50: kullo, pl. kulle; Lexique kissi–français, p. 25: kollo; Childs 2000, p. 173: kòlló</text></form></note>
    <note><form lang="fr"><text>Pluriel kolle selon Keita (p. 27). Paulme 1964, p. 50 : kullo, pl. kulle « kola ».</text></form></note>
  </entry>
  <entry id="kolo mayendioo_2195">
    <lexical-unit><form lang="kqs"><text>kolo mayendioo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kolo mayendioo_2195_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>jaune</text></gloss>
      <gloss lang="en"><text>yellow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 162: Kolo mayendioo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="kolokoloo_2196">
    <lexical-unit><form lang="kqs"><text>kolokoloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>kolokololan</text></form></field>
    <variant><form lang="kqs"><text>kolokolo</text></form></variant>
    <sense id="kolokoloo_2196_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coin de rue, angle ; (pl.) carrefours, places</text></gloss>
      <gloss lang="en"><text>corner, street corner; (pl.) street corners, open places</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>corner, space between two houses</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first NEH.3.24; Childs 2000, p. 173: kòlòkòlóó</text></form></note>
    <note><form lang="fr"><text>mó kei o kolokoloo pum ikɛi « il passa près de l'angle (de sa rue) » (PRO.7.8) ; o kolokololan kpow ikɛi « à tous les coins de rue » (PRO.7.12).</text></form></note>
  </entry>
  <entry id="kolole_2197">
    <lexical-unit><form lang="kqs"><text>kolole</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kolea</text></form></field>
    <sense id="kolole_2197_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fouet pour toupie (jeu d'enfant)</text></gloss>
      <gloss lang="en"><text>whip for a spinning top (children's game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: korole, pl. korea</text></form></note>
    <note><form lang="fr"><text>Cf. kɔlulen « fouet » (Bible).</text></form></note>
  </entry>
  <entry id="kolombololen_2198">
    <lexical-unit><form lang="kqs"><text>kolombololen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="kolombololen_2198_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>larynx</text></gloss>
      <gloss lang="en"><text>larynx</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: koronborolen</text></form></note>
    <note><form lang="fr"><text>Écrit koronborolen ; r → l, nb → mb.</text></form></note>
  </entry>
  <entry id="kólómbómbó_2199">
    <lexical-unit><form lang="kqs"><text>kólómbómbó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kólómbómbó_2199_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout, absolument tout (registre aigu, vieilles femmes)</text></gloss>
      <gloss lang="en"><text>all, everything (high register, used by old women)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 173: kólómbómbó</text></form></note>
  </entry>
  <entry id="kolonɛlnɔɔ_2200">
