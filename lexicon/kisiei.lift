      <gloss lang="en"><text>governor, proconsul</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first LUK.2.2</text></form></note>
  </entry>
  <entry id="masaa_2227">
    <lexical-unit><form lang="kqs"><text>masaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="masaa_2227_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>roi, chef</text></gloss>
      <gloss lang="en"><text>king, chief</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6.1 Ruler"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chief</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2748 occurrences, first GEN.12.15; Keita 1979, p. 148: Masaa; Childs 2000, p. 242: màsàá</text></form></note>
  </entry>
  <entry id="másáá_2228">
    <lexical-unit><form lang="kqs"><text>másáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>másáléŋ</text></form></field>
    <sense id="másáá_2228_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pian (infection de la peau, surtout aux pieds)</text></gloss>
      <gloss lang="en"><text>yaws (skin infection, especially of the feet)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 243: másáá</text></form></note>
