    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 110: fùkpàá</text></form></note>
  </entry>
  <entry id="fúkpàà-fùkpàà_1031">
    <lexical-unit><form lang="kqs"><text>fúkpàà-fùkpàà</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fúkpàà-fùkpàà_1031_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(pleurer) à chaudes larmes, amèrement</text></gloss>
      <gloss lang="en"><text>(weep) bitterly, aloud</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.45.14</text></form></note>
  </entry>
  <entry id="fùkù-fùkù_1032">
    <lexical-unit><form lang="kqs"><text>fùkù-fùkù</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fùkù-fùkùei</text></form></variant>
    <variant><form lang="kqs"><text>fùkù-fùkùi</text></form></variant>
    <variant><form lang="kqs"><text>fùkù-fùkoo</text></form></variant>
    <sense id="fùkù-fùkù_1032_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>violent, impétueux (vent)</text></gloss>
      <gloss lang="en"><text>violent, stormy (wind)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first ISA.47.11</text></form></note>
    <note><form lang="fr"><text>hoeyii fùkù-fùkùei « tempête, vent violent » ; piɔɔ hoeyii fùkù-fùkoo « orage ».</text></form></note>
  </entry>
  <entry id="fula_1033">
    <lexical-unit><form lang="kqs"><text>fula</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fulanin</text></form></variant>
    <variant><form lang="kqs"><text>fulan</text></form></variant>
    <sense id="fula_1033_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sortir ; venir de, provenir ; apparaître</text></gloss>
      <gloss lang="en"><text>go out, come out; come from; appear</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go or come out, leave; also shine (sun), beat (heart); resemble</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2126 occurrences, first GEN.1.6; Lexique kissi–français, p. 16: fura; Childs 2000, p. 111: fùlàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 16 : fura « apparaître ; sortir ; partir » ; fura cien « sortir, être divulgué ; apparaître » ; furula cien « apparaître à ».</text></form></note>
  </entry>
  <entry id="fulaa_1034">
    <lexical-unit><form lang="kqs"><text>fulaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fula</text></form></variant>
    <variant><form lang="kqs"><text>fulanin</text></form></variant>
    <variant><form lang="kqs"><text>fulan</text></form></variant>
    <sense id="fulaa_1034_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sortir</text></gloss>
      <gloss lang="en"><text>go out, come out</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go or come out, leave</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 690 occurrences, first GEN.2.6; Keita 1979, p. 110: Fulaa; Lexique kissi–français, p. 16: fulaa/ fula; Childs 2000, p. 111: fùlàá</text></form></note>
    <note><form lang="fr"><text>Bénéfactif fulal « sortir vers, apparaître à ».</text></form></note>
  </entry>
  <entry id="fulakɔlio_1035">
    <lexical-unit><form lang="kqs"><text>fulakɔlio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="fulakɔlio_1035_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>trahison</text></gloss>
      <gloss lang="en"><text>betrayal</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Fulakölio; Lexique kissi–français, p. 16: fulakɔlio</text></form></note>
  </entry>
  <entry id="fulal_1036">
    <lexical-unit><form lang="kqs"><text>fulal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>fulal-le</text></form></variant>
    <sense id="fulal_1036_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apparaître à, se montrer à ; surgir contre, tomber sur (l'ennemi)</text></gloss>
      <gloss lang="en"><text>appear to; come out against, fall upon (an enemy)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>go out for someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first JDG.6.12; Childs 2000, p. 111: fùlàlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de fula « sortir ». mɛlɛkanɔ Hala-o fulal laa ndɔ « l'ange de Dieu apparut à la femme » (JDG.13.3) ; fulal nda fɛlɛmɛndɛn a cɔwvo « il fondit sur eux » (JDG.9.43).</text></form></note>
  </entry>
