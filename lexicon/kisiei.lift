  <entry id="bewvo_214">
    <lexical-unit><form lang="kqs"><text>bewvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bewvo_214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gencive ; trou laissé par une dent manquante ; cercle de roseaux à la base du toit d'une case</text></gloss>
      <gloss lang="en"><text>gum (of the teeth); gap left by a missing tooth; ring of reeds at the base of a hut roof</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 5: bewvo</text></form></note>
    <note><form lang="fr"><text>Deux articles dans le Lexique, p. 5. Cf. kandoncindo « gencive ».</text></form></note>
  </entry>
  <entry id="bèyó_215">
