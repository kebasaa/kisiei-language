    </sense>
    <note type="source"><form lang="en"><text>BKG: 65 occurrences, first GEN.9.13; Childs 2000, p. 346: tààmàsììyó</text></form></note>
  </entry>
  <entry id="tɔɔndan_1744">
    <lexical-unit><form lang="kqs"><text>tɔɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɔɔndanndo</text></form></variant>
    <sense id="tɔɔndan_1744_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>éprouver, mettre à l'épreuve ; tenter ; essayer</text></gloss>
      <gloss lang="en"><text>test, try; tempt; attempt</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.22.1</text></form></note>
