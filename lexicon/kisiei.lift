  <entry id="yìkpɔ̀ɔ́_3888">
    <lexical-unit><form lang="kqs"><text>yìkpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yìkpɔ̀ɔ́_3888_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dépôt, sédiment (dans l'eau)</text></gloss>
      <gloss lang="en"><text>sediment in water</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yìkpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yilanndo_3889">
    <lexical-unit><form lang="kqs"><text>yilanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yilanndo_3889_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se saluer</text></gloss>
      <gloss lang="en"><text>greet each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Yilanndo</text></form></note>
    <note><form lang="fr"><text>Réciproque de yilɔɔ. Forme attestée dans la Bible : yilan (2KI 10,15).</text></form></note>
  </entry>
  <entry id="yilili_3890">
    <lexical-unit><form lang="kqs"><text>yilili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yilili_3890_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>désert, solitaire, isolé (lieu)</text></gloss>
      <gloss lang="en"><text>deserted, desolate, lonely (place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.5.4 Area"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sleepily, weakly, lackadaisically; by oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first DEU.32.10; Childs 2000, p. 407: yílílí</text></form></note>
    <note><form lang="fr"><text>Fondaa ho co bɔɔ yilili « cet endroit est désert » (MAT.14.15) ; o fonda yilili « dans un lieu désolé » (DEU.32.10). Rapprochement avec Childs (« seul, à l'écart ») à confirmer.</text></form></note>
  </entry>
  <entry id="yílímìŋndɛ̀ŋ_3891">
    <lexical-unit><form lang="kqs"><text>yílímìŋndɛ̀ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílímìŋndɛ̀ŋ_3891_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>entassés ; indistinct (dans la nuit, la foule)</text></gloss>
      <gloss lang="en"><text>all piled together; unrecognizable (in the dark, a crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílímìŋndɛ̀ŋ</text></form></note>
  </entry>
  <entry id="yílíŋ_3892">
    <lexical-unit><form lang="kqs"><text>yílíŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yílíŋ_3892_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(groupe informe, attroupement)</text></gloss>
      <gloss lang="en"><text>(amorphous group, crowd)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 407: yílíŋ</text></form></note>
  </entry>
  <entry id="yilɔɔ_3893">
    <lexical-unit><form lang="kqs"><text>yilɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yil</text></form></variant>
    <variant><form lang="kqs"><text>yilnin</text></form></variant>
    <sense id="yilɔɔ_3893_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saluer ; épouser (une femme)</text></gloss>
      <gloss lang="en"><text>greet; marry (a wife)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greet or salute</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.24.7; Keita 1979, p. 114: Yilöö; Childs 2000, p. 407: yìlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, yil lanɔɔ « prendre femme » (GEN 4,19 ; 24,7) ; yil « saluer, s'adresser à » (GEN 27,18).</text></form></note>
  </entry>
  <entry id="yimbu_3894">
    <lexical-unit><form lang="kqs"><text>yimbu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimbɔɔ</text></form></variant>
    <sense id="yimbu_3894_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser en broussaille, croître sans soin (cheveux) ; (chemins) devenir déserts, envahis</text></gloss>
      <gloss lang="en"><text>grow wild, grow long (hair); (roads) become deserted, overgrown</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) overgrown, bushy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first LEV.26.22; Childs 2000, p. 408: yìmbàà</text></form></note>
    <note><form lang="fr"><text>yiiŋii ndɔɛi yimbu « ses cheveux poussèrent » (DAN.4.30) ; nɛila niaalan la yimbu « vos chemins seront déserts » (LEV.26.22) ; mal bolii ndɛi yimbɔɔ « laisser pousser leurs cheveux » (EZK.44.20).</text></form></note>
  </entry>
  <entry id="yimbɔɔ_3895">
    <lexical-unit><form lang="kqs"><text>yimbɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="yimbɔɔ_3895_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tam-tam (Keita)</text></gloss>
      <gloss lang="en"><text>drum (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Yimböö</text></form></note>
    <note><form lang="fr"><text>La seule occurrence biblique (Ez 44,20) ne signifie pas « tam-tam » : elle se rattache à yimbu « devenir broussailleux, laisser pousser » (Dn 4,30). Sens de Keita à confirmer.</text></form></note>
  </entry>
  <entry id="yimi_3896">
    <lexical-unit><form lang="kqs"><text>yimi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yimiyimi</text></form></variant>
    <sense id="yimi_3896_s1">
