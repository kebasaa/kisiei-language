      <gloss lang="fr"><text>potage, bouillon</text></gloss>
      <gloss lang="en"><text>pottage, stew, broth</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thin watery sauce served over rice, residue left after making palm oil</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 2KI.4.38; Childs 2000, p. 256: mbòòyàá</text></form></note>
    <note><form lang="fr"><text>mà yowlu naa mbooyaa « fais-nous cuire un potage » (2KI.4.38).</text></form></note>
  </entry>
