      <gloss lang="en"><text>fruit with a bitter oil</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: koelen</text></form></note>
  </entry>
  <entry id="koello_2168">
    <lexical-unit><form lang="kqs"><text>koello</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="koello_2168_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>marcher sur (sens militaire)</text></gloss>
      <gloss lang="en"><text>march on (military)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 423: Koello</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi « offensive » (idéologie n° 464, avec yangilan, cɛɛlanndo).</text></form></note>
  </entry>
  <entry id="koesio_2169">
    <lexical-unit><form lang="kqs"><text>koesio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>koesi</text></form></variant>
