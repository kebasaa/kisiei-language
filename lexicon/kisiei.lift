      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3295 occurrences, first GEN.2.19; Childs 2000, p. 223: láŋ</text></form></note>
  </entry>
  <entry id="làndàá_2346">
    <lexical-unit><form lang="kqs"><text>làndàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làndàá_2346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque (« diable ») au long museau</text></gloss>
      <gloss lang="en"><text>mask ('devil') with a long snout</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 222: làndàá</text></form></note>
    <note><form lang="fr"><text>Emprunt au bandi ou au loma ; même masque que ŋúɲàá.</text></form></note>
  </entry>
  <entry id="lándán_2347">
    <lexical-unit><form lang="kqs"><text>lándán</text></form></lexical-unit>
