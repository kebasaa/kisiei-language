    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Nimöö; Childs 2000, p. 263: nímɔ́ɔ́</text></form></note>
  </entry>
  <entry id="nin_2445">
    <lexical-unit><form lang="kqs"><text>nin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="nin_2445_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>dans (o … nin)</text></gloss>
      <gloss lang="en"><text>in, inside (o … nin)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
      <trait name="semantic-domain-ddp4" value="8.6.4 Inner part"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'from inside'; ó … nǐŋ also 'during, while'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11973 occurrences, first GEN.1.17; Childs 2000, p. 263: nǐŋ</text></form></note>
  </entry>
  <entry id="ningilaa_2446">
    <lexical-unit><form lang="kqs"><text>ningilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ningila</text></form></variant>
    <sense id="ningilaa_2446_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>luisant, (teint) éclatant ; gras, bien portant</text></gloss>
      <gloss lang="en"><text>shining, glowing (skin); fat, well-fed</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4 Body condition"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shining (?)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 1SA.17.42; Childs 2000, p. 263: nìŋgìlàá</text></form></note>
    <note><form lang="fr"><text>Souvent avec l'idéophone ningili : a ningilaa ningili « bien gras, florissant » (Jb 21,24 ; Ps 73,7).</text></form></note>
  </entry>
  <entry id="ninginangaa_2447">
    <lexical-unit><form lang="kqs"><text>ninginangaa</text></form></lexical-unit>
