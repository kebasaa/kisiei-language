    <sense id="kúsáŋ-kúsáŋ_1802_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>tout à coup ; poussiéreux (air de saison sèche)</text></gloss>
      <gloss lang="en"><text>all of a sudden; dusty (dry-season air)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 197: kúsáŋ-kúsáŋ</text></form></note>
  </entry>
  <entry id="kusuan_1803">
