    <note type="source"><form lang="en"><text>Childs 2000, p. 239: màásàlèìyó</text></form></note>
    <note><form lang="fr"><text>Emprunt probable au mendé.</text></form></note>
  </entry>
  <entry id="mààsííyó_2574">
    <lexical-unit><form lang="kqs"><text>mààsííyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
