      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 31: gbando</text></form></note>
    <note><form lang="fr"><text>Paulme donne deux fois ce mot (p. 31). Cf. bando, gbando (Myrianthus arboreus), p. 4.</text></form></note>
  </entry>
