      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkàá</text></form></note>
  </entry>
  <entry id="sàkàlàá_3365">
    <lexical-unit><form lang="kqs"><text>sàkàlàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sàkàlàá_3365_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (non comestible)</text></gloss>
      <gloss lang="en"><text>a tree species (inedible)</text></gloss>
