    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 210: kpélóó kpéléláŋ</text></form></note>
  </entry>
  <entry id="kpema lelɛnndo_2420">
    <lexical-unit><form lang="kqs"><text>kpema lelɛnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kpema lelɛnndo_2420_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>constitution</text></gloss>
      <gloss lang="en"><text>constitution</text></gloss>
