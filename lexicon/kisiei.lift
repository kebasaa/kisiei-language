    <field type="southern-kissi-sense"><form lang="en"><text>drink; also smoke (tobacco)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 191 occurrences, first GEN.24.19; Keita 1979, p. 110: Kolöö; Lexique kissi–français, p. 25: kolɔɔ/ kol; Childs 2000, p. 173: kɔ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 25 : kolɔɔ aussi « avoir soif ».</text></form></note>
  </entry>
  <entry id="komal_1672">
    <lexical-unit><form lang="kqs"><text>komal</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>komallo</text></form></variant>
    <variant><form lang="kqs"><text>komalnin</text></form></variant>
    <sense id="komal_1672_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>trouver, rencontrer ; voir</text></gloss>
      <gloss lang="en"><text>find, come upon; see</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6.2 Find"/>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 339 occurrences, first GEN.9.22</text></form></note>
  </entry>
  <entry id="kombaa_1673">
    <lexical-unit><form lang="kqs"><text>kombaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>komba</text></form></variant>
    <variant><form lang="kqs"><text>kombanin</text></form></variant>
    <sense id="kombaa_1673_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abattre, renverser</text></gloss>
      <gloss lang="en"><text>fell, knock down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cut down</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first DEU.19.5; Keita 1979, p. 110: Kombaa; Lexique kissi–français, p. 25: konbaa/ konba; Childs 2000, p. 174: kòmbàá</text></form></note>
  </entry>
  <entry id="kombiaa_1674">
    <lexical-unit><form lang="kqs"><text>kombiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kombiaa_1674_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>abattre, renverser (plusieurs)</text></gloss>
      <gloss lang="en"><text>fell, overthrow (many)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2SA.12.31; Keita 1979, p. 110: Kombiaa; Lexique kissi–français, p. 25: konbiaa/ konbia</text></form></note>
    <note><form lang="fr"><text>Pluriel de kombaa (HAG 2,22). Le Lexique kissi–français donne aussi : kombia.</text></form></note>
  </entry>
  <entry id="komolaa_1675">
    <lexical-unit><form lang="kqs"><text>komolaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>komola</text></form></variant>
    <sense id="komolaa_1675_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire la connaissance de qqn, trouver qqn</text></gloss>
      <gloss lang="en"><text>get to know someone, meet someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1 Relationships"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: komolaa/ komola</text></form></note>
  </entry>
  <entry id="komsaa_1676">
    <lexical-unit><form lang="kqs"><text>komsaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>komsa</text></form></variant>
    <sense id="komsaa_1676_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>femme qui allaite, nourrice ; femelle qui allaite</text></gloss>
      <gloss lang="en"><text>nursing mother, wet nurse; female with young</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.32.16; Lexique kissi–français, p. 25: komsa; Childs 2000, p. 174: kómsàá</text></form></note>
    <note><form lang="fr"><text>ɲɔɔmɛɛa komsaa « chamelles qui allaitent » (Gn 32,16).</text></form></note>
  </entry>
  <entry id="komɔɔ_1677">
    <lexical-unit><form lang="kqs"><text>komɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kom</text></form></variant>
    <variant><form lang="kqs"><text>koam</text></form></variant>
    <variant><form lang="kqs"><text>kum</text></form></variant>
    <variant><form lang="kqs"><text>koamnin</text></form></variant>
    <variant><form lang="kqs"><text>kumnin</text></form></variant>
    <sense id="komɔɔ_1677_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter des fruits, mettre bas ; fruit</text></gloss>
      <gloss lang="en"><text>bear fruit, bear young; fruit</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first GEN.3.6; Keita 1979, p. 115: Komöö; Lexique kissi–français, p. 25: komɔɔ/ kom, kum, koam; Childs 2000, p. 174: kòmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>kum, kumnin : radical négatif (HAB 3,17 ; LEV 26,20). komɔɔ est aussi le nom « fruit » (GEN 3,6).</text></form></note>
  </entry>
  <entry id="kon_1678">
    <lexical-unit><form lang="kqs"><text>kon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kon_1678_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>ce…-là (classe o)</text></gloss>
      <gloss lang="en"><text>that (o class)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>that (o class); also the default demonstrative for other classes</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9758 occurrences, first GEN.1.4; Lexique kissi–français, p. 25: kon; Childs 2000, p. 176: kòŋ</text></form></note>
  </entry>
  <entry id="konaa_1679">
    <lexical-unit><form lang="kqs"><text>konaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="konaa_1679_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nouvelles, récit, compte rendu ; (ɲuna … konaa) demander compte</text></gloss>
      <gloss lang="en"><text>news, report, account; (ɲuna … konaa) call to account</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>message, news, explanation</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.9.5; Childs 2000, p. 175: kónáá</text></form></note>
    <note><form lang="fr"><text>le ndu konaa downɔnndo « pour lui faire le récit (de la bataille) » (2SA.11.18) ; i ɲunanin konaa le man « je demanderai compte de votre sang » (GEN.9.5).</text></form></note>
  </entry>
  <entry id="konaa_1680">
    <lexical-unit><form lang="kqs"><text>konaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>kona</text></form></variant>
    <sense id="konaa_1680_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>accompagner</text></gloss>
      <gloss lang="en"><text>accompany</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.5 Accompany"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 25: konaa/ konaa</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, kona et konaa se rapportent à « raconter, nouvelles » (GEN.24.66 ; GEN.9.5) ; le sens « accompagner » du Lexique est à confirmer.</text></form></note>
  </entry>
  <entry id="kónándíóó_1681">
    <lexical-unit><form lang="kqs"><text>kónándíóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kónándíláŋ</text></form></field>
    <sense id="kónándíóó_1681_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>amertume</text></gloss>
      <gloss lang="en"><text>bitterness</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 175: kónándíóó kónándíláŋ</text></form></note>
  </entry>
  <entry id="kondalan_1682">
    <lexical-unit><form lang="kqs"><text>kondalan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kondala</text></form></variant>
    <sense id="kondalan_1682_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>greniers, granges</text></gloss>
      <gloss lang="en"><text>barns, storehouses</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.26.10; Lexique kissi–français, p. 25: kondaa</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé. Lexique kissi–français, p. 25 : singulier kondaa « le grenier ». Le Lexique kissi–français donne aussi : kondaa.</text></form></note>
  </entry>
  <entry id="kòndìyàá_1683">
