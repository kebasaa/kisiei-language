      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau pêcheur à long bec (martin-pêcheur ?)</text></gloss>
      <gloss lang="en"><text>long-billed fishing bird (kingfisher?)</text></gloss>
