    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɔɔmɛɛa</text></form></field>
    <variant><form lang="kqs"><text>ɲɔɔmɛɛ</text></form></variant>
    <variant><form lang="kqs"><text>ɲɔɔmɛaa</text></form></variant>
    <sense id="ɲɔɔmɛɔ_6578_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chameau</text></gloss>
      <gloss lang="en"><text>camel</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.24.64; Childs 2000, p. 281: ɲɔ̀míó</text></form></note>
  </entry>
  <entry id="ɲɔ̀ɔ́ɲɔ́ɔ̀_6579">
    <lexical-unit><form lang="kqs"><text>ɲɔ̀ɔ́ɲɔ́ɔ̀</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="ɲɔ̀ɔ́ɲɔ́ɔ̀_6579_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rien du tout</text></gloss>
      <gloss lang="en"><text>nothing at all</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 281: ɲɔ̀ɔ́ɲɔ́ɔ̀</text></form></note>
  </entry>
  <entry id="ɲɛ_6580">
    <lexical-unit><form lang="kqs"><text>ɲɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɛlan</text></form></field>
    <variant><form lang="kqs"><text>ɲɛm</text></form></variant>
    <variant><form lang="kqs"><text>ɲɛla</text></form></variant>
    <sense id="ɲɛ_6580_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose ; ce que</text></gloss>
      <gloss lang="en"><text>thing; what, that which</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>thing, something (ɲɛ̀- in compounds)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4401 occurrences, first GEN.1.2; Paulme 1964, p. 71: nyɛy; Lexique kissi–français, p. 39: ɲɛ; Childs 2000, p. 281: ɲɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>ɲɛla ɲaananndan « chars » (2 S 10,18). Paulme 1964, p. 71-72 : nyɛy « chose » (nyɛye fefele « aluminium », litt. chose légère) ; aussi « paiement, salaire » ; nyɛy diyo « la chose du matin, le soleil levant, de bonne heure » ; nyɛy mela « le dernier » ; nyɛy panday « chose achetée ».</text></form></note>
  </entry>
  <entry id="ɲɛ biŋilando_6581">
    <lexical-unit><form lang="kqs"><text>ɲɛ biŋilando</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ biŋilando_6581_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>choses mélangées (offrande aux morts impurs)</text></gloss>
      <gloss lang="en"><text>mixed things (offering to the impure dead)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 72: nyɛy biŋilando</text></form></note>
    <note><form lang="fr"><text>Paulme rapproche binyuwo « troubler ».</text></form></note>
  </entry>
  <entry id="ɲɛ bɛnduo_6582">
    <lexical-unit><form lang="kqs"><text>ɲɛ bɛnduo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ bɛnduo_6582_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rhombe</text></gloss>
      <gloss lang="en"><text>bullroarer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 72: nyebɛnduo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 72 : litt. « grande chose ».</text></form></note>
  </entry>
  <entry id="ɲɛ cɔm toɲaa-o_6583">
    <lexical-unit><form lang="kqs"><text>ɲɛ cɔm toɲaa-o</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ cɔm toɲaa-o_6583_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>preuve</text></gloss>
      <gloss lang="en"><text>proof</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.6 Sign, symbol"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 39: ɲɛ cɔm toɲaa o</text></form></note>
    <note><form lang="fr"><text>Litt. « la chose qui montre la vérité » ; mots attestés séparément dans la Bible, pas l'expression. Référent rattaché par un trait d'union comme dans la Bible.</text></form></note>
  </entry>
  <entry id="ɲɛ cɔw lakpundɔɔ_6584">
    <lexical-unit><form lang="kqs"><text>ɲɛ cɔw lakpundɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ cɔw lakpundɔɔ_6584_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arme nucléaire</text></gloss>
      <gloss lang="en"><text>nuclear weapon</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 68: Nyè työw lakpundöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="ɲɛ cɔwvo_6585">
    <lexical-unit><form lang="kqs"><text>ɲɛ cɔwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>ɲɛm cɔwvon</text></form></field>
    <sense id="ɲɛ cɔwvo_6585_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arme ; armement (pl.)</text></gloss>
      <gloss lang="en"><text>weapon; weapons</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Nyètyöwvo; Lexique kissi–français, p. 39: ɲɛcɔwvo; Terminologie (histoire), n° 66: Nyè työwvo</text></form></note>
    <note><form lang="fr"><text>Keita écrit en un mot Nyètyöwvo « l'arme » et Nyèmtyöwvon « l'armement » (p. 156) ; la Bible écrit ɲɛm cɔwvon (Nb 31,3). Lexique kissi–français, p. 39 écrit aussi en un mot : ɲɛcɔwvo « l'arme », ɲɛmcɔwvon « l'armement ». Académie des langues (terminologie, histoire n° 66 et 70) : « arme, armement » (pl. nyè työwvon).</text></form></note>
  </entry>
  <entry id="ɲɛ kpowvo_6586">
    <lexical-unit><form lang="kqs"><text>ɲɛ kpowvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ kpowvo_6586_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>collectif</text></gloss>
      <gloss lang="en"><text>collective</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 180: Nyè kpowvo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="ɲɛ lapisullo_6587">
    <lexical-unit><form lang="kqs"><text>ɲɛ lapisullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ lapisullo_6587_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jouet</text></gloss>
      <gloss lang="en"><text>toy</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 168: Nyè lapisullo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Litt. « chose pour jouer ».</text></form></note>
  </entry>
  <entry id="ɲɛ masindɛsindɔɔ_6588">
    <lexical-unit><form lang="kqs"><text>ɲɛ masindɛsindɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ masindɛsindɔɔ_6588_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>millénaire</text></gloss>
      <gloss lang="en"><text>millennium</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 428: Nyè masindèsindöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Idéologie n° 427 : sindɛ bɛnduo, vɔsiivaao.</text></form></note>
  </entry>
  <entry id="ɲɛ nanndo_6589">
    <lexical-unit><form lang="kqs"><text>ɲɛ nanndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ɲɛ nanndo_6589_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>ravissant</text></gloss>
      <gloss lang="en"><text>delightful</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 39: ɲɛ nanndo</text></form></note>
    <note><form lang="fr"><text>Expression du Lexique, découpage et graphie à confirmer (comparer naŋɔɔ « être bon, beau »).</text></form></note>
  </entry>
  <entry id="ɲɛ pilɛ_6590">
    <lexical-unit><form lang="kqs"><text>ɲɛ pilɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ pilɛ_6590_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de la même manière, pareil ; analogue</text></gloss>
      <gloss lang="en"><text>in the same way, alike; analogous</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 24: Nyè pilè</text></form></note>
    <note><form lang="fr"><text>Terme retenu par l'Académie des langues (années 1970) pour « analogue ». Dans la Bible, ɲɛ pilɛ (kon) « de la même manière » (JDG.8.8, 2SA.12.31).</text></form></note>
  </entry>
  <entry id="ɲɛ sɛnɛiye_6591">
    <lexical-unit><form lang="kqs"><text>ɲɛ sɛnɛiye</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ sɛnɛiye_6591_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de nouveau</text></gloss>
      <gloss lang="en"><text>again</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 72: nye saneye</text></form></note>
    <note><form lang="fr"><text>Respelled d'après sɛnɛiyo « nouveau » dans la Bible. Cf. vɛlɛ « de nouveau ».</text></form></note>
  </entry>
  <entry id="ɲɛ vɔɔndo_6592">
    <lexical-unit><form lang="kqs"><text>ɲɛ vɔɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲɛ vɔɔndo_6592_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cimetière des premiers-nés et des lépreux</text></gloss>
      <gloss lang="en"><text>burial ground for first-born children and lepers</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 72: nyɛy wɔndo</text></form></note>
    <note><form lang="fr"><text>Paulme : litt. « mauvaise chose » (wɔndo « mauvais »). Dans la Bible, ɲɛ vɔɔndo signifie « le mal » (GEN.3.5).</text></form></note>
  </entry>
  <entry id="ɲɛ̀-pùlǎŋndó_6593">
    <lexical-unit><form lang="kqs"><text>ɲɛ̀-pùlǎŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ɲɛ̀pùláŋndò</text></form></variant>
    <sense id="ɲɛ̀-pùlǎŋndó_6593_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaires de toilette (brosse à frotter, etc.)</text></gloss>
      <gloss lang="en"><text>bathing articles (scrub brush, etc.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 278: ɲɛ̀-pùlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Cf. pulɔnndo « se laver » (Bible).</text></form></note>
  </entry>
  <entry id="ɲɛ-pɔmbɔ_6594">
    <lexical-unit><form lang="kqs"><text>ɲɛ-pɔmbɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ɲɛ-pɔmbɔɔ</text></form></variant>
    <sense id="ɲɛ-pɔmbɔ_6594_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>un peu, un peu de ; (ɲɛ-pɔmbɔ bɛɛ) le moindre ; (ɲɛ-pɔmbɔ ɲɛ-pɔmbɔ) peu à peu</text></gloss>
      <gloss lang="en"><text>a little, a bit of; (ɲɛ-pɔmbɔ bɛɛ) the least; (ɲɛ-pɔmbɔ ɲɛ-pɔmbɔ) little by little</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 123 occurrences, first GEN.8.7; Paulme 1964, p. 72: nye pɔmbo nye pɔmbo; Childs 2000, p. 276: ɲɛ̀ɛ̀mbɔ̀</text></form></note>
    <note><form lang="fr"><text>mɛnndan ɲɛ-pɔmbɔ « un peu d'eau » (GEN.18.4) ; Soar = « Ɲɛ-pɔmbɔɔ » (« petite chose », GEN.19.22). De ɲɛ « chose » et pɔmbɔ « petit ». Paulme 1964, p. 72 : nye pɔmbo nye pɔmbo « peu à peu » ; nyɛ pɔmo, nyɛypɔmbo « peu (petite chose) ».</text></form></note>
  </entry>
  <entry id="ɲɛ̀-sìmàá_6595">
    <lexical-unit><form lang="kqs"><text>ɲɛ̀-sìmàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ɲɛ̀m-sìmǎŋ</text></form></field>
    <sense id="ɲɛ̀-sìmàá_6595_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>point de côté, douleur thoracique, crampe ; pneumonie (« chose debout »)</text></gloss>
      <gloss lang="en"><text>side or chest pain, cramp; pneumonia ('thing standing')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
      <trait name="semantic-domain-ddp4" value="2.5.6 Symptom of disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 278: ɲɛ̀-sìmàá</text></form></note>
  </entry>
  <entry id="ɲɛ-sɔlaa_6596">
    <lexical-unit><form lang="kqs"><text>ɲɛ-sɔlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ-sɔlaa_6596_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>biens, possessions, richesses ; argent, prix</text></gloss>
      <gloss lang="en"><text>goods, possessions, wealth; money, price</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.1 Have wealth"/>
      <trait name="semantic-domain-ddp4" value="6.8.6 Money"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>money</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first GEN.14.21; Childs 2000, p. 278: ɲɛ̀-sɔ̀làá</text></form></note>
    <note><form lang="fr"><text>mà hin a ɲɛ-sɔlaa taw « ils sortiront avec de grands biens » (GEN.15.14) ; pendu lɛŋnden … a ɲɛ-sɔlaa « acheter le terrain contre argent » (GEN.23.13). De ɲɛ « chose » et sɔlaa « obtenir ».</text></form></note>
  </entry>
  <entry id="ɲɛ-tengaa_6597">
    <lexical-unit><form lang="kqs"><text>ɲɛ-tengaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ-tengaa_6597_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lumière</text></gloss>
      <gloss lang="en"><text>light</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 214 occurrences, first GEN.1.4; Keita 1979, p. 154: Nyètengaa; Terminologie (arts), n° 228: Nyètengaa</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, arts n° 228) : « lumière ».</text></form></note>
  </entry>
  <entry id="ɲɛ̀-tùùwó_6598">
    <lexical-unit><form lang="kqs"><text>ɲɛ̀-tùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ɲɛ̀m-tùùwóŋ</text></form></field>
    <sense id="ɲɛ̀-tùùwó_6598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose chaude</text></gloss>
      <gloss lang="en"><text>something hot</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 279: ɲɛ̀-tùùwó</text></form></note>
  </entry>
  <entry id="ɲɛ̀-wèènàŋndó_6599">
    <lexical-unit><form lang="kqs"><text>ɲɛ̀-wèènàŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="ɲɛ̀-wèènàŋndó_6599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chose qui fait peur</text></gloss>
      <gloss lang="en"><text>something that scares people</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 279: ɲɛ̀-wèènàŋndó</text></form></note>
  </entry>
  <entry id="ɲɛ-ɲɛ_6600">
    <lexical-unit><form lang="kqs"><text>ɲɛ-ɲɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ɲɛ-ɲɛ_6600_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>quelque chose ; (nég.) rien</text></gloss>
      <gloss lang="en"><text>anything; (neg.) nothing</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 941 occurrences, first GEN.1.2</text></form></note>
  </entry>
  <entry id="ɲɛ̀bèndòó_6601">
