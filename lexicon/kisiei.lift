  <entry id="ɲaloo_5022">
    <lexical-unit><form lang="kqs"><text>ɲaloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ɲaloo_5022_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>joie</text></gloss>
      <gloss lang="en"><text>joy</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 39: ɲaloo</text></form></note>
  </entry>
  <entry id="ɲama_5023">
    <lexical-unit><form lang="kqs"><text>ɲama</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="ɲama_5023_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>beauté, agrément</text></gloss>
      <gloss lang="en"><text>beauty, pleasantness</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 39: ɲama</text></form></note>
    <note><form lang="fr"><text>Le Lexique a barré « excellence ; influence ». Une seule occurrence biblique (ROM.3.31), sens à vérifier.</text></form></note>
  </entry>
  <entry id="ɲàmàá_5024">
    <lexical-unit><form lang="kqs"><text>ɲàmàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ɲàmàláŋ</text></form></field>
    <variant><form lang="kqs"><text>ɲàmáá</text></form></variant>
    <sense id="ɲàmàá_5024_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chance, bonne fortune, charme (surtout d'un homme auprès des femmes)</text></gloss>
      <gloss lang="en"><text>luck, good fortune, appeal (especially of a man to women)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 274: ɲàmàá</text></form></note>
    <note><form lang="fr"><text>Cf. peut-être ɲamaa, ɲamaka (Bible : grandeur, éclat).</text></form></note>
  </entry>
