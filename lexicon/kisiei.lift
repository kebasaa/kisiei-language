  <entry id="bàlló_47">
    <lexical-unit><form lang="kqs"><text>bàlló</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bàltáŋ</text></form></field>
