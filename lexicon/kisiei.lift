  </entry>
  <entry id="palekɛwvo_3864">
    <lexical-unit><form lang="kqs"><text>palekɛwvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>palekɛule</text></form></variant>
    <sense id="palekɛwvo_3864_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plante médicinale (purgatif ; inhalation contre les maux de tête ou de ventre)</text></gloss>
      <gloss lang="en"><text>medicinal plant (purgative; inhaled against headache or stomach-ache)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 77: palekɛule ou palekɛwo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 77 : litt. « os de serpent » ; décoction purgative ; feuilles en inhalation ; employée dans les rites de purification yallo (Kiesane, canton Kossa).</text></form></note>
  </entry>
  <entry id="palɛi_3865">
    <lexical-unit><form lang="kqs"><text>palɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="palɛi_3865_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jour (durée), journée ; (au pluriel) époque</text></gloss>
      <gloss lang="en"><text>day (as a unit of time); (pl.) days, time</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 633 occurrences, first GEN.1.14; Terminologie (langue), n° 450: Palèi</text></form></note>
    <note><form lang="fr"><text>palɛi ndii ŋɔmmɛw « sept jours ». Académie des langues (terminologie, langue n° 450) : « jours ».</text></form></note>
  </entry>
  <entry id="pámbáléŋ_3866">
