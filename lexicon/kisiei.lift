  <entry id="ciŋun kamaa_455">
    <lexical-unit><form lang="kqs"><text>ciŋun kamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciŋun kamaa_455_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ivoire</text></gloss>
      <gloss lang="en"><text>ivory</text></gloss>
