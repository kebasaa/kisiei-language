      <gloss lang="fr"><text>chauve-souris</text></gloss>
      <gloss lang="en"><text>bat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>large edible fruit bat, flying fox</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tasaa; Childs 2000, p. 350: tàsáá</text></form></note>
    <note><form lang="fr"><text>La Bible emploie tɔnganndo pour la chauve-souris (LEV.11.19).</text></form></note>
