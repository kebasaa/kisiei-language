  <entry id="kpàsàá_1818">
    <lexical-unit><form lang="kqs"><text>kpàsàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpàsàláŋ</text></form></field>
    <sense id="kpàsàá_1818_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tissu importé (par opposition au tissu tissé au pays)</text></gloss>
