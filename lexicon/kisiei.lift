    <trait name="status" value="southern"/>
    <sense id="wákéé_3699_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(bien propre, transparent, poli)</text></gloss>
      <gloss lang="en"><text>(clean, transparent, polished)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 379: wákéé</text></form></note>
  </entry>
  <entry id="wálà-wàlà_3700">
    <lexical-unit><form lang="kqs"><text>wálà-wàlà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="wálà-wàlà_3700_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(eau qui ondule, ruisselle sur les rochers)</text></gloss>
      <gloss lang="en"><text>(water rippling, rushing over rocks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
