    <field type="southern-kissi-sense"><form lang="en"><text>grandparent</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bembaa; Childs 2000, p. 18: bìmbàá</text></form></note>
    <note><form lang="fr"><text>La Bible dit fuɲa-mamaa « grand-père, ancêtre ».</text></form></note>
  </entry>
