    <variant><form lang="kqs"><text>koŋul</text></form></variant>
    <sense id="koŋullo_2295_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>crier, appeler (à l'aide) ; gémir</text></gloss>
      <gloss lang="en"><text>cry out, call (for help); moan</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.4.10; Paulme 1964, p. 48: koŋwul; Childs 2000, p. 177: kòŋùlló</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 48 : ɔ koŋwul « il gémit », koŋwulɔ « gémissement ».</text></form></note>
  </entry>
  <entry id="koŋɔlɔ tɔndo_2296">
    <lexical-unit><form lang="kqs"><text>koŋɔlɔ tɔndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="koŋɔlɔ tɔndo_2296_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>crosse du sarino</text></gloss>
      <gloss lang="en"><text>crook of the sarino</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: koŋɔrɔ tɔndo</text></form></note>
    <note><form lang="fr"><text>Le sarino est le gardien d'un culte (cf. kɔsɔa).</text></form></note>
  </entry>
  <entry id="koŋɔɔ_2297">
    <lexical-unit><form lang="kqs"><text>koŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>koaŋ</text></form></variant>
    <variant><form lang="kqs"><text>koŋ</text></form></variant>
    <variant><form lang="kqs"><text>koaŋnin</text></form></variant>
    <variant><form lang="kqs"><text>kuŋ</text></form></variant>
    <sense id="koŋɔɔ_2297_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>frapper, battre, vaincre ; (koaŋ balan) battre des mains ; secouer, herser</text></gloss>
      <gloss lang="en"><text>strike, beat, defeat; (koaŋ balan) clap one's hands; shake, harrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also cultivate, break up clods; beat, flog</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first DEU.1.44; Lexique kissi–français, p. 26: koŋɔɔ/ koŋ, kuŋ, koaŋ; Childs 2000, p. 177: kòŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>koaŋ nda koŋɔɔ pila « il leur infligea une grande défaite » (Jg 8,16). Lexique kissi–français, p. 25-26 : « secouer, herser ».</text></form></note>
  </entry>
  <entry id="koɔ_2298">
    <lexical-unit><form lang="kqs"><text>koɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kɔva</text></form></field>
    <sense id="koɔ_2298_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épervier (oiseau)</text></gloss>
      <gloss lang="en"><text>sparrowhawk</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 52: koɔ, pl. kɔwa</text></form></note>
    <note><form lang="fr"><text>Paulme : le sorcier peut se changer la nuit en épervier. La Bible dit kòòndo « épervier ».</text></form></note>
  </entry>
  <entry id="kpá_2299">
    <lexical-unit><form lang="kqs"><text>kpá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpá_2299_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>exprime l'agacement, le doute, l'hésitation ou la surprise</text></gloss>
      <gloss lang="en"><text>expresses irritation, doubt, hesitation or surprise</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpá</text></form></note>
  </entry>
  <entry id="kpá_2300">
    <lexical-unit><form lang="kqs"><text>kpá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpá_2300_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>vraiment, même ; tout</text></gloss>
      <gloss lang="en"><text>indeed, even; all</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpá</text></form></note>
  </entry>
  <entry id="kpâ_2301">
    <lexical-unit><form lang="kqs"><text>kpâ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpâ_2301_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>à l'excès ; (serrer) fort ; longuement</text></gloss>
      <gloss lang="en"><text>overdone; (hold) tightly; for a long time</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpâ</text></form></note>
  </entry>
  <entry id="kpaa_2302">
    <lexical-unit><form lang="kqs"><text>kpaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpaa_2302_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>calmer, apaiser ; arrêter, retenir</text></gloss>
      <gloss lang="en"><text>calm, still; stop, restrain</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
      <trait name="semantic-domain-ddp4" value="4.8.4 Peace"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first NUM.13.30; Lexique kissi–français, p. 27: kpaa</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 27 : « réduire au silence ».</text></form></note>
  </entry>
  <entry id="kpaa_2303">
    <lexical-unit><form lang="kqs"><text>kpaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kpaa_2303_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri, case sans murs</text></gloss>
      <gloss lang="en"><text>shelter, open-sided hut</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 27: kpaa</text></form></note>
    <note><form lang="fr"><text>Homographe du verbe kpaa « calmer, faire taire » (Bible), que le Lexique donne aussi (« réduire au silence »).</text></form></note>
  </entry>
  <entry id="kpáá_2304">
    <lexical-unit><form lang="kqs"><text>kpáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpáá_2304_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(frapper) fort</text></gloss>
      <gloss lang="en"><text>(hit) hard</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpáá</text></form></note>
  </entry>
  <entry id="kpàà_2305">
    <lexical-unit><form lang="kqs"><text>kpàà</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpàá</text></form></field>
    <sense id="kpàà_2305_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grosse fourmi rouge à morsure douloureuse (forme des ponts)</text></gloss>
      <gloss lang="en"><text>large red ant with a painful bite (builds bridges)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpàà kpàá</text></form></note>
