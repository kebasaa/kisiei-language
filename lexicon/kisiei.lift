    <sense id="kpúù_1980_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un coup porté à quelqu'un</text></gloss>
      <gloss lang="en"><text>sound of striking someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 220: kpúù</text></form></note>
  </entry>
  <entry id="kpùùyàá_1981">
    <lexical-unit><form lang="kqs"><text>kpùùyàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpùùyàá_1981_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>revenir, retourner</text></gloss>
      <gloss lang="en"><text>return</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 220: kpùùyàá</text></form></note>
  </entry>
  <entry id="kpuva_1982">
    <lexical-unit><form lang="kqs"><text>kpuva</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpuva_1982_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>saisir, s'emparer de, capturer</text></gloss>
      <gloss lang="en"><text>seize, capture</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grab, seize; also rape</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.34.2; Childs 2000, p. 220: kpùwàá</text></form></note>
  </entry>
  <entry id="kpúyàá_1983">
    <lexical-unit><form lang="kqs"><text>kpúyàá</text></form></lexical-unit>
