      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arracher</text></gloss>
      <gloss lang="en"><text>pluck, tear away</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>uproot, pull up, extract</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JOB.24.9; Keita 1979, p. 113: Sungöö; Childs 2000, p. 345: sùŋɔ̀ɔ́</text></form></note>
