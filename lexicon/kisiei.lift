  <entry id="ɲáŋgbáá_4162">
    <lexical-unit><form lang="kqs"><text>ɲáŋgbáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ɲáŋmgbáá</text></form></variant>
    <sense id="ɲáŋgbáá_4162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>masque (« diable ») visible de tous qui critique tout le monde ; nom générique des masques</text></gloss>
      <gloss lang="en"><text>mask ('bush devil') seen by all that criticizes everyone; general name for masks</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 275: ɲáŋgbáá</text></form></note>
  </entry>
  <entry id="ɲáŋgóó_4163">
    <lexical-unit><form lang="kqs"><text>ɲáŋgóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ɲàŋgòó</text></form></variant>
    <sense id="ɲáŋgóó_4163_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>purificateur, exorciste (qui purifie les gens et les lieux)</text></gloss>
      <gloss lang="en"><text>cleanser, exorcist (who purifies people and places)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 275: ɲáŋgóó</text></form></note>
  </entry>
  <entry id="ɲáŋòŋ-ɲàŋòŋ_4164">
