    <sense id="bílílí_145_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>écoulement fort et régulier (d'un liquide)</text></gloss>
      <gloss lang="en"><text>strong, steady flow (of a liquid)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bílílí</text></form></note>
  </entry>
  <entry id="bilio_146">
    <lexical-unit><form lang="kqs"><text>bilio</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bilio_146_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rue</text></gloss>
      <gloss lang="en"><text>street</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 142: Bilio; Childs 2000, p. 17: bílíó</text></form></note>
    <note><form lang="fr"><text>Keita glose « la rue (route) » ; la Bible dit nɛiyo pour « chemin, route ».</text></form></note>
  </entry>
  <entry id="bìllèsókóó_147">
    <lexical-unit><form lang="kqs"><text>bìllèsókóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bìllèsókúá</text></form></field>
    <sense id="bìllèsókóó_147_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herboriste, guérisseur par les plantes</text></gloss>
      <gloss lang="en"><text>herbalist</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
      <trait name="semantic-domain-ddp4" value="6.6 Occupation"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bìllèsókóó</text></form></note>
  </entry>
  <entry id="billo_148">
    <lexical-unit><form lang="kqs"><text>billo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bil</text></form></variant>
    <variant><form lang="kqs"><text>bilten</text></form></variant>
    <variant><form lang="kqs"><text>bilte</text></form></variant>
    <sense id="billo_148_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>herbe ; herbe, plante, verdure</text></gloss>
      <gloss lang="en"><text>grass ; grass, plant, vegetation</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 71 occurrences, first GEN.1.11; Keita 1979, p. 139: Billo</text></form></note>
  </entry>
  <entry id="bîm_149">
    <lexical-unit><form lang="kqs"><text>bîm</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bîm_149_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'un coup (fort)</text></gloss>
      <gloss lang="en"><text>sound of a blow (loud)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 18: bîm</text></form></note>
  </entry>
  <entry id="bìndìó_150">
    <lexical-unit><form lang="kqs"><text>bìndìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bìndìó_150_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir les yeux (petit d'animal) ; cligner ; détendre (un piège) ; tirer (au fusil)</text></gloss>
      <gloss lang="en"><text>open the eyes (newborn animal); blink; spring (a trap); shoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
      <trait name="semantic-domain-ddp4" value="6.4.2 Trap"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 18: bìndìó</text></form></note>
  </entry>
  <entry id="bingi_151">
    <lexical-unit><form lang="kqs"><text>bingi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bingi_151_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>court ; (telen bingi) un peu de temps</text></gloss>
      <gloss lang="en"><text>short; (telen bingi) a short while</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>short; also little, small</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.12.10; Childs 2000, p. 18: bìŋì</text></form></note>
  </entry>
  <entry id="bingulanndo_152">
    <lexical-unit><form lang="kqs"><text>bingulanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bingulan</text></form></variant>
    <sense id="bingulanndo_152_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se mélanger, être mêlé</text></gloss>
      <gloss lang="en"><text>be mixed</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.3 Mix"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first PRO.23.30</text></form></note>
  </entry>
  <entry id="binɔnndo_153">
    <lexical-unit><form lang="kqs"><text>binɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="binɔnndo_153_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entretenir (propriété)</text></gloss>
      <gloss lang="en"><text>keep, maintain (property)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Binönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de biyɔɔ ; sens à préciser.</text></form></note>
  </entry>
  <entry id="bìó_154">
    <lexical-unit><form lang="kqs"><text>bìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bèèláŋ</text></form></field>
    <sense id="bìó_154_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sauce gluante (graines de gombo ou d'arbre sauvage) servie sur le riz</text></gloss>
      <gloss lang="en"><text>gooey sauce (from okra or wild-tree seeds) served on rice</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 19: bìó</text></form></note>
  </entry>
  <entry id="bìòlɔ̀ɔ́_155">
    <lexical-unit><form lang="kqs"><text>bìòlɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bìòlɔ̀ɔ́_155_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre à nu</text></gloss>
      <gloss lang="en"><text>lay bare</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 19: bìòlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="biondɔnndo_156">
    <lexical-unit><form lang="kqs"><text>biondɔnndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>biondɔnndan</text></form></field>
    <variant><form lang="kqs"><text>biondɔn</text></form></variant>
    <variant><form lang="kqs"><text>biondɔnnda</text></form></variant>
    <sense id="biondɔnndo_156_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>faute, erreur, péché involontaire</text></gloss>
      <gloss lang="en"><text>fault, error, unintentional sin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) make a mistake, miss (oneself)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.18.1; Childs 2000, p. 19: bìòndɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="biondɔɔ_157">
    <lexical-unit><form lang="kqs"><text>biondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biondu</text></form></variant>
    <variant><form lang="kqs"><text>bindu</text></form></variant>
    <variant><form lang="kqs"><text>bindunin</text></form></variant>
    <sense id="biondɔɔ_157_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manquer (la cible), rater ; échapper à ; se tromper</text></gloss>
      <gloss lang="en"><text>miss (a target), fail to catch; escape; err</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>miss; (of a trap) spring without catching</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ACT.18.25; Childs 2000, p. 19: bìòndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>yaŋɔɔlen le ... biondu « le piège ne se détend pas (à vide) » (AMO.3.5) ; ndóò bindu len te « sans manquer (la cible) » (JDG.20.16) ; o ve biondɔɔ le « sans se tromper » (ACT.18.25). Voir bendun, biondɔnndo.</text></form></note>
  </entry>
  <entry id="biwnun_158">
    <lexical-unit><form lang="kqs"><text>biwnun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biuvɔnndo</text></form></variant>
    <variant><form lang="kqs"><text>biuvɔn</text></form></variant>
    <sense id="biwnun_158_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>supporter, endurer ; patienter</text></gloss>
      <gloss lang="en"><text>bear, endure; be patient</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4 Emotion"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first NEH.9.17</text></form></note>
  </entry>
  <entry id="biwvo_159">
    <lexical-unit><form lang="kqs"><text>biwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biw</text></form></variant>
    <variant><form lang="kqs"><text>biwnin</text></form></variant>
    <sense id="biwvo_159_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre, saisir, emmener ; rassembler (butin, argent) ; (biw vanalanɔɔ) se fiancer</text></gloss>
      <gloss lang="en"><text>take, seize, carry off; collect (spoil, money); (biw vanalanɔɔ) become engaged</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of 'hold': take from several places; keep for someone over time, e.g. a girl for later marriage</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JER.9.20; Childs 2000, p. 20: bìùwó</text></form></note>
  </entry>
  <entry id="biyanndo_160">
    <lexical-unit><form lang="kqs"><text>biyanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="biyanndo_160_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'attraper, se saisir l'un l'autre</text></gloss>
      <gloss lang="en"><text>seize each other, grapple</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Biyanndo</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : biyan « se battre, se saisir » (DEU 25,11), biyannin (ZEC 14,13).</text></form></note>
  </entry>
  <entry id="biyɔɔ_161">
    <lexical-unit><form lang="kqs"><text>biyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bii</text></form></variant>
    <variant><form lang="kqs"><text>bil</text></form></variant>
    <sense id="biyɔɔ_161_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>attraper, saisir, tenir</text></gloss>
      <gloss lang="en"><text>catch, seize, hold</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take, seize, capture; have; begin</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 740 occurrences, first GEN.1.15; Keita 1979, p. 110: Biyöö; Childs 2000, p. 20: bìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>bil : « porter (de la semence), tenir » (GEN 1,29).</text></form></note>
  </entry>
  <entry id="bìyɔ̀ɔ̀píó_162">
    <lexical-unit><form lang="kqs"><text>bìyɔ̀ɔ̀píó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bìyɔ̀ɔ̀píá</text></form></field>
    <sense id="bìyɔ̀ɔ̀píó_162_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>animal semblable à une tortue, mais plus grand</text></gloss>
      <gloss lang="en"><text>turtle-like animal, but bigger</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 20: bìyɔ̀ɔ̀píó</text></form></note>
  </entry>
  <entry id="bìŋgùùkɔ̀ɔ́_163">
    <lexical-unit><form lang="kqs"><text>bìŋgùùkɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bìŋgùùkɔ̀ɔ́_163_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>envoi d'une jeune fille célibataire vivre chez sa sœur aînée ou sa tante mariée</text></gloss>
      <gloss lang="en"><text>sending an unmarried girl to live with her married elder sister or aunt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 17: bìŋgùùkɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bìŋíínáá_164">
    <lexical-unit><form lang="kqs"><text>bìŋíínáá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bìŋíínáá_164_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>très court, tout petit</text></gloss>
      <gloss lang="en"><text>very short</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 18: bìŋíínáá</text></form></note>
  </entry>
  <entry id="bìŋìléŋ_165">
    <lexical-unit><form lang="kqs"><text>bìŋìléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="bìŋìléŋ_165_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petitesse, petite taille</text></gloss>
      <gloss lang="en"><text>shortness, small stature</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 18: bìŋìléŋ</text></form></note>
  </entry>
  <entry id="biŋinndo_166">
    <lexical-unit><form lang="kqs"><text>biŋinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>biŋin</text></form></variant>
    <sense id="biŋinndo_166_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bouger, chanceler, être ébranlé ; (pulei biŋin X) être prise par les douleurs de l'accouchement</text></gloss>
      <gloss lang="en"><text>move, waver, be shaken; (pulei biŋin X) go into labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.7 Not moving"/>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.66.8</text></form></note>
  </entry>
  <entry id="bíŋndó_167">
    <lexical-unit><form lang="kqs"><text>bíŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bíŋndáŋ</text></form></field>
    <sense id="bíŋndó_167_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>muret de véranda (assez bas pour s'y asseoir)</text></gloss>
      <gloss lang="en"><text>low verandah wall (for sitting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 19: bíŋndó</text></form></note>
  </entry>
  <entry id="biɔmnɔnndo_168">
    <lexical-unit><form lang="kqs"><text>biɔmnɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="biɔmnɔnndo_168_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se blottir, s'accroupir</text></gloss>
      <gloss lang="en"><text>crouch, huddle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1 Posture"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Biömnönndo</text></form></note>
    <note><form lang="fr"><text>Forme attestée dans la Bible : biɔmnun « il s'est accroupi » (GEN 49,9).</text></form></note>
  </entry>
  <entry id="biɔŋɔɔ_169">
    <lexical-unit><form lang="kqs"><text>biɔŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="biɔŋɔɔ_169_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cligner des yeux ; clin d'œil</text></gloss>
      <gloss lang="en"><text>blink; blink of an eye</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sting; blink</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JER.4.20; Keita 1979, p. 116: Biönhöö; Childs 2000, p. 19: bìɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>o biɔŋɔɔ lepilɔɔ « en un clin d'œil » (JER 4,20).</text></form></note>
  </entry>
  <entry id="bô_170">
    <lexical-unit><form lang="kqs"><text>bô</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bô_170_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>par taches, par morceaux distincts (couvert, marqué, coupé)</text></gloss>
      <gloss lang="en"><text>in patches, in discrete pieces (covered, marked, cut)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 20: bô</text></form></note>
  </entry>
  <entry id="bòáŋ_171">
    <lexical-unit><form lang="kqs"><text>bòáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <sense id="bòáŋ_171_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre fruitier sauvage</text></gloss>
      <gloss lang="en"><text>species of wild fruit tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 20: bòáŋ</text></form></note>
  </entry>
  <entry id="bòáŋ_172">
    <lexical-unit><form lang="kqs"><text>bòáŋ</text></form></lexical-unit>
    <trait name="noun-class" value="ma"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bòléŋ</text></form></field>
    <sense id="bòáŋ_172_s1">
      <grammatical-info value="Noun"/>
