    <variant><form lang="kqs"><text>maalian</text></form></variant>
    <sense id="maalianndo_769_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entraider</text></gloss>
      <gloss lang="en"><text>help one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first ISA.41.6; Keita 1979, p. 110: Maalianndo</text></form></note>
    <note><form lang="fr"><text>Réciproque de malaa.</text></form></note>
  </entry>
