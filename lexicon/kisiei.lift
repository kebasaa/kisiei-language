    <trait name="status" value="respelled"/>
    <sense id="kolombololen_1662_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>larynx</text></gloss>
      <gloss lang="en"><text>larynx</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: koronborolen</text></form></note>
    <note><form lang="fr"><text>Écrit koronborolen ; r → l, nb → mb.</text></form></note>
  </entry>
  <entry id="kólómbómbó_1663">
