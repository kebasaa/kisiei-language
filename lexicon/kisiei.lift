    <trait name="status" value="attested"/>
    <sense id="oo_2493_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>chaque, tout (entre deux noms répétés : X oo X)</text></gloss>
      <gloss lang="en"><text>every, any (between a repeated noun: X oo X)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
