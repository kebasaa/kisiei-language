      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 54: tasio</text></form></note>
    <note><form lang="fr"><text>Emprunt (français tasse). Homographe : tasio dans la Bible (PRO.14.29) signifie « intelligence » (voir taasio).</text></form></note>
  </entry>
