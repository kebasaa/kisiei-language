      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 40: o foofoo</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence biblique (DAN.2.35), sens à vérifier.</text></form></note>
  </entry>
  <entry id="fòòlòfóólóó_1418">
