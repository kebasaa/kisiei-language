  <entry id="tueiyo_3451">
    <lexical-unit><form lang="kqs"><text>tueiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tueiyo_3451_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver, rincer (l'intérieur des récipients)</text></gloss>
      <gloss lang="en"><text>wash, rinse (the inside of vessels)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.23.25; Childs 2000, p. 370: tùèìyó</text></form></note>
    <note><form lang="fr"><text>la co taala kólaa a hɛngɛiyo tueiyo o kɔɔ « vous lavez l'extérieur de la coupe et du plat » (MAT.23.25 ; aussi MRK.7.4).</text></form></note>
  </entry>
  <entry id="tùèndɔ̀ɔ́_3452">
    <lexical-unit><form lang="kqs"><text>tùèndɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="tùèndɔ̀ɔ́_3452_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>instrument de musique (espèce)</text></gloss>
      <gloss lang="en"><text>a musical instrument</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 371: tùèndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="tueyɔɔ_3453">
    <lexical-unit><form lang="kqs"><text>tueyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuei</text></form></variant>
    <variant><form lang="kqs"><text>tuɛi</text></form></variant>
    <variant><form lang="kqs"><text>tui</text></form></variant>
    <variant><form lang="kqs"><text>tuɛinin</text></form></variant>
    <sense id="tueyɔɔ_3453_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>entendre, écouter ; apprendre (une nouvelle)</text></gloss>
      <gloss lang="en"><text>hear, listen; learn (news)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also: understand; sense, perceive, smell</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 265 occurrences, first GEN.3.10; Childs 2000, p. 370: tùèìyɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tui au négatif : la tui ya diom te « vous ne m'avez pas écouté » (Gn 42,22).</text></form></note>
  </entry>
  <entry id="tufɔɔ_3454">
    <lexical-unit><form lang="kqs"><text>tufɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tufu</text></form></variant>
    <sense id="tufɔɔ_3454_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>cracher</text></gloss>
      <gloss lang="en"><text>spit</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.3 Spit, saliva"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JOB.17.6; Childs 2000, p. 371: tùfɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>tufu lɔluan « cracher (de la salive) ».</text></form></note>
  </entry>
  <entry id="túfɛ́-túfɛ́_3455">
    <lexical-unit><form lang="kqs"><text>túfɛ́-túfɛ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="túfɛ́-túfɛ́_3455_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(goût sucré)</text></gloss>
      <gloss lang="en"><text>(sweet-tasting)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 371: túfɛ́-túfɛ́</text></form></note>
  </entry>
  <entry id="tuilian_3456">
    <lexical-unit><form lang="kqs"><text>tuilian</text></form></lexical-unit>
    <trait name="noun-class" value="an"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>tuilima</text></form></variant>
    <sense id="tuilian_3456_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>urine</text></gloss>
      <gloss lang="en"><text>urine</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.7 Urinate, urine"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Tuilian; Childs 2000, p. 371: tùìlíáŋ</text></form></note>
    <note><form lang="fr"><text>Forme radicale tuilima attestée (2R 18,27 ; Is 36,12).</text></form></note>
  </entry>
  <entry id="tuinɔnndo_3457">
    <lexical-unit><form lang="kqs"><text>tuinɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuinun</text></form></variant>
    <sense id="tuinɔnndo_3457_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire grâce, avoir pitié (tuinun … iɲíí)</text></gloss>
      <gloss lang="en"><text>show favour, have mercy (tuinun … iɲíí)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.4 Do good to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.33.19</text></form></note>
  </entry>
  <entry id="tuisinndo_3458">
    <lexical-unit><form lang="kqs"><text>tuisinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuisin</text></form></variant>
    <sense id="tuisinndo_3458_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'humilier, se soumettre</text></gloss>
      <gloss lang="en"><text>humble oneself, submit</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
      <trait name="semantic-domain-ddp4" value="7.1.5 Bow"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 25 occurrences, first EXO.10.3</text></form></note>
    <note><form lang="fr"><text>Moyen de tuisio.</text></form></note>
  </entry>
  <entry id="tuisio_3459">
    <lexical-unit><form lang="kqs"><text>tuisio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuisi</text></form></variant>
    <variant><form lang="kqs"><text>tuisinin</text></form></variant>
    <sense id="tuisio_3459_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire descendre, envoyer (pluie, malheur) sur ; abaisser</text></gloss>
      <gloss lang="en"><text>bring down, send (rain, calamity) upon; humble</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first GEN.17.13</text></form></note>
  </entry>
  <entry id="tuituiyaa_3460">
    <lexical-unit><form lang="kqs"><text>tuituiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="tuituiyaa_3460_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>plié, roulé (à plusieurs plis)</text></gloss>
      <gloss lang="en"><text>folded, rolled up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fold together, roll up (plural of tùwɔ̀ɔ́ 'fold')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JHN.20.7; Childs 2000, p. 372: tùìtùìyó</text></form></note>
    <note><form lang="fr"><text>o va o tuituiyaa « (le linge) était plié » (JHN.20.7).</text></form></note>
  </entry>
  <entry id="tuiŋio_3461">
    <lexical-unit><form lang="kqs"><text>tuiŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tuiŋi</text></form></variant>
    <sense id="tuiŋio_3461_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>retirer, arracher du feu</text></gloss>
      <gloss lang="en"><text>take out of the fire, snatch from the fire</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.47.14; Childs 2000, p. 371: tùìŋìó</text></form></note>
    <note><form lang="fr"><text>La tuiŋi nda o yin « arrachez-les du feu » (JUD.1.23) ; yoomu ndaa tuiŋio o yinnden nin « sauver leur vie des flammes » (ISA.47.14).</text></form></note>
  </entry>
  <entry id="tùkpàá_3462">
    <lexical-unit><form lang="kqs"><text>tùkpàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>tùkpàláŋ</text></form></field>
    <sense id="tùkpàá_3462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>canon, mortier ; coup de fusil de fête (veillées)</text></gloss>
      <gloss lang="en"><text>cannon, mortar; celebratory gunshot (at wakes)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="4.2.2 Social event"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 372: tùkpàá</text></form></note>
  </entry>
  <entry id="tullo_3463">
    <lexical-unit><form lang="kqs"><text>tullo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="tullo_3463_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sommet</text></gloss>
      <gloss lang="en"><text>top, summit</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first EXO.24.17</text></form></note>
    <note><form lang="fr"><text>pembei tullo « le sommet de la montagne ».</text></form></note>
  </entry>
  <entry id="tum yekpandio_3464">
    <lexical-unit><form lang="kqs"><text>tum yekpandio</text></form></lexical-unit>
