    <note><form lang="fr"><text>Keita : « la religion musulmane ». Lexique kissi–français, p. 13 : « la religion musulmane ».</text></form></note>
  </entry>
  <entry id="dinalepɛnndo_1058">
    <lexical-unit><form lang="kqs"><text>dinalepɛnndo</text></form></lexical-unit>
