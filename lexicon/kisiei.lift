    <sense id="fɛ́-fɛ́i_1093_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>doucement (vent) ; (hoeyii fɛ́-fɛ́i) la brise légère</text></gloss>
      <gloss lang="en"><text>gently (wind); (hoeyii fɛ́-fɛ́i) the light breeze</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.1.3 Weather"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sound of wind blowing gently</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.3.8; Childs 2000, p. 103: fé-fé</text></form></note>
    <note><form lang="fr"><text>Une seule occurrence : o hoeyii fɛ́-fɛ́i paale delɛi nin « à la brise du soir » (GEN.3.8).</text></form></note>
  </entry>
