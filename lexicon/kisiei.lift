    <trait name="status" value="southern"/>
    <sense id="súkàá_3103_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>arbre à fruit non comestible servant de mordant (teinture)</text></gloss>
      <gloss lang="en"><text>tree with inedible fruit used as a dye fixative</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: súkàá</text></form></note>
  </entry>
  <entry id="sùkàsùkàá_3104">
    <lexical-unit><form lang="kqs"><text>sùkàsùkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="sùkàsùkàá_3104_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rincer (la bouche)</text></gloss>
      <gloss lang="en"><text>rinse out (the mouth)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 343: sùkàsùkàá</text></form></note>
  </entry>
  <entry id="sulalle_3105">
    <lexical-unit><form lang="kqs"><text>sulalle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sulalii</text></form></variant>
    <sense id="sulalle_3105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>accident, malheur (involontaire)</text></gloss>
      <gloss lang="en"><text>accident, mishap</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first EXO.21.13; Childs 2000, p. 344: sùléí</text></form></note>
    <note><form lang="fr"><text>vanaa sulalle fula o ba má dii vanacieo « ceux qui ont tué quelqu'un par accident » (Nb 35,6).</text></form></note>
  </entry>
  <entry id="sulan_3106">
    <lexical-unit><form lang="kqs"><text>sulan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sulan_3106_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être égal à, être semblable à (… a)</text></gloss>
      <gloss lang="en"><text>be equal to, be like (… a)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(noun) an equal, equivalent</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first EXO.8.6; Childs 2000, p. 344: sùlâŋndó</text></form></note>
    <note><form lang="fr"><text>vana-vana sulan a Mɛlɛka le, Hala naa pɛɛn « nul n'est semblable au Seigneur notre Dieu » (EXO.8.6) ; i sulan bɛɛ a buɛyaa nɔmaa laandua ha o pilɛ le « je ne suis même pas l'égale d'une de tes servantes » (RUT.2.13).</text></form></note>
  </entry>
  <entry id="sullo_3107">
    <lexical-unit><form lang="kqs"><text>sullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>sulɔɔ</text></form></variant>
    <sense id="sullo_3107_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>grandir ; tenir, avoir de la place (dans un lieu)</text></gloss>
      <gloss lang="en"><text>grow up; fit (in a place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.4 Stage of life"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 113: Sullo</text></form></note>
    <note><form lang="fr"><text>Formes attestées dans la Bible : sul (GEN 21,8), sulnin.</text></form></note>
  </entry>
