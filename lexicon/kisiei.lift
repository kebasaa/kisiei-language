    <sense id="yɛ́lɔ̀ɔ́_4031_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vipère, serpent venimeux</text></gloss>
      <gloss lang="en"><text>viper, venomous snake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(spitting) cobra</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.20.16; Childs 2000, p. 404: yɛ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>diɛɛmule yɛ́lɔ̀ɔ́ « la langue de la vipère » (JOB.20.16).</text></form></note>
  </entry>
  <entry id="yɛlɛmaa_4032">
