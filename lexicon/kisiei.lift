    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kòòlòláŋ</text></form></field>
    <sense id="kòòlòó_1453_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palme (feuille de palmier) ; serpent qui ressemble à une tige de palme</text></gloss>
      <gloss lang="en"><text>palm frond; snake resembling a palm stem</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 178: kòòlòó kòòlòláŋ</text></form></note>
  </entry>
  <entry id="koombiaa_1454">
    <lexical-unit><form lang="kqs"><text>koombiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>koombiaanin</text></form></variant>
    <variant><form lang="kqs"><text>koombian</text></form></variant>
    <sense id="koombiaa_1454_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>démolir, abattre, renverser</text></gloss>
      <gloss lang="en"><text>break down, pull down, demolish</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fell many trees; plural of kòmbàá</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.23.24; Childs 2000, p. 178: kòòmbìá</text></form></note>
  </entry>
  <entry id="koon vuuvo_1455">
    <lexical-unit><form lang="kqs"><text>koon vuuvo</text></form></lexical-unit>
