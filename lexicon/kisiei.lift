    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: kosontɛndɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique p. 26 : kosontɛndɔɔ « une sorte d'araignée », kosontɛnndɛɔ « l'araignée ».</text></form></note>
  </entry>
  <entry id="kosuo_2269">
    <lexical-unit><form lang="kqs"><text>kosuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>kosulan</text></form></field>
    <sense id="kosuo_2269_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grande couverture en coton (du Soudan)</text></gloss>
      <gloss lang="en"><text>large cotton blanket (from the Sudan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 48: kósuo, pl. kosurã</text></form></note>
