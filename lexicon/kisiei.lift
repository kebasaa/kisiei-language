    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>samtalan</text></form></field>
    <sense id="samtaa_1404_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaussure, sandale</text></gloss>
      <gloss lang="en"><text>shoe, sandal</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3 Clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.25.9; Keita 1979, p. 144: Samtaa</text></form></note>
  </entry>
  <entry id="sanaa_1405">
    <lexical-unit><form lang="kqs"><text>sanaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sanaa_1405_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout droit, directement</text></gloss>
      <gloss lang="en"><text>straight, straight ahead, directly</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 34 occurrences, first GEN.30.11; Childs 2000, p. 320: sánáá</text></form></note>
  </entry>
  <entry id="sandaa_1406">
    <lexical-unit><form lang="kqs"><text>sandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sandaala</text></form></variant>
    <variant><form lang="kqs"><text>sandaalan</text></form></variant>
    <sense id="sandaa_1406_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>juste, droit ; (dɛnɛ sandaa) la justice</text></gloss>
      <gloss lang="en"><text>righteous, just; (dɛnɛ sandaa) righteousness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 669 occurrences, first GEN.6.9</text></form></note>
  </entry>
  <entry id="sandei_1407">
    <lexical-unit><form lang="kqs"><text>sandei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="sandei_1407_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>justice, droiture, équité</text></gloss>
      <gloss lang="en"><text>justice, righteousness, equity</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.18.19</text></form></note>
  </entry>
  <entry id="sandu_1408">
    <lexical-unit><form lang="kqs"><text>sandu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sandunin</text></form></variant>
    <sense id="sandu_1408_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être droit, être juste ; paraître bon (à qqn)</text></gloss>
      <gloss lang="en"><text>be upright, be right; seem right (to someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.1 Good, moral"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be straight, be honest; also be bright, blaze (lamp, fire)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 72 occurrences, first NUM.11.3; Childs 2000, p. 320: sàndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Verbe correspondant à l'adjectif sandaa ; vana sandu-o « l'homme juste » (Ez 18,5) ; mɛɛ o sandu nɔm o hɔl « comme il te semble bon » (Jos 9,25). En Nb 11,3, yinnde … le sandu vannda tɛɛn « le feu brûla parmi eux » : sens « flamber », comme en kissi du Sud.</text></form></note>
  </entry>
  <entry id="sangaa_1409">
    <lexical-unit><form lang="kqs"><text>sangaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sanga</text></form></variant>
    <variant><form lang="kqs"><text>sanganin</text></form></variant>
    <sense id="sangaa_1409_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être fatigué, peiner</text></gloss>
      <gloss lang="en"><text>be tired, toil</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 258 occurrences, first GEN.3.17; Keita 1979, p. 113: Sangaa</text></form></note>
  </entry>
  <entry id="sangalaa_1410">
    <lexical-unit><form lang="kqs"><text>sangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sangala</text></form></variant>
    <variant><form lang="kqs"><text>sangalanin</text></form></variant>
    <sense id="sangalaa_1410_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier, exalter</text></gloss>
      <gloss lang="en"><text>praise, glorify, exalt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>praise, esp. by singing; also tie logs together to make a ladder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first JDG.16.24; Childs 2000, p. 321: sàŋàlàá</text></form></note>
    <note><form lang="fr"><text>À distinguer de sangalan « peines, souffrances » (Gn 3,16), de la famille de sangaa « peiner ».</text></form></note>
  </entry>
  <entry id="sangalanndo_1411">
    <lexical-unit><form lang="kqs"><text>sangalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sangalanndo_1411_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se vanter, se glorifier</text></gloss>
      <gloss lang="en"><text>boast, glorify oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first ISA.13.19; Childs 2000, p. 321: sàŋàlăŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de sangalaa « louer ».</text></form></note>
  </entry>
  <entry id="sanganndo_1412">
    <lexical-unit><form lang="kqs"><text>sanganndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sangan</text></form></variant>
    <sense id="sanganndo_1412_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se fatiguer, peiner</text></gloss>
      <gloss lang="en"><text>tire oneself, labour</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.4 Tired"/>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.127.1; Keita 1979, p. 113: Sanganndo</text></form></note>
    <note><form lang="fr"><text>Moyen de sangaa (PSA 127,1).</text></form></note>
