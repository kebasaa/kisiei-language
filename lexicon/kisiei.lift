      <gloss lang="en"><text>camp</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 146 occurrences, first GEN.11.2</text></form></note>
  </entry>
  <entry id="dɔɔniaa_760">
    <lexical-unit><form lang="kqs"><text>dɔɔniaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɔɔniaanin</text></form></variant>
    <variant><form lang="kqs"><text>dɔɔnial</text></form></variant>
    <sense id="dɔɔniaa_760_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>diminuer, réduire, alléger</text></gloss>
      <gloss lang="en"><text>reduce, diminish, lighten</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.1 Small"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.27.18</text></form></note>
    <note><form lang="fr"><text>Causatif de dɔɔnanndo ; dɔɔnial « alléger pour » (1 R 12,4).</text></form></note>
  </entry>
  <entry id="dɔ́ɔ̀ŋndó_761">
    <lexical-unit><form lang="kqs"><text>dɔ́ɔ̀ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="dɔ́ɔ̀ŋndó_761_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affût (du chasseur)</text></gloss>
      <gloss lang="en"><text>(hunter's) blind, hide</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 89: dɔ́ɔ̀ŋndó</text></form></note>
