  <entry id="síɛ́ŋndó_3616">
    <lexical-unit><form lang="kqs"><text>síɛ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="síɛ́ŋndó_3616_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grillon</text></gloss>
      <gloss lang="en"><text>cricket</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 332: síɛ́ŋndó</text></form></note>
  </entry>
  <entry id="siɛɛliaa_3617">
    <lexical-unit><form lang="kqs"><text>siɛɛliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛlia</text></form></variant>
    <sense id="siɛɛliaa_3617_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>glisser, chanceler, tituber ; (nɛi … siɛɛliaa) chemin glissant</text></gloss>
      <gloss lang="en"><text>slip, stagger, totter; (nɛi … siɛɛliaa) slippery path</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>slip, slide (plural)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.35.6; Childs 2000, p. 331: sìɛ̀ɛ̀lìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de siɛlaa « trébucher ». o co naa malɔɔ siɛɛliaa « il ne laisse pas nos pieds glisser » (PSA.66.9) ; mɛɛ vana mɔiyan ma co o hɔl-lo siɛɛliaa « comme un homme ivre qui titube » (ISA.24.20) ; nɛi vana siɛɛliaa coo (PSA.35.6).</text></form></note>
  </entry>
  <entry id="síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀_3618">
    <lexical-unit><form lang="kqs"><text>síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀_3618_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>glissant</text></gloss>
      <gloss lang="en"><text>slippery, slick</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 331: síɛ́ɛ́lɛ̀-síɛ́ɛ́lɛ̀</text></form></note>
  </entry>
  <entry id="siɛɛmbiaa_3619">
    <lexical-unit><form lang="kqs"><text>siɛɛmbiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛmbiɛi</text></form></variant>
    <variant><form lang="kqs"><text>siɛɛmbian</text></form></variant>
    <sense id="siɛɛmbiaa_3619_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>pointu, acéré</text></gloss>
      <gloss lang="en"><text>sharp, pointed</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.45.6</text></form></note>
    <note><form lang="fr"><text>yɔmii siɛɛmbiɛi « javelots » (2 S 18,14) ; yɔɔn siɛɛmbiaa « épine acérée » (Ez 28,24).</text></form></note>
  </entry>
  <entry id="siɛɛnduu_3620">
    <lexical-unit><form lang="kqs"><text>siɛɛnduu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>siɛɛnduunin</text></form></variant>
    <sense id="siɛɛnduu_3620_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>aplanir, rendre droit (les chemins)</text></gloss>
      <gloss lang="en"><text>make straight, level (paths)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
      <trait name="semantic-domain-ddp4" value="6.5.4 Infrastructure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>straighten (plural of 'be straight'); sharpen</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first MAT.3.3; Childs 2000, p. 331: sìɛ̀ɛ̀ndùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de sandu « être droit ». la siɛɛnduu nɛila ndɔla pɔmbɔlan « aplanissez ses sentiers » (MAT.3.3) ; ndu siɛɛnduunin nɛila nɔmndan « il aplanira tes sentiers » (PRO.3.6).</text></form></note>
  </entry>
  <entry id="so laandoo_3621">
    <lexical-unit><form lang="kqs"><text>so laandoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="so laandoo_3621_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jument</text></gloss>
      <gloss lang="en"><text>mare</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Solaanduo; Lexique kissi–français, p. 50: solaanduo</text></form></note>
    <note><form lang="fr"><text>Keita écrit Solaanduo en un mot. Mots attestés séparément dans la Bible, mais pas cette expression.</text></form></note>
  </entry>
  <entry id="soaŋ_3622">
    <lexical-unit><form lang="kqs"><text>soaŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>soaŋnin</text></form></variant>
    <sense id="soaŋ_3622_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>punir, châtier ; réprimander</text></gloss>
      <gloss lang="en"><text>punish, chastise; rebuke</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 21 occurrences, first EXO.20.5</text></form></note>
  </entry>
  <entry id="sodasinɔɔ_3623">
    <lexical-unit><form lang="kqs"><text>sodasinɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sodasinɔɔ_3623_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soldat</text></gloss>
      <gloss lang="en"><text>soldier</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 145: Sodasinöö; Lexique kissi–français, p. 50: sodasinɔɔ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 51 : aussi sɔdasinɔɔ.</text></form></note>
  </entry>
  <entry id="soeiŋi bɛndie_3624">
    <lexical-unit><form lang="kqs"><text>soeiŋi bɛndie</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="soeiŋi bɛndie_3624_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terreur, grande peur</text></gloss>
      <gloss lang="en"><text>terror, great fear</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: soeiŋi bɛndie</text></form></note>
    <note><form lang="fr"><text>Graphie à confirmer ; comparer siòònde « peur » et bɛndu « grand ».</text></form></note>
  </entry>
  <entry id="sofɛlnɔɔ_3625">
    <lexical-unit><form lang="kqs"><text>sofɛlnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="sofɛlnɔɔ_3625_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chauffeur</text></gloss>
      <gloss lang="en"><text>driver</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6 Occupation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 50: sofernɔɔ</text></form></note>
    <note><form lang="fr"><text>Emprunt (français chauffeur). Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
