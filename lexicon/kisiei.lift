  <entry id="pangaa_2524">
    <lexical-unit><form lang="kqs"><text>pangaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>panga</text></form></variant>
    <variant><form lang="kqs"><text>pangala</text></form></variant>
    <sense id="pangaa_2524_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>case de champ, abri ; champ</text></gloss>
      <gloss lang="en"><text>field hut, shelter; field, farm</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.9 Farmland"/>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>farm kitchen, thatched hut at the farm (also for sleeping); the rice farm itself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.1.8; Childs 2000, p. 289: pàŋáá</text></form></note>
    <note><form lang="fr"><text>mɛɛ pangaa … o nakɔ n'rɛsɛnndo nin « comme une cabane dans une vigne » (Es 1,8) ; n va maalon yiiyo tumbulan o panga « nous liions des gerbes au champ » (Gn 37,7) ; o Boas lo panga « dans le champ de Booz » (Rt 2,17).</text></form></note>
  </entry>
