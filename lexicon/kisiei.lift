  <entry id="yavaa_3821">
    <lexical-unit><form lang="kqs"><text>yavaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yavalan</text></form></field>
    <sense id="yavaa_3821_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>divination, consultation des sorts (vanaa viamaa yavaa « devins, magiciens »)</text></gloss>
      <gloss lang="en"><text>divination (vanaa viamaa yavaa 'diviners, magicians')</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a potion used to uncover the truth or foretell; a fortune teller's parcel</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 40 occurrences, first GEN.41.8; Childs 2000, p. 400: yàwàá</text></form></note>
    <note><form lang="fr"><text>yavalan vomɔɔ « pratiquer la divination » (2KI.21.6).</text></form></note>
  </entry>
