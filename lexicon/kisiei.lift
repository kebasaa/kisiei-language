      <gloss lang="en"><text>strip, peel, trim; pull off (fibre); beat (until one cries)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.4 Tear, rip"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 13: bèyó</text></form></note>
