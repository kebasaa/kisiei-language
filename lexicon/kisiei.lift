    <note><form lang="fr"><text>Une seule occurrence, en fin de liste des reptiles impurs (LEV.11.30). Lexique kissi–français, p. 39 écrit ɲangafello.</text></form></note>
  </entry>
  <entry id="ɲǎnìkpɔ́léŋ_5032">
    <lexical-unit><form lang="kqs"><text>ɲǎnìkpɔ́léŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="ɲǎnìkpɔ́léŋ_5032_s1">
      <grammatical-info value="Noun"/>
