    <trait name="status" value="respelled"/>
    <sense id="ɲindin_4181_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>appliquer (un remède) sur le corps ; mettre une compresse</text></gloss>
      <gloss lang="en"><text>apply (a remedy) to the body; apply a compress</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 162: nyindin; Childs 2000, p. 280: ɲìndìó</text></form></note>
    <note><form lang="fr"><text>Keita (p. 162, dialogue sur un remède) : « a nyindin dialon a man ». Kissi du Sud ɲìndìó (Childs).</text></form></note>
  </entry>
