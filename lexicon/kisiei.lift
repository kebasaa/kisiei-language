  <entry id="m̀-ḿ_2559">
    <lexical-unit><form lang="kqs"><text>m̀-ḿ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="m̀-ḿ_2559_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>non</text></gloss>
      <gloss lang="en"><text>no</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="9.4.6 Yes"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 251: m̀-ḿ</text></form></note>
  </entry>
  <entry id="ḿ-m̀_2560">
