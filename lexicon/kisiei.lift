  <entry id="viw_3635">
    <lexical-unit><form lang="kqs"><text>viw</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viwnin</text></form></variant>
    <variant><form lang="kqs"><text>viwanin</text></form></variant>
    <sense id="viw_3635_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>durer, tarder, rester longtemps</text></gloss>
      <gloss lang="en"><text>last long, linger, delay</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first GEN.8.7</text></form></note>
    <note><form lang="fr"><text>o viw le « il ne dure pas » (JOB.14.2) ; la viwnin le « vous ne prolongerez pas vos jours » (DEU.30.18).</text></form></note>
  </entry>
  <entry id="viɔw_3636">
    <lexical-unit><form lang="kqs"><text>viɔw</text></form></lexical-unit>
