    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bàfèíyó_31_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri provisoire (au marché)</text></gloss>
      <gloss lang="en"><text>temporary shelter (at markets)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bàfèíyó</text></form></note>
  </entry>
  <entry id="bahavɛiyo_32">
    <lexical-unit><form lang="kqs"><text>bahavɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bahavɛi</text></form></variant>
    <sense id="bahavɛiyo_32_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>affaire, besoin, demande ; occupation</text></gloss>
      <gloss lang="en"><text>matter, need, request; business</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="9.1.3 Thing"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>being busy or preoccupied; being in need or in trouble (lit. 'hand-stuck')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.47.12; Childs 2000, p. 5: bà-hàwɛ́íyó</text></form></note>
    <note><form lang="fr"><text>yungu bahavɛiyo « le clan le plus pauvre » (Jg 6,15) ; o bahavɛiyo pum nin « occupé à quelque affaire » (1 R 18,27).</text></form></note>
  </entry>
  <entry id="bákáá_33">
    <lexical-unit><form lang="kqs"><text>bákáá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bákáláŋ</text></form></field>
    <sense id="bákáá_33_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouillie de riz pour enfants</text></gloss>
      <gloss lang="en"><text>rice mush for children</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bákáá</text></form></note>
    <note><form lang="fr"><text>Keita (p. 80) a « a de bakaa » (manger du bakaa), sans glose.</text></form></note>
  </entry>
  <entry id="bákéé_34">
    <lexical-unit><form lang="kqs"><text>bákéé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bákéé_34_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bâillement (souligne le bâillement)</text></gloss>
      <gloss lang="en"><text>yawning widely</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 5: bákéé</text></form></note>
  </entry>
  <entry id="bako_35">
    <lexical-unit><form lang="kqs"><text>bako</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bako_35_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>(bako bɛɛ + négation) pas un mot, pas du tout</text></gloss>
      <gloss lang="en"><text>(bako bɛɛ + negative) not a word, not at all</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note><form lang="fr"><text>Kɛ bako bɛɛ o suu le « il n'ouvrit pas la bouche » (Es 53,7).</text></form></note>
  </entry>
  <entry id="bakpeŋndo_36">
    <lexical-unit><form lang="kqs"><text>bakpeŋndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bakpeŋndo_36_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>poignet</text></gloss>
      <gloss lang="en"><text>wrist</text></gloss>
