    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>felenfelennde</text></form></variant>
    <variant><form lang="kqs"><text>felenfelen</text></form></variant>
    <sense id="felenfelenndo_842_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tourbillon, ouragan</text></gloss>
