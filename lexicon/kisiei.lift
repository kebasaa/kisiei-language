  <entry id="tɛu_1753">
    <lexical-unit><form lang="kqs"><text>tɛu</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="tɛu_1753_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière</text></gloss>
      <gloss lang="en"><text>termite mound</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chaff, rice straw left after threshing</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 137: Tèu; Childs 2000, p. 358: tèùwó</text></form></note>
    <note><form lang="fr"><text>Le sens « termitière » est douteux : la Bible a tɛwvo « paille, chaume » (1CO.3.12), comme le mot de Childs.</text></form></note>
  </entry>
  <entry id="tɛɛkpaa_1754">
