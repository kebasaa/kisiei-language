    <trait name="status" value="southern"/>
    <sense id="cììpùùwó_433_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>goûter cru, non cuit</text></gloss>
      <gloss lang="en"><text>taste raw, uncooked</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 47: cììpùùwó</text></form></note>
  </entry>
  <entry id="ciiye_434">
    <lexical-unit><form lang="kqs"><text>ciiye</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="ciiye_434_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>souche (d'arbre)</text></gloss>
      <gloss lang="en"><text>tree stump</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tree stump; foundation of a house</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DAN.4.12; Childs 2000, p. 47: cììyé</text></form></note>
    <note><form lang="fr"><text>mì la mɛi ciiye a puundon yondoo nin « mais laissez la souche avec ses racines dans la terre » (DAN.4.12, 4.20, 4.23).</text></form></note>
  </entry>
  <entry id="cìíyo_435">
    <lexical-unit><form lang="kqs"><text>cìíyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cìíyo_435_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>buffle ; bœuf sauvage</text></gloss>
      <gloss lang="en"><text>buffalo, wild ox</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 161 occurrences, first GEN.5.12; Childs 2000, p. 47: cìíyó</text></form></note>
    <note><form lang="fr"><text>maa cìíyo « comme le buffle » (NUM.23.22) ; JOB.39.9. À distinguer de ciiyo « vivre ».</text></form></note>
  </entry>
  <entry id="ciiŋiaa_436">
