    <variant><form lang="kqs"><text>vanpiaandu</text></form></variant>
    <sense id="vanpiaandua_3598_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hommes (personnes de sexe masculin), mâles</text></gloss>
      <gloss lang="en"><text>men, male persons</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 304 occurrences, first GEN.10.21; Childs 2000, p. 381: wàŋpìàndòó</text></form></note>
    <note><form lang="fr"><text>Pluriel ; singulier vanpiaandu (MAT.19.12). De van- (vanndo « personne ») et piaandoo « mâle ».</text></form></note>
  </entry>
  <entry id="vawvo_3599">
    <lexical-unit><form lang="kqs"><text>vawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vawvan</text></form></field>
    <sense id="vawvo_3599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier à huile ; palmier</text></gloss>
      <gloss lang="en"><text>oil palm; palm tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first SNG.7.9; Keita 1979, p. 140: Vawvo</text></form></note>
    <note><form lang="fr"><text>Pluriel vawvan (EXO.15.27) ; vawlan désigne les palmes (LEV.23.40).</text></form></note>
  </entry>
  <entry id="vayia_3600">
    <lexical-unit><form lang="kqs"><text>vayia</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vayia_3600_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fouler, presser (le raisin) ; tasser (la terre)</text></gloss>
      <gloss lang="en"><text>tread, press (grapes); tread down (soil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wring, squeeze (e.g. cloth)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.40.11; Childs 2000, p. 381: wàyìá</text></form></note>
    <note><form lang="fr"><text>vana vayia rɛsɛnndon o doola nin « celui qui foule le raisin dans la cuve » (LAM.1.15).</text></form></note>
  </entry>
  <entry id="vaŋ_3601">
    <lexical-unit><form lang="kqs"><text>vaŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vaŋ_3601_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(idéophone) tout à fait ; d'un rouge vif (lasiaŋa vaŋ, diw vaŋ)</text></gloss>
      <gloss lang="en"><text>(ideophone) completely; bright red (lasiaŋa vaŋ, diw vaŋ)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.11.1</text></form></note>
  </entry>
  <entry id="veeliaa_3602">
    <lexical-unit><form lang="kqs"><text>veeliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veeliaanin</text></form></variant>
    <sense id="veeliaa_3602_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>dessécher, tarir (les eaux, les fleuves)</text></gloss>
      <gloss lang="en"><text>dry up (waters, rivers)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dry up (plural of wèlàá 'become dry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first PSA.66.6; Childs 2000, p. 382: wèèlìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de velaa « tarir ». I veeliaa peelan Esipte kpow « j'ai tari tous les fleuves d'Égypte » (ISA.37.25).</text></form></note>
  </entry>
  <entry id="veeloo_3603">
    <lexical-unit><form lang="kqs"><text>veeloo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veelu</text></form></variant>
    <variant><form lang="kqs"><text>veelunin</text></form></variant>
    <sense id="veeloo_3603_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>appeler ; invoquer</text></gloss>
      <gloss lang="en"><text>call ; call; call upon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>call, name</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 127 occurrences, first GEN.4.26; Keita 1979, p. 114: Veeluo; Childs 2000, p. 382: wèèlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit veeluo ; la Bible écrit veeloo (GEN 4,26).</text></form></note>
  </entry>
  <entry id="veeluanndo_3604">
    <lexical-unit><form lang="kqs"><text>veeluanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="veeluanndo_3604_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'interpeller</text></gloss>
      <gloss lang="en"><text>call one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Veeluanndo</text></form></note>
    <note><form lang="fr"><text>Réciproque de veeloo.</text></form></note>
  </entry>
  <entry id="veelul_3605">
    <lexical-unit><form lang="kqs"><text>veelul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veelul_3605_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>appeler (qqn) pour (qqn), faire venir</text></gloss>
      <gloss lang="en"><text>call (someone) for (someone), summon</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first NUM.22.5; Childs 2000, p. 382: wèèlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de veeloo « appeler ». mà kɔ veelul ndu ndu « qu'ils aillent le lui appeler » (NUM.22.5).</text></form></note>
  </entry>
  <entry id="veelɔnndo_3606">
    <lexical-unit><form lang="kqs"><text>veelɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veelɔnndo_3606_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être appelé, s'appeler</text></gloss>
      <gloss lang="en"><text>be called, be named</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="9.7 Name"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>call oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first JER.7.10; Childs 2000, p. 382: wèèlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de veeloo.</text></form></note>
  </entry>
  <entry id="veesiaa_3607">
    <lexical-unit><form lang="kqs"><text>veesiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="veesiaa_3607_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire sécher, dessécher</text></gloss>
      <gloss lang="en"><text>make dry, wither</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.41.6; Keita 1979, p. 114: Veesiaa</text></form></note>
    <note><form lang="fr"><text>Causatif de vesaa (GEN 41,6).</text></form></note>
  </entry>
  <entry id="velaa_3608">
    <lexical-unit><form lang="kqs"><text>velaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vela</text></form></variant>
    <variant><form lang="kqs"><text>velanin</text></form></variant>
    <sense id="velaa_3608_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tarir, baisser (eaux)</text></gloss>
      <gloss lang="en"><text>dry up, recede (water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>become dry (of water)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.8.1; Keita 1979, p. 114: Velaa; Childs 2000, p. 382: wèlàá</text></form></note>
  </entry>
  <entry id="velan_3609">
    <lexical-unit><form lang="kqs"><text>velan</text></form></lexical-unit>
    <trait name="noun-class" value="lan"/>
    <trait name="status" value="attested"/>
    <sense id="velan_3609_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>image, ressemblance</text></gloss>
      <gloss lang="en"><text>image, likeness</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>resemblances (from wèlǎŋndó 'resemble')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 67 occurrences, first GEN.1.26; Childs 2000, p. 383: wèlâŋndáŋ</text></form></note>
    <note><form lang="fr"><text>Verbe apparenté vel « ressembler à » (Gn 1,26).</text></form></note>
  </entry>
  <entry id="velanndo_3610">
    <lexical-unit><form lang="kqs"><text>velanndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="velanndo_3610_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se tarir (Keita) ; ressemblance, sens (Bible)</text></gloss>
      <gloss lang="en"><text>dry up (Keita); likeness, meaning (Bible)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.2 Movement of water"/>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>resemble</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Velanndo; Childs 2000, p. 383: wèlǎŋndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, velanndo est « sens (d'un nom), ressemblance » (GEN 29,34), de vel « ressembler » ; le sens « se tarir » de Keita n'y est pas.</text></form></note>
  </entry>
  <entry id="vellaa-velle_3611">
    <lexical-unit><form lang="kqs"><text>vellaa-velle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vellaa-velle_3611_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>l'un l'autre, les uns les autres (réciproque)</text></gloss>
      <gloss lang="en"><text>one another, each other</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adverb) together</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 145 occurrences, first GEN.11.3; Childs 2000, p. 383: wéllàá-wèllè</text></form></note>
    <note><form lang="fr"><text>Má dimulan vellaa-velle « ils se dirent l'un à l'autre » (GEN.11.3).</text></form></note>
  </entry>
  <entry id="velu_3612">
    <lexical-unit><form lang="kqs"><text>velu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="velu_3612_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>engendrer (père)</text></gloss>
      <gloss lang="en"><text>beget, father</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bear, give birth, be born; resemble (the stem wélù is used of a father siring)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 289 occurrences, first GEN.5.4; Childs 2000, p. 386: wìòlɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="velun_3613">
    <lexical-unit><form lang="kqs"><text>velun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="velun_3613_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>naître</text></gloss>
      <gloss lang="en"><text>be born</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 87 occurrences, first GEN.11.28; Childs 2000, p. 386: wìòlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de velu.</text></form></note>
  </entry>
  <entry id="vennun_3614">
    <lexical-unit><form lang="kqs"><text>vennun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vennun_3614_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se réfugier, s'échapper, se mettre à l'abri ; échapper (à l'attention de)</text></gloss>
      <gloss lang="en"><text>take refuge, escape, flee to safety; escape (the notice of)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
      <trait name="semantic-domain-ddp4" value="7.2.3 Move toward something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hide oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first GEN.31.20; Childs 2000, p. 384: wɛ̀nɔ̌ŋndɔ́</text></form></note>
  </entry>
  <entry id="vesaa_3615">
    <lexical-unit><form lang="kqs"><text>vesaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vesa</text></form></variant>
    <variant><form lang="kqs"><text>vesanin</text></form></variant>
    <sense id="vesaa_3615_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>sécher, être sec</text></gloss>
      <gloss lang="en"><text>dry, be dry</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JOB.18.16; Keita 1979, p. 114: Vesaa; Childs 2000, p. 383: wèsàá</text></form></note>
  </entry>
  <entry id="veselɛilen_3616">
    <lexical-unit><form lang="kqs"><text>veselɛilen</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>veselɛile</text></form></variant>
    <sense id="veselɛilen_3616_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>aride, désertique (lɛŋnde veselɛilen « désert »)</text></gloss>
      <gloss lang="en"><text>arid, desert (lɛŋnde veselɛilen 'desert, wilderness')</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 288 occurrences, first GEN.12.9</text></form></note>
  </entry>
  <entry id="vesul_3617">
    <lexical-unit><form lang="kqs"><text>vesul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vesul_3617_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>asperger</text></gloss>
      <gloss lang="en"><text>sprinkle</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>splash</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first LEV.4.6; Childs 2000, p. 384: wèsùlló</text></form></note>
  </entry>
  <entry id="vesɛiyo_3618">
    <lexical-unit><form lang="kqs"><text>vesɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vesɛi</text></form></variant>
    <variant><form lang="kqs"><text>vesɛiya</text></form></variant>
    <variant><form lang="kqs"><text>vesɛilan</text></form></variant>
    <variant><form lang="kqs"><text>vesɛilen</text></form></variant>
    <sense id="vesɛiyo_3618_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>sec ; dur ; terre ferme</text></gloss>
      <gloss lang="en"><text>dry; hard; dry land</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.3.3 Wet"/>
      <trait name="semantic-domain-ddp4" value="1.2.1 Land"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 58 occurrences, first GEN.1.9; Childs 2000, p. 383: wèsɛ́í</text></form></note>
  </entry>
  <entry id="viamaa_3619">
    <lexical-unit><form lang="kqs"><text>viamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viam</text></form></variant>
    <variant><form lang="kqs"><text>vim</text></form></variant>
    <variant><form lang="kqs"><text>viamnin</text></form></variant>
    <sense id="viamaa_3619_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>envoyer (qqn)</text></gloss>
      <gloss lang="en"><text>send (someone)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first GEN.41.8; Childs 2000, p. 387: wìòmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>vanaa viamaa yavaa « les magiciens » (Gn 41,8).</text></form></note>
  </entry>
  <entry id="viannan_3620">
    <lexical-unit><form lang="kqs"><text>viannan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>viannanndo</text></form></variant>
    <variant><form lang="kqs"><text>viannannda</text></form></variant>
    <variant><form lang="kqs"><text>viannanndon</text></form></variant>
    <sense id="viannan_3620_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>caché, secret ; de refuge</text></gloss>
      <gloss lang="en"><text>hidden, secret; of refuge</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.6 Hide"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 33 occurrences, first DEU.4.43</text></form></note>
    <note><form lang="fr"><text>Kobi viannan « ville de refuge ».</text></form></note>
  </entry>
  <entry id="vii_3621">
    <lexical-unit><form lang="kqs"><text>vii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vii_3621_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>lapider (vii … a powtan)</text></gloss>
      <gloss lang="en"><text>stone (vii … a powtan)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 43 occurrences, first EXO.17.4</text></form></note>
  </entry>
  <entry id="viiku_3622">
    <lexical-unit><form lang="kqs"><text>viiku</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vííkù</text></form></variant>
    <sense id="viiku_3622_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>avorter, mettre bas avant terme ; (nom) avorton</text></gloss>
      <gloss lang="en"><text>miscarry, cast young; (noun) untimely birth</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
      <trait name="semantic-domain-ddp4" value="1.6.3 Animal life cycle"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>miscarry, abort; also lose a spouse through death</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first GEN.31.38; Childs 2000, p. 385: wììkùùwó</text></form></note>
    <note><form lang="fr"><text>saa nɔmnda a cuinaa nɔmnda ve viiku le « tes brebis et tes chèvres n'ont pas avorté » (GEN.31.38) ; cɛlɛkpɛ nda viiku-o « l'enfant mort-né » (PSA.58.9).</text></form></note>
  </entry>
  <entry id="vííyo_3623">
    <lexical-unit><form lang="kqs"><text>vííyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vííya</text></form></field>
    <sense id="vííyo_3623_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>orphelin</text></gloss>
      <gloss lang="en"><text>orphan</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first EXO.19.13; Keita 1979, p. 134: Viiyo; Childs 2000, p. 385: wììyó</text></form></note>
    <note><form lang="fr"><text>La Bible écrit vííyo avec tons ; viiyo sans ton y signifie « lapidation » (Lv 20,2).</text></form></note>
  </entry>
  <entry id="vilio_3624">
    <lexical-unit><form lang="kqs"><text>vilio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vili</text></form></variant>
    <sense id="vilio_3624_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>porter (des charges), transporter ; mener, conduire</text></gloss>
      <gloss lang="en"><text>carry (loads), transport; lead, conduct</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>carry loads, haul, draw (plural of 'bear, carry')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 27 occurrences, first NUM.4.24; Childs 2000, p. 386: wìlìó</text></form></note>
    <note><form lang="fr"><text>nɔm vili ndi niko Yerusalɛm « tu les mèneras à Jérusalem » (2CH.2.15).</text></form></note>
  </entry>
  <entry id="vilul_3625">
    <lexical-unit><form lang="kqs"><text>vilul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="vilul_3625_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enfanter (un enfant) à qqn</text></gloss>
      <gloss lang="en"><text>bear (a child) to someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.3 Birth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>deliver (a child) for someone, as a midwife</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first GEN.4.21; Childs 2000, p. 386: wìlùlló</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de violɔɔ « enfanter ».</text></form></note>
  </entry>
  <entry id="vilɛi_3626">
    <lexical-unit><form lang="kqs"><text>vilɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vilɛiye</text></form></variant>
    <variant><form lang="kqs"><text>vilɛilan</text></form></variant>
    <sense id="vilɛi_3626_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>long, haut, élevé</text></gloss>
      <gloss lang="en"><text>long, high, tall</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2.2 Long"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>long, tall, sharp</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 90 occurrences, first GEN.6.4; Childs 2000, p. 385: wìlɛ̀-</text></form></note>
    <note><form lang="fr"><text>pembii vilɛiye « une haute montagne » (MAT.17.1) ; yiiŋii vilɛiye « longue chevelure » (1CO.11.15) ; cɛila coocoola vilɛilan « les hautes tours » (ISA.2.15). Écrit sans accents, à la différence de vílɛ́iyo « mort ».</text></form></note>
  </entry>
  <entry id="vilɛi-vilɛi_3627">
    <lexical-unit><form lang="kqs"><text>vilɛi-vilɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>vilɛi-vilɛiya</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiye</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiyo</text></form></variant>
    <variant><form lang="kqs"><text>vilɛi-vilɛiyon</text></form></variant>
    <sense id="vilɛi-vilɛi_3627_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>très grand, de haute taille ; (vanaa vilɛi-vilɛiya) géants</text></gloss>
      <gloss lang="en"><text>very tall, huge; (vanaa vilɛi-vilɛiya) giants</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first 2SA.23.21; Childs 2000, p. 385: wìlɛ̀-</text></form></note>
    <note><form lang="fr"><text>Redoublement de vilɛi. Esiptenɔ vilɛi-vilɛi « un Égyptien de haute taille » (2SA.23.21) ; kpɛŋɛ lemasa vilɛi-vilɛiyo « un trône très élevé » (ISA.6.1).</text></form></note>
  </entry>
  <entry id="vílɛ́iyo_3628">
    <lexical-unit><form lang="kqs"><text>vílɛ́iyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>vílɛ́iya</text></form></field>
    <variant><form lang="kqs"><text>vílɛ́i</text></form></variant>
    <sense id="vílɛ́iyo_3628_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mort, cadavre</text></gloss>
      <gloss lang="en"><text>dead person, corpse</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="1.4.1 Dead things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(adjective) dead, deceased</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 84 occurrences, first GEN.23.3; Childs 2000, p. 385: wìlɛ́í-</text></form></note>
    <note><form lang="fr"><text>vanvilɛiya « les morts » (Mc 6,14) ; langbanɔ falun vilɛi « l'homme paralysé » (Mt 9,6).</text></form></note>
  </entry>
  <entry id="violɔɔ_3629">
