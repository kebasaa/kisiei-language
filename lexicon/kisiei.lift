  </entry>
  <entry id="babɛngoo_57">
    <lexical-unit><form lang="kqs"><text>babɛngoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bahandaa</text></form></variant>
    <variant><form lang="kqs"><text>babɛngulen</text></form></variant>
    <sense id="babɛngoo_57_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>protection ; protectorat</text></gloss>
      <gloss lang="en"><text>protection; protectorate</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.4 Prosperity, trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 503: Bahandaa, babèngoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi bahandaa ; lɛŋnde co o babɛngulen « protectorat » (histoire n° 504).</text></form></note>
  </entry>
  <entry id="babɛnguyɛi_58">
    <lexical-unit><form lang="kqs"><text>babɛnguyɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>babɛngunɔɔ</text></form></variant>
    <sense id="babɛnguyɛi_58_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>dépendance, tutelle ; (babɛngunɔɔ) tributaire</text></gloss>
      <gloss lang="en"><text>dependence, tutelage; (babɛngunɔɔ) tributary, dependant</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
      <trait name="semantic-domain-ddp4" value="4.5 Authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 284: Babènguyèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi idéologie n° 631 « tutelle » ; babɛngunɔɔ « tributaire » (n° 623) ; cf. babɛngoo « protection ».</text></form></note>
  </entry>
  <entry id="bácù_59">
