    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bandólan</text></form></field>
    <variant><form lang="kqs"><text>bandóla</text></form></variant>
    <sense id="bàndóó_33_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>estrade, plate-forme ; tour de guet ; table (pour les sacrifices)</text></gloss>
      <gloss lang="en"><text>platform, raised stand; watchtower; table (for sacrifices)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>platform from which birds are driven off the crops</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first 2CH.6.13; Childs 2000, p. 7: bàndóó</text></form></note>
    <note><form lang="fr"><text>bandólan « tables » du temple (Ez 40,39-42) ; « hauts lieux » (Ez 16,24).</text></form></note>
  </entry>
