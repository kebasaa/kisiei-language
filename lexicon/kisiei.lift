  <entry id="kalankafoo_1234">
    <lexical-unit><form lang="kqs"><text>kalankafoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kalankafo</text></form></variant>
    <sense id="kalankafoo_1234_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>revenant, esprit d'un mort</text></gloss>
      <gloss lang="en"><text>ghost, spirit of the dead</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>ghost of a dead person not yet among the ancestors</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kalankafoo; Childs 2000, p. 269: ŋàlàŋàfɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Forme radicale attestée : diom kalankafo « la voix d'un revenant » (Is 29,4).</text></form></note>
  </entry>
  <entry id="kalaŋaa_1235">
    <lexical-unit><form lang="kqs"><text>kalaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kalaŋan</text></form></variant>
    <variant><form lang="kqs"><text>kalaŋanin</text></form></variant>
    <variant><form lang="kqs"><text>kalaŋanndo</text></form></variant>
    <sense id="kalaŋaa_1235_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être déterré, mis à nu, retourné ; arracher, faire sortir</text></gloss>
      <gloss lang="en"><text>be dug up, laid bare, turned up; pull out, bring up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.6 Dig"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(middle of 'dig up') be dug up, uprooted</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.28.5; Childs 2000, p. 145: kàlàŋndó</text></form></note>
    <note><form lang="fr"><text>lɛŋnde tumnden le kalaŋan « les fondements du monde furent mis à nu » (2SA.22.16) ; Hala kalaŋanin mun ndu o dembe « Dieu les fera sortir de son ventre » (JOB.20.15). Cf. kalaa « déterrer ».</text></form></note>
  </entry>
  <entry id="kàláŋndó_1236">
    <lexical-unit><form lang="kqs"><text>kàláŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kàláŋndó_1236_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hotte en fibre de palmier (« kinja ») ; fétiche porté au cou ou à la taille ; remède contre le béribéri</text></gloss>
      <gloss lang="en"><text>palm-fibre hamper ('kinja'); fetish worn at the neck or waist; remedy for beriberi</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 145: kàláŋndó</text></form></note>
  </entry>
  <entry id="kaloo_1237">
