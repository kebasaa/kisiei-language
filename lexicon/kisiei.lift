    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="yòù-nàùwó_6215_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aigrette, héron garde-bœufs</text></gloss>
      <gloss lang="en"><text>white egret, cattle egret</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 413: yòù-nàùwó</text></form></note>
  </entry>
  <entry id="yòù-yɔ̀ɔ̀yàá_6216">
    <lexical-unit><form lang="kqs"><text>yòù-yɔ̀ɔ̀yàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
