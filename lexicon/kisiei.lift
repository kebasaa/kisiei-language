      <gloss lang="en"><text>ruin, nothingness; (cuu itambu) come to ruin</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 45 occurrences, first NUM.21.30</text></form></note>
