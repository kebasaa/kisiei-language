      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 37 occurrences, first GEN.50.23</text></form></note>
    <note><form lang="fr"><text>lambilan a lambilan « de génération en génération » ; lambi diinndɔ « une seconde fois » (Jos 5,2).</text></form></note>
  </entry>
  <entry id="lámbùíyó_2342">
    <lexical-unit><form lang="kqs"><text>lámbùíyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="lámbùíyó_2342_s1">
