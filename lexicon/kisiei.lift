    <lexical-unit><form lang="kqs"><text>fɛ̀ɛ̀nɛ̀nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>fɛ̀ɛ̀nìá</text></form></field>
