  <entry id="la_2992">
    <lexical-unit><form lang="kqs"><text>la</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>da</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="la_2992_s1">
      <grammatical-info value="Pronoun"/>
      <gloss lang="fr"><text>vous (sujet) ; pronom de la classe lan</text></gloss>
      <gloss lang="en"><text>you (pl., subject); lan-class pronoun</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11817 occurrences, first GEN.1.11; Paulme 1964, p. 17 (G): da /G./; Lexique kissi–français, p. 31: la; Childs 2000, p. 220: là</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 17 : da /G./ « vous (2e personne du pluriel) ». Aussi Paulme 1964, p. 55 : « lā, a ». Paulme 1964, p. 55 : lā, a « pronom personnel du pluriel ». Paulme : da /G./ « vous » (p. 17).</text></form></note>
  </entry>
  <entry id="laalan ɲɛmcieendon_2993">
    <lexical-unit><form lang="kqs"><text>laalan ɲɛmcieendon</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="laalan ɲɛmcieendon_2993_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>matérialisme</text></gloss>
      <gloss lang="en"><text>materialism</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9 Religion"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (idéologie), n° 417: Laalan nyèmtyieendon</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi vana laalan ɲɛmcieendonndo « matérialiste » (idéologie n° 418).</text></form></note>
  </entry>
  <entry id="laalanndo_2994">
    <lexical-unit><form lang="kqs"><text>laalanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>laalan</text></form></variant>
    <variant><form lang="kqs"><text>laalannda</text></form></variant>
    <variant><form lang="kqs"><text>laaran</text></form></variant>
    <sense id="laalanndo_2994_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>croire, avoir foi, se fier à ; foi</text></gloss>
      <gloss lang="en"><text>believe, trust; faith</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>believe, trust; be sure of</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 188 occurrences, first EXO.4.9; Lexique kissi–français, p. 31: laaran; Childs 2000, p. 221: làálàŋndó</text></form></note>
    <note><form lang="fr"><text>vanaa laalannda « les croyants, les fidèles ». Lexique kissi–français, p. 31 : laaran « croire, convertir à ».</text></form></note>
  </entry>
  <entry id="laalantɛnɔɔ_2995">
    <lexical-unit><form lang="kqs"><text>laalantɛnɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="laalantɛnɔɔ_2995_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>païen, incroyant</text></gloss>
      <gloss lang="en"><text>pagan, unbeliever</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Laalantènöö; Lexique kissi–français, p. 31: laalantɛnɔɔ</text></form></note>
    <note><form lang="fr"><text>Cf. laalan « croire » dans la Bible. Lexique kissi–français, p. 31 : glosé « le pas » (sans doute pour « le païen »).</text></form></note>
  </entry>
  <entry id="laalaŋaa_2996">
    <lexical-unit><form lang="kqs"><text>laalaŋaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="laalaŋaa_2996_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>(vanaa laalaŋaa) assemblée des croyants, Église</text></gloss>
      <gloss lang="en"><text>(vanaa laalaŋaa) assembly of believers, church</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 42 occurrences, first MAT.16.18</text></form></note>
  </entry>
  <entry id="laaloo_2997">
    <lexical-unit><form lang="kqs"><text>laaloo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>hɔlla hinndo</text></form></variant>
    <sense id="laaloo_2997_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assaut ; harceler</text></gloss>
      <gloss lang="en"><text>assault; harass</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 78: Laaloo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Académie des langues (terminologie, histoire n° 375) : « harceler » (aussi hɔlla hinndo).</text></form></note>
  </entry>
  <entry id="laandoo_2998">
    <lexical-unit><form lang="kqs"><text>laandoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>laandaa</text></form></field>
    <variant><form lang="kqs"><text>laandu</text></form></variant>
    <variant><form lang="kqs"><text>laandon</text></form></variant>
    <variant><form lang="kqs"><text>laandun</text></form></variant>
    <sense id="laandoo_2998_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>femelle ; de sexe féminin</text></gloss>
      <gloss lang="en"><text>female</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 111 occurrences, first GEN.6.19; Paulme 1964, p. 55 (G/K): lando /G./, landu /K./; Childs 2000, p. 221: làándò-</text></form></note>
    <note><form lang="fr"><text>cuaambɔɔ laandu « une jeune fille » ; pɔmbɔ naa laandu « notre petite sœur ». Paulme 1964, p. 55 : nawolandu « vache », pl. nawalandua.</text></form></note>
  </entry>
  <entry id="laanduyɛi_2999">
    <lexical-unit><form lang="kqs"><text>laanduyɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="laanduyɛi_2999_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>féminin</text></gloss>
      <gloss lang="en"><text>feminine</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 179: Laanduyèi</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="laasi-laasi_3000">
    <lexical-unit><form lang="kqs"><text>laasi-laasi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>laasi-laasio</text></form></variant>
    <variant><form lang="kqs"><text>laasi-laasian</text></form></variant>
    <sense id="laasi-laasi_3000_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>dans la confusion, en désordre ; pervers</text></gloss>
      <gloss lang="en"><text>in confusion, in disarray; perverse</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first 1SA.7.10; Terminologie (idéologie), n° 630: Laasilaasioo, hölaa hinnanda; Childs 2000, p. 221: láásì-láásì</text></form></note>
    <note><form lang="fr"><text>De laasiaa « troubler, corrompre ». yɔŋnun laasi-laasi « être mis en déroute » (1 S 7,10) ; sɔɔn laasi-laasi « paroles perverses » (Jr 15,19). Académie des langues (terminologie, idéologie n° 630) : laasilaasioo « troubles » (aussi hɔlaa hinnanda).</text></form></note>
  </entry>
  <entry id="laasiaa_3001">
    <lexical-unit><form lang="kqs"><text>laasiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="laasiaa_3001_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>corrompre, perdre ; troubler, confondre (les langues)</text></gloss>
      <gloss lang="en"><text>corrupt, ruin; confuse (languages)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.1 Damage"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mix up, ruin; play tricks, act foolishly; lose, get lost</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 44 occurrences, first GEN.11.9; Childs 2000, p. 221: làásìá</text></form></note>
    <note><form lang="fr"><text>Causatif de laasian.</text></form></note>
  </entry>
  <entry id="laasianndo_3002">
    <lexical-unit><form lang="kqs"><text>laasianndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>laasian</text></form></variant>
    <variant><form lang="kqs"><text>laasiannda</text></form></variant>
    <sense id="laasianndo_3002_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire le mal, se corrompre, pécher ; méchanceté</text></gloss>
      <gloss lang="en"><text>do wrong, be corrupt, sin; wickedness</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.18.20</text></form></note>
    <note><form lang="fr"><text>vanaa laasiannda « les méchants ».</text></form></note>
  </entry>
  <entry id="labɛngu_3003">
    <lexical-unit><form lang="kqs"><text>labɛngu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>rabɛngu</text></form></variant>
    <sense id="labɛngu_3003_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>avec les pieds, sous les pieds</text></gloss>
      <gloss lang="en"><text>with the feet, underfoot</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 35 occurrences, first 1KI.7.34; Lexique kissi–français, p. 45: rabɛngu</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit rabɛngu (r pour l).</text></form></note>
  </entry>
  <entry id="labɛngunin_3004">
    <lexical-unit><form lang="kqs"><text>labɛngunin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>labɛngu</text></form></variant>
    <sense id="labɛngunin_3004_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>dessous, en bas ; (o … labɛngunin) sous, aux pieds de</text></gloss>
      <gloss lang="en"><text>below; (o … labɛngunin) under, at the feet of</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>under, between</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 248 occurrences, first GEN.16.9; Childs 2000, p. 14: bèŋù</text></form></note>
  </entry>
  <entry id="làbɛ́ŋù-níŋndó_3005">
    <lexical-unit><form lang="kqs"><text>làbɛ́ŋù-níŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="làbɛ́ŋù-níŋndó_3005_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>« entre les jambes » : euphémisme pour les parties génitales</text></gloss>
      <gloss lang="en"><text>'between the legs': euphemism for the genitals</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1 Body"/>
      <trait name="semantic-domain-ddp4" value="2.6.2 Sexual relations"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 221: làbɛ́ŋù-níŋndó</text></form></note>
  </entry>
  <entry id="labɛɛ_3006">
    <lexical-unit><form lang="kqs"><text>labɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>labɛɛla</text></form></variant>
    <sense id="labɛɛ_3006_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honte, déshonneur</text></gloss>
      <gloss lang="en"><text>shame, dishonour</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 50 occurrences, first GEN.34.2</text></form></note>
  </entry>
  <entry id="laci_3007">
    <lexical-unit><form lang="kqs"><text>laci</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="laci_3007_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>devant, en avant, en tête</text></gloss>
      <gloss lang="en"><text>ahead, in front, forward</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.1 Front"/>
      <trait name="semantic-domain-ddp4" value="8.5.2 Direction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 742 occurrences, first GEN.6.5; Lexique kissi–français, p. 31: laci</text></form></note>
    <note><form lang="fr"><text>Aussi Lexique kissi–français, p. 45 : « raci ». Lexique kissi–français, p. 45 écrit raci « avant ».</text></form></note>
  </entry>
  <entry id="lacio_3008">
    <lexical-unit><form lang="kqs"><text>lacio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lacio_3008_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avenir, ce qui est devant (siɔdii lacio « les jours à venir »)</text></gloss>
      <gloss lang="en"><text>the future, what lies ahead (siɔdii lacio, days to come)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the front; tomorrow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first PSA.78.55; Terminologie (arts), n° 109: Latyioo; Childs 2000, p. 221: làcìóó</text></form></note>
    <note><form lang="fr"><text>De laci « devant ». o siɔdii lacio nin « dans les jours à venir » (ISA.27.6). Académie des langues (terminologie, arts n° 109) : latyioo « façade ». Académie des langues (terminologie, histoire n° 97) : siödii latyioo (aussi tyilan) « avenir ».</text></form></note>
  </entry>
  <entry id="lácòó_3009">
    <lexical-unit><form lang="kqs"><text>lácòó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="lácòó_3009_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>gluant, visqueux</text></gloss>
      <gloss lang="en"><text>slimy</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.3.2 Texture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 221: lácòó</text></form></note>
  </entry>
  <entry id="lacòòvaa_3010">
    <lexical-unit><form lang="kqs"><text>lacòòvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lacòòvan</text></form></variant>
    <variant><form lang="kqs"><text>lacòòvalan</text></form></variant>
    <sense id="lacòòvaa_3010_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mensonger, faux ; (sɔɔn lacòòvan) mensonges</text></gloss>
      <gloss lang="en"><text>lying, false; (sɔɔn lacòòvan) lies</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 74 occurrences, first DEU.18</text></form></note>
