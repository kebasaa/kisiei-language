    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hard, difficult; also sharp, strong, effective; ripe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 13 occurrences, first DEU.21; Childs 2000, p. 144: kàlà-</text></form></note>
  </entry>
