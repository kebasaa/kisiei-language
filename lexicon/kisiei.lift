  <entry id="sabu_2838">
    <lexical-unit><form lang="kqs"><text>sabu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="sabu_2838_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cause, raison ; (le sabu yɛɛ) pourquoi ; (le sabu kon) c'est pourquoi</text></gloss>
