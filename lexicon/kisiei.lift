    <lexical-unit><form lang="kqs"><text>hiɔɔlundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>hiɔɔlundɔ</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔlen</text></form></variant>
    <variant><form lang="kqs"><text>hiɔɔlundɔɛi</text></form></variant>
    <sense id="hiɔɔlundɔɔ_543_s1">
      <grammatical-info value="Numeral"/>
      <gloss lang="fr"><text>quatrième</text></gloss>
      <gloss lang="en"><text>fourth</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.14.5; Childs 2000, p. 128: hìɔ́ɔ́lùndɔ́ɔ́-</text></form></note>
    <note><form lang="fr"><text>De hiɔɔlu « quatre ». paale hiɔɔlundɔlen « le quatrième jour » (Gn 1,19).</text></form></note>
  </entry>
  <entry id="ho_544">
