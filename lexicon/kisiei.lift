    <trait name="status" value="southern"/>
    <sense id="fàŋndó_831_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>longue machette à bout recourbé (pour couper l'herbe haute) ; sabre</text></gloss>
      <gloss lang="en"><text>long hooked cutlass (for tall grass); sword</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.1 Cutting tool"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 98: fàŋndó</text></form></note>
    <note><form lang="fr"><text>Emprunt mandé selon Childs.</text></form></note>
  </entry>
  <entry id="fé_832">
    <lexical-unit><form lang="kqs"><text>fé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="fé_832_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>du tout, quel qu'il soit, tout (après un distributif)</text></gloss>
      <gloss lang="en"><text>at all, any, every (after a distributive)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 99: fé</text></form></note>
  </entry>
  <entry id="fee_833">
    <lexical-unit><form lang="kqs"><text>fee</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="fee_833_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>partout, tout autour ; complètement</text></gloss>
      <gloss lang="en"><text>everywhere, all around; completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5.1 Here, there"/>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>very hard, intensively, by all means</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 66 occurrences, first DEU.22.27; Childs 2000, p. 99: féé</text></form></note>
    <note><form lang="fr"><text>ba-ba fee « de tous côtés » ; ɲɛ-ɲɛ fee « toutes choses ».</text></form></note>
  </entry>
  <entry id="féé_834">
