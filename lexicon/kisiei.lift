    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààtóndóó_4332_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>troupe qui danse à la mort d'un forgeron</text></gloss>
      <gloss lang="en"><text>dance troupe performing when a blacksmith dies</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 317: sààtóndóó</text></form></note>
