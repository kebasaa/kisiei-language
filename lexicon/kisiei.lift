    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kilitinöö; Lexique kissi–français, p. 24: kilitinɔɔ</text></form></note>
  </entry>
  <entry id="kilo_1599">
    <lexical-unit><form lang="kqs"><text>kilo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kilo_1599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>kilo, poids</text></gloss>
      <gloss lang="en"><text>kilogram, weight</text></gloss>
