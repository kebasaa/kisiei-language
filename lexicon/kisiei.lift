  <entry id="pɔlullo_2739">
    <lexical-unit><form lang="kqs"><text>pɔlullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pɔlul</text></form></variant>
    <variant><form lang="kqs"><text>pɔlulnin</text></form></variant>
    <sense id="pɔlullo_2739_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se calmer, s'apaiser (colère, douleur) ; apaiser</text></gloss>
      <gloss lang="en"><text>cool down, abate (anger, pain); calm</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
      <trait name="semantic-domain-ddp4" value="8.3.4 Hot"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cool (something, someone with a fever)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ZEC.6.8; Childs 2000, p. 309: pɔ̀lùlló</text></form></note>
    <note><form lang="fr"><text>haliko mi kɔltuw Mɛlɛka Hala niaa pɔlul « afin que la colère du Seigneur s'apaise » (DEU.13.18) ; sanga nuu pɔlulnin te « ma douleur ne s'apaise pas » (JOB.16.6) ; kɔl nuu pɔlullo « apaiser mon esprit » (ZEC.6.8).</text></form></note>
  </entry>
