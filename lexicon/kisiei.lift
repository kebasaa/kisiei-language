      <gloss lang="fr"><text>savon</text></gloss>
      <gloss lang="en"><text>soap</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: síɔ́ɔ́</text></form></note>
  </entry>
  <entry id="sìɔ̀ɔ̀lɔ̀ɔ́_4644">
    <lexical-unit><form lang="kqs"><text>sìɔ̀ɔ̀lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sìɔ̀ɔ̀lɔ̀ɔ́_4644_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>oiseau tisserand (au long nid)</text></gloss>
      <gloss lang="en"><text>weaver bird (builds a long nest)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 337: sìɔ̀ɔ̀lɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="siɔɔndaa_4645">
    <lexical-unit><form lang="kqs"><text>siɔɔndaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>siɔɔnda</text></form></variant>
