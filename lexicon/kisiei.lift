      <gloss lang="fr"><text>éplucher, sarcler</text></gloss>
      <gloss lang="en"><text>peel, weed</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scrape (a surface)</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 115: Salöö; Childs 2000, p. 319: sàlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>salu dans la Bible signifie « délimiter » (DEU 32,8), sens différent.</text></form></note>
  </entry>
  <entry id="sámáá_1402">
