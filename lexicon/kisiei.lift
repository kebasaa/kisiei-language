  <entry id="bɔ̀ŋgìɲó_308">
    <lexical-unit><form lang="kqs"><text>bɔ̀ŋgìɲó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ŋgìɲó_308_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sorte de légume-feuille ; espèce d'oiseau</text></gloss>
      <gloss lang="en"><text>type of leafy vegetable; species of bird</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5 Plant"/>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ̀ŋgìɲó</text></form></note>
  </entry>
  <entry id="bɔ̀ŋìéí_309">
    <lexical-unit><form lang="kqs"><text>bɔ̀ŋìéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀ŋìóŋ</text></form></field>
    <sense id="bɔ̀ŋìéí_309_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rein</text></gloss>
      <gloss lang="en"><text>kidney</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ̀ŋìéí</text></form></note>
  </entry>
  <entry id="bɔ́ŋílɔ̃ŋ_310">
    <lexical-unit><form lang="kqs"><text>bɔ́ŋílɔ̃ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ́ŋílɔ̃ŋ_310_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>creusé, rentré (joues, ventre, seins)</text></gloss>
      <gloss lang="en"><text>sucked in, drawn in (cheeks, stomach)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 28: bɔ́ŋílɔ̃ŋ</text></form></note>
  </entry>
  <entry id="bɔ̀ŋndó_311">
    <lexical-unit><form lang="kqs"><text>bɔ̀ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ̀ŋndáŋ</text></form></field>
    <sense id="bɔ̀ŋndó_311_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>claie de stockage ou de séchage du riz (au champ)</text></gloss>
      <gloss lang="en"><text>rack for storing or drying rice (on the farm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 29: bɔ̀ŋndó</text></form></note>
  </entry>
  <entry id="bɔɔ_312">
    <lexical-unit><form lang="kqs"><text>bɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɔɔlan</text></form></field>
    <sense id="bɔɔ_312_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>buisson, fourré ; (bɔ̀ɔ̀ n'yɔɔ) buisson d'épines, ronce</text></gloss>
      <gloss lang="en"><text>bush, thicket; (bɔ̀ɔ̀ n'yɔɔ) thornbush, bramble</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 833 occurrences, first GEN.1.16; Childs 2000, p. 29: bɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Le buisson ardent (EXO.3.2) ; le bélier pris o bɔɔ nin « dans le fourré » (GEN.22.13) ; o bɔɔlan bɛngu « dans les buissons » (1SA.13.6, JOB.30.7). Ne pas confondre avec bɔɔ « cour » ni avec bɔɔlan « plumes, ailes ».</text></form></note>
  </entry>
  <entry id="bɔɔ_313">
    <lexical-unit><form lang="kqs"><text>bɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔɔ_313_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>très, beaucoup, fort</text></gloss>
      <gloss lang="en"><text>very, much, greatly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.3 Very"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 833 occurrences, first GEN.1.16; Childs 2000, p. 29: bɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>ndóò kaola bɔɔ Rasɛl « il aimait beaucoup Rachel » (GEN.29.20) ; a hiw bɔɔ « il est très grand » (GEN.18.20).</text></form></note>
  </entry>
  <entry id="bɔɔ_314">
    <lexical-unit><form lang="kqs"><text>bɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɛ́ɛ̀lan</text></form></field>
    <variant><form lang="kqs"><text>bɛ́ɛ̀</text></form></variant>
    <sense id="bɔɔ_314_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>concession, cour</text></gloss>
      <gloss lang="en"><text>compound, courtyard</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>compound of a patrilineal lineage; yard around a house</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 833 occurrences, first GEN.1.16; Keita 1979, p. 142: Böö; Childs 2000, p. 19: bíɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, la cour se dit bɛ́ɛ̀ (forme radicale, Mt 26,58 ; Jr 32,2), pluriel bɛ́ɛ̀lan, comme bíɔ̀ɔ́ / bɛ́ɛ̀láŋ chez Childs. La forme pleine bɔɔ suit Keita ; dans la Bible, bɔɔ seul a surtout d'autres sens (grand, buisson).</text></form></note>
  </entry>
  <entry id="bɔ̀ɔ̀_315">
    <lexical-unit><form lang="kqs"><text>bɔ̀ɔ̀</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ɔ̀_315_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>interjection de désapprobation</text></gloss>
      <gloss lang="en"><text>interjection of disapproval</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 29: bɔ̀ɔ̀</text></form></note>
  </entry>
  <entry id="bɔ̀ɔ́_316">
    <lexical-unit><form lang="kqs"><text>bɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ɔ́_316_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>gros, grand</text></gloss>
      <gloss lang="en"><text>big, large</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 29: bɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔɔbɔɔyɛi_317">
    <lexical-unit><form lang="kqs"><text>bɔɔbɔɔyɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="bɔɔbɔɔyɛi_317_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gloire, majesté</text></gloss>
      <gloss lang="en"><text>glory, majesty</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
      <trait name="semantic-domain-ddp4" value="4.9.1 God"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first EXO.15.7</text></form></note>
  </entry>
  <entry id="bɔɔle_318">
    <lexical-unit><form lang="kqs"><text>bɔɔle</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔɔle_318_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>peut-être</text></gloss>
      <gloss lang="en"><text>perhaps</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 81 occurrences, first GEN.16.2</text></form></note>
  </entry>
  <entry id="bɔɔlen_319">
    <lexical-unit><form lang="kqs"><text>bɔɔlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔɔlan</text></form></field>
    <sense id="bɔɔlen_319_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plume</text></gloss>
      <gloss lang="en"><text>feather</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>feather; hem of cloth</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Böölen; Childs 2000, p. 29: bɔ̀ɔ̀léŋ</text></form></note>
    <note><form lang="fr"><text>Le singulier n'est pas dans la Bible ; le pluriel bɔɔlan y désigne les plumes et les ailes (LEV.1.16, LEV.11.20).</text></form></note>
  </entry>
  <entry id="bɔɔluuo_320">
    <lexical-unit><form lang="kqs"><text>bɔɔluuo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɔɔluu</text></form></variant>
    <sense id="bɔɔluuo_320_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire du bruit, gronder ; bruit, tumulte</text></gloss>
      <gloss lang="en"><text>make noise, roar; noise, uproar</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.2 Hear"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first ISA.17.12; Childs 2000, p. 29: bɔ̀ɔ̀lùùwó</text></form></note>
  </entry>
  <entry id="bɔɔndɔɔ_321">
    <lexical-unit><form lang="kqs"><text>bɔɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>bɔɔndɔɛi</text></form></field>
    <sense id="bɔɔndɔɔ_321_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre</text></gloss>
      <gloss lang="en"><text>a species of tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>flowering tree with light softwood, used for soap; viscous sap</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 26: Bööndöö : bööndöèi; Childs 2000, p. 30: bɔ̀ɔ̀ndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita le cite comme exemple de nom d'arbre en -ɔ au pluriel -ɛi.</text></form></note>
  </entry>
  <entry id="bɔ́ɔ́nɔ̀ɔ́_322">
    <lexical-unit><form lang="kqs"><text>bɔ́ɔ́nɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>bɔ́ɔ́nùá</text></form></field>
    <sense id="bɔ́ɔ́nɔ̀ɔ́_322_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>serpent noir très dangereux (à cornes, chant de coq, présage)</text></gloss>
      <gloss lang="en"><text>very dangerous long black snake (said to have horns and crow)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 30: bɔ́ɔ́nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɔ̀ɔ́sɔ̀ɔ́-kùèndóó_323">
    <lexical-unit><form lang="kqs"><text>bɔ̀ɔ́sɔ̀ɔ́-kùèndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ̀ɔ́sɔ̀ɔ́-kùèndóó_323_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>petit oiseau noir et blanc joueur (nid au sommet des arbres)</text></gloss>
      <gloss lang="en"><text>small playful black and white bird (nests in treetops)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 30: bɔ̀ɔ́sɔ̀ɔ́-kùèndóó</text></form></note>
  </entry>
  <entry id="bɔɔŋiaa_324">
    <lexical-unit><form lang="kqs"><text>bɔɔŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔɔŋiaa_324_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rassembler, réunir ; assembler (des pièces)</text></gloss>
      <gloss lang="en"><text>gather, assemble; join together</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5.1 Gather"/>
      <trait name="semantic-domain-ddp4" value="7.5.2 Join, attach"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 17 occurrences, first EXO.36.10; Childs 2000, p. 30: bɔ̀ɔ̀ŋìá</text></form></note>
  </entry>
  <entry id="bɔɔŋian_325">
    <lexical-unit><form lang="kqs"><text>bɔɔŋian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɔɔŋian_325_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se rassembler, s'assembler</text></gloss>
      <gloss lang="en"><text>gather, assemble (intr.)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first EXO.32.1; Childs 2000, p. 30: bɔ̀ɔ̀ŋìáŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de bɔɔŋiaa.</text></form></note>
  </entry>
  <entry id="bɔ́ɔ́ŋndó_326">
    <lexical-unit><form lang="kqs"><text>bɔ́ɔ́ŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="bɔ́ɔ́ŋndó_326_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>boue rouge</text></gloss>
      <gloss lang="en"><text>red mud</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 30: bɔ́ɔ́ŋndó</text></form></note>
  </entry>
  <entry id="bɛ_327">
    <lexical-unit><form lang="kqs"><text>bɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛ_327_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aîné, frère ou sœur aîné(e)</text></gloss>
      <gloss lang="en"><text>elder sibling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 68 occurrences, first GEN.25.29</text></form></note>
    <note><form lang="fr"><text>Forme radicale (bɛ ndɔ « son aîné ») ; Ésaü est le bɛ de Jacob, Léa celle de Rachel (Gn 30,8). Voir pɔmbɔɔ « cadet ».</text></form></note>
  </entry>
  <entry id="bɛi_328">
    <lexical-unit><form lang="kqs"><text>bɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="bɛi_328_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>aubergine</text></gloss>
      <gloss lang="en"><text>eggplant, garden egg</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bitterball, a small round bitter vegetable</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèi; Childs 2000, p. 12: bɛ̀í</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi la variante Bai.</text></form></note>
  </entry>
  <entry id="bɛllon_329">
    <lexical-unit><form lang="kqs"><text>bɛllon</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛllon_329_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmiste, noix de palme</text></gloss>
      <gloss lang="en"><text>palm nuts</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèllon; Childs 2000, p. 13: bɛ̌llé</text></form></note>
  </entry>
  <entry id="bɛlɔɔ_330">
    <lexical-unit><form lang="kqs"><text>bɛlɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɛlla</text></form></field>
    <sense id="bɛlɔɔ_330_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat, souris</text></gloss>
      <gloss lang="en"><text>rat, mouse</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LEV.11.29; Childs 2000, p. 13: bèlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>bɛlla « souris (d'or) » (1SA.6.4) ; vanaa co bɛlla dioo « ceux qui mangent des souris » (ISA.66.17).</text></form></note>
  </entry>
  <entry id="bɛ̀lɛ̀nnden_331">
    <lexical-unit><form lang="kqs"><text>bɛ̀lɛ̀nnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="bɛ̀lɛ̀nnden_331_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>flèche, javelot</text></gloss>
      <gloss lang="en"><text>arrow, javelin</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.41.18; Keita 1979, p. 156: Bèlènden</text></form></note>
    <note><form lang="fr"><text>La Bible appelle aussi la flèche kɔɛi, pl. kɔɔn (Gn 27,3).</text></form></note>
  </entry>
  <entry id="bɛmbɛ_332">
    <lexical-unit><form lang="kqs"><text>bɛmbɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛmbɛ_332_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fois (bɛmbɛ lediin « deux fois »)</text></gloss>
      <gloss lang="en"><text>times (bɛmbɛ lediin 'twice')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 86 occurrences, first GEN.27.36</text></form></note>
  </entry>
  <entry id="bɛmɛi_333">
    <lexical-unit><form lang="kqs"><text>bɛmɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <sense id="bɛmɛi_333_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>force, vigueur ; (bɛmɛi-yo) homme fort</text></gloss>
      <gloss lang="en"><text>strength, might; (bɛmɛi-yo) strong one</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first NUM.24.18</text></form></note>
  </entry>
  <entry id="bɛ̀mɛ́ltan_334">
    <lexical-unit><form lang="kqs"><text>bɛ̀mɛ́ltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛ̀mɛ́lta</text></form></variant>
    <sense id="bɛ̀mɛ́ltan_334_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tanières, repaires ; cachettes</text></gloss>
      <gloss lang="en"><text>dens, lairs; hiding places</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PSA.10.9</text></form></note>
    <note><form lang="fr"><text>Pluriel ; le singulier n'est pas relevé.</text></form></note>
  </entry>
  <entry id="bɛnda_335">
    <lexical-unit><form lang="kqs"><text>bɛnda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛnda_335_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devoir, falloir ; (nég.) ne pas devoir</text></gloss>
      <gloss lang="en"><text>must, should; (neg.) must not</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.4.1 Tense and aspect"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2153 occurrences, first GEN.2.19</text></form></note>
  </entry>
  <entry id="bɛndoo_336">
    <lexical-unit><form lang="kqs"><text>bɛndoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛndu</text></form></variant>
    <variant><form lang="kqs"><text>bɛndua</text></form></variant>
    <variant><form lang="kqs"><text>bɛndulan</text></form></variant>
    <variant><form lang="kqs"><text>bɛndula</text></form></variant>
    <variant><form lang="kqs"><text>bɛnduan</text></form></variant>
    <variant><form lang="kqs"><text>bɛnduei</text></form></variant>
    <variant><form lang="kqs"><text>bɛndon</text></form></variant>
    <variant><form lang="kqs"><text>bɛndulen</text></form></variant>
    <sense id="bɛndoo_336_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>grand ; important</text></gloss>
      <gloss lang="en"><text>big, great; important</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1186 occurrences, first GEN.1.26</text></form></note>
  </entry>
  <entry id="bɛnducieo_337">
    <lexical-unit><form lang="kqs"><text>bɛnducieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɛnducieo_337_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>notable</text></gloss>
      <gloss lang="en"><text>notable, elder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.1 Person in authority"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Bèndutyieo</text></form></note>
  </entry>
  <entry id="bɛnduo_338">
    <lexical-unit><form lang="kqs"><text>bɛnduo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="bɛnduo_338_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand frère, aîné</text></gloss>
      <gloss lang="en"><text>elder brother</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>elder, older brother; big one; term of respect</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Bènduo; Childs 2000, p. 13: bɛ́ndɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɛngu_339">
    <lexical-unit><form lang="kqs"><text>bɛngu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛngula</text></form></variant>
    <variant><form lang="kqs"><text>bɛngulan</text></form></variant>
    <sense id="bɛngu_339_s1">
      <grammatical-info value="Postposition"/>
      <gloss lang="fr"><text>sous, au bas de ; (pl. bɛngulan) pieds, sabots</text></gloss>
      <gloss lang="en"><text>under, at the bottom of; (pl. bɛngulan) feet, hooves</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="9.2.4 Prepositions, postpositions"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bottom, beneath, under</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1156 occurrences, first GEN.3.15; Childs 2000, p. 225: lèbèŋgú</text></form></note>
  </entry>
  <entry id="bɛngu lefunndo_340">
    <lexical-unit><form lang="kqs"><text>bɛngu lefunndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛngu lefunndo_340_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cotonnier</text></gloss>
      <gloss lang="en"><text>cotton plant</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.2 Bush, shrub"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèngu lefunndo</text></form></note>
  </entry>
  <entry id="bɛngufɔnɔ_341">
    <lexical-unit><form lang="kqs"><text>bɛngufɔnɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛngufɔnɔ_341_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>novembre</text></gloss>
      <gloss lang="en"><text>November</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.4 Telling time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>time around November</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Bèngufönö; Childs 2000, p. 15: bɛ̀ŋgúfɔ̀nɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="bɛnguo_342">
    <lexical-unit><form lang="kqs"><text>bɛnguo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="bɛnguo_342_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pied, jambe ; dessous, bas ; patte</text></gloss>
      <gloss lang="en"><text>foot, leg; underside, bottom ; paw, foot (of an animal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
      <trait name="semantic-domain-ddp4" value="8.6.2 Top"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>leg, foot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JER.35.7; Keita 1979, p. 131: Bènguo; Childs 2000, p. 14: bɛ̀ŋgóó</text></form></note>
    <note><form lang="fr"><text>Keita : « le pied », confirmé par Childs. Dans la Bible, bɛngu (et bɛnguo, Jr 35,7) s'emploie surtout au sens de « sous, en bas » ; le pied y est d'ordinaire pelei. Dans la Bible, bɛnguo (JER.35.7) est une forme homonyme de bɛngu « dessous ».</text></form></note>
  </entry>
  <entry id="bɛpɛlaa_343">
    <lexical-unit><form lang="kqs"><text>bɛpɛlaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛpɛla</text></form></variant>
    <sense id="bɛpɛlaa_343_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>opprimer, accabler, faire souffrir ; peine, oppression</text></gloss>
      <gloss lang="en"><text>oppress, afflict; toil, affliction</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be tired; suffer, undergo hardship</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first EXO.1.14; Childs 2000, p. 15: bèpèlàá</text></form></note>
  </entry>
  <entry id="bɛsinndo_344">
    <lexical-unit><form lang="kqs"><text>bɛsinndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛsinndo_344_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'écobuer (champ)</text></gloss>
      <gloss lang="en"><text>be burn-cleared</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bèsinndo</text></form></note>
    <note><form lang="fr"><text>Moyen de bɛsio.</text></form></note>
  </entry>
  <entry id="bɛsio_345">
    <lexical-unit><form lang="kqs"><text>bɛsio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>bɛsi</text></form></variant>
    <sense id="bɛsio_345_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>écobuer (Keita) ; porter, prendre soin (?)</text></gloss>
      <gloss lang="en"><text>burn-clear a field (Keita); carry, care for (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.2 Land preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Bèsio</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, bɛsio (DEU 32,10) et bɛsi (ISA 46,3) semblent signifier « porter, entourer de soins », pas « écobuer ». À vérifier.</text></form></note>
  </entry>
  <entry id="bɛsuo_346">
    <lexical-unit><form lang="kqs"><text>bɛsuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>bɛsu</text></form></variant>
    <sense id="bɛsuo_346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>balai</text></gloss>
      <gloss lang="en"><text>broom</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.5 Sweep, rake"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Bèsuo; Childs 2000, p. 15: bɛ̀sòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale bɛsu dans la Bible (Is 14,23).</text></form></note>
  </entry>
  <entry id="bɛvɛiyo_347">
    <lexical-unit><form lang="kqs"><text>bɛvɛiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>bɛvɛiya</text></form></field>
    <sense id="bɛvɛiyo_347_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>boiteux, estropié</text></gloss>
      <gloss lang="en"><text>lame, crippled</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first 2SA.4.4</text></form></note>
  </entry>
  <entry id="bɛŋianndo_348">
    <lexical-unit><form lang="kqs"><text>bɛŋianndo</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɛŋianndo_348_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se botter (?)</text></gloss>
      <gloss lang="en"><text>put on boots (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.7 Wear clothing"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Bènhianndo</text></form></note>
    <note><form lang="fr"><text>Glose de Keita peu claire ; peut-être moyen de bɛŋio « se détacher, se défaire ».</text></form></note>
  </entry>
  <entry id="bɛŋio_349">
    <lexical-unit><form lang="kqs"><text>bɛŋio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛŋi</text></form></variant>
    <variant><form lang="kqs"><text>bɛŋin</text></form></variant>
    <sense id="bɛŋio_349_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>arracher, démonter, détacher</text></gloss>
      <gloss lang="en"><text>knock out, pull out, dismantle</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>come out (as a blade from its handle)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first GEN.19.9; Keita 1979, p. 110: Bènhia; Childs 2000, p. 14: bèŋìó</text></form></note>
    <note><form lang="fr"><text>Keita écrit bènhia ; la Bible a la forme longue bɛŋio (GEN 19,9). bɛŋi : faire sauter une dent (EXO 21,27) ; bɛŋin : se détacher (fer de hache, DEU 19,5).</text></form></note>
  </entry>
  <entry id="bɛɛ_350">
    <lexical-unit><form lang="kqs"><text>bɛɛ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛ_350_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>aussi ; même ; déjà</text></gloss>
      <gloss lang="en"><text>also; even; already</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'indeed, just, now'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2221 occurrences, first GEN.1.11; Childs 2000, p. 11: bɛ́ɛ́</text></form></note>
  </entry>
  <entry id="bɛɛlen_351">
    <lexical-unit><form lang="kqs"><text>bɛɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛɛle</text></form></variant>
    <sense id="bɛɛlen_351_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honneur, gloire ; (ke … bɛɛlen) honorer</text></gloss>
      <gloss lang="en"><text>honour, glory; (ke … bɛɛlen) honour</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 180 occurrences, first GEN.30.20</text></form></note>
  </entry>
  <entry id="bɛɛn-bɛɛn_352">
    <lexical-unit><form lang="kqs"><text>bɛɛn-bɛɛn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛn-bɛɛn_352_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>librement, sans peine, sans encombre ; à la légère</text></gloss>
      <gloss lang="en"><text>freely, easily, unhindered; lightly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 19 occurrences, first EXO.14.8</text></form></note>
    <note><form lang="fr"><text>a ba nda bɛɛn-bɛɛn « la main haute » (Ex 14,8) ; dɛnɛ bɛɛn-bɛɛn « chose légère » (1 S 18,23).</text></form></note>
  </entry>
  <entry id="bɛɛndiaa_353">
    <lexical-unit><form lang="kqs"><text>bɛɛndiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛndiaa_353_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>préparer, apprêter ; arranger, réparer</text></gloss>
      <gloss lang="en"><text>prepare, make ready; set right</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
      <trait name="semantic-domain-ddp4" value="7.9.4 Repair"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 135 occurrences, first GEN.14.14</text></form></note>
  </entry>
  <entry id="bɛɛndian_354">
    <lexical-unit><form lang="kqs"><text>bɛɛndian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛɛndianndo</text></form></variant>
    <sense id="bɛɛndian_354_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se préparer, s'apprêter</text></gloss>
      <gloss lang="en"><text>get ready</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.22</text></form></note>
    <note><form lang="fr"><text>Moyen de bɛɛndiaa « préparer ».</text></form></note>
  </entry>
  <entry id="bɛɛsa_355">
    <lexical-unit><form lang="kqs"><text>bɛɛsa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛsa_355_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>casser, arracher (une branche, une pousse)</text></gloss>
      <gloss lang="en"><text>break off (a branch, a shoot)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break off or prune branches</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.17.4; Childs 2000, p. 12: bèèsàá</text></form></note>
    <note><form lang="fr"><text>Forme de base ; voir bɛɛsiaa « tailler, émonder ».</text></form></note>
  </entry>
  <entry id="bɛɛsiaa_356">
    <lexical-unit><form lang="kqs"><text>bɛɛsiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛsiaa_356_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tailler, élaguer (vigne, arbres) ; dépouiller</text></gloss>
      <gloss lang="en"><text>prune, trim; strip</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first LEV.25.3; Childs 2000, p. 12: bèèsìá</text></form></note>
  </entry>
  <entry id="bɛɛsio_357">
    <lexical-unit><form lang="kqs"><text>bɛɛsio</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bɛɛsio_357_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porc (parler de Towve)</text></gloss>
      <gloss lang="en"><text>pig (Towve dialect)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 8-10: Bèèsio; Childs 2000, p. 12: bèèsìó</text></form></note>
    <note><form lang="fr"><text>Keita, tableau des parlers (introduction) : Bèèsio à Towve (kpekeduei), Pewvo à Luannde et Sayaaninnde, Poovo en kisiduei. Le mot courant et biblique est pewvo.</text></form></note>
  </entry>
  <entry id="bɛɛtambɛiyo_358">
    <lexical-unit><form lang="kqs"><text>bɛɛtambɛiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>bɛɛtambɛi</text></form></variant>
    <variant><form lang="kqs"><text>bɛɛtambɛila</text></form></variant>
    <sense id="bɛɛtambɛiyo_358_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>honte, opprobre ; abomination</text></gloss>
      <gloss lang="en"><text>shame, disgrace; abomination</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.20.6</text></form></note>
  </entry>
  <entry id="bɛɛyan vomɔɔ_359">
    <lexical-unit><form lang="kqs"><text>bɛɛyan vomɔɔ</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="bɛɛyan vomɔɔ_359_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>divination aux cailloux</text></gloss>
      <gloss lang="en"><text>divination with pebbles</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 163: Bèèyan vomöö</text></form></note>
    <note><form lang="fr"><text>Keita écrit « divissation » ; lu « divination ». Découpage à confirmer.</text></form></note>
  </entry>
  <entry id="bɛɛŋun_360">
    <lexical-unit><form lang="kqs"><text>bɛɛŋun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="bɛɛŋun_360_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>morceaux de viande, chair (sans os)</text></gloss>
      <gloss lang="en"><text>pieces of meat, flesh (boneless)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="2.1.7 Flesh"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boneless meat, fillet</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first GEN.4.4; Childs 2000, p. 12: bèèŋndé</text></form></note>
    <note><form lang="fr"><text>Pluriel. visin bɛɛŋun macuɛin « les morceaux gras » (GEN.4.4) ; visin bɛɛŋun cɔlu kon « la chair du taureau » (EXO.29.14).</text></form></note>
  </entry>
  <entry id="càá_361">
    <lexical-unit><form lang="kqs"><text>càá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="càá_361_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vers, asticots</text></gloss>
      <gloss lang="en"><text>maggots, worms</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 321 occurrences, first GEN.4.7; Childs 2000, p. 36: càá</text></form></note>
    <note><form lang="fr"><text>càá luɛi o ɲɛ nda manda kon-ndo nin « il s'y mit des vers » (EXO.16.20) ; Hérode « mangé des vers » (ACT.12.23) ; voir aussi JOB.7.5, ISA.14.11, ISA.66.24.</text></form></note>
  </entry>
  <entry id="caa_362">
    <lexical-unit><form lang="kqs"><text>caa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cee</text></form></variant>
    <sense id="caa_362_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>savoir (faire), être habile</text></gloss>
      <gloss lang="en"><text>know how, be skilled</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
