    <sense id="konaa_1433_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nouvelles, récit, compte rendu ; (ɲuna … konaa) demander compte</text></gloss>
      <gloss lang="en"><text>news, report, account; (ɲuna … konaa) call to account</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
