  <entry id="malɔɔ_2213">
    <lexical-unit><form lang="kqs"><text>malɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mal</text></form></variant>
    <sense id="malɔɔ_2213_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laisser, lâcher, laisser partir ; poser, mettre ; pardonner (malɔɔ … haki) ; (nom) pardon</text></gloss>
      <gloss lang="en"><text>leave, let go, release; put, place; forgive (malɔɔ … haki); (noun) forgiveness</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
      <trait name="semantic-domain-ddp4" value="7.5.9 Put"/>
      <trait name="semantic-domain-ddp4" value="4.7 Law"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>leave, depart; drop; forgive</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 394 occurrences, first GEN.31.27; Childs 2000, p. 240: màlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>masaa Esipte cɛlnin le niaa malɔɔ le « le roi d'Égypte ne vous laissera pas partir » (EXO.3.19) ; mó mal vanapɔnɔ o nakɔ kon nin « il plaça l'homme dans le jardin » (GEN.2.8) ; mó mal vallo « il cessa son travail » (GEN.2.2).</text></form></note>
  </entry>
  <entry id="mamaa_2214">
    <lexical-unit><form lang="kqs"><text>mamaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mama</text></form></variant>
    <sense id="mamaa_2214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand-parent, ancêtre ; petit-enfant</text></gloss>
      <gloss lang="en"><text>grandparent, ancestor; grandchild</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grandmother, old woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 433 occurrences, first GEN.10.32; Childs 2000, p. 241: màmá</text></form></note>
    <note><form lang="fr"><text>fuɲaa mamaa « les ancêtres » ; Lɔt po ndɔ mama « son petit-fils Lot » (Gn 11,31).</text></form></note>
  </entry>
