    <variant><form lang="kqs"><text>suukan</text></form></variant>
    <sense id="suukanndo_3131_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>parler, s'entretenir (avec)</text></gloss>
      <gloss lang="en"><text>speak, talk (with)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>talk back and forth (middle of 'talk')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 36 occurrences, first GEN.18.31; Childs 2000, p. 345: sùùkăŋndɔ́</text></form></note>
  </entry>
  <entry id="suumaa_3132">
    <lexical-unit><form lang="kqs"><text>suumaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>suuma</text></form></variant>
    <sense id="suumaa_3132_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bouder, avoir l'air abattu</text></gloss>
      <gloss lang="en"><text>sulk, look downcast</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.4.5; Childs 2000, p. 345: sùùmàá</text></form></note>
    <note><form lang="fr"><text>mó suuma suumaa « son visage fut abattu » (Gn 4,5) ; pɛngi suumaa « cesser d'être triste » (1 S 1,18).</text></form></note>
  </entry>
