      <gloss lang="en"><text>single-barbed arrow; drill bit</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 49: cìŋɔ́léŋ</text></form></note>
  </entry>
