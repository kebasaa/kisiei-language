  <entry id="dangaa_727">
    <lexical-unit><form lang="kqs"><text>dangaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>danga</text></form></variant>
    <variant><form lang="kqs"><text>dangala</text></form></variant>
    <variant><form lang="kqs"><text>dangalaa</text></form></variant>
    <sense id="dangaa_727_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>malédiction</text></gloss>
      <gloss lang="en"><text>curse</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>rudeness, disrespect, insulting someone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 80 occurrences, first GEN.3.14; Childs 2000, p. 70: dáŋgáá</text></form></note>
  </entry>
  <entry id="dangalaa_728">
    <lexical-unit><form lang="kqs"><text>dangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>dangaltan</text></form></field>
    <sense id="dangalaa_728_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bord, lisière, côté ; (pl.) bords (d'un champ)</text></gloss>
      <gloss lang="en"><text>edge, border, side; (pl.) edges (of a field)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.6.6 Edge"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>boundary, edge; the area just outside a cleared field</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.23.9; Childs 2000, p. 71: dáŋgáláá</text></form></note>
    <note><form lang="fr"><text>o mɛmma ihɛllan dangalaa « au bord de la mer Rouge » (EXO.14.2) ; háá o dangaltan « jusqu'aux bords (du champ) » (LEV.23.22).</text></form></note>
  </entry>
