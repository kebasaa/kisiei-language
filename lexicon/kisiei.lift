  <entry id="sálàá_2854">
    <lexical-unit><form lang="kqs"><text>sálàá</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>sálàlan</text></form></field>
    <variant><form lang="kqs"><text>sálà</text></form></variant>
    <variant><form lang="kqs"><text>sálàla</text></form></variant>
    <sense id="sálàá_2854_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sacrifice, offrande</text></gloss>
      <gloss lang="en"><text>sacrifice, offering</text></gloss>
