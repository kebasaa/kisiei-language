  </entry>
  <entry id="yɛngian_4901">
    <lexical-unit><form lang="kqs"><text>yɛngian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛngian_4901_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>nouveau, doux (vin) : mɔima yɛngian « vin nouveau, moût » ; premier vin de palme de la récolte</text></gloss>
      <gloss lang="en"><text>new, sweet (wine): mɔima yɛngian 'new wine, must'; first palm wine of the harvest</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first NUM.18.12; Lexique kissi–français, p. 64: yengian</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 64 : yengian « la première goutte de la première récolte de vin de palmier ».</text></form></note>
  </entry>
  <entry id="yɛngiyo_4902">
    <lexical-unit><form lang="kqs"><text>yɛngiyo</text></form></lexical-unit>
