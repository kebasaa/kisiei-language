    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mama</text></form></variant>
    <sense id="mamaa_778_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grand-parent, ancêtre ; petit-enfant</text></gloss>
      <gloss lang="en"><text>grandparent, ancestor; grandchild</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>grandmother, old woman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 433 occurrences, first GEN.10.32; Childs 2000, p. 241: màmá</text></form></note>
    <note><form lang="fr"><text>fuɲaa mamaa « les ancêtres » ; Lɔt po ndɔ mama « son petit-fils Lot » (Gn 11,31).</text></form></note>
  </entry>
  <entry id="mamanndo_779">
    <lexical-unit><form lang="kqs"><text>mamanndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="mamanndo_779_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se moquer</text></gloss>
      <gloss lang="en"><text>mock</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 114: Mamanndo</text></form></note>
    <note><form lang="fr"><text>Moyen de mamɔɔ. maman « rire » attesté une fois (PSA 126,2).</text></form></note>
  </entry>
  <entry id="mamɔɔ_780">
    <lexical-unit><form lang="kqs"><text>mamɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mam</text></form></variant>
    <variant><form lang="kqs"><text>mem</text></form></variant>
    <variant><form lang="kqs"><text>mamnin</text></form></variant>
    <sense id="mamɔɔ_780_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rire</text></gloss>
      <gloss lang="en"><text>laugh</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>laugh, joke</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 88 occurrences, first JDG.16.25; Keita 1979, p. 114: Mamöö; Childs 2000, p. 241: màmɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>mem : radical négatif (GEN 18,15).</text></form></note>
  </entry>
  <entry id="man_781">
