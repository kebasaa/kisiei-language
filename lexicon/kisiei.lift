  <entry id="cɔ̀múéí_880">
    <lexical-unit><form lang="kqs"><text>cɔ̀múéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>cɔ̀mɔ́ŋ</text></form></field>
    <sense id="cɔ̀múéí_880_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clochette (de chien de chasse) ; dard ; nid de guêpes</text></gloss>
      <gloss lang="en"><text>bell (on hunting dogs); stinger; wasp nest</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 56: cɔ̀múéí</text></form></note>
  </entry>
  <entry id="cɔn_881">
    <lexical-unit><form lang="kqs"><text>cɔn</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔnɔn</text></form></variant>
    <sense id="cɔn_881_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lever ; (cɔn … nin) depuis</text></gloss>
      <gloss lang="en"><text>get up, rise; (cɔn … nin) since</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 182 occurrences, first GEN.8.21</text></form></note>
  </entry>
  <entry id="cɔndɔɔ_882">
    <lexical-unit><form lang="kqs"><text>cɔndɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>candu</text></form></variant>
    <sense id="cɔndɔɔ_882_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ramasser, récolter, cueillir (des fruits)</text></gloss>
      <gloss lang="en"><text>gather, harvest, pick (fruit)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.5 Harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔndɔɔ/ candu</text></form></note>
    <note><form lang="fr"><text>Le Lexique donne aussi condɔɔ « cueillir » (p. 10). candu existe dans la Bible au sens de « louer » ; comparer kɔndɔɔ « puiser, ramasser ».</text></form></note>
  </entry>
  <entry id="cɔngɔi_883">
    <lexical-unit><form lang="kqs"><text>cɔngɔi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔngɔi_883_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cache-sexe devenu costume de danse</text></gloss>
      <gloss lang="en"><text>loincloth turned dance costume</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.3.3 Traditional clothing"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 144: Työngöi; Lexique kissi–français, p. 11: cɔngɔi</text></form></note>
  </entry>
  <entry id="cɔngɔɔ_884">
    <lexical-unit><form lang="kqs"><text>cɔngɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>cangu</text></form></variant>
    <variant><form lang="kqs"><text>cɔngɔ</text></form></variant>
    <sense id="cɔngɔɔ_884_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>servir, distribuer (le riz de la marmite dans les bols)</text></gloss>
      <gloss lang="en"><text>dish up, serve out (rice from the pot into bowls)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 114: tyɔŋo; Lexique kissi–français, p. 11: cɔngɔɔ/ cangu; Sandara Kisia, fable 20: tyɔŋgɔ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 114 : servir (sortir de la marmite avec la petite calebasse kalama pour mettre dans un plat).</text></form></note>
  </entry>
  <entry id="cɔnnden_885">
    <lexical-unit><form lang="kqs"><text>cɔnnden</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔnnden_885_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jeunes pousses du cœur du palmier</text></gloss>
      <gloss lang="en"><text>new shoots from the heart of the palm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔnnden</text></form></note>
  </entry>
  <entry id="cɔnndo_886">
    <lexical-unit><form lang="kqs"><text>cɔnndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔnndo_886_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>régime (de bananes, de noix de palme)</text></gloss>
      <gloss lang="en"><text>bunch (of bananas, palm nuts)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bunch or stalk of bananas</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 16: TYönndo; Childs 2000, p. 57: cɔ̀ŋndó</text></form></note>
    <note><form lang="fr"><text>Keita le distingue de työnndon « mil » (voir cɔnndon).</text></form></note>
  </entry>
  <entry id="cɔnndon_887">
    <lexical-unit><form lang="kqs"><text>cɔnndon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="cɔnndon_887_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gros mil, sorgho</text></gloss>
      <gloss lang="en"><text>sorghum</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.4.9; Keita 1979, p. 140: Työnndon; Paulme 1964, p. 114: tyɔndo; Lexique kissi–français, p. 11: cɔnndon; Childs 2000, p. 58: cɔ̀ɔ́ŋndé</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 114 : tyɔndo n kullɔ̃ « grains de mil ».</text></form></note>
  </entry>
  <entry id="cɔntum sakpoo_888">
    <lexical-unit><form lang="kqs"><text>cɔntum sakpoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔntum sakpoo_888_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voix active</text></gloss>
      <gloss lang="en"><text>active voice</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 429: Työntum sakpoo (faya timbi dè[…])</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Exemple de l'original, coupé : faya timbi dè…</text></form></note>
  </entry>
  <entry id="cɔntum tundaa_889">
    <lexical-unit><form lang="kqs"><text>cɔntum tundaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔntum tundaa_889_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voix passive</text></gloss>
      <gloss lang="en"><text>passive voice</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 430: Työntum tundaa (dèndöö timbii[…])</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Exemple de l'original, coupé : dèndöö timbii…</text></form></note>
  </entry>
  <entry id="cɔntumndo_890">
    <lexical-unit><form lang="kqs"><text>cɔntumndo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔntumndo_890_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>voix (grammaire)</text></gloss>
      <gloss lang="en"><text>voice (grammar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 428: Työntumndo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. cɔntum sakpoo « voix active », cɔntum tundaa « voix passive ».</text></form></note>
  </entry>
  <entry id="cɔnɔnndo_891">
    <lexical-unit><form lang="kqs"><text>cɔnɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔn</text></form></variant>
    <variant><form lang="kqs"><text>can</text></form></variant>
    <variant><form lang="kqs"><text>cen</text></form></variant>
    <variant><form lang="kqs"><text>cɔnnun</text></form></variant>
    <sense id="cɔnɔnndo_891_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se lever, partir ; se lever contre ; lever (du soleil)</text></gloss>
      <gloss lang="en"><text>get up, set out; rise against; rising (of the sun)</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.1 Stand"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>get up, arise; grow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 200 occurrences, first GEN.5; Keita 1979, p. 116: Työnönndo; Lexique kissi–français, p. 11: cɔnɔnndo/ cɔn, cɛn, can, cen; Terminologie (idéologie), n° 415: Nyaaloo, työnönndo; Childs 2000, p. 57: cɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cen : radical négatif (GEN 31,35). Lexique kissi–français, p. 11 : « se lever ; se lever pour aller quelque part ; se lever contre » ; « le lever (du soleil) ». Académie des langues (terminologie, idéologie n° 415) : « manifestation » (aussi ɲaaloo). Académie des langues (terminologie, idéologie n° 595) : « soulèvement » (aussi piasaa).</text></form></note>
  </entry>
  <entry id="cɔnɔnndo coo_892">
    <lexical-unit><form lang="kqs"><text>cɔnɔnndo coo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔnɔnndo coo_892_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>envol, essor</text></gloss>
      <gloss lang="en"><text>take-off, flight</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.2 Move in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 336: Työnönndo tyoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970) pour « envolement ». La Bible a cɔnɔnndo coo dans un autre sens (PSA.90.10).</text></form></note>
  </entry>
  <entry id="cɔ̀nɔ̌ŋmàkɔ̀ɔ́_893">
    <lexical-unit><form lang="kqs"><text>cɔ̀nɔ̌ŋmàkɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="cɔ̀nɔ̌ŋmàkɔ̀ɔ́_893_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>danse avec sauts et culbutes en arrière</text></gloss>
      <gloss lang="en"><text>dance with backward jumps and flips</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 56: cɔ̀nɔ̌ŋmàkɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="cɔnɔɔ_894">
    <lexical-unit><form lang="kqs"><text>cɔnɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>can</text></form></variant>
    <sense id="cɔnɔɔ_894_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>hacher (les feuilles d'épinards)</text></gloss>
      <gloss lang="en"><text>chop (spinach leaves)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔnɔɔ/ can</text></form></note>
    <note><form lang="fr"><text>Homographe de can « se lever » et de can « pleurer ».</text></form></note>
  </entry>
  <entry id="cɔpiyo_895">
    <lexical-unit><form lang="kqs"><text>cɔpiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>cɔpiya</text></form></field>
    <variant><form lang="kqs"><text>luŋo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="cɔpiyo_895_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>écureuil</text></gloss>
      <gloss lang="en"><text>squirrel</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 114 (G): tyɔpiyo /G./, pl. tyɔpiya</text></form></note>
    <note><form lang="fr"><text>À Kissidougou : luŋo, pl. luŋua (Paulme ; cf. longoo, Lexique). Paulme : tyɔpiyo /G./ ; luŋo /K./, pl. luŋua (p. 114).</text></form></note>
  </entry>
  <entry id="cɔu_896">
    <lexical-unit><form lang="kqs"><text>cɔu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ca</text></form></variant>
    <variant><form lang="kqs"><text>ce</text></form></variant>
    <variant><form lang="kqs"><text>ci</text></form></variant>
    <variant><form lang="kqs"><text>cɔ</text></form></variant>
    <variant><form lang="kqs"><text>canin</text></form></variant>
    <sense id="cɔu_896_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>voir</text></gloss>
      <gloss lang="en"><text>see</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.1 See"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>see, perceive, think</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 382 occurrences, first GEN.2.19; Keita 1979, p. 116: Työw; Paulme 1964, p. 112: tyɛ; Lexique kissi–français, p. 11: cɔu/ cɔ, ce, ca, ci; Childs 2000, p. 58: cɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita écrit työw ; la Bible écrit cɔu (GEN 2,19 ; 13,15) ; cɔw y signifie « créer ». ci : radical négatif (GEN 31,33). Verbe à alternance : ca, ce (accompli), cɔ, ci (négatif), canin (futur). Paulme 1964, p. 112 : ɔ tyɛ dusua « il a vu des chasseurs » ; la tyɛ – tyɔ tyi « il faut bien regarder ».</text></form></note>
  </entry>
  <entry id="cɔunkpɛɛŋɔɔ_897">
    <lexical-unit><form lang="kqs"><text>cɔunkpɛɛŋɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="cɔunkpɛɛŋɔɔ_897_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>potier</text></gloss>
      <gloss lang="en"><text>potter</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 11: cɔunkpɛɛŋɔɔ</text></form></note>
  </entry>
  <entry id="cɔvɔɔ_898">
    <lexical-unit><form lang="kqs"><text>cɔvɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cɔw</text></form></variant>
    <variant><form lang="kqs"><text>cɔaw</text></form></variant>
    <sense id="cɔvɔɔ_898_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire, fabriquer ; créer ; mouler</text></gloss>
      <gloss lang="en"><text>make; create; mould</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.2 Do"/>
      <trait name="semantic-domain-ddp4" value="1 Universe, creation"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 66 occurrences, first GEN.2.1; Lexique kissi–français, p. 11: cɔvɔɔ; Terminologie (arts), n° 122: Työvöö</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 11 : « faire, créer, fabriquer, mouler comme un forgeron » ; aussi cɔwva/ cɔw et le radical caw (p. 9). Académie des langues (terminologie, arts n° 122) : « forger ». Académie des langues (terminologie, arts n° 230) : « maçonner ». Académie des langues (terminologie, arts n° 247) : työvö « modelage ».</text></form></note>
  </entry>
  <entry id="cɔw latukpaa_899">
    <lexical-unit><form lang="kqs"><text>cɔw latukpaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔw latukpaa_899_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>artillerie</text></gloss>
      <gloss lang="en"><text>artillery</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 72: Työw latukpaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="cɔwciɛinɔɔ_900">
    <lexical-unit><form lang="kqs"><text>cɔwciɛinɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="cɔwciɛinɔɔ_900_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>maçon</text></gloss>
      <gloss lang="en"><text>mason</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="6.1.1 Worker"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 229: Työwtyièinöö</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). « Maçonner » : työvöö (cɔvɔɔ) ; « maçonnerie » : työwva (arts n° 230, 231).</text></form></note>
  </entry>
  <entry id="cɔwlaban_901">
    <lexical-unit><form lang="kqs"><text>cɔwlaban</text></form></lexical-unit>
