  <entry id="mandaa_2219">
    <lexical-unit><form lang="kqs"><text>mandaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>manda</text></form></variant>
    <variant><form lang="kqs"><text>mandanin</text></form></variant>
    <sense id="mandaa_2219_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>garder, surveiller, prendre soin de</text></gloss>
      <gloss lang="en"><text>keep, guard, look after</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
      <trait name="semantic-domain-ddp4" value="6.3 Animal husbandry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take care of, raise (animals); mind</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 368 occurrences, first GEN.2.15; Childs 2000, p. 241: màndàá</text></form></note>
    <note><form lang="fr"><text>vana mandaa n'cɔloo « gardien de moutons, berger » (Gn 4,2).</text></form></note>
  </entry>
  <entry id="mandanndo_2220">
    <lexical-unit><form lang="kqs"><text>mandanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mandan</text></form></variant>
    <sense id="mandanndo_2220_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se garder (de), prendre garde ; mettre de côté</text></gloss>
      <gloss lang="en"><text>keep oneself (from), beware; store up</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.5 Keep something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take care of oneself</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first DEU.11; Childs 2000, p. 241: màndăŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de mandaa.</text></form></note>
  </entry>
  <entry id="mandenɔɔ_2221">
    <lexical-unit><form lang="kqs"><text>mandenɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>mandea</text></form></field>
    <sense id="mandenɔɔ_2221_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>marabout, devin</text></gloss>
      <gloss lang="en"><text>diviner, charmer</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>diviner, fortune teller, medicine man; also a Muslim</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.18.11; Keita 1979, p. 150: Mandenöö; Childs 2000, p. 241: màndénɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="mandrakɔr_2222">
    <lexical-unit><form lang="kqs"><text>mandrakɔr</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="mandrakɔr_2222_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mandragore</text></gloss>
      <gloss lang="en"><text>mandrake</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first GEN.30.14</text></form></note>
    <note><form lang="fr"><text>Emprunt.</text></form></note>
  </entry>
  <entry id="mangalaa_2223">
    <lexical-unit><form lang="kqs"><text>mangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mangala</text></form></variant>
    <variant><form lang="kqs"><text>mangalan</text></form></variant>
    <variant><form lang="kqs"><text>mangalanin</text></form></variant>
    <variant><form lang="kqs"><text>mangalɛi</text></form></variant>
    <sense id="mangalaa_2223_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer ; (mangalan) être changé, être différent</text></gloss>
      <gloss lang="en"><text>change; (mangalan) be changed, be different</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.5 Type, kind"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>change (clothes, behaviour); play magic, transform by magic</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 660 occurrences, first GEN.12.2; Childs 2000, p. 242: màŋàlàá</text></form></note>
    <note><form lang="fr"><text>mangala kelala « changer de conduite » ; sɔɛi mangalɛi « une langue différente » (Gn 11,9).</text></form></note>
  </entry>
  <entry id="mangaliaa_2224">
    <lexical-unit><form lang="kqs"><text>mangaliaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>mangaliala</text></form></variant>
    <sense id="mangaliaa_2224_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>falsifier, truquer ; (mangaliala) sortilèges, tours de magie</text></gloss>
      <gloss lang="en"><text>falsify, rig; (mangaliala) sorceries, magic tricks</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>change many things; play magic</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first AMO.8.5; Childs 2000, p. 242: màŋàlìá</text></form></note>
    <note><form lang="fr"><text>Pluriel verbal de mangalaa « changer ». ɲɛla tuvaala n'ɲɛlan mangaliaa « fausser les balances » (AMO.8.5) ; mangaliala ndɔla « ses sortilèges » (ACT.8.11).</text></form></note>
  </entry>
  <entry id="manne_2225">
    <lexical-unit><form lang="kqs"><text>manne</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="manne_2225_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manne</text></gloss>
      <gloss lang="en"><text>manna</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.16</text></form></note>
    <note><form lang="fr"><text>Nom donné par les Israélites à la nourriture du désert (Ex 16,31).</text></form></note>
  </entry>
  <entry id="masa-ibungaa_2226">
    <lexical-unit><form lang="kqs"><text>masa-ibungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>masa-ibunga</text></form></variant>
    <sense id="masa-ibungaa_2226_s1">
