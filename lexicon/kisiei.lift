      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pangolin géant ; (fig.) personnage important</text></gloss>
      <gloss lang="en"><text>giant pangolin; (fig.) big man, important person</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 180: kóósóó kóósúá</text></form></note>
    <note><form lang="fr"><text>Manis gigantea.</text></form></note>
  </entry>
  <entry id="koovaa_1464">
    <lexical-unit><form lang="kqs"><text>koovaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="koovaa_1464_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>médicaments (Keita)</text></gloss>
      <gloss lang="en"><text>medicines (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 161: Koovaa</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, koovaa désigne le chant du coq (Mt 26,34). Cf. Childs (kissi du Sud) p. 177, kòówáŋ « sang ; potion ».</text></form></note>
  </entry>
  <entry id="koovan_1465">
