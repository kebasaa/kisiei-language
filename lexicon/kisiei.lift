  <entry id="lenamta_2044">
    <lexical-unit><form lang="kqs"><text>lenamta</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lenamta_2044_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>défaut, tare (nɔ lenamta loo « sans défaut »)</text></gloss>
      <gloss lang="en"><text>blemish, defect (nɔ lenamta loo 'without blemish')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a crippled or handicapped person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first EXO.12.5; Childs 2000, p. 258: nâmtàá</text></form></note>
  </entry>
  <entry id="lende_2045">
    <lexical-unit><form lang="kqs"><text>lende</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="lende_2045_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>ainsi, de cette façon, comme cela</text></gloss>
      <gloss lang="en"><text>thus, so, in this way, like that</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
      <trait name="semantic-domain-ddp4" value="9.6.3 Discourse markers"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1554 occurrences, first GEN.1.7; Childs 2000, p. 226: léndé</text></form></note>
    <note><form lang="fr"><text>Mí ɲɔɔ tosan lende « et il en fut ainsi » (GEN.1.7) ; lende koni « de même ».</text></form></note>
