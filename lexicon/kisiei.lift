    <sense id="kɔ̀sàá_2872_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être taché, rouillé, rester sale ; salir</text></gloss>
      <gloss lang="en"><text>be spotted, rusty, stay dirty; make dirty</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 189: kɔ̀sàá</text></form></note>
  </entry>
  <entry id="kɔsiɔn_2873">
    <lexical-unit><form lang="kqs"><text>kɔsiɔn</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kɔsiɔn_2873_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>soumbara (condiment de graines de néré)</text></gloss>
      <gloss lang="en"><text>soumbala (néré seed condiment)</text></gloss>
