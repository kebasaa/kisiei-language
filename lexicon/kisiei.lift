      <gloss lang="en"><text>filthy, multicoloured (stresses dirt or colours)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 291: péésée</text></form></note>
  </entry>
