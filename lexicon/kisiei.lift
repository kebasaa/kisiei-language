  <entry id="kiilanɔɔ_1347">
    <lexical-unit><form lang="kqs"><text>kiilanɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiilanɔ</text></form></variant>
    <sense id="kiilanɔɔ_1347_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>messager</text></gloss>
      <gloss lang="en"><text>messenger</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5 Communication"/>
      <trait name="semantic-domain-ddp4" value="7.2.8 Send someone"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 10 occurrences, first GEN.50.16; Keita 1979, p. 148: Kiilanöö</text></form></note>
  </entry>
  <entry id="kiindiaa_1348">
    <lexical-unit><form lang="kqs"><text>kiindiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiindian</text></form></variant>
    <sense id="kiindiaa_1348_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer (plusieurs portes) ; (kiindian) s'enfermer</text></gloss>
      <gloss lang="en"><text>shut, close (several doors); (kiindian) shut oneself in</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>close (plural action of 'close')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.3.23; Childs 2000, p. 163: kììndíá</text></form></note>
    <note><form lang="fr"><text>Mí Ehud kiindiaa diolan kpow « Ehud ferma toutes les portes » (JDG.3.23) ; Má kiindian diolan kɔɔli « ils fermèrent les portes derrière eux » (JDG.9.51). Pluriel verbal de kinda « fermer ».</text></form></note>
  </entry>
  <entry id="kiinkiindo_1349">
    <lexical-unit><form lang="kqs"><text>kiinkiindo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kiinkiindo_1349_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mouche maçonne</text></gloss>
      <gloss lang="en"><text>mason wasp</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 136: Kiinkiindo; Childs 2000, p. 163: kìŋkííŋndó</text></form></note>
  </entry>
  <entry id="kiisanndo_1350">
    <lexical-unit><form lang="kqs"><text>kiisanndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiisan</text></form></variant>
    <sense id="kiisanndo_1350_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>hésiter, tarder, se retenir</text></gloss>
      <gloss lang="en"><text>hesitate, hold back</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.19.16</text></form></note>
  </entry>
  <entry id="kiisuu_1351">
    <lexical-unit><form lang="kqs"><text>kiisuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kiisuu_1351_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>allumer (le feu)</text></gloss>
      <gloss lang="en"><text>kindle (a fire)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>kindle, start a fire; restart an argument</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first JOB.20.26; Childs 2000, p. 164: kììsùùwó</text></form></note>
    <note><form lang="fr"><text>la kue lɛnin yinnden kiisuu o fonda-loamaa-lasálà nuu coo fondo fúú le « vous n'allumerez plus en vain le feu sur mon autel » (MAL.1.10) ; yinnde vana kíísúú le len « un feu qu'on n'a pas allumé » (JOB.20.26).</text></form></note>
  </entry>
  <entry id="kiiye_1352">
    <lexical-unit><form lang="kqs"><text>kiiye</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>kii</text></form></variant>
    <sense id="kiiye_1352_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>clef</text></gloss>
      <gloss lang="en"><text>key</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.2 Parts of a building"/>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Kiiye; Childs 2000, p. 164: kîyé</text></form></note>
    <note><form lang="fr"><text>Forme radicale kii dans la Bible (Jg 3,25 ; Is 22,22). Emprunt à l'anglais key selon Childs.</text></form></note>
  </entry>
  <entry id="kììyo_1353">
    <lexical-unit><form lang="kqs"><text>kììyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kììyo_1353_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lie (du vin)</text></gloss>
      <gloss lang="en"><text>dregs, lees</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>dregs of palm wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PSA.75.9; Childs 2000, p. 164: kììyó</text></form></note>
    <note><form lang="fr"><text>kol man a kììyo kpede « en boire jusqu'à la lie » (PSA.75.9) ; maa mɔiyan ma cal o kììyo coo « comme le vin reposant sur sa lie » (JER.48.11).</text></form></note>
  </entry>
  <entry id="kíkííyá_1354">
    <lexical-unit><form lang="kqs"><text>kíkííyá</text></form></lexical-unit>
    <trait name="noun-class" value="a"/>
    <trait name="status" value="southern"/>
    <sense id="kíkííyá_1354_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paludisme</text></gloss>
      <gloss lang="en"><text>malaria</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 163: kíkííyá</text></form></note>
  </entry>
  <entry id="kikil_1355">
    <lexical-unit><form lang="kqs"><text>kikil</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kikil_1355_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cercle, voûte</text></gloss>
      <gloss lang="en"><text>circle, vault</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.1 Shape"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>traditional round house with a cone-shaped roof; cone</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first ISA.40.22; Childs 2000, p. 164: kíkílló</text></form></note>
    <note><form lang="fr"><text>Ndu co icali o kikil lelɛŋndo bollen ni « il siège au-dessus du cercle de la terre » (ISA.40.22). Une seule occurrence.</text></form></note>
  </entry>
  <entry id="kikiɲaa_1356">
    <lexical-unit><form lang="kqs"><text>kikiɲaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="kikiɲaa_1356_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>épilepsie</text></gloss>
      <gloss lang="en"><text>epilepsy</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.2 Disease"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>malaria</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.4.24; Keita 1979, p. 161: Kikinyaa; Childs 2000, p. 163: kííkííyá</text></form></note>
  </entry>
  <entry id="kila_1357">
    <lexical-unit><form lang="kqs"><text>kila</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilaa</text></form></variant>
    <sense id="kila_1357_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'installer ; (kila dɔ́ɔ́ngɔ́ɔ̀) camper ; établir</text></gloss>
      <gloss lang="en"><text>settle; (kila dɔ́ɔ́ngɔ́ɔ̀) pitch camp; establish</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 114 occurrences, first GEN.11.2</text></form></note>
  </entry>
  <entry id="kila hala_1358">
    <lexical-unit><form lang="kqs"><text>kila hala</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kila hala_1358_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>prophète (Keita)</text></gloss>
      <gloss lang="en"><text>prophet (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.7 Religious organization"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Kila hala</text></form></note>
    <note><form lang="fr"><text>Forme douteuse ; la Bible dit vana-tɛɛngaa-diom Hala « prophète » (2R 4,40).</text></form></note>
  </entry>
  <entry id="kìlàmáŋndéŋ_1359">
    <lexical-unit><form lang="kqs"><text>kìlàmáŋndéŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="kìlàmáŋndéŋ_1359_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>instrument à cordes (sorte de harpe à caisse de résonance, ou monocorde joué à l'archet) accompagnant les contes</text></gloss>
      <gloss lang="en"><text>stringed instrument (harp-like with a resonator, or one-stringed bowed lute) played with storytelling</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 165: kìlàmáŋndéŋ</text></form></note>
  </entry>
  <entry id="kili_1360">
    <lexical-unit><form lang="kqs"><text>kili</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kili_1360_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper, trancher</text></gloss>
      <gloss lang="en"><text>cut, cut off</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cut many things, cut into small pieces</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 49 occurrences, first GEN.49.6; Childs 2000, p. 166: kìlìó</text></form></note>
  </entry>
  <entry id="kílì-kílì_1361">
    <lexical-unit><form lang="kqs"><text>kílì-kílì</text></form></lexical-unit>
