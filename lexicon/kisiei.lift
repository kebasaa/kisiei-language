      <gloss lang="fr"><text>minuit</text></gloss>
      <gloss lang="en"><text>midnight</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 20: idio; Sandara Kisia, fable 2: Idio</text></form></note>
    <note><form lang="fr"><text>Sandara Kissia, fable 2 : Idio mi sulukuo dimul wɛin ndɔ « à minuit, l'hyène dit à sa femme ».</text></form></note>
  </entry>
