    <sense id="masalen hiɔlɔɔ_3413_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'emparer du pouvoir, prendre le royaume</text></gloss>
      <gloss lang="en"><text>seize power, take the kingdom</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.6 Government"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 325: Masalen hiölöö</text></form></note>
    <note><form lang="fr"><text>Académie des langues (terminologie, histoire n° 325) : « s'emparer du pouvoir ».</text></form></note>
  </entry>
  <entry id="masalen kuunanndo_3414">
    <lexical-unit><form lang="kqs"><text>masalen kuunanndo</text></form></lexical-unit>
