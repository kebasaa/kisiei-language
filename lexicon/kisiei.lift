    <sense id="bòpòó_212_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>toute chose grande ; pagaie, gouvernail ; hotte conique à bretelles</text></gloss>
      <gloss lang="en"><text>anything large; paddle, rudder; conical back basket with straps</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 24: bòpòó</text></form></note>
  </entry>
  <entry id="bósàá_213">
