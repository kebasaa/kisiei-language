    <sense id="pesi_2572_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser, casser</text></gloss>
      <gloss lang="en"><text>break</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>break (several things)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first EXO.32.20; Childs 2000, p. 293: pèsìó</text></form></note>
  </entry>
  <entry id="pesipesi_2573">
    <lexical-unit><form lang="kqs"><text>pesipesi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pesipesinin</text></form></variant>
    <sense id="pesipesi_2573_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>briser en morceaux, mettre en pièces</text></gloss>
      <gloss lang="en"><text>break into pieces, smash</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 57 occurrences, first EXO.23.24; Childs 2000, p. 293: pésépésìó</text></form></note>
    <note><form lang="fr"><text>Redoublement de pesi « briser ».</text></form></note>
  </entry>
  <entry id="pèsǐŋndó_2574">
    <lexical-unit><form lang="kqs"><text>pèsǐŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pèsǐŋndó_2574_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se briser tout seul ; éclater de rire</text></gloss>
      <gloss lang="en"><text>break by itself; burst out laughing</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="3.4.1 Feel good"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 293: pèsǐŋndó</text></form></note>
  </entry>
  <entry id="pewvo_2575">
    <lexical-unit><form lang="kqs"><text>pewvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pewva</text></form></field>
    <sense id="pewvo_2575_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cochon, porc</text></gloss>
      <gloss lang="en"><text>pig</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
      <trait name="semantic-domain-ddp4" value="6.3.1 Domesticated animal"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first LEV.11.7; Keita 1979, p. 136: Pewvo; Childs 2000, p. 294: pèùwó</text></form></note>
  </entry>
  <entry id="peŋ_2576">
    <lexical-unit><form lang="kqs"><text>peŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="peŋ_2576_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>solidement, fermement (lier, endurcir)</text></gloss>
      <gloss lang="en"><text>tightly, firmly (bind, harden)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.5.4 Tie"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>tightly</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.22.9; Childs 2000, p. 296: pêŋ</text></form></note>
    <note><form lang="fr"><text>mó yii ndu peŋ « il le lia solidement » (Gn 22,9) ; kindi nilan peŋ « endurcir le cœur » (Ex 7,3).</text></form></note>
  </entry>
  <entry id="péŋ_2577">
    <lexical-unit><form lang="kqs"><text>péŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="péŋ_2577_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>net, d'un coup sec (enfoncé à fond, virage brusque, saut de puce)</text></gloss>
      <gloss lang="en"><text>sharply, abruptly (nailed all the way, sharp turn, flea's jump)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 293: péŋ</text></form></note>
  </entry>
  <entry id="pèŋgìó_2578">
    <lexical-unit><form lang="kqs"><text>pèŋgìó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pèŋgìó_2578_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peler ; frapper, gifler</text></gloss>
      <gloss lang="en"><text>peel; hit, beat, slap</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 293: pèŋgìó</text></form></note>
  </entry>
  <entry id="péŋpéŋ_2579">
    <lexical-unit><form lang="kqs"><text>péŋpéŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="péŋpéŋ_2579_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>en premier, tout d'abord</text></gloss>
      <gloss lang="en"><text>first, originally</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 293: péŋpéŋ</text></form></note>
  </entry>
  <entry id="piaa_2580">
    <lexical-unit><form lang="kqs"><text>piaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pia</text></form></variant>
    <sense id="piaa_2580_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être plein, rempli (o piaa cá a … « plein de … »)</text></gloss>
      <gloss lang="en"><text>be full, filled (o piaa cá a … 'full of …')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.8 Full"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 62 occurrences, first EXO.16.3</text></form></note>
  </entry>
  <entry id="píàà_2581">
    <lexical-unit><form lang="kqs"><text>píàà</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="píàà_2581_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit de ce qui fend l'eau à toute vitesse</text></gloss>
      <gloss lang="en"><text>sound of cutting through water at great speed</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: píàà</text></form></note>
  </entry>
  <entry id="piaandoo_2582">
    <lexical-unit><form lang="kqs"><text>piaandoo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>piaandua</text></form></field>
    <variant><form lang="kqs"><text>piaandu</text></form></variant>
    <variant><form lang="kqs"><text>piaandaa</text></form></variant>
    <sense id="piaandoo_2582_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mâle ; garçon, fils</text></gloss>
      <gloss lang="en"><text>male; boy, son</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.5 Male, female"/>
      <trait name="semantic-domain-ddp4" value="1.6.7 Male and female animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 77 occurrences, first GEN.4.1; Childs 2000, p. 298: pìàndòó</text></form></note>
  </entry>
  <entry id="pialaa_2583">
    <lexical-unit><form lang="kqs"><text>pialaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pialaa_2583_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>brisé, rompu ; (sɛbɛ pialaa) lettre de divorce</text></gloss>
      <gloss lang="en"><text>broken; (sɛbɛ pialaa) certificate of divorce</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.1 Break"/>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cracked open (adj. from 'crack')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first MAT.5.31; Childs 2000, p. 298: pìàlàá</text></form></note>
    <note><form lang="fr"><text>De piɔlɔɔ « briser ». mɛɛ o yɔngu ndu sɛbɛ pialaa « qu'il lui donne une lettre de divorce » (MAT.5.31, MRK.10.4).</text></form></note>
  </entry>
  <entry id="piasaa_2584">
    <lexical-unit><form lang="kqs"><text>piasaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piasa</text></form></variant>
    <sense id="piasaa_2584_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'écarter, s'étendre ; (nom) empan</text></gloss>
      <gloss lang="en"><text>spread apart, extend; (noun) span</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2 Move"/>
      <trait name="semantic-domain-ddp4" value="8.2.8 Measure"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 18 occurrences, first EXO.28.16; Keita 1979, p. 113: Piasaa</text></form></note>
    <note><form lang="fr"><text>piasa : branches qui s'étendent sur le mur (GEN 49,22) ; piasaa « empan » (EXO 28,16).</text></form></note>
  </entry>
  <entry id="piawvo_2585">
    <lexical-unit><form lang="kqs"><text>piawvo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piaw</text></form></variant>
    <sense id="piawvo_2585_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>manche, poignée ; hampe</text></gloss>
      <gloss lang="en"><text>handle, hilt; shaft</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7 Tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.19.5; Childs 2000, p. 298: pìáúwó</text></form></note>
    <note><form lang="fr"><text>Hali piaw imɔɔ … luɛi ndu nin « même la poignée entra après la lame » (Jg 3,22) ; piaw bál ndɔɔ « la hampe de sa lance » (1 S 17,7). Homonyme de piaw, radical de piow « abandonner ».</text></form></note>
  </entry>
  <entry id="pii_2586">
    <lexical-unit><form lang="kqs"><text>pii</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pii_2586_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>toute la nuit (lɔl … pii « passer toute la nuit à … »)</text></gloss>
      <gloss lang="en"><text>all night long (lɔl … pii 'spend the whole night …')</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.2 Take time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first EXO.10.13; Childs 2000, p. 299: píípíí</text></form></note>
    <note><form lang="fr"><text>mó lɔl Hala piɛiyo pii « il passa toute la nuit à prier Dieu » (LUK.6.12) ; icɔl pii « toute la nuit » (LUK.5.5).</text></form></note>
  </entry>
  <entry id="pìì-_2587">
    <lexical-unit><form lang="kqs"><text>pìì-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìì-_2587_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vert, pas mûr</text></gloss>
      <gloss lang="en"><text>green, unripe</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 298: pìì-</text></form></note>
  </entry>
  <entry id="piilian_2588">
    <lexical-unit><form lang="kqs"><text>piilian</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piilianndo</text></form></variant>
    <sense id="piilian_2588_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>palper, tâter, toucher (de la main)</text></gloss>
      <gloss lang="en"><text>feel, touch (with the hand)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.5 Sense of touch"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>touch oneself or someone repeatedly (plural middle of 'touch, dab')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 8 occurrences, first GEN.27.21; Childs 2000, p. 299: pììlìáŋndó</text></form></note>
    <note><form lang="fr"><text>Pluriel de pilanndo « toucher ». mì piilian nɔm « que je te tâte » (GEN.27.21).</text></form></note>
  </entry>
  <entry id="piimiaa_2589">
    <lexical-unit><form lang="kqs"><text>piimiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piimiaanin</text></form></variant>
    <sense id="piimiaa_2589_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'assombrir, noircir</text></gloss>
      <gloss lang="en"><text>grow dark, turn black</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first 1KI.18.45; Childs 2000, p. 299: pììmìá</text></form></note>
    <note><form lang="fr"><text>halataalaa piimiaa kpilo « le ciel s'obscurcit » (1 R 18,45) ; Yáw nuu co ya piimiaa « ma peau noircit » (Jb 30,30).</text></form></note>
  </entry>
  <entry id="piindo_2590">
    <lexical-unit><form lang="kqs"><text>piindo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>piinda</text></form></field>
    <sense id="piindo_2590_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tourterelle</text></gloss>
      <gloss lang="en"><text>turtledove</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.15.9; Childs 2000, p. 299: pììŋndó</text></form></note>
    <note><form lang="fr"><text>piinda nda ŋiɔn, te kon te kangboa nda ŋiɔn « deux tourterelles ou deux jeunes pigeons » (Lv 5,7).</text></form></note>
  </entry>
  <entry id="piinduu_2591">
    <lexical-unit><form lang="kqs"><text>piinduu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="piinduu_2591_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>acheter (beaucoup de choses), acheter tout</text></gloss>
      <gloss lang="en"><text>buy (many things), buy up</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.47.20; Childs 2000, p. 299: pììndùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de piondɔɔ « acheter ». Yosɛf piinduu yondola Esiptea kpow « Joseph acheta toutes les terres des Égyptiens » (GEN.47.20).</text></form></note>
  </entry>
  <entry id="piisuu_2592">
    <lexical-unit><form lang="kqs"><text>piisuu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>piisuanndo</text></form></variant>
    <sense id="piisuu_2592_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>vendre (beaucoup de choses), vendre tout</text></gloss>
      <gloss lang="en"><text>sell (many things), sell off</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.47.20; Childs 2000, p. 299: pììsùùwó</text></form></note>
    <note><form lang="fr"><text>Pluriel de pisio « vendre ». mó kɔ piisuu ɲɛm ndɔn kpow « il alla vendre tout ce qu'il avait » (MAT.13.46) ; piisuanndo (NEH.5.8).</text></form></note>
  </entry>
  <entry id="pîìyó_2593">
    <lexical-unit><form lang="kqs"><text>pîìyó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pîìyó_2593_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>appel (en justice)</text></gloss>
      <gloss lang="en"><text>appeal (legal)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 299: pîìyó</text></form></note>
  </entry>
  <entry id="pìíŋndé_2594">
    <lexical-unit><form lang="kqs"><text>pìíŋndé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="pìíŋndé_2594_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>conditions préalables exigées pour une potion magique (lieu secret)</text></gloss>
      <gloss lang="en"><text>prerequisites for a magical potion (given at a secret place)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 299: pìíŋndé</text></form></note>
  </entry>
  <entry id="pìkàpìkàá_2595">
    <lexical-unit><form lang="kqs"><text>pìkàpìkàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pìkàpìkàá_2595_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>agiter un tison dans l'obscurité pour éclairer</text></gloss>
      <gloss lang="en"><text>swing a burning stick in the dark to make light</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 300: pìkàpìkàá</text></form></note>
  </entry>
  <entry id="pikiei_2596">
    <lexical-unit><form lang="kqs"><text>pikiei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pikion</text></form></field>
    <variant><form lang="kqs"><text>pikii</text></form></variant>
    <variant><form lang="kqs"><text>pikin</text></form></variant>
    <sense id="pikiei_2596_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>piquet (de tente), cheville ; ensouple (de métier à tisser)</text></gloss>
      <gloss lang="en"><text>tent peg, stake; beam (of a loom)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.5 Fastening tool"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first JDG.4.21</text></form></note>
    <note><form lang="fr"><text>pikii cɛi-kola-toandaa « un piquet de tente » (Jg 4,21) ; maa pikii nda simbulu kola « comme une ensouple de tisserand » (1 S 17,7).</text></form></note>
  </entry>
  <entry id="pila_2597">
    <lexical-unit><form lang="kqs"><text>pila</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pila_2597_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>même (lui-même)</text></gloss>
      <gloss lang="en"><text>self, -self</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'indeed'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1778 occurrences, first GEN.2.12; Childs 2000, p. 300: pílá</text></form></note>
  </entry>
  <entry id="pilaa_2598">
    <lexical-unit><form lang="kqs"><text>pilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pilalen</text></form></variant>
    <variant><form lang="kqs"><text>pilalan</text></form></variant>
    <sense id="pilaa_2598_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>d'autrui, de quelqu'un d'autre ; propre (à soi) ; (lɛŋnde pilalen) pays étranger</text></gloss>
      <gloss lang="en"><text>another's, someone else's; (one's) own; (lɛŋnde pilalen) foreign land</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.3 Pronouns"/>
      <trait name="semantic-domain-ddp4" value="7.4 Have, be with"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>someone's, people's, another's</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 88 occurrences, first GEN.1.27; Childs 2000, p. 300: pílá</text></form></note>
    <note><form lang="fr"><text>La fúla cɛi pilaa lehɔl te « tu ne convoiteras pas la maison d'autrui » (EXO.20.17) ; lɛŋnde pilalen « un pays étranger » (EXO.18.3) ; hakila nda pilalan « leurs propres fautes » (LEV.26.39).</text></form></note>
  </entry>
  <entry id="pilacieo_2599">
    <lexical-unit><form lang="kqs"><text>pilacieo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pilacieaa</text></form></field>
    <variant><form lang="kqs"><text>pilaciee</text></form></variant>
    <variant><form lang="kqs"><text>pilacieea</text></form></variant>
    <sense id="pilacieo_2599_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>autochtone, citoyen ; (pl.) gens du pays</text></gloss>
      <gloss lang="en"><text>native, citizen; (pl.) people of the land</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="4.6.7 Region"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first LEV.17.8; Childs 2000, p. 300: pílácíóó</text></form></note>
    <note><form lang="fr"><text>cua pilacieo Israɛl « un Israélite de souche » (Lv 17,8) ; pilacieea Kerar « les gens de Guérar » (Gn 26,7).</text></form></note>
  </entry>
  <entry id="pilannde_2600">
    <lexical-unit><form lang="kqs"><text>pilannde</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <sense id="pilannde_2600_s1">
