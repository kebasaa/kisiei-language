    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 267: ndíámɔ́ɔ́</text></form></note>
  </entry>
  <entry id="ndili_3687">
    <lexical-unit><form lang="kqs"><text>ndili</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="ndili_3687_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>le surlendemain</text></gloss>
      <gloss lang="en"><text>two days after tomorrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 152: Ndili; Lexique kissi–français, p. 37: ndili</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 37 : aussi ndiri « trois jours après ».</text></form></note>
  </entry>
