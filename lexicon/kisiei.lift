  <entry id="púéíyé_2686">
    <lexical-unit><form lang="kqs"><text>púéíyé</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="púéíyé_2686_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pipe</text></gloss>
      <gloss lang="en"><text>pipe (for smoking)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.4 Tobacco"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: púéíyé</text></form></note>
  </entry>
  <entry id="puilen_2687">
    <lexical-unit><form lang="kqs"><text>puilen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puile</text></form></variant>
    <sense id="puilen_2687_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>queue</text></gloss>
      <gloss lang="en"><text>tail</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>a brush of tied grass used by a praise singer, often replaced by a cow's tail</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.4.4; Childs 2000, p. 311: pùìléŋ</text></form></note>
    <note><form lang="fr"><text>puile ndɔlen « sa queue (grasse) » (Lv 3,9).</text></form></note>
  </entry>
  <entry id="puiyaa_2688">
    <lexical-unit><form lang="kqs"><text>puiyaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pui</text></form></variant>
    <variant><form lang="kqs"><text>puinin</text></form></variant>
    <sense id="puiyaa_2688_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pousser, verdir, repousser ; verdure</text></gloss>
      <gloss lang="en"><text>sprout, grow green, shoot again; greenery</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sprout new growth, grow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first GEN.13.10; Childs 2000, p. 311: pùìyó</text></form></note>
    <note><form lang="fr"><text>o muungu vɛlɛ o pui « il repousse » (Jb 14,7) ; dɛɛla … va o puiyaa ɲɛkɛndɛi « la plaine était bien arrosée, verdoyante » (Gn 13,10).</text></form></note>
  </entry>
  <entry id="puiyo_2689">
    <lexical-unit><form lang="kqs"><text>puiyo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="puiyo_2689_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>paille</text></gloss>
      <gloss lang="en"><text>straw</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>new sprouts; thatch, grass cut for thatching</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.19.19; Keita 1979, p. 140: Puiyo; Childs 2000, p. 311: pùìyó</text></form></note>
  </entry>
  <entry id="pùkéé_2690">
    <lexical-unit><form lang="kqs"><text>pùkéé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùkéé_2690_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit du riz qui tombe dans le van</text></gloss>
      <gloss lang="en"><text>whooshing sound of rice falling into a fanner</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùkéé</text></form></note>
  </entry>
  <entry id="pùlàléŋ_2691">
    <lexical-unit><form lang="kqs"><text>pùlàléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pùlàléŋ_2691_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>file, colonne (de gens, de fourmis) ; lignée</text></gloss>
      <gloss lang="en"><text>line, column (of people, ants); ancestral line</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.5 Location"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùlàléŋ</text></form></note>
  </entry>
  <entry id="pulen_2692">
    <lexical-unit><form lang="kqs"><text>pulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>pule</text></form></variant>
    <sense id="pulen_2692_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nombril ; cordon ombilical</text></gloss>
      <gloss lang="en"><text>navel; umbilical cord</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 132: Pulen; Childs 2000, p. 311: pùléŋ</text></form></note>
    <note><form lang="fr"><text>Forme radicale pule attestée (Ez 16,4 ; Ct 7,3).</text></form></note>
  </entry>
  <entry id="pulon_2693">
    <lexical-unit><form lang="kqs"><text>pulon</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pulon_2693_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entrailles, intestins</text></gloss>
      <gloss lang="en"><text>entrails, intestines</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.8 Internal organs"/>
      <trait name="semantic-domain-ddp4" value="1.6.2 Parts of an animal"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stomach, intestines (plural pùlóŋ); also a woman's labour stage, a strip of cloth</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first LEV.3.3; Childs 2000, p. 311: pùléí</text></form></note>
    <note><form lang="fr"><text>cuɛima kumbu pulon « la graisse qui couvre les entrailles » (Lv 3,3). Voir pulen « nombril ».</text></form></note>
  </entry>
  <entry id="pùlóó_2694">
    <lexical-unit><form lang="kqs"><text>pùlóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùlúláŋ</text></form></field>
    <sense id="pùlóó_2694_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>grappe, gousse (noix de kola, noix de palme)</text></gloss>
      <gloss lang="en"><text>cluster, pod (kola nuts, palm nuts)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 311: pùlóó</text></form></note>
  </entry>
  <entry id="pulta_2695">
    <lexical-unit><form lang="kqs"><text>pulta</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>pultan</text></form></field>
    <sense id="pulta_2695_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cendre</text></gloss>
      <gloss lang="en"><text>ash</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.5 Fire"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first EXO.9.8; Childs 2000, p. 312: pùltáŋ</text></form></note>
  </entry>
  <entry id="púlú_2696">
    <lexical-unit><form lang="kqs"><text>púlú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púlú_2696_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>vite, soudain</text></gloss>
      <gloss lang="en"><text>quickly, suddenly</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púlú</text></form></note>
  </entry>
  <entry id="pululen_2697">
    <lexical-unit><form lang="kqs"><text>pululen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulule</text></form></variant>
    <sense id="pululen_2697_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gloutonnerie, gourmandise, excès de table</text></gloss>
      <gloss lang="en"><text>gluttony, greed (for food), carousing</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>greed</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PRO.21.17; Childs 2000, p. 312: pùlúléŋ</text></form></note>
    <note><form lang="fr"><text>De pulei « ventre ». mɔiyan yɔngɔnndo, pululen « l'ivrognerie, les excès de table » (GAL.5.21) ; mɔiyan a pululen (PRO.21.17, LUK.21.34) ; a pulule ndɔlen « à sa voracité » (JOB.20.21).</text></form></note>
  </entry>
  <entry id="púlùtù_2698">
    <lexical-unit><form lang="kqs"><text>púlùtù</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púlùtù_2698_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>bruit d'herbe arrachée, de tissu déchiré, de petite moto</text></gloss>
      <gloss lang="en"><text>sound of grass uprooted, cloth tearing, a small motorbike</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púlùtù</text></form></note>
  </entry>
  <entry id="pulɔn sɛllo_2699">
    <lexical-unit><form lang="kqs"><text>pulɔn sɛllo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="pulɔn sɛllo_2699_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ablution</text></gloss>
      <gloss lang="en"><text>ritual ablution</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Pulön sèllo</text></form></note>
  </entry>
  <entry id="pulɔnndo_2700">
    <lexical-unit><form lang="kqs"><text>pulɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulun</text></form></variant>
    <sense id="pulɔnndo_2700_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se laver</text></gloss>
      <gloss lang="en"><text>wash oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first EXO.2.5; Keita 1979, p. 115: Pulönndo</text></form></note>
    <note><form lang="fr"><text>Moyen de pulɔɔ.</text></form></note>
  </entry>
  <entry id="pulɔɔ_2701">
    <lexical-unit><form lang="kqs"><text>pulɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>pulu</text></form></variant>
    <variant><form lang="kqs"><text>pilu</text></form></variant>
    <sense id="pulɔɔ_2701_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>laver (personnes, corps)</text></gloss>
      <gloss lang="en"><text>wash (people, body)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6.2 Bathe"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>wash, bathe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 23 occurrences, first GEN.18.4; Keita 1979, p. 115: Pulöö; Childs 2000, p. 312: pùlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>pilu : radical négatif (MRK 7,2).</text></form></note>
  </entry>
  <entry id="pum_2702">
    <lexical-unit><form lang="kqs"><text>pum</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pum_2702_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>un certain, un</text></gloss>
      <gloss lang="en"><text>a certain, some</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1 Quantity"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'a few, part, a little'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1454 occurrences, first GEN.2.10; Childs 2000, p. 312: pùm</text></form></note>
  </entry>
  <entry id="pumboo_2703">
    <lexical-unit><form lang="kqs"><text>pumboo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pumboo_2703_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>nid, essaim (d'abeilles)</text></gloss>
      <gloss lang="en"><text>nest, swarm (of bees)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
      <trait name="semantic-domain-ddp4" value="6.4.4 Beekeeping"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>nest of wasps or of a kind of ant</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first JDG.14.8; Childs 2000, p. 312: pùmbòó</text></form></note>
    <note><form lang="fr"><text>mó komal lɛa pumboo o visi kalaa nin « il trouva un essaim d'abeilles dans le cadavre (du lion) » (JDG.14.8).</text></form></note>
  </entry>
  <entry id="pumbu_2704">
    <lexical-unit><form lang="kqs"><text>pumbu</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="pumbu_2704_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu fixe, établissement (icali o pumbu « demeurer à un endroit fixe »)</text></gloss>
      <gloss lang="en"><text>settled place (icali o pumbu 'live in a fixed place')</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note><form lang="fr"><text>A ve lɛnin icali o pumbú le « tu ne demeureras nulle part (tu seras errant) » (Gn 4,12) ; vanaa cel o pumbu le « les nomades » (Jg 8,11). Aussi écrit pumbú. Sens à confirmer.</text></form></note>
  </entry>
  <entry id="pumndo_2705">
    <lexical-unit><form lang="kqs"><text>pumndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pumndo_2705_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être rassasié ; satiété</text></gloss>
      <gloss lang="en"><text>be full, satisfied; fullness</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be full</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 14 occurrences, first EXO.16.21; Childs 2000, p. 312: pùmndó</text></form></note>
    <note><form lang="fr"><text>la vanin dioo mì la va pumndo « tu mangeras et tu seras rassasié » (DEU.8.10) ; mɛɛ ndóò nɔla pumndo yɛ « selon ce qu'il pouvait manger » (EXO.16.21). Voir pim « être rassasié ».</text></form></note>
  </entry>
  <entry id="pundaa_2706">
    <lexical-unit><form lang="kqs"><text>pundaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <sense id="pundaa_2706_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cécité, vue voilée</text></gloss>
      <gloss lang="en"><text>blindness, dimness of sight</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.4 Disabled"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>white filmy growth that causes cataracts and blindness</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first GEN.27.1; Childs 2000, p. 312: púndáá</text></form></note>
    <note><form lang="fr"><text>pundaa cal ndu o lahɔl « ses yeux s'étaient affaiblis » (Gn 27,1).</text></form></note>
  </entry>
  <entry id="pùndóó_2707">
    <lexical-unit><form lang="kqs"><text>pùndóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùndóó_2707_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rat des marais très poilu</text></gloss>
      <gloss lang="en"><text>hairy swamp rat</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: pùndóó</text></form></note>
  </entry>
  <entry id="púndúkúlúŋ_2708">
    <lexical-unit><form lang="kqs"><text>púndúkúlúŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púndúkúlúŋ_2708_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>de très bonne heure (le matin)</text></gloss>
      <gloss lang="en"><text>very early in the morning</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.1 Period of time"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púndúkúlúŋ</text></form></note>
  </entry>
  <entry id="púndùŋ_2709">
    <lexical-unit><form lang="kqs"><text>púndùŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="púndùŋ_2709_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>plouf (nage, chute dans l'eau)</text></gloss>
      <gloss lang="en"><text>splash (swimming, falling into water)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="1.3 Water"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 312: púndùŋ</text></form></note>
  </entry>
  <entry id="pundɔɔ_2710">
    <lexical-unit><form lang="kqs"><text>pundɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="pundɔɔ_2710_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>pétrir, humecter (la farine avec l'huile)</text></gloss>
      <gloss lang="en"><text>knead, moisten (flour with oil)</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze, mash</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first EZK.46.14; Childs 2000, p. 312: pùndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>cuɛiyan … le kpeyanndo pundɔɔ « de l'huile pour humecter la farine » (EZK.46.14).</text></form></note>
  </entry>
  <entry id="pungaa_2711">
    <lexical-unit><form lang="kqs"><text>pungaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>punga</text></form></variant>
    <variant><form lang="kqs"><text>pungapungaa</text></form></variant>
    <sense id="pungaa_2711_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>piller, ravir ; pillage, butin</text></gloss>
      <gloss lang="en"><text>plunder, loot; plunder, spoil</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fight or squabble over something (e.g. food); also blossom</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 1SA.14.48; Childs 2000, p. 313: pùŋàá</text></form></note>
    <note><form lang="fr"><text>vannda punga ɲɛm naan « on a pillé nos biens » (Esd 9,7) ; siŋnun pungapungaa « devenir une proie » (Ez 26,5 ; 34,22).</text></form></note>
  </entry>
  <entry id="pùóó_2712">
    <lexical-unit><form lang="kqs"><text>pùóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùóó_2712_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entaille faite pour abattre un arbre</text></gloss>
      <gloss lang="en"><text>notch made when felling a tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.3 Working with wood"/>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùóó</text></form></note>
  </entry>
  <entry id="pùsàá_2713">
    <lexical-unit><form lang="kqs"><text>pùsàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùsàá_2713_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>produire de nouveaux fruits (ananas, bananier)</text></gloss>
      <gloss lang="en"><text>produce new fruit (pineapple, banana)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùsàá</text></form></note>
  </entry>
  <entry id="pùsìèí_2714">
    <lexical-unit><form lang="kqs"><text>pùsìèí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùsɔ́ŋ</text></form></field>
    <sense id="pùsìèí_2714_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fesses, anus (vulgaire)</text></gloss>
      <gloss lang="en"><text>buttocks, anus (vulgar)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.2 Torso"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùsìèí</text></form></note>
  </entry>
  <entry id="puuloo_2715">
    <lexical-unit><form lang="kqs"><text>puuloo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puulu</text></form></variant>
    <sense id="puuloo_2715_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>terre, sol ; poussière ; boue, argile</text></gloss>
      <gloss lang="en"><text>earth, soil, ground; dust ; dust; mud, clay</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mud, dirt, stoneless soil; mortar</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first GEN.2.7; Keita 1979, p. 155: Puuluo; Childs 2000, p. 313: pùùlòó</text></form></note>
    <note><form lang="fr"><text>Keita écrit Puuluo ; la Bible puuloo.</text></form></note>
  </entry>
  <entry id="pùùlù-_2716">
    <lexical-unit><form lang="kqs"><text>pùùlù-</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="pùùlù-_2716_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>étranger, européen, occidental, moderne ; officiel</text></gloss>
      <gloss lang="en"><text>foreign, European, Western, modern; governmental</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 313: pùùlù-</text></form></note>
  </entry>
  <entry id="pùùlùéí_2717">
    <lexical-unit><form lang="kqs"><text>pùùlùéí</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="southern"/>
    <sense id="pùùlùéí_2717_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue européenne (non locale)</text></gloss>
      <gloss lang="en"><text>European or non-local language</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùéí</text></form></note>
  </entry>
  <entry id="pùùlùléŋ_2718">
    <lexical-unit><form lang="kqs"><text>pùùlùléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="pùùlùléŋ_2718_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mode de vie occidental, « civilisation »</text></gloss>
      <gloss lang="en"><text>Western way of life, 'civilization'</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3.9 Culture"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùléŋ</text></form></note>
  </entry>
  <entry id="puulun_2719">
    <lexical-unit><form lang="kqs"><text>puulun</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="puulun_2719_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>faire cas de, compter sur, s'attacher à ; tenir compte de (fautes)</text></gloss>
      <gloss lang="en"><text>set one's mind on, rely on; take note of, keep account of (sins)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>pay attention to, mark, mind</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first DEU.24.14; Childs 2000, p. 313: pùùlɔ̌ŋndó</text></form></note>
    <note><form lang="fr"><text>Taa puulun pɛ tɛɛmbuula naalan « si tu tenais compte de nos fautes » (PSA.130.3) ; má puulun naŋɔɔ nɔmndo « tu t'es fiée à ta beauté » (EZK.16.15) ; Puulùn ɲɛdiaa ndɔ kɛndɔɔ le « ne convoite pas ses mets délicats » (PRO.23.3). Sens à préciser.</text></form></note>
  </entry>
  <entry id="pùùlùnɔ̀ɔ́_2720">
    <lexical-unit><form lang="kqs"><text>pùùlùnɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùùlùá</text></form></field>
    <sense id="pùùlùnɔ̀ɔ́_2720_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>Européen, Blanc ; personne à la manière occidentale</text></gloss>
      <gloss lang="en"><text>European, white person; someone following Western ways</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùlùnɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="puundulen_2721">
    <lexical-unit><form lang="kqs"><text>puundulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>puundun</text></form></field>
    <variant><form lang="kqs"><text>puundule</text></form></variant>
    <sense id="puundulen_2721_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racine</text></gloss>
      <gloss lang="en"><text>root</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 140: Puundulen; Childs 2000, p. 314: pùùndúléŋ</text></form></note>
    <note><form lang="fr"><text>La Bible a la forme radicale puundule (ISA.53.2) et le pluriel puundun (2KI.19.30).</text></form></note>
  </entry>
  <entry id="puusiaa_2722">
    <lexical-unit><form lang="kqs"><text>puusiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puusian</text></form></variant>
    <sense id="puusiaa_2722_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>disperser, déranger</text></gloss>
      <gloss lang="en"><text>scatter, disperse</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.5 Arrange"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>scatter, spread about</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 85 occurrences, first GEN.11.8; Keita 1979, p. 113: Puusiaa; Childs 2000, p. 314: pùùsìá</text></form></note>
    <note><form lang="fr"><text>Moyen puusian « se disperser » (1SA 13,8).</text></form></note>
  </entry>
  <entry id="puusianɔɔ_2723">
    <lexical-unit><form lang="kqs"><text>puusianɔɔ</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="check"/>
    <sense id="puusianɔɔ_2723_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>réactionnaire (Keita)</text></gloss>
      <gloss lang="en"><text>reactionary (Keita)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Puusianöö</text></form></note>
    <note><form lang="fr"><text>La Bible a puusiaa « disperser » (Gn 11,8) ; le sens exact du dérivé est à confirmer.</text></form></note>
  </entry>
  <entry id="pùùsóó_2724">
    <lexical-unit><form lang="kqs"><text>pùùsóó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>pùùsúláŋ</text></form></field>
    <sense id="pùùsóó_2724_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>termitière</text></gloss>
      <gloss lang="en"><text>termite hill</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.5 Animal home"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùsóó</text></form></note>
  </entry>
  <entry id="puuvo_2725">
    <lexical-unit><form lang="kqs"><text>puuvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>puu</text></form></variant>
    <variant><form lang="kqs"><text>puunin</text></form></variant>
    <variant><form lang="kqs"><text>puunun</text></form></variant>
    <variant><form lang="kqs"><text>puununnin</text></form></variant>
    <sense id="puuvo_2725_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>prendre, enlever, arracher ; reprendre, récupérer</text></gloss>
      <gloss lang="en"><text>take, take away, snatch; take back, recover</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.3 Get"/>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>take away, seize, snatch; also become engaged to, hire</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first ISA.10.2; Childs 2000, p. 315: pùùwó</text></form></note>
    <note><form lang="fr"><text>Mó puu vɛlɛ Lɔt « il reprit aussi Lot » (Gn 14,16) ; buɛyaa Abimelɛk-a ndáà puu a paa-kala « dont les serviteurs d'Abimélek s'étaient emparés » (Gn 21,25) ; puunun « s'emparer, être enlevé ».</text></form></note>
  </entry>
  <entry id="pùùwó_2726">
    <lexical-unit><form lang="kqs"><text>pùùwó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="pùùwó_2726_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entraide (échange de travail)</text></gloss>
      <gloss lang="en"><text>assistance in a work-exchange agreement</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
      <trait name="semantic-domain-ddp4" value="4.2 Social activity"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 314: pùùwó</text></form></note>
  </entry>
  <entry id="púúwɔ́ɔ́_2727">
    <lexical-unit><form lang="kqs"><text>púúwɔ́ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="púúwɔ́ɔ́_2727_s1">
      <grammatical-info value="Noun"/>
