    <trait name="status" value="attested"/>
    <sense id="lacio_1966_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>avenir, ce qui est devant (siɔdii lacio « les jours à venir »)</text></gloss>
      <gloss lang="en"><text>the future, what lies ahead (siɔdii lacio, days to come)</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>the front; tomorrow</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 30 occurrences, first PSA.78.55; Childs 2000, p. 221: làcìóó</text></form></note>
    <note><form lang="fr"><text>De laci « devant ». o siɔdii lacio nin « dans les jours à venir » (ISA.27.6).</text></form></note>
  </entry>
