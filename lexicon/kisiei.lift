    <sense id="kpua_1958_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>bondir et saisir ; terrasser</text></gloss>
      <gloss lang="en"><text>pounce and seize; throw down</text></gloss>
