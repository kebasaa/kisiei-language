      <gloss lang="en"><text>sacrifice, offering</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>sacrifice; blessing; charm, talisman</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 307 occurrences, first GEN.4.3; Childs 2000, p. 319: sálàá</text></form></note>
    <note><form lang="fr"><text>vana-solia-lasálàá « prêtre » ; fonda-loamaa-lasálàá « autel ».</text></form></note>
  </entry>
