    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: koriyolen</text></form></note>
  </entry>
  <entry id="kòlìyòmbòó_2193">
    <lexical-unit><form lang="kqs"><text>kòlìyòmbòó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kòlìyòmbùéí</text></form></field>
    <sense id="kòlìyòmbòó_2193_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (à ne pas toucher)</text></gloss>
      <gloss lang="en"><text>a species of tree (not to be touched)</text></gloss>
