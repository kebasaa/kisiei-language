    </sense>
    <note type="source"><form lang="en"><text>BKG: 54 occurrences, first GEN.18.6</text></form></note>
  </entry>
  <entry id="kiltan_2119">
    <lexical-unit><form lang="kqs"><text>kiltan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kilta</text></form></variant>
    <sense id="kiltan_2119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>course ; (a kiltan) en courant</text></gloss>
      <gloss lang="en"><text>running; (a kiltan) running</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.2.1 Manner of movement"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 134 occurrences, first GEN.18.2; Paulme 1964, p. 45: kita; Lexique kissi–français, p. 24: kiltan; Childs 2000, p. 166: kìltáŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 45 : kita « course ».</text></form></note>
  </entry>
  <entry id="kimballo_2120">
    <lexical-unit><form lang="kqs"><text>kimballo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kimballo_2120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racines sauvages épineuses (dont le manioc sauvage)</text></gloss>
      <gloss lang="en"><text>thorny wild roots (including wild cassava)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="1.5.3 Grass, herb, vine"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 45: kimballo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 45 : « certaines racines sauvages garnies d'épines, dont le manioc sauvage ».</text></form></note>
  </entry>
  <entry id="kimbullo_2121">
    <lexical-unit><form lang="kqs"><text>kimbullo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kimbullo_2121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>racines (élément du suo)</text></gloss>
      <gloss lang="en"><text>roots (ingredient of the suo charm)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 45: kimbullo ou simbullo</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 45 : élément du suo pour le wanayawa de Kongole. Variante simbullo.</text></form></note>
  </entry>
  <entry id="kinda_2122">
    <lexical-unit><form lang="kqs"><text>kinda</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindaa</text></form></variant>
    <sense id="kinda_2122_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fermer</text></gloss>
      <gloss lang="en"><text>shut, close</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 64 occurrences, first GEN.7.16; Paulme 1964, p. 45: kinda; Lexique kissi–français, p. 24: kindaa/ kinda</text></form></note>
    <note><form lang="fr"><text>Paulme : i kinda duo « je ferme la porte ».</text></form></note>
  </entry>
  <entry id="kìndàá_2123">
    <lexical-unit><form lang="kqs"><text>kìndàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="kìndàá_2123_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>excréments ; fibre du manioc</text></gloss>
