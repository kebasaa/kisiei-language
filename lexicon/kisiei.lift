    <sense id="dandaa dɔwɔɔ_726_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>soigner</text></gloss>
      <gloss lang="en"><text>treat, nurse (a sick person)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.7 Treat disease"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 13: dandaa dɔwɔɔ</text></form></note>
    <note><form lang="fr"><text>Radical dau danda (p. 13).</text></form></note>
