    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>hemndan</text></form></field>
    <sense id="hemndo_363_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>gourde, outre</text></gloss>
      <gloss lang="en"><text>gourd, skin bottle</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>gourd for keeping oil or wine</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first JDG.6.19; Keita 1979, p. 139: Hemndo; Childs 2000, p. 120: hěmndó</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, mɔiyan hemndo « une outre de vin ».</text></form></note>
  </entry>
  <entry id="hialu_364">
