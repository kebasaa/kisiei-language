  <entry id="kiolɔɔ_1380">
    <lexical-unit><form lang="kqs"><text>kiolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiolu</text></form></variant>
    <variant><form lang="kqs"><text>kelu</text></form></variant>
    <variant><form lang="kqs"><text>kialu</text></form></variant>
    <variant><form lang="kqs"><text>kilu</text></form></variant>
    <variant><form lang="kqs"><text>kialunin</text></form></variant>
    <sense id="kiolɔɔ_1380_s1">
