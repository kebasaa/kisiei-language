  <entry id="tase_3293">
    <lexical-unit><form lang="kqs"><text>tase</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tasela</text></form></variant>
    <variant><form lang="kqs"><text>taselan</text></form></variant>
    <sense id="tase_3293_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>premier, aîné ; (pl.) premiers, anciens, précédents</text></gloss>
      <gloss lang="en"><text>first, firstborn, elder; (pl.) first, former</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.1 Number"/>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>first, at first, originally</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 132 occurrences, first GEN.19.34; Childs 2000, p. 350: tàsé</text></form></note>
    <note><form lang="fr"><text>Forme d'accord de tasoo « premier ». O tase o velu-o « le premier qui naquit » (GEN.25.25) ; cua ndɔ tase « sa fille aînée » (GEN.19.34) ; powta yɛ́ndɛ́la tasela « les premières tables » (DEU.10.2) ; vɔsila taselan « les premières années » (GEN.41.31).</text></form></note>
  </entry>
