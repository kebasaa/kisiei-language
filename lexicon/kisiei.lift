  <entry id="paŋ_2996">
    <lexical-unit><form lang="kqs"><text>paŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="paŋ_2996_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>fade, sans goût (sel)</text></gloss>
      <gloss lang="en"><text>tasteless, insipid (salt)</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.3.3 Taste"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first LUK.14.34; Childs 2000, p. 288: pâŋ</text></form></note>
    <note><form lang="fr"><text>te i muungu pɛ paŋ « s'il devient fade » (LUK.14.34).</text></form></note>
  </entry>
  <entry id="paŋalaa_2997">
    <lexical-unit><form lang="kqs"><text>paŋalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>paŋala</text></form></variant>
    <sense id="paŋalaa_2997_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>jalousie, envie ; zèle</text></gloss>
      <gloss lang="en"><text>jealousy, envy; zeal</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) be jealous, envy</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 51 occurrences, first GEN.26.14; Lexique kissi–français, p. 41: paŋalaa; Childs 2000, p. 288: pàŋàlàá</text></form></note>
  </entry>
  <entry id="paŋalɛiyo_2998">
    <lexical-unit><form lang="kqs"><text>paŋalɛiyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="paŋalɛiyo_2998_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>premier</text></gloss>
      <gloss lang="en"><text>first</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 41: paŋalɛiyo</text></form></note>
    <note><form lang="fr"><text>Lexique, p. 41 : paŋalɛiyo et paŋalaa « premier » ; paŋalaa est dans la Bible au sens de « jalousie ».</text></form></note>
  </entry>
  <entry id="páŋú_2999">
    <lexical-unit><form lang="kqs"><text>páŋú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="páŋú_2999_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>tout, entièrement</text></gloss>
      <gloss lang="en"><text>all, completely</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: páŋú</text></form></note>
  </entry>
  <entry id="pàɲàá_3000">
