  </entry>
  <entry id="koondo_1459">
    <lexical-unit><form lang="kqs"><text>koondo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="koondo_1459_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>juin</text></gloss>
