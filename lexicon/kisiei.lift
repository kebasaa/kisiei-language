    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>tɛnda</text></form></variant>
    <variant><form lang="kqs"><text>tɛndanin</text></form></variant>
    <sense id="tɛndaa_1749_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>fendre, diviser ; (seilen) témoigner</text></gloss>
