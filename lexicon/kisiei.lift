      <gloss lang="fr"><text>auparavant, autrefois, d'abord</text></gloss>
      <gloss lang="en"><text>before, formerly, at first</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 245 occurrences, first GEN.13.3</text></form></note>
  </entry>
  <entry id="paangei_2507">
    <lexical-unit><form lang="kqs"><text>paangei</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="attested"/>
