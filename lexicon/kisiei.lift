    <trait name="status" value="southern"/>
    <sense id="sèmɔ̀ɔ́_3480_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (bois à planches)</text></gloss>
      <gloss lang="en"><text>a tree species (gives planks)</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 325: sèmɔ̀ɔ́</text></form></note>
  </entry>
