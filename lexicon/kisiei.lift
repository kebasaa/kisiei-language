    <trait name="status" value="southern"/>
    <sense id="yɛ́íyó_6336_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent, membre de la famille</text></gloss>
      <gloss lang="en"><text>relative</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 404: yɛ́íyó</text></form></note>
  </entry>
  <entry id="yɛ̀kàyɛ̀kàá_6337">
    <lexical-unit><form lang="kqs"><text>yɛ̀kàyɛ̀kàá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yɛ̀kàyɛ̀kàá_6337_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>rincer</text></gloss>
      <gloss lang="en"><text>rinse</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.6 Cleaning"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 404: yɛ̀kàyɛ̀kàá</text></form></note>
  </entry>
  <entry id="yɛ̀kpɔ̀ɔ́_6338">
    <lexical-unit><form lang="kqs"><text>yɛ̀kpɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>yɛ̀kpéláŋ</text></form></field>
    <sense id="yɛ̀kpɔ̀ɔ́_6338_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>abri (p. ex. de gardien chassant les oiseaux)</text></gloss>
      <gloss lang="en"><text>shelter (e.g. a bird-scarer's platform)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
      <trait name="semantic-domain-ddp4" value="6.2.4 Tend a field"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 404: yɛ̀kpɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="yɛ̀kɛ̀yɛ̀ŋǎŋndó_6339">
    <lexical-unit><form lang="kqs"><text>yɛ̀kɛ̀yɛ̀ŋǎŋndó</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yɛ̀kɛ̀yɛ̀ŋǎŋndó_6339_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>se secouer ; vanner (le riz)</text></gloss>
      <gloss lang="en"><text>shake (oneself); winnow (rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.2.6 Process harvest"/>
      <trait name="semantic-domain-ddp4" value="7.3 Move something"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 404: yɛ̀kɛ̀yɛ̀ŋǎŋndó</text></form></note>
  </entry>
  <entry id="yɛlaa_6340">
    <lexical-unit><form lang="kqs"><text>yɛlaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yɛla</text></form></variant>
    <variant><form lang="kqs"><text>yɛraa</text></form></variant>
    <variant><form lang="kqs"><text>yɛra</text></form></variant>
    <sense id="yɛlaa_6340_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>multiplier, agrandir</text></gloss>
      <gloss lang="en"><text>multiply, enlarge</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.4 More"/>
      <trait name="semantic-domain-ddp4" value="8.2 Big"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 65: yɛraa/ yɛra</text></form></note>
    <note><form lang="fr"><text>Le Lexique écrit r ; la Bible écrit toujours l.</text></form></note>
  </entry>
  <entry id="yɛlen_6341">
    <lexical-unit><form lang="kqs"><text>yɛlen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <sense id="yɛlen_6341_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>haine, animosité (tol X yɛlen « haïr X » ; yɛlen tollo « persécution, être persécuté »)</text></gloss>
      <gloss lang="en"><text>hatred, animosity (tol X yɛlen 'hate X'; yɛlen tollo 'persecution, be persecuted')</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>hatred, bad feelings; (yɛ̀lɛ̀-tùlààléŋ) persecution</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 48 occurrences, first GEN.26.27; Lexique kissi–français, p. 65: yɛlen tolinndo; Childs 2000, p. 404: yɛ̀léŋ</text></form></note>
    <note><form lang="fr"><text>O co niaa le tol-la yɛlen « vous me haïssiez » (GEN.26.27) ; vanaa co yɛlen tollo « ceux qui sont persécutés » (MAT.5.10) ; vanaa co ya yɛlen tollo-a « mes persécuteurs » (PSA.7.2). Lexique kissi–français, p. 65 : yɛlen tolinndo « maltraiter, persécuter ».</text></form></note>
  </entry>
  <entry id="yɛ́lɔ̀ɔ́_6342">
    <lexical-unit><form lang="kqs"><text>yɛ́lɔ̀ɔ́</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛ́lɔ̀ɔ́_6342_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vipère, serpent venimeux ; serpent cracheur</text></gloss>
      <gloss lang="en"><text>viper, venomous snake; spitting cobra</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(spitting) cobra</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first JOB.20.16; Paulme 1964, p. 126: yɛlo, pl. yɛlsa; Lexique kissi–français, p. 65: yɛlɔɔ; Childs 2000, p. 404: yɛ̀lɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>diɛɛmule yɛ́lɔ̀ɔ́ « la langue de la vipère » (JOB.20.16). Lexique kissi–français, p. 65 : « un serpent noir qui fait jaillir le poison pour aveugler ».</text></form></note>
  </entry>
  <entry id="yɛlɛmaa_6343">
    <lexical-unit><form lang="kqs"><text>yɛlɛmaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>yɛlɛma</text></form></variant>
    <variant><form lang="kqs"><text>yɛlɛman</text></form></variant>
    <variant><form lang="kqs"><text>yɛlɛmanin</text></form></variant>
    <sense id="yɛlɛmaa_6343_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer, se changer ; se détourner</text></gloss>
      <gloss lang="en"><text>change; turn away</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>clear one's throat, groan; reduce the size of (clothing); nearly finish (work)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first PRO.29.1; Childs 2000, p. 404: yèlèmàá</text></form></note>
    <note><form lang="fr"><text>yɛlɛman « se changer » (MAL.3.6).</text></form></note>
  </entry>
  <entry id="yɛlɛmiaa_6344">
    <lexical-unit><form lang="kqs"><text>yɛlɛmiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɛlɛmiaa_6344_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>changer (qqch), modifier, altérer</text></gloss>
      <gloss lang="en"><text>change (something), alter</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3 Quality"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>plural of 'clear one's throat; reduce the size of'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first GEN.31.7; Childs 2000, p. 404: yèlèmìá</text></form></note>
    <note><form lang="fr"><text>Pluriel de yɛlɛmaa.</text></form></note>
  </entry>
  <entry id="yɛ́lɛ́ŋ_6345">
    <lexical-unit><form lang="kqs"><text>yɛ́lɛ́ŋ</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="yɛ́lɛ́ŋ_6345_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>lentement, avec précaution, doucement</text></gloss>
      <gloss lang="en"><text>slowly, cautiously, gently</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="8.4.8 Speed"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 404: yɛ́lɛ́ŋ</text></form></note>
  </entry>
  <entry id="yɛmbɛi_6346">
    <lexical-unit><form lang="kqs"><text>yɛmbɛi</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>yɛmbɛn</text></form></field>
    <sense id="yɛmbɛi_6346_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ongle, griffe</text></gloss>
      <gloss lang="en"><text>nail, claw</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.3 Limb"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 133: Yèmbèi; Paulme 1964, p. 126: yembe ẅisyo, pl. yembɔ̃; Terminologie (langue), n° 300: Yèmbèi; Childs 2000, p. 404: yɛ́mbɛ̀í</text></form></note>
    <note><form lang="fr"><text>Pluriel yɛmbɛn attesté (Dt 21,12 ; 1S 17,37). Paulme 1964, p. 126 : yembe ẅisyo « griffe d'un animal », yembe « ongle humain ». Académie des langues (terminologie, langue n° 300) : « parenthèse » (signe).</text></form></note>
  </entry>
  <entry id="yɛmian_6347">
    <lexical-unit><form lang="kqs"><text>yɛmian</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="yɛmian_6347_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>totem</text></gloss>
      <gloss lang="en"><text>totem</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 127: yɛmyã /S./</text></form></note>
    <note><form lang="fr"><text>Paulme marque le mot « Sud » ; yɛmyano « mon totem est ».</text></form></note>
  </entry>
  <entry id="yɛ́ndɔ̀ɔ́_6348">
    <lexical-unit><form lang="kqs"><text>yɛ́ndɔ̀ɔ́</text></form></lexical-unit>
