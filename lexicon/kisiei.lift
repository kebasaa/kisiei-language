    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 398: yàndìá</text></form></note>
  </entry>
  <entry id="yàndúléŋ_3808">
    <lexical-unit><form lang="kqs"><text>yàndúléŋ</text></form></lexical-unit>
    <trait name="noun-class" value="le"/>
    <trait name="status" value="southern"/>
    <sense id="yàndúléŋ_3808_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>détente (d'un fusil)</text></gloss>
      <gloss lang="en"><text>trigger (of a gun)</text></gloss>
