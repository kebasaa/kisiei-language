      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 41: kariñã, karignan</text></form></note>
  </entry>
  <entry id="kallante_1913">
