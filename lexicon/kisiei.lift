    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 318: sàkàlàá</text></form></note>
  </entry>
  <entry id="sàkàlàpíóó_3366">
    <lexical-unit><form lang="kqs"><text>sàkàlàpíóó</text></form></lexical-unit>
