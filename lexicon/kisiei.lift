      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>excréments ; fibre du manioc</text></gloss>
      <gloss lang="en"><text>excrement; stringy fibre in cassava</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 166: kìndàá</text></form></note>
  </entry>
  <entry id="kindi_1604">
    <lexical-unit><form lang="kqs"><text>kindi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindio</text></form></variant>
    <sense id="kindi_1604_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>endurcir, rendre dur ; fortifier ; faire sécher (le riz) pour le durcir</text></gloss>
      <gloss lang="en"><text>harden; make strong; dry (rice) to harden it</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
      <trait name="semantic-domain-ddp4" value="3.1.2 Mental state"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>complicate, make difficult; roast rice to dry it</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 63 occurrences, first EXO.7.3; Lexique kissi–français, p. 24: kindio/ kindi; Childs 2000, p. 167: kìndìó</text></form></note>
  </entry>
  <entry id="kindilaa_1605">
    <lexical-unit><form lang="kqs"><text>kindilaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindila</text></form></variant>
    <sense id="kindilaa_1605_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>peser sur, accabler</text></gloss>
      <gloss lang="en"><text>weigh on, burden</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
      <trait name="semantic-domain-ddp4" value="7.3.1 Carry"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>squeeze, press against</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 15 occurrences, first GEN.31.39; Lexique kissi–français, p. 24: kindilaa; Childs 2000, p. 167: kìndìlàá</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 24 : kindilaa « la pression ».</text></form></note>
  </entry>
  <entry id="kindin_1606">
    <lexical-unit><form lang="kqs"><text>kindin</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kindin_1606_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'efforcer, s'appliquer ; s'attacher à</text></gloss>
      <gloss lang="en"><text>strive, make an effort; be attached to</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3 Want"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 75 occurrences, first GEN.34.3</text></form></note>
    <note><form lang="fr"><text>Moyen de kindi.</text></form></note>
  </entry>
  <entry id="kindinndo_1607">
    <lexical-unit><form lang="kqs"><text>kindinndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindin</text></form></variant>
    <variant><form lang="kqs"><text>kindinnin</text></form></variant>
    <sense id="kindinndo_1607_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'efforcer</text></gloss>
      <gloss lang="en"><text>strive, make an effort</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.1 Work"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>try</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 31 occurrences, first RUT.3; Keita 1979, p. 110: Kindinndo; Lexique kissi–français, p. 24: kindinndo/ kindin; Childs 2000, p. 167: kìndìó</text></form></note>
    <note><form lang="fr"><text>Childs donne la base kìndìó « essayer » ; kindinndo en est le moyen.</text></form></note>
  </entry>
  <entry id="kindu_1608">
    <lexical-unit><form lang="kqs"><text>kindu</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kindu_1608_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>fort, solide ; (nég.) faible</text></gloss>
      <gloss lang="en"><text>strong, firm; (neg.) weak</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.4.1 Strong"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be hard; be ripe</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.33.13; Lexique kissi–français, p. 24: kindu re; Childs 2000, p. 167: kìòndòó</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 24 : kindu re « pas difficile, pas dur ».</text></form></note>
  </entry>
  <entry id="kindɔɔ_1609">
    <lexical-unit><form lang="kqs"><text>kindɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kindu</text></form></variant>
    <sense id="kindɔɔ_1609_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tendre, bander (l'arc) ; forcer</text></gloss>
      <gloss lang="en"><text>stretch, draw (a bow); force</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.4.1 Hunt"/>
      <trait name="semantic-domain-ddp4" value="7.3.4 Handle something"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>stretch out (a rope), strain, make an effort</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first 2SA.22.35; Lexique kissi–français, p. 24: kindɔɔ/ kindu; Childs 2000, p. 168: kìndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>vanaa kɔlvesɛiya co kpaasiaala ndalan kindɔɔ « les méchants bandent leurs arcs » (PSA.11.2) ; kpaasiaa idaɲaa kindɔɔ « tendre l'arc de bronze » (PSA.18.35). Lexique kissi–français, p. 24 : « forcer, tendre ».</text></form></note>
  </entry>
  <entry id="kínɛí_1610">
    <lexical-unit><form lang="kqs"><text>kínɛí</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="kínɛí_1610_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>seulement, juste ; précisément (alors)</text></gloss>
      <gloss lang="en"><text>only, just; exactly (then)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.2 Adverbs"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 168: kínéí</text></form></note>
    <note><form lang="fr"><text>vanaa sandaa belehiɔɔlu kínɛí « seulement quarante justes » (Gn 18,29).</text></form></note>
  </entry>
  <entry id="kìó_1611">
    <lexical-unit><form lang="kqs"><text>kìó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kèláŋ</text></form></field>
    <sense id="kìó_1611_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>don, offrande ; salaire du messager</text></gloss>
      <gloss lang="en"><text>gift, offering; messenger's fee</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 169: kìó kèláŋ</text></form></note>
  </entry>
  <entry id="kiolɔɔ_1612">
    <lexical-unit><form lang="kqs"><text>kiolɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kiolu</text></form></variant>
    <variant><form lang="kqs"><text>kelu</text></form></variant>
    <variant><form lang="kqs"><text>kialu</text></form></variant>
    <variant><form lang="kqs"><text>kilu</text></form></variant>
    <variant><form lang="kqs"><text>kialunin</text></form></variant>
    <variant><form lang="kqs"><text>kial</text></form></variant>
    <sense id="kiolɔɔ_1612_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>couper ; trancher (une affaire), juger ; décider, trancher ; mordre</text></gloss>
      <gloss lang="en"><text>cut; decide (a case), judge ; decide, settle; bite</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.8.3 Cut"/>
      <trait name="semantic-domain-ddp4" value="4.7.5 Trial"/>
      <trait name="semantic-domain-ddp4" value="3.3.1 Decide, plan"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>cut, remove</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 168 occurrences, first GEN.6.13; Keita 1979, p. 116: Kiolöö; Lexique kissi–français, p. 24: kiolɔɔ/ (kial) kiolu, kelu, kialu, kilu; Childs 2000, p. 169: kìòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>kiolu / kelu yamɛi « juger » (GEN 16,5 ; 18,19) ; kilu, kilunin : radical négatif (ISA 11,3). Lexique kissi–français, p. 24 : aussi « mordre » ; radical kial.</text></form></note>
  </entry>
