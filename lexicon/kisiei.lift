      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.6 Stimulant"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 231: lìmbàwóó</text></form></note>
