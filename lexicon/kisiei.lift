    <trait name="status" value="check"/>
    <sense id="pasa_2528_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'irriter, menacer (?)</text></gloss>
      <gloss lang="en"><text>get angry, threaten (?)</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.4.2 Feel bad"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>spread one's legs; dance; bristle with vexation</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 289: pàsàá</text></form></note>
    <note><form lang="fr"><text>Un seul emploi : ndu nda saangiaa, o pasa loo « quand on le maltraitait, il ne menaçait pas » (1PE.2.23). Sens déduit du contexte et du sens « s'irriter » donné par Childs ; à confirmer.</text></form></note>
  </entry>
