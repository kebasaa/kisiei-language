    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>ɲáŋgáá</text></form></variant>
    <sense id="ɲáŋáá_4160_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>espèce d'arbre (dur à casser)</text></gloss>
      <gloss lang="en"><text>kind of tree (hard to break)</text></gloss>
