    <variant><form lang="kqs"><text>yiya</text></form></variant>
    <sense id="yiyaa_4748_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>loger, séjourner ; logement (pour un étranger) ; abriter</text></gloss>
      <gloss lang="en"><text>lodge, stay; lodging (for a stranger); shelter</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lodge</text></form></field>
