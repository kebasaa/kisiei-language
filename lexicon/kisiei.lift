    <lexical-unit><form lang="kqs"><text>bandɔcooyɛi</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="bandɔcooyɛi_125_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>stabilité</text></gloss>
      <gloss lang="en"><text>stability</text></gloss>
