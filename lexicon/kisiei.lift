  <entry id="solullo_3065">
    <lexical-unit><form lang="kqs"><text>solullo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>solul</text></form></variant>
    <variant><form lang="kqs"><text>solulnin</text></form></variant>
    <sense id="solullo_3065_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>offrir (à), présenter ; produire pour ; chanter (un chant) à</text></gloss>
      <gloss lang="en"><text>offer (to), present; bring forth for; sing (a song) to</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 134 occurrences, first GEN.8.20</text></form></note>
    <note><form lang="fr"><text>Bénéfactif de solio.</text></form></note>
  </entry>
  <entry id="solɔɔ_3066">
    <lexical-unit><form lang="kqs"><text>solɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sol</text></form></variant>
    <sense id="solɔɔ_3066_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>besoin naturel, excréments ; (sol) faire ses besoins</text></gloss>
      <gloss lang="en"><text>need to defecate, excrement; (sol) relieve oneself</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.2.8 Defecate, feces"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>defecate</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.23.14; Childs 2000, p. 338: sòlɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>te solɔɔ bii ndu pɛ, o kɔ tow soondo … o sol lenin « quand le besoin le prend, il creusera un trou … et s'y soulagera » (DEU.23.14).</text></form></note>
  </entry>
