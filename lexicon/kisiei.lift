      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fer</text></gloss>
      <gloss lang="en"><text>iron</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, iron; iron strips once used as money</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 41 occurrences, first GEN.4.22; Childs 2000, p. 48: cìlíŋndé</text></form></note>
  </entry>
  <entry id="ciliŋii_214">
    <lexical-unit><form lang="kqs"><text>ciliŋii</text></form></lexical-unit>
    <trait name="noun-class" value="i"/>
    <trait name="status" value="check"/>
    <field type="plural"><form lang="kqs"><text>ciliŋun</text></form></field>
    <sense id="ciliŋii_214_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>métal ; outil ou objet de métal ; (ciliŋun teengian) métal fondu</text></gloss>
      <gloss lang="en"><text>metal; metal tool or object; (ciliŋun teengian) molten metal</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="6.6.2 Working with minerals"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>metal, pieces of iron, esp. twisted iron strips used as (Kisi) money</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 48: cìlíŋndé</text></form></note>
    <note><form lang="fr"><text>maa ciliŋii dingɛn « comme du plomb » (Ex 15,10) ; piɔmndo a ciliŋun teengian « idole de métal fondu » (Dt 9,12).</text></form></note>
  </entry>
  <entry id="cindaa_215">
    <lexical-unit><form lang="kqs"><text>cindaa</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>cinda</text></form></variant>
    <sense id="cindaa_215_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>vie ; salut</text></gloss>
      <gloss lang="en"><text>life; salvation</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6 Life"/>
    </sense>
