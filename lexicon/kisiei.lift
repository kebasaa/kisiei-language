      <gloss lang="fr"><text>flûte</text></gloss>
      <gloss lang="en"><text>flute, pipe</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first JOB.21.12; Keita 1979, p. 163: Sènden; Childs 2000, p. 328: sɛ̀ŋndéŋ</text></form></note>
    <note><form lang="fr"><text>Keita écrit Sènden ; la Bible écrit sɛ̀ŋnden.</text></form></note>
  </entry>
  <entry id="sɛ́ŋndó_3224">
    <lexical-unit><form lang="kqs"><text>sɛ́ŋndó</text></form></lexical-unit>
