      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Sièndilen; Lexique kissi–français, p. 49: siɛndilen; Childs 2000, p. 331: sìɛ̀ndíléŋ</text></form></note>
    <note><form lang="fr"><text>Lexique kissi–français, p. 48 : aussi sɛndilen.</text></form></note>
  </entry>
  <entry id="siɛtullan_3615">
    <lexical-unit><form lang="kqs"><text>siɛtullan</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
