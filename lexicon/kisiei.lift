      <gloss lang="en"><text>lend</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>lend; borrow, take on credit</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first DEU.28.44; Childs 2000, p. 88: dɔ̀ndàá</text></form></note>
  </entry>
  <entry id="dɔndan_749">
    <lexical-unit><form lang="kqs"><text>dɔndan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="dɔndan_749_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>emprunter</text></gloss>
      <gloss lang="en"><text>borrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.8.4 Financial transaction"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first PSA.37.21; Childs 2000, p. 88: dɔ̀ndǎŋndó</text></form></note>
    <note><form lang="fr"><text>Moyen de dɔndaa « prêter ». Vana kɔlvesɛiyo dɔndan pɛ ɲɔɔ, o mingi le « le méchant emprunte et ne rend pas » (PSA.37.21).</text></form></note>
  </entry>
  <entry id="dɔ̀ndɔ̀kpééyó_750">
    <lexical-unit><form lang="kqs"><text>dɔ̀ndɔ̀kpééyó</text></form></lexical-unit>
