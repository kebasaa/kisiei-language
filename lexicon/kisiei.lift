    <variant><form lang="kqs"><text>lamban</text></form></variant>
    <variant><form lang="kqs"><text>lambaa</text></form></variant>
    <variant><form lang="kqs"><text>lambannin</text></form></variant>
    <sense id="lambanndo_1981_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>insister, persister ; répéter ; (lamban … kɔɔli) presser qqn</text></gloss>
      <gloss lang="en"><text>insist, persist; repeat; (lamban … kɔɔli) press someone</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.3.2 Request"/>
      <trait name="semantic-domain-ddp4" value="8.4.6 Aspectual time"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>continue, repeat</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first PRO.17.9; Childs 2000, p. 222: làmbǎŋndó</text></form></note>
    <note><form lang="fr"><text>lambanndo sondo « répéter une affaire » (PRO.17.9) ; I co lambanndo ɲunaa « je demande sans cesse » (ROM.1.10) ; lamban piɛiyo « pria avec insistance » (JAS.5.17).</text></form></note>
  </entry>
