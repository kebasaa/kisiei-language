      <trait name="semantic-domain-ddp4" value="5.4.3 Care for hair"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 46: sandiaa/ sandia; Childs 2000, p. 316: sààndìá</text></form></note>
    <note><form lang="fr"><text>Confirmé au Nord par le Lexique kissi–français, p. 46 (« se peigner »).</text></form></note>
  </entry>
  <entry id="sàndíkìnɔ̀ɔ́_3412">
