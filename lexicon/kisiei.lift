      <gloss lang="fr"><text>jeu de cache-cache</text></gloss>
      <gloss lang="en"><text>hide-and-seek (game)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.7 Play, fun"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 239: máámúúléŋ</text></form></note>
  </entry>
  <entry id="máándo_2571">
    <lexical-unit><form lang="kqs"><text>máándo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>máánnda</text></form></variant>
    <variant><form lang="kqs"><text>máánndan</text></form></variant>
    <sense id="máándo_2571_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>sanctuaire, lieu de culte</text></gloss>
      <gloss lang="en"><text>shrine, place of worship</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>place of worship; secret meeting place of the men in the forest</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first JDG.17.5; Keita 1979, p. 142: Maando; Lexique kissi–français, p. 36: naando; Childs 2000, p. 239: máàŋndó</text></form></note>
    <note><form lang="fr"><text>Bible : cɛi máándo « maison des idoles, sanctuaire ». Lexique kissi–français, p. 36 écrit naando « le sanctuaire » (pour maando ?).</text></form></note>
  </entry>
  <entry id="máànùú_2572">
    <lexical-unit><form lang="kqs"><text>máànùú</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <variant><form lang="kqs"><text>máánùú</text></form></variant>
    <sense id="máànùú_2572_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>désolé ! (condoléances, compassion)</text></gloss>
      <gloss lang="en"><text>sorry! (sympathy, condolence)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 239: máànùú</text></form></note>
  </entry>
