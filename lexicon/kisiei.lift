      <gloss lang="en"><text>ignorance; (o sina lepɛŋndo nin) unknowingly</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2.3 Know"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 52 occurrences, first LEV.4.2</text></form></note>
