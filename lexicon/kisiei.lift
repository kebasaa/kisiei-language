    <trait name="status" value="southern"/>
    <sense id="kpààfá-_1758_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>à claire-voie, non torchée (maison faite de seuls bâtons)</text></gloss>
      <gloss lang="en"><text>framed with sticks but not yet daubed (unfinished house)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.5.1 Building"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 201: kpààfá-</text></form></note>
