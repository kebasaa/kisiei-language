    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>ɲùmícílìá</text></form></field>
    <sense id="ɲùmícílìó_4195_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>luciole</text></gloss>
      <gloss lang="en"><text>firefly</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.6.1 Types of animals"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 282: ɲùmícílìó</text></form></note>
