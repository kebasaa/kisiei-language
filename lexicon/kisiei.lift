  <entry id="sangalaa_2883">
    <lexical-unit><form lang="kqs"><text>sangalaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sangala</text></form></variant>
    <variant><form lang="kqs"><text>sangalanin</text></form></variant>
    <sense id="sangalaa_2883_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>louer, glorifier, exalter</text></gloss>
      <gloss lang="en"><text>praise, glorify, exalt</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
      <trait name="semantic-domain-ddp4" value="3.5.1 Say"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>praise, esp. by singing; also tie logs together to make a ladder</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 47 occurrences, first JDG.16.24; Childs 2000, p. 321: sàŋàlàá</text></form></note>
    <note><form lang="fr"><text>À distinguer de sangalan « peines, souffrances » (Gn 3,16), de la famille de sangaa « peiner ».</text></form></note>
  </entry>
