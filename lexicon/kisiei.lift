      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fruit et jus de l'arbre kààŋgòó</text></gloss>
      <gloss lang="en"><text>fruit and juice of the kààŋgòó tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 142: kààŋgùáŋ kààŋgòléŋ</text></form></note>
  </entry>
  <entry id="kààɲìá_1391">
    <lexical-unit><form lang="kqs"><text>kààɲìá</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kààɲìá_1391_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>ouvrir de force (pour vérifier), écarter les branches</text></gloss>
      <gloss lang="en"><text>force open (to check), push apart branches on a path</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.6 Open"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 142: kààɲìá</text></form></note>
  </entry>
  <entry id="kabalen_1392">
