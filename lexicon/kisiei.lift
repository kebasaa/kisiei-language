    <trait name="status" value="attested"/>
    <sense id="ihini_1344_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>couché, étendu</text></gloss>
      <gloss lang="en"><text>lying down</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.1.3 Lie down"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 79 occurrences, first GEN.9.22</text></form></note>
    <note><form lang="fr"><text>Lié à hini « être couché ».</text></form></note>
