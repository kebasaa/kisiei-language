  <entry id="yùŋɔ̀ɔ́_6267">
    <lexical-unit><form lang="kqs"><text>yùŋɔ̀ɔ́</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
