    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>seile</text></form></variant>
    <sense id="seilen_3470_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>témoignage, preuve</text></gloss>
      <gloss lang="en"><text>testimony, evidence</text></gloss>
