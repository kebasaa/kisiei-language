    <variant><form lang="kqs"><text>sumialii</text></form></variant>
    <sense id="sumialle_3111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>séjour comme étranger ; (o sumialle) en étranger</text></gloss>
      <gloss lang="en"><text>sojourning as a stranger; (o sumialle) as a stranger</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
      <trait name="semantic-domain-ddp4" value="5.9 Live, stay"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 12 occurrences, first GEN.15.13</text></form></note>
    <note><form lang="fr"><text>La forme sumialii désigne l'hôte (Gn 19,8).</text></form></note>
  </entry>
  <entry id="sùmndéŋ_3112">
