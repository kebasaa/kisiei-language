    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="sààtóndóó_3357_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>troupe qui danse à la mort d'un forgeron</text></gloss>
