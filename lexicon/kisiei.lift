    <trait name="status" value="respelled"/>
    <sense id="ɲandia_5030_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>grimacer (de souffrance)</text></gloss>
      <gloss lang="en"><text>grimace (in pain)</text></gloss>
