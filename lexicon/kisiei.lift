  <entry id="faŋiaa_424">
    <lexical-unit><form lang="kqs"><text>faŋiaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="faŋiaa_424_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>enlever beaucoup</text></gloss>
      <gloss lang="en"><text>remove many</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 110: Fanhiaa</text></form></note>
    <note><form lang="fr"><text>Pluriel de faŋaa.</text></form></note>
