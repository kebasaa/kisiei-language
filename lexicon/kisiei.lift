      <trait name="semantic-domain-ddp4" value="5.2 Food"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 327: sɛ̀ìyó</text></form></note>
  </entry>
  <entry id="sɛ̀kìmɛ́íyó_3816">
