    <trait name="status" value="respelled"/>
    <field type="plural"><form lang="kqs"><text>lefua</text></form></field>
    <variant><form lang="kqs"><text>lefu</text></form></variant>
    <sense id="lefuo_712_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>parent par alliance : gendre, bru, beau-père, belle-mère</text></gloss>
      <gloss lang="en"><text>in-law: son-in-law, daughter-in-law, father-in-law, mother-in-law</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>in-law</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 134: Lefuo; Childs 2000, p. 226: lèfòó</text></form></note>
    <note><form lang="fr"><text>Forme radicale lefu attestée (Jéthro, beau-père de Moïse, Ex 3,1) ; pluriel lefua « gendres » (Gn 19,14). Keita donne aussi Nde lefu « la belle-mère ».</text></form></note>
  </entry>
