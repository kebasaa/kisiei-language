      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier à huile ; palmier</text></gloss>
      <gloss lang="en"><text>oil palm; palm tree</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 5 occurrences, first SNG.7.9; Keita 1979, p. 140: Vawvo</text></form></note>
    <note><form lang="fr"><text>Pluriel vawvan (EXO.15.27) ; vawlan désigne les palmes (LEV.23.40).</text></form></note>
  </entry>
  <entry id="vayia_1805">
    <lexical-unit><form lang="kqs"><text>vayia</text></form></lexical-unit>
