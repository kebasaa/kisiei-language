      <trait name="semantic-domain-ddp4" value="4.7.7 Punish"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 9 occurrences, first GEN.49.15</text></form></note>
    <note><form lang="fr"><text>baala lepɔtɔllo « travail forcé, corvée » (1 R 4,6).</text></form></note>
  </entry>
  <entry id="lepɛŋndo_2418">
    <lexical-unit><form lang="kqs"><text>lepɛŋndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>lepɛŋ</text></form></variant>
