    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="tɔlaadimioo_5465">
    <lexical-unit><form lang="kqs"><text>tɔlaadimioo</text></form></lexical-unit>
