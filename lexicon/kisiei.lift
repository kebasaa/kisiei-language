      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>mortier ; mortier ; meule</text></gloss>
      <gloss lang="en"><text>mortar; mortar; millstone</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.2 Pounding tool"/>
      <trait name="semantic-domain-ddp4" value="5.2.1 Food preparation"/>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
