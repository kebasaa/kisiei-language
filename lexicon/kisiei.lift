      <trait name="semantic-domain-ddp4" value="8.6.3 Side"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 194: kùmbùèí kùmbɔ̃ŋ</text></form></note>
  </entry>
  <entry id="kumbuo_1785">
    <lexical-unit><form lang="kqs"><text>kumbuo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="respelled"/>
    <sense id="kumbuo_1785_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>couvercle, bouchon</text></gloss>
      <gloss lang="en"><text>lid, stopper</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 159: Kumbuo; Childs 2000, p. 194: kùmbòó</text></form></note>
    <note><form lang="fr"><text>Même racine que le verbe kumbuu « couvrir ».</text></form></note>
  </entry>
  <entry id="kumbɔɔ_1786">
