    <sense id="yɛɛvɔɔ_4050_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>ruine, perdition (yɛɛvɔɔ dɔvɔɔ « faire périr » ; yɛɛvɔɔ dɔwnɔnndo « dépérir, périr »)</text></gloss>
      <gloss lang="en"><text>ruin, perdition (yɛɛvɔɔ dɔvɔɔ 'destroy'; yɛɛvɔɔ dɔwnɔnndo 'perish, languish')</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note><form lang="fr"><text>hoeiye va ya yɛɛvɔɔ « le froid me consumait » (GEN.31.40). Peut-être lié à yɛɛvɛ « entièrement ».</text></form></note>
  </entry>
