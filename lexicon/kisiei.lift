    <trait name="status" value="southern"/>
    <sense id="sàkàlàpíóó_3366_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>entraves (pour les mains ou les pieds)</text></gloss>
      <gloss lang="en"><text>stocks (for hands or feet)</text></gloss>
