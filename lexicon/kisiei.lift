  <entry id="sondoo_4707">
    <lexical-unit><form lang="kqs"><text>sondoo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>sondo</text></form></variant>
    <sense id="sondoo_4707_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>bouche ; entrée, porte (d'une ville)</text></gloss>
      <gloss lang="en"><text>mouth; entrance, gate</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>mouth; opening, hole</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 252 occurrences, first GEN.3.24; Keita 1979, p. 132: Sondoo; Paulme 1964, p. 95 (G): sɔndo, pl. sɔndorã; Lexique kissi–français, p. 51: sondoo; Childs 2000, p. 338: sòndòó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 95 : sɔndo « bouche » /G./ ; sɔndo, sundu « trou » (ɔ dyɛlu sunduni « il est tombé dans un trou ») ; cf. soondo « trou ».</text></form></note>
  </entry>
  <entry id="sondovoaa_4708">
