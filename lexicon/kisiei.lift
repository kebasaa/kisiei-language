  </entry>
  <entry id="diomtuulaa_1105">
    <lexical-unit><form lang="kqs"><text>diomtuulaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diomtuulaa_1105_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>onomatopée</text></gloss>
      <gloss lang="en"><text>onomatopoeia</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 290: Diomtuulaa</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="diomtuuo_1106">
    <lexical-unit><form lang="kqs"><text>diomtuuo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diomtuuo_1106_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>comparatif</text></gloss>
      <gloss lang="en"><text>comparative</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.5.3 Language"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (langue), n° 75: Diomtuuo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Cf. tuuo « comparaison ».</text></form></note>
  </entry>
  <entry id="diondɔɔ_1107">
    <lexical-unit><form lang="kqs"><text>diondɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diandu</text></form></variant>
    <variant><form lang="kqs"><text>diandunin</text></form></variant>
    <variant><form lang="kqs"><text>diondu</text></form></variant>
    <sense id="diondɔɔ_1107_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>être pur, devenir propre ; briller, être blanc ; (nom) éclat, blancheur, gloire</text></gloss>
      <gloss lang="en"><text>be clean, become pure; shine, be white; (noun) brightness, whiteness, glory</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
      <trait name="semantic-domain-ddp4" value="5.6.1 Clean, dirty"/>
      <trait name="semantic-domain-ddp4" value="4.5.6 Status"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be clean, shine, be white; fade (Childs lists dendu, diandu, dindu as forms)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 60 occurrences, first GEN.1.16; Paulme 1964, p. 18: dɛndu; Terminologie (arts), n° 86: Diondöö; Childs 2000, p. 83: dìòndɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Nom verbal : sina diondɔɔ ndɔɔ « connaître sa gloire » (Lv 10,3) ; hiow diondɔɔ « plus blanc » (Gn 49,12). diandu « se purifier » (Esd 6,20). Cf. diandaa « saint, pur ». Paulme 1964, p. 18 : dɛndu « être propre » (la dɛndu « soyez propres ») ; madɛndo « propreté ». Académie des langues (terminologie, arts n° 86) : « décoloration ».</text></form></note>
  </entry>
  <entry id="dioo_1108">
    <lexical-unit><form lang="kqs"><text>dioo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dio</text></form></variant>
    <variant><form lang="kqs"><text>de</text></form></variant>
    <variant><form lang="kqs"><text>dia</text></form></variant>
    <variant><form lang="kqs"><text>di</text></form></variant>
    <variant><form lang="kqs"><text>dianin</text></form></variant>
    <variant><form lang="kqs"><text>dinin</text></form></variant>
    <variant><form lang="kqs"><text>doo</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <sense id="dioo_1108_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>manger</text></gloss>
      <gloss lang="en"><text>eat</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.2.2 Eat"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>eat, consume, use up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 452 occurrences, first GEN.2.9; Keita 1979, p. 116: Dioo; Paulme 1964, p. 22: du; Lexique kissi–français, p. 13: dioo/ dio, de, dia, di; Childs 2000, p. 82: dìó</text></form></note>
    <note><form lang="fr"><text>di, dinin : radical négatif. Lexique kissi–français, p. 13 : radicaux dio, de, dia, di, da. Paulme 1964, p. 22 : du, duo « manger ; nourriture » (du mumu o « mange ce riz ») ; rattachement à confirmer.</text></form></note>
  </entry>
  <entry id="diuvaa_1109">
    <lexical-unit><form lang="kqs"><text>diuvaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diuvaa_1109_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer, massacrer (vanaa diuvaa n'vannda « les meurtriers »)</text></gloss>
      <gloss lang="en"><text>kill, slaughter (vanaa diuvaa n'vannda 'murderers')</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first PSA.5.7</text></form></note>
    <note><form lang="fr"><text>Sans doute dérivé (pluriel) de dii « tuer ».</text></form></note>
  </entry>
  <entry id="diuvan_1110">
    <lexical-unit><form lang="kqs"><text>diuvan</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diuvanndo</text></form></variant>
    <sense id="diuvan_1110_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>s'entretuer</text></gloss>
      <gloss lang="en"><text>kill one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 4 occurrences, first JDG.7.22</text></form></note>
    <note><form lang="fr"><text>Réciproque de diuvaa.</text></form></note>
  </entry>
  <entry id="diuvvo_1111">
    <lexical-unit><form lang="kqs"><text>diuvvo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diuvvo_1111_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>extermination</text></gloss>
      <gloss lang="en"><text>extermination</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
      <trait name="semantic-domain-ddp4" value="7.9.3 Destroy"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 303: Diuvvo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="diuvɔɔ peengoo_1112">
    <lexical-unit><form lang="kqs"><text>diuvɔɔ peengoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diuvɔɔ peengoo_1112_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>rose</text></gloss>
      <gloss lang="en"><text>pink</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.3 Light"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (arts), n° 250: Diuvöö peengoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="diuvɛi_1113">
    <lexical-unit><form lang="kqs"><text>diuvɛi</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diuvɛi_1113_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>mûr (fruit) ; mûrir</text></gloss>
      <gloss lang="en"><text>ripe (fruit); ripen</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.6 Growth of plants"/>
      <trait name="semantic-domain-ddp4" value="5.2.3 Types of food"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be red (yellow), be ripe; also temper iron, be drunk</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first AMO.8.1; Paulme 1964, p. 19: diwo; Lexique kissi–français, p. 13: divɔɔ/ diw; Childs 2000, p. 85: dìùwɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>yɔmii koamɛi diuvɛi « des fruits mûrs » (AMO.8.1-2). Le Lexique kissi–français, p. 13, donne le verbe divɔɔ/ diw « mûr ; mûrir ». Paulme 1964, p. 19 : diwo « mûrir » (malo ndiwu « le riz a mûri ») ; p. 18 : dɛu « mûr » (tyaleny le dɛu « la papaye est mûre »).</text></form></note>
  </entry>
  <entry id="diwvo_1114">
    <lexical-unit><form lang="kqs"><text>diwvo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diw</text></form></variant>
    <variant><form lang="kqs"><text>diwnin</text></form></variant>
    <sense id="diwvo_1114_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer (en nombre), massacrer</text></gloss>
      <gloss lang="en"><text>kill (many), slaughter</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 136 occurrences, first EXO.5.21; Terminologie (histoire), n° 422: Diwvo</text></form></note>
    <note><form lang="fr"><text>diw s'emploie surtout pour plusieurs victimes ; voir dii « tuer ».</text></form></note>
  </entry>
  <entry id="diyo_1115">
    <lexical-unit><form lang="kqs"><text>diyo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diyo_1115_s1">
      <grammatical-info value="Interjection"/>
      <gloss lang="fr"><text>au revoir</text></gloss>
      <gloss lang="en"><text>goodbye</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.7 Interjections"/>
      <trait name="semantic-domain-ddp4" value="4.3.7 Polite"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: diyo</text></form></note>
  </entry>
  <entry id="diyɔɔ_1116">
    <lexical-unit><form lang="kqs"><text>diyɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dii</text></form></variant>
    <sense id="diyɔɔ_1116_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>tuer</text></gloss>
      <gloss lang="en"><text>kill</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 204 occurrences, first GEN.25.32; Keita 1979, p. 110: Diyöö; Lexique kissi–français, p. 13: diyɔɔ/ dii; Childs 2000, p. 85: dìyɔ̀ɔ́</text></form></note>
  </entry>
  <entry id="diyɔɔ koya_1117">
    <lexical-unit><form lang="kqs"><text>diyɔɔ koya</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="diyɔɔ koya_1117_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
      <trait name="semantic-domain-ddp4" value="2.6.6 Die"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 148: Diyöö koya; Lexique kissi–français, p. 13: diyɔɔ koya</text></form></note>
    <note><form lang="fr"><text>diyɔɔ « fait de tuer » est attesté ; koya n'est pas dans la Bible.</text></form></note>
  </entry>
  <entry id="diyɔɔ kpudu_1118">
    <lexical-unit><form lang="kqs"><text>diyɔɔ kpudu</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diyɔɔ kpudu_1118_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mettre à sac</text></gloss>
      <gloss lang="en"><text>sack, plunder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.3 War"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 427: Diyöö kpudu</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="diyɔɔkoyaa_1119">
    <lexical-unit><form lang="kqs"><text>diyɔɔkoyaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diyɔɔkoyaa_1119_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>assassinat</text></gloss>
      <gloss lang="en"><text>murder</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8.2 Fight"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 156: Diyöökoyaa; Lexique kissi–français, p. 13: diyɔɔkoyaa</text></form></note>
    <note><form lang="fr"><text>Contient diyɔɔ « tuer », attesté dans la Bible.</text></form></note>
  </entry>
  <entry id="díŋndó_1120">
    <lexical-unit><form lang="kqs"><text>díŋndó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <sense id="díŋndó_1120_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>pierre d'appui du fuseau (filage) ; pierre que le masque fait siffler</text></gloss>
      <gloss lang="en"><text>stone on which a spindle rests; stone blown by the masked spirit</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
      <trait name="semantic-domain-ddp4" value="4.9.8 Religious things"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 81: díŋndó</text></form></note>
  </entry>
  <entry id="diɔmnde_1121">
    <lexical-unit><form lang="kqs"><text>diɔmnde</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diɔmnde_1121_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise, stupidité</text></gloss>
      <gloss lang="en"><text>folly, foolishness, stupidity</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 29 occurrences, first JOB.15.2; Childs 2000, p. 83: dìɔ̀mndé</text></form></note>
    <note><form lang="fr"><text>Voir diɔmndo « sot ». La mal diɔmnde « abandonnez la sottise » (PRO.9.6).</text></form></note>
  </entry>
  <entry id="diɔmndo_1122">
    <lexical-unit><form lang="kqs"><text>diɔmndo</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>diɔm</text></form></variant>
    <variant><form lang="kqs"><text>diɔmaa</text></form></variant>
    <sense id="diɔmndo_1122_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>folie, sottise ; (pl.) les sots</text></gloss>
      <gloss lang="en"><text>folly; (pl.) fools</text></gloss>
      <trait name="semantic-domain-ddp4" value="3.2 Think"/>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>fool, foolish person</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 32 occurrences, first 1SA.21.14; Paulme 1964, p. 20: dɔmdo; Childs 2000, p. 83: ɗìɔ̀mndó</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 20 : dɔmdo « bête, stupide » (dɔmdo ntyu ni « tu es idiot »).</text></form></note>
  </entry>
  <entry id="díɔ́móó_1123">
    <lexical-unit><form lang="kqs"><text>díɔ́móó</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>díɔ́múáá</text></form></field>
    <sense id="díɔ́móó_1123_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>coépouse</text></gloss>
      <gloss lang="en"><text>co-wife</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.6.1 Marriage"/>
      <trait name="semantic-domain-ddp4" value="4.1.9 Kinship"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 83: díɔ́móó</text></form></note>
  </entry>
  <entry id="diɛmbe_1124">
    <lexical-unit><form lang="kqs"><text>diɛmbe</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>yimbo</text></form></variant>
    <sense id="diɛmbe_1124_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>tambour de danse</text></gloss>
      <gloss lang="en"><text>dance drum</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.2.3 Music"/>
      <trait name="semantic-domain-ddp4" value="4.2.4 Dance"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: diɛmbe, yimbo, pl. yimbɔra</text></form></note>
    <note><form lang="fr"><text>Paulme : pl. yimbɔra.</text></form></note>
  </entry>
  <entry id="diɛŋ_1125">
    <lexical-unit><form lang="kqs"><text>diɛŋ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="diɛŋ_1125_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>après-demain</text></gloss>
      <gloss lang="en"><text>the day after tomorrow</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.4.5 Relative time"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 6 occurrences, first EXO.19.11; Keita 1979, p. 152: Dièn; Paulme 1964, p. 17: dɛn; Lexique kissi–français, p. 13: diɛn; Childs 2000, p. 78: díɛ̀ŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 17 : dɛn « après-demain » (a kwani dɛn « ils partiront après-demain »).</text></form></note>
  </entry>
  <entry id="diɛɛmoo_1126">
    <lexical-unit><form lang="kqs"><text>diɛɛmoo</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <variant><form lang="kqs"><text>diɛɛmaɛi</text></form></variant>
    <sense id="diɛɛmoo_1126_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>rival ; (diɛɛmaɛi) rivalité</text></gloss>
      <gloss lang="en"><text>rival; (diɛɛmaɛi) rivalry</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <note type="source"><form lang="en"><text>Terminologie (histoire), n° 555: Dièèmoo</text></form></note>
    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970). Aussi diɛɛmaɛi « rivalité » (histoire n° 556).</text></form></note>
  </entry>
  <entry id="diɛɛmulen_1127">
    <lexical-unit><form lang="kqs"><text>diɛɛmulen</text></form></lexical-unit>
    <trait name="noun-class" value="len"/>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>dɛmule</text></form><trait name="dialect" value="Kissidougou"/></variant>
    <variant><form lang="kqs"><text>diamule</text></form><trait name="dialect" value="Guéckédou"/></variant>
    <sense id="diɛɛmulen_1127_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>langue (organe)</text></gloss>
      <gloss lang="en"><text>tongue</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.1.1 Head"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 11 occurrences, first JOB.20.12; Keita 1979, p. 131: Dièèmulen; Paulme 1964, p. 17: dɛmule, pl. dɛmuã; Lexique kissi–français, p. 13: diɛɛmulen; Childs 2000, p. 83: dìɔ̀mùléŋ</text></form></note>
    <note><form lang="fr"><text>Paulme 1964, p. 17 : dɛmule, pl. dɛmuã « langue » ; dyamule /G./. Paulme : dɛmule /K./, dyamule /G./ (p. 17, 23).</text></form></note>
  </entry>
  <entry id="diɲomaa_1128">
    <lexical-unit><form lang="kqs"><text>diɲomaa</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="diɲomaa_1128_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>lieu d'excision (rite du sadɛndo)</text></gloss>
      <gloss lang="en"><text>place of excision (sadɛndo rite)</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.5 Practice religion"/>
    </sense>
    <note type="source"><form lang="en"><text>Paulme 1964, p. 19: dinyomā</text></form></note>
  </entry>
  <entry id="dòkìó_1129">
