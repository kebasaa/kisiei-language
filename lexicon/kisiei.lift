  <entry id="kóópíá_1462">
    <lexical-unit><form lang="kqs"><text>kóópíá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kóópíláŋ</text></form></field>
    <sense id="kóópíá_1462_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>hotte en rotin portée sur le dos (transport du riz)</text></gloss>
      <gloss lang="en"><text>long rattan back-basket with shoulder straps (for carrying rice)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.7.3 Carrying tool"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 179: kóópíá kóópíláŋ</text></form></note>
