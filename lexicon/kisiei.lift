      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>esprit de brousse qui produit un son avec une canne</text></gloss>
      <gloss lang="en"><text>bush spirit producing a sound with a wild cane</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 338: sòmìsòmìŋndó</text></form></note>
  </entry>
