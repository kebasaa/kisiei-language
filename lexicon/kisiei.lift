      <gloss lang="en"><text>eggplant, garden egg</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.5 Parts of a plant"/>
      <trait name="semantic-domain-ddp4" value="6.2.1 Growing crops"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bitterball, a small round bitter vegetable</text></form></field>
    <note type="source"><form lang="en"><text>Keita 1979, p. 139: Bèi; Childs 2000, p. 12: bɛ̀í</text></form></note>
    <note><form lang="fr"><text>Keita donne aussi la variante Bai.</text></form></note>
