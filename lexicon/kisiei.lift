    <variant><form lang="kqs"><text>yɔŋnunnin</text></form></variant>
    <variant><form lang="kqs"><text>yɔŋnɔn</text></form></variant>
    <sense id="yɔŋnun_4008_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>devenir, être ; se produire</text></gloss>
      <gloss lang="en"><text>become, be; happen</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.1.1 Be"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>happen, occur; become</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 975 occurrences, first GEN.1.5; Childs 2000, p. 414: yɔ̀ŋnɔ̌ŋndó</text></form></note>
  </entry>
  <entry id="yɔŋul_4009">
    <lexical-unit><form lang="kqs"><text>yɔŋul</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔŋul_4009_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>blesser, faire du mal à</text></gloss>
      <gloss lang="en"><text>injure, harm, wound</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
      <trait name="semantic-domain-ddp4" value="7.7.1 Hit"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>poison, wound, harm</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 22 occurrences, first LEV.24.19; Childs 2000, p. 415: yɔ̀ŋùlló</text></form></note>
  </entry>
  <entry id="yɔŋulɔnndo_4010">
    <lexical-unit><form lang="kqs"><text>yɔŋulɔnndo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <field type="plural"><form lang="kqs"><text>yɔŋulɔnnda</text></form></field>
    <variant><form lang="kqs"><text>yɔŋulɔn</text></form></variant>
    <variant><form lang="kqs"><text>yɔŋulɔnndan</text></form></variant>
    <variant><form lang="kqs"><text>yɔŋulannda</text></form></variant>
    <sense id="yɔŋulɔnndo_4010_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>blessure, coup ; (yɔŋulannda) blessés</text></gloss>
      <gloss lang="en"><text>wound, injury; (yɔŋulannda) the wounded</text></gloss>
      <trait name="semantic-domain-ddp4" value="2.5.3 Injure"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>harming oneself (middle plural of yɔ̀ŋùlló 'harm')</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first DEU.17.8; Childs 2000, p. 415: yɔ̀ŋùlɔ̌ŋndáŋ</text></form></note>
    <note><form lang="fr"><text>De yɔŋul « blesser ». siangunin a yɔŋulɔn kon « guérir de cette blessure » (2KI.1.2) ; deli a yɔŋulannda « tombèrent blessés » (JDG.9.40).</text></form></note>
  </entry>
  <entry id="yɔŋɔɔ_4011">
    <lexical-unit><form lang="kqs"><text>yɔŋɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔŋɔɔ_4011_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>cadeau, présent</text></gloss>
      <gloss lang="en"><text>gift, present</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.4.1 Give, hand to"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>(verb) send (something), present, offer; cf. yɔ̀ŋndó 'gift, sending'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first GEN.33.11; Childs 2000, p. 414: yɔ̀ŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>mí Esau bii yɔŋɔɔ kon « Ésaü accepta le cadeau » (GEN.33.11 ; aussi 2KI.20.12). Cf. yɔngoo « donner ».</text></form></note>
  </entry>
  <entry id="yɔɔ_4012">
    <lexical-unit><form lang="kqs"><text>yɔɔ</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="yɔɔ_4012_s1">
