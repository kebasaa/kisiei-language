    <variant><form lang="kqs"><text>vanndaciee</text></form></variant>
    <sense id="vanacieo_4340_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>être humain, homme ; (pl.) les humains</text></gloss>
      <gloss lang="en"><text>human being, man; (pl.) people, mankind</text></gloss>
      <trait name="semantic-domain-ddp4" value="2 Person"/>
      <trait name="semantic-domain-ddp4" value="4.1.2 Types of people"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>citizen, human being</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 479 occurrences, first GEN.1.26; Childs 2000, p. 379: wànà-cíóó</text></form></note>
    <note><form lang="fr"><text>Po vanacieo « le Fils de l'homme ».</text></form></note>
  </entry>
