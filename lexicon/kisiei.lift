  <entry id="saafɔɔ_4313">
    <lexical-unit><form lang="kqs"><text>saafɔɔ</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="saafɔɔ_4313_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>fléau</text></gloss>
      <gloss lang="en"><text>scourge, plague</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
