  <entry id="ŋoviŋovio_4074">
    <lexical-unit><form lang="kqs"><text>ŋoviŋovio</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>ŋoviŋovi</text></form></variant>
    <variant><form lang="kqs"><text>ŋovian</text></form></variant>
    <sense id="ŋoviŋovio_4074_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>presser de tous côtés, bousculer ; (ŋovian) se bousculer</text></gloss>
      <gloss lang="en"><text>press on all sides, jostle, crowd; (ŋovian) jostle one another</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.7 Physical impact"/>
      <trait name="semantic-domain-ddp4" value="4.2.1 Come together, form a group"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>press or lean against (repeatedly)</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first MRK.5.31; Childs 2000, p. 270: ŋòwìó</text></form></note>
    <note><form lang="fr"><text>sɛ́lɔ́ɔ́ co nɔm ŋoviŋovio « la foule te presse » (MRK.5.31) ; A co ŋovian mà kuindian te « ils ne se bousculent pas » (JOL.2.8). Cf. ŋɔvɔɔ « serrer, presser ».</text></form></note>
  </entry>
