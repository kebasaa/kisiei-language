    <field type="plural"><form lang="kqs"><text>kɔɔfɛɛlan</text></form></field>
    <sense id="kɔɔfɛɛ_1906_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>chaudron, grande marmite</text></gloss>
      <gloss lang="en"><text>cauldron, large cooking pot</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1 Household equipment"/>
      <trait name="semantic-domain-ddp4" value="6.7.7 Container"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>large iron cooking pot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 1 occurrences, first 1SA.2.14; Childs 2000, p. 187: kɔ̀ɔ̀fíɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>o va ikpɛɛnɛ, o va kɔɔfɛɛ, o va ibonyu « dans la marmite, le chaudron ou le pot » (1SA.2.14) ; o kɔɔfɛɛlan nin (2CH.35.13). Pluriel chez Childs kɔ̀ɔ̀féèláŋ.</text></form></note>
  </entry>
