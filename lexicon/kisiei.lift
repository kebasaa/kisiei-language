    <field type="plural"><form lang="kqs"><text>kɔ̀lɔ̀tɔ̀láŋ</text></form></field>
    <sense id="kɔ̀lɔ̀tɔ̀ɔ́_1861_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>philtre pour faire accepter ses suggestions</text></gloss>
      <gloss lang="en"><text>potion to make people go along with one's suggestions</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.9.4 Miracle, supernatural power"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 183: kɔ̀lɔ̀tɔ̀ɔ́ kɔ̀lɔ̀tɔ̀láŋ</text></form></note>
  </entry>
