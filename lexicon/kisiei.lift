    <sense id="kpɛŋɔɔ_2617_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>siège, chaise ; trône ; litière</text></gloss>
      <gloss lang="en"><text>seat, chair; throne; litter, palanquin</text></gloss>
      <trait name="semantic-domain-ddp4" value="5.1.1 Furniture"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>chair or bed made of bamboo sticks; stool</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 3 occurrences, first 2KI.4.10; Childs 2000, p. 213: kpèŋɔ̀ɔ́</text></form></note>
    <note><form lang="fr"><text>Keita (p. 15) donne Kpèènhöö « tabouret » pour le parler de Luannde.</text></form></note>
  </entry>
