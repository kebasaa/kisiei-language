  </entry>
  <entry id="dio_1065">
    <lexical-unit><form lang="kqs"><text>dio</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <sense id="dio_1065_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>porte</text></gloss>
