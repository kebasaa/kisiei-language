      <gloss lang="fr"><text>(idéophone) en plein (soleil haut, dans toute sa force)</text></gloss>
      <gloss lang="en"><text>(ideophone) in full (of the sun: high, in full strength)</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
