  <entry id="kpede_1838">
    <lexical-unit><form lang="kqs"><text>kpede</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpede_1838_s1">
      <grammatical-info value="Determiner"/>
      <gloss lang="fr"><text>tous, sans exception ; entier</text></gloss>
      <gloss lang="en"><text>all, every one; whole</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.1.5 All"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>also 'all over, everywhere'</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 828 occurrences, first GEN.7.22; Lexique kissi–français, p. 28: kpede; Childs 2000, p. 207: kpédé</text></form></note>
  </entry>
  <entry id="kpédè_1839">
    <lexical-unit><form lang="kqs"><text>kpédè</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpédè_1839_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>(s'asseoir) lourdement</text></gloss>
      <gloss lang="en"><text>(sit down) hard</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
      <trait name="semantic-domain-ddp4" value="7.1.2 Sit"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 207: kpédè</text></form></note>
  </entry>
  <entry id="kpeekpei_1840">
    <lexical-unit><form lang="kqs"><text>kpeekpei</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpeekpei_1840_s1">
      <grammatical-info value="Particle"/>
      <gloss lang="fr"><text>exactement, précisément</text></gloss>
      <gloss lang="en"><text>exactly, the very</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.6 Particles"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>really, very, a lot</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 224 occurrences, first GEN.13.4; Childs 2000, p. 207: kpéékpéí</text></form></note>
  </entry>
  <entry id="kpeekpeiyo_1841">
    <lexical-unit><form lang="kqs"><text>kpeekpeiyo</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kpeekpeiya</text></form></variant>
    <sense id="kpeekpeiyo_1841_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>vrai, véritable ; propre (à soi)</text></gloss>
      <gloss lang="en"><text>true, real; one's own</text></gloss>
      <trait name="semantic-domain-ddp4" value="8.3.7 Good"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 80 occurrences, first LEV.27.31</text></form></note>
  </entry>
  <entry id="kpéélàá_1842">
    <lexical-unit><form lang="kqs"><text>kpéélàá</text></form></lexical-unit>
    <trait name="noun-class" value="o"/>
    <trait name="status" value="southern"/>
    <field type="plural"><form lang="kqs"><text>kpéélàláŋ</text></form></field>
    <sense id="kpéélàá_1842_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>palmier haut et droit au tronc lisse, souvent sans palmes ; palmier mort</text></gloss>
      <gloss lang="en"><text>tall straight smooth-trunked palm, often without fronds; dead palm</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.5.1 Tree"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 207: kpéélàá kpéélàláŋ</text></form></note>
  </entry>
  <entry id="kpeen_1843">
    <lexical-unit><form lang="kqs"><text>kpeen</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kpeen_1843_s1">
      <grammatical-info value="Adverb"/>
      <gloss lang="fr"><text>exactement le même, tout juste</text></gloss>
      <gloss lang="en"><text>exactly the same, just so</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.6 Connected with, related"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 28: kpeen</text></form></note>
  </entry>
  <entry id="kpeendaalan_1844">
    <lexical-unit><form lang="kqs"><text>kpeendaalan</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>kpeendaalen</text></form></variant>
    <sense id="kpeendaalan_1844_s1">
      <grammatical-info value="Adjective"/>
      <gloss lang="fr"><text>retors, tordu (fil)</text></gloss>
      <gloss lang="en"><text>twisted, twined (thread)</text></gloss>
      <trait name="semantic-domain-ddp4" value="6.6.1 Working with cloth"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>be strict; wind around a spindle, braid rope</text></form></field>
    <note type="source"><form lang="en"><text>Childs 2000, p. 208: kpèèndàá</text></form></note>
    <note><form lang="fr"><text>kɛila kpeendaalan « fin lin retors ».</text></form></note>
  </entry>
  <entry id="kpéésésé_1845">
    <lexical-unit><form lang="kqs"><text>kpéésésé</text></form></lexical-unit>
    <trait name="status" value="southern"/>
    <sense id="kpéésésé_1845_s1">
      <grammatical-info value="Ideophone"/>
      <gloss lang="fr"><text>très serré (tressage) ; d'une méchanceté excessive</text></gloss>
      <gloss lang="en"><text>tightly (braided); excessively mean</text></gloss>
      <trait name="semantic-domain-ddp4" value="9.2.8 Ideophones"/>
    </sense>
    <note type="source"><form lang="en"><text>Childs 2000, p. 209: kpéésésé</text></form></note>
  </entry>
  <entry id="kpeeŋa_1846">
    <lexical-unit><form lang="kqs"><text>kpeeŋa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="kpeeŋa_1846_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>soulever, retrousser (un vêtement), découvrir</text></gloss>
      <gloss lang="en"><text>lift up, turn back (a garment), uncover</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.2 Move something in a direction"/>
      <trait name="semantic-domain-ddp4" value="7.3.7 Cover"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>move or shake; stir up</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 7 occurrences, first RUT.3.4; Childs 2000, p. 208: kpèèŋàá</text></form></note>
  </entry>
  <entry id="kpeeŋiaa_1847">
    <lexical-unit><form lang="kqs"><text>kpeeŋiaa</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <variant><form lang="kqs"><text>kpeeŋian</text></form></variant>
    <sense id="kpeeŋiaa_1847_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>déranger, troubler, inquiéter</text></gloss>
      <gloss lang="en"><text>disturb, trouble, harass</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.4.2 Trouble"/>
      <trait name="semantic-domain-ddp4" value="4.8 Conflict"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>shake up, agitate; move from one position to another</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 16 occurrences, first 1SA.28.15; Childs 2000, p. 208: kpèèŋìá</text></form></note>
  </entry>
  <entry id="kpéhènɔ̀ɔ́_1848">
