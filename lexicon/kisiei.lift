  <entry id="kotaa_1727">
    <lexical-unit><form lang="kqs"><text>kotaa</text></form></lexical-unit>
    <trait name="status" value="check"/>
    <variant><form lang="kqs"><text>kota</text></form></variant>
    <sense id="kotaa_1727_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>mépriser</text></gloss>
      <gloss lang="en"><text>despise</text></gloss>
      <trait name="semantic-domain-ddp4" value="4.3 Behavior"/>
    </sense>
    <note type="source"><form lang="en"><text>Lexique kissi–français, p. 26: kotaa/ kota</text></form></note>
    <note><form lang="fr"><text>Dans la Bible, kotaa (JER.30.16) semble signifier « piller » ; le sens « mépriser » est à confirmer.</text></form></note>
  </entry>
