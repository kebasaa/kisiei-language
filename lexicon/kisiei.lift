    <note><form lang="fr"><text>Terme proposé par l'Académie des langues (années 1970).</text></form></note>
  </entry>
  <entry id="kamalindonden_1925">
    <lexical-unit><form lang="kqs"><text>kamalindonden</text></form></lexical-unit>
    <trait name="status" value="respelled"/>
    <sense id="kamalindonden_1925_s1">
