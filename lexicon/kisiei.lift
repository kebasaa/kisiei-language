  <entry id="liion_3141">
    <lexical-unit><form lang="kqs"><text>liion</text></form></lexical-unit>
    <trait name="status" value="attested"/>
    <sense id="liion_3141_s1">
      <grammatical-info value="Noun"/>
      <gloss lang="fr"><text>plomb ; plomb de filet de pêche (épervier)</text></gloss>
      <gloss lang="en"><text>lead; sinker of a cast net</text></gloss>
      <trait name="semantic-domain-ddp4" value="1.2.2 Substance, matter"/>
      <trait name="semantic-domain-ddp4" value="6.4.5 Fishing"/>
    </sense>
    <note type="source"><form lang="en"><text>BKG: 2 occurrences, first NUM.31.22; Paulme 1964, p. 57: lio</text></form></note>
    <note><form lang="fr"><text>Paulme : lio « plomb pour filet de pêche » (Guéckédou ; l'épervier n'est pas en usage dans la région de Kissidougou). La Bible a liion dans la liste des métaux (NUM.31.22).</text></form></note>
  </entry>
  <entry id="lìlìléŋ_3142">
    <lexical-unit><form lang="kqs"><text>lìlìléŋ</text></form></lexical-unit>
