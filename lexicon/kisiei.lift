    <variant><form lang="kqs"><text>cuu</text></form></variant>
    <variant><form lang="kqs"><text>cuunin</text></form></variant>
    <sense id="cuuo_193_s1">
      <grammatical-info value="Verb"/>
      <gloss lang="fr"><text>apporter, amener</text></gloss>
      <gloss lang="en"><text>bring</text></gloss>
      <trait name="semantic-domain-ddp4" value="7.3.3 Take somewhere"/>
    </sense>
    <field type="southern-kissi-sense"><form lang="en"><text>bring; give someone a present</text></form></field>
    <note type="source"><form lang="en"><text>BKG: 28 occurrences, first GEN.27.5; Childs 2000, p. 69: cùùwó</text></form></note>
  </entry>
