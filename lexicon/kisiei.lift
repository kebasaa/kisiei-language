      <trait name="semantic-domain-ddp4" value="4.9.2 Supernatural being"/>
    </sense>
    <note type="source"><form lang="en"><text>Keita 1979, p. 150: Nyamavuloo; Lexique kissi–français, p. 39: ɲamavuloo</text></form></note>
    <note><form lang="fr"><text>Pluriel ɲamavulua attesté (Is 34,14).</text></form></note>
